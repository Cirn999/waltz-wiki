{"schemaVersion":2,"cardId":6374,"modelId":10189,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10189:3","text":"长官好！那个…您能不能帮我安排个单人间宿舍?"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10189:29","text":"啊啊，今天我这个小兵也终于升变为王后了呀..."}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10189:4","text":"一个高明的外科医生应该有鹰的眼睛，狮子的心和…一双女人的手…哎，好难啊，只满足最后那条"},{"id":"10189:5","text":"要问我和其他钢舞姬的关系嘛，不算很紧张，但有点像异色格的象～"},{"id":"10189:6","text":"战车兽的生化结构还不是很稳定，感觉一直在进化..我们需要密切观测"},{"id":"10189:7","text":"有谁骨折了可以来找我… 参战前正好是外科医生，嗯 不过是实习的啦.."},{"id":"10189:8","text":"一个人的时候，喜欢自己和自己下国际象棋…似乎还能提高命中率咧…"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10189:14","text":"这次行动不难，我们让对方一个皇后也能取得胜利的"},{"id":"10189:15","text":"这几我们要给敌人一次外科手术式的打击"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10189:16","text":"安静的一着~"},{"id":"10189:17","text":"简化战局！"},{"id":"10189:18","text":"慌什么～"},{"id":"10189:19","text":"Checkmate！"},{"id":"10189:20","text":"按计划攻击"},{"id":"10189:21","text":"轮到我了"},{"id":"10189:22","text":"机会！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10189:27","text":"吖，我的裙子～"},{"id":"10189:28","text":"Ya ah~~~he"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10189:26","text":"局面发展的比我预料的要严重唉～～"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10189:25","text":"被吃掉的棋子，可能是胜局的起点吧..."}]},{"tag":1019,"label":"胜利","lines":[{"id":"10189:23","text":"胜局不再是梦想，而是一种回忆了…"}]},{"tag":1020,"label":"失败","lines":[{"id":"10189:24","text":"浪漫型棋手对失败并不反感…那么，我们撤退吧！"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10189:0","text":"开始炮击！"},{"id":"10189:1","text":"进攻！"},{"id":"10189:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
