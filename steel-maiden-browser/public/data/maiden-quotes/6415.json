{"schemaVersion":2,"cardId":6415,"modelId":10586,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10586:3","text":"刚刚从地狱回来了！同志，你先到的吗？"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10586:30","text":"同志，也许你做了一个最明智的决定… 哈哈哈"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10586:4","text":"最近兵工厂缺少原材料，这套舞装比较适合夏天穿着"},{"id":"10586:5","text":"我伸手搜索自己身上所有口袋……。既没有钱包，也没有怀表，甚至连一块手帕也没有……"},{"id":"10586:6","text":"基于舞装的款式，我为自己设计了这个头巾。嗯…可以直接去赌场工作了吧？"},{"id":"10586:7","text":"同志，我觉得你缺乏锻炼，借我的主炮过去，练习下举重如何？"},{"id":"10586:8","text":"你有迷人的作战思想，我感觉我喜欢上指挥官同志了呢。"},{"id":"10586:9","text":"战争结束后，你会失业的吧？不过我会照顾你...应该会"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10586:15","text":"为了胜利，全队出发！"},{"id":"10586:16","text":"舞装检查完毕，可以出发！"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10586:17","text":"Бъемся мы здорово"},{"id":"10586:18","text":"来，试试姐姐炮弹的味道。"},{"id":"10586:19","text":"为了祖国！"},{"id":"10586:20","text":"主炮发射！"},{"id":"10586:21","text":"给我狠狠的打！"},{"id":"10586:22","text":"方向410，发射！"},{"id":"10586:23","text":"炮火不许停下来！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10586:28","text":"还好没打到脸上…呼"},{"id":"10586:29","text":"指挥官同志注意隐蔽！"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10586:27","text":"不好！高低机损坏～"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10586:26","text":"舞装完全失灵，SU-14先撤退了！"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10586:24","text":"В боях познаеться радость побед."}]},{"tag":1020,"label":"失败","lines":[{"id":"10586:25","text":"我们还会再来的！"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10586:0","text":"开始炮击！"},{"id":"10586:1","text":"进攻！"},{"id":"10586:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
