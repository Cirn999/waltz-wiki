{"schemaVersion":2,"cardId":9876,"modelId":10956,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10956:3","text":"又见面了，长官阁下，不过这次“我们”可没那么好指挥咯。"},{"id":"10956:4","text":"*“我们”有权在必要时违抗命令。还有，我们需要双人床。*"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10956:5","text":"勋章？“我们”有很多，这一枚恐怕也不会戴在身上的。"},{"id":"10956:6","text":"*“我们”不戴勋章，因为我们在阴影中行动，手上沾满污浊。*"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10956:7","text":"*把你的手松开，长官，我可没有妹妹那样温和。*"},{"id":"10956:8","text":"“我们”？这让你困惑吗？其实“我们”都是我呀。"},{"id":"10956:9","text":"（幸福的瞌睡声）"},{"id":"10956:10","text":"*（警惕的目光）*"}]}],"battle":[{"tag":1012,"label":"攻击","lines":[{"id":"10956:11","text":"*我没允许你逃跑。*"},{"id":"10956:12","text":"再不闪开的话，闪电就要到了哦。"},{"id":"10956:13","text":"*让我看看你还能流几升血！*"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10956:14","text":"哎呀！扎到我了！你们怎么下得去手的！"},{"id":"10956:15","text":"*（鲨鱼般的响动）*"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10956:16","text":"我还未离去……"},{"id":"10956:17","text":"*你们……不可饶恕……*"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10956:0","text":"开始炮击！"},{"id":"10956:1","text":"进攻！"},{"id":"10956:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
