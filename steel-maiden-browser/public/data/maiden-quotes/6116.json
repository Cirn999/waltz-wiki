{"schemaVersion":2,"cardId":6116,"modelId":10106,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10106:3","text":"A-Sir,应该认得出我吧？……这次从特别空勤队调来的呢…"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10106:27","text":"终于等到这一天！可以和长官在一起了～"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10106:4","text":"这里和掷弹兵卫队第4营比起来，生活更简单了。可以抽空撰写一些恐怖小说"},{"id":"10106:5","text":"如果不是佐伊写信给我，应该会毕业了再来。总是放心不下这个姐姐啦"},{"id":"10106:6","text":"所有的战术要围绕进攻，而不是保住发型…"},{"id":"10106:7","text":"我研究了北非作战时遇到的新型敌人，光靠表姐的\"突突鲁\"是解决不了问题的。"},{"id":"10106:8","text":"有时候在餐厅遇到克伦威尔姐妹，似乎总对着我背后指指点点。什么意思嘛…"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10106:13","text":"诸位，把作战手册都折成纸飞机吧！"},{"id":"10106:14","text":"出发，全程12公里，预计15分钟到达前线。"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10106:16","text":"正前方，目视距离！"},{"id":"10106:17","text":"火力掩护！"},{"id":"10106:18","text":"保持火力～～"},{"id":"10106:19","text":"开火~"},{"id":"10106:20","text":"还想跑？"},{"id":"10106:21","text":"哈---哈~"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10106:25","text":"…帮我挡一下唉～"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10106:24","text":"正面被重创～好疼"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10106:22","text":"赢了～赢了唉～～"}]},{"tag":1020,"label":"失败","lines":[{"id":"10106:23","text":"我们还是重新配置下部队吧…"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10106:0","text":"开始炮击！"},{"id":"10106:1","text":"进攻！"},{"id":"10106:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
