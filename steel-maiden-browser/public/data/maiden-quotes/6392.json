{"schemaVersion":2,"cardId":6392,"modelId":10133,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10133:3","text":"生命中有些东西，对于我来说是如此之重，对于长官来说却是如此之轻…"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10133:25","text":"这种感觉...可怜的我对于幸福太容易陷入其中了"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10133:4","text":"我可以爱你，这让我痛不欲生；我可以不爱你，但这样甚至无法生存。恩？长官找我有事？"},{"id":"10133:5","text":"有人养狼獾也可以，我养个鼹鼠应该也行吧…"},{"id":"10133:6","text":"某国的人根本不懂什么才是音乐！"},{"id":"10133:7","text":"我所害怕的是，苦涩的爱，以荆棘为冠的虎式战车！"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10133:14","text":"随我来吧～"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10133:15","text":"命运的炮击！"},{"id":"10133:16","text":"死亡的气息！"},{"id":"10133:17","text":"最终的旋律！"},{"id":"10133:18","text":"为了祖国！"},{"id":"10133:19","text":"长官小心！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10133:23","text":"呃～"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10133:22","text":"不要远离我,胜利女神～"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10133:20","text":"谢谢你，胜利女神…"}]},{"tag":1020,"label":"失败","lines":[{"id":"10133:21","text":"又战败了，散不去的失望之雾～"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10133:0","text":"为了夺回我们的家园！攻击！"},{"id":"10133:1","text":"我可不觉得战争事件有趣的事情！"},{"id":"10133:2","text":"敌人虽然很强大，但是我也不会屈服的！"}]}]},"recruitmentStory":null}
