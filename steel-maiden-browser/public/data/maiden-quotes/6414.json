{"schemaVersion":2,"cardId":6414,"modelId":10168,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10168:3","text":"这个时代，在战场上我总能遇到各种稀奇古怪的人！"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10168:29","text":"除了打仗，你还会做蛋糕吗？"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10168:4","text":"我家…嘛，做点小生意。开蛋糕店...彼得诺夫蛋糕店。"},{"id":"10168:5","text":"看着我干嘛？我可是来参军的，床单请自己洗。"},{"id":"10168:6","text":"首长，下次去城里给大家带点啤酒吧，天快热了。"},{"id":"10168:7","text":"炮火支援和做蛋糕一样，只要男人不来指挥就能做好。"},{"id":"10168:8","text":"快对我说...“我想为你做一辈子的早餐～”"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10168:15","text":"吃饱喝足，就开始工作吧。"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10168:16","text":"别忘记放糖！"},{"id":"10168:17","text":"新鲜炮弹～"},{"id":"10168:18","text":"开胃的～"},{"id":"10168:19","text":"吃完还有～"},{"id":"10168:20","text":"招牌一击！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10168:26","text":"干嘛打我呀～"},{"id":"10168:27","text":"嗷～"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10168:25","text":"哎呦，麻烦了～呃"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10168:21","text":"进展得好像很顺利，应该没遇到敌军主力。"},{"id":"10168:22","text":"啊～居然胜利了！"}]},{"tag":1020,"label":"失败","lines":[{"id":"10168:23","text":"这下被烤糊了…"},{"id":"10168:24","text":"说好不参加这次行动的～"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10168:0","text":"开始炮击！"},{"id":"10168:1","text":"进攻！"},{"id":"10168:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
