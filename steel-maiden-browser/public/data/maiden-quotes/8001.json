{"schemaVersion":2,"cardId":8001,"modelId":13000,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"13000:3","text":"代号空钢，准备应对历史的演进吧，长官"}]}],"honor":[],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"13000:4","text":"哎～轻点，飞机是精密战争机器...弄坏螺旋桨，长官把坦克卖光也赔不起的"},{"id":"13000:5","text":"空钢部队的存在，是不是让长官吓一跳?"},{"id":"13000:6","text":"普通飞机的造价和我们相比…大概只是1%吧，一场豪赌，我来当筹码罢了"},{"id":"13000:7","text":"长官你这个人挺有趣的，和钢舞姬相处就不腻味吗？对我...有何评定？"},{"id":"13000:8","text":"我推荐你本小说看看，嗯…名字叫《这里的黎明静悄悄》，和长官您现在的处境很像。"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"13000:10","text":"引擎开车，请求滑出。"},{"id":"13000:11","text":"灰鸠收到，大家喝杯滚烫的咖啡，我这就来。"}]},{"tag":1012,"label":"攻击","lines":[{"id":"13000:12","text":"僚机跟紧，我们来一轮短点射。"},{"id":"13000:13","text":"注意接近后再射击看，节约弹药。"},{"id":"13000:14","text":"啊～小不点～"},{"id":"13000:15","text":"稳住，攻击八点钟方向。"},{"id":"13000:16","text":"前置追击，开火！"},{"id":"13000:17","text":"目视确立，开火！"},{"id":"13000:18","text":"空中救援到场。"},{"id":"13000:19","text":"垂直俯冲！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"13000:24","text":"被击中！被击中！"}]},{"tag":1015,"label":"重伤","lines":[{"id":"13000:25","text":"啊～要失速了～"}]},{"tag":1019,"label":"胜利","lines":[{"id":"13000:20","text":"破S是小学课程，哼哼～"}]},{"tag":1020,"label":"失败","lines":[{"id":"13000:21","text":"似乎有点低血糖了，我先回去了。"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"13000:0","text":"锁定目标！"},{"id":"13000:1","text":"进攻！"},{"id":"13000:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
