{"schemaVersion":2,"cardId":9221,"modelId":10855,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10855:3","text":"您好，长官，好久不见，我从ES国进修回来了～啊，对了，我房间里的那套厨具怎么没了？是您帮我收起来了吗？"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10855:4","text":"说起来～我在瓦伦西亚进修时，学会了一道很特别的海鲜饭～怎么样？待会儿要不来我房间，我给您做一份\"私人定制\"版的尝尝？"}]}],"touch":[],"battle":[{"tag":1002,"label":"战斗对白","lines":[{"id":"10855:0","text":"开始炮击！"},{"id":"10855:1","text":"进攻！"},{"id":"10855:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
