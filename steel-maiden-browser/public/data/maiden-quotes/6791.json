{"schemaVersion":2,"cardId":6791,"modelId":10589,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10589:3","text":"那么长官你好，你这个地方还不赖啊，全都是小姑娘"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10589:35","text":"终于等到这一天！可以和长官在一起了～"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10589:4","text":"啊呀，我这个人是有点木讷，但是还算很好说话的"},{"id":"10589:5","text":"哎，又怎么了？"},{"id":"10589:6","text":"长官同志，你家以前是做啥的？"},{"id":"10589:7","text":"今天中午吃啥呀？我觉得做个红菜汤再吃点面包就可以了"},{"id":"10589:8","text":"佐伊这个人很有趣，她的吹风机会飘的，好玩好玩，长官你也帮我买一个…啊？其实只是门炮啊？"},{"id":"10589:9","text":"长官，这两天也不带我出去玩啊，啥意思嘛…"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10589:18","text":"出发了，要带的都带好，不要丢三落四！"},{"id":"10589:19","text":"等一会儿大家一起出力！听到了吗？"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10589:20","text":"吃我一炮"},{"id":"10589:21","text":"我打你哦"},{"id":"10589:22","text":"想怎么样？"},{"id":"10589:23","text":"Fire"},{"id":"10589:24","text":"死开点"},{"id":"10589:25","text":"打不中不要怪我"},{"id":"10589:26","text":"那么我来处理吧"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10589:32","text":"啊呀，好可怕啊"},{"id":"10589:33","text":"怎么啦～"},{"id":"10589:34","text":"不要啊～"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10589:31","text":"哎呀，干嘛啦～"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10589:30","text":"啊呀，这炮打得好痛，我不行了要"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10589:27","text":"好啊好啊一下子就搞定了"}]},{"tag":1020,"label":"失败","lines":[{"id":"10589:28","text":"输了，这下回去要受批评了"},{"id":"10589:29","text":"哎呀，真丢脸，这样也会输掉啊，实在受不了"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10589:0","text":"开始炮击！"},{"id":"10589:1","text":"进攻！"},{"id":"10589:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
