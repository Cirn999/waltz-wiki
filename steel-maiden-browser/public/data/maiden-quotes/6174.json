{"schemaVersion":2,"cardId":6174,"modelId":10096,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10096:3","text":"啊～～今后就要和长官在一起执行任务了，好期待哦…如您有需要帮助，请按服务按钮哦"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10096:32","text":"飞机马上就要起飞啦！长官请抱紧我～～"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10096:4","text":"哎？长官身上的军用肥皂味道挺好闻的…Ha! 应该是佛手柑的味道！"},{"id":"10096:5","text":"出击的时候，我总是会担心逃生门的事情… 唉"},{"id":"10096:6","text":"以前当班的时候会见到芬妮，她每次都会问我要两份开胃酒。"},{"id":"10096:7","text":"在陆地上作战，比想象中有趣多了，就是经常会留意长官的吉普车，忘记开火了～"},{"id":"10096:8","text":"啊～要出发了吗？"},{"id":"10096:9","text":"如果明年战争能结束的话，我应该可以通过调香师的考试"},{"id":"10096:10","text":"第一次试制古龙水，长官不知道会喜欢吗？青柠 罗勒 鸢尾花…可能我喜欢吧"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10096:17","text":"出发啦，请长官系好安全带～，如果找不到的话，可能被您坐在屁股下啦"},{"id":"10096:18","text":"This is Final Call… 请长官登机啦～马上启程了"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10096:19","text":"要喝点什么？"},{"id":"10096:20","text":"您要..鸡肉还是鱼呢？"},{"id":"10096:21","text":"有点下不了狠手唉～"},{"id":"10096:22","text":"要开始攻击了哦～"},{"id":"10096:23","text":"请保持秩序～"},{"id":"10096:24","text":"这是特别服务～"},{"id":"10096:25","text":"不要碰我～～"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10096:30","text":"请大家抓紧靠背～"},{"id":"10096:31","text":"Ah…好痛"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10096:29","text":"不行了～ 冲击姿势～"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10096:28","text":"MAYDAY MAYDAY~"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10096:26","text":"胜利啦～为了自由的生活～"}]},{"tag":1020,"label":"失败","lines":[{"id":"10096:27","text":"输啦，不过还好没把鼻子碰伤"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10096:0","text":"开始炮击！"},{"id":"10096:1","text":"进攻！"},{"id":"10096:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
