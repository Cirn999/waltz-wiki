{"schemaVersion":2,"cardId":6336,"modelId":10179,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10179:3","text":"请首长检阅！"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10179:25","text":"终于等到这一天！可以和长官在一起了～"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10179:4","text":"首长您辛苦了～"},{"id":"10179:5","text":"不用数负重轮了，请看着我的眼睛。好好说话"},{"id":"10179:6","text":"人不犯我，我不犯人。。。后半句您应该背得出"},{"id":"10179:7","text":"最近似乎换了制服供应商，衣服有点紧…嗯"},{"id":"10179:8","text":"品茶的、作诗的、养狼獾的…这些钢舞姬都是你挑的？那...为什么又选择了我？"},{"id":"10179:9","text":"首长是官员，也是个好人。简称官人？"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10179:15","text":"听好指挥，十一点钟方向，时速30！"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10179:16","text":"da si wei da ni ya ～"},{"id":"10179:17","text":"放！"},{"id":"10179:18","text":"这种水准～哼哼"},{"id":"10179:19","text":"间接射击！"},{"id":"10179:20","text":"代表人民消灭你！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10179:22","text":"哎呀～"},{"id":"10179:23","text":"吖～～"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10179:21","text":"轻伤不下.火线"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10179:0","text":"开始炮击！"},{"id":"10179:1","text":"进攻！"},{"id":"10179:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
