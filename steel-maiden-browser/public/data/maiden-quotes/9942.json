{"schemaVersion":2,"cardId":9942,"modelId":10864,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10864:3","text":"哎？您是这里的新来的指挥官吧？来的正好，您能不能给我开一份滑雪资格证明？这里新开的越野滑雪场太离谱了，必须要有上级的证明书才能进去滑雪…"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10864:4","text":"哼哼～我现在可是这里新滑雪场的明星教练啦～指挥官要不要来上我的培训课？这枚勋章就当做学费了吧～嗯？放心～当然不是公开课，是私教啦～一对一的那种哦～"}]}],"touch":[],"battle":[{"tag":1002,"label":"战斗对白","lines":[{"id":"10864:0","text":"开始炮击！"},{"id":"10864:1","text":"进攻！"},{"id":"10864:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
