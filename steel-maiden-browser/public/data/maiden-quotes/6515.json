{"schemaVersion":2,"cardId":6515,"modelId":10560,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10560:3","text":"哎？指挥官同志，还有哪个小队需要火箭炮支援？"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10560:29","text":"今天晚上想吃点什么？白萝卜准备好了～"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10560:4","text":"说起来，第一次发射火箭弹的时候，忘记看说明书啦！"},{"id":"10560:5","text":"瞳孔颜色很有趣吧？火箭弹事故之后经过某人的特别治疗就这样了，反倒视力超强咧！"},{"id":"10560:6","text":"火箭弹实在太贵了，有时候摆几只白萝卜吓唬吓唬敌人也足够了。嗯...饿了还能啃啃。"},{"id":"10560:7","text":"我要把你平放在白净的盘子里，用小刀和叉子，吃掉你……哎？指挥官，我是在和我的萝卜聊天呢…不是和您说话啦！"},{"id":"10560:8","text":"天气马上转凉，一切会变得美丽，如同进入老派的爱情小说。"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10560:14","text":"大家这次要认真作战，否则战后只能去遮阳伞下卖冰淇淋了哦"},{"id":"10560:15","text":"出发！出发！"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10560:16","text":"来自火炮的问候！"},{"id":"10560:17","text":"吃点蔬菜吧？"},{"id":"10560:18","text":"为了胜利时的水果鸡尾酒！"},{"id":"10560:19","text":"进攻！"},{"id":"10560:20","text":"地狱里的夏天来了！"},{"id":"10560:21","text":"在黄昏中分手吧！"},{"id":"10560:22","text":"起风了～"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10560:27","text":"对不起，请让我喘口气～"},{"id":"10560:28","text":"不碍事，皮外伤"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10560:26","text":"所有配件都开始脱落了！"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10560:25","text":"不要阿……呀！"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10560:23","text":"以后请叫我胜利小姐！"}]},{"tag":1020,"label":"失败","lines":[{"id":"10560:24","text":"千万别用一块忘记了牌子的香皂，来招待我们这些伤员噢…"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10560:0","text":"开始炮击！"},{"id":"10560:1","text":"进攻！"},{"id":"10560:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
