{"schemaVersion":2,"cardId":9711,"modelId":10824,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10824:3","text":"嗨~您就是指挥官吧,麦瑞·福瑞德里克森向您报道,接到调令后,我就坐最近的航班赶过来了.啊~不用帮我搬行李箱了~这里面有些\"私人物品\",您可能拿不动…"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10824:4","text":"呀~据说凭这枚勋章可以去申请几天年假呢~指挥官要不要和我一起去我的家乡度个假?那里的大教堂很有特色呢~"}]}],"touch":[],"battle":[{"tag":1002,"label":"战斗对白","lines":[{"id":"10824:0","text":"开始炮击！"},{"id":"10824:1","text":"进攻！"},{"id":"10824:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
