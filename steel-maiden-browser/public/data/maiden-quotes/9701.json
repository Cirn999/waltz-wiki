{"schemaVersion":2,"cardId":9701,"modelId":10825,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10825:3","text":"您好指挥官,前\"无敌舰队\"特派员克里斯蒂娜·迪亚兹前来报道.听说您的战术风格非常的…\"标新立异\",我期待在今后的战斗中能好好见识一下"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10825:4","text":"嗯…其实我觉得指挥官您的战术风格更适合在我们舰队发挥,怎么样?要不要干脆申请调任到我们舰队去吧?我可以当保证人哦."}]}],"touch":[],"battle":[{"tag":1002,"label":"战斗对白","lines":[{"id":"10825:0","text":"开始炮击！"},{"id":"10825:1","text":"进攻！"},{"id":"10825:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
