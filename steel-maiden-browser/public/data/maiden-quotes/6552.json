{"schemaVersion":2,"cardId":6552,"modelId":10550,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10550:3","text":"你好长官！ 很开心在这里遇见你，乓！"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10550:31","text":"授勋！现在作战目标明确了，接来下是作战技巧的问题了。（用手指戳了戳指挥官）"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10550:4","text":"立正！好现在攻击的战略有了，轮到防御～"},{"id":"10550:5","text":"大家都说我很喜欢八卦，其实，这只是我挑起话题的方法"},{"id":"10550:6","text":"爸爸是一名酿酒人，生产的葡萄酒是AOC级别都兰产区干红，干白及桃红葡萄酒…"},{"id":"10550:7","text":"我的叔叔于勒老说些黄段子"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10550:14","text":"好吧 ，跟我来吧"},{"id":"10550:15","text":"生活就是战场，每个人都要进行战斗。"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10550:16","text":"开火！"},{"id":"10550:17","text":"bong～～～"},{"id":"10550:18","text":"不入虎穴焉得虎子"},{"id":"10550:19","text":"多帅的动物啊～"},{"id":"10550:20","text":"让开路！别人都没法过了"},{"id":"10550:21","text":"逮住它"},{"id":"10550:22","text":"哎？"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10550:29","text":"哦～～该死啊"},{"id":"10550:30","text":"啊！太讨厌了！"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10550:28","text":"啊 这些坏蛋！"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10550:27","text":"战斗的结果还不确定"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10550:23","text":"大家都还好吧？棒极了"},{"id":"10550:24","text":"笑到最后的笑得最好 bong～"}]},{"tag":1020,"label":"失败","lines":[{"id":"10550:25","text":"这就是生活吧"},{"id":"10550:26","text":"不可能不是一个法语单词"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10550:0","text":"开始炮击！"},{"id":"10550:1","text":"进攻！"},{"id":"10550:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
