{"schemaVersion":2,"cardId":6255,"modelId":10047,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10047:3","text":"同志们好～嗯…我有点怕冷…不想摘下帽子…可，可以么…"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10047:29","text":"在库尔斯克的冬天过去之后，一起融化在新的世界中吧…"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10047:4","text":"ruang…我一直以为…军方用了鸡尾酒的名字给我命名的…但是…伙伴却都在偷笑…到底为什么呢…"},{"id":"10047:5","text":"请，请不要欺负我…我，我曾经一个人…阻挡住了一大群的军马型战车兽的进攻呢…是,是真的哦"},{"id":"10047:6","text":"今天下午…我要去战地医院帮忙照顾伤员和做饭呢…指挥官要一起去么？"},{"id":"10047:7","text":"深夜花园里四处静悄悄，树叶也不再沙沙响，夜色多么好，令人心神往，多么幽静的晚上。"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10047:15","text":"啊～大家不要跑得那么快…等，等等我…"},{"id":"10047:16","text":"希望我…可以保护伙伴们"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10047:17","text":"歌声…会带来胜利的"},{"id":"10047:18","text":"请，请你们快回到树林里吧…拜托了"},{"id":"10047:19","text":"为了胜利！"},{"id":"10047:20","text":"命中…就只能交给信仰了…"},{"id":"10047:21","text":"炮塔转向花了点时间，希望…还来得及"},{"id":"10047:22","text":"我，我好像开到斜坡上了～"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10047:27","text":"唉～炮弹…被前胸弹开了么"},{"id":"10047:28","text":"唉～发动机故障，现在我该怎么办呢？"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10047:26","text":"不！我还有许多…伙伴呢…"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10047:23","text":"这个时候…好像应该和大家一起喊“Ypa”…对吧？"},{"id":"10047:24","text":"ypa！"}]},{"tag":1020,"label":"失败","lines":[{"id":"10047:25","text":"撤，撤退了么…是我的错…"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10047:0","text":"开始炮击！"},{"id":"10047:1","text":"进攻！"},{"id":"10047:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
