{"schemaVersion":2,"cardId":9853,"modelId":10979,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10979:3","text":"啊，虽然格雷确实是一条雪橇犬，但这可不是狗拉雪橇，这套舞装有着自己的独立动力源，哈哈。"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10979:4","text":"什么？格雷的那些迷惑行为给作战带来了有益的影响？还增加了作战成功率？要给我和它一起颁发勋章？难以置信，我还愁这孩子在战场捣乱要给我开处罚令呢……"}]}],"touch":[],"battle":[{"tag":1002,"label":"战斗对白","lines":[{"id":"10979:0","text":"开始炮击！"},{"id":"10979:1","text":"进攻！"},{"id":"10979:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
