{"schemaVersion":2,"cardId":6047,"modelId":10124,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10124:3","text":"不做侦察就行动,和玩扑克不看牌面一样蠢--这句名言是我说的～"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10124:38","text":"伙计，这是我得到的最好的勋章，比一千双双鞋子更让我开心"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10124:4","text":"我可不会叫你长官的，就叫伙计好了。"},{"id":"10124:5","text":"伙计，你今天真的洗过澡了吗？"},{"id":"10124:6","text":"基地里我考虑装个按摩浴缸。伙计去订购下。"},{"id":"10124:7","text":"很久以前我还去过熊猫的故乡，你去过哪些地方？"},{"id":"10124:8","text":"喂喂，望远镜的牌子不nice嘛，什么时候level up下嘛？"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10124:9","text":"那我走啦"},{"id":"10124:19","text":"大家擦亮皮鞋出发吧！"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10124:20","text":"太阳礼拜！"},{"id":"10124:21","text":"直角姿态攻击！"},{"id":"10124:22","text":"Wo Da～"},{"id":"10124:23","text":"要来了哦～"},{"id":"10124:24","text":"Very Good！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10124:25","text":"非常好啊。"},{"id":"10124:26","text":"天天做瑜伽的成果！"},{"id":"10124:28","text":"还好衣服没脏。"},{"id":"10124:33","text":"哎呦！"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10124:27","text":"鞋子坏了！"},{"id":"10124:34","text":"嗯～～"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10124:30","text":"被暗算了～"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10124:29","text":"奇迹！"},{"id":"10124:31","text":"伙计，我想休个假"},{"id":"10124:35","text":"生活就该如此！"}]},{"tag":1020,"label":"失败","lines":[{"id":"10124:32","text":"我想去尼斯渡假了…"},{"id":"10124:36","text":"这样的生活实在太艰难了…"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10124:0","text":"侦察到敌方位置，准备开始炮击压制～"},{"id":"10124:1","text":"看见了，就在那里，攻击！"},{"id":"10124:2","text":"已完全把握敌人的动向～～我真是太厉害了～"}]}]},"recruitmentStory":null}
