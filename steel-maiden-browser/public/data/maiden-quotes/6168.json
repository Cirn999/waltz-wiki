{"schemaVersion":2,"cardId":6168,"modelId":10028,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10028:3","text":"哼哼～最近我在练习转向倒车时的远距离射击哎。"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10028:28","text":"高个子的女孩原来并不用担心太多，战争和生活都会臣服于裙下。"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10028:4","text":"那个，我听说突击炮要被清理出建制？"},{"id":"10028:5","text":"基地里有必要组个排球队的。"},{"id":"10028:6","text":"我觉得拉伊莎挺可爱的诺，哈哈哈哈。"},{"id":"10028:7","text":"每天保持作战训练10小时，战后我就可以去打职业排球了。"},{"id":"10028:8","text":"长官喜欢高个子的女孩吗？"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10028:16","text":"测试!检查！出发！"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10028:17","text":"再打一个基数！"},{"id":"10028:18","text":"注意风速！"},{"id":"10028:19","text":"垂直稳定！"},{"id":"10028:20","text":"Fire!"},{"id":"10028:21","text":"咚～～～～哼哼～"},{"id":"10028:22","text":"这个交给我！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10028:26","text":"啊～噢～～"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10028:25","text":"这样下去我不行了。"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10028:23","text":"值得尊敬的对手吖～哼哼～"}]},{"tag":1020,"label":"失败","lines":[{"id":"10028:24","text":"嗯？嗯………"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10028:0","text":"闪开！闪开！都闪开！本大小姐要开炮了～"},{"id":"10028:1","text":"突击！突击！……呜哇，差点把草莓牛奶洒出来了。"},{"id":"10028:2","text":"已经飙到极限了～呼呼，下一发会贯穿的预感？"}]}]},"recruitmentStory":null}
