{"schemaVersion":2,"cardId":8371,"modelId":13050,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"13050:3","text":"在空战中，能调整弹道才是制胜的关键，毕竟飞的再快也比不过导弹的速度。"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"13050:4","text":"呀，这勋章看着挺大，重量却意外的轻啊，看来带着应该不会影响我作战时的飞行速度了～噢，感觉军部就是拿我来当\"小白鼠\"，什么试验设备都往我身上装，导致我的舞装重量剧增，严重拖慢了我的飞行速度…"}]}],"touch":[],"battle":[{"tag":1002,"label":"战斗对白","lines":[{"id":"13050:0","text":"开始炮击！"},{"id":"13050:1","text":"进攻！"},{"id":"13050:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
