{"schemaVersion":2,"cardId":6003,"modelId":10002,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10002:3","text":"保护队伍的安全是我应尽的义务，啊，当然也包括保护长官啦～"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10002:27","text":"今天,你很帅气...我感到有点心跳加快了。"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10002:4","text":"就算要去杀戮，先喝杯红茶也伤不了你。"},{"id":"10002:5","text":"历史对我不错，因为都是我写的～"},{"id":"10002:6","text":"作战时候大家开心点，因为搞点别的也没用。"},{"id":"10002:7","text":"最近战局指挥得不错，我不再发表意见了。"},{"id":"10002:8","text":"我弟弟和你一样高，呃呵呵～"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10002:15","text":"行动！"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10002:16","text":"继续前进！"},{"id":"10002:17","text":"征服地狱！"},{"id":"10002:18","text":"这点炮火还不够～"},{"id":"10002:19","text":"注意侧翼！"},{"id":"10002:20","text":"火力交叉！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10002:25","text":"我还好～"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10002:24","text":"腿脚受伤了。"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10002:23","text":"上帝准备见我了。"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10002:21","text":"历史由胜者书写！"}]},{"tag":1020,"label":"失败","lines":[{"id":"10002:22","text":"不管战略多美妙，偶尔也要看看结果。"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10002:0","text":"开始炮击！"},{"id":"10002:1","text":"狂轰滥炸不是我的作风。"},{"id":"10002:2","text":"炮击瞄准！发射！"}]}]},"recruitmentStory":null}
