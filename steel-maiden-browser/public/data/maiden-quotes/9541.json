{"schemaVersion":2,"cardId":9541,"modelId":10805,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10805:3","text":"那个……这里是登记处吗？我是艾米娅·勒曼，应募而来的钢舞姬，这是海伦娜教官的推荐信，请过目。"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10805:4","text":"和教官说的一样呢，长官虽然看起来不怎么可靠，甚至让人有些担心，但其实非常有才干，对部下也十分照顾。能跟着这样的长官工作，真是我的荣幸。"}]}],"touch":[],"battle":[{"tag":1002,"label":"战斗对白","lines":[{"id":"10805:0","text":"开始炮击！"},{"id":"10805:1","text":"进攻！"},{"id":"10805:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
