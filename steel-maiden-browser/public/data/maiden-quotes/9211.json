{"schemaVersion":2,"cardId":9211,"modelId":10861,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10861:3","text":"百夫长前来报到！"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10861:31","text":"正常情况下，授勋工作应该由我来安排。（捏了捏指挥官的脸）"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10861:4","text":"早知道要行军这么多，我还不如参加海军呢"},{"id":"10861:5","text":"只要记住，瞄准然后射击！别想爸爸来帮你"},{"id":"10861:6","text":"不管折腾啥，都给我手脚麻利点！"},{"id":"10861:7","text":"发生了啥？"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10861:14","text":"发现敌军战车，准备作战！"},{"id":"10861:15","text":"抓稳了，我们要出发了"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10861:16","text":"给我狠狠的揍他们…"},{"id":"10861:17","text":"华尔兹小队，开火！"},{"id":"10861:18","text":"来着不善，都给我机灵点"},{"id":"10861:19","text":"发现目标，进发！"},{"id":"10861:20","text":"看他们出洋相吧"},{"id":"10861:21","text":"敌军战车！上去揍他们"},{"id":"10861:22","text":"目标确认，转进！"},{"id":"10861:23","text":"掩护！！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10861:29","text":"诸位，这不是演习！"},{"id":"10861:30","text":"他们没能击穿我的装甲！"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10861:28","text":"中弹了！百夫长中弹！"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10861:27","text":"撤销任务，统统撤销！"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10861:24","text":"时刻准备，特别是胜利"}]},{"tag":1020,"label":"失败","lines":[{"id":"10861:25","text":"大家赶紧逃啊！"},{"id":"10861:26","text":"快开快开，不然没命了"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10861:0","text":"开始炮击！"},{"id":"10861:1","text":"进攻！"},{"id":"10861:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
