{"schemaVersion":2,"cardId":9892,"modelId":10944,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10944:3","text":"您好，指挥官！凯特·马歇尔，非常荣幸能加入到您的麾下。如果有需要帮忙尽管找我便是"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10944:13","text":"诶？不，我只是......只是有些欣慰，迷路之人终于能够找到属于她的归宿了"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10944:4","text":"迷路之人......大概最需要的是一个归宿吧......"},{"id":"10944:5","text":"有什么事情吗指挥官？如果您有什么烦心的事情不妨可以和我说说？"},{"id":"10944:6","text":"不要觉得我很好欺负哦，小瞧我可是要付出代价的"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10944:16","text":"保持警惕，战局瞬息万变，我们必须做好万全的准备"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10944:10","text":"进攻！碾碎他们！"},{"id":"10944:11","text":"他们拦不住我们的！"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10944:12","text":"该死，大意了，只能做到这种程度了吗......"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10944:14","text":"大家干得不错，保持这个势头继续前进吧！"}]},{"tag":1020,"label":"失败","lines":[{"id":"10944:15","text":"快撤退！我来掩护你们！"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10944:0","text":"开始炮击！"},{"id":"10944:1","text":"进攻！"},{"id":"10944:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
