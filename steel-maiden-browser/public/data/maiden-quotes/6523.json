{"schemaVersion":2,"cardId":6523,"modelId":10549,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10549:3","text":"Bonjour, commandant!!"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10549:29","text":"只要一个字，一个微笑，就已足够..."}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10549:4","text":"今天要不要去军港玩玩呢，我预测会有东西运来了。"},{"id":"10549:5","text":"指挥官，您对电子工程学...有了解吗？可以心算偏微分方程吗？"},{"id":"10549:6","text":"有时候...觉得装甲不重要，外观设计才是取胜关键。"},{"id":"10549:7","text":"哎对了，动物毛发对榴弹会有影响，指挥官大人要额外考虑哦"},{"id":"10549:8","text":"大家都以为谢尔曼厉害，其实从数学上说并不是这样！"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10549:11","text":"我的作战计划都要熟读三遍哦"},{"id":"10549:12","text":"战前好好计算，就绝不会输"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10549:17","text":"攻击！攻击！"},{"id":"10549:18","text":"按我计划，发起总攻！"},{"id":"10549:19","text":"Vers L'Avant!"},{"id":"10549:20","text":"一切都在我的计算之中，阿哈哈哈～"},{"id":"10549:21","text":"重新计算角度！"},{"id":"10549:22","text":"集中火力！攻击敌军侧翼～"},{"id":"10549:23","text":"不错不错，继续保持"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10549:27","text":"切，就知道会这样受伤～"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10549:26","text":"négatif!!怎么这样的啦！"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10549:24","text":"啊哈～我说会这样吧"}]},{"tag":1020,"label":"失败","lines":[{"id":"10549:25","text":"呃,,也？我的算法出问题了吗"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10549:0","text":"开始炮击！"},{"id":"10549:1","text":"进攻！"},{"id":"10549:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
