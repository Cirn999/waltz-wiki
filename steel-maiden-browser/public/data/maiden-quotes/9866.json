{"schemaVersion":2,"cardId":9866,"modelId":10972,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10972:3","text":"伊迪丝姐姐也是这里的钢舞姬，虽然她不支持我当佣兵，但我还是想来试试，希望长官能给我个机会。"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10972:4","text":"这勋章是给我的吗？不会是因为姐姐的关系吧？我可不想被人说是通关系才拿到勋章的，长官要给我证明啊。"}]}],"touch":[],"battle":[{"tag":1002,"label":"战斗对白","lines":[{"id":"10972:0","text":"开始炮击！"},{"id":"10972:1","text":"进攻！"},{"id":"10972:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
