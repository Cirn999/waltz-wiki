{"schemaVersion":2,"cardId":6172,"modelId":10801,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10801:3","text":"当搞清楚敌人火炮口径的时候，我想是该认真对待生活了。"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10801:29","text":"以后去市场上，我终于可以一次性买两条法棍啦！"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10801:4","text":"弹药架里塞根长棍面包并不会降低作战成功率。只要关键时刻不拿错就好了～"},{"id":"10801:5","text":"和我约会要提前预约，但并不保证一定会变成现实。"},{"id":"10801:6","text":"上了战场就要回忆美好生活，不然装2个侧面逃生门干嘛？"},{"id":"10801:7","text":"我说一遍我家电话号码，记得下来就…让长官和我约会～"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10801:13","text":"出发，安全第一！"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10801:14","text":"笨猪！"},{"id":"10801:15","text":"仅此而已？"},{"id":"10801:16","text":"援军呢！"},{"id":"10801:17","text":"顶住！"},{"id":"10801:18","text":"这就是勇气！"},{"id":"10801:19","text":"MayDay MayDay!"},{"id":"10801:20","text":"On me！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10801:27","text":"没事，没事。"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10801:23","text":"阿…肩膀受伤了～"},{"id":"10801:24","text":"阿…大腿受伤了～"},{"id":"10801:25","text":"阿…胳膊受伤了～"},{"id":"10801:26","text":"阿…浑身疼～～"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10801:21","text":"久违了，胜利女神！"}]},{"tag":1020,"label":"失败","lines":[{"id":"10801:22","text":"这仗打得太混乱了～"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10801:0","text":"本人特制法式面包坚硬如铁，塞进炮膛里也能发射～"},{"id":"10801:1","text":"法国面包世界第一，法国火炮天下无敌～要不要来一发？"},{"id":"10801:2","text":"要来份法式面包，哦不，法式炮弹吗～？"}]}]},"recruitmentStory":null}
