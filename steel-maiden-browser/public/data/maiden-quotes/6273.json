{"schemaVersion":2,"cardId":6273,"modelId":10064,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10064:3","text":"呦～又有新来的指挥官！首长你好～"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10064:27","text":"啊...原来我并不是长官一时的部下， 虽然...我早就把你...当成一生的依赖"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10064:4","text":"老叫首长首长的，很不习惯哎…."},{"id":"10064:5","text":"啊？我…没什么心事的。首长你要想一下子了解我，就意味着什么也不能了解。"},{"id":"10064:6","text":"首长你有擦眼镜布吗？借一下...擦擦瞄准镜。上面好像沾到点什么。"},{"id":"10064:7","text":"不去读书就没有真正的教养，同时也不可能有什么鉴别力，对战场指挥官尤其重要。"},{"id":"10064:8","text":"我的生活里只有三个事情:瞄准、射击、下一个,首长你可不要这样生活..."}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10064:15","text":"大家跟紧前车，出发。我压阵"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10064:16","text":"这个我来！"},{"id":"10064:17","text":"装填完毕！"},{"id":"10064:18","text":"Fire!"},{"id":"10064:19","text":"攻击侧翼～"},{"id":"10064:20","text":"保护首长～"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10064:24","text":"哎呀～"},{"id":"10064:25","text":"不好～"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10064:23","text":"真的受伤了～唔！"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10064:21","text":"这就是深思熟虑的结果"}]},{"tag":1020,"label":"失败","lines":[{"id":"10064:22","text":"不管怎么说，其实大家发挥的还可以了～"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10064:0","text":"开始炮击！"},{"id":"10064:1","text":"进攻！"},{"id":"10064:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
