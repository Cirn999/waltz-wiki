{"schemaVersion":2,"cardId":6064,"modelId":10021,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10021:3","text":"豹式G型加入作战序列！噢，对了！长官，虎式E型扎莉来了没？"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10021:30","text":"今天任务结束后，长官可以看到我不戴眼镜的样子了～"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10021:4","text":"小时候，身体不太好，大约心脏有点子问题。为了参军，我就开始每天慢跑…现在如愿了"},{"id":"10021:5","text":"其实我也可以配M10狼獾舞装，只是会有点滑稽的感觉,大概吧…"},{"id":"10021:6","text":"长官，我说…你脱掉眼镜还是有点帅气的。"},{"id":"10021:7","text":"常胜没有秘诀，也不用喝什么牛奶,关键是要有个可靠的队友。"},{"id":"10021:8","text":"军部似乎在军服设计上更愿意花钱，呃...这配发的小短裙...退役后可以带回家去吗？"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10021:15","text":"各位校准好手表，一起行动了！"},{"id":"10021:16","text":"炮灰们，都准备好了吗？记得要穿军用丝袜作战！"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10021:17","text":"精确命中吧！"},{"id":"10021:18","text":"攻击侧翼薄弱部位！"},{"id":"10021:19","text":"重型单位注意掩护！"},{"id":"10021:20","text":"进攻！进攻！"},{"id":"10021:21","text":"Fire!"},{"id":"10021:22","text":"看你再躲？"},{"id":"10021:23","text":"目标即将消失！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10021:28","text":"右侧护甲要失效了～"},{"id":"10021:29","text":"豹G受伤..请求掩护！"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10021:27","text":"唉呀，好疼的"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10021:26","text":"啊？不会吧？"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10021:24","text":"战术、火炮、装备、完美配合！作战可以是一种生活方式了"}]},{"tag":1020,"label":"失败","lines":[{"id":"10021:25","text":"唉，小短裙有点被弄脏了，作战也失利了…"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10021:0","text":"开始炮击！"},{"id":"10021:1","text":"进攻！"},{"id":"10021:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
