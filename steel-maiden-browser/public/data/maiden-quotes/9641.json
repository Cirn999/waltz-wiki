{"schemaVersion":2,"cardId":9641,"modelId":10814,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10814:3","text":"真走运呢，这次居然是到你的小队……那么，您好，指挥官同志，请下命令吧！"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10814:29","text":"哎？哎哎？给我的吗？那……那作为回礼，这个发卡送你做纪念吧，我还有个备用的，真的。"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10814:4","text":"我的头发？嗯…好吧其实我染过色，黑色可是很高级的～"},{"id":"10814:5","text":"那家咖啡店好像又出新品了？老实说我还是更愿意接受一些经典的款式…"},{"id":"10814:6","text":"其实这个电台还可以放CD或者磁带，所以你想不想听听看？我挺推荐这张专辑的"},{"id":"10814:7","text":"最近在学一门超有趣的语言，写起来像在画画，要不要我也教你几个词？"},{"id":"10814:8","text":"指挥官同志，你……有点像童话里的英雄呢。"},{"id":"10814:9","text":"今晚的月亮好像也在对我们笑呢，你看见了吗～"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10814:16","text":"准备完成，一切就绪！"},{"id":"10814:17","text":"走吧，带我去跳舞！"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10814:18","text":"角度合适"},{"id":"10814:19","text":"这发一定会打中的"},{"id":"10814:20","text":"哼～这招怎么样！"},{"id":"10814:21","text":"我可要生气啦！"},{"id":"10814:22","text":"目标锁定!你跑不掉啦～"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10814:27","text":"哼～等我回去换个装备再来"},{"id":"10814:28","text":"呜…这算什么嘛！"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10814:26","text":"这也太强…有点想哭"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10814:25","text":"啊呀……好痛……"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10814:23","text":"轻轻松松～下次也请多指教啦，指挥官同志！"}]},{"tag":1020,"label":"失败","lines":[{"id":"10814:24","text":"失败也没关系……下次一定会赢的！加油！"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10814:0","text":"开始炮击！"},{"id":"10814:1","text":"进攻！"},{"id":"10814:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
