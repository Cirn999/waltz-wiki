{"schemaVersion":2,"cardId":6181,"modelId":10043,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10043:3","text":"突袭是门战争艺术，特别是突然出现在敌人的背后的那种。"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10043:28","text":"今后，我会一直追随着你。不再仅仅是在背后凝视你"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10043:4","text":"长官，你的鞋带也松了呢。自己处理下吧..嗯，别怕"},{"id":"10043:5","text":"与怪物战斗的人，应当小心自己不要成为怪物。当你远远凝视我时，我也在凝视你。"},{"id":"10043:6","text":"长官，就算我有点喜欢你，也和你没关系的"},{"id":"10043:7","text":"我是来打仗的，不是来交朋友的。"},{"id":"10043:8","text":"战车兽计划我是没权限接触，以后遇到猎虎可以问问她。"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10043:14","text":"那么好了，出发，都别拖后腿了！"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10043:15","text":"进攻！"},{"id":"10043:16","text":"Fire"},{"id":"10043:17","text":"速战速决！"},{"id":"10043:18","text":"注意风速！"},{"id":"10043:19","text":"其他人不要偷懒了！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10043:25","text":"丫～侧裙断裂！"},{"id":"10043:26","text":"装甲被击穿！"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10043:24","text":"正面重创了～呃…"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10043:20","text":"赢了不要傻笑，输了也不要跳啦。"},{"id":"10043:21","text":"不算很难，也许敌军不是主力。"}]},{"tag":1020,"label":"失败","lines":[{"id":"10043:22","text":"这次战败，责任在我。"},{"id":"10043:23","text":"没有就着泪水吃过面包的人，是不懂得人生味道的"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10043:0","text":"再狡猾的敌人也逃不过猎人的枪口。"},{"id":"10043:1","text":"猎物出现了，绝对不会让你逃跑的！"},{"id":"10043:2","text":"追捕猎物的任务，真是令人雀跃不已～"}]}]},"recruitmentStory":null}
