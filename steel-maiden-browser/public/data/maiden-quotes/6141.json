{"schemaVersion":2,"cardId":6141,"modelId":10030,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10030:3","text":"我老爸说，最好的防御就是进攻！"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10030:30","text":"这样一来，我就不回512重炮营了,以后得让爸爸过来看看你"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10030:4","text":"啊！有新任务了吗？"},{"id":"10030:5","text":"把我从512重型坦克歼击营调防过来，想必遇到棘手的敌人了吧。火力覆盖什么的就交给我吧。"},{"id":"10030:6","text":"我老爸参与过战车兽计划，长官想了解一些详细情报吗？下次见到他我会拷贝过来的……现在再点我也不会说的。"},{"id":"10030:7","text":"长官，没事别老点人家。"},{"id":"10030:8","text":"这次会梦见谁呢？醒来再告诉长官～"},{"id":"10030:9","text":"我回来了～爸爸想我了吗？"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10030:16","text":"当我站最前面，大家就不会变成炮灰！"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10030:17","text":"最强一击！"},{"id":"10030:18","text":"Feuer!!"},{"id":"10030:20","text":"给炮弹让让开！"},{"id":"10030:28","text":"射击！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10030:19","text":"这是给我挠痒痒吗？"},{"id":"10030:22","text":"擦伤而已！"},{"id":"10030:27","text":"嗯哼…"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10030:21","text":"这炮还真被打到了～"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10030:24","text":"行动失败，猎虎先撤退了！"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10030:23","text":"你还没有资格挑战CLASS A！"},{"id":"10030:25","text":"Freiheit！！！"}]},{"tag":1020,"label":"失败","lines":[{"id":"10030:26","text":"呃～～输了。我现在想和老爸去罗马广场撒豆喂鸽子。"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10030:0","text":"开始炮击！"},{"id":"10030:1","text":"进攻！"},{"id":"10030:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
