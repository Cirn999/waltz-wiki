{"schemaVersion":2,"cardId":9849,"modelId":10993,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10993:3","text":"新进钢舞姬秦舒荷前来报到，希望能将我分配到战车兽比较多的战线，这样我可以获得更多的历练。另外我对武术也略懂一二，就算遇到接近战也完全没问题。"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10993:4","text":"有奖励自然是好事，不过我的历练还远远没达到目标。所谓骄兵必败，所以我并不打算认领这枚勋章，东西就先寄放在长官那里吧。"}]}],"touch":[],"battle":[{"tag":1002,"label":"战斗对白","lines":[{"id":"10993:0","text":"开始炮击！"},{"id":"10993:1","text":"进攻！"},{"id":"10993:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
