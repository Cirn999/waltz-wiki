{"schemaVersion":2,"cardId":6155,"modelId":10514,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10514:3","text":"这位同学，准备好上课了吗？"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10514:30","text":"连老师也可以授勋吗？"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10514:4","text":"我去钓鱼的时候，干脆就放你们一天假好了。"},{"id":"10514:5","text":"一会儿去吃牡蛎吗？至于指挥官，他用不着吃这种东西的吧？"},{"id":"10514:6","text":"为了教学，我只好携带两种火炮。但工资只发一份……"},{"id":"10514:7","text":"指挥官先生，你今年多大了？领带有点松掉了呢～"},{"id":"10514:8","text":"哎？"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10514:13","text":"上课了，收起小说出发。"},{"id":"10514:14","text":"准备好就开始。"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10514:17","text":"没礼貌！"},{"id":"10514:18","text":"我来示范一下～"},{"id":"10514:19","text":"走开～"},{"id":"10514:20","text":"正确的攻击姿势。"},{"id":"10514:21","text":"正确瞄准。"},{"id":"10514:22","text":"老师先来～"},{"id":"10514:23","text":"这也是为了教学！"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10514:28","text":"哎？"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10514:27","text":"放尊重点！"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10514:26","text":"正确的击毁！"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10514:24","text":"教科书式的胜利！"}]},{"tag":1020,"label":"失败","lines":[{"id":"10514:25","text":"下课了，你们走吧。"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10514:0","text":"开始炮击！"},{"id":"10514:1","text":"进攻！"},{"id":"10514:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
