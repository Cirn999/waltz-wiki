{"schemaVersion":2,"cardId":8921,"modelId":13033,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"13033:3","text":"哟，这基地可够寒酸的啊，到底行不行？我可不想饿一顿饱一顿，每天早上一份香肠早餐必须满足啊。"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"13033:4","text":"习惯了这里的生活倒也还不坏，伪装的基地是有点不堪入目就是了，不过最重要的是能和长官在一起的话，这点小事不值一提，毕竟你不会让我觉得无聊。"}]}],"touch":[],"battle":[{"tag":1002,"label":"战斗对白","lines":[{"id":"13033:0","text":"开始炮击！"}]}]},"recruitmentStory":null}
