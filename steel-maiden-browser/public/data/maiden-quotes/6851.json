{"schemaVersion":2,"cardId":6851,"modelId":10617,"groups":{"recruit":[{"tag":1003,"label":"入队","lines":[{"id":"10617:3","text":"嗯.....长官喜欢我洗发香波的味道吗？"}]}],"honor":[{"tag":1029,"label":"授勋","lines":[{"id":"10617:30","text":"啊！！真没想到！爱死你了，长官！"}]}],"touch":[{"tag":1004,"label":"主界面触摸","lines":[{"id":"10617:4","text":"上战场最重要的溜得快～ 带上溜冰鞋就可以比长官的吉普车更快啦"},{"id":"10617:5","text":"呃，上次发给我的制服送laundry了，我穿成这样长官不会介意吧…"},{"id":"10617:6","text":"麻烦长官，问下，我腰部的钢管是干嘛用的？上次我拆了好像...也没出大事..."},{"id":"10617:7","text":"备用履带装在前胸有两个作用，一.履带坏了可以拆下来备用，二.挡住小口径炮弹。我希望都别发生，特别前者。"},{"id":"10617:8","text":"我其实很喜欢在基地里做个宅女，永远不要出击...和长官一起做点指挥工作…"},{"id":"10617:9","text":"设计出我这种舞装，是不是军部源铁已经不够用了？"}]}],"battle":[{"tag":1011,"label":"出征","lines":[{"id":"10617:15","text":"明天才是洗晒日，今天就穿这点出发吧！"},{"id":"10617:16","text":"衣服穿那么多干嘛，进了丛林一场雨下来你还不是得脱？"}]},{"tag":1012,"label":"攻击","lines":[{"id":"10617:17","text":"来，转过身来看看我吧"},{"id":"10617:18","text":"没想到吧～"},{"id":"10617:19","text":"嘿～"},{"id":"10617:20","text":"弹药充足！"},{"id":"10617:21","text":"Boom～～哈哈"},{"id":"10617:22","text":"命中你的要害！"},{"id":"10617:23","text":"盯着对方要害打！不要手软！"},{"id":"10617:24","text":"眼睛往哪里看？不要脸～"}]},{"tag":1016,"label":"轻伤","lines":[{"id":"10617:29","text":"好险～哎呦，似乎脚受伤了"}]},{"tag":1015,"label":"重伤","lines":[{"id":"10617:28","text":"居然还活着？"}]},{"tag":1018,"label":"撤退","lines":[{"id":"10617:27","text":"吖～～失误了！"}]},{"tag":1019,"label":"胜利","lines":[{"id":"10617:25","text":"“不战而屈人之兵，,善之善者也” 长官看过这本书吗？"}]},{"tag":1020,"label":"失败","lines":[{"id":"10617:26","text":"没打过仗的小孩才喜欢打仗吧～～哎呀哎呀～"}]},{"tag":1002,"label":"战斗对白","lines":[{"id":"10617:0","text":"开始炮击！"},{"id":"10617:1","text":"进攻！"},{"id":"10617:2","text":"准备攻击！"}]}]},"recruitmentStory":null}
