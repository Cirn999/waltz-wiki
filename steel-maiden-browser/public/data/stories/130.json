{"schemaVersion":1,"id":130,"sections":[{"id":"207001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20750],"start":0,"count":4}],"frames":[{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207001-PROLOGUE:20750:1","scriptId":20750,"text":"“新的捷径战模式已经开启。”","background":"/art/stories/zjm-066.webp","left":null,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207001-PROLOGUE:20750:2","scriptId":20750,"text":"“在此模式下，各位指挥官可以快速收集对应关卡的资源。”","background":"/art/stories/zjm-066.webp","left":null,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207001-PROLOGUE:20750:3","scriptId":20750,"text":"“当然，所有的消耗和奖励与原有的剧情模式完全相同。”","background":"/art/stories/zjm-066.webp","left":null,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207001-PROLOGUE:20750:4","scriptId":20750,"text":"“不用担心资源会有缺省的问题，请放心攻略～”","background":"/art/stories/zjm-066.webp","left":null,"right":11,"section":0,"shake":false}],"summaries":[]}
