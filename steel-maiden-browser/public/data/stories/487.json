{"schemaVersion":1,"id":487,"sections":[{"id":"1906001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20652],"start":0,"count":50},{"id":"1906001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20653],"start":50,"count":13}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:1","scriptId":20652,"text":"集合时间是早上十时，为了不迟到而早早等在了任务大厅——","background":"/art/stories/zjm-099.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:2","scriptId":20652,"text":"“大家都挺早的啊，我还以为会是第一个到呢。”","background":"/art/stories/zjm-099.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:3","scriptId":20652,"text":"“如果长官再不来的话，十分钟后就要去敲长官寝室的门了。”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:4","scriptId":20652,"text":"“谢啦～有你这样的队员，我这个队长就不会迟到啦。”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:5","scriptId":20652,"text":"“菲尼克斯看上去就是个很守时的人，我觉得还是不要迟到比较好～”","background":"/art/stories/zjm-099.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:6","scriptId":20652,"text":"“同感。”","background":"/art/stories/zjm-099.webp","left":596,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:7","scriptId":20652,"text":"“是啊，佩妮叫我那么早起来，头发都还没弄好呢。”","background":"/art/stories/zjm-099.webp","left":596,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:8","scriptId":20652,"text":"看来整个小队里也就佐伊和我是比较合拍的——在时间观念上没什么紧张感。","background":"/art/stories/zjm-099.webp","left":596,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:9","scriptId":20652,"text":"等了没一会儿就看到了那个熟悉的面孔，不，应该说是熟悉的面罩——多福莱尼的代理人菲尼克斯。","background":"/art/stories/zjm-099.webp","left":596,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:10","scriptId":20652,"text":"“对不起，我进死水的时候检查身份浪费了点时间。那么开始清点人数。”","background":"/art/stories/zjm-099.webp","left":596,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:11","scriptId":20652,"text":"菲尼克斯一边道歉一边开始清点人数。","background":"/art/stories/zjm-099.webp","left":596,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:12","scriptId":20652,"text":"“没关系，也就迟到了几分钟而已。”","background":"/art/stories/zjm-099.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:13","scriptId":20652,"text":"“人数和舞装都没问题，但怎么多了个机器人。”","background":"/art/stories/zjm-099.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:14","scriptId":20652,"text":"菲尼克斯弯下腰敲了敲跟在我身后的救助者1号，发出了“磅磅磅”的响声。","background":"/art/stories/zjm-099.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1134,"speaker":"救助者1号","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:15","scriptId":20652,"text":"“请问有什么事？”","background":"/art/stories/zjm-099.webp","left":1134,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:16","scriptId":20652,"text":"“诶！？”","background":"/art/stories/zjm-099.webp","left":1134,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:17","scriptId":20652,"text":"被救助者1号的回答吓了一条，菲尼克斯露出了惊讶的神情。","background":"/art/stories/zjm-099.webp","left":1134,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:18","scriptId":20652,"text":"“这个是委托波西娅做的自律搜救机器人，对我们的搜索工作会有帮助。”","background":"/art/stories/zjm-099.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:19","scriptId":20652,"text":"“哦，是那个波西娅博士吗？果然是发明奇才。”","background":"/art/stories/zjm-099.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:20","scriptId":20652,"text":"菲尼克斯恢复了镇定，虽然对救助者1号好像很有兴趣，但她还是努力克制住好奇心。","background":"/art/stories/zjm-099.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:21","scriptId":20652,"text":"“这和事先说好的不同，要追加一些运输费用。”","background":"/art/stories/zjm-099.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:22","scriptId":20652,"text":"“诶？机器人也要买票吗？”","background":"/art/stories/zjm-099.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:23","scriptId":20652,"text":"“就算不买票，作为大件行李也要额外收费。”","background":"/art/stories/zjm-099.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:24","scriptId":20652,"text":"“呃……好吧。”","background":"/art/stories/zjm-099.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:26","scriptId":20652,"text":"支付了额外的开销之后，我们跟随菲尼克斯到了死水基地的门口，一辆大型装甲运输车正等候着。","background":"/art/stories/zjm-099.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:27","scriptId":20652,"text":"“你们先上去吧，我和司机交待一下行程。”","background":"/art/stories/zjm-099.webp","left":1133,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:28","scriptId":20652,"text":"“好的。”","background":"/art/stories/zjm-099.webp","left":1133,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:30","scriptId":20652,"text":"“哇，里面好宽敞，竟然还有专门摆放舞装的机架。”","background":"/art/stories/zjm-099.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:31","scriptId":20652,"text":"佐伊先一步进入了运输车里，佩妮奈特莉维卡也跟着上了车。","background":"/art/stories/zjm-099.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:32","scriptId":20652,"text":"“这运输车的内建好厉害，本来存放货物的空间都被有效利用。”","background":"/art/stories/zjm-099.webp","left":740,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:33","scriptId":20652,"text":"“很难想象装甲车的里面打造得跟精致的客室一样。”","background":"/art/stories/zjm-099.webp","left":572,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:34","scriptId":20652,"text":"“很干净。”","background":"/art/stories/zjm-099.webp","left":572,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:35","scriptId":20652,"text":"大家都给出了一致好评。","background":"/art/stories/zjm-099.webp","left":572,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:36","scriptId":20652,"text":"“看来运输费贵也是有道理的。”","background":"/art/stories/zjm-099.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:37","scriptId":20652,"text":"“给客人带去最舒适的旅程体验是我们的待客之道。”","background":"/art/stories/zjm-099.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:38","scriptId":20652,"text":"这时菲尼克斯也进到了车厢内，她顺手关上了车门。","background":"/art/stories/zjm-099.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:39","scriptId":20652,"text":"“那么我们准备出发了，请各位都先坐到座位上。”","background":"/art/stories/zjm-099.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:42","scriptId":20652,"text":"经过长时间的运输，我们终于到达了目的地。","background":"/art/stories/zdbjbz-07.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:43","scriptId":20652,"text":"“到达目的了。”","background":"/art/stories/zdbjbz-07.webp","left":1133,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:44","scriptId":20652,"text":"“这里是哪里啊？”","background":"/art/stories/zdbjbz-07.webp","left":1133,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:45","scriptId":20652,"text":"车厢内没有安装窗户，取而代之的外部观测镜都是由菲尼克斯在查看，偶尔在休息站停车上个厕所时才能看到车外的风景。","background":"/art/stories/zdbjbz-07.webp","left":1133,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:46","scriptId":20652,"text":"虽然车内很舒服，但这种把握不了自己所在何处的旅途总是让人有些芒刺在背的感觉。","background":"/art/stories/zdbjbz-07.webp","left":1133,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:47","scriptId":20652,"text":"“里海的某中继站。”","background":"/art/stories/zdbjbz-07.webp","left":1133,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:48","scriptId":20652,"text":"“哦？里海？”","background":"/art/stories/zdbjbz-07.webp","left":1133,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:49","scriptId":20652,"text":"“是的，据可靠资料显示A-44舞装的携带者在这片区域出没。”","background":"/art/stories/zdbjbz-07.webp","left":1133,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:50","scriptId":20652,"text":"“有点意思，这资料有多可靠？万一找不到人怎么办。”","background":"/art/stories/zdbjbz-07.webp","left":1133,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:51","scriptId":20652,"text":"“具体资料来源属于商业机密，无可奉告。”","background":"/art/stories/zdbjbz-07.webp","left":1133,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:52","scriptId":20652,"text":"“目标人物肯定在这里出现过，是否能找到就看运气了，我们并不能给与保证。”","background":"/art/stories/zdbjbz-07.webp","left":1133,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-PROLOGUE:20652:53","scriptId":20652,"text":"菲尼克斯扔出两组照片，上面确实有着安妮的身影。而且从周围的环境和地标来看确实是这一带。","background":"/art/stories/zdbjbz-07.webp","left":1133,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-PROLOGUE:20652:54","scriptId":20652,"text":"“好吧，那么开工了。”","background":"/art/stories/zdbjbz-07.webp","left":1133,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-EPILOGUE:20653:1","scriptId":20653,"text":"这个地方的战车兽异常凶暴，如果在这里长时间逗留补给上会吃不消。","background":"/art/stories/zdbjbz-07.webp","left":1133,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-EPILOGUE:20653:2","scriptId":20653,"text":"“真是见鬼，这种地方要找人还真是有海底捞针的感觉。”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-EPILOGUE:20653:3","scriptId":20653,"text":"我敲了敲旁边铁疙瘩。","background":"/art/stories/zdbjbz-07.webp","left":4,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-EPILOGUE:20653:4","scriptId":20653,"text":"“怎么样？救助者1号，有没有什么收获？”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1134,"speaker":"救助者1号","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-EPILOGUE:20653:5","scriptId":20653,"text":"“探测到西南有强磁场。”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":1134,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-EPILOGUE:20653:6","scriptId":20653,"text":"“强磁场又怎么了？调查一下咯？”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":1134,"section":1,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-EPILOGUE:20653:7","scriptId":20653,"text":"“现在毫无头绪，救助者给出的讯息应该利用。”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-EPILOGUE:20653:8","scriptId":20653,"text":"维卡发表了自己的看法。","background":"/art/stories/zdbjbz-07.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-EPILOGUE:20653:9","scriptId":20653,"text":"“我们行动不便，能最短距离找到目标是最好的啦，现在只有先跟着救助者去看看？”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1906001-EPILOGUE:20653:10","scriptId":20653,"text":"这个时候负责侦查的佐伊和佩妮回来了。","background":"/art/stories/zdbjbz-07.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-EPILOGUE:20653:11","scriptId":20653,"text":"“西北方向有十多头战车兽，要绕过去有点困难。”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-EPILOGUE:20653:12","scriptId":20653,"text":"“西南方向没有战车兽，并且我发现有条可以行车的碎石道路。”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1906001-EPILOGUE:20653:13","scriptId":20653,"text":"“哦？看来这西南方向确实有问题，往那边前进！”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":584,"section":1,"shake":false}],"summaries":[]}
