{"schemaVersion":1,"id":-40748,"sections":[{"id":"script-20748","name":"原始脚本 20748","scripts":[20748],"start":0,"count":39}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20748:20748:1","scriptId":20748,"text":"关于旅行者的事情一时间虽然吵得沸沸扬扬，但不知情的民众大多也就初遇好奇。","background":"/art/stories/zjm-129.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20748:20748:2","scriptId":20748,"text":"特勤局倒是私底下设立了调查组，当然结果肯定是白忙活一场。","background":"/art/stories/zjm-129.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20748:20748:3","scriptId":20748,"text":"自从兰布达等一众旅行者离开死水之后，整件事情很快就冷却了下来。","background":"/art/stories/zjm-129.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20748:20748:4","scriptId":20748,"text":"毕竟人类还没从战车兽的威胁下解放，即便是外星人出现这种新闻也不可能成为持久话题。","background":"/art/stories/zjm-129.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20748:20748:5","scriptId":20748,"text":"不过兰布达本人其实并没有和死水完全切断关系……","background":"/art/stories/zjm-129.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:7","scriptId":20748,"text":"“终于到了联络的时间，这一等可是大半年啊。”","background":"/art/stories/zjm-094.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20748:20748:8","scriptId":20748,"text":"从上衣口袋里掏出一张小小的卡片，卡面的做工非常精致并且还浮现着淡淡的幽光。","background":"/art/stories/zjm-094.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20748:20748:9","scriptId":20748,"text":"这张卡片并不是哪里的贵宾卡，而是之前兰布达在信中留下的联络工具。","background":"/art/stories/zjm-094.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:10","scriptId":20748,"text":"“把卡面朝上放置到宽敞处……然后用手指按住一角……”","background":"/art/stories/zjm-094.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20748:20748:11","scriptId":20748,"text":"照着信中的说法，操作着卡牌——突然卡面上泛起了大量的白色光芒。","background":"/art/stories/zjm-094.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:12","scriptId":20748,"text":"“喔！？”","background":"/art/stories/zjm-094.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:13","scriptId":20748,"text":"“应该是兰布达的传送，这预兆式的光芒我可不会看错。”","background":"/art/stories/zjm-094.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20748:20748:14","scriptId":20748,"text":"紧接着从卡片中冒出的白光席卷了整个房间——","background":"/art/stories/zjm-094.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:15","scriptId":20748,"text":"“传送通道无异常，闭锁传送实验成功。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:16","scriptId":20748,"text":"“喔！果然是兰布达啊，不过你这样子好像变了不少？”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20748:20748:17","scriptId":20748,"text":"虽然着装有所变化，但那头光泽的长发和冷漠的表情再让人熟悉不过了。","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:18","scriptId":20748,"text":"“这服装是阿尔库涅大人的试作品，最近她很痴迷人类的服装设计。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:19","scriptId":20748,"text":"“原来是这样，看起来漂亮了很多，挺适合你的。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:20","scriptId":20748,"text":"“那、那是当然，阿尔库涅大人的设计岂是你这种人可以品头论足的。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20748:20748:21","scriptId":20748,"text":"仔细观察了一下兰布达，除了衣装外好像连骸虫都有了不小的变化。","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:22","scriptId":20748,"text":"“连骸虫都换过了吗？好像和以前不一样了。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:23","scriptId":20748,"text":"“……”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:24","scriptId":20748,"text":"“真是意外，你竟然也看得出来？不过也没有更换品种，只是进化了而已。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:25","scriptId":20748,"text":"“在韧性和攻击性能方面提升了不少。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:26","scriptId":20748,"text":"“好神奇，生物的进化是能反映在同一代的物种上的？”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:27","scriptId":20748,"text":"“哼，少见多怪。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:28","scriptId":20748,"text":"“回到正题，即便是在密闭的空间里，只要你带着这张卡，就能随时召唤我。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:29","scriptId":20748,"text":"“真方便，不愧是旅行者的高科技。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:30","scriptId":20748,"text":"“阿谀奉承就免了，被蝼蚁感谢我也不会高兴。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:31","scriptId":20748,"text":"“比之前能说会道了嘛。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:32","scriptId":20748,"text":"“……”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:33","scriptId":20748,"text":"“好了，传送通道测试已经没问题了，我也该走了，免得被其他人发现。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:34","scriptId":20748,"text":"“诶？那么快就要走了吗？”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:35","scriptId":20748,"text":"“这是阿尔库涅大人给予你的礼物，最好在遇到危险或者困境的时候再召唤我。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:36","scriptId":20748,"text":"“呃，你这么一说，信上好像是有提到过。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:37","scriptId":20748,"text":"“你倒是好好读信啊，上面的内容给我都背下来。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:38","scriptId":20748,"text":"“我也不知道那封信在读完会自动销毁，所以……”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:39","scriptId":20748,"text":"“算了，总之为了避免给你自己带来麻烦，使用的时候不要太招摇。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20748:20748:40","scriptId":20748,"text":"“嗯，知道了。”","background":"/art/stories/zjm-094.webp","left":4,"right":1198,"section":0,"shake":false}],"summaries":[]}
