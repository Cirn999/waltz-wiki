{"schemaVersion":1,"id":317,"sections":[{"id":"709001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20204],"start":0,"count":26},{"id":"709001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20205],"start":26,"count":26},{"id":"709002-PROLOGUE","name":"第 2 战 · 战前","scripts":[20206],"start":52,"count":28},{"id":"709002-EPILOGUE","name":"第 2 战 · 战后","scripts":[20207],"start":80,"count":24}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-PROLOGUE:20204:0","scriptId":20204,"text":"在地图上找到相应的坐标位置之后，我们告别阿芙多季娅开始朝着目标地点出发。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-PROLOGUE:20204:1","scriptId":20204,"text":"一路上——","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:2","scriptId":20204,"text":"“我就随口说说，没想到还真去啊……”","background":"/art/stories/zjm-047.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:3","scriptId":20204,"text":"“因为地理位置上离我们这里并不是很远，所以就算猜错了也不会有多大的消耗。”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:4","scriptId":20204,"text":"“是啊～一两天的车程就到了。”","background":"/art/stories/zjm-047.webp","left":740,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":897,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:5","scriptId":20204,"text":"“如果不遇到战车兽的话……”","background":"/art/stories/zjm-047.webp","left":740,"right":897,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:6","scriptId":20204,"text":"“为什么总觉得你们都是一副很高兴的样子？”","background":"/art/stories/zjm-047.webp","left":4,"right":897,"section":0,"shake":false},{"kind":"dialogue","head":897,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:7","scriptId":20204,"text":"“因为我们要去的地方好像是旅游胜地来着。”","background":"/art/stories/zjm-047.webp","left":4,"right":897,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:8","scriptId":20204,"text":"“长官这都不知道吗？情报有点落后啊～”","background":"/art/stories/zjm-047.webp","left":740,"right":897,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-PROLOGUE:20204:9","scriptId":20204,"text":"没想到会被佐伊说情报缺乏……我打开了地图，仔细看了看。","background":"/art/stories/zjm-047.webp","left":740,"right":897,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:10","scriptId":20204,"text":"“艾菲斯……完全不知道会有什么呢……”","background":"/art/stories/zjm-047.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-PROLOGUE:20204:11","scriptId":20204,"text":"这时候佐伊不知道从哪里摸出来一本旅游指南……","background":"/art/stories/zjm-047.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:12","scriptId":20204,"text":"“我给长官个提示～”","background":"/art/stories/zjm-047.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:13","scriptId":20204,"text":"“呃，为什么我车上会有这种东西？”","background":"/art/stories/zjm-047.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":742,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:14","scriptId":20204,"text":"“诶嘿嘿……”","background":"/art/stories/zjm-047.webp","left":742,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:15","scriptId":20204,"text":"（肯定是佐伊又把私人物品带上车了啊……）","background":"/art/stories/zjm-047.webp","left":742,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:16","scriptId":20204,"text":"“算了，我就不追究这种小事情了。”","background":"/art/stories/zjm-047.webp","left":742,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-PROLOGUE:20204:17","scriptId":20204,"text":"我打开旅游指南翻阅了起来。","background":"/art/stories/zjm-047.webp","left":742,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:18","scriptId":20204,"text":"“不过这旅游指南写的东西还挺全么。”","background":"/art/stories/zjm-047.webp","left":742,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-PROLOGUE:20204:19","scriptId":20204,"text":"艾菲斯……爱琴海周边的海滨小镇，周边有不少古城遗迹。","background":"/art/stories/zjm-047.webp","left":742,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-PROLOGUE:20204:20","scriptId":20204,"text":"快速阅读了一遍关于艾菲斯的章节，确实要比看地图要方便不少。","background":"/art/stories/zjm-047.webp","left":742,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:21","scriptId":20204,"text":"“恩……总觉得我好像已经猜错了……”","background":"/art/stories/zjm-047.webp","left":742,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:22","scriptId":20204,"text":"“怎么？是要折返吗？”","background":"/art/stories/zjm-047.webp","left":584,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-PROLOGUE:20204:23","scriptId":20204,"text":"今天开车的是佩妮，她放缓了车速。","background":"/art/stories/zjm-047.webp","left":584,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:24","scriptId":20204,"text":"“算了，去就去吧……现在也没什么头绪，到艾菲斯确认下也好。”","background":"/art/stories/zjm-047.webp","left":584,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709001-PROLOGUE:20204:25","scriptId":20204,"text":"“了解。”","background":"/art/stories/zjm-047.webp","left":584,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-EPILOGUE:20205:0","scriptId":20205,"text":"与此同时——","background":"/art/stories/zjm-047.webp","left":584,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-EPILOGUE:20205:1","scriptId":20205,"text":"某个老旧的遗迹里集结了几名旅行者。","background":"/art/stories/zjm-047.webp","left":584,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:2","scriptId":20205,"text":"“看样子就是这里了。”","background":"/art/stories/zjm-047.webp","left":12,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-EPILOGUE:20205:3","scriptId":20205,"text":"在一面巨大的石壁前聚集着西格玛奥米克戎伊塔等人……","background":"/art/stories/zjm-047.webp","left":12,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:4","scriptId":20205,"text":"“这个符号是不会错的。”","background":"/art/stories/zjm-047.webp","left":12,"right":421,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-EPILOGUE:20205:5","scriptId":20205,"text":"奥米克戎的目光注视着一个灰色的台座，上面已经布满了沙尘，在风化作用下，台座表面的花纹已经看不清本来的图案了。","background":"/art/stories/zjm-047.webp","left":12,"right":421,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-EPILOGUE:20205:6","scriptId":20205,"text":"奥米克戎把手放到了台座上……","background":"/art/stories/zjm-047.webp","left":12,"right":421,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-EPILOGUE:20205:7","scriptId":20205,"text":"“嗡——","background":"/art/stories/zjm-047.webp","left":12,"right":421,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-EPILOGUE:20205:9","scriptId":20205,"text":"整个石墙向后退了下去，地面上出现了一个向下的阶梯型入口。","background":"/art/stories/zjm-047.webp","left":12,"right":421,"section":1,"shake":true},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:10","scriptId":20205,"text":"“很好，这下我们可就立大功了～”","background":"/art/stories/zjm-047.webp","left":12,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:11","scriptId":20205,"text":"“那我们就下去吧。”","background":"/art/stories/zjm-047.webp","left":12,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:12","scriptId":20205,"text":"“恩。”","background":"/art/stories/zjm-047.webp","left":12,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:13","scriptId":20205,"text":"“这里就是先祖大人留下的‘东西’？”","background":"/art/stories/zjm-047.webp","left":400,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:14","scriptId":20205,"text":"“是的，会对旅行者纹章有反应，所以肯定没错了。”","background":"/art/stories/zjm-047.webp","left":400,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:15","scriptId":20205,"text":"“可以探险了～真棒～”","background":"/art/stories/zjm-047.webp","left":400,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:16","scriptId":20205,"text":"“奥米克戎队长，为了防止被人类发现这里，我们是不是要做点什么？”","background":"/art/stories/zjm-047.webp","left":400,"right":411,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-EPILOGUE:20205:17","scriptId":20205,"text":"经伊塔这么一说，奥米克戎和西格玛都停了一下。","background":"/art/stories/zjm-047.webp","left":400,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:18","scriptId":20205,"text":"“那伊塔你在这入口布置一些特异型义体，不管遇到什么都格杀勿论。”","background":"/art/stories/zjm-047.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:19","scriptId":20205,"text":"“以防万一，伊塔你也先留下，如果发生可以第一时间通报给我们。”","background":"/art/stories/zjm-047.webp","left":12,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:20","scriptId":20205,"text":"“遵命。”","background":"/art/stories/zjm-047.webp","left":411,"right":421,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709001-EPILOGUE:20205:21","scriptId":20205,"text":"于是奥米克戎一行就先走下了台阶。","background":"/art/stories/zjm-047.webp","left":411,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:22","scriptId":20205,"text":"“看上去挺深啊……”","background":"/art/stories/zjm-047.webp","left":411,"right":430,"section":1,"shake":false},{"kind":"dialogue","head":62,"speaker":"德尔塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:23","scriptId":20205,"text":"“并没什么关系吧，反正你我都是用异虫代步的。”","background":"/art/stories/zjm-047.webp","left":62,"right":430,"section":1,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:24","scriptId":20205,"text":"“不不，我的意思是这应该很费时间吧。”","background":"/art/stories/zjm-047.webp","left":62,"right":430,"section":1,"shake":false},{"kind":"dialogue","head":62,"speaker":"德尔塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:25","scriptId":20205,"text":"“我倒是对这地方挺感兴趣的。”","background":"/art/stories/zjm-047.webp","left":62,"right":430,"section":1,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"709001-EPILOGUE:20205:26","scriptId":20205,"text":"（怎么一个个都那么兴致勃勃……）","background":"/art/stories/zjm-047.webp","left":62,"right":430,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-PROLOGUE:20206:0","scriptId":20206,"text":"经过了两天的车程，我们终于抵达了这个叫艾菲斯的地方。","background":"/art/stories/zjm-047.webp","left":62,"right":430,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:1","scriptId":20206,"text":"“终于到了嘛……”","background":"/art/stories/zjm-047.webp","left":4,"right":430,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-PROLOGUE:20206:2","scriptId":20206,"text":"老样子，我们并没有直接进入艾菲斯小镇，而是选择停靠在小镇附近的守备站。","background":"/art/stories/zjm-047.webp","left":4,"right":430,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-PROLOGUE:20206:3","scriptId":20206,"text":"看到这里的守军一副懒洋洋的样子就能推测出这里基本没有受到过战车兽的光顾。","background":"/art/stories/zjm-047.webp","left":4,"right":430,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-PROLOGUE:20206:4","scriptId":20206,"text":"因此我们这几队钢舞姬整装到来的时候，反而把这些守军吓得不轻……","background":"/art/stories/zjm-047.webp","left":4,"right":430,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-PROLOGUE:20206:5","scriptId":20206,"text":"好在有奈乐，她很容易就把守军糊弄了过去。","background":"/art/stories/zjm-047.webp","left":4,"right":430,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:6","scriptId":20206,"text":"“许久不见，奈乐你现在好像越来越有官架子了么～”","background":"/art/stories/zjm-047.webp","left":4,"right":430,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:7","scriptId":20206,"text":"“还好吧，这种时候随便找个理由就行了，反正守军的任务是守护这里，知道太多对他们也没什么用。”","background":"/art/stories/zjm-047.webp","left":4,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:8","scriptId":20206,"text":"“哦哦～”","background":"/art/stories/zjm-047.webp","left":4,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":952,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:9","scriptId":20206,"text":"“长官，你有所不知～奈乐可是得到了她老爸的真传，在处理公务的时候可有一套了～”","background":"/art/stories/zjm-047.webp","left":4,"right":952,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:10","scriptId":20206,"text":"“我想也是～”","background":"/art/stories/zjm-047.webp","left":4,"right":952,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:11","scriptId":20206,"text":"“我可没有故意去学老爸那种官腔呢，长官不要听莉娜瞎说。”","background":"/art/stories/zjm-047.webp","left":4,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:12","scriptId":20206,"text":"“圆滑处世可是很多人都办不到的，如果奈乐有这家族遗传我觉得倒是可以多加利用～”","background":"/art/stories/zjm-047.webp","left":4,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:13","scriptId":20206,"text":"“呜！都怪莉娜多嘴，现在连长官也跟着笑我了！”","background":"/art/stories/zjm-047.webp","left":4,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":952,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:14","scriptId":20206,"text":"“是啊～祖传官腔～”","background":"/art/stories/zjm-047.webp","left":952,"right":103,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-PROLOGUE:20206:16","scriptId":20206,"text":"撇开莉娜和奈乐这边，我走到佩妮这边。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:17","scriptId":20206,"text":"“怎么样了？”","background":"/art/stories/zjm-047.webp","left":4,"right":null,"section":2,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:18","scriptId":20206,"text":"“基本的大坐标已经找到，现在我们需要更换成现地的精确地图了。”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:19","scriptId":20206,"text":"“比方说旅游指南么？”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":2,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:20","scriptId":20206,"text":"“恩，差不多，不过可能范围还要广泛一些，毕竟坐标比较模糊。”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":2,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:21","scriptId":20206,"text":"“我已经让姐姐她们去买地图了。”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-PROLOGUE:20206:22","scriptId":20206,"text":"这时候我看了一眼小镇的方向，发现佐伊和梅丽雅还有芙琳她们已经进到镇子里开始瞎转悠了。","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:23","scriptId":20206,"text":"“希望她们能买对吧……”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:24","scriptId":20206,"text":"（总觉得她们会买一堆没用的东西回来。）","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":2,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:25","scriptId":20206,"text":"“这里的风景倒是挺不错，还能看到爱琴海～”","background":"/art/stories/zjm-047.webp","left":572,"right":584,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-PROLOGUE:20206:26","scriptId":20206,"text":"虽然平日对风景并不怎么感兴趣，但是到了这里确实感受到了一些不一样的风土气息。","background":"/art/stories/zjm-047.webp","left":572,"right":584,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-PROLOGUE:20206:27","scriptId":20206,"text":"“仔细想想的话，能被分配到这里还真是份美差啊～”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-PROLOGUE:20206:28","scriptId":20206,"text":"最后……我们所有人都到小镇里逛了一下……","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-EPILOGUE:20207:0","scriptId":20207,"text":"远处的地平线上,太阳正在缓缓落下，昭示着黄昏的降临。","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-EPILOGUE:20207:1","scriptId":20207,"text":"在艾菲斯逛了一圈之后，我们回到了临时搭建的营地里。","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-EPILOGUE:20207:2","scriptId":20207,"text":"今天从小镇里买了很多烤肉，所以省去了准备晚餐的过程。","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-EPILOGUE:20207:3","scriptId":20207,"text":"我一边吃着当地的烤肉，一边开始研究起刚弄到手的地图。","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:4","scriptId":20207,"text":"“果然还是要看当地的地图才有感觉啊，所有道路和地标建筑都有标记，就连不起眼的设施和小路都一应俱全。”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:5","scriptId":20207,"text":"“是的，虽然上面还登载了不少没用的信息……”","background":"/art/stories/zjm-047.webp","left":4,"right":103,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-EPILOGUE:20207:6","scriptId":20207,"text":"地图的边边角角都登有广告，真是佩服这见缝插针的排版技术。","background":"/art/stories/zjm-047.webp","left":4,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:7","scriptId":20207,"text":"“恩，进一步看坐标的话，目标地点很可能是这个阿尔忒弥斯神庙？”","background":"/art/stories/zjm-047.webp","left":4,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:8","scriptId":20207,"text":"“哦，那个光秃秃的神庙？”","background":"/art/stories/zjm-047.webp","left":4,"right":740,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:9","scriptId":20207,"text":"“？佐伊你已经去过了？”","background":"/art/stories/zjm-047.webp","left":4,"right":740,"section":3,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:10","scriptId":20207,"text":"“我在这本指南里看到过。”","background":"/art/stories/zjm-047.webp","left":4,"right":740,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-EPILOGUE:20207:11","scriptId":20207,"text":"一抬头看到佐伊拿着本旅游指南，不过看封面应该不是之前看到过的那本。","background":"/art/stories/zjm-047.webp","left":4,"right":740,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:12","scriptId":20207,"text":"“你……又买了本新的？”","background":"/art/stories/zjm-047.webp","left":4,"right":740,"section":3,"shake":false},{"kind":"dialogue","head":742,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:13","scriptId":20207,"text":"“那是当然～信息都是要时常更新的嘛～”","background":"/art/stories/zjm-047.webp","left":4,"right":742,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:14","scriptId":20207,"text":"“唉……把脑筋都放在了这种地方啊……”","background":"/art/stories/zjm-047.webp","left":4,"right":742,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"709002-EPILOGUE:20207:15","scriptId":20207,"text":"接过佐伊的指南——除了神庙那标志性的巨大石柱外，这个神庙好像也没什么特别可以看的地方。","background":"/art/stories/zjm-047.webp","left":4,"right":742,"section":3,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:16","scriptId":20207,"text":"“这个小镇主要是以观光旅游业为主，再加上周围战车兽都销声匿迹了，所以理论上是个很安全的地方。”","background":"/art/stories/zjm-047.webp","left":584,"right":742,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:17","scriptId":20207,"text":"“佩妮你的意思是……？”","background":"/art/stories/zjm-047.webp","left":584,"right":4,"section":3,"shake":false},{"kind":"dialogue","head":589,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:18","scriptId":20207,"text":"“找错地方的可能性很高……”","background":"/art/stories/zjm-047.webp","left":589,"right":4,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:19","scriptId":20207,"text":"“嗯……虽然感觉不会有什么收获，不过明天还是过去看看吧……”","background":"/art/stories/zjm-047.webp","left":589,"right":4,"section":3,"shake":false},{"kind":"dialogue","head":742,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:20","scriptId":20207,"text":"“是啊，来都来了，有时间的话可以把周围的那些古城遗址也一起参观了～”","background":"/art/stories/zjm-047.webp","left":742,"right":4,"section":3,"shake":false},{"kind":"dialogue","head":952,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:21","scriptId":20207,"text":"“佐伊就只会想着玩～”","background":"/art/stories/zjm-047.webp","left":742,"right":952,"section":3,"shake":false},{"kind":"dialogue","head":746,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:22","scriptId":20207,"text":"“呃……”","background":"/art/stories/zjm-047.webp","left":746,"right":952,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"709002-EPILOGUE:20207:23","scriptId":20207,"text":"“如果明天没有收获的话，就要考虑重新调查破译的信息了。”","background":"/art/stories/zjm-047.webp","left":746,"right":103,"section":3,"shake":false}],"summaries":[]}
