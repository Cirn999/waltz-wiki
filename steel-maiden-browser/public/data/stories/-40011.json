{"schemaVersion":1,"id":-40011,"sections":[{"id":"script-20011","name":"原始脚本 20011","scripts":[20011],"start":0,"count":17}],"frames":[{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:1","scriptId":20011,"text":"“虽然不是我打击你们士气，但是又有一批钢舞姬朝这里来了……”","background":"/art/stories/zdbjbz-14.webp","left":608,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:2","scriptId":20011,"text":"“什么！？还有？？”","background":"/art/stories/zdbjbz-14.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:3","scriptId":20011,"text":"“数据不止一组嘛……其实有很多组……”","background":"/art/stories/zdbjbz-14.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:4","scriptId":20011,"text":"“那……我们这边既然已经知道了敌人的位置，应该优先采取攻击。”","background":"/art/stories/zdbjbz-14.webp","left":591,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:5","scriptId":20011,"text":"“没错，维卡！先发动火炮攻击！”","background":"/art/stories/zdbjbz-14.webp","left":591,"right":578,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:6","scriptId":20011,"text":"“Да！”（俄文：是）","background":"/art/stories/zdbjbz-14.webp","left":596,"right":578,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:7","scriptId":20011,"text":"“等等！还是先看看对手是什么人！？”","background":"/art/stories/zdbjbz-14.webp","left":596,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:8","scriptId":20011,"text":"“从数据上对照……带头的是索菲亚教授……的数据。”","background":"/art/stories/zdbjbz-14.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:9","scriptId":20011,"text":"“……！！！！！！！”","background":"/art/stories/zdbjbz-14.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:10","scriptId":20011,"text":"“我去！这种数据你也装进去了！？这还怎么玩，对手太强了，我们赶紧逃吧……”","background":"/art/stories/zdbjbz-14.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:11","scriptId":20011,"text":"“还行吧，索菲亚教授的数据只是从传闻里收集来的，并不是100%还原的。”","background":"/art/stories/zdbjbz-14.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:12","scriptId":20011,"text":"“那……还是得赶紧逃……”","background":"/art/stories/zdbjbz-14.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:13","scriptId":20011,"text":"“那个……我看到我姐姐了……”","background":"/art/stories/zdbjbz-14.webp","left":591,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:14","scriptId":20011,"text":"“哦！？佐伊也在？那好像可以一战……我想想战术……”","background":"/art/stories/zdbjbz-14.webp","left":591,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":590,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:15","scriptId":20011,"text":"“……”","background":"/art/stories/zdbjbz-14.webp","left":590,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:16","scriptId":20011,"text":"“……”","background":"/art/stories/zdbjbz-14.webp","left":590,"right":582,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20011:20011:17","scriptId":20011,"text":"“倒钩？”","background":"/art/stories/zdbjbz-14.webp","left":596,"right":582,"section":0,"shake":false}],"summaries":[]}
