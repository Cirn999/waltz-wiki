{"schemaVersion":1,"id":-20014,"sections":[{"id":"script-14","name":"原始脚本 14","scripts":[14],"start":0,"count":11}],"frames":[{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-14:14:1","scriptId":14,"text":"“你们是……？”","background":"/art/stories/zjm-166.webp","left":null,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-14:14:2","scriptId":14,"text":"“我们是103学院的学生，我是陈雯兰，她是夏虹萤。”","background":"/art/stories/zjm-166.webp","left":1158,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-14:14:3","scriptId":14,"text":"“你好。”","background":"/art/stories/zjm-166.webp","left":1170,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-14:14:4","scriptId":14,"text":"“诶？竟然是在校生？为什么会出现在这里啊？”","background":"/art/stories/zjm-166.webp","left":1170,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-14:14:5","scriptId":14,"text":"“这个说来话长了，先干掉战车兽吧。”","background":"/art/stories/zjm-166.webp","left":1158,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-14:14:6","scriptId":14,"text":"“是的，优先处理战车兽。对了，她是佐伊，我的跟班，你们协同作战吧。”","background":"/art/stories/zjm-166.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-14:14:7","scriptId":14,"text":"“诶！？什么叫跟班，我可是正式入伍的钢舞姬。”","background":"/art/stories/zjm-166.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-14:14:8","scriptId":14,"text":"“就这些战车兽，不足为惧。”","background":"/art/stories/zjm-166.webp","left":1158,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-14:14:9","scriptId":14,"text":"“确实，在小兰面前这点数量根本不值一提。”","background":"/art/stories/zjm-166.webp","left":1158,"right":1170,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-14:14:10","scriptId":14,"text":"“那可真是可靠啊。”","background":"/art/stories/zjm-166.webp","left":3,"right":1170,"section":0,"shake":false},{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-14:14:11","scriptId":14,"text":"（诶？什么情况？她们那么强的吗？）","background":"/art/stories/zjm-166.webp","left":3,"right":38,"section":0,"shake":false}],"summaries":[]}
