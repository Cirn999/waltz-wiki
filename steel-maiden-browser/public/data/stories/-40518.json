{"schemaVersion":1,"id":-40518,"sections":[{"id":"script-20518","name":"原始脚本 20518","scripts":[20518],"start":0,"count":41}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:1","scriptId":20518,"text":"波西娅的研究室——","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":855,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:2","scriptId":20518,"text":"“好了吗？”","background":"/art/stories/zjm-094.webp","left":855,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:3","scriptId":20518,"text":"“马上就好。”","background":"/art/stories/zjm-094.webp","left":855,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:4","scriptId":20518,"text":"兰布达淡淡地答道。","background":"/art/stories/zjm-094.webp","left":855,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:5","scriptId":20518,"text":"今天实验的主要目的是恢复埃普西隆的身体，不过看上去好像并不是很顺利。","background":"/art/stories/zjm-094.webp","left":855,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:6","scriptId":20518,"text":"“呼……可以了。”","background":"/art/stories/zjm-094.webp","left":855,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:7","scriptId":20518,"text":"兰布达微抖一下手中的烧瓶，里面的液体冒着棕黑色的光泽，倘若是不知情的人，可能会以为兰布达在用烧杯泡咖啡。","background":"/art/stories/zjm-094.webp","left":855,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:8","scriptId":20518,"text":"“过来，进去躺好。”","background":"/art/stories/zjm-094.webp","left":855,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:9","scriptId":20518,"text":"兰布达用另一只手敲了敲桌子，沿着她手指方向看去是一个放在地上的实验烧杯。","background":"/art/stories/zjm-094.webp","left":855,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":854,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:10","scriptId":20518,"text":"“呃……要进到那里面去啊？”","background":"/art/stories/zjm-094.webp","left":854,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:11","scriptId":20518,"text":"“没有更好的地方了，快进去。”","background":"/art/stories/zjm-094.webp","left":854,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:12","scriptId":20518,"text":"埃普西隆吐了吐舌头就爬进了空置的实验烧杯中。","background":"/art/stories/zjm-094.webp","left":854,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:13","scriptId":20518,"text":"接着兰布达蹲下身，把调制好的试剂往烧杯中灌注。","background":"/art/stories/zjm-094.webp","left":854,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":853,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:14","scriptId":20518,"text":"“哇，怎么是热的！好烫！好烫！”","background":"/art/stories/zjm-094.webp","left":853,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:15","scriptId":20518,"text":"“恩，是热的就对了，说明试剂和你的身体起了反应。”","background":"/art/stories/zjm-094.webp","left":853,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":853,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:16","scriptId":20518,"text":"“希望如此，但还是好烫啊！”","background":"/art/stories/zjm-094.webp","left":853,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:17","scriptId":20518,"text":"不消片刻兰布达就把烧杯给灌满了，烧杯中的液体还溢了一些出来。","background":"/art/stories/zjm-094.webp","left":853,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:18","scriptId":20518,"text":"埃普西隆则是静静地沉在杯底，从她紧闭双眼面无表情的样子来看，好像已经适应了刚才的热度。","background":"/art/stories/zjm-094.webp","left":853,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:19","scriptId":20518,"text":"就这样，约莫过了五分钟——","background":"/art/stories/zjm-094.webp","left":853,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":853,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:20","scriptId":20518,"text":"“噗哈！！！！呼……呼……呼……”","background":"/art/stories/zjm-094.webp","left":853,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:21","scriptId":20518,"text":"埃普西隆从烧杯里一跃而起，跳到了桌上。","background":"/art/stories/zjm-094.webp","left":853,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":854,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:22","scriptId":20518,"text":"“怎么还是没恢复原来的大小啊！！！兰布达你这个骗人的家伙！！”","background":"/art/stories/zjm-094.webp","left":854,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:23","scriptId":20518,"text":"“嗯，看来还是缺少一些关键的素材，代替品果然还是没有生效。”","background":"/art/stories/zjm-094.webp","left":854,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:24","scriptId":20518,"text":"就像是在实验之前就知道会有这样的结果，实验本身或许只是为了做一下验证。","background":"/art/stories/zjm-094.webp","left":854,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:25","scriptId":20518,"text":"兰布达再次蹲下身，烧杯提了起来倒入下水道中，并把周围溢出的液体都擦拭干净。","background":"/art/stories/zjm-094.webp","left":854,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":855,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:26","scriptId":20518,"text":"“那该怎么办啊！？等你下一次实验吗？”","background":"/art/stories/zjm-094.webp","left":855,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:27","scriptId":20518,"text":"当埃普西隆正在抱怨的时候——","background":"/art/stories/zjm-094.webp","left":855,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:28","scriptId":20518,"text":"“在聊什么呢？？好像挺开心啊。”","background":"/art/stories/zjm-094.webp","left":608,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:29","scriptId":20518,"text":"是波西娅和经常出现在她身边的那批人，当然其中还包括了埃普西隆和兰布达的主子艾丽莎（阿尔库涅）。","background":"/art/stories/zjm-094.webp","left":608,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:30","scriptId":20518,"text":"“那个……我正在考虑让埃普西隆出去透透气。”","background":"/art/stories/zjm-094.webp","left":608,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:31","scriptId":20518,"text":"“什么意思？如果埃普西隆趁机逃跑的话，那可就麻烦了。”","background":"/art/stories/zjm-094.webp","left":608,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:32","scriptId":20518,"text":"“因为埃普西隆现在变小了，各项身体素质也都渐渐变差了，特别在这阴暗潮湿的地下室，再这么下去可能会衰弱死。”","background":"/art/stories/zjm-094.webp","left":608,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:33","scriptId":20518,"text":"说到这里，兰布达向埃普西隆使了个眼色。","background":"/art/stories/zjm-094.webp","left":608,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":854,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:34","scriptId":20518,"text":"“诶！？原来我的身体那么糟糕了吗？我自己倒是不觉得……难道我快死了！？”","background":"/art/stories/zjm-094.webp","left":854,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:35","scriptId":20518,"text":"埃普西隆摸了摸自己的身体，还蹦跶了一下。","background":"/art/stories/zjm-094.webp","left":854,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:36","scriptId":20518,"text":"“…………”","background":"/art/stories/zjm-094.webp","left":854,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:37","scriptId":20518,"text":"（这个蠢货怎么自己还当真了……算了糊弄过去就行。最近实验一直失败，撵她出去也能让我清静一下。）","background":"/art/stories/zjm-094.webp","left":854,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:38","scriptId":20518,"text":"“这……如果按你所说的话，确实会有些麻烦，如果真的衰弱死了的话，我还得承担点责任啊。”","background":"/art/stories/zjm-094.webp","left":608,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20518:20518:39","scriptId":20518,"text":"波西娅转身看了看身着一席红衣的指挥官。","background":"/art/stories/zjm-094.webp","left":608,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:40","scriptId":20518,"text":"“我明白，看来也只能由我们小队来处理了。带埃普西隆去透透气是吧，小事一桩。”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20518:20518:41","scriptId":20518,"text":"“OK，那就交给你们了，记得定期回来我这里报告。”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false}],"summaries":[]}
