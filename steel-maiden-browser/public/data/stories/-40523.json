{"schemaVersion":1,"id":-40523,"sections":[{"id":"script-20523","name":"原始脚本 20523","scripts":[20523],"start":0,"count":3}],"frames":[{"kind":"dialogue","head":50,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20523:20523:1","scriptId":20523,"text":"“虽然很想打开，但是我觉得不应该浪费体力，箱子里可能都是变质的食物吧。”","background":"/art/stories/zdbjbz-04.webp","left":50,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20523:20523:2","scriptId":20523,"text":"“恩，可能性很高，走吧。”","background":"/art/stories/zdbjbz-04.webp","left":50,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20523:20523:3","scriptId":20523,"text":"于是埃普西隆她们路过了这个补给箱。","background":"/art/stories/zdbjbz-04.webp","left":50,"right":56,"section":0,"shake":false}],"summaries":[]}
