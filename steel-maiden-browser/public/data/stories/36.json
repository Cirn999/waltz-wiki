{"schemaVersion":1,"id":36,"sections":[{"id":"114007-PROLOGUE","name":"第 1 战 · 战前","scripts":[1190],"start":0,"count":15},{"id":"114007-EPILOGUE","name":"第 1 战 · 战后","scripts":[11180],"start":15,"count":8},{"id":"114008-PROLOGUE","name":"第 2 战 · 战前","scripts":[1200],"start":23,"count":9},{"id":"114008-EPILOGUE","name":"第 2 战 · 战后","scripts":[11190],"start":32,"count":12},{"id":"114009-PROLOGUE","name":"第 3 战 · 战前","scripts":[1210],"start":44,"count":17},{"id":"114009-EPILOGUE","name":"第 3 战 · 战后","scripts":[11200],"start":61,"count":14}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114007-PROLOGUE:1190:2","scriptId":1190,"text":"门口的战斗又持续了一段时间。","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114007-PROLOGUE:1190:3","scriptId":1190,"text":"渐渐的，毛熊们的进攻势头开始减弱了。","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114007-PROLOGUE:1190:4","scriptId":1190,"text":"“呼～～战车兽好像停止了攻击？？”","background":"/art/stories/zdjm-034.webp","left":31,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114007-PROLOGUE:1190:5","scriptId":1190,"text":"“干掉了那么多，我想它们也不会继续进来送死了吧。”","background":"/art/stories/zdjm-034.webp","left":31,"right":81,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114007-PROLOGUE:1190:6","scriptId":1190,"text":"“不过现在还不能放松，反而是最需要警惕的时刻。”","background":"/art/stories/zdjm-034.webp","left":3,"right":81,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114007-PROLOGUE:1190:9","scriptId":1190,"text":"突然，几枚炮弹落在了大门口的方向。","background":"/art/stories/zdjm-034.webp","left":3,"right":81,"section":0,"shake":true},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114007-PROLOGUE:1190:10","scriptId":1190,"text":"“看吧，果然敌人还没有放弃进攻。”","background":"/art/stories/zdjm-034.webp","left":3,"right":81,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114007-PROLOGUE:1190:11","scriptId":1190,"text":"“那个……有什么味道？？……”","background":"/art/stories/zdjm-034.webp","left":41,"right":81,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114007-PROLOGUE:1190:12","scriptId":1190,"text":"“……呜呃，好臭……”","background":"/art/stories/zdjm-034.webp","left":40,"right":81,"section":0,"shake":false},{"kind":"dialogue","head":86,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114007-PROLOGUE:1190:13","scriptId":1190,"text":"“呜呃……我也闻到了，毒气弹？？”","background":"/art/stories/zdjm-034.webp","left":40,"right":86,"section":0,"shake":false},{"kind":"dialogue","head":108,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114007-PROLOGUE:1190:14","scriptId":1190,"text":"“可能是臭鼬型战车兽的臭气弹……”","background":"/art/stories/zdjm-034.webp","left":108,"right":86,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114007-PROLOGUE:1190:15","scriptId":1190,"text":"“好臭好臭……，不行不行，要晕了……”","background":"/art/stories/zdjm-034.webp","left":108,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114007-PROLOGUE:1190:16","scriptId":1190,"text":"“这里通风比较差……不妙啊……”","background":"/art/stories/zdjm-034.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114007-PROLOGUE:1190:17","scriptId":1190,"text":"“现在门口应该没有那么多毛熊了，全员冲出大门口！”","background":"/art/stories/zdjm-034.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114007-PROLOGUE:1190:19","scriptId":1190,"text":"冲出大门一看，迎接我们的是一堆啮齿类战车兽，臭鼬型首当其冲……","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114007-EPILOGUE:11180:1","scriptId":11180,"text":"虽然解决了臭气弹的威胁，但是又被迫进入了开阔的战斗区域，非常不利。","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114007-EPILOGUE:11180:2","scriptId":11180,"text":"环顾四周，突然看到高台上面站着一个熟悉的身影。","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114007-EPILOGUE:11180:3","scriptId":11180,"text":"“……”","background":"/art/stories/zdjm-034.webp","left":null,"right":48,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114007-EPILOGUE:11180:4","scriptId":11180,"text":"“不明人形生物！！？？”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":1,"shake":false},{"kind":"dialogue","head":113,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114007-EPILOGUE:11180:5","scriptId":11180,"text":"“真的！？我也看到了！！”","background":"/art/stories/zdjm-034.webp","left":3,"right":113,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114007-EPILOGUE:11180:6","scriptId":11180,"text":"“啊，她下来了，是朝我们这边过来了……？”","background":"/art/stories/zdjm-034.webp","left":3,"right":113,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114007-EPILOGUE:11180:7","scriptId":11180,"text":"教官的声音立刻通过便携式无线电传了过来。","background":"/art/stories/zdjm-034.webp","left":3,"right":113,"section":1,"shake":false},{"kind":"dialogue","head":220,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114007-EPILOGUE:11180:8","scriptId":11180,"text":"“什么！！人形生物？？我马上就来！！。”","background":"/art/stories/zdjm-034.webp","left":3,"right":220,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114008-PROLOGUE:1200:2","scriptId":1200,"text":"最坏的情况，被啮齿类战车兽包围，还夹杂了一只人形战车兽……","background":"/art/stories/zdjm-034.webp","left":3,"right":220,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114008-PROLOGUE:1200:3","scriptId":1200,"text":"“情况非常不妙啊，趁那东西还没靠近之前，先把周围的战车兽干掉，不然等会儿都逃都逃不掉……”","background":"/art/stories/zdjm-034.webp","left":3,"right":220,"section":2,"shake":false},{"kind":"dialogue","head":86,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114008-PROLOGUE:1200:4","scriptId":1200,"text":"“不行……，我的手抖个不停……”","background":"/art/stories/zdjm-034.webp","left":3,"right":86,"section":2,"shake":false},{"kind":"dialogue","head":104,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114008-PROLOGUE:1200:5","scriptId":1200,"text":"“开炮！！！！”","background":"/art/stories/zdjm-034.webp","left":104,"right":86,"section":2,"shake":false},{"kind":"dialogue","head":82,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114008-PROLOGUE:1200:6","scriptId":1200,"text":"“是！”","background":"/art/stories/zdjm-034.webp","left":104,"right":82,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114008-PROLOGUE:1200:9","scriptId":1200,"text":"奈乐大声一喝，莉娜反射性的扣下了发射的扳机……一发炮弹飞了出去，然而并没有命中任何目标。","background":"/art/stories/zdjm-034.webp","left":104,"right":82,"section":2,"shake":true},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114008-PROLOGUE:1200:10","scriptId":1200,"text":"“在这种时刻即使害怕，我们也不能放弃希望，至少要撑到教官下来。”","background":"/art/stories/zdjm-034.webp","left":103,"right":82,"section":2,"shake":false},{"kind":"dialogue","head":90,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114008-PROLOGUE:1200:11","scriptId":1200,"text":"“是！”","background":"/art/stories/zdjm-034.webp","left":103,"right":90,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114008-PROLOGUE:1200:12","scriptId":1200,"text":"（哦呀，奈乐在控制队员情绪上面很果断啊。）","background":"/art/stories/zdjm-034.webp","left":3,"right":90,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114008-EPILOGUE:11190:1","scriptId":11190,"text":"快速清理掉了一些臭鼬，不过人形怪物已经走到那群战车兽中间……","background":"/art/stories/zdjm-034.webp","left":3,"right":90,"section":3,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114008-EPILOGUE:11190:2","scriptId":11190,"text":"“哟，远看没注意。这不是上次在齐格菲那边遇到的那队钢舞姬么～”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114008-EPILOGUE:11190:3","scriptId":11190,"text":"“……”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114008-EPILOGUE:11190:4","scriptId":11190,"text":"“……”","background":"/art/stories/zdjm-034.webp","left":103,"right":48,"section":3,"shake":false},{"kind":"dialogue","head":50,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114008-EPILOGUE:11190:5","scriptId":11190,"text":"“还是不说话吗？真是没礼貌呢～”","background":"/art/stories/zdjm-034.webp","left":103,"right":50,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114008-EPILOGUE:11190:6","scriptId":11190,"text":"（恩，先试试交谈看看……）","background":"/art/stories/zdjm-034.webp","left":3,"right":50,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114008-EPILOGUE:11190:7","scriptId":11190,"text":"“怎么称呼……？”","background":"/art/stories/zdjm-034.webp","left":3,"right":50,"section":3,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114008-EPILOGUE:11190:8","scriptId":11190,"text":"“啊～终于有回答我的了～”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":3,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114008-EPILOGUE:11190:9","scriptId":11190,"text":"“我叫埃普西隆，是来送你们去死的人～”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114008-EPILOGUE:11190:10","scriptId":11190,"text":"“诶！？”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":3,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114008-EPILOGUE:11190:11","scriptId":11190,"text":"“啊哈哈哈哈哈～终于有机会说出来了，这句台词读起来感觉真不错～”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114008-EPILOGUE:11190:12","scriptId":11190,"text":"（呃……果然不是能正常交流的生物吗……）","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114009-PROLOGUE:1210:2","scriptId":1210,"text":"气氛诡异，看来战斗是不可避免的了。","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114009-PROLOGUE:1210:3","scriptId":1210,"text":"（教官赶来之前，先拖点时间……）","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114009-PROLOGUE:1210:4","scriptId":1210,"text":"“那个……埃普西隆，你来这里有什么目的？”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":4,"shake":false},{"kind":"dialogue","head":50,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114009-PROLOGUE:1210:5","scriptId":1210,"text":"“目的？？我想想……”","background":"/art/stories/zdjm-034.webp","left":3,"right":50,"section":4,"shake":false},{"kind":"dialogue","head":50,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114009-PROLOGUE:1210:6","scriptId":1210,"text":"“嗯……呜……呃……哦，对了，目的是陪兰布达出来逛逛？”","background":"/art/stories/zdjm-034.webp","left":3,"right":50,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114009-PROLOGUE:1210:7","scriptId":1210,"text":"（诶？这也算回答？）","background":"/art/stories/zdjm-034.webp","left":3,"right":50,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114009-PROLOGUE:1210:8","scriptId":1210,"text":"“兰布达是什么……？”","background":"/art/stories/zdjm-034.webp","left":3,"right":50,"section":4,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114009-PROLOGUE:1210:9","scriptId":1210,"text":"“兰布达就是兰布达啊～啊……和你们解释太麻烦了，我们来玩玩吧。”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114009-PROLOGUE:1210:10","scriptId":1210,"text":"“玩玩？？”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114009-PROLOGUE:1210:11","scriptId":1210,"text":"只见连结在埃普西隆头部两侧类似炮台的东西，开始发出一阵阵光芒。","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114009-PROLOGUE:1210:12","scriptId":1210,"text":"“嗯？”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":4,"shake":false},{"kind":"dialogue","head":104,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114009-PROLOGUE:1210:13","scriptId":1210,"text":"“快闪开！！”","background":"/art/stories/zdjm-034.webp","left":104,"right":48,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114009-PROLOGUE:1210:16","scriptId":1210,"text":"听到奈乐一把推开我，硬是用装甲抗住了飞来的炮弹……","background":"/art/stories/zdjm-034.webp","left":104,"right":48,"section":4,"shake":true},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114009-PROLOGUE:1210:17","scriptId":1210,"text":"“哦呀，反应还不错嘛～～”","background":"/art/stories/zdjm-034.webp","left":104,"right":48,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114009-PROLOGUE:1210:18","scriptId":1210,"text":"“奈乐，不要紧吧！？”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":4,"shake":false},{"kind":"dialogue","head":108,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114009-PROLOGUE:1210:19","scriptId":1210,"text":"“恩，还好……”","background":"/art/stories/zdjm-034.webp","left":3,"right":108,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114009-PROLOGUE:1210:20","scriptId":1210,"text":"一场恶战随即展开。","background":"/art/stories/zdjm-034.webp","left":3,"right":108,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114009-EPILOGUE:11200:1","scriptId":11200,"text":"由于是开阔地形，所以埃普西隆周围的战车兽可以一拥而上，战局对我们非常不利。","background":"/art/stories/zdjm-034.webp","left":3,"right":108,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114009-EPILOGUE:11200:2","scriptId":11200,"text":"并且由于还要保护我这个指挥官，奈乐她们并不能很好的集中精神在进攻上。","background":"/art/stories/zdjm-034.webp","left":3,"right":108,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114009-EPILOGUE:11200:3","scriptId":11200,"text":"（唉……在这种时候我真是个累赘……）","background":"/art/stories/zdjm-034.webp","left":3,"right":108,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114009-EPILOGUE:11200:4","scriptId":11200,"text":"战斗越持久就对我们越不利。","background":"/art/stories/zdjm-034.webp","left":3,"right":108,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114009-EPILOGUE:11200:5","scriptId":11200,"text":"最先出状况的是佐伊，她的脚部和肩部均有一定程度的损伤，开始面露疲色。","background":"/art/stories/zdjm-034.webp","left":3,"right":108,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114009-EPILOGUE:11200:6","scriptId":11200,"text":"“佐伊，你先退后，和我站一起就行了。”","background":"/art/stories/zdjm-034.webp","left":3,"right":108,"section":5,"shake":false},{"kind":"dialogue","head":34,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114009-EPILOGUE:11200:7","scriptId":11200,"text":"“好……好的。”","background":"/art/stories/zdjm-034.webp","left":3,"right":34,"section":5,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114009-EPILOGUE:11200:8","scriptId":11200,"text":"“哦呀，还没打完就想跑？”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114009-EPILOGUE:11200:10","scriptId":11200,"text":"埃普西隆看准时机射出一发炮弹。","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":5,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114009-EPILOGUE:11200:11","scriptId":11200,"text":"“佐伊当心！！”","background":"/art/stories/zdjm-034.webp","left":103,"right":48,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114009-EPILOGUE:11200:12","scriptId":11200,"text":"奈乐虽然发出了警告，但是已经为时已晚，炮弹眼看就要命中佐伊。","background":"/art/stories/zdjm-034.webp","left":103,"right":48,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114009-EPILOGUE:11200:15","scriptId":11200,"text":"说时迟那时快，一道身影从天而降落在了炮弹和佐伊的中间，硬生生地截断了炮弹的行进路线。地面被震裂出一道巨大的口子整个陷了下去，同时掀起了大量尘土。","background":"/art/stories/zdjm-034.webp","left":103,"right":48,"section":5,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114009-EPILOGUE:11200:16","scriptId":11200,"text":"“呼……”","background":"/art/stories/zdjm-034.webp","left":211,"right":48,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114009-EPILOGUE:11200:17","scriptId":11200,"text":"尘埃散尽，原来是索菲亚教官以一个极其漂亮的着地姿势闪亮登场……","background":"/art/stories/zdjm-034.webp","left":211,"right":48,"section":5,"shake":false}],"summaries":["恩，窄口作战还是很成功的嘛……","再次遭遇人形战车兽。","教官好慢……另外，要怎么逃呢？"]}
