{"schemaVersion":1,"id":-40517,"sections":[{"id":"script-20517","name":"原始脚本 20517","scripts":[20517],"start":0,"count":37}],"frames":[{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:1","scriptId":20517,"text":"“啊……这……这个旗语是……”","background":"/art/stories/zjm-099.webp","left":11,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:2","scriptId":20517,"text":"“有什么问题吗？”","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20517:20517:3","scriptId":20517,"text":"看到芮蓓一脸惊慌失措的样子，我不自觉地问道。","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:4","scriptId":20517,"text":"“您从哪儿弄到这套旗语暗号的，可以不要用这套旗语来兑换吗……我就当没看到……”（小声）","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:5","scriptId":20517,"text":"“？？？”","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20517:20517:6","scriptId":20517,"text":"芮蓓这么一说，我的好奇心更重了。","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:7","scriptId":20517,"text":"“是这样的——","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:8","scriptId":20517,"text":"“哦呀？芮蓓有什么悄悄话要和长官说吗？”","background":"/art/stories/zjm-099.webp","left":11,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20517:20517:9","scriptId":20517,"text":"正当芮蓓要对我说些什么的时候，从背后听到了波西娅的声音。","background":"/art/stories/zjm-099.webp","left":11,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:10","scriptId":20517,"text":"“啊…没，没什么……”","background":"/art/stories/zjm-099.webp","left":11,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:11","scriptId":20517,"text":"“哦？波西娅？”","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20517:20517:12","scriptId":20517,"text":"说起来这次奖励物资的发放负责人好像是波西娅来着。","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:13","scriptId":20517,"text":"“长官在兑换旗语？我看看～哦呀呀！！长官是来兑换这套旗语的！？果然都是缘分～”","background":"/art/stories/zjm-099.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:14","scriptId":20517,"text":"“什么情况？？这套旗语有什么问题吗？”","background":"/art/stories/zjm-099.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20517:20517:15","scriptId":20517,"text":"被波西娅说得云里雾里。","background":"/art/stories/zjm-099.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:16","scriptId":20517,"text":"“我这就去取‘奖品’～”","background":"/art/stories/zjm-099.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20517:20517:17","scriptId":20517,"text":"说完波西娅就笑呵呵地走开了。","background":"/art/stories/zjm-099.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:19","scriptId":20517,"text":"“长官，不赖我啊，我已经提醒过您了……”","background":"/art/stories/zjm-099.webp","left":11,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20517:20517:20","scriptId":20517,"text":"芮蓓一脸歉意地看着我。","background":"/art/stories/zjm-099.webp","left":11,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20517:20517:21","scriptId":20517,"text":"大约过了五分钟左右，波西娅回来了，她手里还牵着一头战车兽！？","background":"/art/stories/zjm-099.webp","left":11,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:22","scriptId":20517,"text":"“给，你的奖励～”","background":"/art/stories/zjm-099.webp","left":11,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":1094,"speaker":"FFV304MK2","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:23","scriptId":20517,"text":"“…………”","background":"/art/stories/zjm-099.webp","left":1094,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20517:20517:24","scriptId":20517,"text":"波西娅把缰绳递了出来，但我完全没有要接的意思。","background":"/art/stories/zjm-099.webp","left":1094,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:25","scriptId":20517,"text":"“这东西真的不要紧吗？不会突然攻击我吧……”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:26","scriptId":20517,"text":"“不要紧啦，这家伙是我根据之前捕获的战车兽为原型做出来的拟态版。”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:27","scriptId":20517,"text":"“是不是很像真的～？”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:28","scriptId":20517,"text":"“何止是像，简直是一模一样……真是被你吓得不轻。”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20517:20517:29","scriptId":20517,"text":"这下我总算明白为什么芮蓓会有刚才那样惊恐的表情了。","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:30","scriptId":20517,"text":"（带着这东西进战场的话，怕不是会被人集火攻击……）","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:31","scriptId":20517,"text":"“如果可以的话，请把它带上战场，我想测试一下它的战斗数据。”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:32","scriptId":20517,"text":"“喂喂……不是吧……真要这么玩？我被友军误伤了怎么办？”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:33","scriptId":20517,"text":"“那就算你工伤咯～我会赔钱的啦～要不尤拉也可以赔你～”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:34","scriptId":20517,"text":"“呃…………”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:35","scriptId":20517,"text":"“好啦，你就收着吧，测试出的数据我会高额收购的，你可是大赚一票啊。”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:36","scriptId":20517,"text":"“我才不想拿这种奖励呢……”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20517:20517:37","scriptId":20517,"text":"虽然只是抱怨，但我还是接过了缰绳。","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20517:20517:38","scriptId":20517,"text":"“换都换了，恕不退货。”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false}],"summaries":[]}
