{"schemaVersion":1,"id":-40149,"sections":[{"id":"script-20149","name":"原始脚本 20149","scripts":[20149],"start":0,"count":19}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20149:20149:1","scriptId":20149,"text":"想都没有想过事情到最后竟然会是这个发展方向……","background":"/art/stories/zjm-098.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20149:20149:2","scriptId":20149,"text":"敲了敲团长室的大门，得到许可后我走了进去。","background":"/art/stories/zjm-098.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:3","scriptId":20149,"text":"“恩，回来啦～”","background":"/art/stories/zjm-098.webp","left":547,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:4","scriptId":20149,"text":"“是……是的……”","background":"/art/stories/zjm-098.webp","left":547,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":553,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:5","scriptId":20149,"text":"“别那么一副唯唯诺诺的样子，我又不会吃了你。”","background":"/art/stories/zjm-098.webp","left":553,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:6","scriptId":20149,"text":"“那个……这次的报告书我带来了。”","background":"/art/stories/zjm-098.webp","left":553,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":549,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:7","scriptId":20149,"text":"“哦哦～我很期待你的报告啊，搞出那么大动静，弄得鸡飞狗跳～”","background":"/art/stories/zjm-098.webp","left":549,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:8","scriptId":20149,"text":"“呃……这是个不幸的意外……”","background":"/art/stories/zjm-098.webp","left":549,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20149:20149:9","scriptId":20149,"text":"我从怀里掏出了一本笔记本递给维多利亚团长。","background":"/art/stories/zjm-098.webp","left":549,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":555,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:10","scriptId":20149,"text":"“哇……好破旧啊……这是报告书？”","background":"/art/stories/zjm-098.webp","left":555,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":555,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:11","scriptId":20149,"text":"“信使计划？”","background":"/art/stories/zjm-098.webp","left":555,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:12","scriptId":20149,"text":"“是的……这上面记录了事件的全部始末。”","background":"/art/stories/zjm-098.webp","left":555,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":557,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:13","scriptId":20149,"text":"“恩，还是航空局出品的笔记本么～”","background":"/art/stories/zjm-098.webp","left":557,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20149:20149:14","scriptId":20149,"text":"维多利亚用两个手指捏住笔记本的一角提了起来仔细打量，就好似在研究一块破抹布一样，来来回回看了又看。","background":"/art/stories/zjm-098.webp","left":557,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:15","scriptId":20149,"text":"“恩，本来是纪念品，不过那会儿是非常时期，我就拿来用了……”","background":"/art/stories/zjm-098.webp","left":557,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:16","scriptId":20149,"text":"“确实是有点脏……不过不影响阅读，因为中间遇到了太多突发状况……”","background":"/art/stories/zjm-098.webp","left":557,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":553,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:17","scriptId":20149,"text":"“我想也是……好了，我等会儿会看的，你可以出去了。”","background":"/art/stories/zjm-098.webp","left":553,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20149:20149:18","scriptId":20149,"text":"“是。”","background":"/art/stories/zjm-098.webp","left":553,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20149:20149:19","scriptId":20149,"text":"门“啪嗒”一声关上了。","background":"/art/stories/zjm-098.webp","left":553,"right":4,"section":0,"shake":false}],"summaries":[]}
