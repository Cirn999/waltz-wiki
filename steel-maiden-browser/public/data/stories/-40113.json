{"schemaVersion":1,"id":-40113,"sections":[{"id":"script-20113","name":"原始脚本 20113","scripts":[20113],"start":0,"count":32}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20113:20113:0","scriptId":20113,"text":"经过一番激战，德尔塔和兰布达稍微有些疲倦了，反观我们……","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20113:20113:1","scriptId":20113,"text":"已经疲于奔命。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20113:20113:2","scriptId":20113,"text":"“周围的原核体都已经被消灭掉了……。”","background":"/art/stories/zjm-047.webp","left":null,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":62,"speaker":"德尔塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20113:20113:3","scriptId":20113,"text":"“恩，比想象中的要有战斗力。”","background":"/art/stories/zjm-047.webp","left":62,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":62,"speaker":"德尔塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20113:20113:4","scriptId":20113,"text":"“兰布达你也玩够了吧，我们可以走了吗？再留在这里好像也没什么可以收集的数据了。”","background":"/art/stories/zjm-047.webp","left":62,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20113:20113:5","scriptId":20113,"text":"“恩，差不多了……估计埃普西隆已经在外面等得不耐烦了。”","background":"/art/stories/zjm-047.webp","left":62,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":62,"speaker":"德尔塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20113:20113:6","scriptId":20113,"text":"“那么就走咯？”","background":"/art/stories/zjm-047.webp","left":62,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20113:20113:7","scriptId":20113,"text":"“可以。”","background":"/art/stories/zjm-047.webp","left":62,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20113:20113:8","scriptId":20113,"text":"说完，这两人就变成一串数字离开了这个虚拟世界。","background":"/art/stories/zjm-047.webp","left":62,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:9","scriptId":20113,"text":"“这……她们到底是来干什么的……”","background":"/art/stories/zjm-047.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:10","scriptId":20113,"text":"“不知道，但是异常强大，真是难得的经验……”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:11","scriptId":20113,"text":"“真是让人捏把汗，虽然在这虚拟世界，死亡其实也没什么，只不过想想还是有点后怕呢。”","background":"/art/stories/zjm-047.webp","left":572,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:12","scriptId":20113,"text":"“强敌……”","background":"/art/stories/zjm-047.webp","left":572,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20113:20113:13","scriptId":20113,"text":"","background":"/art/stories/zjm-047.webp","left":572,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:14","scriptId":20113,"text":"“干得不错，让我收集到了有用的数据～”","background":"/art/stories/zjm-047.webp","left":572,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:15","scriptId":20113,"text":"“您刚才去哪儿了……”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:16","scriptId":20113,"text":"“刚刚我一直在记录数据啦～”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:17","scriptId":20113,"text":"“还想让你帮我们弄些作弊程序呢……”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:18","scriptId":20113,"text":"“哼，不是拟真的战斗根本测不到有用的数据。你这不懂科学的家伙。”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:19","scriptId":20113,"text":"“好了，可以返航了——”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20113:20113:20","scriptId":20113,"text":"还没说完，只见天空突然“吧嗒”一下变暗了……我们从机器中醒来。","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:21","scriptId":20113,"text":"“啊！！我的数据。”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20113:20113:22","scriptId":20113,"text":"只听到波西娅本人在那里大叫，而刚醒来的众人并不知道最后发生了什么。","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20113:20113:24","scriptId":20113,"text":"只是看见波西娅在那里玩命般的敲击键盘……","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20113:20113:25","scriptId":20113,"text":"这次的征召任务结果上来还不错……虽然战斗数据损失了一大半，但好像可以修复，就是非常耗费时间和精力……","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20113:20113:26","scriptId":20113,"text":"波西娅仍旧照单支付了大笔的报酬给我们，真是出手阔绰的大小姐。","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:27","scriptId":20113,"text":"“没想到最后的最后还是让她们摆了一道啊……”","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:28","scriptId":20113,"text":"“恩，最后把程序抹消这点还真是没想到啊……”","background":"/art/stories/zjm-094.webp","left":4,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:29","scriptId":20113,"text":"“她们这能力简直是作弊，有这能力的话，也难怪会有那种游刃有余的态度，让人感觉就是在玩一样……”","background":"/art/stories/zjm-094.webp","left":572,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:30","scriptId":20113,"text":"“恩。”","background":"/art/stories/zjm-094.webp","left":572,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20113:20113:31","scriptId":20113,"text":"“说不定她们就是在玩啊……”","background":"/art/stories/zjm-094.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20113:20113:32","scriptId":20113,"text":"通过这次的模拟数据收集，波西娅又开发出了不少新品种的舞装，不过这都是后话了。","background":"/art/stories/zjm-094.webp","left":4,"right":596,"section":0,"shake":false}],"summaries":[]}
