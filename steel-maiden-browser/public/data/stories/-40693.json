{"schemaVersion":1,"id":-40693,"sections":[{"id":"script-20693","name":"原始脚本 20693","scripts":[20693],"start":0,"count":52}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20693:20693:1","scriptId":20693,"text":"距离普希来到地球已经有大约一周的时间。","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20693:20693:2","scriptId":20693,"text":"由于是丝黛罗佩的召唤所以普希不敢怠慢。","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20693:20693:3","scriptId":20693,"text":"根据丝黛罗佩的指示，她到达地球以后第一步是观察和学习。","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:4","scriptId":20693,"text":"“记录更新，关于人类文明已经进行了初步学习。”","background":"/art/stories/zjm-067.webp","left":1186,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:5","scriptId":20693,"text":"“目前的形式也已经理解了，就是还不清楚上位大人们对于地球今后的考量。”","background":"/art/stories/zjm-067.webp","left":1186,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":825,"speaker":"丝黛罗佩","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:6","scriptId":20693,"text":"“不用那么详细的报告，普希。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:7","scriptId":20693,"text":"“是，丝黛罗佩大人……哦，不，赛琳娜大人。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":825,"speaker":"丝黛罗佩","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:8","scriptId":20693,"text":"“无妨，我们单独见面的时候，随便你怎么叫都可以。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:9","scriptId":20693,"text":"“是。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":825,"speaker":"丝黛罗佩","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:10","scriptId":20693,"text":"“那么关于这个星球你的初步看法是什么？”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:11","scriptId":20693,"text":"“地球的文明还很年轻，但也正因为年轻，多样性很突出。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":825,"speaker":"丝黛罗佩","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:12","scriptId":20693,"text":"“着眼点很有意思，不像泰莱塔，嫌弃这里的文明太过低级。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:13","scriptId":20693,"text":"“泰莱塔大人性格就是那样，喜欢强者。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":825,"speaker":"丝黛罗佩","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:14","scriptId":20693,"text":"“所以她和我对于这个星球的引领方式有了分歧。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:15","scriptId":20693,"text":"“上位大人们的冲突我可不想参与……而且上位之间的斗争是被禁止的说……”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":825,"speaker":"丝黛罗佩","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:16","scriptId":20693,"text":"“哼，你是我的部下，命令的优先级在我这里。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:17","scriptId":20693,"text":"“但顶撞泰莱塔大人会违反星团的总章……”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":825,"speaker":"丝黛罗佩","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:18","scriptId":20693,"text":"“我也没打算让你去和泰莱塔正面对抗，毕竟凭你的本事也挡不住泰莱塔。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:19","scriptId":20693,"text":"“那……”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":825,"speaker":"丝黛罗佩","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:20","scriptId":20693,"text":"“召唤你来，是为了让你和人类协作。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:21","scriptId":20693,"text":"“人类？协作？”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":825,"speaker":"丝黛罗佩","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:22","scriptId":20693,"text":"“兰布达还有德尔塔等一批下位，我都已经安排到了人类的阵营里。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:23","scriptId":20693,"text":"“诶？那些不是阿尔库涅大人麾下的旅行者吗？”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":825,"speaker":"丝黛罗佩","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:24","scriptId":20693,"text":"“我当然和阿尔库涅是一起的啦，对付那个讨厌泰莱塔。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:25","scriptId":20693,"text":"（虽然丝黛罗佩大人说的很轻松，但这事情听上去可不是一般的麻烦……）","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":825,"speaker":"丝黛罗佩","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:26","scriptId":20693,"text":"“泰莱塔都已经打算挑起与人类的战争了，我觉得帮一下人类那边应该也没什么关系。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:27","scriptId":20693,"text":"“难道要我帮助人类培养骸虫？”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":825,"speaker":"丝黛罗佩","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:28","scriptId":20693,"text":"“这个你自己衡量，或者去问兰布达也行，她现在做得就不错。”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:29","scriptId":20693,"text":"“好吧……”","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:30","scriptId":20693,"text":"（总之先去人类那边看看吧……）","background":"/art/stories/zjm-067.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20693:20693:32","scriptId":20693,"text":"在那之后过去了约一个月。","background":"/art/stories/zjm-047.webp","left":1186,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:33","scriptId":20693,"text":"“这个普希真的是丝黛罗佩的旅行者？”（小声）","background":"/art/stories/zjm-047.webp","left":4,"right":825,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:34","scriptId":20693,"text":"“没错，这点毋庸置疑。”","background":"/art/stories/zjm-047.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:35","scriptId":20693,"text":"“但她来我这里大半个月了，基本没提供什么援助，光是吃……简直和埃普西隆有得拼……”（小声）","background":"/art/stories/zjm-047.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:36","scriptId":20693,"text":"“她已经啃掉我三箱苹果和二箱手雷了……。”（小声）","background":"/art/stories/zjm-047.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:37","scriptId":20693,"text":"“那你想要她干什么呢？”","background":"/art/stories/zjm-047.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:38","scriptId":20693,"text":"“呃……我不太了解她的能力……”（小声）","background":"/art/stories/zjm-047.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:39","scriptId":20693,"text":"“普希的话，能够调整骸虫的基因制造出各种品种的骸虫，你想要弄点骸虫吗？”","background":"/art/stories/zjm-047.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:40","scriptId":20693,"text":"“呃……别了吧，我对那东西没什么好感……”（小声）","background":"/art/stories/zjm-047.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:41","scriptId":20693,"text":"“啧，人类真够麻烦的，普希，过来一下。”","background":"/art/stories/zjm-047.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20693:20693:42","scriptId":20693,"text":"兰布达这么一叫，普希就过来了。","background":"/art/stories/zjm-047.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:43","scriptId":20693,"text":"“兰布达，找我什么事？”","background":"/art/stories/zjm-047.webp","left":4,"right":1186,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:44","scriptId":20693,"text":"“这家伙认为你没什么贡献，只会在那里吃物资。”","background":"/art/stories/zjm-047.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:45","scriptId":20693,"text":"“诶？兰布达你……”","background":"/art/stories/zjm-047.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:46","scriptId":20693,"text":"“哦，这样啊……这么说来好像确实没做过什么事情，都怪物资太好吃了。”","background":"/art/stories/zjm-047.webp","left":4,"right":1186,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:47","scriptId":20693,"text":"“当初确实有说过基地里的物资你随便用……但没想到你那么能吃啊……”","background":"/art/stories/zjm-047.webp","left":4,"right":1186,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:48","scriptId":20693,"text":"“这么说来，我已经在研究地球的水果了，相信很快就能培育出新品种的水果了。”","background":"/art/stories/zjm-047.webp","left":4,"right":1186,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:49","scriptId":20693,"text":"“诶？水果？难道你打算在基地里种水果？”","background":"/art/stories/zjm-047.webp","left":4,"right":1186,"section":0,"shake":false},{"kind":"dialogue","head":1186,"speaker":"普希","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20693:20693:50","scriptId":20693,"text":"“有什么问题吗？”","background":"/art/stories/zjm-047.webp","left":4,"right":1186,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20693:20693:51","scriptId":20693,"text":"“……随你喜欢了，反正基地里的空地很多，能种点水果也是好事。”","background":"/art/stories/zjm-047.webp","left":4,"right":1186,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20693:20693:52","scriptId":20693,"text":"结果——","background":"/art/stories/zjm-047.webp","left":4,"right":1186,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20693:20693:53","scriptId":20693,"text":"几个月后基地里出现了一棵能够长出手雷的奇异苹果树……","background":"/art/stories/zjm-047.webp","left":4,"right":1186,"section":0,"shake":false}],"summaries":[]}
