{"schemaVersion":1,"id":147,"sections":[{"id":"207018-PROLOGUE","name":"第 1 战 · 战前","scripts":[20754],"start":0,"count":8}],"frames":[{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207018-PROLOGUE:20754:1","scriptId":20754,"text":"“旅行者……已经完全超越了我的认知，真的不想考虑她们的事情。”","background":"/art/stories/zjm-099.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207018-PROLOGUE:20754:2","scriptId":20754,"text":"“但作为研究者来说她们可是无价之宝，好想完整得研究她们……”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207018-PROLOGUE:20754:3","scriptId":20754,"text":"“科学家真是疯狂……只要是感兴趣的东西，就连来历不明的种族都不放过……”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207018-PROLOGUE:20754:4","scriptId":20754,"text":"“这叫求知欲，特别是兰布达她们展现出惊人的特殊能力之后，我简直都要控制不住自己了。”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207018-PROLOGUE:20754:5","scriptId":20754,"text":"“也对，如果获得了她们的科技，或许人类的历史就要发生改变了。”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207018-PROLOGUE:20754:6","scriptId":20754,"text":"“但目前她们已经成为了最高机密，只能一点点进行研究，真是急死我了。”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207018-PROLOGUE:20754:7","scriptId":20754,"text":"“这总比没有研究对象来得好吧？”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207018-PROLOGUE:20754:8","scriptId":20754,"text":"“是的，至少要先从兰布达那里挖掘出一些有用的技术才行……”","background":"/art/stories/zjm-099.webp","left":4,"right":608,"section":0,"shake":false}],"summaries":[]}
