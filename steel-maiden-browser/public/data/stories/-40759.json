{"schemaVersion":1,"id":-40759,"sections":[{"id":"script-20759","name":"原始脚本 20759","scripts":[20759],"start":0,"count":35}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20759:20759:1","scriptId":20759,"text":"RHO屋中——","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:2","scriptId":20759,"text":"“哟，今天吹得是什么风，你怎么跑我这儿来了？”","background":"/art/stories/zjm-132.webp","left":1124,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:3","scriptId":20759,"text":"“还不是因为你的信号频繁出现在这鬼地方,我只是过来确认一下罢了。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:4","scriptId":20759,"text":"“那现在确认好了没？”","background":"/art/stories/zjm-132.webp","left":1124,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:5","scriptId":20759,"text":"“……”","background":"/art/stories/zjm-132.webp","left":1124,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:6","scriptId":20759,"text":"“你这是在替人类搞研究？”","background":"/art/stories/zjm-132.webp","left":1124,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:7","scriptId":20759,"text":"“是啊，就像你看到的一样，正在改良这套航空舞装的出力问题。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:8","scriptId":20759,"text":"“你疯了？把我们的知识提供给人类可是要被泰莱塔大人降罪的。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:9","scriptId":20759,"text":"“哪有，我只是在人类技术的基础上进行的调整，不会涉及星团技术的。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:10","scriptId":20759,"text":"“我们这可是正经工作。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20759:20759:11","scriptId":20759,"text":"兰布达悄无声息地出现在了菲的身后，吓得菲一个激灵。","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:12","scriptId":20759,"text":"“又搞突然袭击！兰布达你的潜行技术又提高了不少啊？”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:13","scriptId":20759,"text":"“是你自己不观察周围，我都站这里好久了。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20759:20759:14","scriptId":20759,"text":"兰布达示意柔继续工作，自己和菲聊了起来。","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:15","scriptId":20759,"text":"“泰莱塔大人那边有什么动向吗？”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:16","scriptId":20759,"text":"“那位大人已经好久没有消息了，不过这也是常有的事情，早就习惯了。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:17","scriptId":20759,"text":"“既然这样，那你也过来这边替阿尔库涅大人办事吧。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:18","scriptId":20759,"text":"“哈？你没搞错吧，我可是效力于泰莱塔大人的。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:19","scriptId":20759,"text":"“阿尔库涅大人和泰莱塔大人搞对立的事情也就仅限于地球，星团绝不会允许上位们内斗的。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:20","scriptId":20759,"text":"“……”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:21","scriptId":20759,"text":"“但泰莱塔大人好歹也是我的直属上司，我不想违背她的命令。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:22","scriptId":20759,"text":"“我可没说让你违背上位的命令。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:23","scriptId":20759,"text":"“你也是明白人，大家都是为了星团，我们努力执行上位的命令就行了。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:24","scriptId":20759,"text":"“……你的意思是？”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:25","scriptId":20759,"text":"“反正泰莱塔大人的命令也只是培养和增殖新品种骸虫，这个命令很容易达成。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:26","scriptId":20759,"text":"“而阿尔库涅大人的命令是观察并协助她关注的人类，两位大人的命令其实完全不冲突。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:27","scriptId":20759,"text":"“你的意思是让我同时执行两位大人的任务？”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:28","scriptId":20759,"text":"“我和柔还有其他一批下位都是这么做的。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:29","scriptId":20759,"text":"“呃……你说的有道理，我们这种小人物还是别惹事为妙……”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:30","scriptId":20759,"text":"“菲，没想到吧，昔日那个固执的兰布达已经如此圆滑了。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:31","scriptId":20759,"text":"“你这么一说……好像是完全变了不少啊。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:32","scriptId":20759,"text":"“柔，不要多嘴，继续干活。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:33","scriptId":20759,"text":"“是是是。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20759:20759:34","scriptId":20759,"text":"“之后我会给你引荐那位人类指挥官的。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20759:20759:35","scriptId":20759,"text":"“知道啦。”","background":"/art/stories/zjm-132.webp","left":1198,"right":1110,"section":0,"shake":false}],"summaries":[]}
