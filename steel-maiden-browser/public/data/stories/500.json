{"schemaVersion":1,"id":500,"sections":[{"id":"1919001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20679],"start":0,"count":15},{"id":"1919001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20680],"start":15,"count":24}],"frames":[{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-PROLOGUE:20679:1","scriptId":20679,"text":"“西格玛，好像出了点状况。”","background":"/art/stories/zjm-067.webp","left":null,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-PROLOGUE:20679:2","scriptId":20679,"text":"“什么情况？”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-PROLOGUE:20679:3","scriptId":20679,"text":"“有个中继站无法取得联络，但是迪塔格项圈的信号还在。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-PROLOGUE:20679:4","scriptId":20679,"text":"“信号还在的话应该不是什么大事吧，只不过丢失定期联络的话……”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1919001-PROLOGUE:20679:5","scriptId":20679,"text":"西格玛的话还没说完，伊塔就一副要动身的架势。","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-PROLOGUE:20679:6","scriptId":20679,"text":"“那我过去看一下。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-PROLOGUE:20679:7","scriptId":20679,"text":"“去吧，这边就我一个人也没问题。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-PROLOGUE:20679:8","scriptId":20679,"text":"“嗯。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-PROLOGUE:20679:9","scriptId":20679,"text":"“发现什么问题的话，先通知我，不要一个人冒进。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-PROLOGUE:20679:10","scriptId":20679,"text":"“了解。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1919001-PROLOGUE:20679:12","scriptId":20679,"text":"待到伊塔走后不久。","background":"/art/stories/zjm-067.webp","left":12,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-PROLOGUE:20679:13","scriptId":20679,"text":"“迪塔格项圈的信号，我来看看目前方位……”","background":"/art/stories/zjm-067.webp","left":12,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1919001-PROLOGUE:20679:14","scriptId":20679,"text":"西格玛虽然并没把伊塔的报告放在心上，不过她还是随手确认了一下信号。","background":"/art/stories/zjm-067.webp","left":12,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-PROLOGUE:20679:15","scriptId":20679,"text":"“……这信号好像是先前抓到的那批钢舞姬。”","background":"/art/stories/zjm-067.webp","left":12,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-PROLOGUE:20679:16","scriptId":20679,"text":"“已经脱离了中继站范围，看来伊塔说的不错，应该是出了什么问题。”","background":"/art/stories/zjm-067.webp","left":12,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1919001-EPILOGUE:20680:1","scriptId":20680,"text":"没过多久，伊塔就回到了西格玛所在的据点。","background":"/art/stories/zjm-067.webp","left":12,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-EPILOGUE:20680:2","scriptId":20680,"text":"“确实有一小撮钢舞姬在我们制作的假中继点里惹事。”","background":"/art/stories/zjm-067.webp","left":411,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-EPILOGUE:20680:3","scriptId":20680,"text":"“嗯？惹事？难道偷袭没有得手？”","background":"/art/stories/zjm-067.webp","left":411,"right":12,"section":1,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-EPILOGUE:20680:4","scriptId":20680,"text":"“好像是这样。”","background":"/art/stories/zjm-067.webp","left":411,"right":12,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-EPILOGUE:20680:5","scriptId":20680,"text":"“看来是比较警觉的家伙，和之前被轻松干掉的那些蠢蛋有点不同么。”","background":"/art/stories/zjm-067.webp","left":411,"right":12,"section":1,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-EPILOGUE:20680:6","scriptId":20680,"text":"“但被发现的话，还是灭口比较好？反正这中继站周围还布置了不少兵力。”","background":"/art/stories/zjm-067.webp","left":411,"right":12,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1919001-EPILOGUE:20680:7","scriptId":20680,"text":"“那你就和她们玩玩好了。”","background":"/art/stories/zjm-067.webp","left":411,"right":12,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1919001-EPILOGUE:20680:9","scriptId":20680,"text":"另一边，由于脑部受到了意外的冲击，齐奈达变得有些奇怪……","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:10","scriptId":20680,"text":"“请下达下一个命令吧。”","background":"/art/stories/zjm-067.webp","left":null,"right":1137,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:11","scriptId":20680,"text":"“呃……先跟着我们就行了。”","background":"/art/stories/zjm-067.webp","left":4,"right":1137,"section":1,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:12","scriptId":20680,"text":"“遵命！”","background":"/art/stories/zjm-067.webp","left":4,"right":1137,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:13","scriptId":20680,"text":"“唔啊……还真是紧贴在长官身后呢……”","background":"/art/stories/zjm-067.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1919001-EPILOGUE:20680:14","scriptId":20680,"text":"齐奈达非常紧凑地跟在我身后，感觉自己如果突然停下脚步可能立刻就会和她撞上……","background":"/art/stories/zjm-067.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:15","scriptId":20680,"text":"“看上去就像是某种精神控制，我在科幻小说里经常看到这种桥段。”","background":"/art/stories/zjm-067.webp","left":584,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:16","scriptId":20680,"text":"“嗯，如果按你这么说的话，现在齐奈达的状态确实很吻合。”","background":"/art/stories/zjm-067.webp","left":584,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:17","scriptId":20680,"text":"“现在我们反而应该监视好长官，因为他不管说什么齐奈达都会照做。”","background":"/art/stories/zjm-067.webp","left":591,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":746,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:18","scriptId":20680,"text":"“是啊是啊，严禁长官和齐奈达单独相处！”","background":"/art/stories/zjm-067.webp","left":591,"right":746,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:19","scriptId":20680,"text":"“呃……我就那么不受你们信任吗？”","background":"/art/stories/zjm-067.webp","left":4,"right":746,"section":1,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:20","scriptId":20680,"text":"“也不是，只不过长官经常不拘小节，所以我们担心会弄出点麻烦～”","background":"/art/stories/zjm-067.webp","left":4,"right":574,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:21","scriptId":20680,"text":"“……好吧。”","background":"/art/stories/zjm-067.webp","left":4,"right":574,"section":1,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:22","scriptId":20680,"text":"“齐奈达可以保护长官。”","background":"/art/stories/zjm-067.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:23","scriptId":20680,"text":"“嗯，也算是增加了一个有效战力，我们可以更加安心作战。”","background":"/art/stories/zjm-067.webp","left":584,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1919001-EPILOGUE:20680:24","scriptId":20680,"text":"“总之先想想怎么搞定齐奈达的项圈吧，不然我们的任务无法完成。”","background":"/art/stories/zjm-067.webp","left":584,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1919001-EPILOGUE:20680:25","scriptId":20680,"text":"为了解开迪塔格项圈，我们开始探查周边区域。","background":"/art/stories/zjm-067.webp","left":584,"right":4,"section":1,"shake":false}],"summaries":[]}
