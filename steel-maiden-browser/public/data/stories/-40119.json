{"schemaVersion":1,"id":-40119,"sections":[{"id":"script-20119","name":"原始脚本 20119","scripts":[20119],"start":0,"count":43}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20119:20119:1","scriptId":20119,"text":"某群岛的沙滩上，出现了一位旅行者的身影——","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20119:20119:2","scriptId":20119,"text":"“登陆完成……给约塔鼓掌……啪叽啪叽啪叽～”","background":"/art/stories/zjm-067.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20119:20119:3","scriptId":20119,"text":"头上有着“兔耳”一般的骸虫，这正是旅行者——约塔的特征。","background":"/art/stories/zjm-067.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20119:20119:4","scriptId":20119,"text":"“不过这里一点人烟都没有的感觉……难道我走错了？”","background":"/art/stories/zjm-067.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20119:20119:5","scriptId":20119,"text":"“算了，反正西格玛只是要求拿下这片群岛而已，先从这里收割呗。”","background":"/art/stories/zjm-067.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20119:20119:6","scriptId":20119,"text":"约塔拿出两个像实心球一样的东西，往地上一扔……","background":"/art/stories/zjm-067.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20119:20119:7","scriptId":20119,"text":"这两块东西在接触到地面以后立刻变成了像软泥一样物质，并且开始吸收地表上的泥土逐渐变大。","background":"/art/stories/zjm-067.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20119:20119:8","scriptId":20119,"text":"“虽然是借来的试作品，不过应该也够了吧……”","background":"/art/stories/zjm-067.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20119:20119:9","scriptId":20119,"text":"约塔一路自言自语地往丛林方向走去……","background":"/art/stories/zjm-067.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20119:20119:12","scriptId":20119,"text":"海滩边——","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20119:20119:13","scriptId":20119,"text":"拍摄小组方面，负责警卫的我们已经散开，形成了一个扇形的警卫网。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20119:20119:14","scriptId":20119,"text":"因为我基本不能成为战斗力，所以和白银皇后的队长分在一起。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:15","scriptId":20119,"text":"“这海滩还真是漂亮啊……怪不得要到这里来拍摄。”","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:16","scriptId":20119,"text":"“恩，这次要拍摄出夏季的感觉，所以第一个想到的地方就是这里。”","background":"/art/stories/zjm-101.webp","left":4,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:17","scriptId":20119,"text":"“这里的战车兽看上去不算凶猛，数量也一般般，我想这次任务应该挺简单的。”","background":"/art/stories/zjm-101.webp","left":4,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:18","scriptId":20119,"text":"“是的，作为警卫来说算是较为轻松吧，而且报酬丰厚，算是美差吧～”","background":"/art/stories/zjm-101.webp","left":4,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:19","scriptId":20119,"text":"“原来如此，怪不得芮蓓极力推荐这任务……因为第一次接到这种任务，一时还有点不知所措呢。”","background":"/art/stories/zjm-101.webp","left":4,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:20","scriptId":20119,"text":"“恩，对于我们这种不知名的小队来说，做这种任务是最开心的。”","background":"/art/stories/zjm-101.webp","left":4,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:21","scriptId":20119,"text":"“……诶？白银皇后那么帅气的名字，我觉得很容易被记住的吧？”","background":"/art/stories/zjm-101.webp","left":4,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:22","scriptId":20119,"text":"“啊哈哈……这个其实是我们小队成员的愿望吧……希望自己有朝一日能成为真正的皇后啦～”","background":"/art/stories/zjm-101.webp","left":4,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:23","scriptId":20119,"text":"“功夫不负有心人，我想你们应该可以的～”","background":"/art/stories/zjm-101.webp","left":4,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:24","scriptId":20119,"text":"“那就先谢谢啦～”","background":"/art/stories/zjm-101.webp","left":4,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":748,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:25","scriptId":20119,"text":"“长官～在聊什么呢？玩忽职守可不好啊～”","background":"/art/stories/zjm-101.webp","left":748,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:26","scriptId":20119,"text":"“诶！？佐伊？你怎么在这儿？”","background":"/art/stories/zjm-101.webp","left":748,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":747,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:27","scriptId":20119,"text":"“刚才就来了……看长官聊得那么开心，没打断而已。”","background":"/art/stories/zjm-101.webp","left":747,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:28","scriptId":20119,"text":"“……”","background":"/art/stories/zjm-101.webp","left":747,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:29","scriptId":20119,"text":"“咳哼，说正事……”","background":"/art/stories/zjm-101.webp","left":747,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:30","scriptId":20119,"text":"“刚才发现有两只战车兽在北面的峭壁上徘徊，佩妮让我来报告一下。”","background":"/art/stories/zjm-101.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:31","scriptId":20119,"text":"“恩……好的，防患于未然，还是排除掉这些战车兽吧……”","background":"/art/stories/zjm-101.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:32","scriptId":20119,"text":"“好的，我这就出发。”","background":"/art/stories/zjm-101.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:33","scriptId":20119,"text":"“等等……峭壁这种地方，对我们来说不太有利，正好……让我看看这东西到底有没有用？”","background":"/art/stories/zjm-101.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20119:20119:34","scriptId":20119,"text":"我从口袋里掏出通信器，打开了开关。","background":"/art/stories/zjm-101.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:35","scriptId":20119,"text":"“波西娅，听得到吗？”","background":"/art/stories/zjm-101.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20119:20119:36","scriptId":20119,"text":"通信器里传来了沙沙声，但是并没有回答。","background":"/art/stories/zjm-101.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:37","scriptId":20119,"text":"“没什么用的东西么……”","background":"/art/stories/zjm-101.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20119:20119:38","scriptId":20119,"text":"我刚要收起来——","background":"/art/stories/zjm-101.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:39","scriptId":20119,"text":"“听到了，听到了～遇到什么情况了吗？”","background":"/art/stories/zjm-101.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:40","scriptId":20119,"text":"“我发现峭壁上有几只战车兽，正常攻击比较困难，你有什么好办法吗？”","background":"/art/stories/zjm-101.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:41","scriptId":20119,"text":"“峭壁？告诉我大致坐标，我会派点小援军过来的～”","background":"/art/stories/zjm-101.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:42","scriptId":20119,"text":"“援军？你自己不过来吗？”","background":"/art/stories/zjm-101.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:43","scriptId":20119,"text":"“谁告诉你是我过来了？我还是挺忙的说～”","background":"/art/stories/zjm-101.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:44","scriptId":20119,"text":"“好吧……”","background":"/art/stories/zjm-101.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20119:20119:45","scriptId":20119,"text":"（很忙？听不出来啊……）","background":"/art/stories/zjm-101.webp","left":608,"right":4,"section":0,"shake":false}],"summaries":[]}
