{"schemaVersion":1,"id":-40521,"sections":[{"id":"script-20521","name":"原始脚本 20521","scripts":[20521],"start":0,"count":5}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20521:20521:1","scriptId":20521,"text":"","background":"/art/stories/zdbjbz-04.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":50,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20521:20521:5","scriptId":20521,"text":"“呃……这是什么？石头吗？”","background":"/art/stories/zdbjbz-04.webp","left":50,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20521:20521:6","scriptId":20521,"text":"“这是面包，因为要便于存放所以基本不含水分，但经过那么久，倒也确实硬得跟石头一样了。”","background":"/art/stories/zdbjbz-04.webp","left":50,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20521:20521:7","scriptId":20521,"text":"兰布达拿出一块，用力捏了捏，这面包竟然没有变形……","background":"/art/stories/zdbjbz-04.webp","left":50,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20521:20521:8","scriptId":20521,"text":"“应该还可以吃吧……”","background":"/art/stories/zdbjbz-04.webp","left":50,"right":56,"section":0,"shake":false}],"summaries":[]}
