{"schemaVersion":1,"id":48,"sections":[{"id":"117007-PROLOGUE","name":"第 1 战 · 战前","scripts":[1610],"start":0,"count":16},{"id":"117007-EPILOGUE","name":"第 1 战 · 战后","scripts":[11600],"start":16,"count":19},{"id":"117008-PROLOGUE","name":"第 2 战 · 战前","scripts":[1620],"start":35,"count":14},{"id":"117008-EPILOGUE","name":"第 2 战 · 战后","scripts":[11610],"start":49,"count":10},{"id":"117009-PROLOGUE","name":"第 3 战 · 战前","scripts":[1630],"start":59,"count":13},{"id":"117009-EPILOGUE","name":"第 3 战 · 战后","scripts":[11620],"start":72,"count":21}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117007-PROLOGUE:1610:2","scriptId":1610,"text":"到达被占领的基地外围。","background":"/art/stories/zdbjbz-05.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:3","scriptId":1610,"text":"“呜啊……这只是外围吧，少说三四十只战车兽。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:4","scriptId":1610,"text":"（每发炮弹是多少钱来着……我算算……）","background":"/art/stories/zdbjbz-05.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:5","scriptId":1610,"text":"“恭喜您首次任务就要赤字了啊～”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":231,"section":0,"shake":false},{"kind":"dialogue","head":255,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:6","scriptId":1610,"text":"“那还不至于，只要能仔细规划作战，应该能节省不少吧～”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":255,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:7","scriptId":1610,"text":"“恩，我想想作战方式。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":255,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:8","scriptId":1610,"text":"（理论上一次性多体打击是最合算的。）","background":"/art/stories/zdbjbz-05.webp","left":4,"right":255,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:9","scriptId":1610,"text":"“由我去诱敌，然后让维卡进行范围打击，这样能做到最效率。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:10","scriptId":1610,"text":"“但这个任务比较危险吧，如果有个万一……”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:11","scriptId":1610,"text":"“不会有问题的，您觉得不妥的话，可以让奈特莉在旁边接应。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:12","scriptId":1610,"text":"“也可以，不过……”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":577,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:13","scriptId":1610,"text":"“太犹豫不决了～这种程度的战斗不算什么啦～”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":577,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:14","scriptId":1610,"text":"“那么就先采用这个方案，让佩妮去试试。如果遇到突发情况的话，奈特莉你从侧面支援。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":577,"section":0,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:15","scriptId":1610,"text":"“没问题～”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:16","scriptId":1610,"text":"“成功引诱完成后，就看你的了，维卡。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117007-PROLOGUE:1610:17","scriptId":1610,"text":"“保证完成任务。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117007-EPILOGUE:11600:0","scriptId":11600,"text":"作战初步成立，由佩妮的引诱把战车兽成功引致坐标位置。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117007-EPILOGUE:11600:2","scriptId":11600,"text":"随后维卡的精准火炮打击，只用了三发炮弹就解决了一小队的战车兽。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:3","scriptId":11600,"text":"“这等战斗实力简直让人无话可说。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:4","scriptId":11600,"text":"“你们之前确定是没配合过？怎么能那么默契……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:5","scriptId":11600,"text":"“恩……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:6","scriptId":11600,"text":"“因为有见过维卡之前的打靶训练，所以我觉得没什么问题。”","background":"/art/stories/zdbjbz-14.webp","left":584,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:7","scriptId":11600,"text":"“哦哦，真是能很细心的观察周边事物啊，帮大忙了，佩妮。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":588,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:8","scriptId":11600,"text":"“还好啦……”","background":"/art/stories/zdbjbz-14.webp","left":588,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:9","scriptId":11600,"text":"“结果我连出场都不需要啊～”","background":"/art/stories/zdbjbz-14.webp","left":588,"right":582,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:10","scriptId":11600,"text":"“那肯定不会，奈特莉的补位是必须的。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":582,"section":1,"shake":false},{"kind":"dialogue","head":576,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:11","scriptId":11600,"text":"“啊哈哈～长官真会说话～”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":576,"section":1,"shake":false},{"kind":"dialogue","head":243,"speaker":"露米娜·施泰特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:12","scriptId":11600,"text":"“这个队伍看来挺不错，基本用不到我们出场了，还以为会出什么问题呢。”","background":"/art/stories/zdbjbz-14.webp","left":243,"right":576,"section":1,"shake":false},{"kind":"dialogue","head":249,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:13","scriptId":11600,"text":"“我觉得到不会，蕾贝卡队长可是专程跑到人事处把零散的佣兵都调查了一遍才选的这三个，肯定战斗力不俗啦。”","background":"/art/stories/zdbjbz-14.webp","left":243,"right":249,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:14","scriptId":11600,"text":"（怪不得蕾贝卡那天出去那么久才回来。）","background":"/art/stories/zdbjbz-14.webp","left":4,"right":249,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:15","scriptId":11600,"text":"“真是太感谢了，这么帮忙真是让我过意不去啊。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":249,"section":1,"shake":false},{"kind":"dialogue","head":227,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:16","scriptId":11600,"text":"“哪里，不过是同僚间的互相帮助啦～”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":227,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117007-EPILOGUE:11600:17","scriptId":11600,"text":"蕾贝卡略显尴尬，于是她支开了话题。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":227,"section":1,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:18","scriptId":11600,"text":"“接下来还有不少战车兽要清理，现在还不是可以闲聊的时候。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117007-EPILOGUE:11600:19","scriptId":11600,"text":"“是。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117008-PROLOGUE:1620:2","scriptId":1620,"text":"费了一番功夫清理掉了基地外围的战车兽。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":223,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117008-PROLOGUE:1620:3","scriptId":1620,"text":"由于战术安排合理，并没有大量消耗弹药。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":223,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117008-PROLOGUE:1620:4","scriptId":1620,"text":"已经进入内部开始清扫作战了，蕾贝卡小队并没有随行，而是在外围等待。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":223,"section":2,"shake":false},{"kind":"dialogue","head":254,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117008-PROLOGUE:1620:5","scriptId":1620,"text":"“真是有点闲啊，虽说看别人战斗也挺有意思，但还是比不上自己上场啊……”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":254,"section":2,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117008-PROLOGUE:1620:6","scriptId":1620,"text":"“雷娅，抢同僚的生意可不好哦。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":235,"section":2,"shake":false},{"kind":"dialogue","head":247,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117008-PROLOGUE:1620:7","scriptId":1620,"text":"“也就玩玩而已，几枚炮弹钱我还是付得起的～”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":247,"section":2,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117008-PROLOGUE:1620:8","scriptId":1620,"text":"“那就达不到考察的目的啦～”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":235,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117008-PROLOGUE:1620:9","scriptId":1620,"text":"露米娜转头看向蕾贝卡带着特殊的语气说道。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":235,"section":2,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117008-PROLOGUE:1620:10","scriptId":1620,"text":"“不过话说回来，考察的事情明明可以交给专门的监察队来处理。为什么要亲自来啊～”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":235,"section":2,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117008-PROLOGUE:1620:11","scriptId":1620,"text":"“稍微有点不放心啊，毕竟人生地不熟的，我们这几个熟人当然要照应一下咯～“","background":"/art/stories/zdbjbz-05.webp","left":223,"right":235,"section":2,"shake":false},{"kind":"dialogue","head":243,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117008-PROLOGUE:1620:12","scriptId":1620,"text":"“不惜把任务委托都给推了～”","background":"/art/stories/zdbjbz-05.webp","left":223,"right":243,"section":2,"shake":false},{"kind":"dialogue","head":230,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117008-PROLOGUE:1620:13","scriptId":1620,"text":"“……”","background":"/art/stories/zdbjbz-05.webp","left":230,"right":243,"section":2,"shake":false},{"kind":"dialogue","head":237,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117008-PROLOGUE:1620:14","scriptId":1620,"text":"“好了好了，不开玩笑了，队长做的决定我们是不会插嘴的啦～”","background":"/art/stories/zdbjbz-05.webp","left":230,"right":237,"section":2,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117008-PROLOGUE:1620:15","scriptId":1620,"text":"“谢谢……”","background":"/art/stories/zdbjbz-05.webp","left":223,"right":237,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117008-EPILOGUE:11610:1","scriptId":11610,"text":"说实话，基地内部的战斗比外围轻松不少。","background":"/art/stories/zjm-054.webp","left":223,"right":237,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117008-EPILOGUE:11610:2","scriptId":11610,"text":"靠着奈特莉的防御保护，基本没有受到伤害就到达了基地内部。","background":"/art/stories/zjm-054.webp","left":223,"right":237,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117008-EPILOGUE:11610:3","scriptId":11610,"text":"“这个基地竟然连个自爆程序都没有？”","background":"/art/stories/zjm-054.webp","left":4,"right":237,"section":3,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117008-EPILOGUE:11610:4","scriptId":11610,"text":"“我推荐把武器库炸了，这样应该也能引发基地的连锁爆炸。”","background":"/art/stories/zjm-054.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117008-EPILOGUE:11610:5","scriptId":11610,"text":"“可以试试，但是要先找到炸药……”","background":"/art/stories/zjm-054.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117008-EPILOGUE:11610:6","scriptId":11610,"text":"“给。”","background":"/art/stories/zjm-054.webp","left":4,"right":596,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117008-EPILOGUE:11610:7","scriptId":11610,"text":"维卡从旁边塞给一个包裹一样的东西。","background":"/art/stories/zjm-054.webp","left":4,"right":596,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117008-EPILOGUE:11610:8","scriptId":11610,"text":"定睛一看，原来是自制的简易爆炸装置……里面塞了好几枚炮弹的火药，沉甸甸的。","background":"/art/stories/zjm-054.webp","left":4,"right":596,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117008-EPILOGUE:11610:9","scriptId":11610,"text":"“短时间能做出这种东西，维卡你说不定是个天才……”","background":"/art/stories/zjm-054.webp","left":4,"right":596,"section":3,"shake":false},{"kind":"dialogue","head":606,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117008-EPILOGUE:11610:10","scriptId":11610,"text":"“………………谢谢”（小声）","background":"/art/stories/zjm-054.webp","left":4,"right":606,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117009-PROLOGUE:1630:6","scriptId":1630,"text":"顺利爆破，摧毁基地的任务完成。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":606,"section":4,"shake":true},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117009-PROLOGUE:1630:7","scriptId":1630,"text":"和蕾贝卡小队汇合。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":606,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117009-PROLOGUE:1630:8","scriptId":1630,"text":"“这个基地废弃多时了，自毁装置应该失效了，真亏你们有办法把那里炸了。”","background":"/art/stories/zdbjbz-05.webp","left":223,"right":606,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117009-PROLOGUE:1630:9","scriptId":1630,"text":"“任务这样就算完成了？”","background":"/art/stories/zdbjbz-05.webp","left":223,"right":4,"section":4,"shake":false},{"kind":"dialogue","head":243,"speaker":"露米娜·施泰特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117009-PROLOGUE:1630:10","scriptId":1630,"text":"“没错，只要返回死水基地以后就可以向团长报告了。”","background":"/art/stories/zdbjbz-05.webp","left":243,"right":4,"section":4,"shake":false},{"kind":"dialogue","head":247,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117009-PROLOGUE:1630:11","scriptId":1630,"text":"“第一次能顺利完成的话，之后就不需要我们这些保镖了～”","background":"/art/stories/zdbjbz-05.webp","left":243,"right":247,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117009-PROLOGUE:1630:12","scriptId":1630,"text":"“能做到这样我们也就放心了，这里先恭喜顺利摧毁了基地。”","background":"/art/stories/zdbjbz-05.webp","left":223,"right":247,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117009-PROLOGUE:1630:13","scriptId":1630,"text":"“谢谢，这都是亏了这三位精英队员啊。比起我单人指挥，她们能快速的判断情况，非常不错。”","background":"/art/stories/zdbjbz-05.webp","left":223,"right":4,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117009-PROLOGUE:1630:14","scriptId":1630,"text":"我对队员们在这次行动中的表现给予了高度的评价。","background":"/art/stories/zdbjbz-05.webp","left":223,"right":4,"section":4,"shake":false},{"kind":"dialogue","head":243,"speaker":"露米娜·施泰特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117009-PROLOGUE:1630:15","scriptId":1630,"text":"“蕾贝卡选人有成效了啊～”（小声）","background":"/art/stories/zdbjbz-05.webp","left":243,"right":4,"section":4,"shake":false},{"kind":"dialogue","head":227,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117009-PROLOGUE:1630:16","scriptId":1630,"text":"“多嘴。”","background":"/art/stories/zdbjbz-05.webp","left":243,"right":227,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117009-PROLOGUE:1630:17","scriptId":1630,"text":"“？？？？”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":227,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117009-PROLOGUE:1630:18","scriptId":1630,"text":"“咳哼，好了，现在开始回程吧。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117009-EPILOGUE:11620:0","scriptId":11620,"text":"任务完成后，以原路返回死水基地","background":"/art/stories/zdbjbz-05.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117009-EPILOGUE:11620:2","scriptId":11620,"text":"中间遇到一些战车兽，但是根本不是这群钢舞姬们的对手。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117009-EPILOGUE:11620:3","scriptId":11620,"text":"一路顺畅得返回了基地，稍作休整，再次来到团长室门口。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117009-EPILOGUE:11620:4","scriptId":11620,"text":"这次是作为任务汇报，虽然有蕾贝卡跟着，但还是稍微有点紧张，我轻轻扣了下门……","background":"/art/stories/zdbjbz-05.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117009-EPILOGUE:11620:6","scriptId":11620,"text":"“进来。”","background":"/art/stories/zjm-098.webp","left":4,"right":547,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117009-EPILOGUE:11620:7","scriptId":11620,"text":"“维多利亚团长，海伦娜教官委托的任务已经顺利完成了。”","background":"/art/stories/zjm-098.webp","left":4,"right":547,"section":5,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117009-EPILOGUE:11620:8","scriptId":11620,"text":"“是吗？”","background":"/art/stories/zjm-098.webp","left":4,"right":547,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117009-EPILOGUE:11620:9","scriptId":11620,"text":"维多利亚正在看另一份报告，轻描淡写得回应了一下。","background":"/art/stories/zjm-098.webp","left":4,"right":547,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117009-EPILOGUE:11620:10","scriptId":11620,"text":"“那个，我就把报告书放这里了……”","background":"/art/stories/zjm-098.webp","left":4,"right":547,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117009-EPILOGUE:11620:11","scriptId":11620,"text":"把报告书放到桌上以后，我就准备退出团长室，这时候维多利亚抬了下头。","background":"/art/stories/zjm-098.webp","left":4,"right":547,"section":5,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117009-EPILOGUE:11620:12","scriptId":11620,"text":"“蕾贝卡留下，你的话，先到一号会议室去，海伦娜在那里等着呢，我们稍后也会过来。”","background":"/art/stories/zjm-098.webp","left":4,"right":547,"section":5,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117009-EPILOGUE:11620:13","scriptId":11620,"text":"“好的，我知道了。”","background":"/art/stories/zjm-098.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117009-EPILOGUE:11620:15","scriptId":11620,"text":"“诶？”","background":"/art/stories/zjm-098.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117009-EPILOGUE:11620:16","scriptId":11620,"text":"稍微有点犯迷糊，于是我问了一下。","background":"/art/stories/zjm-098.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117009-EPILOGUE:11620:17","scriptId":11620,"text":"“那个……一号会议室在哪？”","background":"/art/stories/zjm-098.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117009-EPILOGUE:11620:18","scriptId":11620,"text":"“……”","background":"/art/stories/zjm-098.webp","left":4,"right":547,"section":5,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117009-EPILOGUE:11620:19","scriptId":11620,"text":"“我说蕾贝卡，你没有好好的介绍基地情况给他啊……”","background":"/art/stories/zjm-098.webp","left":4,"right":547,"section":5,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117009-EPILOGUE:11620:20","scriptId":11620,"text":"“啊呀，忘记了啦，这次时间比较紧～”","background":"/art/stories/zjm-098.webp","left":223,"right":547,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117009-EPILOGUE:11620:21","scriptId":11620,"text":"蕾贝卡转过身来对我说。","background":"/art/stories/zjm-098.webp","left":223,"right":547,"section":5,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117009-EPILOGUE:11620:22","scriptId":11620,"text":"“那你就问问佩妮她们吧～”","background":"/art/stories/zjm-098.webp","left":223,"right":547,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117009-EPILOGUE:11620:23","scriptId":11620,"text":"“哦，好的。”","background":"/art/stories/zjm-098.webp","left":223,"right":4,"section":5,"shake":false}],"summaries":["到达被占领的基地","任务进行中。","完成爆破，摧毁基地完成"]}
