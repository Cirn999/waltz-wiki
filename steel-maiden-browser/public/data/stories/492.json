{"schemaVersion":1,"id":492,"sections":[{"id":"1911001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20662],"start":0,"count":8},{"id":"1911001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20663],"start":8,"count":12}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1911001-PROLOGUE:20662:1","scriptId":20662,"text":"让安妮一个人躲在矮灌木丛中，加上伪装网，几乎不可能辨识。","background":"/art/stories/zdbjbz-04.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1911001-PROLOGUE:20662:2","scriptId":20662,"text":"而她侧面的山地上是相对容易被发现的奈特莉。","background":"/art/stories/zdbjbz-04.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1911001-PROLOGUE:20662:3","scriptId":20662,"text":"“正常情况下奈特莉那边应该会被先发现……”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1911001-PROLOGUE:20662:4","scriptId":20662,"text":"然而事情就和之前所料到的一样，出现的旅行者是径直朝着安妮的位置去的……","background":"/art/stories/zdbjbz-04.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1911001-PROLOGUE:20662:5","scriptId":20662,"text":"“那么，我们就开动了。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1911001-PROLOGUE:20662:6","scriptId":20662,"text":"“我也要战斗，毕竟敌人是冲着我来的。”","background":"/art/stories/zdbjbz-04.webp","left":1135,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1911001-PROLOGUE:20662:7","scriptId":20662,"text":"“哦！我们从侧翼偷袭它们！”","background":"/art/stories/zdbjbz-04.webp","left":1135,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1911001-PROLOGUE:20662:8","scriptId":20662,"text":"“那个……能别叫那么大声吗？怕别人听不见？”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1911001-EPILOGUE:20663:1","scriptId":20663,"text":"旅行者的某处据点——","background":"/art/stories/zdjm-034.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1911001-EPILOGUE:20663:2","scriptId":20663,"text":"“什么！？”","background":"/art/stories/zdjm-034.webp","left":430,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1911001-EPILOGUE:20663:3","scriptId":20663,"text":"柯西突然叫了一声。","background":"/art/stories/zdjm-034.webp","left":430,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1911001-EPILOGUE:20663:4","scriptId":20663,"text":"“怎么了？”","background":"/art/stories/zdjm-034.webp","left":430,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1911001-EPILOGUE:20663:5","scriptId":20663,"text":"“啊，不……没什么。”","background":"/art/stories/zdjm-034.webp","left":430,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1911001-EPILOGUE:20663:6","scriptId":20663,"text":"（怎么回事，负责清理研究所的队伍竟然消灭了大半？）","background":"/art/stories/zdjm-034.webp","left":430,"right":421,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1911001-EPILOGUE:20663:7","scriptId":20663,"text":"柯西之前因为懒得亲自处理，所以让实验体队伍去收拾研究所。","background":"/art/stories/zdjm-034.webp","left":430,"right":421,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1911001-EPILOGUE:20663:8","scriptId":20663,"text":"不过怎么也没想到那些实验体会遇到对手。","background":"/art/stories/zdjm-034.webp","left":430,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1911001-EPILOGUE:20663:9","scriptId":20663,"text":"“你的脸色不太好啊？”","background":"/art/stories/zdjm-034.webp","left":430,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1911001-EPILOGUE:20663:10","scriptId":20663,"text":"“没这回事，我要出去一次。”","background":"/art/stories/zdjm-034.webp","left":430,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1911001-EPILOGUE:20663:11","scriptId":20663,"text":"“…………”","background":"/art/stories/zdjm-034.webp","left":430,"right":421,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1911001-EPILOGUE:20663:12","scriptId":20663,"text":"柯西驱使她的骸虫快速离开了据点。","background":"/art/stories/zdjm-034.webp","left":430,"right":421,"section":1,"shake":false}],"summaries":[]}
