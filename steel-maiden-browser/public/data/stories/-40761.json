{"schemaVersion":1,"id":-40761,"sections":[{"id":"script-20761","name":"原始脚本 20761","scripts":[20761],"start":0,"count":45}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20761:20761:1","scriptId":20761,"text":"夏日炎炎，烈日把死水基地烤得像个火炉。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20761:20761:2","scriptId":20761,"text":"为了躲避这场漫长的炙烤，某一行人主动申请来到夏威夷分基地进行“休假”","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20761:20761:3","scriptId":20761,"text":"此时，在某一处沙滩边——","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:4","scriptId":20761,"text":"“呼……还是这儿的海风舒服，待在基地那种闷死人的地方简直是一种酷刑啊。”","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1197,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:5","scriptId":20761,"text":"“是啊，就知道长官会打小算盘，所以出勤的时候留了个心眼。”","background":"/art/stories/zjm-101.webp","left":4,"right":1197,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:6","scriptId":20761,"text":"“呃，要不是你们死缠着要跟来，其实我和波西亚两个人都可以搞定这个任务。”","background":"/art/stories/zjm-101.webp","left":4,"right":1197,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:7","scriptId":20761,"text":"“而且你们这根本不是来执行任务的，分明是来玩的吧，一个个连泳衣都换上了。”","background":"/art/stories/zjm-101.webp","left":4,"right":1197,"section":0,"shake":false},{"kind":"dialogue","head":1204,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:8","scriptId":20761,"text":"“我是看姐姐已经换了衣服，所以也就跟着……”","background":"/art/stories/zjm-101.webp","left":4,"right":1204,"section":0,"shake":false},{"kind":"dialogue","head":1196,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:9","scriptId":20761,"text":"“毕竟是海滩嘛，穿上泳装更容易行动啦。”","background":"/art/stories/zjm-101.webp","left":4,"right":1196,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:10","scriptId":20761,"text":"“算了，偶尔休息一下也不错。”","background":"/art/stories/zjm-101.webp","left":4,"right":1196,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:11","scriptId":20761,"text":"“可惜维卡不在，我觉得她也应该来放松一下。”","background":"/art/stories/zjm-101.webp","left":4,"right":1196,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:12","scriptId":20761,"text":"“但……你怎么也跟来了？”","background":"/art/stories/zjm-101.webp","left":4,"right":1196,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20761:20761:13","scriptId":20761,"text":"望向另一边，一个熟悉的身影窜了出来，原来是蕾贝卡。","background":"/art/stories/zjm-101.webp","left":4,"right":1196,"section":0,"shake":false},{"kind":"dialogue","head":1141,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:14","scriptId":20761,"text":"“当然是上头的要求啦，毕竟是特殊监视对象，怎么可能就让你和波西亚单独处理？”","background":"/art/stories/zjm-101.webp","left":4,"right":1141,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:15","scriptId":20761,"text":"“我也姑且算是带了小队，虽然她们也不太正经就是了。”","background":"/art/stories/zjm-101.webp","left":4,"right":1141,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:16","scriptId":20761,"text":"“话说回来，我看你也打算趁这个机会来夏威夷度假吧。”","background":"/art/stories/zjm-101.webp","left":4,"right":1141,"section":0,"shake":false},{"kind":"dialogue","head":1141,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:17","scriptId":20761,"text":"“嘿嘿，这种事情就没必要说穿了吧，难道你打算向上面打小报告？”","background":"/art/stories/zjm-101.webp","left":4,"right":1141,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:18","scriptId":20761,"text":"“我哪有那个胆子。”","background":"/art/stories/zjm-101.webp","left":4,"right":1141,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20761:20761:20","scriptId":20761,"text":"一行人向着沙滩的另一边走了一会儿——","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1193,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:21","scriptId":20761,"text":"“你们终于来了啊，我都打算提前开始了。”","background":"/art/stories/zjm-101.webp","left":null,"right":1193,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20761:20761:22","scriptId":20761,"text":"只见穿着泳装的波西娅和另一位客人正等在沙滩边。","background":"/art/stories/zjm-101.webp","left":null,"right":1193,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:23","scriptId":20761,"text":"“哇……这可真是秀色可餐啊，没想到我这辈子还能看到旅行者的泳装。”","background":"/art/stories/zjm-101.webp","left":4,"right":1193,"section":0,"shake":false},{"kind":"dialogue","head":1205,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:24","scriptId":20761,"text":"“……”","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":false},{"kind":"dialogue","head":1205,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:25","scriptId":20761,"text":"“只不过是义体而已，我对地球人的审美还不甚了解。”","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:26","scriptId":20761,"text":"“兰布达说艾丽莎你的义体因为过热的问题需要进行调整，她人呢？”","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":false},{"kind":"dialogue","head":1193,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:27","scriptId":20761,"text":"“兰布达已经回去了，而且你不是也看见了，新泳装已经给艾丽莎换上了。”","background":"/art/stories/zjm-101.webp","left":4,"right":1193,"section":0,"shake":false},{"kind":"dialogue","head":1205,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:28","scriptId":20761,"text":"“换上这个叫泳装的服装之后散热确实好了不少。”","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:29","scriptId":20761,"text":"“嗯？等等，调试工作不会说的是艾丽莎的泳装吧？？”","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":false},{"kind":"dialogue","head":1193,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:30","scriptId":20761,"text":"“没错啊，这可不是一般的泳装，材料都是见都没见过的品种。”","background":"/art/stories/zjm-101.webp","left":4,"right":1193,"section":0,"shake":false},{"kind":"dialogue","head":1205,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:31","scriptId":20761,"text":"“海风也吹够了，那就开始测试了。”","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:32","scriptId":20761,"text":"“诶？”","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20761:20761:33","scriptId":20761,"text":"说罢，艾丽莎周身的聚合炮开始发出赤色的亮光。","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:34","scriptId":20761,"text":"“周围的空气好像开始变冷了？这难道是在吸收周边的热能？”","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":false},{"kind":"dialogue","head":1205,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:35","scriptId":20761,"text":"“没错，反应还挺快。”","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20761:20761:38","scriptId":20761,"text":"一发聚合炮在无人的海面上炸开了，大量的渔获被炸到了海滩上。","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":true},{"kind":"dialogue","head":1193,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:39","scriptId":20761,"text":"“这威力都快赶上列车炮了啊，还好是在海面上试射。”","background":"/art/stories/zjm-101.webp","left":4,"right":1193,"section":0,"shake":false},{"kind":"dialogue","head":1205,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:40","scriptId":20761,"text":"“考虑到爆炸范围我还特别减少了总出力，威力应该只有普通的30%，不值一提。”","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:41","scriptId":20761,"text":"（不是全力发射就有这种威力，果然这次护卫基本没有风险可言……）","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:42","scriptId":20761,"text":"“看来没什么大问题，可以安心度假了。”","background":"/art/stories/zjm-101.webp","left":4,"right":1205,"section":0,"shake":false},{"kind":"dialogue","head":1193,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:43","scriptId":20761,"text":"“稳定性还要再测试一下，之后几天的场地封锁的文书和给团长的报告就拜托你了。”","background":"/art/stories/zjm-101.webp","left":4,"right":1193,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:44","scriptId":20761,"text":"“书面工作果然不少啊，我就知道没那么简单……”","background":"/art/stories/zjm-101.webp","left":4,"right":1193,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:45","scriptId":20761,"text":"“算了，还是想想今晚吃什么吧。”","background":"/art/stories/zjm-101.webp","left":4,"right":1193,"section":0,"shake":false},{"kind":"dialogue","head":1141,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:46","scriptId":20761,"text":"“大家可以收集一下被炸上来的渔获，今晚可以加餐了。”","background":"/art/stories/zjm-101.webp","left":4,"right":1141,"section":0,"shake":false},{"kind":"dialogue","head":1197,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20761:20761:47","scriptId":20761,"text":"“这算是赶海的一种吗？我要玩。”","background":"/art/stories/zjm-101.webp","left":1197,"right":1141,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20761:20761:48","scriptId":20761,"text":"就这样，围绕着艾丽莎的测试，众人开始了夏日休假。","background":"/art/stories/zjm-101.webp","left":1197,"right":1141,"section":0,"shake":false}],"summaries":[]}
