{"schemaVersion":1,"id":-40749,"sections":[{"id":"script-20749","name":"原始脚本 20749","scripts":[20749],"start":0,"count":52}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20749:20749:1","scriptId":20749,"text":"死水勤务办公室中——","background":"/art/stories/zjm-099.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:2","scriptId":20749,"text":"“外面好像有点吵闹啊？是发生了什么事吗？”","background":"/art/stories/zjm-099.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1188,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:3","scriptId":20749,"text":"“长官难道忘了吗？今天会有一批新的钢舞姬到达死水。”","background":"/art/stories/zjm-099.webp","left":4,"right":1188,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:4","scriptId":20749,"text":"“啊，好像是接到过报告书，因为和我关系不大，所以没有太在意。”","background":"/art/stories/zjm-099.webp","left":4,"right":1188,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20749:20749:5","scriptId":20749,"text":"翻了翻堆叠在办公桌上的文件，果然找到了之前的报告书。","background":"/art/stories/zjm-099.webp","left":4,"right":1188,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:6","scriptId":20749,"text":"“从这些制式型号上也看不出什么特别的，都是一些常见的型号……”","background":"/art/stories/zjm-099.webp","left":4,"right":1188,"section":0,"shake":false},{"kind":"dialogue","head":1188,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:7","scriptId":20749,"text":"“因为都是实验室改造的旧型号，虽然文件记录上没什么区别，但性能有着天差地别。”","background":"/art/stories/zjm-099.webp","left":4,"right":1188,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:8","scriptId":20749,"text":"“喔？”","background":"/art/stories/zjm-099.webp","left":4,"right":1188,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20749:20749:9","scriptId":20749,"text":"就在这时，办公室的门被敲响了。","background":"/art/stories/zjm-099.webp","left":4,"right":1188,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:10","scriptId":20749,"text":"“进来。”","background":"/art/stories/zjm-099.webp","left":4,"right":1188,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20749:20749:11","scriptId":20749,"text":"得到了回应后，门砰地一声打开了。从门外走进来一个身高两米超过的钢舞姬。","background":"/art/stories/zjm-099.webp","left":4,"right":1188,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:12","scriptId":20749,"text":"“报告，我是埃丽芙·贝塞尔，新来的钢舞姬，有人告诉我这里可以办理登记手续。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:13","scriptId":20749,"text":"“我这儿不是专门登记的，不过也可以帮忙登记就是了。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:14","scriptId":20749,"text":"“非常感谢，我对这基地不熟，而且被那么多人围观有点不舒服。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:15","scriptId":20749,"text":"（体型如此庞大的钢舞姬确实不多见，也难怪外面会吵闹了。）","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1188,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:16","scriptId":20749,"text":"“登记文件和相关档案已经准备好了。”","background":"/art/stories/zjm-099.webp","left":1188,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:17","scriptId":20749,"text":"“那就正式开始吧，埃丽芙。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:18","scriptId":20749,"text":"“是！”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:19","scriptId":20749,"text":"“我是死水的指挥官之一，她是奈特莉，我的书记官。同时也是钢舞姬护卫。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1188,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:20","scriptId":20749,"text":"“你好，埃丽芙。”","background":"/art/stories/zjm-099.webp","left":1188,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:21","scriptId":20749,"text":"“你好。”","background":"/art/stories/zjm-099.webp","left":1188,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:22","scriptId":20749,"text":"“你的履历我粗略看了一下，在校成绩的各项指标都非常优秀。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:23","scriptId":20749,"text":"“而且还有地区军官的推荐信，能力方面应该没有问题。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:24","scriptId":20749,"text":"“谢谢。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:25","scriptId":20749,"text":"“不过……”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:26","scriptId":20749,"text":"“不过？”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:27","scriptId":20749,"text":"“看你履历上的身高应该没有两米以上吧，难道是舞装的关系？”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:28","scriptId":20749,"text":"“是的，这套舞装为了增加越野机动性，采用了新式的反曲关节。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20749:20749:29","scriptId":20749,"text":"埃丽芙抬起小腿，这里的关节和人类的小腿构造完全相反。","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:30","scriptId":20749,"text":"“反曲关节？”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:31","scriptId":20749,"text":"“听说这是以狮型战车兽为原型设计的舞装，爆发力和机动力远超普通钢舞姬。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:32","scriptId":20749,"text":"“呃……听着就像是某疯狂研究员的点子，而且这特殊的兽耳接收器……不会是波西娅吧？”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:33","scriptId":20749,"text":"“喔？您认识波西娅博士吗？这套舞装正是她开发的得意之作。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20749:20749:34","scriptId":20749,"text":"埃丽芙一脸自豪的样子，而一旁的奈特莉则是一脸担忧。","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1188,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:35","scriptId":20749,"text":"“即便是钢舞姬恐怕也无法承受这反曲构造吧……难道实验室对埃丽芙进行了身体改造？”","background":"/art/stories/zjm-099.webp","left":1188,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:36","scriptId":20749,"text":"“奈特莉的着眼点跟我一样啊。不能否定……毕竟是那个波西娅……”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:37","scriptId":20749,"text":"“这点的话不用担心，在使用这套舞装的时候要先把大小腿闭合，用膝盖连结扩张的反曲关节。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20749:20749:38","scriptId":20749,"text":"埃丽芙指了指自己的大腿部分，那里确实要比一般人的大腿要粗壮不少。","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:39","scriptId":20749,"text":"“原来是这种设计啊……但这样应该很辛苦吧，实验室的那群家伙不考虑舞装对钢舞姬的负担吗？”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1188,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:40","scriptId":20749,"text":"“是啊，这就等于长时间跪着，会对膝关节造成影响的吧。”","background":"/art/stories/zjm-099.webp","left":1188,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:41","scriptId":20749,"text":"“习惯的话就好了，刚开始使用的时候确实有些难受。”","background":"/art/stories/zjm-099.webp","left":1188,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1188,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:42","scriptId":20749,"text":"“可以想象……毕竟这种装载方式非常跳脱常识。”","background":"/art/stories/zjm-099.webp","left":1188,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:43","scriptId":20749,"text":"“现在已经好多了，而且舞装内部有安装疏导减压系统，连续作战一昼夜是完全没有问题的。”","background":"/art/stories/zjm-099.webp","left":1188,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:44","scriptId":20749,"text":"“真是辛苦你了，我可不想死水被人称作黑心企业。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:45","scriptId":20749,"text":"“但超过三天的话，还是需要卸下舞装进行深度休息和腿部按摩的。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:46","scriptId":20749,"text":"“嗯，我会特别注意你的作战时长，尽量减少连续作战的时间。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:47","scriptId":20749,"text":"“非常感谢，虽然我有听说死水是个残酷的佣兵组织，但没想到还能遇上你这样温柔的长官呢。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1188,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:48","scriptId":20749,"text":"“哈哈，我们的这位长官可是死水里的老好人了，遇到他的话，你就不用担心待遇问题啦。”","background":"/art/stories/zjm-099.webp","left":1188,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:49","scriptId":20749,"text":"“那我的运气还真是不错。”","background":"/art/stories/zjm-099.webp","left":1188,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:50","scriptId":20749,"text":"“既然是波西娅设计的舞装，性能方面应该无可挑剔。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:51","scriptId":20749,"text":"“那么面试登记就先到这里，期待你今后的活跃表现了。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false},{"kind":"dialogue","head":1199,"speaker":"埃丽芙·贝塞尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20749:20749:52","scriptId":20749,"text":"“了解。”","background":"/art/stories/zjm-099.webp","left":4,"right":1199,"section":0,"shake":false}],"summaries":[]}
