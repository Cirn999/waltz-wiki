{"schemaVersion":1,"id":17,"sections":[{"id":"109010-PROLOGUE","name":"第 1 战 · 战前","scripts":[520],"start":0,"count":18},{"id":"109010-EPILOGUE","name":"第 1 战 · 战后","scripts":[10510],"start":18,"count":6},{"id":"109011-PROLOGUE","name":"第 2 战 · 战前","scripts":[530],"start":24,"count":8},{"id":"109011-EPILOGUE","name":"第 2 战 · 战后","scripts":[10520],"start":32,"count":3},{"id":"109012-PROLOGUE","name":"第 3 战 · 战前","scripts":[540],"start":35,"count":5},{"id":"109012-EPILOGUE","name":"第 3 战 · 战后","scripts":[10530],"start":40,"count":11},{"id":"109013-PROLOGUE","name":"第 4 战 · 战前","scripts":[550],"start":51,"count":13},{"id":"109013-EPILOGUE","name":"第 4 战 · 战后","scripts":[10540],"start":64,"count":8},{"id":"109014-PROLOGUE","name":"第 5 战 · 战前","scripts":[560],"start":72,"count":8},{"id":"109014-EPILOGUE","name":"第 5 战 · 战后","scripts":[10550],"start":80,"count":12}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109010-PROLOGUE:520:2","scriptId":520,"text":"第一次参加夺旗战，算是有惊无险，完成了任务。","background":"/art/stories/zjm-090.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109010-PROLOGUE:520:4","scriptId":520,"text":"我坐在会议室等待佐伊她们。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:5","scriptId":520,"text":"“我靠！竟然径直撤离战场，也不事先告诉我们一下！”","background":"/art/stories/zjm-047.webp","left":40,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:6","scriptId":520,"text":"“事先告诉你的话……我想想还是算了。”","background":"/art/stories/zjm-047.webp","left":40,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:7","scriptId":520,"text":"“为什么？”","background":"/art/stories/zjm-047.webp","left":41,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:8","scriptId":520,"text":"“反正就算告诉你也还是进行拖延作战而已，从结果看并没什么区别。”","background":"/art/stories/zjm-047.webp","left":41,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:9","scriptId":520,"text":"“……”","background":"/art/stories/zjm-047.webp","left":40,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109010-PROLOGUE:520:10","scriptId":520,"text":"就在这时，奈乐小队和索菲亚教官也来到了会议室。","background":"/art/stories/zjm-047.webp","left":40,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:11","scriptId":520,"text":"“恩，马马虎虎算是完成了夺旗任务，还不错。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109010-PROLOGUE:520:12","scriptId":520,"text":"随后索菲亚教官简单的交待了下之后要进行的搜索任务。","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:13","scriptId":520,"text":"“大致的任务就是这么回事，那么这次的侦察任务就由奈乐领队。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":109,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:14","scriptId":520,"text":"“恩，大致任务内容我已经都知道了。”","background":"/art/stories/zjm-047.webp","left":211,"right":109,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:15","scriptId":520,"text":"“诶！？不是我来指挥吗？”","background":"/art/stories/zjm-047.webp","left":3,"right":109,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:16","scriptId":520,"text":"“嗯？有什么意见吗？卖队友的指挥官？”","background":"/art/stories/zjm-047.webp","left":3,"right":219,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:17","scriptId":520,"text":"“呃……我那叫顾全大局，最后旗帜还是保住了。”","background":"/art/stories/zjm-047.webp","left":3,"right":219,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:18","scriptId":520,"text":"“我有说让你做解释了吗？”","background":"/art/stories/zjm-047.webp","left":3,"right":219,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:19","scriptId":520,"text":"“……一切听凭教官安排……”","background":"/art/stories/zjm-047.webp","left":3,"right":219,"section":0,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109010-PROLOGUE:520:20","scriptId":520,"text":"（哦也～）","background":"/art/stories/zjm-047.webp","left":39,"right":219,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109010-EPILOGUE:10510:1","scriptId":10510,"text":"正式开始任务，协同还是猎虎小队，只不过指挥权交给了奈乐。","background":"/art/stories/zjm-090.webp","left":39,"right":219,"section":1,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109010-EPILOGUE:10510:2","scriptId":10510,"text":"“根据老爸的指示，这次任务还会有死水公司的特派队伍和我们同行。”","background":"/art/stories/zjm-090.webp","left":103,"right":219,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109010-EPILOGUE:10510:3","scriptId":10510,"text":"“诶？那不就是说有三个队伍一起执行这次的任务？”","background":"/art/stories/zjm-090.webp","left":103,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109010-EPILOGUE:10510:4","scriptId":10510,"text":"“恩，毕竟正规队伍有限，只能问佣兵公司借点了。”","background":"/art/stories/zjm-090.webp","left":103,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109010-EPILOGUE:10510:5","scriptId":10510,"text":"“看来隆美尔司令还是很宝贝你的嘛……”","background":"/art/stories/zjm-090.webp","left":103,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":107,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109010-EPILOGUE:10510:6","scriptId":10510,"text":"“哪有～”","background":"/art/stories/zjm-090.webp","left":107,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109011-PROLOGUE:530:2","scriptId":530,"text":"“唉……”","background":"/art/stories/zjm-090.webp","left":107,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109011-PROLOGUE:530:3","scriptId":530,"text":"“有什么好叹气的？”","background":"/art/stories/zjm-090.webp","left":103,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109011-PROLOGUE:530:4","scriptId":530,"text":"“既然我都不用指挥了，应该不需要去了吧……而且还有三个小队。”","background":"/art/stories/zjm-090.webp","left":103,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109011-PROLOGUE:530:5","scriptId":530,"text":"“不要那么沮丧嘛～至少你还是我们小队的指挥官啦。”","background":"/art/stories/zjm-090.webp","left":39,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109011-PROLOGUE:530:6","scriptId":530,"text":"“佐伊偶尔也会说说像样的话嘛～”","background":"/art/stories/zjm-090.webp","left":39,"right":81,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109011-PROLOGUE:530:7","scriptId":530,"text":"“战术指挥的辅佐还是需要的，所以长官还是长官。我就不改口叫你小弟了。”","background":"/art/stories/zjm-090.webp","left":103,"right":81,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109011-PROLOGUE:530:8","scriptId":530,"text":"“……”","background":"/art/stories/zjm-090.webp","left":103,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109011-PROLOGUE:530:9","scriptId":530,"text":"（哎，如果索菲亚教官真的有意让我全权指挥的话，就不会让长官随行了……）","background":"/art/stories/zjm-090.webp","left":103,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109011-EPILOGUE:10520:1","scriptId":10520,"text":"“那这次和我们一起行动的是哪个佣兵队啊？死水佣兵都挺有名气的。”","background":"/art/stories/zjm-090.webp","left":3,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109011-EPILOGUE:10520:2","scriptId":10520,"text":"“我也不清楚，只通知了我汇合地点。”","background":"/art/stories/zjm-090.webp","left":3,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109011-EPILOGUE:10520:3","scriptId":10520,"text":"“不过我也能大致猜到会是哪个队了……”","background":"/art/stories/zjm-090.webp","left":3,"right":103,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109012-PROLOGUE:540:2","scriptId":540,"text":"快要抵达集合地点所在的位置。","background":"/art/stories/zdbjbz-07.webp","left":3,"right":103,"section":4,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109012-PROLOGUE:540:3","scriptId":540,"text":"“前方有队伍正在和战车兽群作战。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":81,"section":4,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109012-PROLOGUE:540:4","scriptId":540,"text":"“那肯定是死水佣兵队了。”","background":"/art/stories/zdbjbz-07.webp","left":103,"right":81,"section":4,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109012-PROLOGUE:540:5","scriptId":540,"text":"“要去帮忙吗？”","background":"/art/stories/zdbjbz-07.webp","left":103,"right":81,"section":4,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109012-PROLOGUE:540:6","scriptId":540,"text":"“应该不需要，不过也不能在这干瞪眼，我们就清理掉一点周围的残余战车兽吧。”","background":"/art/stories/zdbjbz-07.webp","left":103,"right":81,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109012-EPILOGUE:10530:1","scriptId":10530,"text":"战斗结束以后和死水佣兵队顺利会合。","background":"/art/stories/zdbjbz-07.webp","left":103,"right":81,"section":5,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109012-EPILOGUE:10530:2","scriptId":10530,"text":"“……果然是沙狐小队。”","background":"/art/stories/zdbjbz-07.webp","left":103,"right":81,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109012-EPILOGUE:10530:3","scriptId":10530,"text":"“沙狐小队？就是那个支援非洲支部并且剿灭北非大量战车兽巢穴的沙狐小队？”","background":"/art/stories/zdbjbz-07.webp","left":103,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":225,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109012-EPILOGUE:10530:4","scriptId":10530,"text":"“恩，正是我们沙狐小队，死水佣兵集团的招牌小队之一～”","background":"/art/stories/zdbjbz-07.webp","left":225,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":225,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109012-EPILOGUE:10530:5","scriptId":10530,"text":"“我是蕾贝卡·隆美尔，沙狐小队的队长。”","background":"/art/stories/zdbjbz-07.webp","left":225,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109012-EPILOGUE:10530:6","scriptId":10530,"text":"“诶！？隆美尔……”","background":"/art/stories/zdbjbz-07.webp","left":225,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109012-EPILOGUE:10530:7","scriptId":10530,"text":"“那岂不是和奈乐同姓？”","background":"/art/stories/zdbjbz-07.webp","left":225,"right":41,"section":5,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109012-EPILOGUE:10530:8","scriptId":10530,"text":"“……”","background":"/art/stories/zdbjbz-07.webp","left":103,"right":41,"section":5,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109012-EPILOGUE:10530:9","scriptId":10530,"text":"“恩，我和奈乐是同父异母的姐妹。”","background":"/art/stories/zdbjbz-07.webp","left":103,"right":223,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109012-EPILOGUE:10530:10","scriptId":10530,"text":"气氛整个变得诡异了起来……","background":"/art/stories/zdbjbz-07.webp","left":103,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109012-EPILOGUE:10530:11","scriptId":10530,"text":"（好复杂的家庭关系，我们还是不要废话太多……）","background":"/art/stories/zdbjbz-07.webp","left":3,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109013-PROLOGUE:550:2","scriptId":550,"text":"“这两位是露米娜·施泰特和雷娅·古德里安，我的两位得力助手。”","background":"/art/stories/zdbjbz-07.webp","left":223,"right":223,"section":6,"shake":false},{"kind":"dialogue","head":247,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109013-PROLOGUE:550:3","scriptId":550,"text":"“大家好，我是雷娅，沙狐小队的主攻手～”","background":"/art/stories/zdbjbz-07.webp","left":223,"right":247,"section":6,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109013-PROLOGUE:550:4","scriptId":550,"text":"“我是露米娜·施泰特-----啊！？”","background":"/art/stories/zdbjbz-07.webp","left":235,"right":247,"section":6,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109013-PROLOGUE:550:5","scriptId":550,"text":"露米娜说到一半，突然被什么东西吸引了注意力。","background":"/art/stories/zdbjbz-07.webp","left":235,"right":247,"section":6,"shake":false},{"kind":"dialogue","head":243,"speaker":"露米娜·施泰特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109013-PROLOGUE:550:6","scriptId":550,"text":"“普莉玛？真的是普莉玛？好久不见！”","background":"/art/stories/zdbjbz-07.webp","left":243,"right":247,"section":6,"shake":false},{"kind":"dialogue","head":100,"speaker":"普莉玛·派普","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109013-PROLOGUE:550:7","scriptId":550,"text":"“好久不见……露米娜还有雷娅。”","background":"/art/stories/zdbjbz-07.webp","left":243,"right":100,"section":6,"shake":false},{"kind":"dialogue","head":249,"speaker":"雷娅·古德里安","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109013-PROLOGUE:550:8","scriptId":550,"text":"“哇～普莉玛，胸前那对赘肉又大了不少，都快变成西瓜了。”","background":"/art/stories/zdbjbz-07.webp","left":249,"right":100,"section":6,"shake":false},{"kind":"dialogue","head":96,"speaker":"普莉玛·派普","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109013-PROLOGUE:550:9","scriptId":550,"text":"“没……没那么大啦。”","background":"/art/stories/zdbjbz-07.webp","left":249,"right":96,"section":6,"shake":false},{"kind":"dialogue","head":91,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109013-PROLOGUE:550:10","scriptId":550,"text":"（哼，和普莉玛组队每次谈到这种话题总是压力不小……）","background":"/art/stories/zdbjbz-07.webp","left":91,"right":96,"section":6,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109013-PROLOGUE:550:11","scriptId":550,"text":"（我还在成长期，还有希望的……）","background":"/art/stories/zdbjbz-07.webp","left":91,"right":39,"section":6,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109013-PROLOGUE:550:12","scriptId":550,"text":"（……）","background":"/art/stories/zdbjbz-07.webp","left":91,"right":103,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109013-PROLOGUE:550:13","scriptId":550,"text":"“咳哼……打断一下，你们认识？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":103,"section":6,"shake":false},{"kind":"dialogue","head":100,"speaker":"普莉玛·派普","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109013-PROLOGUE:550:14","scriptId":550,"text":"“恩……我们以前住一个小镇的。”","background":"/art/stories/zdbjbz-07.webp","left":100,"right":103,"section":6,"shake":false},{"kind":"dialogue","head":225,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109013-EPILOGUE:10540:1","scriptId":10540,"text":"“话说这次父亲叫我来支援奈乐，我还真是很高兴呢～”","background":"/art/stories/zdbjbz-07.webp","left":225,"right":103,"section":7,"shake":false},{"kind":"dialogue","head":108,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109013-EPILOGUE:10540:2","scriptId":10540,"text":"“哼，老爸就是喜欢爱管闲事。”","background":"/art/stories/zdbjbz-07.webp","left":225,"right":108,"section":7,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109013-EPILOGUE:10540:3","scriptId":10540,"text":"“奈乐什么时候才肯改口叫我姐姐呢～”","background":"/art/stories/zdbjbz-07.webp","left":231,"right":108,"section":7,"shake":false},{"kind":"dialogue","head":108,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109013-EPILOGUE:10540:4","scriptId":10540,"text":"“死也不要！”","background":"/art/stories/zdbjbz-07.webp","left":231,"right":108,"section":7,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109013-EPILOGUE:10540:5","scriptId":10540,"text":"“奈乐真是不可爱啊～明明继承了老爸的血统长得那么俊俏的说。”","background":"/art/stories/zdbjbz-07.webp","left":231,"right":108,"section":7,"shake":false},{"kind":"dialogue","head":108,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109013-EPILOGUE:10540:6","scriptId":10540,"text":"“我是不会承认那个东方女人和我老爸的关系！”","background":"/art/stories/zdbjbz-07.webp","left":231,"right":108,"section":7,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109013-EPILOGUE:10540:7","scriptId":10540,"text":"“又来了～”","background":"/art/stories/zdbjbz-07.webp","left":231,"right":108,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109013-EPILOGUE:10540:8","scriptId":10540,"text":"（完全不敢插嘴……但是前面那个岔路应该要往哪边走呢？）","background":"/art/stories/zdbjbz-07.webp","left":231,"right":3,"section":7,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109014-PROLOGUE:560:2","scriptId":560,"text":"有了沙狐小队的精英支援，路途上的战车兽分分钟灰飞烟灭，根本是势不可挡啊。","background":"/art/stories/zdbjbz-07.webp","left":231,"right":3,"section":8,"shake":false},{"kind":"dialogue","head":242,"speaker":"露米娜·施泰特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109014-PROLOGUE:560:3","scriptId":560,"text":"“前方发现战车兽，三点钟方向发现蜥蜴型战车兽和熊类。”","background":"/art/stories/zdbjbz-07.webp","left":242,"right":3,"section":8,"shake":false},{"kind":"dialogue","head":237,"speaker":"露米娜·施泰特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109014-PROLOGUE:560:4","scriptId":560,"text":"“对付蜥蜴可以先用高爆弹破坏它们的机动力，而对付黑熊的话，近距离使用硬芯穿甲弹能更好的穿透它们的护甲。”","background":"/art/stories/zdbjbz-07.webp","left":237,"right":3,"section":8,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109014-PROLOGUE:560:5","scriptId":560,"text":"“哇，好厉害哦，感觉和教官一样～”","background":"/art/stories/zdbjbz-07.webp","left":237,"right":41,"section":8,"shake":false},{"kind":"dialogue","head":249,"speaker":"雷娅·古德里安","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109014-PROLOGUE:560:6","scriptId":560,"text":"“当然啦～露米娜可是我的得力搭档，她的推荐不会有错的。”","background":"/art/stories/zdbjbz-07.webp","left":249,"right":41,"section":8,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109014-PROLOGUE:560:7","scriptId":560,"text":"“死水佣兵果然个个都是精英啊～”","background":"/art/stories/zdbjbz-07.webp","left":81,"right":41,"section":8,"shake":false},{"kind":"dialogue","head":249,"speaker":"雷娅·古德里安","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109014-PROLOGUE:560:8","scriptId":560,"text":"“价格可是很高的哟～”","background":"/art/stories/zdbjbz-07.webp","left":249,"right":41,"section":8,"shake":false},{"kind":"dialogue","head":100,"speaker":"普莉玛·派普","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109014-PROLOGUE:560:9","scriptId":560,"text":"“那我就先用高爆弹进行一轮阵地炮击了。”","background":"/art/stories/zdbjbz-07.webp","left":249,"right":100,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109014-EPILOGUE:10550:1","scriptId":10550,"text":"分分钟扫清战场，而且都是最佳的应对方式。","background":"/art/stories/zdbjbz-07.webp","left":249,"right":100,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109014-EPILOGUE:10550:2","scriptId":10550,"text":"“沙狐队员都是身经百战的战士，临场发挥游刃有余啊，完全不需要什么指挥嘛。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":100,"section":9,"shake":false},{"kind":"dialogue","head":225,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109014-EPILOGUE:10550:3","scriptId":10550,"text":"“怎么？作为军官感觉到压力了吗～”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":225,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109014-EPILOGUE:10550:4","scriptId":10550,"text":"“说实话是有那么点，感觉自己的存在意义被缩小了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":225,"section":9,"shake":false},{"kind":"dialogue","head":225,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109014-EPILOGUE:10550:5","scriptId":10550,"text":"“按父亲的话说，战斗小队的指挥官既要积极主动，又要坚决果断。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":225,"section":9,"shake":false},{"kind":"dialogue","head":225,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109014-EPILOGUE:10550:6","scriptId":10550,"text":"“像你这样随同钢舞姬一起行动的指挥官已经不多了。高官们都喜欢蹲在会议室里纸上谈兵。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":225,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109014-EPILOGUE:10550:7","scriptId":10550,"text":"“我只是官阶低，更像炮灰脸吧……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":225,"section":9,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109014-EPILOGUE:10550:8","scriptId":10550,"text":"“只有在第一线的指挥官才能更快更准确的掌握战局，然而那些怕死的军官们都不理解这一点。”","background":"/art/stories/zdbjbz-07.webp","left":103,"right":225,"section":9,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109014-EPILOGUE:10550:9","scriptId":10550,"text":"“既然不喜欢那些军官，就来死水吧～可以为钱战斗，不，更加随心所欲的战斗。”","background":"/art/stories/zdbjbz-07.webp","left":103,"right":223,"section":9,"shake":false},{"kind":"dialogue","head":108,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109014-EPILOGUE:10550:10","scriptId":10550,"text":"“我才不要，我只为老爸效力。”","background":"/art/stories/zdbjbz-07.webp","left":108,"right":223,"section":9,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109014-EPILOGUE:10550:11","scriptId":10550,"text":"“我们现在也是为父亲效力，不是吗～”","background":"/art/stories/zdbjbz-07.webp","left":108,"right":231,"section":9,"shake":false},{"kind":"dialogue","head":108,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109014-EPILOGUE:10550:12","scriptId":10550,"text":"“哼！我才不听你的歪理。”","background":"/art/stories/zdbjbz-07.webp","left":108,"right":231,"section":9,"shake":false}],"summaries":["顺利完成夺旗任务，有惊无险，和奈乐汇合，开始正式的侦察任务。","简单听取了一下奈乐那边得来的第一手情报，准备和新队伍汇合。","快到集合地点了，前方正在交战！？","和沙狐小队汇合，看上去好强力的样子，这下信心十足了。","虽然一路畅通无阻，不过这连携配合真的能顺利完成任务吗……"]}
