{"schemaVersion":1,"id":12,"sections":[{"id":"108007-PROLOGUE","name":"第 1 战 · 战前","scripts":[350],"start":0,"count":6},{"id":"108007-EPILOGUE","name":"第 1 战 · 战后","scripts":[10340],"start":6,"count":2},{"id":"108008-PROLOGUE","name":"第 2 战 · 战前","scripts":[360],"start":8,"count":14},{"id":"108008-EPILOGUE","name":"第 2 战 · 战后","scripts":[10350],"start":22,"count":2},{"id":"108009-PROLOGUE","name":"第 3 战 · 战前","scripts":[370,371,372,373],"start":24,"count":24},{"id":"108009-EPILOGUE","name":"第 3 战 · 战后","scripts":[10360,10362,10363,10364],"start":48,"count":36}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108007-PROLOGUE:350:2","scriptId":350,"text":"重返齐格菲研究所，这次挑选了另一条路线。","background":"/art/stories/zdbjbz-10.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108007-PROLOGUE:350:3","scriptId":350,"text":"“这次没有猎虎小队的支援，压力不小啊。”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108007-PROLOGUE:350:4","scriptId":350,"text":"“要不我们联络一下奈乐她们？”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108007-PROLOGUE:350:5","scriptId":350,"text":"“这倒也是个办法，索菲亚教官的命令是寻找线索，并没限定我们手段。”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108007-PROLOGUE:350:6","scriptId":350,"text":"“也没限定时间～”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108007-PROLOGUE:350:7","scriptId":350,"text":"“说的也是～”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108007-EPILOGUE:10340:0","scriptId":10340,"text":"听了佐伊的意见，我们决定先找个通信站联络一下奈乐。","background":"/art/stories/zdbjbz-10.webp","left":3,"right":31,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108007-EPILOGUE:10340:1","scriptId":10340,"text":"好在最近的通信站离这儿不算太远。","background":"/art/stories/zdbjbz-10.webp","left":3,"right":31,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108008-PROLOGUE:360:2","scriptId":360,"text":"找到了一个通信站，佐伊立刻拨通连接奈乐的无线电。","background":"/art/stories/zdbjbz-10.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108008-PROLOGUE:360:3","scriptId":360,"text":"“是奈乐吗？”","background":"/art/stories/zdbjbz-10.webp","left":31,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108008-PROLOGUE:360:4","scriptId":360,"text":"“吊车尾？”","background":"/art/stories/zdbjbz-10.webp","left":31,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108008-PROLOGUE:360:5","scriptId":360,"text":"“……”","background":"/art/stories/zdbjbz-10.webp","left":40,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108008-PROLOGUE:360:6","scriptId":360,"text":"“喂喂？没人？我挂了噢？”","background":"/art/stories/zdbjbz-10.webp","left":40,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108008-PROLOGUE:360:7","scriptId":360,"text":"“嗯……是我佐伊，我让长官和你说……”","background":"/art/stories/zdbjbz-10.webp","left":40,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108008-PROLOGUE:360:8","scriptId":360,"text":"“喂，奈乐吗，我需要你的支援，这次的任务是重返调查那个人形怪物。”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108008-PROLOGUE:360:9","scriptId":360,"text":"“呃，我收到老爸的命令，先要去次伏龙芝学院，暂时帮不了你们。”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108008-PROLOGUE:360:10","scriptId":360,"text":"“真是太巧了，我们就在伏龙芝学院附近。你办完事的话，要不和我们一起去调查？”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108008-PROLOGUE:360:11","scriptId":360,"text":"“也行，不影响我的任务就行，那么伏龙芝学院见。”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":103,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108008-PROLOGUE:360:12","scriptId":360,"text":"奈乐说完就挂断了。","background":"/art/stories/zdbjbz-10.webp","left":3,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108008-PROLOGUE:360:13","scriptId":360,"text":"“那么我们就回伏龙芝吧～”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108008-PROLOGUE:360:14","scriptId":360,"text":"“你不怕被索菲亚教官说延误任务？”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108008-PROLOGUE:360:15","scriptId":360,"text":"“不被她发现就行……”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108008-EPILOGUE:10350:0","scriptId":10350,"text":"为了和奈乐汇合，我们又偷偷摸摸地返回了伏龙芝学院……","background":"/art/stories/zdbjbz-10.webp","left":3,"right":40,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108008-EPILOGUE:10350:1","scriptId":10350,"text":"希望会平安无事吧。","background":"/art/stories/zdbjbz-10.webp","left":3,"right":40,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108009-PROLOGUE:370:2","scriptId":370,"text":"返回伏龙芝，因为怕被索菲亚教官看到，所以就决定在学校附近等奈乐。","background":"/art/stories/zdbjbz-10.webp","left":3,"right":40,"section":4,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:370:3","scriptId":370,"text":"“长官，这样真的没问题吗？”","background":"/art/stories/zdbjbz-10.webp","left":41,"right":40,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:370:4","scriptId":370,"text":"“应该吧……这次我也不太确定……”","background":"/art/stories/zdbjbz-10.webp","left":41,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:370:5","scriptId":370,"text":"“那我推荐离校门最近的中继站蹲点奈乐会更好。”","background":"/art/stories/zdbjbz-10.webp","left":61,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:370:6","scriptId":370,"text":"“恩，特别是在实训演习期间，周围的战车兽不少。”","background":"/art/stories/zdbjbz-10.webp","left":61,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:370:7","scriptId":370,"text":"“老样子，大家轮流站岗呗。”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108009-PROLOGUE:371:2","scriptId":371,"text":"返回伏龙芝，因为怕被索菲亚教官看到，所以就决定在学校附近等奈乐。","background":"/art/stories/zdbjbz-10.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:371:3","scriptId":371,"text":"“长官，这样真的没问题吗？”","background":"/art/stories/zdbjbz-10.webp","left":41,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:371:4","scriptId":371,"text":"“应该吧……这次我也不太确定……”","background":"/art/stories/zdbjbz-10.webp","left":41,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:371:5","scriptId":371,"text":"“就在中继站等吧，那边有补给，也是个明显的地标。”","background":"/art/stories/zdbjbz-10.webp","left":1171,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:371:6","scriptId":371,"text":"“恩，特别是在实训演习期间，周围的战车兽不少。”","background":"/art/stories/zdbjbz-10.webp","left":1171,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:371:7","scriptId":371,"text":"“老样子，大家轮流站岗呗。”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108009-PROLOGUE:372:2","scriptId":372,"text":"返回伏龙芝，因为怕被索菲亚教官看到，所以就决定在学校附近等奈乐。","background":"/art/stories/zdbjbz-10.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:372:3","scriptId":372,"text":"“长官，这样真的没问题吗？”","background":"/art/stories/zdbjbz-10.webp","left":41,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:372:4","scriptId":372,"text":"“应该吧……这次我也不太确定……”","background":"/art/stories/zdbjbz-10.webp","left":41,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:372:5","scriptId":372,"text":"“要等人的话，自然是选比较明显的地方会比较好。”","background":"/art/stories/zdbjbz-10.webp","left":1146,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:372:6","scriptId":372,"text":"“先在中继站休息下吧，反正也不知道等的人什么时候来。”","background":"/art/stories/zdbjbz-10.webp","left":1146,"right":968,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:372:7","scriptId":372,"text":"“行吧，就去那儿等。”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":968,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108009-PROLOGUE:373:2","scriptId":373,"text":"返回伏龙芝，因为怕被索菲亚教官看到，所以就决定在学校附近等奈乐。","background":"/art/stories/zdbjbz-10.webp","left":3,"right":968,"section":4,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:373:3","scriptId":373,"text":"“长官，这样真的没问题吗？”","background":"/art/stories/zdbjbz-10.webp","left":41,"right":968,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:373:4","scriptId":373,"text":"“应该吧……这次我也不太确定……”","background":"/art/stories/zdbjbz-10.webp","left":41,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:373:5","scriptId":373,"text":"“如果不确定时间的话，找个能休息的地方等待是最好的。”","background":"/art/stories/zdbjbz-10.webp","left":1170,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:373:6","scriptId":373,"text":"“恩，中继站是个不错的选择。”","background":"/art/stories/zdbjbz-10.webp","left":1170,"right":1158,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-PROLOGUE:373:7","scriptId":373,"text":"“好的，那就这么办吧。”","background":"/art/stories/zdbjbz-10.webp","left":3,"right":1158,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108009-EPILOGUE:10360:1","scriptId":10360,"text":"在中继站蹲守了好几天，受到了三四波战车兽的小规模袭击。","background":"/art/stories/zdbjbz-10.webp","left":3,"right":1158,"section":5,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10360:2","scriptId":10360,"text":"“长官，都蹲了快一周了，怎么还没见到奈乐……”","background":"/art/stories/zdbjbz-10.webp","left":40,"right":1158,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10360:3","scriptId":10360,"text":"“从路程上考虑，应该差不多快到了吧。”","background":"/art/stories/zdbjbz-10.webp","left":40,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10360:4","scriptId":10360,"text":"“报告！！”","background":"/art/stories/zdbjbz-10.webp","left":61,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10360:5","scriptId":10360,"text":"“恩？又是战车兽袭击？”","background":"/art/stories/zdbjbz-10.webp","left":61,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10360:6","scriptId":10360,"text":"“不是……索菲亚教官从学校方向朝我们来了……”","background":"/art/stories/zdbjbz-10.webp","left":61,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10360:7","scriptId":10360,"text":"“什么！！？？”","background":"/art/stories/zdbjbz-10.webp","left":61,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10360:8","scriptId":10360,"text":"“………………………………”","background":"/art/stories/zdbjbz-10.webp","left":39,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10360:9","scriptId":10360,"text":"“报告！！佐伊她吓得昏过去了。”","background":"/art/stories/zdbjbz-10.webp","left":71,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108009-EPILOGUE:10362:1","scriptId":10362,"text":"在中继站蹲守了好几天，受到了三四波战车兽的小规模袭击。","background":"/art/stories/zdbjbz-10.webp","left":71,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10362:2","scriptId":10362,"text":"“长官，都蹲了快一周了，怎么还没见到奈乐……”","background":"/art/stories/zdbjbz-10.webp","left":40,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10362:3","scriptId":10362,"text":"“从路程上考虑，应该差不多快到了吧。”","background":"/art/stories/zdbjbz-10.webp","left":40,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10362:4","scriptId":10362,"text":"“报告！！”","background":"/art/stories/zdbjbz-10.webp","left":1171,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10362:5","scriptId":10362,"text":"“恩？又是战车兽袭击？”","background":"/art/stories/zdbjbz-10.webp","left":1171,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10362:6","scriptId":10362,"text":"“索菲亚教官从学校方向朝我们来了，而且还是全速前进的状态。”","background":"/art/stories/zdbjbz-10.webp","left":1171,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10362:7","scriptId":10362,"text":"“What！！？？”","background":"/art/stories/zdbjbz-10.webp","left":1171,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10362:8","scriptId":10362,"text":"“………………………………”","background":"/art/stories/zdbjbz-10.webp","left":39,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10362:9","scriptId":10362,"text":"“报告！！佐伊她吓得昏过去了。”","background":"/art/stories/zdbjbz-10.webp","left":71,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108009-EPILOGUE:10363:1","scriptId":10363,"text":"在中继站蹲守了好几天，受到了三四波战车兽的小规模袭击。","background":"/art/stories/zdbjbz-10.webp","left":71,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10363:2","scriptId":10363,"text":"“长官，都蹲了快一周了，怎么还没见到奈乐……”","background":"/art/stories/zdbjbz-10.webp","left":40,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10363:3","scriptId":10363,"text":"“从路程上考虑，应该差不多快到了吧。”","background":"/art/stories/zdbjbz-10.webp","left":40,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10363:4","scriptId":10363,"text":"“不好了！！”","background":"/art/stories/zdbjbz-10.webp","left":1146,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10363:5","scriptId":10363,"text":"“恩？又是战车兽袭击？”","background":"/art/stories/zdbjbz-10.webp","left":1146,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10363:6","scriptId":10363,"text":"“那个……索菲亚教官好像发现了我们，正朝着这边行进中。”","background":"/art/stories/zdbjbz-10.webp","left":1146,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10363:7","scriptId":10363,"text":"“What！！？？”","background":"/art/stories/zdbjbz-10.webp","left":1146,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10363:8","scriptId":10363,"text":"“………………………………”","background":"/art/stories/zdbjbz-10.webp","left":39,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10363:9","scriptId":10363,"text":"“想逃也来不及了，佐伊她吓得昏过去了。”","background":"/art/stories/zdbjbz-10.webp","left":968,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108009-EPILOGUE:10364:1","scriptId":10364,"text":"在中继站蹲守了好几天，受到了三四波战车兽的小规模袭击。","background":"/art/stories/zdbjbz-10.webp","left":968,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10364:2","scriptId":10364,"text":"“长官，都蹲了快一周了，怎么还没见到奈乐……”","background":"/art/stories/zdbjbz-10.webp","left":40,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10364:3","scriptId":10364,"text":"“从路程上考虑，应该差不多快到了吧。”","background":"/art/stories/zdbjbz-10.webp","left":40,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10364:4","scriptId":10364,"text":"“情况不太对。”","background":"/art/stories/zdbjbz-10.webp","left":1170,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10364:5","scriptId":10364,"text":"“恩？又是战车兽袭击？”","background":"/art/stories/zdbjbz-10.webp","left":1170,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10364:6","scriptId":10364,"text":"“是索菲亚教官，她从学校方向朝我们这边冲过来了……可能被她发现了吧。”","background":"/art/stories/zdbjbz-10.webp","left":1170,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10364:7","scriptId":10364,"text":"“What！！？？”","background":"/art/stories/zdbjbz-10.webp","left":1170,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10364:8","scriptId":10364,"text":"“………………………………”","background":"/art/stories/zdbjbz-10.webp","left":39,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108009-EPILOGUE:10364:9","scriptId":10364,"text":"“那个……佐伊可能是惊吓过度，已经躺地上了。”","background":"/art/stories/zdbjbz-10.webp","left":1158,"right":3,"section":5,"shake":false}],"summaries":["执行索菲亚教官的命令重返齐格菲研究所。","到达了一个通信站，联络上了奈乐，听听她对这次任务的看法。","伏龙芝学院外围蹲守奈乐……"]}
