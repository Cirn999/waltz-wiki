{"schemaVersion":1,"id":-40122,"sections":[{"id":"script-20122","name":"原始脚本 20122","scripts":[20122],"start":0,"count":36}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20122:20122:0","scriptId":20122,"text":"结果因为波西娅的追加要求，我们等到了清晨时分才进行了对软泥的进攻作战。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20122:20122:1","scriptId":20122,"text":"不过就像事先想的如出一辙……确实没法一下就制伏这个软泥，中途还分裂了好几次。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20122:20122:2","scriptId":20122,"text":"废了九牛二虎之力才把这快软泥打回了原形——一堆烂泥。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:3","scriptId":20122,"text":"“唉……最后还是没有捕获成功啊……”","background":"/art/stories/zjm-047.webp","left":608,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20122:20122:4","scriptId":20122,"text":"波西娅把那些脏兮兮的软泥和装甲碎片一点点装进密封的研究用素材袋中。","background":"/art/stories/zjm-047.webp","left":608,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:5","scriptId":20122,"text":"“不过竟然没有发现旅行者的踪迹，难道是我想太多了？”","background":"/art/stories/zjm-047.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:6","scriptId":20122,"text":"“是啊，有点可惜呢～”","background":"/art/stories/zjm-047.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:7","scriptId":20122,"text":"“那个……这样就没问题了吗？”","background":"/art/stories/zjm-047.webp","left":608,"right":680,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20122:20122:8","scriptId":20122,"text":"诺伊娜把已经装满的素材袋子递给了波西娅。","background":"/art/stories/zjm-047.webp","left":608,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:9","scriptId":20122,"text":"“恩～很好，就这样～”","background":"/art/stories/zjm-047.webp","left":608,"right":680,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20122:20122:10","scriptId":20122,"text":"波西娅把装有软泥“尸体”的袋子往吉普车的后座上一扔。","background":"/art/stories/zjm-047.webp","left":608,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:11","scriptId":20122,"text":"“回去分析一下，不知道这些残渣能有什么剩余价值。”","background":"/art/stories/zjm-047.webp","left":608,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:12","scriptId":20122,"text":"“那就拜托您了。”","background":"/art/stories/zjm-047.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:13","scriptId":20122,"text":"“哪儿的话，如果又发现了什么的话记得第一时间通知我～”","background":"/art/stories/zjm-047.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20122:20122:15","scriptId":20122,"text":"波西娅就这么一路风尘仆仆地回科研基地去了。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20122:20122:16","scriptId":20122,"text":"科研基地中——","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:17","scriptId":20122,"text":"“我回来了～”","background":"/art/stories/zjm-047.webp","left":608,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:18","scriptId":20122,"text":"“姐姐，你怎么全身脏兮兮的啊？”","background":"/art/stories/zjm-047.webp","left":608,"right":728,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20122:20122:19","scriptId":20122,"text":"看到波西娅手里提着一大堆素材袋，刚起床的尤拉有点吃惊。","background":"/art/stories/zjm-047.webp","left":608,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:20","scriptId":20122,"text":"“这些都是今天早上的‘战利品’～等会儿我要好好分析一下这些粘土～”","background":"/art/stories/zjm-047.webp","left":608,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:21","scriptId":20122,"text":"“呃……还是一如既往的恶趣味十足啊，快去洗个澡，脏死了啦。”","background":"/art/stories/zjm-047.webp","left":608,"right":728,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20122:20122:22","scriptId":20122,"text":"波西娅闻了闻自己的大褂，意识到身上确实有不小的味道","background":"/art/stories/zjm-047.webp","left":608,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:23","scriptId":20122,"text":"“恩……我这就去洗～”","background":"/art/stories/zjm-047.webp","left":608,"right":728,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20122:20122:25","scriptId":20122,"text":"波西娅离开不久后，艾丽莎来到了实验室。","background":"/art/stories/zjm-047.webp","left":null,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":13,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:26","scriptId":20122,"text":"“早啊，尤拉，刚刚好像有听到波西娅的声音？”","background":"/art/stories/zjm-047.webp","left":null,"right":13,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:27","scriptId":20122,"text":"“恩～刚回来，不过带了这么一堆烂泥回来，好恶心……”","background":"/art/stories/zjm-047.webp","left":728,"right":13,"section":0,"shake":false},{"kind":"dialogue","head":13,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:28","scriptId":20122,"text":"“烂泥？”","background":"/art/stories/zjm-047.webp","left":728,"right":13,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20122:20122:29","scriptId":20122,"text":"艾丽莎走到堆成小山的素材袋前，从里面取了一个出来，打开一看——","background":"/art/stories/zjm-047.webp","left":728,"right":13,"section":0,"shake":false},{"kind":"dialogue","head":13,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:30","scriptId":20122,"text":"（这不就是一般的泥土嘛……等等……这个碎片是……劣化的聚合物？）","background":"/art/stories/zjm-047.webp","left":728,"right":13,"section":0,"shake":false},{"kind":"dialogue","head":13,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:31","scriptId":20122,"text":"（到底是谁把这东西带到这个岛上的……）","background":"/art/stories/zjm-047.webp","left":728,"right":13,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:32","scriptId":20122,"text":"“诶？艾丽莎不要碰那东西，很脏的！”","background":"/art/stories/zjm-047.webp","left":728,"right":13,"section":0,"shake":false},{"kind":"dialogue","head":13,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:33","scriptId":20122,"text":"“哦……”","background":"/art/stories/zjm-047.webp","left":728,"right":13,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20122:20122:34","scriptId":20122,"text":"听到尤拉的提醒，艾丽莎又把袋子关上放了回去。","background":"/art/stories/zjm-047.webp","left":728,"right":13,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:35","scriptId":20122,"text":"“反正姐姐看起来之后要一直研究这堆臭东西，我们找个地方出去玩玩吧～夏威夷有不少好玩的地方呢～”","background":"/art/stories/zjm-047.webp","left":728,"right":13,"section":0,"shake":false},{"kind":"dialogue","head":13,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:36","scriptId":20122,"text":"“恩，可以尝尝夏威夷的特殊食物～”","background":"/art/stories/zjm-047.webp","left":728,"right":13,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20122:20122:37","scriptId":20122,"text":"“那叫特产啦，特产～”","background":"/art/stories/zjm-047.webp","left":728,"right":13,"section":0,"shake":false}],"summaries":[]}
