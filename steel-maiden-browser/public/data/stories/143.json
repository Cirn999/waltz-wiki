{"schemaVersion":1,"id":143,"sections":[{"id":"207014-PROLOGUE","name":"第 1 战 · 战前","scripts":[20753],"start":0,"count":11}],"frames":[{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207014-PROLOGUE:20753:1","scriptId":20753,"text":"“没想到成了佣兵以后反而背上了一屁股债……”","background":"/art/stories/zjm-099.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207014-PROLOGUE:20753:2","scriptId":20753,"text":"“姐姐还是给您添了不少麻烦，真是过意不去。”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207014-PROLOGUE:20753:3","scriptId":20753,"text":"“还行吧……往好了想，只要还掉债以后就可以完全独立了。”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207014-PROLOGUE:20753:4","scriptId":20753,"text":"“嗯，考虑到死水的高额报酬，还债的任务不算太重。”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207014-PROLOGUE:20753:5","scriptId":20753,"text":"“话说回来，死水最有钱的人应该是波西娅吧？”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207014-PROLOGUE:20753:6","scriptId":20753,"text":"“是的，听说她的财产除了专利之外还有不少来源不明的资金。”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207014-PROLOGUE:20753:7","scriptId":20753,"text":"“这就不是我们该管的事情了。”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207014-PROLOGUE:20753:8","scriptId":20753,"text":"“就连死水团长都要对她敬畏三分，而且她还认识不少特勤局的政要。”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207014-PROLOGUE:20753:9","scriptId":20753,"text":"“佩妮，你知道的还真多啊……”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207014-PROLOGUE:20753:10","scriptId":20753,"text":"“是的，波西娅在死水工作纯粹只是因为自由，大部分人都管不了她。”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207014-PROLOGUE:20753:11","scriptId":20753,"text":"“等等，我已经不想听下去了，跟她扯上关系总没好事……”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false}],"summaries":[]}
