{"schemaVersion":1,"id":4,"sections":[{"id":"106007-PROLOGUE","name":"第 1 战 · 战前","scripts":[70,71,72,73],"start":0,"count":13},{"id":"106007-EPILOGUE","name":"第 1 战 · 战后","scripts":[10060],"start":13,"count":3},{"id":"106008-PROLOGUE","name":"第 2 战 · 战前","scripts":[80,81,82,83],"start":16,"count":28},{"id":"106008-EPILOGUE","name":"第 2 战 · 战后","scripts":[10070,10071,10072,10073],"start":44,"count":14},{"id":"106009-PROLOGUE","name":"第 3 战 · 战前","scripts":[90],"start":58,"count":1},{"id":"106009-EPILOGUE","name":"第 3 战 · 战后","scripts":[10080,10081,10082,10083],"start":59,"count":21}],"frames":[{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106007-PROLOGUE:70:2","scriptId":70,"text":"“这里停水了？我刚想洗澡就遇到没水……”","background":"/art/stories/zjm-066.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106007-PROLOGUE:70:3","scriptId":70,"text":"“昨天还好好的啊。”","background":"/art/stories/zjm-066.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106007-PROLOGUE:70:4","scriptId":70,"text":"“看来只能去水厂跑一次了，我有种不祥的预感。”","background":"/art/stories/zjm-066.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106007-PROLOGUE:71:2","scriptId":71,"text":"“这里停水了？我刚想洗澡就遇到没水……”","background":"/art/stories/zjm-066.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106007-PROLOGUE:71:3","scriptId":71,"text":"“昨天还好好的啊。”","background":"/art/stories/zjm-066.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106007-PROLOGUE:71:4","scriptId":71,"text":"“看来只能去水厂跑一次了，我有种不祥的预感。”","background":"/art/stories/zjm-066.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106007-PROLOGUE:72:2","scriptId":72,"text":"“这里停水了？我刚想洗澡就遇到没水……”","background":"/art/stories/zjm-066.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106007-PROLOGUE:72:3","scriptId":72,"text":"“一两天不洗没事的。”","background":"/art/stories/zjm-066.webp","left":3,"right":968,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106007-PROLOGUE:72:4","scriptId":72,"text":"“但这样的话，饮用水也会受到影响。”","background":"/art/stories/zjm-066.webp","left":3,"right":968,"section":0,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106007-PROLOGUE:72:5","scriptId":72,"text":"“那只能去水厂看看了，快点通知人员出发吧。”","background":"/art/stories/zjm-066.webp","left":3,"right":968,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106007-PROLOGUE:73:2","scriptId":73,"text":"“这里停水了？我刚想洗澡就遇到没水……”","background":"/art/stories/zjm-066.webp","left":3,"right":968,"section":0,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106007-PROLOGUE:73:3","scriptId":73,"text":"“水源中断可是重大事件，长官，展开调查吧。”","background":"/art/stories/zjm-066.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106007-PROLOGUE:73:4","scriptId":73,"text":"“嗯，看来只能去水厂跑一次了，我有种不祥的预感。”","background":"/art/stories/zjm-066.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106007-EPILOGUE:10060:1","scriptId":10060,"text":"“就如预料的一样，战车兽想控制我们的水力，真是可怕。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1158,"section":1,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106007-EPILOGUE:10060:2","scriptId":10060,"text":"“不就是少喝几杯水嘛，不碍事的。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":31,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106007-EPILOGUE:10060:3","scriptId":10060,"text":"“……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":31,"section":1,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:80:2","scriptId":80,"text":"“前方发现大量爬虫类战车兽，这个数量以我们的战斗力恐怕无能为力。”","background":"/art/stories/zdbjbz-07.webp","left":61,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:80:3","scriptId":80,"text":"“这可就麻烦大了，爬虫类战车兽的探知能力比较强大，找突破点没那么容易。”","background":"/art/stories/zdbjbz-07.webp","left":61,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:80:4","scriptId":80,"text":"“我去当诱饵，引开它们怎么样？”","background":"/art/stories/zdbjbz-07.webp","left":38,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:80:5","scriptId":80,"text":"“哦？偶尔你还是能想出点像样的作战方式么。引开主力以后，就准备突袭水厂。”","background":"/art/stories/zdbjbz-07.webp","left":38,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:80:6","scriptId":80,"text":"“哼哼，那是当然，我去去就来。”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:80:7","scriptId":80,"text":"“等等……没让你去，派小飞象去就行了……”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:81:2","scriptId":81,"text":"“前方发现大量爬虫类战车兽，这个数量以我们的战斗力恐怕无能为力。”","background":"/art/stories/zdbjbz-07.webp","left":71,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:81:3","scriptId":81,"text":"“这可就麻烦大了，爬虫类战车兽的探知能力比较强大，找突破点没那么容易。”","background":"/art/stories/zdbjbz-07.webp","left":71,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:81:4","scriptId":81,"text":"“而且爬虫类的动作很难预判，只能通过火力把它们压回去。”","background":"/art/stories/zdbjbz-07.webp","left":1171,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:81:5","scriptId":81,"text":"“我们现在最缺乏的但就是火力。”","background":"/art/stories/zdbjbz-07.webp","left":1171,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:81:6","scriptId":81,"text":"“要不我去当诱饵引开它们怎么样？”","background":"/art/stories/zdbjbz-07.webp","left":38,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:81:7","scriptId":81,"text":"“哦？偶尔你还是能想出点像样的作战方式么。引开主力以后，就准备突袭水厂。”","background":"/art/stories/zdbjbz-07.webp","left":38,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:81:8","scriptId":81,"text":"“哼哼，那是当然，我去去就来。”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:81:9","scriptId":81,"text":"“等等……没让你去，派小飞象去就行了……”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:82:2","scriptId":82,"text":"“前方发现大量爬虫类战车兽，目测是无法正面突破的数量。”","background":"/art/stories/zdbjbz-07.webp","left":1146,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:82:3","scriptId":82,"text":"“索菲？你不是可以单人突破么？机会来了。”","background":"/art/stories/zdbjbz-07.webp","left":1146,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":973,"speaker":"索菲·阿登","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:82:4","scriptId":82,"text":"“呃……算了吧……爬虫类怪恶心的……我想还是算了……”","background":"/art/stories/zdbjbz-07.webp","left":973,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:82:5","scriptId":82,"text":"“这可就麻烦大了，爬虫类战车兽的探知能力比较强大，找突破点没那么容易。”","background":"/art/stories/zdbjbz-07.webp","left":973,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:82:6","scriptId":82,"text":"“我去当诱饵，引开它们怎么样？”","background":"/art/stories/zdbjbz-07.webp","left":38,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:82:7","scriptId":82,"text":"“哦？偶尔你还是能想出点像样的作战方式么。引开主力以后，就准备突袭水厂。”","background":"/art/stories/zdbjbz-07.webp","left":38,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:82:8","scriptId":82,"text":"“哼哼，那是当然，我去去就来。”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:82:9","scriptId":82,"text":"“等等……没让你去，派小飞象去就行了……”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:83:2","scriptId":83,"text":"“前方发现大量爬虫类战车兽，数量非常惊人，如果被拖进消耗战恐怕难以全身而退。”","background":"/art/stories/zdbjbz-07.webp","left":1170,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:83:3","scriptId":83,"text":"“这可就麻烦大了，爬虫类战车兽的探知能力比较强大，找突破点没那么容易。”","background":"/art/stories/zdbjbz-07.webp","left":1170,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:83:4","scriptId":83,"text":"“我去当诱饵，引开它们怎么样？”","background":"/art/stories/zdbjbz-07.webp","left":38,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:83:5","scriptId":83,"text":"“哦？偶尔你还是能想出点像样的作战方式么。引开主力以后，就准备突袭水厂。”","background":"/art/stories/zdbjbz-07.webp","left":38,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:83:6","scriptId":83,"text":"“哼哼，那是当然，我去去就来。”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-PROLOGUE:83:7","scriptId":83,"text":"“等等……没让你去，派小飞象去就行了……”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10070:1","scriptId":10070,"text":"“很好，终于快到水厂的控制室了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10070:2","scriptId":10070,"text":"“不过引开的敌军主力回来了怎么办？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10070:3","scriptId":10070,"text":"“不用担心，我自有妙计。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10071:1","scriptId":10071,"text":"“很好，终于快到水厂的控制室了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":3,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10071:2","scriptId":10071,"text":"“不过引开的敌军主力回来了怎么办？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10071:3","scriptId":10071,"text":"“不用担心，我自有妙计。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10072:1","scriptId":10072,"text":"“很好，终于快到水厂的控制室了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":3,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10072:2","scriptId":10072,"text":"“好死不死，那些战车兽又回来了，我去干掉他们。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":968,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10072:3","scriptId":10072,"text":"“大可不必，接下来就交给我吧。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":968,"section":3,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10072:4","scriptId":10072,"text":"“哦？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":968,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10073:1","scriptId":10073,"text":"“很好，终于快到水厂的控制室了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":968,"section":3,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10073:2","scriptId":10073,"text":"“战车兽的主力快回来了，我给你们殿后，准备突围吧。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1158,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10073:3","scriptId":10073,"text":"“不不不，没有这个必要，接下来看我的就行了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1158,"section":3,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106008-EPILOGUE:10073:4","scriptId":10073,"text":"“是吗？那就等着看您大展身手了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1158,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-PROLOGUE:90:2","scriptId":90,"text":"“虽说引开了大批敌人，但是这里残留的战车兽还是不少啊。大家注意了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1158,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10080:1","scriptId":10080,"text":"“搞定收工。准备撤离。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1158,"section":5,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10080:2","scriptId":10080,"text":"“小飞象引开的主力已经回来了怎么办！？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10080:3","scriptId":10080,"text":"“把冷气开到最大，然后等半个小时。我们就能大摇大摆的出去了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10080:4","scriptId":10080,"text":"“利用温度使爬虫类冬眠么？好战术！”","background":"/art/stories/zdbjbz-07.webp","left":61,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10081:1","scriptId":10081,"text":"“搞定收工。准备撤离。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10081:2","scriptId":10081,"text":"“小飞象引开的主力已经回来了怎么办！？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10081:3","scriptId":10081,"text":"“把冷气开到最大，然后等半个小时。我们就能大摇大摆的出去了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":163,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10081:4","scriptId":10081,"text":"“通过冷气来驱散战车兽吗？”","background":"/art/stories/zdbjbz-07.webp","left":163,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10081:5","scriptId":10081,"text":"“不，因为这里的战车兽爬虫类居多，低温可以让他们行动迟缓，昏昏欲睡。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10082:1","scriptId":10082,"text":"“搞定收工。准备撤离。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10082:2","scriptId":10082,"text":"“小飞象引开的主力已经回来了怎么办！？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10082:3","scriptId":10082,"text":"“把冷气开到最大，然后等半个小时。我们就能大摇大摆的出去了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":975,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10082:4","scriptId":10082,"text":"“什么意思？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":975,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10082:5","scriptId":10082,"text":"“通过冷气降低战车兽们的活性。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":975,"section":5,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10082:6","scriptId":10082,"text":"“哦哦！？还有这种操作啊？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":968,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10083:1","scriptId":10083,"text":"“搞定收工。准备撤离。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":968,"section":5,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10083:2","scriptId":10083,"text":"“小飞象引开的主力已经回来了怎么办！？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10083:3","scriptId":10083,"text":"“把冷气开到最大，然后等半个小时。我们就能大摇大摆的出去了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10083:4","scriptId":10083,"text":"“是利用冷气来封锁战车兽的行动咯？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1158,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10083:5","scriptId":10083,"text":"“没错。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1158,"section":5,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106009-EPILOGUE:10083:6","scriptId":10083,"text":"“头脑很灵活啊，本来可能是要来一场恶战了。”","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":1158,"section":5,"shake":false}],"summaries":["没想到原来这里是停电还停水，电力总算是修复了，不过没水也是比较头疼的事情，只能再去水厂跑一趟了。","唉，虽然已经料到水厂也会有战车兽，但是这不科学的数量……果然爬虫类的繁殖能力拔群么……","收复水厂大作战开启！希望大家能好好执行我的战斗部署……"]}
