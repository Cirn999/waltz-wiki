{"schemaVersion":1,"id":348,"sections":[{"id":"807001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20557],"start":0,"count":16},{"id":"807001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20558],"start":16,"count":24}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-PROLOGUE:20557:1","scriptId":20557,"text":"向亚当斯长官要了一周的时间进行突击培训。","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-PROLOGUE:20557:2","scriptId":20557,"text":"一周的时间很快就过去了——","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-PROLOGUE:20557:3","scriptId":20557,"text":"在此期间亚当斯长官也指派了专属空勤教官来对我们华尔兹中队进行航空知识补习。","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-PROLOGUE:20557:4","scriptId":20557,"text":"至于佐伊她们能学到多少就不太清楚了。","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-PROLOGUE:20557:5","scriptId":20557,"text":"但快速的填鸭式培训着实有点效果，至少不会再发生让轰炸机去对付截击机的尴尬问题。","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-PROLOGUE:20557:6","scriptId":20557,"text":"“希望你今天能给我一个满意的战绩。”","background":"/art/stories/zjm-132.webp","left":1111,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-PROLOGUE:20557:7","scriptId":20557,"text":"今天的目标很简单，击败火鹰小队。","background":"/art/stories/zjm-132.webp","left":1111,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"807001-PROLOGUE:20557:8","scriptId":20557,"text":"“我会努力的。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-PROLOGUE:20557:9","scriptId":20557,"text":"这时玛加丽塔走过来小声对我说。","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1116,"speaker":"玛加丽塔·杰米多娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-PROLOGUE:20557:10","scriptId":20557,"text":"“希望长官不要让我失望啊~上次只是亚当斯长官的坏心眼啦~”（小声）","background":"/art/stories/zjm-132.webp","left":1116,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1116,"speaker":"玛加丽塔·杰米多娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-PROLOGUE:20557:11","scriptId":20557,"text":"“让新手指挥直接上空战，谁都知道会是那种结果。削削你的锐气~”（小声）","background":"/art/stories/zjm-132.webp","left":1116,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"807001-PROLOGUE:20557:12","scriptId":20557,"text":"“原来是这样吗……”（小声）","background":"/art/stories/zjm-132.webp","left":1116,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1125,"speaker":"娜奥米·兰开斯特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-PROLOGUE:20557:13","scriptId":20557,"text":"“玛加丽塔，该走了。”","background":"/art/stories/zjm-132.webp","left":1125,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1116,"speaker":"玛加丽塔·杰米多娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-PROLOGUE:20557:14","scriptId":20557,"text":"“来了~”","background":"/art/stories/zjm-132.webp","left":1116,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-PROLOGUE:20557:16","scriptId":20557,"text":"今天和上周不同，并不是空中遭遇战，而是防御作战。","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-PROLOGUE:20557:17","scriptId":20557,"text":"作战目标：阻止火鹰小队对指定区域进行投弹。","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-EPILOGUE:20558:1","scriptId":20558,"text":"几轮交火过后。","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":1125,"speaker":"娜奥米·兰开斯特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:2","scriptId":20558,"text":"“不好办呢，航弹储量快没有了，对面有点难缠啊。”","background":"/art/stories/zjm-132.webp","left":1125,"right":null,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-EPILOGUE:20558:3","scriptId":20558,"text":"娜奥米虽然有尝试性的进行过俯冲轰炸，但效果并不理想。","background":"/art/stories/zjm-132.webp","left":1125,"right":null,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-EPILOGUE:20558:4","scriptId":20558,"text":"虽然有斯盖拉护航，但娜奥米被死死盯住，根本无法进行有效投弹。","background":"/art/stories/zjm-132.webp","left":1125,"right":null,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-EPILOGUE:20558:5","scriptId":20558,"text":"而玛加丽塔意外被地面的防空机枪打中早早退出了战场……","background":"/art/stories/zjm-132.webp","left":1125,"right":null,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-EPILOGUE:20558:6","scriptId":20558,"text":"最终火鹰小队因无法继续轰炸而放弃，算是华尔兹中队的胜利。","background":"/art/stories/zjm-132.webp","left":1125,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:9","scriptId":20558,"text":"“很有意思，竟然还藏了一手地勤防空。”","background":"/art/stories/zjm-104.webp","left":1111,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":1125,"speaker":"娜奥米·兰开斯特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:10","scriptId":20558,"text":"“虽然想抗议，但这种出其不意的作战手段或许才是战场所需要的。”","background":"/art/stories/zjm-104.webp","left":1111,"right":1125,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:11","scriptId":20558,"text":"“没错，让陆地钢舞姬装备防空武器对空中进行掩护，很有效的利用了自己的优势。”","background":"/art/stories/zjm-104.webp","left":1111,"right":1125,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:12","scriptId":20558,"text":"“过奖了，正好是防御战才能体现出效果，运气好而已。”","background":"/art/stories/zjm-104.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1116,"speaker":"玛加丽塔·杰米多娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:13","scriptId":20558,"text":"“运气也是实力的一部分啊，我就知道长官可以的~”","background":"/art/stories/zjm-104.webp","left":1116,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1125,"speaker":"娜奥米·兰开斯特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:14","scriptId":20558,"text":"“你没故意放水吧，玛加丽塔。”","background":"/art/stories/zjm-104.webp","left":1116,"right":1125,"section":1,"shake":false},{"kind":"dialogue","head":1116,"speaker":"玛加丽塔·杰米多娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:15","scriptId":20558,"text":"“怎么会，当突然被防空炮击中的时候，一时间我也有点慌了神呢。”","background":"/art/stories/zjm-104.webp","left":1116,"right":1125,"section":1,"shake":false},{"kind":"dialogue","head":1122,"speaker":"斯盖拉·波特曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:16","scriptId":20558,"text":"“始祖鸟小队也很难缠，失去了玛加丽塔以后，我也受到了不小的打击。”","background":"/art/stories/zjm-104.webp","left":1116,"right":1122,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-EPILOGUE:20558:17","scriptId":20558,"text":"斯盖拉指了指自己机翼上斑驳的漆痕。","background":"/art/stories/zjm-104.webp","left":1116,"right":1122,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:18","scriptId":20558,"text":"“总之，这下你们不会吐槽我这位人选弱了吧。”","background":"/art/stories/zjm-104.webp","left":1111,"right":1122,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"807001-EPILOGUE:20558:19","scriptId":20558,"text":"亚当斯对着始祖鸟小队说道，就好似这场作战就是为了让她们看清这一点。","background":"/art/stories/zjm-104.webp","left":1111,"right":1122,"section":1,"shake":false},{"kind":"dialogue","head":1115,"speaker":"利季娅·达诺娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:20","scriptId":20558,"text":"“哼，确实还不赖，这家伙可堪一用。”","background":"/art/stories/zjm-104.webp","left":1111,"right":1115,"section":1,"shake":false},{"kind":"dialogue","head":1120,"speaker":"黛兰·沃茨","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:21","scriptId":20558,"text":"“但奇招也就能偶尔成功一两次，虽然这次是很成功就是了……”","background":"/art/stories/zjm-104.webp","left":1120,"right":1115,"section":1,"shake":false},{"kind":"dialogue","head":1118,"speaker":"妮莉·斯托克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:22","scriptId":20558,"text":"“能出奇制胜挺好的，看到斯盖拉当时那紧张的神情，我就想笑~嘻嘻嘻~”","background":"/art/stories/zjm-104.webp","left":1120,"right":1118,"section":1,"shake":false},{"kind":"dialogue","head":1126,"speaker":"阿比盖尔·麦克莱恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:23","scriptId":20558,"text":"“既然出了成绩，那就得承认，长官确实是一位才华出众的指挥官，之前那样说你真是对不起了。”","background":"/art/stories/zjm-104.webp","left":1126,"right":1118,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:24","scriptId":20558,"text":"“没事……”","background":"/art/stories/zjm-104.webp","left":1126,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:25","scriptId":20558,"text":"（早就习惯被佐伊她们奚落了，这点耐性我还是有的。）","background":"/art/stories/zjm-104.webp","left":1126,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"807001-EPILOGUE:20558:26","scriptId":20558,"text":"“那就这样，都回去整备一下吧，万一这时候基地受到袭击可就不好玩了。”","background":"/art/stories/zjm-104.webp","left":1111,"right":4,"section":1,"shake":false}],"summaries":[]}
