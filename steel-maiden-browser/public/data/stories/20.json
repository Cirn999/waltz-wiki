{"schemaVersion":1,"id":20,"sections":[{"id":"110007-PROLOGUE","name":"第 1 战 · 战前","scripts":[630],"start":0,"count":6},{"id":"110007-EPILOGUE","name":"第 1 战 · 战后","scripts":[10620],"start":6,"count":15},{"id":"110008-PROLOGUE","name":"第 2 战 · 战前","scripts":[640],"start":21,"count":4},{"id":"110008-EPILOGUE","name":"第 2 战 · 战后","scripts":[10630],"start":25,"count":15},{"id":"110009-PROLOGUE","name":"第 3 战 · 战前","scripts":[650],"start":40,"count":6},{"id":"110009-EPILOGUE","name":"第 3 战 · 战后","scripts":[10640],"start":46,"count":3}],"frames":[{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110007-PROLOGUE:630:2","scriptId":630,"text":"“刚才的乌龟好像和普通的战车兽不同。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110007-PROLOGUE:630:3","scriptId":630,"text":"“你也发现了这个问题？”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":223,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110007-PROLOGUE:630:4","scriptId":630,"text":"“恩，比起其他战车兽来说这机械化程度简直是天壤之别。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":223,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110007-PROLOGUE:630:5","scriptId":630,"text":"“总觉得新品种和人形生物这两者之间有很深的关系。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":223,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110007-PROLOGUE:630:6","scriptId":630,"text":"“有这可能，之前遇到人形生物的时候周围的战车兽也有点不太对劲。”","background":"/art/stories/zdbjbz-03.webp","left":103,"right":223,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110007-PROLOGUE:630:7","scriptId":630,"text":"“看来只有期望这趟调查能给出原因了。”","background":"/art/stories/zdbjbz-03.webp","left":103,"right":223,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110007-EPILOGUE:10620:1","scriptId":10620,"text":"终于快到齐格菲防线的外围了，研究所已经不远了。","background":"/art/stories/zdbjbz-03.webp","left":103,"right":223,"section":1,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110007-EPILOGUE:10620:2","scriptId":10620,"text":"“今天就先到这里，停止行进。”","background":"/art/stories/zdbjbz-03.webp","left":103,"right":223,"section":1,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110007-EPILOGUE:10620:3","scriptId":10620,"text":"“了解。”","background":"/art/stories/zdbjbz-03.webp","left":103,"right":235,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110007-EPILOGUE:10620:4","scriptId":10620,"text":"露米娜向在前方的佐伊和莉娜示意停止行进。","background":"/art/stories/zdbjbz-03.webp","left":103,"right":235,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110007-EPILOGUE:10620:5","scriptId":10620,"text":"因为没有比较好的庇护所，所以还是老样子就地扎营。","background":"/art/stories/zdbjbz-03.webp","left":103,"right":235,"section":1,"shake":false},{"kind":"dialogue","head":34,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110007-EPILOGUE:10620:6","scriptId":10620,"text":"“好累……在齐格菲周边做侦察时刻都要绷紧神经。”","background":"/art/stories/zdbjbz-03.webp","left":34,"right":235,"section":1,"shake":false},{"kind":"dialogue","head":87,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110007-EPILOGUE:10620:7","scriptId":10620,"text":"“这点程度就累了？”","background":"/art/stories/zdbjbz-03.webp","left":34,"right":87,"section":1,"shake":false},{"kind":"dialogue","head":34,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110007-EPILOGUE:10620:8","scriptId":10620,"text":"“谁让莉娜你跑那么快，做你的援护可比平常累上好几倍……”","background":"/art/stories/zdbjbz-03.webp","left":34,"right":87,"section":1,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110007-EPILOGUE:10620:9","scriptId":10620,"text":"“所谓的协同侦察就是要配合对方的步调来进行。”","background":"/art/stories/zdbjbz-03.webp","left":34,"right":235,"section":1,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110007-EPILOGUE:10620:10","scriptId":10620,"text":"“佐伊你的主要任务是跟随莉娜，在她被敌人发现的时候，给予第一波火力支援，好让莉娜安全后撤。”","background":"/art/stories/zdbjbz-03.webp","left":34,"right":235,"section":1,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110007-EPILOGUE:10620:11","scriptId":10620,"text":"“但是莉娜每次都容易跑出我的射程，还要我追上去，不然根本没法掩护……”","background":"/art/stories/zdbjbz-03.webp","left":40,"right":235,"section":1,"shake":false},{"kind":"dialogue","head":87,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110007-EPILOGUE:10620:12","scriptId":10620,"text":"“那还不是因为佐伊你腿短～”","background":"/art/stories/zdbjbz-03.webp","left":40,"right":87,"section":1,"shake":false},{"kind":"dialogue","head":242,"speaker":"露米娜·施泰特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110007-EPILOGUE:10620:13","scriptId":10620,"text":"“虽然佐伊的速度确实不太行，但是所谓的配合并不是他人迎合你，莉娜你也要适当放慢行进速度。”","background":"/art/stories/zdbjbz-03.webp","left":242,"right":87,"section":1,"shake":false},{"kind":"dialogue","head":84,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110007-EPILOGUE:10620:14","scriptId":10620,"text":"“好吧……”","background":"/art/stories/zdbjbz-03.webp","left":242,"right":84,"section":1,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110007-EPILOGUE:10620:15","scriptId":10620,"text":"（虽然批评的是莉娜，为什么我高兴不起来呢……）","background":"/art/stories/zdbjbz-03.webp","left":40,"right":84,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110008-PROLOGUE:640:2","scriptId":640,"text":"“快要到齐格菲研究所了，大家注意警惕周围。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":84,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110008-PROLOGUE:640:3","scriptId":640,"text":"“之前那条通道被我炸掉了，现在怎么走呢……”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110008-PROLOGUE:640:4","scriptId":640,"text":"“那只能先在周围找找有没有类似通道，最坏的情况么就是把那条通道挖开……”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110008-PROLOGUE:640:5","scriptId":640,"text":"“也只能这样了。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":103,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110008-EPILOGUE:10630:1","scriptId":10630,"text":"到达了齐格菲研究所的那条通道前，出现了令众人惊讶的情况。","background":"/art/stories/zdbjbz-03.webp","left":3,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110008-EPILOGUE:10630:2","scriptId":10630,"text":"“这是怎么回事？？”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110008-EPILOGUE:10630:3","scriptId":10630,"text":"“这通道不是好好得吗？我记得之前确实是被奈乐炸崩坍了啊。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":41,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110008-EPILOGUE:10630:4","scriptId":10630,"text":"“这实在是太奇怪了！现在该怎么办呢？就这么进去吗？","background":"/art/stories/zdbjbz-03.webp","left":103,"right":41,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110008-EPILOGUE:10630:5","scriptId":10630,"text":"“难道是陷阱……”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":41,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110008-EPILOGUE:10630:6","scriptId":10630,"text":"正当众人拿不定主意的时候，蕾贝卡发话了。","background":"/art/stories/zdbjbz-03.webp","left":3,"right":41,"section":3,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110008-EPILOGUE:10630:7","scriptId":10630,"text":"“不管前方有什么等待着我们，既然道路只有一条，那也只有前进一途。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":223,"section":3,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110008-EPILOGUE:10630:8","scriptId":10630,"text":"“为了防止全军覆没，长官的小队在这里待命，由沙狐和猎虎两小队执行内部侦察。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":223,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110008-EPILOGUE:10630:9","scriptId":10630,"text":"“什么！？”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":223,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110008-EPILOGUE:10630:10","scriptId":10630,"text":"“我同意蕾贝卡的说法，长官就算进去了也没什么帮助。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110008-EPILOGUE:10630:11","scriptId":10630,"text":"“那至少带上佐伊她们。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110008-EPILOGUE:10630:12","scriptId":10630,"text":"“那谁来保护在外围的长官？留一小队在外面接应也是必须的。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110008-EPILOGUE:10630:13","scriptId":10630,"text":"“好吧……”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110008-EPILOGUE:10630:14","scriptId":10630,"text":"“从现在开始24小时为侦察任务执行时间，如果超过时间，你们小队就直接返回伏龙芝报告情况。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110008-EPILOGUE:10630:15","scriptId":10630,"text":"“是！”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":103,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110009-PROLOGUE:650:2","scriptId":650,"text":"奈乐率队进入了通道，通道的内壁还存有上次炮击留下的痕迹。","background":"/art/stories/zdbjbz-15.webp","left":3,"right":103,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110009-PROLOGUE:650:3","scriptId":650,"text":"“奈乐，你说这个通道之前崩塌过？”","background":"/art/stories/zdbjbz-15.webp","left":3,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110009-PROLOGUE:650:4","scriptId":650,"text":"“恩。”","background":"/art/stories/zdbjbz-15.webp","left":103,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110009-PROLOGUE:650:5","scriptId":650,"text":"“从周围的痕迹看来是这么回事情，但是这通道确实被人为的清理过。”","background":"/art/stories/zdbjbz-15.webp","left":103,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":242,"speaker":"露米娜·施泰特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110009-PROLOGUE:650:6","scriptId":650,"text":"“前方已经侦察到少量战车兽的痕迹了，出了通道应该就会遇上战车兽。”","background":"/art/stories/zdbjbz-15.webp","left":242,"right":223,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110009-PROLOGUE:650:7","scriptId":650,"text":"走出通道，果然来了一堆战车兽。","background":"/art/stories/zdbjbz-15.webp","left":242,"right":223,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110009-EPILOGUE:10640:1","scriptId":10640,"text":"快速清除了小批战车兽以后，奈乐她们继续前进。","background":"/art/stories/zdbjbz-03.webp","left":242,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110009-EPILOGUE:10640:2","scriptId":10640,"text":"“不明人形怪物随时都可能出现，大家要更加警惕。”","background":"/art/stories/zdbjbz-03.webp","left":223,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110009-EPILOGUE:10640:3","scriptId":10640,"text":"“了解。”","background":"/art/stories/zdbjbz-03.webp","left":223,"right":235,"section":5,"shake":false}],"summaries":["在中继站进行了一些应急补给之后，便准备继续赶路。","整装待发，目标齐格菲研究所。","奈乐和蕾贝卡她们进入了通道。"]}
