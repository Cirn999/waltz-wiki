{"schemaVersion":1,"id":391,"sections":[{"id":"910001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20660],"start":0,"count":16},{"id":"910001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20661],"start":16,"count":17}],"frames":[{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:1","scriptId":20660,"text":"“敌袭！！”","background":"/art/stories/zdbjbz-14.webp","left":740,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:4","scriptId":20660,"text":"“这里的旅行者数量怎么那么多……我们是捅了旅行者的窝吗？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":null,"section":0,"shake":true},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:5","scriptId":20660,"text":"“优先迎击前排，敌人数量不多。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:6","scriptId":20660,"text":"“收到。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:7","scriptId":20660,"text":"“那个……我只是个推测，敌人可能是能追踪到我们的动向？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"910001-PROLOGUE:20660:8","scriptId":20660,"text":"佩妮在一旁发表了自己的观点——很显然，她所指的就是安妮。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:9","scriptId":20660,"text":"“……”","background":"/art/stories/zdbjbz-14.webp","left":1135,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:10","scriptId":20660,"text":"“佩妮说的也是一种可能性，不过即便这种推论是正确的，我们绝不会抛下你不管的。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:11","scriptId":20660,"text":"“指挥官同志……我都不知道该说什么报答您……”","background":"/art/stories/zdbjbz-14.webp","left":1135,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:12","scriptId":20660,"text":"“安妮，你现在是要用自己的力量保护好长官，虽然这个环对你造成了一些影响，但是抵御炮弹什么的还是可以的。”","background":"/art/stories/zdbjbz-14.webp","left":1135,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:13","scriptId":20660,"text":"“这长官虽然平常有些靠不住也比较滑头，但他至少有办法能带我们走向胜利。”","background":"/art/stories/zdbjbz-14.webp","left":1135,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:14","scriptId":20660,"text":"“那个……佩妮，你这夸法有些不对啊……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:15","scriptId":20660,"text":"“哈哈……”","background":"/art/stories/zdbjbz-14.webp","left":1135,"right":584,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"910001-PROLOGUE:20660:16","scriptId":20660,"text":"面容沮丧的安妮终于笑了，可能这才是佩妮的目的。","background":"/art/stories/zdbjbz-14.webp","left":1135,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:17","scriptId":20660,"text":"“那长官就交给你了，安妮。”","background":"/art/stories/zdbjbz-14.webp","left":1135,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-PROLOGUE:20660:18","scriptId":20660,"text":"“是！一定完成任务！”","background":"/art/stories/zdbjbz-14.webp","left":1135,"right":584,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"910001-EPILOGUE:20661:1","scriptId":20661,"text":"旅行者虽然撤退了，但很可能是为了下一波的攻势。","background":"/art/stories/zdbjbz-14.webp","left":1135,"right":584,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"910001-EPILOGUE:20661:2","scriptId":20661,"text":"趁着这个喘息的机会，我们开始制定对策。","background":"/art/stories/zdbjbz-14.webp","left":1135,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:3","scriptId":20661,"text":"“首先我们还不能确认敌人是不是通过安妮的项圈才找到我们的，所以要确立一个计划。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:4","scriptId":20661,"text":"“什么计划？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1135,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:5","scriptId":20661,"text":"“拿你当诱饵。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1135,"section":1,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:6","scriptId":20661,"text":"“诱饵？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1135,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:7","scriptId":20661,"text":"“长官的意思是，让安妮做诱饵，然后我们伏击敌人？”","background":"/art/stories/zdbjbz-14.webp","left":584,"right":1135,"section":1,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:8","scriptId":20661,"text":"“……”","background":"/art/stories/zdbjbz-14.webp","left":584,"right":1135,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:9","scriptId":20661,"text":"“正是这个意思，不过安妮要藏好自己，这样我们才能判断敌人是通过项圈找到她的。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1135,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:10","scriptId":20661,"text":"“佐伊，把你的伪装网给安妮。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1135,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:11","scriptId":20661,"text":"“我的？嘿嘿~忘带了……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:12","scriptId":20661,"text":"“……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:13","scriptId":20661,"text":"“那佩妮的吧，等会埋伏的时候你们可能要离得更远一些才行。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:14","scriptId":20661,"text":"“好的。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"910001-EPILOGUE:20661:15","scriptId":20661,"text":"佩妮从包里拿出了伪装网递给安妮。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:16","scriptId":20661,"text":"“谢谢。”","background":"/art/stories/zdbjbz-14.webp","left":1135,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"910001-EPILOGUE:20661:17","scriptId":20661,"text":"“好了，那么接下来，我们就来试一试旅行者吧~”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":1,"shake":false}],"summaries":[]}
