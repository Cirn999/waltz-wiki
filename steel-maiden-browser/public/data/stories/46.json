{"schemaVersion":1,"id":46,"sections":[{"id":"117001-PROLOGUE","name":"第 1 战 · 战前","scripts":[1550],"start":0,"count":14},{"id":"117001-EPILOGUE","name":"第 1 战 · 战后","scripts":[11540],"start":14,"count":35},{"id":"117002-PROLOGUE","name":"第 2 战 · 战前","scripts":[1560],"start":49,"count":21},{"id":"117002-EPILOGUE","name":"第 2 战 · 战后","scripts":[11550],"start":70,"count":24},{"id":"117003-PROLOGUE","name":"第 3 战 · 战前","scripts":[1570],"start":94,"count":53},{"id":"117003-EPILOGUE","name":"第 3 战 · 战后","scripts":[11560],"start":147,"count":14}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-PROLOGUE:1550:2","scriptId":1550,"text":"匆忙赶回伏龙芝学院。","background":"/art/stories/zjm-090.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-PROLOGUE:1550:3","scriptId":1550,"text":"索菲亚的预感应验了，伏龙芝学院遭受到了史无前例的重创。","background":"/art/stories/zjm-090.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-PROLOGUE:1550:4","scriptId":1550,"text":"教学大楼和实验室的大楼都出现了很大程度的损毁，场面一片狼藉。","background":"/art/stories/zjm-090.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-PROLOGUE:1550:5","scriptId":1550,"text":"周围还能看到一些守备人员残破的尸体……还有不少战车兽在学院的废墟内徘徊。","background":"/art/stories/zjm-090.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-PROLOGUE:1550:6","scriptId":1550,"text":"远处还能时不时听到一点炮火的轰鸣声，看来还有一些钢舞姬正在奋力抵抗。","background":"/art/stories/zjm-090.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":216,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117001-PROLOGUE:1550:7","scriptId":1550,"text":"“啧……”","background":"/art/stories/zjm-090.webp","left":216,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":34,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117001-PROLOGUE:1550:8","scriptId":1550,"text":"“这……”","background":"/art/stories/zjm-090.webp","left":216,"right":34,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117001-PROLOGUE:1550:9","scriptId":1550,"text":"“好惨……”","background":"/art/stories/zjm-090.webp","left":3,"right":34,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-PROLOGUE:1550:10","scriptId":1550,"text":"昔日的学院变成了这幅景象，不由得让在场的所有人语塞。","background":"/art/stories/zjm-090.webp","left":3,"right":34,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-PROLOGUE:1550:11","scriptId":1550,"text":"这时，索菲亚好像突然想起了什么，她飞一般得跑向某栋大楼。","background":"/art/stories/zjm-090.webp","left":3,"right":34,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-PROLOGUE:1550:12","scriptId":1550,"text":"是实验室所在的大楼，正当我们想跟过去的时候，阿芙罗拉挡住了我们。","background":"/art/stories/zjm-090.webp","left":3,"right":34,"section":0,"shake":false},{"kind":"dialogue","head":511,"speaker":"阿芙罗拉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117001-PROLOGUE:1550:13","scriptId":1550,"text":"“教官那边应该没什么问题，我们留下来清理掉学院里的战车兽为最紧要的任务。”","background":"/art/stories/zjm-090.webp","left":3,"right":511,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117001-PROLOGUE:1550:14","scriptId":1550,"text":"“恩……援救学员和相关人员才是首要任务。”","background":"/art/stories/zjm-090.webp","left":3,"right":511,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-PROLOGUE:1550:15","scriptId":1550,"text":"阿芙罗拉说得没错，于是大家开始分批清理学院内的战车兽……","background":"/art/stories/zjm-090.webp","left":3,"right":511,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:0","scriptId":11540,"text":"扫除完伏龙芝里残留的战车兽，开始救助伤员和重建工作。","background":"/art/stories/zjm-090.webp","left":3,"right":511,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:2","scriptId":11540,"text":"一周后，","background":"/art/stories/zjm-066.webp","left":3,"right":511,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:3","scriptId":11540,"text":"根据教官的报告指出，之前发现的L-蛋白质已经被夺走，并且当时正在参与研究的缪妮亚博士也下落不明。","background":"/art/stories/zjm-066.webp","left":3,"right":511,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:4","scriptId":11540,"text":"总计死亡人数65名，另有10多名正在培训中的学员下落不明。","background":"/art/stories/zjm-066.webp","left":3,"right":511,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:5","scriptId":11540,"text":"本次事故主要责任者——索菲亚·马利诺夫娜，指挥不当，停职查看。","background":"/art/stories/zjm-066.webp","left":3,"right":511,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:6","scriptId":11540,"text":"其相关人员都负有连带责任，具体处罚单独通知。","background":"/art/stories/zjm-066.webp","left":3,"right":511,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:7","scriptId":11540,"text":"由于这次伏龙芝遇袭事件，索菲亚教官被调回联盟总部接受审讯，因此调查不明人形的事情就这样被搁置了。","background":"/art/stories/zjm-066.webp","left":3,"right":511,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:8","scriptId":11540,"text":"而我正在基地中整理行李，由于受到了连带处分，我这个指挥官也被解任了。","background":"/art/stories/zjm-066.webp","left":3,"right":511,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:9","scriptId":11540,"text":"“唉……明明是在战斗中立下了功劳，全队反而受到了处分，怎么想都有问题……”","background":"/art/stories/zjm-066.webp","left":3,"right":511,"section":1,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:10","scriptId":11540,"text":"“是啊，连马奇诺研究所损毁事件也被算在了我们头上……”","background":"/art/stories/zjm-066.webp","left":3,"right":40,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:11","scriptId":11540,"text":"相对的，佐伊她们并没有受到很大的处分，只是被调回各自原本的职位，毕竟钢舞姬这种战力是不会轻易被开除的吧。","background":"/art/stories/zjm-066.webp","left":3,"right":40,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:12","scriptId":11540,"text":"“替罪羊总要找的……只是解任已经算不错的了……”","background":"/art/stories/zjm-066.webp","left":3,"right":40,"section":1,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:13","scriptId":11540,"text":"“那长官今后有什么打算？”","background":"/art/stories/zjm-066.webp","left":3,"right":31,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:14","scriptId":11540,"text":"“啊，已经可以不用叫我长官了……今后的打算么……大概先回老家种种田？”","background":"/art/stories/zjm-066.webp","left":3,"right":31,"section":1,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:15","scriptId":11540,"text":"“……”","background":"/art/stories/zjm-066.webp","left":3,"right":36,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:16","scriptId":11540,"text":"“开玩笑的啦～”","background":"/art/stories/zjm-066.webp","left":3,"right":36,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:17","scriptId":11540,"text":"看到佐伊有点悲伤的表情，我立即打了个圆场，不过确实要认真考虑下今后的出路了……","background":"/art/stories/zjm-066.webp","left":3,"right":36,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:19","scriptId":11540,"text":"坐在军用吉普车上，这次是由佐伊开车，送我到最近的火车站，毕竟路上遇到战车兽可就不妙了。","background":"/art/stories/zjm-067.webp","left":3,"right":36,"section":1,"shake":false},{"kind":"dialogue","head":0,"speaker":"？？？","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:20","scriptId":11540,"text":"“……”","background":"/art/stories/zjm-067.webp","left":0,"right":36,"section":1,"shake":false},{"kind":"dialogue","head":0,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:21","scriptId":11540,"text":"“……”","background":"/art/stories/zjm-067.webp","left":0,"right":0,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:22","scriptId":11540,"text":"一路上比较尴尬，两人都相对无言，就这样慢慢得向着火车站驶去……","background":"/art/stories/zjm-067.webp","left":0,"right":0,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:23","scriptId":11540,"text":"“想起了来的时候啊，好像也是这条路来着？”","background":"/art/stories/zjm-067.webp","left":3,"right":0,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:24","scriptId":11540,"text":"沉不住气的我还是打破了这种沉默。","background":"/art/stories/zjm-067.webp","left":3,"right":0,"section":1,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:25","scriptId":11540,"text":"“是啊，长官那时候还在车上睡大觉呢……”","background":"/art/stories/zjm-067.webp","left":3,"right":36,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:26","scriptId":11540,"text":"“哈哈，也是，那时候还遇到了战车兽的突袭呢。”","background":"/art/stories/zjm-067.webp","left":3,"right":36,"section":1,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:27","scriptId":11540,"text":"“……”","background":"/art/stories/zjm-067.webp","left":3,"right":36,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:28","scriptId":11540,"text":"“……”","background":"/art/stories/zjm-067.webp","left":3,"right":36,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:29","scriptId":11540,"text":"佐伊没有回话，这下又变成了沉默的状态……","background":"/art/stories/zjm-067.webp","left":3,"right":36,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:30","scriptId":11540,"text":"嘟嘟嘟嘟嘟嘟——","background":"/art/stories/zjm-067.webp","left":3,"right":36,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:31","scriptId":11540,"text":"正当我在脑中拼命的搜寻聊天话题时，后方传来了汽车的鸣笛声。","background":"/art/stories/zjm-067.webp","left":3,"right":36,"section":1,"shake":false},{"kind":"dialogue","head":0,"speaker":"？？？","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:32","scriptId":11540,"text":"“谁啊？”","background":"/art/stories/zjm-067.webp","left":0,"right":36,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:33","scriptId":11540,"text":"我回头想看下到底是谁在后面猛按喇叭……","background":"/art/stories/zjm-067.webp","left":0,"right":36,"section":1,"shake":false},{"kind":"dialogue","head":0,"speaker":"？？？","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:34","scriptId":11540,"text":"“这……是蕾贝卡？佐伊，停车。”","background":"/art/stories/zjm-067.webp","left":0,"right":36,"section":1,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117001-EPILOGUE:11540:35","scriptId":11540,"text":"“诶！？”","background":"/art/stories/zjm-067.webp","left":0,"right":41,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117001-EPILOGUE:11540:36","scriptId":11540,"text":"佐伊猛踩一脚刹车，由于突如其来的惯性，我一头撞在了挡风玻璃上……","background":"/art/stories/zjm-067.webp","left":0,"right":41,"section":1,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:2","scriptId":1560,"text":"“长官，对不起……”","background":"/art/stories/zjm-067.webp","left":36,"right":41,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117002-PROLOGUE:1560:3","scriptId":1560,"text":"我捂着被撞疼的鼻子下了车……对佐伊挥挥手表示不用介意。","background":"/art/stories/zjm-067.webp","left":36,"right":41,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117002-PROLOGUE:1560:5","scriptId":1560,"text":"蕾贝卡的车也停在我们后面不远处，正朝我们这边招手，于是我便朝她所在的方向走去。","background":"/art/stories/zjm-067.webp","left":null,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:6","scriptId":1560,"text":"“好久不见啊～听说你过得还不错啊～鼻子怎么了？”","background":"/art/stories/zjm-067.webp","left":null,"right":223,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:7","scriptId":1560,"text":"“呃，一言难尽……那个，有什么事情吗？”","background":"/art/stories/zjm-067.webp","left":3,"right":223,"section":2,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:8","scriptId":1560,"text":"“听说你被开除了？于是我就来接你了啊～”","background":"/art/stories/zjm-067.webp","left":3,"right":223,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:9","scriptId":1560,"text":"“接我？什么情况……”","background":"/art/stories/zjm-067.webp","left":3,"right":223,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117002-PROLOGUE:1560:10","scriptId":1560,"text":"大概停顿了两秒进行思索，随后我立刻进入了状态。","background":"/art/stories/zjm-067.webp","left":3,"right":223,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:11","scriptId":1560,"text":"“难道……！？”","background":"/art/stories/zjm-067.webp","left":3,"right":223,"section":2,"shake":false},{"kind":"dialogue","head":225,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:12","scriptId":1560,"text":"“恩，看来你已经猜到了。没错，我来邀请你加入死水的～”","background":"/art/stories/zjm-067.webp","left":3,"right":225,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:13","scriptId":1560,"text":"“诶！？”","background":"/art/stories/zjm-067.webp","left":3,"right":225,"section":2,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:14","scriptId":1560,"text":"“诶！？”","background":"/art/stories/zjm-067.webp","left":41,"right":225,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117002-PROLOGUE:1560:15","scriptId":1560,"text":"蕾贝卡的邀请确实让我和佐伊都目瞪口呆……索菲亚教官和我们被处分的事情应该没有对外大肆公布才对。","background":"/art/stories/zjm-067.webp","left":41,"right":225,"section":2,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:16","scriptId":1560,"text":"“话说回来，蕾贝卡怎么知道长官被开除了？”","background":"/art/stories/zjm-067.webp","left":41,"right":225,"section":2,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:17","scriptId":1560,"text":"“因为消息灵通啊～”","background":"/art/stories/zjm-067.webp","left":41,"right":231,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:18","scriptId":1560,"text":"（肯定是隆美尔司令了吧……毕竟是胜利女神特勤局上层，这点消息源应该还是有的。）","background":"/art/stories/zjm-067.webp","left":3,"right":231,"section":2,"shake":false},{"kind":"dialogue","head":59,"speaker":"战车兽","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"117002-PROLOGUE:1560:19","scriptId":1560,"text":"“呜呜呜呜！”","background":"/art/stories/zjm-067.webp","left":3,"right":59,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117002-PROLOGUE:1560:20","scriptId":1560,"text":"就在这时，远处传来了战车兽的吼声……","background":"/art/stories/zjm-067.webp","left":3,"right":59,"section":2,"shake":false},{"kind":"dialogue","head":232,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:21","scriptId":1560,"text":"“唉，这种时候……真是些不解风情的家伙。”","background":"/art/stories/zjm-067.webp","left":3,"right":232,"section":2,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-PROLOGUE:1560:22","scriptId":1560,"text":"“长官由我来保护！”","background":"/art/stories/zjm-067.webp","left":32,"right":232,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117002-PROLOGUE:1560:23","scriptId":1560,"text":"佐伊和蕾贝卡转而进入了战斗状态。","background":"/art/stories/zjm-067.webp","left":32,"right":232,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117002-EPILOGUE:11550:0","scriptId":11550,"text":"干掉了战车兽后，蕾贝卡掸了掸身上的尘土，不紧不慢地说道。","background":"/art/stories/zjm-067.webp","left":32,"right":232,"section":3,"shake":false},{"kind":"dialogue","head":225,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:2","scriptId":11550,"text":"“那么我们继续刚才的话题～”","background":"/art/stories/zdbjbz-05.webp","left":32,"right":225,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:3","scriptId":11550,"text":"（看这架势应该不是说着玩玩的了……）","background":"/art/stories/zdbjbz-05.webp","left":3,"right":225,"section":3,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:4","scriptId":11550,"text":"“你现在也是自由身了，为了不浪费人才，我以最快速度向死水负责人推荐了你。”","background":"/art/stories/zdbjbz-05.webp","left":3,"right":223,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:5","scriptId":11550,"text":"“真是万万没想到我还有加入死水佣兵团的一天。”","background":"/art/stories/zdbjbz-05.webp","left":3,"right":223,"section":3,"shake":false},{"kind":"dialogue","head":225,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:6","scriptId":11550,"text":"“那看来是没有什么问题了咯～那我们走吧，乘我的车直接前往死水总部～”","background":"/art/stories/zdbjbz-05.webp","left":3,"right":225,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117002-EPILOGUE:11550:7","scriptId":11550,"text":"很快便和蕾贝卡达成共识，准备前往死水总部报道了。","background":"/art/stories/zdbjbz-05.webp","left":3,"right":225,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117002-EPILOGUE:11550:8","scriptId":11550,"text":"这时候背后传来了一句弱弱的询问。","background":"/art/stories/zdbjbz-05.webp","left":3,"right":225,"section":3,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:9","scriptId":11550,"text":"“那个……我能不能一起去啊……”","background":"/art/stories/zdbjbz-05.webp","left":36,"right":225,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:10","scriptId":11550,"text":"“那当然是没----","background":"/art/stories/zdbjbz-05.webp","left":36,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":230,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:11","scriptId":11550,"text":"“不行。”","background":"/art/stories/zdbjbz-05.webp","left":230,"right":3,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117002-EPILOGUE:11550:12","scriptId":11550,"text":"原以为带着佐伊一起应该也没什么大问题，但是蕾贝卡拒绝得斩钉截铁，这可真是在意料之外。","background":"/art/stories/zdbjbz-05.webp","left":230,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:13","scriptId":11550,"text":"“额……我能问一下理由吗？”","background":"/art/stories/zdbjbz-05.webp","left":230,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:14","scriptId":11550,"text":"“……”","background":"/art/stories/zdbjbz-05.webp","left":36,"right":3,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117002-EPILOGUE:11550:15","scriptId":11550,"text":"佐伊点点头，用小动物一般的眼光看向蕾贝卡。","background":"/art/stories/zdbjbz-05.webp","left":36,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":233,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:16","scriptId":11550,"text":"“啊……不是那个意思！”","background":"/art/stories/zdbjbz-05.webp","left":233,"right":3,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117002-EPILOGUE:11550:17","scriptId":11550,"text":"看到佐伊的表情，蕾贝卡有点慌了神，急忙把原因说了出来。","background":"/art/stories/zdbjbz-05.webp","left":233,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:18","scriptId":11550,"text":"“我的意思是暂时不行，佐伊现在还是所属胜利女神特勤局，所以需要办些手续才能引渡到死水的啦。”","background":"/art/stories/zdbjbz-05.webp","left":231,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:19","scriptId":11550,"text":"“原来如此。”","background":"/art/stories/zdbjbz-05.webp","left":231,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:20","scriptId":11550,"text":"“那我需要等多久才能转过去？”","background":"/art/stories/zdbjbz-05.webp","left":31,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:21","scriptId":11550,"text":"“这个我需要通过父亲的关系帮你处理一下，需要点时间，大概三个月左右吧。”","background":"/art/stories/zdbjbz-05.webp","left":31,"right":223,"section":3,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:22","scriptId":11550,"text":"“啊，要那么久啊……”","background":"/art/stories/zdbjbz-05.webp","left":36,"right":223,"section":3,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:23","scriptId":11550,"text":"“不过正好，在这等待的时间，你需要帮我办点事情……”","background":"/art/stories/zdbjbz-05.webp","left":36,"right":231,"section":3,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117002-EPILOGUE:11550:24","scriptId":11550,"text":"“诶？”","background":"/art/stories/zdbjbz-05.webp","left":41,"right":231,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:2","scriptId":1570,"text":"蕾贝卡交代给佐伊要办的事情以后，就带着我前往死水总部了。","background":"/art/stories/zjm-099.webp","left":41,"right":231,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:3","scriptId":1570,"text":"中间还换乘了飞机……因为死水总部位于北美大陆。","background":"/art/stories/zjm-099.webp","left":41,"right":231,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:4","scriptId":1570,"text":"“花了那么大功夫终于到了啊……”","background":"/art/stories/zjm-099.webp","left":3,"right":231,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:5","scriptId":1570,"text":"望着眼前雄伟的建筑，我不禁感叹到。","background":"/art/stories/zjm-099.webp","left":3,"right":231,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:6","scriptId":1570,"text":"一看就是非常显眼的独立大楼，周边还有各种防御设施和巡逻人员，像层层关卡般的岗哨，这简直可以称之为要塞了吧。","background":"/art/stories/zjm-099.webp","left":3,"right":231,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:7","scriptId":1570,"text":"继续往前走就来到了最外层的岗哨。","background":"/art/stories/zjm-099.webp","left":3,"right":231,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:8","scriptId":1570,"text":"虽然哨兵们戴着面具，但还是能明显感觉到他们正在警惕着我这个陌生人。","background":"/art/stories/zjm-099.webp","left":3,"right":231,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:9","scriptId":1570,"text":"正当其中一个哨兵准备上前来盘问的时候，后面的另一个士兵发出了声音。","background":"/art/stories/zjm-099.webp","left":3,"right":231,"section":4,"shake":false},{"kind":"dialogue","head":60,"speaker":"死水哨兵","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:10","scriptId":1570,"text":"“啊，是蕾贝卡大人，准备放行！”","background":"/art/stories/zjm-099.webp","left":3,"right":60,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:11","scriptId":1570,"text":"因为看到了同行的蕾贝卡，所以哨兵们就收回了警惕的视线，快速地把防护栏打开，好让我和蕾贝卡通过。","background":"/art/stories/zjm-099.webp","left":3,"right":60,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:12","scriptId":1570,"text":"“谢谢啦～”","background":"/art/stories/zjm-099.webp","left":223,"right":60,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:13","scriptId":1570,"text":"“果然是王牌之一，待遇完全不一样啊。”","background":"/art/stories/zjm-099.webp","left":223,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":225,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:14","scriptId":1570,"text":"“你以后也是这里的一员，估计没多久就能混熟脸了啦～”","background":"/art/stories/zjm-099.webp","left":225,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:16","scriptId":1570,"text":"继续前行，走过了层层的哨岗，终于到达了大楼的正门。","background":"/art/stories/zjm-099.webp","left":null,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":535,"speaker":"伊达·布鲁克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:17","scriptId":1570,"text":"“哟，蕾贝卡，听说你带新人来了？就是他了咯？”","background":"/art/stories/zjm-099.webp","left":null,"right":535,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:18","scriptId":1570,"text":"“恩，没错，现在正要去见团长呢。”","background":"/art/stories/zjm-099.webp","left":223,"right":535,"section":4,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:19","scriptId":1570,"text":"“伊达今天没任务吗？”","background":"/art/stories/zjm-099.webp","left":231,"right":535,"section":4,"shake":false},{"kind":"dialogue","head":535,"speaker":"伊达·布鲁克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:20","scriptId":1570,"text":"“扎莉队长和米歇尔正在里面交接新任务呢。”","background":"/art/stories/zjm-099.webp","left":231,"right":535,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:21","scriptId":1570,"text":"“那我们就先进去了。”","background":"/art/stories/zjm-099.webp","left":223,"right":535,"section":4,"shake":false},{"kind":"dialogue","head":535,"speaker":"伊达·布鲁克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:22","scriptId":1570,"text":"“恩，回见～”","background":"/art/stories/zjm-099.webp","left":223,"right":535,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:23","scriptId":1570,"text":"看到两人的对话结束了，我向伊达点头打了个招呼，就跟着蕾贝卡进了大楼。","background":"/art/stories/zjm-099.webp","left":223,"right":535,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:25","scriptId":1570,"text":"一路穿过走廊往中央电梯方向前进，中途能看到一些钢舞姬正在攀谈，不过当我们经过的时候，她们都会停下来对我进行一番打量。","background":"/art/stories/zjm-099.webp","left":null,"right":null,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:26","scriptId":1570,"text":"（比起一般的钢舞姬警惕性要高啊，还是说我的脸或者服装很奇怪吗……）","background":"/art/stories/zjm-099.webp","left":null,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:27","scriptId":1570,"text":"乘上电梯，到达了最高层。","background":"/art/stories/zjm-099.webp","left":null,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:28","scriptId":1570,"text":"我稍微整理了下衣服和帽子，看到此景的蕾贝卡微微一笑。","background":"/art/stories/zjm-099.webp","left":null,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:29","scriptId":1570,"text":"“不用紧张啦～团长大人不是特别严厉的人，只要你不惹她生气……”","background":"/art/stories/zjm-099.webp","left":231,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:30","scriptId":1570,"text":"没过多久，我们已经来到了一扇墨色的大门前，大门的把手上镶着金边，这里想必是团长室了吧。","background":"/art/stories/zjm-099.webp","left":231,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:31","scriptId":1570,"text":"蕾贝卡伸出手轻轻敲了两下门。","background":"/art/stories/zjm-099.webp","left":231,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:32","scriptId":1570,"text":"不过既没有人来开门也没有听到应答，取而代之的是听到门内传来了好像是争执般的声音。","background":"/art/stories/zjm-099.webp","left":231,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":230,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:33","scriptId":1570,"text":"“唉……肯定又是那两个人了，稍等。”","background":"/art/stories/zjm-099.webp","left":230,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:34","scriptId":1570,"text":"蕾贝卡叹了口气，随后看到她的耳朵动了动，应该是在听取门内的动静，寻找开门的时机？","background":"/art/stories/zjm-099.webp","left":230,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:35","scriptId":1570,"text":"两分钟后，蕾贝卡对我点头示意了下，就“咔嚓”一下把门打开了……","background":"/art/stories/zjm-099.webp","left":230,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:37","scriptId":1570,"text":"“不行就是不行，你给的报酬和实际要承担的风险明显不在一个水平线上。”","background":"/art/stories/zjm-098.webp","left":547,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":568,"speaker":"海伦娜·潘兴","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:38","scriptId":1570,"text":"“就不能通融一下吗！？这次预算没有那么充足啊，作为老客户不能给点折扣么？”","background":"/art/stories/zjm-098.webp","left":547,"right":568,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:39","scriptId":1570,"text":"听到有人开门，两人立刻停了下来看向门口。","background":"/art/stories/zjm-098.webp","left":547,"right":568,"section":4,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:40","scriptId":1570,"text":"“团长，我把新人带来了～”","background":"/art/stories/zjm-098.webp","left":231,"right":568,"section":4,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:41","scriptId":1570,"text":"“噢，是蕾贝卡啊，大致的情况我已经从隆美尔司令那里了解了。”","background":"/art/stories/zjm-098.webp","left":231,"right":547,"section":4,"shake":false},{"kind":"dialogue","head":567,"speaker":"海伦娜·潘兴","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:42","scriptId":1570,"text":"“好久不见，蕾贝卡。”","background":"/art/stories/zjm-098.webp","left":231,"right":567,"section":4,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:43","scriptId":1570,"text":"“恩，好久不见，海伦娜教官。”","background":"/art/stories/zjm-098.webp","left":231,"right":567,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:44","scriptId":1570,"text":"（海伦娜……好像哪听说过，看样子是西点军校的教官？）","background":"/art/stories/zjm-098.webp","left":231,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:45","scriptId":1570,"text":"“……”","background":"/art/stories/zjm-098.webp","left":231,"right":547,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:46","scriptId":1570,"text":"突然发现，被称为团长的那位红衣服的女士正在盯着自己看，不由得心里一紧。","background":"/art/stories/zjm-098.webp","left":231,"right":547,"section":4,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:47","scriptId":1570,"text":"“我是死水佣兵团的总负责人维多利亚·威灵顿。”","background":"/art/stories/zjm-098.webp","left":231,"right":547,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:48","scriptId":1570,"text":"“你好。”","background":"/art/stories/zjm-098.webp","left":231,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:49","scriptId":1570,"text":"“恩，不过我看他还是嫩了点……”","background":"/art/stories/zjm-098.webp","left":231,"right":547,"section":4,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:50","scriptId":1570,"text":"“我想应该没什么问题吧～”","background":"/art/stories/zjm-098.webp","left":231,"right":547,"section":4,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:51","scriptId":1570,"text":"“恩……虽说有隆佬和蕾贝卡的推荐么，但也需要通过我的考核。”","background":"/art/stories/zjm-098.webp","left":231,"right":547,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-PROLOGUE:1570:52","scriptId":1570,"text":"这时海伦娜说话了。","background":"/art/stories/zjm-098.webp","left":231,"right":547,"section":4,"shake":false},{"kind":"dialogue","head":559,"speaker":"海伦娜·潘兴","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:53","scriptId":1570,"text":"“那么……我就先告辞了。”","background":"/art/stories/zjm-098.webp","left":231,"right":559,"section":4,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:54","scriptId":1570,"text":"“等等，海伦娜，算你运气好，这次就让这位新人君来负责你的委托了，报酬就按之前你给的价格。”","background":"/art/stories/zjm-098.webp","left":547,"right":559,"section":4,"shake":false},{"kind":"dialogue","head":561,"speaker":"海伦娜·潘兴","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:55","scriptId":1570,"text":"“真的！？那真是太感谢了！”","background":"/art/stories/zjm-098.webp","left":547,"right":561,"section":4,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:56","scriptId":1570,"text":"“那么后面的事情就交给蕾贝卡你了。”","background":"/art/stories/zjm-098.webp","left":547,"right":561,"section":4,"shake":false},{"kind":"dialogue","head":229,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-PROLOGUE:1570:57","scriptId":1570,"text":"“好的，没问题～”","background":"/art/stories/zjm-098.webp","left":547,"right":229,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-EPILOGUE:11560:1","scriptId":11560,"text":"从团长室退了出来以后，被蕾贝卡带到了某间空闲着的会议室。","background":"/art/stories/zjm-047.webp","left":547,"right":229,"section":5,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-EPILOGUE:11560:2","scriptId":11560,"text":"“那我先去叫一下你的队员～”","background":"/art/stories/zjm-047.webp","left":231,"right":229,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-EPILOGUE:11560:3","scriptId":11560,"text":"“诶？”","background":"/art/stories/zjm-047.webp","left":231,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-EPILOGUE:11560:4","scriptId":11560,"text":"虽然大概能料想到自己转到死水应该还是会担任指挥职务，不过没想到那么快就有实战任务了……","background":"/art/stories/zjm-047.webp","left":231,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-EPILOGUE:11560:5","scriptId":11560,"text":"（希望是群靠谱的家伙……虽说死水佣兵里面应该都是精英，不过还是有点担心啊……）","background":"/art/stories/zjm-047.webp","left":231,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-EPILOGUE:11560:6","scriptId":11560,"text":"正当我还在胡思乱想之际，一个声音把我拉了回来。","background":"/art/stories/zjm-047.webp","left":231,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":559,"speaker":"海伦娜·潘兴","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-EPILOGUE:11560:7","scriptId":11560,"text":"“听说索菲亚惹了大事？都被胜利女神特勤局拉去喝茶了？”","background":"/art/stories/zjm-047.webp","left":559,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-EPILOGUE:11560:8","scriptId":11560,"text":"“恩，马奇诺研究所全毁和伏龙芝学院遇袭，这两件事情的责任都算在了索菲亚教官头上……”","background":"/art/stories/zjm-047.webp","left":559,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":566,"speaker":"海伦娜·潘兴","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-EPILOGUE:11560:9","scriptId":11560,"text":"“我要听的不是这些，这种对外的官方说法我一点兴趣都没有。”","background":"/art/stories/zjm-047.webp","left":566,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-EPILOGUE:11560:10","scriptId":11560,"text":"“那……海伦娜教官想知道什么？”","background":"/art/stories/zjm-047.webp","left":566,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":567,"speaker":"海伦娜·潘兴","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-EPILOGUE:11560:11","scriptId":11560,"text":"“你可以把大致事情的来龙去脉跟我说一下，反正看样子蕾贝卡应该会要点时间。”","background":"/art/stories/zjm-047.webp","left":567,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117003-EPILOGUE:11560:12","scriptId":11560,"text":"海伦娜教官笑了笑，接着说道。","background":"/art/stories/zjm-047.webp","left":567,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":565,"speaker":"海伦娜·潘兴","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117003-EPILOGUE:11560:13","scriptId":11560,"text":"“我可没索菲亚那么死板，叫我海伦娜就行了，反正我也不是你的教官～”","background":"/art/stories/zjm-047.webp","left":565,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117003-EPILOGUE:11560:14","scriptId":11560,"text":"“好的……”","background":"/art/stories/zjm-047.webp","left":565,"right":3,"section":5,"shake":false}],"summaries":["急急忙忙赶回伏龙芝学院。","死水的蕾贝卡","死水总部"]}
