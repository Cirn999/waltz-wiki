{"schemaVersion":1,"id":50,"sections":[{"id":"118001-PROLOGUE","name":"第 1 战 · 战前","scripts":[1690],"start":0,"count":43},{"id":"118001-EPILOGUE","name":"第 1 战 · 战后","scripts":[11680],"start":43,"count":10},{"id":"118002-PROLOGUE","name":"第 2 战 · 战前","scripts":[1700],"start":53,"count":20},{"id":"118002-EPILOGUE","name":"第 2 战 · 战后","scripts":[11690],"start":73,"count":22},{"id":"118003-PROLOGUE","name":"第 3 战 · 战前","scripts":[1710],"start":95,"count":13},{"id":"118003-EPILOGUE","name":"第 3 战 · 战后","scripts":[11700],"start":108,"count":15}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-PROLOGUE:1690:1","scriptId":1690,"text":"死水地下室——","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-PROLOGUE:1690:3","scriptId":1690,"text":"地下室的入口前挂着闲人莫入的牌子。走过下沉式的台阶，我们来到了死水基地的地下通道。","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-PROLOGUE:1690:4","scriptId":1690,"text":"有别于一般的防空洞式地下室，死水的地下室更像是大型的科研工厂，能看到很多研究人员来来往往。","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:5","scriptId":1690,"text":"“这地下室有点热闹啊……”","background":"/art/stories/zjm-094.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:6","scriptId":1690,"text":"“原来地下室是这样子的啊，完全不知道呢。”","background":"/art/stories/zjm-094.webp","left":4,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:7","scriptId":1690,"text":"“那么波西娅博士在哪儿呢……”","background":"/art/stories/zjm-094.webp","left":4,"right":574,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-PROLOGUE:1690:8","scriptId":1690,"text":"因为地下室太大，所以准备找个研究员问问波西娅博士的实验室在哪。","background":"/art/stories/zjm-094.webp","left":4,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:9","scriptId":1690,"text":"“这边……”","background":"/art/stories/zjm-094.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:10","scriptId":1690,"text":"“诶？维卡知道研究室在哪儿吗？”","background":"/art/stories/zjm-094.webp","left":584,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-PROLOGUE:1690:11","scriptId":1690,"text":"维卡指了指天花板，抬头一看，上面挂着一枚非常大的牌子，上面写着“波西娅的研究室❤请往Ａ４通道→”","background":"/art/stories/zjm-094.webp","left":584,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:12","scriptId":1690,"text":"“好大的牌子……”","background":"/art/stories/zjm-094.webp","left":584,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-PROLOGUE:1690:14","scriptId":1690,"text":"顺着牌子的指引，我们很顺利的就到达了波西娅的研究室。","background":"/art/stories/zjm-094.webp","left":584,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-PROLOGUE:1690:15","scriptId":1690,"text":"敲了敲门。","background":"/art/stories/zjm-094.webp","left":584,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-PROLOGUE:1690:16","scriptId":1690,"text":"然而并没有反应，于是轻轻推了一下，谁知“吱呀”一声——研究室的门就自动打开了。","background":"/art/stories/zjm-094.webp","left":584,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-PROLOGUE:1690:17","scriptId":1690,"text":"映入眼帘的是许多异常巨大的研发设备和一位长着一头飘逸长发的女子。","background":"/art/stories/zjm-094.webp","left":584,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:18","scriptId":1690,"text":"“恩……钛糖的配比如果再提高十个百分点的话，应该能增加舞装的融合强度……”","background":"/art/stories/zjm-094.webp","left":608,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:19","scriptId":1690,"text":"（想必这位就是波西娅博士了吧……）","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:20","scriptId":1690,"text":"“咳哼，不好意思打扰了……”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-PROLOGUE:1690:21","scriptId":1690,"text":"我故意咳嗽了一声，对方察觉到了，转向了我们。","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:22","scriptId":1690,"text":"“哦呀～你们是……”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-PROLOGUE:1690:23","scriptId":1690,"text":"正当我要开口回答的时候。","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:24","scriptId":1690,"text":"“不用回答，让我想想……恩……应该是刚才芮蓓联络我的受托人？”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:25","scriptId":1690,"text":"“对的。您就是波西娅博士吧？”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:26","scriptId":1690,"text":"“恩～正是～”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-PROLOGUE:1690:27","scriptId":1690,"text":"波西娅突然眯起眼睛，仔细得端详起我来……","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:28","scriptId":1690,"text":"“那个……我的脸上粘了什么东西吗……”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:29","scriptId":1690,"text":"“啊～我只是觉得奇怪，你不是人类男性吗？我还以为只是长得比较中性的钢舞姬呢。”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:30","scriptId":1690,"text":"“呃……我是最近才加入死水的，是负责这个小队的指挥官。”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:31","scriptId":1690,"text":"“哦呀～人类指挥官？维多利亚最近吃错药了么？连续招募了两名人类指挥官，这是吹得什么风啊……”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:32","scriptId":1690,"text":"“如果可以的话，能让我稍微解剖下吗～？”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:33","scriptId":1690,"text":"“呃……，我们是来问一下具体的委托内容的……”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:34","scriptId":1690,"text":"“哦，对对，正事不能忘了，那么解剖的事情下次再说～”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:35","scriptId":1690,"text":"（外表长得那么文静，但是发言却句句都是爆炸性的……）","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:36","scriptId":1690,"text":"“恩，这次的委托任务是这样的～我需要你们去给我抓些灵长类的战车兽来。另外，任务内容需要对外保密。”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:37","scriptId":1690,"text":"“呃……抓猴子？不管哪种都可以吗？”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:38","scriptId":1690,"text":"“我这边有详细的清单和目标的大致活动范围，每只我都做过标记。对了，要捉活的，死的我才不要呢。”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-PROLOGUE:1690:39","scriptId":1690,"text":"接过清单扫了一眼，大致内容就是抓回之前放出去的战车兽活体样本……","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:40","scriptId":1690,"text":"（这是故意放出战车兽……怪不得内容不能对外公开。）","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:41","scriptId":1690,"text":"“好的，那么委托内容就是这些吗？”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:42","scriptId":1690,"text":"“是的，还有别的问题吗？”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:43","scriptId":1690,"text":"“呃，如果不小心弄死了怎么办……”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:44","scriptId":1690,"text":"“哼哼～那我就把你当战车兽解剖了～”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-PROLOGUE:1690:45","scriptId":1690,"text":"“……”","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-EPILOGUE:11680:0","scriptId":11680,"text":"不得不说活捉战车兽比杀死要困难太多……","background":"/art/stories/zjm-094.webp","left":608,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-EPILOGUE:11680:2","scriptId":11680,"text":"“活捉战车兽的难度真是不小啊……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-EPILOGUE:11680:3","scriptId":11680,"text":"“主要是麻醉弹不容易命中，装甲很容易把弹头弹开，所以只能极近距离作战……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-EPILOGUE:11680:4","scriptId":11680,"text":"“恩，最佳手段是需要有人做诱饵，然后从战车兽的死角打入麻醉弹。”","background":"/art/stories/zdbjbz-14.webp","left":572,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-EPILOGUE:11680:5","scriptId":11680,"text":"“人手不足。”","background":"/art/stories/zdbjbz-14.webp","left":572,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118001-EPILOGUE:11680:6","scriptId":11680,"text":"“这个数量确实对我们四个人来说，稍微有些困难……我要想想办法……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-EPILOGUE:11680:7","scriptId":11680,"text":"于是，我就把小队重新召集起来了。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118001-EPILOGUE:11680:8","scriptId":11680,"text":"另一方面，死水地下研究室——","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-EPILOGUE:11680:9","scriptId":11680,"text":"“啊……特种麻醉穿甲弹怎么在这里？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":608,"section":1,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118001-EPILOGUE:11680:10","scriptId":11680,"text":"“哦，忘记发给抓捕小队了……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":608,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118002-PROLOGUE:1700:2","scriptId":1700,"text":"经过一番商议，结果是使用最原始而有效的方法……布陷阱……","background":"/art/stories/zdbjbz-14.webp","left":4,"right":608,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:3","scriptId":1700,"text":"“呼……这种体力活真是吃不消啊……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":608,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118002-PROLOGUE:1700:4","scriptId":1700,"text":"我放下手中铁铲，从挖好的大坑中爬了出来，拍了拍身上的尘土，最原始的落穴陷阱就这么完成了。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":608,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118002-PROLOGUE:1700:5","scriptId":1700,"text":"拖着疲惫的身躯回到搭建好的临时帐篷边，奈特莉和佩妮已经坐在里面了，看来她们很早就已经完成了自己的份额。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":608,"section":2,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:6","scriptId":1700,"text":"“长官的体能很差啊～需要多多锻炼呢～不然会被女孩子们瞧不起的哟～”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":582,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:7","scriptId":1700,"text":"“这个我会注意的……比起这种体力活还是指挥席更适合我。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":582,"section":2,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:8","scriptId":1700,"text":"“挖陷阱这么复古的手段，现在用来抓战车兽真的会有效吗？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118002-PROLOGUE:1700:9","scriptId":1700,"text":"从佩妮的话语中感觉到了疑惑。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":2,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:10","scriptId":1700,"text":"“那个～我想听听维卡的看法。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":578,"section":2,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:11","scriptId":1700,"text":"“应该会有成效。”","background":"/art/stories/zdbjbz-14.webp","left":596,"right":578,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118002-PROLOGUE:1700:12","scriptId":1700,"text":"维卡正蹲在陷阱旁边进行仔细确认。","background":"/art/stories/zdbjbz-14.webp","left":596,"right":578,"section":2,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:13","scriptId":1700,"text":"“啊哈～虽然我也是有点半信半疑，但是既然维卡这么说了，我觉得就没什么问题了～”","background":"/art/stories/zdbjbz-14.webp","left":596,"right":574,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:14","scriptId":1700,"text":"“诶？是这样吗？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":574,"section":2,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:15","scriptId":1700,"text":"“恩，你们可能不知道，维卡本来就是捕捉战车兽的专家。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":578,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:16","scriptId":1700,"text":"“哦哦～那可真是让我对这个方案增加了不少信心啊。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":578,"section":2,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:17","scriptId":1700,"text":"“恩……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118002-PROLOGUE:1700:18","scriptId":1700,"text":"话语间，维卡已经从陷阱旁离开，回到了我们的临时帐篷边。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":2,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:19","scriptId":1700,"text":"“不过没想到波西娅博士竟然是那种人……”","background":"/art/stories/zdbjbz-14.webp","left":591,"right":596,"section":2,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:20","scriptId":1700,"text":"“大概在研究室待多了都会变成那种性格？”","background":"/art/stories/zdbjbz-14.webp","left":591,"right":582,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-PROLOGUE:1700:21","scriptId":1700,"text":"（说起来索菲亚教官也有这毛病……难道这种强势的性格是职业病！？）","background":"/art/stories/zdbjbz-14.webp","left":4,"right":582,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118002-EPILOGUE:11690:0","scriptId":11690,"text":"陷阱发挥了预期的效果……","background":"/art/stories/zdbjbz-14.webp","left":4,"right":582,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118002-EPILOGUE:11690:2","scriptId":11690,"text":"通过引诱战车兽到指定的陷阱处，让它们落入事先布置好的落穴陷阱中。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":582,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118002-EPILOGUE:11690:3","scriptId":11690,"text":"然后对着掉落到陷阱中四脚朝天的战车兽进行麻醉弹扫射，从这种极近距离进行射击，非常有成效。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":582,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118002-EPILOGUE:11690:4","scriptId":11690,"text":"坑中的战车兽很快药效发作陷入了沉睡。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":582,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:5","scriptId":11690,"text":"“不错不错，效果很明显，快看看有几只是标的战车兽。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":582,"section":3,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:6","scriptId":11690,"text":"“一只……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:7","scriptId":11690,"text":"“呃……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":3,"shake":false},{"kind":"dialogue","head":589,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:8","scriptId":11690,"text":"“以这样的速度要抓到什么时候去……表单里面可是有二十只呢……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":589,"section":3,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:9","scriptId":11690,"text":"“啊哈哈……这下变成持久战了？”","background":"/art/stories/zdbjbz-14.webp","left":582,"right":589,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118002-EPILOGUE:11690:10","scriptId":11690,"text":"从引诱到成功捕捉需要费一番功夫，而陷阱的制作时间也比较长，所以大家已经意识到这个方案的性价比很低……","background":"/art/stories/zdbjbz-14.webp","left":582,"right":589,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:11","scriptId":11690,"text":"“看来要换个方案了……我想想……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":589,"section":3,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:12","scriptId":11690,"text":"“我建议还是用比较简单直接的方法，引诱然后从旁狙击。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:13","scriptId":11690,"text":"“恩……这个方案之前已经试过了，战斗的劳损和弹药消耗非常大啊……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:14","scriptId":11690,"text":"“但是时间成本可以节约下来，快点完成这个任务以后，继续做其他委托补回损失不就行了吗？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:15","scriptId":11690,"text":"“呃……我考虑一下。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:16","scriptId":11690,"text":"（看来有必要和波西娅确认一下任务的限定时间……）","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:17","scriptId":11690,"text":"“这还考虑什么……真是……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":591,"section":3,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:18","scriptId":11690,"text":"“好啦～佩妮，这个决定交给指挥官来处理吧，我们只要好好的完成分配的工作就行了。”","background":"/art/stories/zdbjbz-14.webp","left":574,"right":591,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118002-EPILOGUE:11690:19","scriptId":11690,"text":"佩妮本来还打算说什么，不过听到奈特莉的话以后，把话又憋了回去。她凑到奈特莉身边……","background":"/art/stories/zdbjbz-14.webp","left":574,"right":591,"section":3,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:20","scriptId":11690,"text":"“你确定这个指挥官靠谱么？我怎么觉得他越来越不靠谱了……这决断力一点都不干脆啊。”（小声）","background":"/art/stories/zdbjbz-14.webp","left":574,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:21","scriptId":11690,"text":"“恩，犹豫不决的问题我之前就注意到了，不过这其实也算是一种优点吧，我们再等等看吧～”（小声）","background":"/art/stories/zdbjbz-14.webp","left":578,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":589,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118002-EPILOGUE:11690:22","scriptId":11690,"text":"“好吧……”","background":"/art/stories/zdbjbz-14.webp","left":578,"right":589,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118003-PROLOGUE:1710:2","scriptId":1710,"text":"第三天，通过老式陷阱的办法一共只抓到五只战车兽。","background":"/art/stories/zdbjbz-14.webp","left":578,"right":589,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118003-PROLOGUE:1710:3","scriptId":1710,"text":"弹药舞装之类的战损很小，大家状态良好，只是佩妮因为抓捕的速率问题上有点不满。","background":"/art/stories/zdbjbz-14.webp","left":578,"right":589,"section":4,"shake":false},{"kind":"dialogue","head":589,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118003-PROLOGUE:1710:4","scriptId":1710,"text":"“我说长官，按照这样的进度，我们至少还有十天左右的时间才能完成任务啊……这也太长了。”","background":"/art/stories/zdbjbz-14.webp","left":589,"right":589,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118003-PROLOGUE:1710:5","scriptId":1710,"text":"“应该不会太久了～”","background":"/art/stories/zdbjbz-14.webp","left":589,"right":4,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118003-PROLOGUE:1710:6","scriptId":1710,"text":"面对我这一副从容不迫的表情，佩妮十分不解。","background":"/art/stories/zdbjbz-14.webp","left":589,"right":4,"section":4,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118003-PROLOGUE:1710:7","scriptId":1710,"text":"“诶？为什么能说得那么肯定？”","background":"/art/stories/zdbjbz-14.webp","left":584,"right":4,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118003-PROLOGUE:1710:8","scriptId":1710,"text":"“你待会儿就知道了～”","background":"/art/stories/zdbjbz-14.webp","left":584,"right":4,"section":4,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118003-PROLOGUE:1710:9","scriptId":1710,"text":"“唔……”","background":"/art/stories/zdbjbz-14.webp","left":591,"right":4,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118003-PROLOGUE:1710:10","scriptId":1710,"text":"就在这时，维卡对我们两个说道。","background":"/art/stories/zdbjbz-14.webp","left":591,"right":4,"section":4,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118003-PROLOGUE:1710:11","scriptId":1710,"text":"“前方有小批战车兽靠近。”","background":"/art/stories/zdbjbz-14.webp","left":591,"right":596,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118003-PROLOGUE:1710:12","scriptId":1710,"text":"“佩妮，到前面去确认一下，是否有指定目标。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":596,"section":4,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118003-PROLOGUE:1710:13","scriptId":1710,"text":"“好好好……”","background":"/art/stories/zdbjbz-14.webp","left":591,"right":596,"section":4,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118003-PROLOGUE:1710:14","scriptId":1710,"text":"“不要带着情绪啦～这样会影响战斗状态的哟～”","background":"/art/stories/zdbjbz-14.webp","left":591,"right":574,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118003-EPILOGUE:11700:0","scriptId":11700,"text":"因为事先确认过并没有捕捉目标，所以很轻松地干掉了前来的战车兽。","background":"/art/stories/zdbjbz-14.webp","left":591,"right":574,"section":5,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118003-EPILOGUE:11700:2","scriptId":11700,"text":"“我们现在是在干什么？既不去找目标，也不挖陷阱，这不是在浪费时间吗？”","background":"/art/stories/zdbjbz-14.webp","left":591,"right":574,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118003-EPILOGUE:11700:3","scriptId":11700,"text":"我并没有在意佩妮的话，转而看了看手表。","background":"/art/stories/zdbjbz-14.webp","left":591,"right":574,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118003-EPILOGUE:11700:4","scriptId":11700,"text":"“哦，快来了～”","background":"/art/stories/zdbjbz-14.webp","left":591,"right":4,"section":5,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118003-EPILOGUE:11700:5","scriptId":11700,"text":"“？？？”","background":"/art/stories/zdbjbz-14.webp","left":584,"right":4,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118003-EPILOGUE:11700:6","scriptId":11700,"text":"我的这句话让佩妮有点摸不着头脑，生气的表情转变成了满脸疑问。","background":"/art/stories/zdbjbz-14.webp","left":584,"right":4,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"118003-EPILOGUE:11700:7","scriptId":11700,"text":"就在这时，我看到了远处的一样东西。","background":"/art/stories/zdbjbz-14.webp","left":584,"right":4,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118003-EPILOGUE:11700:8","scriptId":11700,"text":"“来了来了～”","background":"/art/stories/zdbjbz-14.webp","left":584,"right":4,"section":5,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118003-EPILOGUE:11700:9","scriptId":11700,"text":"“那个是波西娅博士？还开着吉普车？”","background":"/art/stories/zdbjbz-14.webp","left":572,"right":4,"section":5,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118003-EPILOGUE:11700:10","scriptId":11700,"text":"“恩……”","background":"/art/stories/zdbjbz-14.webp","left":572,"right":596,"section":5,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118003-EPILOGUE:11700:11","scriptId":11700,"text":"“诶？这是什么情况？”","background":"/art/stories/zdbjbz-14.webp","left":584,"right":596,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118003-EPILOGUE:11700:12","scriptId":11700,"text":"“因为在任务开始之前，波西娅博士忘记给我们专用的麻醉穿甲弹了，所以她现在亲自送过来了～”","background":"/art/stories/zdbjbz-14.webp","left":584,"right":4,"section":5,"shake":false},{"kind":"dialogue","head":590,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118003-EPILOGUE:11700:13","scriptId":11700,"text":"“什么，这种事情怎么不早点告诉我们……”","background":"/art/stories/zdbjbz-14.webp","left":590,"right":4,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"118003-EPILOGUE:11700:14","scriptId":11700,"text":"“我也是昨天晚上联络波西娅博士确认任务时限的时候才知道的啦～”","background":"/art/stories/zdbjbz-14.webp","left":590,"right":4,"section":5,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"118003-EPILOGUE:11700:15","scriptId":11700,"text":"“好吧……”","background":"/art/stories/zdbjbz-14.webp","left":591,"right":4,"section":5,"shake":false}],"summaries":[]}
