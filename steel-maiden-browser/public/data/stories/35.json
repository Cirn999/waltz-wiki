{"schemaVersion":1,"id":35,"sections":[{"id":"114004-PROLOGUE","name":"第 1 战 · 战前","scripts":[1160],"start":0,"count":13},{"id":"114004-EPILOGUE","name":"第 1 战 · 战后","scripts":[11150],"start":13,"count":9},{"id":"114005-PROLOGUE","name":"第 2 战 · 战前","scripts":[1170],"start":22,"count":17},{"id":"114005-EPILOGUE","name":"第 2 战 · 战后","scripts":[11160],"start":39,"count":10},{"id":"114006-PROLOGUE","name":"第 3 战 · 战前","scripts":[1180],"start":49,"count":11},{"id":"114006-EPILOGUE","name":"第 3 战 · 战后","scripts":[11170],"start":60,"count":6}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114004-PROLOGUE:1160:2","scriptId":1160,"text":"距离索菲亚教官进入研究大楼已经两个小时了……","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114004-PROLOGUE:1160:3","scriptId":1160,"text":"“教官这速度有点慢啊……”","background":"/art/stories/zdjm-034.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114004-PROLOGUE:1160:4","scriptId":1160,"text":"“教官会不会遇到麻烦了？”","background":"/art/stories/zdjm-034.webp","left":3,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114004-PROLOGUE:1160:5","scriptId":1160,"text":"“有无线电联络的，有什么状况的话，教官早就通知我们了吧。”","background":"/art/stories/zdjm-034.webp","left":3,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114004-PROLOGUE:1160:6","scriptId":1160,"text":"“况且如果真遇到麻烦了，以教官的身手这栋研究大楼会一点动静都没有吗？","background":"/art/stories/zdjm-034.webp","left":3,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114004-PROLOGUE:1160:7","scriptId":1160,"text":"“也对……”","background":"/art/stories/zdjm-034.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114004-PROLOGUE:1160:8","scriptId":1160,"text":"“所以你还是和莉娜一样，给我在草丛里蹲好……发现战车兽立刻报告。”","background":"/art/stories/zdjm-034.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114004-PROLOGUE:1160:9","scriptId":1160,"text":"“哦……”","background":"/art/stories/zdjm-034.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114004-PROLOGUE:1160:10","scriptId":1160,"text":"“不要聊天了！佐伊！有大批熊类战车兽朝你那个方向过去了！”","background":"/art/stories/zdjm-034.webp","left":81,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114004-PROLOGUE:1160:11","scriptId":1160,"text":"“什么？？”","background":"/art/stories/zdjm-034.webp","left":81,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114004-PROLOGUE:1160:12","scriptId":1160,"text":"“奈乐和普莉玛准备支援！”","background":"/art/stories/zdjm-034.webp","left":3,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":92,"speaker":"普莉玛·派普","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114004-PROLOGUE:1160:13","scriptId":1160,"text":"“好的！”","background":"/art/stories/zdjm-034.webp","left":3,"right":92,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114004-PROLOGUE:1160:14","scriptId":1160,"text":"“随时可以作战。”","background":"/art/stories/zdjm-034.webp","left":103,"right":92,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114004-EPILOGUE:11150:1","scriptId":11150,"text":"经过一番小规模战斗，摆平了那群黑熊。","background":"/art/stories/zdjm-034.webp","left":103,"right":92,"section":1,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114004-EPILOGUE:11150:2","scriptId":11150,"text":"“教官，那边还没好吗？门口的战车兽尸体都要堆起来了……”","background":"/art/stories/zdjm-034.webp","left":103,"right":92,"section":1,"shake":false},{"kind":"dialogue","head":216,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114004-EPILOGUE:11150:3","scriptId":11150,"text":"“我已经在13楼的研究室了，不过看样子研究人员无一幸免，全部遇难了。”","background":"/art/stories/zdjm-034.webp","left":103,"right":216,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114004-EPILOGUE:11150:4","scriptId":11150,"text":"“13楼……”","background":"/art/stories/zdjm-034.webp","left":3,"right":216,"section":1,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114004-EPILOGUE:11150:5","scriptId":11150,"text":"“这里的分析机有些故障，我得先修理一下，才能使用分析机，大概还要2-3个小时吧。”","background":"/art/stories/zdjm-034.webp","left":3,"right":211,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114004-EPILOGUE:11150:6","scriptId":11150,"text":"“我的天……那岂不是要天黑了？”","background":"/art/stories/zdjm-034.webp","left":3,"right":211,"section":1,"shake":false},{"kind":"dialogue","head":92,"speaker":"普莉玛·派普","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114004-EPILOGUE:11150:7","scriptId":11150,"text":"“天黑的话，视野变差，这里就会非常危险了。”","background":"/art/stories/zdjm-034.webp","left":3,"right":92,"section":1,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114004-EPILOGUE:11150:8","scriptId":11150,"text":"“不用担心啦，如果有什么问题，我会以最快速度赶下来的。”","background":"/art/stories/zdjm-034.webp","left":3,"right":219,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114004-EPILOGUE:11150:9","scriptId":11150,"text":"“好吧，那么继续蹲守……”","background":"/art/stories/zdjm-034.webp","left":3,"right":219,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114005-PROLOGUE:1170:2","scriptId":1170,"text":"正当众人在守在研究大楼正门的时候，远处的高台上----","background":"/art/stories/zdjm-034.webp","left":3,"right":219,"section":2,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114005-PROLOGUE:1170:3","scriptId":1170,"text":"“1、2、3、4～恩……有四个钢舞姬～怪不得刚才过去巡逻的毛熊都死翘翘了。”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":2,"shake":false},{"kind":"dialogue","head":50,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114005-PROLOGUE:1170:4","scriptId":1170,"text":"“哦，还有一个人类，还是个军官？”","background":"/art/stories/zdjm-034.webp","left":3,"right":50,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114005-PROLOGUE:1170:5","scriptId":1170,"text":"略微惊讶之余，埃普西隆露出了会心一笑。","background":"/art/stories/zdjm-034.webp","left":3,"right":50,"section":2,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114005-PROLOGUE:1170:6","scriptId":1170,"text":"“恩～闲着无聊，可以和她们玩个游戏～”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114005-PROLOGUE:1170:7","scriptId":1170,"text":"埃普西隆的笑容越发变得狰狞，她轻轻一挥手，周边的战车兽都抬起头，全部进入了静止状态。","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":2,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114005-PROLOGUE:1170:8","scriptId":1170,"text":"“看看她们能坚持多久～去攻击吧，家畜们～”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":2,"shake":false},{"kind":"dialogue","head":45,"speaker":"重甲毛熊","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114005-PROLOGUE:1170:9","scriptId":1170,"text":"“吼！！！”","background":"/art/stories/zdjm-034.webp","left":3,"right":45,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114005-PROLOGUE:1170:10","scriptId":1170,"text":"静止的战车兽们仿佛着了魔一样，齐刷刷地向在研究大楼门口的佐伊她们冲去……","background":"/art/stories/zdjm-034.webp","left":3,"right":45,"section":2,"shake":false},{"kind":"dialogue","head":82,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114005-PROLOGUE:1170:12","scriptId":1170,"text":"“哇！！！左边出现大量战车兽！！”","background":"/art/stories/zdjm-034.webp","left":82,"right":null,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114005-PROLOGUE:1170:13","scriptId":1170,"text":"“啊！！！右边也有好多战车兽！！”","background":"/art/stories/zdjm-034.webp","left":82,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114005-PROLOGUE:1170:14","scriptId":1170,"text":"“恩！！？？怎么会一下子有那么多战车兽？？”","background":"/art/stories/zdjm-034.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":108,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114005-PROLOGUE:1170:15","scriptId":1170,"text":"“我们应该也没有弄出很大动静啊？怎么会这样……”","background":"/art/stories/zdjm-034.webp","left":3,"right":108,"section":2,"shake":false},{"kind":"dialogue","head":92,"speaker":"普莉玛·派普","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114005-PROLOGUE:1170:16","scriptId":1170,"text":"“好多……我先进行火力打击了！”","background":"/art/stories/zdjm-034.webp","left":92,"right":108,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114005-PROLOGUE:1170:17","scriptId":1170,"text":"“莉娜和佐伊先从侦察点撤回来，集中火力，驱逐目标！”","background":"/art/stories/zdjm-034.webp","left":92,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":82,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114005-PROLOGUE:1170:18","scriptId":1170,"text":"“好的，立刻撤离当前位置。”","background":"/art/stories/zdjm-034.webp","left":82,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114005-PROLOGUE:1170:19","scriptId":1170,"text":"“诶？已经要撤了？”","background":"/art/stories/zdjm-034.webp","left":82,"right":41,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114005-EPILOGUE:11160:1","scriptId":11160,"text":"突如其来的袭击，让众人有些慌乱，但并没有失去理性。","background":"/art/stories/zdjm-034.webp","left":82,"right":41,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114005-EPILOGUE:11160:2","scriptId":11160,"text":"奈乐和普莉玛火力全开，炮火像雨点般的落在敌人的头上。","background":"/art/stories/zdjm-034.webp","left":82,"right":41,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114005-EPILOGUE:11160:3","scriptId":11160,"text":"而莉娜和佐伊则是顶在第一线，不让战车兽们靠近研究大楼半步。","background":"/art/stories/zdjm-034.webp","left":82,"right":41,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114005-EPILOGUE:11160:4","scriptId":11160,"text":"“索菲亚教官，听到请回话。”","background":"/art/stories/zdjm-034.webp","left":103,"right":41,"section":3,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114005-EPILOGUE:11160:5","scriptId":11160,"text":"“恩，听得到，怎么了？”","background":"/art/stories/zdjm-034.webp","left":103,"right":211,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114005-EPILOGUE:11160:6","scriptId":11160,"text":"“我们这边遇到点麻烦了，不知道从哪里突然冒出好多战车兽。”","background":"/art/stories/zdjm-034.webp","left":103,"right":211,"section":3,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114005-EPILOGUE:11160:7","scriptId":11160,"text":"“恩，从刚才就听到楼下大量的响声和震动了……现在的情况如何？”","background":"/art/stories/zdjm-034.webp","left":103,"right":211,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114005-EPILOGUE:11160:8","scriptId":11160,"text":"“我这边可视范围内大概就有十多只，长官怎么看？”","background":"/art/stories/zdjm-034.webp","left":103,"right":211,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114005-EPILOGUE:11160:9","scriptId":11160,"text":"“我们现在正准备退守到了大门内侧，敌人虽然数量有点多，不过都是些没脑子只会傻冲的类型。”","background":"/art/stories/zdjm-034.webp","left":3,"right":211,"section":3,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114005-EPILOGUE:11160:10","scriptId":11160,"text":"“那你们再撑会儿，我这边还要点时间，弄完以后会立刻来支援你们的～”","background":"/art/stories/zdjm-034.webp","left":3,"right":219,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114006-PROLOGUE:1180:2","scriptId":1180,"text":"我们退守到了大门内侧，这样一来就省去了目标分散的问题。","background":"/art/stories/zdjm-034.webp","left":3,"right":219,"section":4,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114006-PROLOGUE:1180:3","scriptId":1180,"text":"“恩，这样的话，应该还能撑更久。”","background":"/art/stories/zdjm-034.webp","left":103,"right":219,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114006-PROLOGUE:1180:4","scriptId":1180,"text":"“敌人数量虽多，但是因为大门口很窄，所以一次能冲进来的数量并不多。”","background":"/art/stories/zdjm-034.webp","left":103,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114006-PROLOGUE:1180:5","scriptId":1180,"text":"“那把大门入口炸塌不就行了吗？”","background":"/art/stories/zdjm-034.webp","left":41,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114006-PROLOGUE:1180:6","scriptId":1180,"text":"“唉……如果真能那么简单就好了……”","background":"/art/stories/zdjm-034.webp","left":41,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114006-PROLOGUE:1180:7","scriptId":1180,"text":"“什么意思？”","background":"/art/stories/zdjm-034.webp","left":41,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114006-PROLOGUE:1180:8","scriptId":1180,"text":"“既然我们已经被敌人发现，那么就算炸塌了入口，它们也会千方百计的从其他地方进来。”","background":"/art/stories/zdjm-034.webp","left":41,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114006-PROLOGUE:1180:9","scriptId":1180,"text":"“与其让敌人从其他入口进来弄得我们措手不及，还不如留一道口子让他们一批批进来送死。”","background":"/art/stories/zdjm-034.webp","left":41,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114006-PROLOGUE:1180:10","scriptId":1180,"text":"“好狠……”","background":"/art/stories/zdjm-034.webp","left":40,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":92,"speaker":"普莉玛·派普","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114006-PROLOGUE:1180:11","scriptId":1180,"text":"“不过这样打下去，不知道这大楼能否吃得消，大门口已经炸得面目全非了。”","background":"/art/stories/zdjm-034.webp","left":40,"right":92,"section":4,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114006-PROLOGUE:1180:12","scriptId":1180,"text":"“希望能撑到教官弄完……”","background":"/art/stories/zdjm-034.webp","left":103,"right":92,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114006-EPILOGUE:11170:1","scriptId":11170,"text":"高台上----","background":"/art/stories/zdjm-034.webp","left":103,"right":92,"section":5,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114006-EPILOGUE:11170:2","scriptId":11170,"text":"“嗯～～～～挺能撑的嘛～～～～”","background":"/art/stories/zdjm-034.webp","left":103,"right":48,"section":5,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114006-EPILOGUE:11170:3","scriptId":11170,"text":"“躲进大楼里面，不错的想法～毛熊不行的话，我这还有更好玩的东西～”","background":"/art/stories/zdjm-034.webp","left":103,"right":48,"section":5,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114006-EPILOGUE:11170:4","scriptId":11170,"text":"“你们也去吧～”","background":"/art/stories/zdjm-034.webp","left":103,"right":48,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114006-EPILOGUE:11170:5","scriptId":11170,"text":"埃普西隆又集结了更多的战车兽过来，这次集结的不是毛熊，而是臭鼬……","background":"/art/stories/zdjm-034.webp","left":103,"right":48,"section":5,"shake":false},{"kind":"dialogue","head":46,"speaker":"炮鼬","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"114006-EPILOGUE:11170:6","scriptId":11170,"text":"“吱吱！！”","background":"/art/stories/zdjm-034.webp","left":46,"right":48,"section":5,"shake":false}],"summaries":["持续蹲大门中……","突如其来的袭击……","漫长的拉锯战。"]}
