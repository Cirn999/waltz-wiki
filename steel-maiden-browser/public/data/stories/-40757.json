{"schemaVersion":1,"id":-40757,"sections":[{"id":"script-20757","name":"原始脚本 20757","scripts":[20757],"start":0,"count":33}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20757:20757:1","scriptId":20757,"text":"作为高贵的星团旅行者的一员，原本就没有义务去帮助地球上的劣等种。","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20757:20757:2","scriptId":20757,"text":"但由于违反了阿尔库涅大人的命令，欧米伽现在正在接受处罚。","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20757:20757:3","scriptId":20757,"text":"每每想到这里，欧米伽不由得感到一阵目眩……","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1195,"speaker":"欧米伽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:4","scriptId":20757,"text":"“真是难以置信，阿尔库涅大人竟然倒向人类那一边，完全搞不懂其中的理由……”","background":"/art/stories/zjm-067.webp","left":1195,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1195,"speaker":"欧米伽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:5","scriptId":20757,"text":"“帮助劣等种根本捞不到好处，还不如把他们当做骸虫们的饲料。”","background":"/art/stories/zjm-067.webp","left":1195,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20757:20757:6","scriptId":20757,"text":"欧米伽一边小声嘀咕着，一边将装有骸虫精髓的试管滴入培养皿中。","background":"/art/stories/zjm-067.webp","left":1195,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20757:20757:7","scriptId":20757,"text":"由于欧米伽擅自行动并攻击了阿尔库涅所指定的特级目标，她目前被罚协助兰布达进行义体改良。","background":"/art/stories/zjm-067.webp","left":1195,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1195,"speaker":"欧米伽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:8","scriptId":20757,"text":"“喂，兰布达，在这儿已经待了几个月了，你还真坐得住啊。”","background":"/art/stories/zjm-067.webp","left":1195,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:9","scriptId":20757,"text":"“才几个月你就坐不住了？”","background":"/art/stories/zjm-067.webp","left":1195,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1195,"speaker":"欧米伽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:10","scriptId":20757,"text":"“单纯搞研究不是我的专长啊，想出去透透气。”","background":"/art/stories/zjm-067.webp","left":1195,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:11","scriptId":20757,"text":"“……”","background":"/art/stories/zjm-067.webp","left":1195,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:12","scriptId":20757,"text":"“想要出去也行，如果我被人类那边征召的话，你就代替我去帮助他们。”","background":"/art/stories/zjm-067.webp","left":1195,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1195,"speaker":"欧米伽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:13","scriptId":20757,"text":"“什么！？竟然要我去帮助人类……”","background":"/art/stories/zjm-067.webp","left":1195,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:14","scriptId":20757,"text":"“也只有这么个借口，不然我也想不到把你放出去的办法。”","background":"/art/stories/zjm-067.webp","left":1195,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1195,"speaker":"欧米伽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:15","scriptId":20757,"text":"“呃……唔……嗯……”","background":"/art/stories/zjm-067.webp","left":1195,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20757:20757:16","scriptId":20757,"text":"欧米伽陷入了一阵沉思，仿佛在做着心理斗争。","background":"/art/stories/zjm-067.webp","left":1195,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1195,"speaker":"欧米伽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:17","scriptId":20757,"text":"“好吧……我答应你。”","background":"/art/stories/zjm-067.webp","left":1195,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:18","scriptId":20757,"text":"“嗯，很好，这样的话我也能安心进行研究了。”","background":"/art/stories/zjm-067.webp","left":1195,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20757:20757:20","scriptId":20757,"text":"过了一段时间，果然出现了征召信号。","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1195,"speaker":"欧米伽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:21","scriptId":20757,"text":"“喔！这下终于可以出去透透气了。”","background":"/art/stories/zjm-067.webp","left":1195,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:22","scriptId":20757,"text":"“走吧，我把你传送过去。”","background":"/art/stories/zjm-067.webp","left":1195,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20757:20757:23","scriptId":20757,"text":"白光过后，兰布达和欧米伽一起进行了传送。","background":"/art/stories/zjm-067.webp","left":1195,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:25","scriptId":20757,"text":"“嗯？怎么有两个人？”","background":"/art/stories/zdbjbz-20.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1195,"speaker":"欧米伽","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:26","scriptId":20757,"text":"“哼哼。”","background":"/art/stories/zdbjbz-20.webp","left":4,"right":1195,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:27","scriptId":20757,"text":"“诶！？这不是欧米伽吗？”","background":"/art/stories/zdbjbz-20.webp","left":4,"right":1195,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:28","scriptId":20757,"text":"“因为我现在比较忙，所以让欧米伽来代替我当外援。”","background":"/art/stories/zdbjbz-20.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:29","scriptId":20757,"text":"“哦，这样啊……”","background":"/art/stories/zdbjbz-20.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1195,"speaker":"欧米伽","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:30","scriptId":20757,"text":"“怎么，你还不满意？”","background":"/art/stories/zdbjbz-20.webp","left":4,"right":1195,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:31","scriptId":20757,"text":"“不不不，怎么会，既然能来帮忙就再好不过了。”","background":"/art/stories/zdbjbz-20.webp","left":4,"right":1195,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:32","scriptId":20757,"text":"“好了，那我先走了，欧米伽的出击时间为一小时，届时她会自动传回我那儿。”","background":"/art/stories/zdbjbz-20.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:33","scriptId":20757,"text":"“哦，了解了。”","background":"/art/stories/zdbjbz-20.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1195,"speaker":"欧米伽","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:34","scriptId":20757,"text":"“啊？才一小时？那么短啊。”","background":"/art/stories/zdbjbz-20.webp","left":4,"right":1195,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20757:20757:35","scriptId":20757,"text":"“能放你出来就不错了，先将就着吧。”","background":"/art/stories/zdbjbz-20.webp","left":4,"right":1198,"section":0,"shake":false}],"summaries":[]}
