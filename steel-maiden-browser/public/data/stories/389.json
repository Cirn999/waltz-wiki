{"schemaVersion":1,"id":389,"sections":[{"id":"908001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20656],"start":0,"count":30},{"id":"908001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20657],"start":30,"count":26}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-PROLOGUE:20656:1","scriptId":20656,"text":"成功救出了安妮·沃佳诺娃之后——","background":"/art/stories/zdbjbz-02.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-PROLOGUE:20656:2","scriptId":20656,"text":"由于安妮非常虚弱，我们立刻让她服下了清水和一些压碎的干粮。","background":"/art/stories/zdbjbz-02.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-PROLOGUE:20656:3","scriptId":20656,"text":"好在她只是虚弱，身体上并没有明显的受伤迹象。","background":"/art/stories/zdbjbz-02.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-PROLOGUE:20656:4","scriptId":20656,"text":"在临时搭建的帐篷中对安妮进行临时护理之后，她的情况目前趋于缓和，原本苍白的脸庞也恢复了一些血色。","background":"/art/stories/zdbjbz-02.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-PROLOGUE:20656:5","scriptId":20656,"text":"帐篷外——","background":"/art/stories/zdbjbz-02.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:6","scriptId":20656,"text":"“怎么样？安妮的情况好些了吗？”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-PROLOGUE:20656:7","scriptId":20656,"text":"趁着奈特莉出来换毛巾的时候，我问道。","background":"/art/stories/zdbjbz-02.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":577,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:8","scriptId":20656,"text":"“应该没事了，她只是有些虚弱，毕竟几天没吃东西。如果我们再晚几天的话，或许就要被活活饿死……”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":577,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:9","scriptId":20656,"text":"“真是万幸……那我现在可以进去了吧？”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":577,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:10","scriptId":20656,"text":"“可以了。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-PROLOGUE:20656:12","scriptId":20656,"text":"我钻入帐篷，看到佐伊和佩妮正在和安妮说话，如奈特莉所说安妮的状况应该已经没问题了。","background":"/art/stories/zdbjbz-02.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:13","scriptId":20656,"text":"“啊，长官来了。”","background":"/art/stories/zdbjbz-02.webp","left":740,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:14","scriptId":20656,"text":"“你好，安妮·沃佳诺娃。我们是死水佣兵，受理了寻找你的任务。”","background":"/art/stories/zdbjbz-02.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:15","scriptId":20656,"text":"“虽然你还没完全恢复，但我还是想尽快弄清你遇到的麻烦。”","background":"/art/stories/zdbjbz-02.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:16","scriptId":20656,"text":"“谢谢您和您的部下救了我，说真的，当时我已经快要放弃活下去的意志了。”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:17","scriptId":20656,"text":"“而且我完全没有想到外面竟然是如此凄惨的状况……”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:18","scriptId":20656,"text":"“哦，是佐伊她们跟你说了吗？”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:19","scriptId":20656,"text":"“是的……我原本在执行巡逻任务……但不知为什么就被关到到那个地下室里……”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:20","scriptId":20656,"text":"“记忆缺失……","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:21","scriptId":20656,"text":"“在那里，每天都能听到各种惨叫声，我很害怕，试图用舞装逃跑，但不知道为什么我根本使不出力气。”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:22","scriptId":20656,"text":"“现在也是这样吗？”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:23","scriptId":20656,"text":"“现在好些了，至少有源奶的情况下，我想我还是能正常作战的。”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:24","scriptId":20656,"text":"“对了……那时候有长着触手的女人偶尔会给我送一点点食物，直到前阵子，她们都不见了。”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:25","scriptId":20656,"text":"“看来是旅行者，你还能回忆起其他情况吗？一些细节也好。”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:26","scriptId":20656,"text":"“对不起，好像没有特别的了，我这脖子上的环能不能拿掉？”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:27","scriptId":20656,"text":"“嗯？这个环不是你舞装的一部分么？我还以为是装饰呢。”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:28","scriptId":20656,"text":"“我被关的时候就发现多了这个环，也因为这个我的舞装好像脱不下来了。”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:29","scriptId":20656,"text":"“是的，我们也没办法卸下她的舞装。”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":584,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-PROLOGUE:20656:30","scriptId":20656,"text":"听到佩妮这么说，我想了想。","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-PROLOGUE:20656:31","scriptId":20656,"text":"“这事情需要问问她了。”","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-EPILOGUE:20657:1","scriptId":20657,"text":"原本打算先带安妮回死水，但在这时候发生了一些问题。","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-EPILOGUE:20657:2","scriptId":20657,"text":"安妮无法离开那片特殊磁场的区域……就像有空气墙一样。","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-EPILOGUE:20657:3","scriptId":20657,"text":"不过原因多半也是因为安妮脖子上的那个项圈一样的环。","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-EPILOGUE:20657:4","scriptId":20657,"text":"没办法，我只能使出了杀手锏。","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-EPILOGUE:20657:5","scriptId":20657,"text":"研究所的废墟中——","background":"/art/stories/zdbjbz-02.webp","left":1135,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:6","scriptId":20657,"text":"“怎么样？有什么眉目吗？”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:7","scriptId":20657,"text":"“那个钢舞姬所戴的是迪塔格项圈，可以弱化佩戴者的生物能，并且囚禁在特定的磁场范围内。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:8","scriptId":20657,"text":"“一般都是给不听话的骸虫装的，当然对待俘虏也是个非常好的囚禁手段。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:9","scriptId":20657,"text":"“那有办法解除吗？”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:10","scriptId":20657,"text":"“这个需要安装者的权令才能解除，我也没办法。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:11","scriptId":20657,"text":"“那这个安装者是谁？你有办法知道吗？”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:12","scriptId":20657,"text":"“我正在调查不是吗？”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-EPILOGUE:20657:13","scriptId":20657,"text":"冒着兰布达可能叛逃风险，让波西娅用了点小手段让兰布达从死水溜了过来。","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-EPILOGUE:20657:14","scriptId":20657,"text":"不过现在看来这冒险还是值得的，兰布达确实帮上了大忙。","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:15","scriptId":20657,"text":"“…………”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:16","scriptId":20657,"text":"（这惨状，多半是柯西干的……不过以她的能力，根本不屑使用迪塔格项圈才对，或许还有其他人……）","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-EPILOGUE:20657:17","scriptId":20657,"text":"兰布达开始翻找废墟中的线索。","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-EPILOGUE:20657:18","scriptId":20657,"text":"很快她就锁定了一样东西——是一盘磁带。","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:19","scriptId":20657,"text":"“这磁带是……？”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:20","scriptId":20657,"text":"“哦，长得确实跟人类的磁带有点像，不过这东西不是磁带，它是波谱坐标集。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"908001-EPILOGUE:20657:21","scriptId":20657,"text":"兰布达打开磁带的外壳，里面写着奇怪的数字和符号。","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:22","scriptId":20657,"text":"（这东西是用来做记录的，可以看看这里到底在搞什么名堂……不过收集起来有点麻烦……）","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:23","scriptId":20657,"text":"“去收集这些坐标集，我可以试着给你们找到迪塔格项圈的安装者。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:24","scriptId":20657,"text":"“哦！？这样就行了？”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:25","scriptId":20657,"text":"“是的。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"908001-EPILOGUE:20657:26","scriptId":20657,"text":"（真是容易使唤的家伙。）","background":"/art/stories/zdbjbz-02.webp","left":4,"right":56,"section":1,"shake":false}],"summaries":[]}
