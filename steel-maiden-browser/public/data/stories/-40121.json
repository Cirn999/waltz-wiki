{"schemaVersion":1,"id":-40121,"sections":[{"id":"script-20121","name":"原始脚本 20121","scripts":[20121],"start":0,"count":52}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:0","scriptId":20121,"text":"吃完晚饭，伊诺娜提出轮班制的执勤，由我们小队进行第一轮值班。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:1","scriptId":20121,"text":"度假村哨岗附近——","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:2","scriptId":20121,"text":"“呼……这工作确实性价比很高啊，感觉没什么难度，真是要谢谢芮蓓啊～”","background":"/art/stories/zjm-047.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:3","scriptId":20121,"text":"“是的，现阶段感觉不到难度，不过也不能放松晚上的执勤。”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:4","scriptId":20121,"text":"“确实，不过我看佐伊她们好像已经一脸期待的样子了……”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":742,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:5","scriptId":20121,"text":"“哼哼～长官观察地真仔细，这轮值班完成以后我和奈特莉打算去沙滩玩～晚上的沙滩应该也不错～”","background":"/art/stories/zjm-047.webp","left":4,"right":742,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:6","scriptId":20121,"text":"（好恐怖的顺风耳……）","background":"/art/stories/zjm-047.webp","left":4,"right":742,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:7","scriptId":20121,"text":"“还好吧～你这点花花肠子都写在脸上了……看不出来倒是奇怪了。”","background":"/art/stories/zjm-047.webp","left":4,"right":742,"section":0,"shake":false},{"kind":"dialogue","head":742,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:8","scriptId":20121,"text":"“诶嘿嘿～”","background":"/art/stories/zjm-047.webp","left":4,"right":742,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:9","scriptId":20121,"text":"“不要玩太疯，这任务要三天呢……”","background":"/art/stories/zjm-047.webp","left":4,"right":742,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:11","scriptId":20121,"text":"大约两个小时以后，情况发生了变化——","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:12","scriptId":20121,"text":"“发现异常！”","background":"/art/stories/zjm-047.webp","left":596,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":581,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:13","scriptId":20121,"text":"“是软泥生物！”","background":"/art/stories/zjm-047.webp","left":596,"right":581,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:14","scriptId":20121,"text":"从反方向跑来的奈特莉和维卡一脸紧张的样子。","background":"/art/stories/zjm-047.webp","left":596,"right":581,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:15","scriptId":20121,"text":"“什么！？”","background":"/art/stories/zjm-047.webp","left":4,"right":581,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:16","scriptId":20121,"text":"气氛一下子变得凝重了起来……","background":"/art/stories/zjm-047.webp","left":4,"right":581,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:17","scriptId":20121,"text":"我以最快速度跑到另一边的哨塔上，佐伊她们也紧随其后。","background":"/art/stories/zjm-047.webp","left":4,"right":581,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:18","scriptId":20121,"text":"“这……没错……是软泥！”","background":"/art/stories/zjm-047.webp","left":4,"right":581,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:19","scriptId":20121,"text":"软泥生物——虽然没有见过真正的本体，但是在之前和德尔塔交战的时候有见识过。","background":"/art/stories/zjm-047.webp","left":4,"right":581,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:20","scriptId":20121,"text":"如果出现了这种生物，则说明旅行者有极大的可能会出现。","background":"/art/stories/zjm-047.webp","left":4,"right":581,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:21","scriptId":20121,"text":"我攒紧了拳头……","background":"/art/stories/zjm-047.webp","left":4,"right":581,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:22","scriptId":20121,"text":"“现在是晚上，视野很差，不利作战，如果真的是旅行者……埃普西隆到还好，如果是兰布达这种的话，就非常难搞了……”","background":"/art/stories/zjm-047.webp","left":4,"right":581,"section":0,"shake":false},{"kind":"dialogue","head":594,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:23","scriptId":20121,"text":"“长官说得正是，现在是晚上，不适合正面战斗，先观望一下。”","background":"/art/stories/zjm-047.webp","left":4,"right":594,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:24","scriptId":20121,"text":"“恩……佩妮，你去把伊诺娜她们叫起来，塞西尔那边也通知一下，虽然不一定要她们出战，但是至少要警惕起来。”","background":"/art/stories/zjm-047.webp","left":4,"right":594,"section":0,"shake":false},{"kind":"dialogue","head":593,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:25","scriptId":20121,"text":"“好的，我马上就去。”","background":"/art/stories/zjm-047.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:26","scriptId":20121,"text":"说完，佩妮就一路飞奔，离开了哨塔。","background":"/art/stories/zjm-047.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:27","scriptId":20121,"text":"“这种时候通知波西娅准没错……”","background":"/art/stories/zjm-047.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:28","scriptId":20121,"text":"我又一次拿出了通信器。","background":"/art/stories/zjm-047.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:29","scriptId":20121,"text":"“波西娅！？听到没有？波西娅！？”","background":"/art/stories/zjm-047.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:30","scriptId":20121,"text":"“听到了……大晚上的……不要吵吵嚷嚷……”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:31","scriptId":20121,"text":"“发现重大情况，可能有旅行者的踪迹。”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:32","scriptId":20121,"text":"“什么！！？？”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:33","scriptId":20121,"text":"通信器的另一头传来了波西娅的欢呼声，震得我耳朵都有点疼了……","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:34","scriptId":20121,"text":"“那个……波西娅？”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:35","scriptId":20121,"text":"“你在度假村是吧？”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:36","scriptId":20121,"text":"“对的……”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:37","scriptId":20121,"text":"“我马上过来！”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:38","scriptId":20121,"text":"因为软泥生物并没有任何攻击性的表现，和白天面对战车兽不同，我们并没选择主动出击而是静观其变。","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:39","scriptId":20121,"text":"大约十分钟后伊诺娜小队赶到了，波西娅也在之后不久就赶到了。","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20121:20121:40","scriptId":20121,"text":"塞西尔小队已经成功到避难所等待进一步消息，尤拉和艾丽莎则没有跟着波西娅一起来，她们在科研基地也算比较安全。","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:41","scriptId":20121,"text":"“情况就如诸位所看到的一样……软泥并没有什么攻击动作，只是在丛林附近晃悠。”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":799,"speaker":"波比·克里斯蒂安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:42","scriptId":20121,"text":"“这软泥长得像大型的巧克力冰淇淋……”","background":"/art/stories/zjm-047.webp","left":4,"right":799,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:43","scriptId":20121,"text":"“不过我可以保证肯定比冰淇淋难吃……”","background":"/art/stories/zjm-047.webp","left":4,"right":799,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:44","scriptId":20121,"text":"“这东西从来没见到过呢……好对付吗？”","background":"/art/stories/zjm-047.webp","left":4,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:45","scriptId":20121,"text":"“比战车兽难对付不少，会分裂。要破坏藏在身体某处的核心才能弄死。”","background":"/art/stories/zjm-047.webp","left":608,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:46","scriptId":20121,"text":"“话说？这里只有一只么……？”","background":"/art/stories/zjm-047.webp","left":608,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:47","scriptId":20121,"text":"“是的，暂时没有发现其他个体。”","background":"/art/stories/zjm-047.webp","left":608,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:48","scriptId":20121,"text":"“哦呀哦呀～那这样的话，能不能试着捕获一下啊？”","background":"/art/stories/zjm-047.webp","left":608,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:49","scriptId":20121,"text":"“喂喂……波西娅博士，这可不是好玩的……现在是晚上，而且万一不止一只呢……”","background":"/art/stories/zjm-047.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:50","scriptId":20121,"text":"“那就等到早上如何，现在软泥怪也没有动静，时间有的是。”","background":"/art/stories/zjm-047.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":747,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:51","scriptId":20121,"text":"“抓软泥……好恶心啊……”","background":"/art/stories/zjm-047.webp","left":608,"right":747,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20121:20121:52","scriptId":20121,"text":"“当然我也不会强人所难，抓不到也没办法，但是如果能抓到的话，我会支付非常高额的费用来购买～”","background":"/art/stories/zjm-047.webp","left":608,"right":747,"section":0,"shake":false}],"summaries":[]}
