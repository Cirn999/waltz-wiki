{"schemaVersion":1,"id":360,"sections":[{"id":"819001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20595],"start":0,"count":28},{"id":"819001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20596],"start":28,"count":23}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-PROLOGUE:20595:1","scriptId":20595,"text":"废弃的基地中，有一名旅行者正在其中徘徊。","background":"/art/stories/zjm-054.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:2","scriptId":20595,"text":"（柔，听得到吗？）","background":"/art/stories/zjm-054.webp","left":1110,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-PROLOGUE:20595:3","scriptId":20595,"text":"菲通过感应通信呼叫了基地外围的另一名旅行者。","background":"/art/stories/zjm-054.webp","left":1110,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:4","scriptId":20595,"text":"（怎么了？有收获吗？）","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:5","scriptId":20595,"text":"（很遗憾，并没有什么收获，既没有战车兽，也没有一点筑巢的痕迹。”","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:6","scriptId":20595,"text":"（奇怪了，理论上这种废弃基地非常适合战车兽居住。）","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:7","scriptId":20595,"text":"（那就是扑空了？）","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:8","scriptId":20595,"text":"（可能是吧。）","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:9","scriptId":20595,"text":"（这里有好多源铁，可能是之前人类没带走的。）","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:10","scriptId":20595,"text":"（源铁？你等等，我这就过来。）","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-PROLOGUE:20595:12","scriptId":20595,"text":"很快柔就出现在了菲的面前。","background":"/art/stories/zjm-054.webp","left":1110,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:13","scriptId":20595,"text":"“这就是你说的源铁？”","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:14","scriptId":20595,"text":"“是的，那边还有很多，你看。”","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-PROLOGUE:20595:15","scriptId":20595,"text":"菲指向另外一个角落，确实也有不少方方正正的源铁散落在那儿。","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-PROLOGUE:20595:16","scriptId":20595,"text":"柔从乘坐的浮空轮上跳了下来，捡起一块源铁的碎块仔细端详。","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:17","scriptId":20595,"text":"“这东西，确实是源铁，不过又有点不太一样……我得带点样本回去研究一下。”","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-PROLOGUE:20595:18","scriptId":20595,"text":"突然，浮空轮上的多头骸虫发出了警觉地嘶叫。","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:19","scriptId":20595,"text":"（看来我们是来对了。）","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-PROLOGUE:20595:20","scriptId":20595,"text":"柔不自然地切换成了感应通信让菲立刻察觉到了事态的变化。","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:21","scriptId":20595,"text":"（对面好像有两个东西正在移动。）","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"dialogue","head":1127,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:22","scriptId":20595,"text":"“……”","background":"/art/stories/zjm-054.webp","left":1110,"right":1127,"section":0,"shake":false},{"kind":"dialogue","head":1128,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:23","scriptId":20595,"text":"“……”","background":"/art/stories/zjm-054.webp","left":1128,"right":1127,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-PROLOGUE:20595:24","scriptId":20595,"text":"很快昏暗的走道里出现了两个飞行在半空中的东西。","background":"/art/stories/zjm-054.webp","left":1128,"right":1127,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:25","scriptId":20595,"text":"（来了啊。）","background":"/art/stories/zjm-054.webp","left":1110,"right":1127,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-PROLOGUE:20595:26","scriptId":20595,"text":"菲展开了手里武器，看上去是准备应战的态势。","background":"/art/stories/zjm-054.webp","left":1110,"right":1127,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:27","scriptId":20595,"text":"（笨蛋，这里迎战对我们不利。而且目标不止这两只，正有大批同类型目标朝这里靠近。）","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-PROLOGUE:20595:28","scriptId":20595,"text":"经柔的提醒，菲这才收回了架势。","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-PROLOGUE:20595:29","scriptId":20595,"text":"（嗯，先出去再说。）","background":"/art/stories/zjm-054.webp","left":1110,"right":1124,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-EPILOGUE:20596:3","scriptId":20596,"text":"巨大的爆炸声响彻天空，菲和柔从半封闭的基地中直冲出来。","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":true},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-EPILOGUE:20596:4","scriptId":20596,"text":"尾随而至的是一群虫型飞行物。","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:5","scriptId":20596,"text":"（这群战车兽是怎么回事？比以往更有气势嘛。）","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:6","scriptId":20596,"text":"（注意，不要全部杀光，留活口。）","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:7","scriptId":20596,"text":"（我尽量。）","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-EPILOGUE:20596:9","scriptId":20596,"text":"菲和柔分头行动把追击的虫群分成了两队。数量削减之后，她们独自开始清理这些从基地里追击而出的生物。","background":"/art/stories/zdbjbz-17.webp","left":null,"right":null,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-EPILOGUE:20596:12","scriptId":20596,"text":"一阵交锋过后，柔这里的虫型飞行物很快便被灼烧殆尽，她的多头蛇形骸虫一旦进入攻击状态之后便会发动无差别攻击。","background":"/art/stories/zdbjbz-17.webp","left":null,"right":null,"section":1,"shake":true},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:13","scriptId":20596,"text":"“都让你们注意一下了，结果还是烧光了啊……”","background":"/art/stories/zdbjbz-17.webp","left":null,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:14","scriptId":20596,"text":"“每次近距离看你作战我都深有体会……你那骸虫发起疯来真吓人，你倒是想想怎么控制一下它们啊。”","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:15","scriptId":20596,"text":"“如果强硬控制这些孩子们的话，就不会有如此高的战力了。”","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:16","scriptId":20596,"text":"“放任自流还有理了……不过上面没意见的话，肯定有。”","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:17","scriptId":20596,"text":"“你那边怎么样了？也搞定了？”","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:18","scriptId":20596,"text":"“本来我就不会输，只不过要完成你的不杀任务有点困难。”","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:19","scriptId":20596,"text":"“那你也失手了？”","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:20","scriptId":20596,"text":"“失手倒也谈不上，但确实是失败了。”","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:21","scriptId":20596,"text":"“怎么说？”","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-EPILOGUE:20596:22","scriptId":20596,"text":"菲指了指地上一滩烧焦的痕迹。","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:23","scriptId":20596,"text":"“我本来已经把其中一只的翅膀射断了，但那玩意在坠落的途中突然就爆炸了，什么都没留下。”","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:24","scriptId":20596,"text":"“先找找有没有残骸碎片吧。不然这次的收获就只有这个了……”","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-EPILOGUE:20596:25","scriptId":20596,"text":"柔从怀里掏出一块源铁碎块。","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"dialogue","head":1110,"speaker":"菲","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"819001-EPILOGUE:20596:26","scriptId":20596,"text":"“好吧……但我总觉得这很没意义就是了。”","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-EPILOGUE:20596:27","scriptId":20596,"text":"菲又一次盘旋在她刚刚战斗过的区域，同时仔细寻找是否有漏网之鱼的残骸碎片。","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"819001-EPILOGUE:20596:28","scriptId":20596,"text":"当然结果和她自己猜想的一样，毫无收获。","background":"/art/stories/zdbjbz-17.webp","left":1110,"right":1124,"section":1,"shake":false}],"summaries":[]}
