{"schemaVersion":1,"id":14,"sections":[{"id":"109001-PROLOGUE","name":"第 1 战 · 战前","scripts":[430],"start":0,"count":9},{"id":"109001-EPILOGUE","name":"第 1 战 · 战后","scripts":[10420],"start":9,"count":4},{"id":"109002-PROLOGUE","name":"第 2 战 · 战前","scripts":[440,441,442,443],"start":13,"count":20},{"id":"109002-EPILOGUE","name":"第 2 战 · 战后","scripts":[10430,10431,10432,10433],"start":33,"count":26},{"id":"109003-PROLOGUE","name":"第 3 战 · 战前","scripts":[450,451,452,453],"start":59,"count":36},{"id":"109003-EPILOGUE","name":"第 3 战 · 战后","scripts":[10440],"start":95,"count":2}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109001-PROLOGUE:430:2","scriptId":430,"text":"开上了中继站里借来的吉普车，行进速度立刻大幅飞跃。","background":"/art/stories/zdbjbz-06.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109001-PROLOGUE:430:3","scriptId":430,"text":"“根据芙琳的情报，她们小队应该是最快拿到旗帜的队伍。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109001-PROLOGUE:430:4","scriptId":430,"text":"“作为我们的后辈来说，做的还是相当不错的嘛～”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":37,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109001-PROLOGUE:430:5","scriptId":430,"text":"“根据规则的话，其实我们刚才应该追击她们的护旗手。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":37,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109001-PROLOGUE:430:6","scriptId":430,"text":"“不过之前受到过芙琳她们的关照，所以就算了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":37,"section":0,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109001-PROLOGUE:430:7","scriptId":430,"text":"“长官还是游刃有余的嘛。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":39,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109001-PROLOGUE:430:8","scriptId":430,"text":"“不不，我第一次参加夺旗战。军官培训里面夺旗战就和走国际象棋差不多。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":39,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109001-PROLOGUE:430:9","scriptId":430,"text":"“……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109001-PROLOGUE:430:10","scriptId":430,"text":"（原来都是纸上谈兵啊……）","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109001-EPILOGUE:10420:1","scriptId":10420,"text":"为了方便吉普车的行进，只能挑选比较好行驶的山路。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109001-EPILOGUE:10420:2","scriptId":10420,"text":"“以目前的速度来看，明天就能到达目标位置。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":1,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109001-EPILOGUE:10420:3","scriptId":10420,"text":"“不过走在大路上不觉得我们更容易遭到战车兽的攻击吗？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109001-EPILOGUE:10420:4","scriptId":10420,"text":"“还好吧，现在弥补和大部队的速度差才是关键。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109002-PROLOGUE:440:2","scriptId":440,"text":"距离旗帜放置地区已经不远了。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109002-PROLOGUE:440:3","scriptId":440,"text":"周围能听到此起彼伏的炮击声，看来算是赶上了大部队。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-PROLOGUE:440:4","scriptId":440,"text":"“情况不乐观啊……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-PROLOGUE:440:5","scriptId":440,"text":"“快要到指定地点了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-PROLOGUE:440:6","scriptId":440,"text":"“还剩1公里左右就要进入旗帜放置区域最大半径范围。”","background":"/art/stories/zdbjbz-06.webp","left":61,"right":31,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109002-PROLOGUE:441:2","scriptId":441,"text":"距离旗帜放置地区已经不远了。","background":"/art/stories/zdbjbz-06.webp","left":61,"right":31,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109002-PROLOGUE:441:3","scriptId":441,"text":"周围能听到此起彼伏的炮击声，看来算是赶上了大部队。","background":"/art/stories/zdbjbz-06.webp","left":61,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-PROLOGUE:441:4","scriptId":441,"text":"“情况不乐观啊……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-PROLOGUE:441:5","scriptId":441,"text":"“快要到指定地点了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-PROLOGUE:441:6","scriptId":441,"text":"“旗帜区域离这里还有1公里，加快速度吧。”","background":"/art/stories/zdbjbz-06.webp","left":1171,"right":31,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109002-PROLOGUE:442:2","scriptId":442,"text":"距离旗帜放置地区已经不远了。","background":"/art/stories/zdbjbz-06.webp","left":1171,"right":31,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109002-PROLOGUE:442:3","scriptId":442,"text":"周围能听到此起彼伏的炮击声，看来算是赶上了大部队。","background":"/art/stories/zdbjbz-06.webp","left":1171,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-PROLOGUE:442:4","scriptId":442,"text":"“情况不乐观啊……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-PROLOGUE:442:5","scriptId":442,"text":"“快要到指定地点了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-PROLOGUE:442:6","scriptId":442,"text":"“有意思，我的热血开始沸腾了，终于要对上钢舞姬了啊。”","background":"/art/stories/zdbjbz-06.webp","left":968,"right":31,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109002-PROLOGUE:443:2","scriptId":443,"text":"距离旗帜放置地区已经不远了。","background":"/art/stories/zdbjbz-06.webp","left":968,"right":31,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109002-PROLOGUE:443:3","scriptId":443,"text":"周围能听到此起彼伏的炮击声，看来算是赶上了大部队。","background":"/art/stories/zdbjbz-06.webp","left":968,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-PROLOGUE:443:4","scriptId":443,"text":"“情况不乐观啊……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-PROLOGUE:443:5","scriptId":443,"text":"“快要到指定地点了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-PROLOGUE:443:6","scriptId":443,"text":"“这阵仗，应该有不少队伍啊，开始有意思了。”","background":"/art/stories/zdbjbz-06.webp","left":1158,"right":31,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109002-EPILOGUE:10430:1","scriptId":10430,"text":"正式进入旗帜范围，开始地毯式搜索。","background":"/art/stories/zdbjbz-06.webp","left":1158,"right":31,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10430:2","scriptId":10430,"text":"“最大搜索范围是多少来着？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10430:3","scriptId":10430,"text":"“大概1/3平方公里。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":61,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10430:4","scriptId":10430,"text":"“我靠，这也太大了吧，足足有40个足球场大小……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":61,"section":3,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10430:5","scriptId":10430,"text":"“这才是模拟战场的规格。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10430:6","scriptId":10430,"text":"“反过来想想，搜索范围越大，旗帜被找到的几率就越小，我们还有机会。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109002-EPILOGUE:10431:1","scriptId":10431,"text":"正式进入旗帜范围，开始地毯式搜索。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10431:2","scriptId":10431,"text":"“最大搜索范围是多少来着？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10431:3","scriptId":10431,"text":"“大概1/3平方公里。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1171,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10431:4","scriptId":10431,"text":"“我靠，这也太大了吧，足足有40个足球场大小……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1171,"section":3,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10431:5","scriptId":10431,"text":"“这才是模拟战场的规格。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10431:6","scriptId":10431,"text":"“反过来想想，搜索范围越大，旗帜被找到的几率就越小，我们还有机会。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109002-EPILOGUE:10432:1","scriptId":10432,"text":"正式进入旗帜范围，开始地毯式搜索。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10432:2","scriptId":10432,"text":"“最大搜索范围是多少来着？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"dialogue","head":975,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10432:3","scriptId":10432,"text":"“呃，忘记了……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":975,"section":3,"shake":false},{"kind":"dialogue","head":1152,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10432:4","scriptId":10432,"text":"“约1/3平方公里。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1152,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10432:5","scriptId":10432,"text":"“我靠，这也太大了吧，足足有40个足球场大小……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1152,"section":3,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10432:6","scriptId":10432,"text":"“这才是模拟战场的规格。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10432:7","scriptId":10432,"text":"“反过来想想，搜索范围越大，旗帜被找到的几率就越小，我们还有机会。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109002-EPILOGUE:10433:1","scriptId":10433,"text":"正式进入旗帜范围，开始地毯式搜索。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10433:2","scriptId":10433,"text":"“最大搜索范围是多少来着？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10433:3","scriptId":10433,"text":"“大概1/3平方公里。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1170,"section":3,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10433:4","scriptId":10433,"text":"“还挺宽敞，要在这里搜索的话可要费一番功夫了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10433:5","scriptId":10433,"text":"“我靠，这也太大了吧，足足有40个足球场大小……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":3,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10433:6","scriptId":10433,"text":"“这才是模拟战场的规格。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109002-EPILOGUE:10433:7","scriptId":10433,"text":"“反过来想想，搜索范围越大，旗帜被找到的几率就越小，我们还有机会。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109003-PROLOGUE:450:2","scriptId":450,"text":"搜索持续进行中，但是毫无结果，时间一分一秒地流逝着。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":4,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:450:3","scriptId":450,"text":"“到底还有没有旗帜啊……”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":31,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:450:4","scriptId":450,"text":"“周围还是能听到一些炮火的声音，说明还有和我们一样没有找到旗帜的人。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:450:5","scriptId":450,"text":"“旗帜总数确实不多，说不定我们这些人都是在进行徒劳的搜索。”","background":"/art/stories/zdbjbz-06.webp","left":61,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:450:6","scriptId":450,"text":"“报告！发现旗帜了！”","background":"/art/stories/zdbjbz-06.webp","left":61,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:450:7","scriptId":450,"text":"“在哪！？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:450:8","scriptId":450,"text":"“前面那只灵长类的战车兽手里。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:450:9","scriptId":450,"text":"“那还等什么！？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:450:10","scriptId":450,"text":"“出发！捉猴子去咯！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":32,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109003-PROLOGUE:451:2","scriptId":451,"text":"搜索持续进行中，但是毫无结果，时间一分一秒地流逝着。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":32,"section":4,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:451:3","scriptId":451,"text":"“到底还有没有旗帜啊……”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":32,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:451:4","scriptId":451,"text":"“周围还是能听到一些炮火的声音，说明还有和我们一样没有找到旗帜的人。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:451:5","scriptId":451,"text":"“或许顺着火炮的声音去找交战的小队更靠谱。”","background":"/art/stories/zdbjbz-06.webp","left":1171,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:451:6","scriptId":451,"text":"“报告！发现旗帜了！”","background":"/art/stories/zdbjbz-06.webp","left":1171,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:451:7","scriptId":451,"text":"“在哪！？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:451:8","scriptId":451,"text":"“前面那只灵长类的战车兽手里。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:451:9","scriptId":451,"text":"“那还等什么！？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:451:10","scriptId":451,"text":"“出发！捉猴子去咯！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":32,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109003-PROLOGUE:452:2","scriptId":452,"text":"搜索持续进行中，但是毫无结果，时间一分一秒地流逝着。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":32,"section":4,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:452:3","scriptId":452,"text":"“到底还有没有旗帜啊……”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":32,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:452:4","scriptId":452,"text":"“周围还是能听到一些炮火的声音，说明还有和我们一样没有找到旗帜的人。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:452:5","scriptId":452,"text":"“旗帜散落的范围很广，或许还有机会。”","background":"/art/stories/zdbjbz-06.webp","left":1146,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:452:6","scriptId":452,"text":"“确实，我这眼神！发现旗帜了！”","background":"/art/stories/zdbjbz-06.webp","left":1146,"right":968,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:452:7","scriptId":452,"text":"“在哪！？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":968,"section":4,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:452:8","scriptId":452,"text":"“我也看到了！在前面的那只猴子战车兽手里！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1146,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:452:9","scriptId":452,"text":"“那还等什么！？冲！！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1146,"section":4,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:452:10","scriptId":452,"text":"“出发！捉猴子去咯！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":32,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109003-PROLOGUE:453:2","scriptId":453,"text":"搜索持续进行中，但是毫无结果，时间一分一秒地流逝着。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":32,"section":4,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:453:3","scriptId":453,"text":"“到底还有没有旗帜啊……”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":32,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:453:4","scriptId":453,"text":"“周围还是能听到一些炮火的声音，说明还有和我们一样没有找到旗帜的人。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:453:5","scriptId":453,"text":"“或者说我们直接去抢已经找到旗帜的小队会比较好？”","background":"/art/stories/zdbjbz-06.webp","left":1170,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:453:6","scriptId":453,"text":"“别想那么多了，我已经发现旗帜了。”","background":"/art/stories/zdbjbz-06.webp","left":1170,"right":1158,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:453:7","scriptId":453,"text":"“在哪！？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":4,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:453:8","scriptId":453,"text":"“你看9点钟方向，有只战车兽正拿着面旗帜不是吗？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:453:9","scriptId":453,"text":"“那还等什么！？全部出击。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":4,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109003-PROLOGUE:453:10","scriptId":453,"text":"“出发！捉猴子去咯！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":32,"section":4,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-EPILOGUE:10440:1","scriptId":10440,"text":"“报告，顺利获得旗帜～”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":32,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109003-EPILOGUE:10440:2","scriptId":10440,"text":"“很好，收工返程。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":32,"section":5,"shake":false}],"summaries":["终于有车了，一下子行进速度快了不少。","快到旗点了，希望还有剩余的旗帜吧。","旗帜好像已经没有了嘛……怎么办呢……"]}
