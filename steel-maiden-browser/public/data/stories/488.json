{"schemaVersion":1,"id":488,"sections":[{"id":"1907001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20654],"start":0,"count":31},{"id":"1907001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20655],"start":31,"count":49}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:1","scriptId":20654,"text":"黑漆漆的室内没有灯光，只能听到水管中偶尔滚落的水滴声。","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:2","scriptId":20654,"text":"一名少女正蹲在牢房的一角——她是安妮·沃佳诺娃","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-PROLOGUE:20654:3","scriptId":20654,"text":"（今天……是第几天了……？）","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:4","scriptId":20654,"text":"安妮的眼中没有光芒，仿佛失去了希望的灯火。","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-PROLOGUE:20654:5","scriptId":20654,"text":"（好安静……听不到那些凄惨的呻吟声……）","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-PROLOGUE:20654:6","scriptId":20654,"text":"（难道我已经死了……？）","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:7","scriptId":20654,"text":"然而一阵强烈的饥饿感向少女袭来。","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-PROLOGUE:20654:8","scriptId":20654,"text":"（唔……好饿……这感觉……看来我还没有死……）","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:9","scriptId":20654,"text":"安妮缓缓地爬到一个低洼水槽前，把嘴伸向正在滴水的龙头。","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:10","scriptId":20654,"text":"虽然水滴很慢，但仅仅是这些水也能让安妮的饥饿感得到缓解。","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:11","scriptId":20654,"text":"但周围的环境实在太安静，安妮有些疑惑。","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-PROLOGUE:20654:12","scriptId":20654,"text":"（难道发生了什么事情？）","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:13","scriptId":20654,"text":"安妮扶着墙，试图慢慢站起来，然而她身上的舞装非常沉重。","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:14","scriptId":20654,"text":"舞装已经没有弹药并且脱卸关节被锁死导致无法脱卸，在没有源奶补给的情况下，舞装反而成为了安妮的枷锁。","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-PROLOGUE:20654:15","scriptId":20654,"text":"（好重……）","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:16","scriptId":20654,"text":"安妮看向牢门——","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-PROLOGUE:20654:17","scriptId":20654,"text":"（……难道现在没有通电？）","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:18","scriptId":20654,"text":"之前曾经被电过一次，但是安妮还是鼓起勇气摸了一下牢门。","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-PROLOGUE:20654:19","scriptId":20654,"text":"（没有通电！？）","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:20","scriptId":20654,"text":"如果换作以往，这种程度的铁门可以轻松撞开，但是对于极度虚弱的安妮来说可就不那么轻松了。","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:21","scriptId":20654,"text":"安妮使出全身力气去撞铁门……但铁门纹丝不动。","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-PROLOGUE:20654:22","scriptId":20654,"text":"（不行……就算没通电这门我也打不开。）","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:23","scriptId":20654,"text":"失望感侵袭着安妮的全身，而舞装的重量也迫使她又一次跪坐在地上。","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:24","scriptId":20654,"text":"凝聚起来的一点点力量也因为这失望感而分崩离析。","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-PROLOGUE:20654:25","scriptId":20654,"text":"（可能真的要死在这里了吧，完全没有力气……连思考也要停顿了……）","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:26","scriptId":20654,"text":"疲劳和虚弱加上无法打开铁门的残酷现实，让安妮的意志力变得非常薄弱。","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-PROLOGUE:20654:27","scriptId":20654,"text":"（好累……还是先睡一会儿吧……）","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:28","scriptId":20654,"text":"安妮又一次合上了眼睛，一股强烈的睡意立刻袭来……","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:29","scriptId":20654,"text":"就这样，不知道过了多久……","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-PROLOGUE:20654:32","scriptId":20654,"text":"安妮的耳畔传来了一些动静，很快安妮就被响声给吵醒了。”","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":true},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-PROLOGUE:20654:33","scriptId":20654,"text":"“……嗯？这响声和震动是……爆炸！？”","background":"/art/stories/zdjm-034.webp","left":1135,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:1","scriptId":20655,"text":"根据救助者1号的讯息，我们继续向西南进发。","background":"/art/stories/zdbjbz-11.webp","left":1135,"right":null,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:2","scriptId":20655,"text":"奇怪的事情发生了，这一路上非但没有遇到战车兽，我们反而还发现了一间形似研究所的建筑。","background":"/art/stories/zdbjbz-11.webp","left":1135,"right":null,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:3","scriptId":20655,"text":"因为没有被战车兽袭击的危险，所以我们打算进去查看一下。","background":"/art/stories/zdbjbz-11.webp","left":1135,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:4","scriptId":20655,"text":"“佩妮和维卡留在外面把风，一旦有动静，立刻通知我们。”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:5","scriptId":20655,"text":"“好的。”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:6","scriptId":20655,"text":"“了解。”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:7","scriptId":20655,"text":"“佐伊和奈特莉，我们进到那个建筑里去调查一下。”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:8","scriptId":20655,"text":"“好嘞。”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:9","scriptId":20655,"text":"“噫……这地方看上去好阴森……”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:10","scriptId":20655,"text":"“噫什么？那你和佩妮换一下，留在外面把风。”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:11","scriptId":20655,"text":"“不不不，我没说不愿意，待在外面把风也无聊。”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:12","scriptId":20655,"text":"“那就出发了。”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:15","scriptId":20655,"text":"由佐伊和奈特莉当先锋，我们进入了那栋建筑。","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:16","scriptId":20655,"text":"“米……什么研究所？”","background":"/art/stories/zdjm-034.webp","left":4,"right":null,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:17","scriptId":20655,"text":"看到了大楼前的门牌，但很可惜大多数的字母已经脱落。","background":"/art/stories/zdjm-034.webp","left":4,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:18","scriptId":20655,"text":"“这里是研究所？从长草的程度来看，多半是废弃的吧。”","background":"/art/stories/zdjm-034.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:19","scriptId":20655,"text":"奈特莉已经走到了建筑内部，指着从地板夹缝中长出的野草说道。","background":"/art/stories/zdjm-034.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:20","scriptId":20655,"text":"“不过……救助者1号正在往里走。”","background":"/art/stories/zdjm-034.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:21","scriptId":20655,"text":"佐伊尾随着救助者1号。","background":"/art/stories/zdjm-034.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:22","scriptId":20655,"text":"“有什么其他发现吗？”","background":"/art/stories/zdjm-034.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:23","scriptId":20655,"text":"快步跟上救助者1号，它好像在找什么东西。","background":"/art/stories/zdjm-034.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":1134,"speaker":"救助者1号","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:24","scriptId":20655,"text":"“发现A-44舞装的信号，在前方五米处的正下方。”","background":"/art/stories/zdjm-034.webp","left":4,"right":1134,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:25","scriptId":20655,"text":"“什么！？”","background":"/art/stories/zdjm-034.webp","left":4,"right":1134,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:26","scriptId":20655,"text":"万万没想到救助者1号会突然报出个让人喜出望外的消息。","background":"/art/stories/zdjm-034.webp","left":4,"right":1134,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:27","scriptId":20655,"text":"“但……正下方？看来这里有地下室，快找下去的入口！”","background":"/art/stories/zdjm-034.webp","left":4,"right":1134,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:28","scriptId":20655,"text":"转了两圈之后，佐伊在一个拐角处里发现了地下室的入口。","background":"/art/stories/zdjm-034.webp","left":4,"right":1134,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:29","scriptId":20655,"text":"顺着楼梯，我们下到了地下室。","background":"/art/stories/zdjm-034.webp","left":4,"right":1134,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:30","scriptId":20655,"text":"“哇……好臭……鼻子都要臭歪了……”","background":"/art/stories/zdjm-034.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:31","scriptId":20655,"text":"虽然佐伊经常会小题大做，但这次她倒没说错。","background":"/art/stories/zdjm-034.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:32","scriptId":20655,"text":"“唔，这味道……是尸臭。”","background":"/art/stories/zdjm-034.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":579,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:33","scriptId":20655,"text":"“看！那边！”","background":"/art/stories/zdjm-034.webp","left":4,"right":579,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:34","scriptId":20655,"text":"“这……”","background":"/art/stories/zdjm-034.webp","left":4,"right":579,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:35","scriptId":20655,"text":"如果说地狱真的存在，那我现在看到的或许就是地狱的一角……","background":"/art/stories/zdjm-034.webp","left":4,"right":579,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:36","scriptId":20655,"text":"残肢、碎裂的舞装、还有一些角质化的硬壳，这些东西像垃圾一样被堆放在一起。","background":"/art/stories/zdjm-034.webp","left":4,"right":579,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:37","scriptId":20655,"text":"很明显，恶臭的源头一定是这些东西。","background":"/art/stories/zdjm-034.webp","left":4,"right":579,"section":1,"shake":false},{"kind":"dialogue","head":745,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:38","scriptId":20655,"text":"“……难道是……”","background":"/art/stories/zdjm-034.webp","left":4,"right":745,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:39","scriptId":20655,"text":"佐伊的声音有些颤抖。","background":"/art/stories/zdjm-034.webp","left":4,"right":745,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:40","scriptId":20655,"text":"“注意保持警惕，这里或许有非常不妙的东西，另外，奈特莉，去跟着救助者1号。”","background":"/art/stories/zdjm-034.webp","left":4,"right":745,"section":1,"shake":false},{"kind":"dialogue","head":579,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:41","scriptId":20655,"text":"“是。”","background":"/art/stories/zdjm-034.webp","left":4,"right":579,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:42","scriptId":20655,"text":"“这些硬壳应该是骸虫留下的，这里可能是旅行者遗弃的巢穴。”","background":"/art/stories/zdjm-034.webp","left":4,"right":579,"section":1,"shake":false},{"kind":"dialogue","head":745,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:43","scriptId":20655,"text":"“难道我们的目标也在这里面？”","background":"/art/stories/zdjm-034.webp","left":4,"right":745,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:44","scriptId":20655,"text":"换做平常我肯定会调侃佐伊，但现在的情况我没有开玩笑的心情。","background":"/art/stories/zdjm-034.webp","left":4,"right":745,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:45","scriptId":20655,"text":"“救助者1号还在往里面走，所以我们的目标应该不在这里。”","background":"/art/stories/zdjm-034.webp","left":4,"right":745,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:48","scriptId":20655,"text":"突然爆炸声传来，","background":"/art/stories/zdjm-034.webp","left":4,"right":745,"section":1,"shake":true},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:49","scriptId":20655,"text":"“快！佐伊，奈特莉那边可能出问题了。”","background":"/art/stories/zdjm-034.webp","left":4,"right":745,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:51","scriptId":20655,"text":"一阵小跑，我和佐伊来到地下室的一个转角并看到了奈特莉和救助者1号。","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:52","scriptId":20655,"text":"周围挡路瓦砾已经被炸开，另外一处像禁闭室一样的门也被炸开。","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":579,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1907001-EPILOGUE:20655:53","scriptId":20655,"text":"“那个……救助者它擅自就开火了，不过我们的目标找到了。”","background":"/art/stories/zdjm-034.webp","left":null,"right":579,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1907001-EPILOGUE:20655:54","scriptId":20655,"text":"奈特莉的怀中抱着一名虚弱的钢舞姬——是失踪者安妮·沃佳诺娃。","background":"/art/stories/zdjm-034.webp","left":null,"right":579,"section":1,"shake":false}],"summaries":[]}
