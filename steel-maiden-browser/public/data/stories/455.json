{"schemaVersion":1,"id":455,"sections":[{"id":"1814001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20585],"start":0,"count":29},{"id":"1814001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20586],"start":29,"count":35}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1814001-PROLOGUE:20585:1","scriptId":20585,"text":"特别空勤队基地——","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:2","scriptId":20585,"text":"“欢迎回来，任务完成的如何？”","background":"/art/stories/zjm-132.webp","left":1111,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1125,"speaker":"娜奥米·兰开斯特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:3","scriptId":20585,"text":"“很顺利，但我们有听到一些不好的传闻。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1125,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:4","scriptId":20585,"text":"“什么传闻？”","background":"/art/stories/zjm-132.webp","left":1111,"right":1125,"section":0,"shake":false},{"kind":"dialogue","head":1125,"speaker":"娜奥米·兰开斯特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:5","scriptId":20585,"text":"“那个……特勤局是不是要垮台了？”","background":"/art/stories/zjm-132.webp","left":1111,"right":1125,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:6","scriptId":20585,"text":"“嗯！？你们从哪儿听来的？”","background":"/art/stories/zjm-132.webp","left":1111,"right":1125,"section":0,"shake":false},{"kind":"dialogue","head":1116,"speaker":"玛加丽塔·杰米多娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:7","scriptId":20585,"text":"“特勤局最近的支持率越来越差了？我们去救援的时候，非但不感谢我们，还埋怨我们去得太慢。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1116,"section":0,"shake":false},{"kind":"dialogue","head":1122,"speaker":"斯盖拉·波特曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:8","scriptId":20585,"text":"“是啊，特别是知道我们是特勤局派来的时候，那眼神就像在看仇人一样……”","background":"/art/stories/zjm-132.webp","left":1122,"right":1116,"section":0,"shake":false},{"kind":"dialogue","head":1125,"speaker":"娜奥米·兰开斯特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:9","scriptId":20585,"text":"“那个……刚才的话，您就当是我们的一些猜测吧……其实也没什么根据。”","background":"/art/stories/zjm-132.webp","left":1122,"right":1125,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:10","scriptId":20585,"text":"“……”","background":"/art/stories/zjm-132.webp","left":1111,"right":1125,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:11","scriptId":20585,"text":"“这种事情虽然在规定上最好不透露给你们，但为了彼此的信任，我觉得还是要告诉你们。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1125,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1814001-PROLOGUE:20585:12","scriptId":20585,"text":"亚当斯理了理衣领。","background":"/art/stories/zjm-132.webp","left":1111,"right":1125,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:13","scriptId":20585,"text":"“你们听到和看到的问题确实都存在，现在特勤局的支持率确实很低。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1125,"section":0,"shake":false},{"kind":"dialogue","head":1125,"speaker":"娜奥米·兰开斯特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:14","scriptId":20585,"text":"“诶！？真的是这样吗？”","background":"/art/stories/zjm-132.webp","left":1111,"right":1125,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:15","scriptId":20585,"text":"“特勤局因为隐瞒旅行者情报的问题被曝光，导致各国的信任率直线下降。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1125,"section":0,"shake":false},{"kind":"dialogue","head":1116,"speaker":"玛加丽塔·杰米多娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:16","scriptId":20585,"text":"“啊？那要垮台的问题也是真的？”","background":"/art/stories/zjm-132.webp","left":1111,"right":1116,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:17","scriptId":20585,"text":"“那倒还没，拨给我们的预算款非常充足。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1116,"section":0,"shake":false},{"kind":"dialogue","head":1116,"speaker":"玛加丽塔·杰米多娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:18","scriptId":20585,"text":"“您确定？或许特勤局是没钱了才让我们住这种破基地的吧……”","background":"/art/stories/zjm-132.webp","left":1111,"right":1116,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:19","scriptId":20585,"text":"“你怎么还拽着这事，当初来的时候一直抱怨到现在。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1116,"section":0,"shake":false},{"kind":"dialogue","head":1116,"speaker":"玛加丽塔·杰米多娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:20","scriptId":20585,"text":"“哼，让我从原本的高级军营住到这种破烂基地和下放有什么区别。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1116,"section":0,"shake":false},{"kind":"dialogue","head":1122,"speaker":"斯盖拉·波特曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:21","scriptId":20585,"text":"“是啊，又不是特别危险的前线却要我们每天吃罐头，伙食太差啦。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1122,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:22","scriptId":20585,"text":"“这些问题之后会改善的，现在先忍忍吧。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1122,"section":0,"shake":false},{"kind":"dialogue","head":1116,"speaker":"玛加丽塔·杰米多娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:23","scriptId":20585,"text":"“之后？你说了多少次之后了？”","background":"/art/stories/zjm-132.webp","left":1111,"right":1116,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1814001-PROLOGUE:20585:24","scriptId":20585,"text":"亚当斯被玛加丽塔说得都有些头大了。","background":"/art/stories/zjm-132.webp","left":1111,"right":1116,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:25","scriptId":20585,"text":"“好吧，一个月后吧，我让建筑队优先改造一下厨房，毕竟华尔兹中队也来了，确实需要改善下。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1116,"section":0,"shake":false},{"kind":"dialogue","head":1122,"speaker":"斯盖拉·波特曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:26","scriptId":20585,"text":"“终于可以不用吃罐头了。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1122,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:27","scriptId":20585,"text":"“这样总可以了吧，话题扯远了。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1122,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-PROLOGUE:20585:28","scriptId":20585,"text":"“总之特勤局垮台问题你们就别瞎传了，会惹麻烦的。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1122,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1814001-PROLOGUE:20585:29","scriptId":20585,"text":"这时外面传来了一阵炮弹声。","background":"/art/stories/zjm-132.webp","left":1111,"right":1122,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:1","scriptId":20586,"text":"“不错嘛，连续作战一点问题都没有的感觉。”","background":"/art/stories/zjm-132.webp","left":1111,"right":1122,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1814001-EPILOGUE:20586:2","scriptId":20586,"text":"虽然亚当斯笑容满面，但大家都知道这次任务结束的并不完美。","background":"/art/stories/zjm-132.webp","left":1111,"right":1122,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:3","scriptId":20586,"text":"“没想到在回来的路上会遇到飞行战车兽，被打了个措手不及。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1814001-EPILOGUE:20586:4","scriptId":20586,"text":"因为没有习惯对空中目标的侦察，所以这次的失态也算是敲响了警钟。","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1814001-EPILOGUE:20586:5","scriptId":20586,"text":"所幸雀鹰小队支援得及时，没有人员伤亡。","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:6","scriptId":20586,"text":"“不过现在确实要习惯敌人的空中力量了，光是地面作战已经不够了。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:7","scriptId":20586,"text":"“恩，下次会注意的。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:8","scriptId":20586,"text":"“倒也没什么，你的小队对空能力好像并不强。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:9","scriptId":20586,"text":"“是的，临时培训了一下防空技巧，但还远远不够。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:10","scriptId":20586,"text":"“缺乏实战经验的话，多练练就好了。飞行战车兽的袭击频率与日俱增，不练的话就没法生存了。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:11","scriptId":20586,"text":"“明白了。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:12","scriptId":20586,"text":"“对了，最近想扩充一下这个基地的设施，之后有些事情要你帮忙处理一下。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:13","scriptId":20586,"text":"“好的，尽管吩咐。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:14","scriptId":20586,"text":"“这次作战剿灭了一个战车兽的据点，同时还带回了一些物资，可能是以前战车兽抢去的。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:15","scriptId":20586,"text":"“是钢材吗？”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:16","scriptId":20586,"text":"“恩，不止是钢材还有源铁矿之类的东西。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:17","scriptId":20586,"text":"“很不错啊，基地的补强正需要这些，这年头物资永远是匮乏的。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:18","scriptId":20586,"text":"“不过其中有一些源铁好像有点不太一样，我想向死水的波西娅博士那边提供一些样品，让她研究一下。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1814001-EPILOGUE:20586:19","scriptId":20586,"text":"听到波西娅的名字时，亚当斯皱了下眉头。","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:20","scriptId":20586,"text":"“要给波西娅吗？虽然我承认她研究东西是有一套，但也是因为她，我们特别空勤队才落到现在的田地……”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:21","scriptId":20586,"text":"“恩？第一次听说呢，波西娅又干了些什么？”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:22","scriptId":20586,"text":"“又？看来你是波西娅的熟人，波西娅因为抢先研发出了航空钢舞姬，让我们这边损失巨大啊……”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:23","scriptId":20586,"text":"“哦，是这样啊。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:24","scriptId":20586,"text":"“不但提供了飞行舞装和测试人员，连航空舞装都完成了好几套，要知道那时候我们研究室还在为如何拼接飞行装甲而头疼。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:25","scriptId":20586,"text":"（以波西娅为研究的竞争对手是多么恐怖的事情……有些同情亚当斯他们了。）","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:26","scriptId":20586,"text":"“结果呢？”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:27","scriptId":20586,"text":"“结果我们这边的研究室解散，特勤局给波西娅支付了一笔不菲的开发费买下了空钢的使用权和技术核心。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:28","scriptId":20586,"text":"“那个开发部门还是我亲自组建的，结果落得要亲自解散他们……”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:29","scriptId":20586,"text":"“呃……竞争真是残酷。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:30","scriptId":20586,"text":"“算了，都是过去的事情了。提供给源铁样本给波西娅也可以，但功劳一定要让她记给你。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:31","scriptId":20586,"text":"“不记给特别空勤队？”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:32","scriptId":20586,"text":"“毕竟是你找到的，而且现在你身份特殊，目前也算是特别空勤队的一员，在这点不变的前提下这次的功劳就是你留在空勤队的业绩。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:33","scriptId":20586,"text":"“好吧，我努力下，毕竟波西娅这人我到现在都还不太会应付。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1814001-EPILOGUE:20586:34","scriptId":20586,"text":"“呵呵，感同身受。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1814001-EPILOGUE:20586:35","scriptId":20586,"text":"亚当斯苦笑着点了点头。","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":1,"shake":false}],"summaries":[]}
