{"schemaVersion":1,"id":-40127,"sections":[{"id":"script-20127","name":"原始脚本 20127","scripts":[20127],"start":0,"count":37}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:0","scriptId":20127,"text":"虽然下午发生了不少战车兽，但是因为有伊诺娜的正确指挥，都被轻松驱逐了。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:1","scriptId":20127,"text":"伊诺娜把情况都报告给了我们，鉴于没有发现其他软泥的情况，于是我们稍微安心了一点。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:2","scriptId":20127,"text":"第二天算是相安无事，经过一夜的休整，我的精神状态也很快恢复了。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:3","scriptId":20127,"text":"第三天——护卫任务的最后一天。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:5","scriptId":20127,"text":"“恩，希望今天没什么突发事件。”","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:6","scriptId":20127,"text":"“长官，你这么说我总觉得今天应该会发生些什么呢～”","background":"/art/stories/zjm-101.webp","left":4,"right":582,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:7","scriptId":20127,"text":"“呃……”","background":"/art/stories/zjm-101.webp","left":4,"right":582,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:8","scriptId":20127,"text":"伊诺娜小队早早就到达了指定的拍摄地点，因为不是在海边，场地又相对开阔，她们负责场内警卫。","background":"/art/stories/zjm-101.webp","left":4,"right":582,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:9","scriptId":20127,"text":"而我们则在比较远处进行侦查和警卫，如果发生意外情况可以优先进行应对，这样好让场内的人有更充足的准备时间。","background":"/art/stories/zjm-101.webp","left":4,"right":582,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:10","scriptId":20127,"text":"“恩，今天是专辑单曲的外景吗～真是不错呢～”","background":"/art/stories/zjm-101.webp","left":4,"right":582,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:11","scriptId":20127,"text":"看着在场内一边跳舞一边歌唱的塞西尔她们，我不由得说道。","background":"/art/stories/zjm-101.webp","left":4,"right":582,"section":0,"shake":false},{"kind":"dialogue","head":748,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:12","scriptId":20127,"text":"“长官很喜欢看塞西尔她们排演呢～”","background":"/art/stories/zjm-101.webp","left":4,"right":748,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:13","scriptId":20127,"text":"是佐伊……原以为她会说我几句，结果到头来她也是来偷懒的……","background":"/art/stories/zjm-101.webp","left":4,"right":748,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:14","scriptId":20127,"text":"“是啊，我挺喜欢这种气氛，好让我们暂时忘记自己的佣兵身份。”","background":"/art/stories/zjm-101.webp","left":4,"right":748,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:15","scriptId":20127,"text":"“我还以为长官是那种从来不看文宣的人呢～没想到你也挺关注的嘛～”","background":"/art/stories/zjm-101.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:16","scriptId":20127,"text":"“还好，也就一般人的程度吧。”","background":"/art/stories/zjm-101.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:17","scriptId":20127,"text":"“呜呜呜呜——”","background":"/art/stories/zjm-101.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:18","scriptId":20127,"text":"突然，听到了度假村方向传来了警笛声。","background":"/art/stories/zjm-101.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:19","scriptId":20127,"text":"“什么情况？度假村那边出现状况了！？”","background":"/art/stories/zjm-101.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:20","scriptId":20127,"text":"“度假村那边发现大量的战车兽！”","background":"/art/stories/zjm-101.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:21","scriptId":20127,"text":"佩妮所处的岗哨方位离度假村方向比较近，她带来了最新的情报。","background":"/art/stories/zjm-101.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:22","scriptId":20127,"text":"“真不是时候！这样的话……就只能拜托伊诺娜她们进行守卫，而我们有必要去支援度假村的方向了。”","background":"/art/stories/zjm-101.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:23","scriptId":20127,"text":"“佐伊你去通知一下伊诺娜她们，我召集奈特莉她们先去度假村那边了。”","background":"/art/stories/zjm-101.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":749,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:24","scriptId":20127,"text":"“是！”","background":"/art/stories/zjm-101.webp","left":4,"right":749,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:25","scriptId":20127,"text":"我们立即展开了行动。","background":"/art/stories/zjm-101.webp","left":4,"right":749,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:27","scriptId":20127,"text":"度假村方向发现大量战车兽从丛林中奔涌而出……","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:28","scriptId":20127,"text":"加上度假村原本的守卫，我们勉强可以抵挡这些战车兽，但是如果这些战车兽数量再增加下去，恐怖有点不妙了。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:29","scriptId":20127,"text":"这时候我又想到了波西娅，于是我掏出了通信器——","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:30","scriptId":20127,"text":"“波西娅，听到了没！？波西娅？这里是度假村，发生状况了！”","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:31","scriptId":20127,"text":"通信器发出了一些“呲呲”的杂音，随后从通信器的另一头传来了我从来没听过的声音……","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":811,"speaker":"妮科尔·奥尔巴赫","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:32","scriptId":20127,"text":"“那个……这里不是波西娅……不过这个通信器是波西娅交给我的……说是让我遇到意外的时候进行联系。”","background":"/art/stories/zjm-101.webp","left":4,"right":811,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:33","scriptId":20127,"text":"“我去……波西娅这家伙应该是把通信器弄错了吧！？”","background":"/art/stories/zjm-101.webp","left":4,"right":811,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:34","scriptId":20127,"text":"“这下可麻烦了……”","background":"/art/stories/zjm-101.webp","left":4,"right":811,"section":0,"shake":false},{"kind":"dialogue","head":811,"speaker":"妮科尔·奥尔巴赫","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:35","scriptId":20127,"text":"“那个……我是妮科尔·奥尔巴赫，也是一名钢舞姬，可以立刻对你们的方向进行支援。”","background":"/art/stories/zjm-101.webp","left":4,"right":811,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:36","scriptId":20127,"text":"“哦！那真是太好了！妮科尔，请尽快赶来这边的度假村……”","background":"/art/stories/zjm-101.webp","left":4,"right":811,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20127:20127:37","scriptId":20127,"text":"话音刚落，就听到了远处传来了飞机引擎的轰鸣声……","background":"/art/stories/zjm-101.webp","left":4,"right":811,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20127:20127:38","scriptId":20127,"text":"“什……么！？刚才那个是……钢舞姬？？是从空中来的！？”","background":"/art/stories/zjm-101.webp","left":4,"right":811,"section":0,"shake":false}],"summaries":[]}
