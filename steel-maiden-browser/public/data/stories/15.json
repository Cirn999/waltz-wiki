{"schemaVersion":1,"id":15,"sections":[{"id":"109004-PROLOGUE","name":"第 1 战 · 战前","scripts":[460],"start":0,"count":5},{"id":"109004-EPILOGUE","name":"第 1 战 · 战后","scripts":[10450],"start":5,"count":2},{"id":"109005-PROLOGUE","name":"第 2 战 · 战前","scripts":[470,471,472,473],"start":7,"count":23},{"id":"109005-EPILOGUE","name":"第 2 战 · 战后","scripts":[10460],"start":30,"count":2},{"id":"109006-PROLOGUE","name":"第 3 战 · 战前","scripts":[480],"start":32,"count":5},{"id":"109006-EPILOGUE","name":"第 3 战 · 战后","scripts":[10470],"start":37,"count":6}],"frames":[{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109004-PROLOGUE:460:2","scriptId":460,"text":"“哼～～哼～～哼～～”","background":"/art/stories/zdbjbz-06.webp","left":39,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109004-PROLOGUE:460:3","scriptId":460,"text":"“心情太好了吧，战斗其实现在才刚刚开始吧。”","background":"/art/stories/zdbjbz-06.webp","left":39,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109004-PROLOGUE:460:4","scriptId":460,"text":"“为什么啊？不是已经顺利拿到旗帜了吗？”","background":"/art/stories/zdbjbz-06.webp","left":41,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109004-PROLOGUE:460:5","scriptId":460,"text":"“额，说你是吊车尾看来还真是一点都没错……”","background":"/art/stories/zdbjbz-06.webp","left":41,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109004-PROLOGUE:460:6","scriptId":460,"text":"“我们的任务是找到旗帜并护送回学院，现在才一半呢。”","background":"/art/stories/zdbjbz-06.webp","left":41,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109004-EPILOGUE:10450:1","scriptId":10450,"text":"从小路行驶上了来时的山路，速度一下子又提升了不少。","background":"/art/stories/zdbjbz-06.webp","left":41,"right":3,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109004-EPILOGUE:10450:2","scriptId":10450,"text":"由于之前清理过路线，所以不用担心有战车兽的骚扰，非常顺利。","background":"/art/stories/zdbjbz-06.webp","left":41,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:470:2","scriptId":470,"text":"“一路上为什么还有战车兽，总觉得有点不太对。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:470:3","scriptId":470,"text":"“不用太担心啦，我们返程的速度比别人快多了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:470:4","scriptId":470,"text":"“希望是我杞人忧天。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:470:5","scriptId":470,"text":"“前方又看见一小队战车兽。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:471:2","scriptId":471,"text":"“一路上为什么还有战车兽，总觉得有点不太对。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:471:3","scriptId":471,"text":"“不用太担心啦，我们返程的速度比别人快多了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:471:4","scriptId":471,"text":"“希望是我杞人忧天。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:471:5","scriptId":471,"text":"“前方又看见一小队战车兽。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:471:6","scriptId":471,"text":"“看看，我说的吧，不会那么顺利的。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:471:7","scriptId":471,"text":"“乌鸦嘴啊！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:472:2","scriptId":472,"text":"“一路上为什么还有战车兽，总觉得有点不太对。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:472:3","scriptId":472,"text":"“不用太担心啦，我们返程的速度比别人快多了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:472:4","scriptId":472,"text":"“希望是我杞人忧天。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:472:5","scriptId":472,"text":"“前方发现少量战车兽，把路给挡住了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1146,"section":2,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:472:6","scriptId":472,"text":"“虽然是根本不值一提的对手，但还是会拖延我们的时间。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1146,"section":2,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:472:7","scriptId":472,"text":"“那就边行进边攻击，长官可要注意别被流弹打中啊。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":968,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:472:8","scriptId":472,"text":"“只能硬着头皮上了，冲啊。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":968,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:473:2","scriptId":473,"text":"“一路上为什么还有战车兽，总觉得有点不太对。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":968,"section":2,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:473:3","scriptId":473,"text":"“不用太担心啦，我们返程的速度比别人快多了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:473:4","scriptId":473,"text":"“希望是我杞人忧天。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:473:5","scriptId":473,"text":"“少量战车兽在前方出现。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1170,"section":2,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:473:6","scriptId":473,"text":"“这点数量我一个人就够了，你们先走。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109005-PROLOGUE:473:7","scriptId":473,"text":"“那就拜托了！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109005-EPILOGUE:10460:1","scriptId":10460,"text":"“为什么还有战车兽，不是应该已经清理干净了嘛……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":3,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109005-EPILOGUE:10460:2","scriptId":10460,"text":"“只是偶然而已，小问题啦～”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109006-PROLOGUE:480:2","scriptId":480,"text":"依仗着吉普车的速度，很快便走完了一半的回程路线。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":4,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109006-PROLOGUE:480:3","scriptId":480,"text":"“轻松轻松～还有不远就要到啦～”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":31,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109006-PROLOGUE:480:4","scriptId":480,"text":"“还是不要太放松比较好，虽然-----”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109006-PROLOGUE:480:7","scriptId":480,"text":"话音未落，一枚榴弹在吉普车的左前方炸了开来。","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":4,"shake":true},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109006-PROLOGUE:480:8","scriptId":480,"text":"“我们被攻击了！？”","background":"/art/stories/zdbjbz-06.webp","left":41,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109006-EPILOGUE:10470:1","scriptId":10470,"text":"虽然很快击退了冷不丁冒出来的战车兽，但是吉普车完全报废了。","background":"/art/stories/zdbjbz-06.webp","left":41,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109006-EPILOGUE:10470:2","scriptId":10470,"text":"“……这下完了，剩下的路程要徒步走了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109006-EPILOGUE:10470:3","scriptId":10470,"text":"“突发事件总是会有的嘛，反正也没多少路了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":31,"section":5,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109006-EPILOGUE:10470:4","scriptId":10470,"text":"“就和之前一样呗，慢慢走啦。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":39,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109006-EPILOGUE:10470:5","scriptId":10470,"text":"（明显的幸灾乐祸……双脚步行和舞装辅助行走能一样吗……）","background":"/art/stories/zdbjbz-06.webp","left":3,"right":39,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109006-EPILOGUE:10470:6","scriptId":10470,"text":"“只要不再发生别的意外就好了……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":39,"section":5,"shake":false}],"summaries":["顺利获得旗帜，返程。","希望能安全返回吧，挑选有战车兽在的路线可能会更安全？","最糟糕的情况，速战速决吧。"]}
