{"schemaVersion":1,"id":41,"sections":[{"id":"115010-PROLOGUE","name":"第 1 战 · 战前","scripts":[1360],"start":0,"count":11},{"id":"115010-EPILOGUE","name":"第 1 战 · 战后","scripts":[11350],"start":11,"count":8},{"id":"115011-PROLOGUE","name":"第 2 战 · 战前","scripts":[1370],"start":19,"count":13},{"id":"115011-EPILOGUE","name":"第 2 战 · 战后","scripts":[11360],"start":32,"count":9},{"id":"115012-PROLOGUE","name":"第 3 战 · 战前","scripts":[1380],"start":41,"count":14},{"id":"115012-EPILOGUE","name":"第 3 战 · 战后","scripts":[11370],"start":55,"count":13},{"id":"115013-PROLOGUE","name":"第 4 战 · 战前","scripts":[1390],"start":68,"count":11},{"id":"115013-EPILOGUE","name":"第 4 战 · 战后","scripts":[11380],"start":79,"count":14},{"id":"115014-PROLOGUE","name":"第 5 战 · 战前","scripts":[1400],"start":93,"count":16},{"id":"115014-EPILOGUE","name":"第 5 战 · 战后","scripts":[11390],"start":109,"count":12}],"frames":[{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115010-PROLOGUE:1360:2","scriptId":1360,"text":"“恩……正巧你代过几节课，也对学生比较了解……”","background":"/art/stories/zjm-047.webp","left":211,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115010-PROLOGUE:1360:3","scriptId":1360,"text":"“这次任务比较麻烦，而且人手不足，所以你就在学生里面挑几个不错的一起执行这个任务吧。”","background":"/art/stories/zjm-047.webp","left":211,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115010-PROLOGUE:1360:4","scriptId":1360,"text":"“诶！？带学生？是不是有点危险啊？”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115010-PROLOGUE:1360:5","scriptId":1360,"text":"“没有办法，可能我们的位置已经被敌人察觉，所以我们这边需要主动出击，探个究竟。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115010-PROLOGUE:1360:6","scriptId":1360,"text":"“好吧……反正都是既定事实了，我要以下几名学生一起行动……”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115010-PROLOGUE:1360:7","scriptId":1360,"text":"我翻了下点名册，在需要的钢舞姬上面打了几个勾，递给教官。","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115010-PROLOGUE:1360:8","scriptId":1360,"text":"“好的，就这么定了。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115010-PROLOGUE:1360:9","scriptId":1360,"text":"“不错么，这几个都是很有潜力的学生，你倒是挺有眼光啊～”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115010-PROLOGUE:1360:10","scriptId":1360,"text":"“哪里哪里，不过是随手挑挑罢了。”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115010-PROLOGUE:1360:11","scriptId":1360,"text":"“哦，对了，佐伊也带上，让她打杂那么久，也该干点正事了。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115010-PROLOGUE:1360:12","scriptId":1360,"text":"“恩，您不说，我也会带上她的。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115010-EPILOGUE:11350:1","scriptId":11350,"text":"根据教官的指示，我把几名学生和佐伊都叫到了会议室。","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":175,"speaker":"伊诺·赞佩里尼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115010-EPILOGUE:11350:2","scriptId":11350,"text":"“伊诺·赞佩里尼，前来报道！”","background":"/art/stories/zjm-047.webp","left":175,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":127,"speaker":"达利波娃·戈沃罗夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115010-EPILOGUE:11350:3","scriptId":11350,"text":"“达利波娃·戈沃罗夫娜，请大家多多关照。”","background":"/art/stories/zjm-047.webp","left":175,"right":127,"section":1,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115010-EPILOGUE:11350:4","scriptId":11350,"text":"“芙琳·勒布，时刻准备完成任务！”","background":"/art/stories/zjm-047.webp","left":115,"right":127,"section":1,"shake":false},{"kind":"dialogue","head":499,"speaker":"米佳·叶戈罗夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115010-EPILOGUE:11350:5","scriptId":11350,"text":"“米佳·叶戈罗夫娜，随时可以出发！”","background":"/art/stories/zjm-047.webp","left":115,"right":499,"section":1,"shake":false},{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115010-EPILOGUE:11350:6","scriptId":11350,"text":"“佐伊·谢尔曼。”","background":"/art/stories/zjm-047.webp","left":38,"right":499,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115010-EPILOGUE:11350:7","scriptId":11350,"text":"“嗯嗯，大家都互相认识一下，这次任务需要大家齐心协力，共通完成，请认真听我指挥。”","background":"/art/stories/zjm-047.webp","left":38,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115010-EPILOGUE:11350:8","scriptId":11350,"text":"（佐伊那家伙，几天不见好像有点没精打采的么……）","background":"/art/stories/zjm-047.webp","left":38,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115011-PROLOGUE:1370:2","scriptId":1370,"text":"“这次的任务比较奇怪，听教官说是前往特定的坐标位置周围做一下侦察，具体侦察什么并没有明确指示。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115011-PROLOGUE:1370:3","scriptId":1370,"text":"“那就是说，到了坐标位置开始随机应变，发现奇怪的东西就记录下来？”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":115,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115011-PROLOGUE:1370:4","scriptId":1370,"text":"“正是如此，芙琳真是聪明。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":115,"section":2,"shake":false},{"kind":"dialogue","head":123,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115011-PROLOGUE:1370:5","scriptId":1370,"text":"“没什么啦，已经习惯配合长官的波长了～”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":123,"section":2,"shake":false},{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115011-PROLOGUE:1370:6","scriptId":1370,"text":"“……”","background":"/art/stories/zdbjbz-04.webp","left":38,"right":123,"section":2,"shake":false},{"kind":"dialogue","head":175,"speaker":"伊诺·赞佩里尼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115011-PROLOGUE:1370:7","scriptId":1370,"text":"“恩，那么我的工作就是负责后排的火力援护是吧。”","background":"/art/stories/zdbjbz-04.webp","left":38,"right":175,"section":2,"shake":false},{"kind":"dialogue","head":135,"speaker":"达利波娃·戈沃罗夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115011-PROLOGUE:1370:8","scriptId":1370,"text":"“我和芙琳当然都是负责长官的侧近咯，反正之前就是一个小组的，合作愉快～”","background":"/art/stories/zdbjbz-04.webp","left":135,"right":175,"section":2,"shake":false},{"kind":"dialogue","head":123,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115011-PROLOGUE:1370:9","scriptId":1370,"text":"“没问题～”","background":"/art/stories/zdbjbz-04.webp","left":135,"right":123,"section":2,"shake":false},{"kind":"dialogue","head":499,"speaker":"米佳·叶戈罗夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115011-PROLOGUE:1370:10","scriptId":1370,"text":"“侦察工作就交给我吧”","background":"/art/stories/zdbjbz-04.webp","left":499,"right":123,"section":2,"shake":false},{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115011-PROLOGUE:1370:11","scriptId":1370,"text":"“我就负责诱敌了……”","background":"/art/stories/zdbjbz-04.webp","left":499,"right":38,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115011-PROLOGUE:1370:12","scriptId":1370,"text":"（诶？佐伊竟然那么清楚自己的定位……太阳从西边出来了……）","background":"/art/stories/zdbjbz-04.webp","left":3,"right":38,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115011-PROLOGUE:1370:13","scriptId":1370,"text":"“恩，就是这样，那么我们出发吧，这次主要是侦察，避开不必要的战斗。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":38,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115011-PROLOGUE:1370:14","scriptId":1370,"text":"分工完毕，我们这个临时小队就开始执行本次的侦察任务了。","background":"/art/stories/zdbjbz-04.webp","left":3,"right":38,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115011-EPILOGUE:11360:1","scriptId":11360,"text":"虽然是第一次配合，不过确实都是优秀的学员，并没有很明显的失误。","background":"/art/stories/zdbjbz-04.webp","left":3,"right":38,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115011-EPILOGUE:11360:2","scriptId":11360,"text":"（大家都表现的不错，比我预计的要好很多啊，佐伊工作也做的十分漂亮啊，难得。）","background":"/art/stories/zdbjbz-04.webp","left":3,"right":38,"section":3,"shake":false},{"kind":"dialogue","head":499,"speaker":"米佳·叶戈罗夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115011-EPILOGUE:11360:3","scriptId":11360,"text":"“前方已经排除战车兽，但是右方还有一批察觉到了这里的动静，建议从左方绕行。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":499,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115011-EPILOGUE:11360:4","scriptId":11360,"text":"“恩，就这么办。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":499,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115011-EPILOGUE:11360:5","scriptId":11360,"text":"“对了，米佳，注意不要太靠右侧，那边没有可以隐蔽的岩体。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":499,"section":3,"shake":false},{"kind":"dialogue","head":499,"speaker":"米佳·叶戈罗夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115011-EPILOGUE:11360:6","scriptId":11360,"text":"“知道了，教官～”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":499,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115011-EPILOGUE:11360:7","scriptId":11360,"text":"“不要叫我教官了，听着怪别扭的，毕竟现在不是代课了，叫我长官就行了。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":499,"section":3,"shake":false},{"kind":"dialogue","head":507,"speaker":"米佳·叶戈罗夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115011-EPILOGUE:11360:8","scriptId":11360,"text":"“是，长官～”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":507,"section":3,"shake":false},{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115011-EPILOGUE:11360:9","scriptId":11360,"text":"（哼，一个个都叫的那么亲密……才几天功夫，就已经完全和她们打成一片了，也不怎么搭理我这个老队员了啊……）","background":"/art/stories/zdbjbz-04.webp","left":38,"right":507,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115012-PROLOGUE:1380:2","scriptId":1380,"text":"从教官给出的地图坐标来看，比想象中的位置要远不少，主要是隔着一片荒漠，看上去一望无际……","background":"/art/stories/zdbjbz-04.webp","left":38,"right":507,"section":4,"shake":false},{"kind":"dialogue","head":499,"speaker":"米佳·叶戈罗夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115012-PROLOGUE:1380:3","scriptId":1380,"text":"“这附近的沙丘有点多，我去高处侦察一下。”","background":"/art/stories/zdbjbz-04.webp","left":499,"right":507,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115012-PROLOGUE:1380:4","scriptId":1380,"text":"“好的，那我们就先在这等一下，你自己当心一点。”","background":"/art/stories/zdbjbz-04.webp","left":499,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":499,"speaker":"米佳·叶戈罗夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115012-PROLOGUE:1380:5","scriptId":1380,"text":"“恩～”","background":"/art/stories/zdbjbz-04.webp","left":499,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":135,"speaker":"达利波娃·戈沃罗夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115012-PROLOGUE:1380:6","scriptId":1380,"text":"“闲着也是闲着～佐伊前辈和长官是老组合了吧，有没有长官的趣闻啊，说来听听～”","background":"/art/stories/zdbjbz-04.webp","left":499,"right":135,"section":4,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115012-PROLOGUE:1380:7","scriptId":1380,"text":"“前辈……前辈！？恩，包在我身上，长官睡觉怎么流口水我都知道的一清二楚！！”","background":"/art/stories/zdbjbz-04.webp","left":37,"right":135,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115012-PROLOGUE:1380:8","scriptId":1380,"text":"“你们在说什么呢……”","background":"/art/stories/zdbjbz-04.webp","left":37,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115012-PROLOGUE:1380:9","scriptId":1380,"text":"“哼，没什么，和长官无关！”","background":"/art/stories/zdbjbz-04.webp","left":38,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115012-PROLOGUE:1380:10","scriptId":1380,"text":"“诶？我又说错什么话了？”","background":"/art/stories/zdbjbz-04.webp","left":38,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":179,"speaker":"伊诺·赞佩里尼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115012-PROLOGUE:1380:11","scriptId":1380,"text":"“长官在代课时的样子还是挺帅的呢。”","background":"/art/stories/zdbjbz-04.webp","left":179,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115012-PROLOGUE:1380:12","scriptId":1380,"text":"“哦哦！我这帅气的样子果然深入人心了吗～”","background":"/art/stories/zdbjbz-04.webp","left":179,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115012-PROLOGUE:1380:13","scriptId":1380,"text":"“要是你们看到他跑马拉松的时候就不会那么说了……”","background":"/art/stories/zdbjbz-04.webp","left":40,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115012-PROLOGUE:1380:14","scriptId":1380,"text":"正当我们开始你一句我一句聊天的时候，听到了米佳的声音。","background":"/art/stories/zdbjbz-04.webp","left":40,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":500,"speaker":"米佳·叶戈罗夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115012-PROLOGUE:1380:15","scriptId":1380,"text":"“前方有状况！大家注意临战态势！”","background":"/art/stories/zdbjbz-04.webp","left":500,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115012-EPILOGUE:11370:1","scriptId":11370,"text":"虽然有米佳的及时提醒，我们顺利的干掉了不知道从哪冒出来的一批战车兽。","background":"/art/stories/zdbjbz-04.webp","left":500,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115012-EPILOGUE:11370:2","scriptId":11370,"text":"但是因为对面先手的攻击，我们这边还是有点损伤。","background":"/art/stories/zdbjbz-04.webp","left":500,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115012-EPILOGUE:11370:3","scriptId":11370,"text":"“大家确认下损伤情况！”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115012-EPILOGUE:11370:4","scriptId":11370,"text":"“还好吧……佐伊，你的右脚刚才被击中了？”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115012-EPILOGUE:11370:5","scriptId":11370,"text":"“这点小伤不要紧的。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115012-EPILOGUE:11370:6","scriptId":11370,"text":"“还是紧急修理一下吧，让我看看。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115012-EPILOGUE:11370:7","scriptId":11370,"text":"我蹲下身看了看佐伊的右脚，炮弹是击穿了右脚上的装甲，不过好在并没有完全穿透，只是造成了一些装甲变形。","background":"/art/stories/zdbjbz-04.webp","left":3,"right":36,"section":5,"shake":false},{"kind":"dialogue","head":35,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115012-EPILOGUE:11370:8","scriptId":11370,"text":"“啊……别一直抓着我的脚不放啦！”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":35,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115012-EPILOGUE:11370:9","scriptId":11370,"text":"“恩，没事就好。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":35,"section":5,"shake":false},{"kind":"dialogue","head":35,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115012-EPILOGUE:11370:10","scriptId":11370,"text":"“哼，长官没事就是喜欢在这种地方瞎操心！”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":35,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115012-EPILOGUE:11370:11","scriptId":11370,"text":"“唉？确认队员的战斗状态不是指挥应该做的么。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":35,"section":5,"shake":false},{"kind":"dialogue","head":33,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115012-EPILOGUE:11370:12","scriptId":11370,"text":"（♪～♪～）","background":"/art/stories/zdbjbz-04.webp","left":3,"right":33,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115012-EPILOGUE:11370:13","scriptId":11370,"text":"（嗯？佐伊这家伙受了伤怎么心情还那么好……）","background":"/art/stories/zdbjbz-04.webp","left":3,"right":33,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115013-PROLOGUE:1390:2","scriptId":1390,"text":"前方的战车兽越来越多，已经很难通过绕行来回避战斗了，总觉得事情有点蹊跷。","background":"/art/stories/zdbjbz-04.webp","left":3,"right":33,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115013-PROLOGUE:1390:3","scriptId":1390,"text":"“注意弹药的消耗，特别是伊诺，榴弹尽量节约点用，不然遇到大批的战车兽时没范围性杀伤武器就麻烦了。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":33,"section":6,"shake":false},{"kind":"dialogue","head":175,"speaker":"伊诺·赞佩里尼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115013-PROLOGUE:1390:4","scriptId":1390,"text":"“好的，我会注意的。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":175,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115013-PROLOGUE:1390:5","scriptId":1390,"text":"“另外，米佳从最前线往后退100米，现在周围战车兽群的密度已经不能让我们在那么广阔的范围侦察了。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":175,"section":6,"shake":false},{"kind":"dialogue","head":499,"speaker":"米佳·叶戈罗夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115013-PROLOGUE:1390:6","scriptId":1390,"text":"“恩，我也感觉到了，现在这个位置很容易暴露……”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":499,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115013-PROLOGUE:1390:7","scriptId":1390,"text":"“佐伊尽量不要离开米佳太远，一旦米佳被发现的话，就马上进行火力铺设。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":499,"section":6,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115013-PROLOGUE:1390:8","scriptId":1390,"text":"“没问题！”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":31,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115013-PROLOGUE:1390:9","scriptId":1390,"text":"“芙琳和达利波娃随机应变，不要离开我这个指挥塔太远就行了。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":31,"section":6,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115013-PROLOGUE:1390:10","scriptId":1390,"text":"刚分配完任务，就看到对面沙丘上有战车兽探出头来张望。","background":"/art/stories/zdbjbz-04.webp","left":3,"right":31,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115013-PROLOGUE:1390:11","scriptId":1390,"text":"“伊诺，给我瞄准点，一炮结果了它！”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":31,"section":6,"shake":false},{"kind":"dialogue","head":176,"speaker":"伊诺·赞佩里尼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115013-PROLOGUE:1390:12","scriptId":1390,"text":"“遵命！”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":176,"section":6,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115013-EPILOGUE:11380:1","scriptId":11380,"text":"离坐标位置还有一半的距离，但是战车兽已经多得寸步难行了。","background":"/art/stories/zdbjbz-04.webp","left":3,"right":176,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115013-EPILOGUE:11380:2","scriptId":11380,"text":"“不妙啊，这个情况似曾相识，和马奇诺的情况很像啊……”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":176,"section":7,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115013-EPILOGUE:11380:3","scriptId":11380,"text":"“不会吧……这可怎么办，这次可没有索菲亚教官在啊。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":36,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115013-EPILOGUE:11380:4","scriptId":11380,"text":"“别急我想想办法。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":36,"section":7,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115013-EPILOGUE:11380:5","scriptId":11380,"text":"沉思了片刻……","background":"/art/stories/zdbjbz-04.webp","left":3,"right":36,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115013-EPILOGUE:11380:6","scriptId":11380,"text":"“这样，现在先停下队伍，佐伊把我们在马奇诺遇到的事情大致传达给队员们。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":36,"section":7,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115013-EPILOGUE:11380:7","scriptId":11380,"text":"“啊？我的叙述能力一般啊……”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":41,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115013-EPILOGUE:11380:8","scriptId":11380,"text":"“那就当锻炼口才了，平时和莉娜一起说八卦到是挺溜的。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":41,"section":7,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115013-EPILOGUE:11380:9","scriptId":11380,"text":"“呃……”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":40,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115013-EPILOGUE:11380:10","scriptId":11380,"text":"“米佳就在原地待命，一旦发现有战车兽往我们方向来，就第一时间回撤。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":40,"section":7,"shake":false},{"kind":"dialogue","head":499,"speaker":"米佳·叶戈罗夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115013-EPILOGUE:11380:11","scriptId":11380,"text":"“了解！”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":499,"section":7,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115013-EPILOGUE:11380:12","scriptId":11380,"text":"“那长官呢？”","background":"/art/stories/zdbjbz-04.webp","left":115,"right":499,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115013-EPILOGUE:11380:13","scriptId":11380,"text":"“当然是联络索菲亚教官咯，这情况冒然前进实在不是明智之举。”","background":"/art/stories/zdbjbz-04.webp","left":115,"right":3,"section":7,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115013-EPILOGUE:11380:14","scriptId":11380,"text":"说罢，我就开始鼓捣起吉普车上的步话机。","background":"/art/stories/zdbjbz-04.webp","left":115,"right":3,"section":7,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115014-PROLOGUE:1400:2","scriptId":1400,"text":"开启步话机之后，我开始联络教官。","background":"/art/stories/zdbjbz-04.webp","left":115,"right":3,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115014-PROLOGUE:1400:3","scriptId":1400,"text":"“是传达室？帮我转一下索菲亚教官！急件！”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":3,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115014-PROLOGUE:1400:4","scriptId":1400,"text":"过了一会儿，从话筒的另一侧传来了索菲亚教官的声音。","background":"/art/stories/zdbjbz-04.webp","left":3,"right":3,"section":8,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115014-PROLOGUE:1400:5","scriptId":1400,"text":"“有什么情况吗？”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":211,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115014-PROLOGUE:1400:6","scriptId":1400,"text":"“教官，情况有点不太妙，我们现在行进到一半……”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":211,"section":8,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115014-PROLOGUE:1400:7","scriptId":1400,"text":"“挑重点说。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":211,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115014-PROLOGUE:1400:8","scriptId":1400,"text":"“我感觉我们现在可能遇到了和马奇诺研究所一样的情况，周围的战车兽越来越多。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":211,"section":8,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115014-PROLOGUE:1400:9","scriptId":1400,"text":"“什么！？”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":211,"section":8,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115014-PROLOGUE:1400:10","scriptId":1400,"text":"“那你们先撤回来，我们……滋滋滋滋滋”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":211,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115014-PROLOGUE:1400:11","scriptId":1400,"text":"“干扰？真是见了鬼了。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":211,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115014-PROLOGUE:1400:12","scriptId":1400,"text":"我把话筒一甩，准备马上发令后撤。","background":"/art/stories/zdbjbz-04.webp","left":3,"right":211,"section":8,"shake":false},{"kind":"dialogue","head":499,"speaker":"米佳·叶戈罗夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115014-PROLOGUE:1400:13","scriptId":1400,"text":"“有两波战车兽向我们的方向过来了！”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":499,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115014-PROLOGUE:1400:14","scriptId":1400,"text":"“全员做好战斗准备，边打边撤，现在任务目标修订为撤回伏龙芝！”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":499,"section":8,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115014-PROLOGUE:1400:15","scriptId":1400,"text":"“啊？我这里还没说完呢……”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":40,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115014-PROLOGUE:1400:16","scriptId":1400,"text":"“……”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":40,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115014-PROLOGUE:1400:17","scriptId":1400,"text":"“后撤优先……”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":40,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115014-EPILOGUE:11390:0","scriptId":11390,"text":"快速清理掉冲上来的战车兽，我们退到了一处砂岩后面。","background":"/art/stories/zdbjbz-04.webp","left":3,"right":40,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115014-EPILOGUE:11390:2","scriptId":11390,"text":"“好像干扰已经没了，我再联络下教官看看。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":40,"section":9,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115014-EPILOGUE:11390:3","scriptId":11390,"text":"“别联系了，直接撤就行了……”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":36,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115014-EPILOGUE:11390:4","scriptId":11390,"text":"“也对，再退远一点，现在这个地方也还是不够安全。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":36,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115014-EPILOGUE:11390:5","scriptId":11390,"text":"“米佳那边情况如何？”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":36,"section":9,"shake":false},{"kind":"dialogue","head":499,"speaker":"米佳·叶戈罗夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115014-EPILOGUE:11390:6","scriptId":11390,"text":"“现在只能看到战车兽的一些小规模的集群，不过在往我们方向前进是确实无误的……”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":499,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115014-EPILOGUE:11390:7","scriptId":11390,"text":"“那还是继续后撤！”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":499,"section":9,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115014-EPILOGUE:11390:8","scriptId":11390,"text":"“第一次看到长官那么慌乱，看来我们遇到大事件了。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":115,"section":9,"shake":false},{"kind":"dialogue","head":175,"speaker":"伊诺·赞佩里尼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115014-EPILOGUE:11390:9","scriptId":11390,"text":"“那个不明人形有那么厉害吗？”","background":"/art/stories/zdbjbz-04.webp","left":175,"right":115,"section":9,"shake":false},{"kind":"dialogue","head":127,"speaker":"达利波娃·戈沃罗夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115014-EPILOGUE:11390:10","scriptId":11390,"text":"“虽然没遇到过，不过听佐伊前辈说的应该不会错，超级可怕。”","background":"/art/stories/zdbjbz-04.webp","left":175,"right":127,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115014-EPILOGUE:11390:11","scriptId":11390,"text":"“如果在这里遇上了的话，我们就肯定全灭了。”","background":"/art/stories/zdbjbz-04.webp","left":3,"right":127,"section":9,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115014-EPILOGUE:11390:12","scriptId":11390,"text":"我一脚踩在油门上，加快了后撤的速度……","background":"/art/stories/zdbjbz-04.webp","left":3,"right":127,"section":9,"shake":false}],"summaries":["自找麻烦","新成立的临时小队，开始向任务坐标出发。","遭遇奇袭","情况可能比较糟糕"]}
