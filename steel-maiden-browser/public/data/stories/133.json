{"schemaVersion":1,"id":133,"sections":[{"id":"207004-PROLOGUE","name":"第 1 战 · 战前","scripts":[20751],"start":0,"count":3}],"frames":[{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207004-PROLOGUE:20751:1","scriptId":20751,"text":"“长官现在已经习惯了捷径战模式吧？”","background":"/art/stories/zjm-066.webp","left":null,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207004-PROLOGUE:20751:2","scriptId":20751,"text":"“虽然捷径战的消耗很大，但只要合理运用就能节约大量的时间和精力。”","background":"/art/stories/zjm-066.webp","left":null,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207004-PROLOGUE:20751:3","scriptId":20751,"text":"“这样长官也能留出精力来应对其他的事务。”","background":"/art/stories/zjm-066.webp","left":null,"right":11,"section":0,"shake":false}],"summaries":[]}
