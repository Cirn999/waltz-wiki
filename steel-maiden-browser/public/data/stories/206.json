{"schemaVersion":1,"id":206,"sections":[{"id":"356002-PROLOGUE","name":"第 1 战 · 战前","scripts":[20537],"start":0,"count":29},{"id":"356002-EPILOGUE","name":"第 1 战 · 战后","scripts":[20538],"start":29,"count":20}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-PROLOGUE:20537:1","scriptId":20537,"text":"莉安娜一行人来到了位于城镇郊区的一处废墟。","background":"/art/stories/zdbjbz-11.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:2","scriptId":20537,"text":"“虽然途中遇上蕾贝卡那个麻烦家伙，但看来没多大影响。”","background":"/art/stories/zdbjbz-11.webp","left":780,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-PROLOGUE:20537:3","scriptId":20537,"text":"来到了约定地点，但是好像接头人还没到的样子。","background":"/art/stories/zdbjbz-11.webp","left":780,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":859,"speaker":"莎娃·叶尔马科夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:4","scriptId":20537,"text":"“不，好像已经到了。”","background":"/art/stories/zdbjbz-11.webp","left":780,"right":859,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-PROLOGUE:20537:5","scriptId":20537,"text":"莎娃往远处的树墩用手一指。","background":"/art/stories/zdbjbz-11.webp","left":780,"right":859,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-PROLOGUE:20537:6","scriptId":20537,"text":"如果不仔细看可能无法察觉，有一截舞装露在了树墩外面……看破这种程度的伪装对于侦察型钢舞姬来说简直是小菜一碟。","background":"/art/stories/zdbjbz-11.webp","left":780,"right":859,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:7","scriptId":20537,"text":"“哦？看来人已经到了？走，我们过去。注意保持警惕。”","background":"/art/stories/zdbjbz-11.webp","left":780,"right":859,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-PROLOGUE:20537:9","scriptId":20537,"text":"莉安娜她们往莎娃所指的方向走去，果然发现了处于隐蔽状态的某钢舞姬小队。","background":"/art/stories/zdbjbz-11.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":475,"speaker":"达克妮·戴维斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:10","scriptId":20537,"text":"“竟然识破了我们的伪装，很有一套嘛～我是利爪小队的达克妮～”","background":"/art/stories/zdbjbz-11.webp","left":475,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-PROLOGUE:20537:11","scriptId":20537,"text":"没想到对方会抢先发言，莉安娜愣了一下。","background":"/art/stories/zdbjbz-11.webp","left":475,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:12","scriptId":20537,"text":"“你是这个队伍的队长吗？”","background":"/art/stories/zdbjbz-11.webp","left":475,"right":780,"section":0,"shake":false},{"kind":"dialogue","head":475,"speaker":"达克妮·戴维斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:13","scriptId":20537,"text":"“呃……算是吧，你有什么问题尽管说～”","background":"/art/stories/zdbjbz-11.webp","left":475,"right":780,"section":0,"shake":false},{"kind":"dialogue","head":469,"speaker":"雷思丽·戴维斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:14","scriptId":20537,"text":"“你这死猫还真是满口胡话，虽然瓦什蒂队长不太靠谱，但也轮不到你来当队长。”","background":"/art/stories/zdbjbz-11.webp","left":475,"right":469,"section":0,"shake":false},{"kind":"dialogue","head":469,"speaker":"雷思丽·戴维斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:15","scriptId":20537,"text":"“你好，我是雷思丽，这位是瓦什蒂队长。”","background":"/art/stories/zdbjbz-11.webp","left":475,"right":469,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-PROLOGUE:20537:16","scriptId":20537,"text":"这位褐色皮肤的钢舞姬旁边站着一位战战兢兢的人，应该就是瓦什蒂了。","background":"/art/stories/zdbjbz-11.webp","left":475,"right":469,"section":0,"shake":false},{"kind":"dialogue","head":481,"speaker":"达克妮·戴维斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:17","scriptId":20537,"text":"“哼～”","background":"/art/stories/zdbjbz-11.webp","left":481,"right":469,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-PROLOGUE:20537:18","scriptId":20537,"text":"达克妮作了个鬼脸跑开了。","background":"/art/stories/zdbjbz-11.webp","left":481,"right":469,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:20","scriptId":20537,"text":"“……”","background":"/art/stories/zdbjbz-11.webp","left":null,"right":780,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:21","scriptId":20537,"text":"（这是接头的队伍？怎么感觉有点不对劲啊……）","background":"/art/stories/zdbjbz-11.webp","left":null,"right":780,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-PROLOGUE:20537:22","scriptId":20537,"text":"想到这里，莉安娜用背着的手朝站在自己身后的莎娃和乔娜做了个信号。","background":"/art/stories/zdbjbz-11.webp","left":null,"right":780,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-PROLOGUE:20537:23","scriptId":20537,"text":"接到信号的二人开始慢慢地往后退开。","background":"/art/stories/zdbjbz-11.webp","left":null,"right":780,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:24","scriptId":20537,"text":"“那么你就是瓦什蒂队长了吧，能对一下暗号吗？”","background":"/art/stories/zdbjbz-11.webp","left":null,"right":780,"section":0,"shake":false},{"kind":"dialogue","head":440,"speaker":"瓦什蒂·布雷德利","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:25","scriptId":20537,"text":"“是……是的，暗号，我记得好像是打雷、不不、应该是鸳鸯茶？”","background":"/art/stories/zdbjbz-11.webp","left":440,"right":780,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:26","scriptId":20537,"text":"“…………”","background":"/art/stories/zdbjbz-11.webp","left":440,"right":780,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:27","scriptId":20537,"text":"“你确定了吗？”","background":"/art/stories/zdbjbz-11.webp","left":440,"right":780,"section":0,"shake":false},{"kind":"dialogue","head":440,"speaker":"瓦什蒂·布雷德利","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:28","scriptId":20537,"text":"“那个……我再想想，难道是暴风雨？？”","background":"/art/stories/zdbjbz-11.webp","left":440,"right":780,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:29","scriptId":20537,"text":"“时间到……很遗憾，你并没有给我正确答案。”","background":"/art/stories/zdbjbz-11.webp","left":440,"right":780,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-PROLOGUE:20537:30","scriptId":20537,"text":"莉安娜举起了武器。","background":"/art/stories/zdbjbz-11.webp","left":440,"right":780,"section":0,"shake":false},{"kind":"dialogue","head":443,"speaker":"瓦什蒂·布雷德利","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-PROLOGUE:20537:31","scriptId":20537,"text":"“诶！？那个……再给我点时间啊！？”","background":"/art/stories/zdbjbz-11.webp","left":443,"right":780,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-EPILOGUE:20538:1","scriptId":20538,"text":"没想到和利爪小队战斗的途中又来了另外一支队伍。","background":"/art/stories/zdbjbz-11.webp","left":443,"right":780,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-EPILOGUE:20538:2","scriptId":20538,"text":"不过正因为这支队伍的出现，才成功制止了死亡彗星与利爪的战斗。","background":"/art/stories/zdbjbz-11.webp","left":443,"right":780,"section":1,"shake":false},{"kind":"dialogue","head":1092,"speaker":"艾米丽·兰德尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-EPILOGUE:20538:3","scriptId":20538,"text":"“真是抱歉，因为我们小队去确认周围情况所以让利爪队在这里等候，没想到……”","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-EPILOGUE:20538:4","scriptId":20538,"text":"说到这里，铁血小队的艾米丽队长狠狠地瞪了瓦什蒂一眼，把瓦什蒂吓得躲了起来。","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-EPILOGUE:20538:5","scriptId":20538,"text":"不过由于艾米丽成功对上了暗号，才使得莉安娜放下了武器。","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-EPILOGUE:20538:6","scriptId":20538,"text":"“那家伙自己没来吗？”","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-EPILOGUE:20538:7","scriptId":20538,"text":"白白浪费了弹药让莉安娜有点不爽。","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"dialogue","head":1092,"speaker":"艾米丽·兰德尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-EPILOGUE:20538:8","scriptId":20538,"text":"“特勤局的上层都比价忙，我们只是代劳接头工作。”","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-EPILOGUE:20538:9","scriptId":20538,"text":"“好吧，东西在这里了，报酬呢？”","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-EPILOGUE:20538:10","scriptId":20538,"text":"莉安娜拿出了文件夹并在手里晃了晃，相应的艾米丽也从怀里取出了一样东西。","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"dialogue","head":1092,"speaker":"艾米丽·兰德尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-EPILOGUE:20538:11","scriptId":20538,"text":"“这份是瑞士银行的存折。”","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-EPILOGUE:20538:12","scriptId":20538,"text":"双方交换了物件并加以确认。","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-EPILOGUE:20538:13","scriptId":20538,"text":"“很好，这个数字我很喜欢，符合那家伙的作风。”","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"dialogue","head":1092,"speaker":"艾米丽·兰德尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-EPILOGUE:20538:14","scriptId":20538,"text":"“图纸的真伪我虽然不能确认，但是波西娅的签名我认得，这份确实是真迹。”","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-EPILOGUE:20538:15","scriptId":20538,"text":"“吼哦～那家伙派来的人有点见识嘛，所以说利爪的那群废物只是临时来顶班的？”","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"dialogue","head":1092,"speaker":"艾米丽·兰德尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-EPILOGUE:20538:16","scriptId":20538,"text":"“恩，附近能调动的护卫队就只有这么一队了……”","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-EPILOGUE:20538:17","scriptId":20538,"text":"“哼，好好管教吧，太不像样了，特勤局老是收纳这种低等货色？”","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"dialogue","head":1092,"speaker":"艾米丽·兰德尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"356002-EPILOGUE:20538:18","scriptId":20538,"text":"“……”","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"356002-EPILOGUE:20538:19","scriptId":20538,"text":"看到艾米丽没有继续说话，莉安娜也就此打住。","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"356002-EPILOGUE:20538:20","scriptId":20538,"text":"“好了，交易完成，此地也不宜久留，那我们就先走了，拜～”","background":"/art/stories/zdbjbz-11.webp","left":1092,"right":780,"section":1,"shake":false}],"summaries":[]}
