{"schemaVersion":1,"id":-40117,"sections":[{"id":"script-20117","name":"原始脚本 20117","scripts":[20117],"start":0,"count":66}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:2","scriptId":20117,"text":"好死不死，在这个时候竟然遇上了旅行者……","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":true},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:3","scriptId":20117,"text":"原以为是个非常轻松的任务，但却没想到会落到这个境地……","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:4","scriptId":20117,"text":"不过这都是后话了，让我们把故事的时间轴回溯到两天前。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:6","scriptId":20117,"text":"“这个是最新的任务，但是因为有指定的小队负责，所以其实已经没有了。”","background":"/art/stories/zjm-099.webp","left":11,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:7","scriptId":20117,"text":"“这样啊……，那就没办法了，还有其他的推荐吗？”","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:8","scriptId":20117,"text":"“好的，请您稍微等一下……”","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:9","scriptId":20117,"text":"一个平凡的早晨，我们小队正在任务前台选择任务。","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:10","scriptId":20117,"text":"因为起得比较早，任务大厅里还没有多少队伍。","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:11","scriptId":20117,"text":"“叮铃铃铃……”","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:12","scriptId":20117,"text":"摆在桌上的电话响了，芮蓓把手上的任务资料堆砌在一边，以娴熟的手势提起了话筒。","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:13","scriptId":20117,"text":"“您好，这里是死水服务中心～请问您有什么需要？”","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:14","scriptId":20117,"text":"看到芮蓓在接电话，所以我们就只能继续检查任务清单里还有哪些性价比较高的任务。","background":"/art/stories/zjm-099.webp","left":11,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:15","scriptId":20117,"text":"“随便接一个不就行了嘛……我看看都挺简单的说……”","background":"/art/stories/zjm-099.webp","left":11,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:16","scriptId":20117,"text":"“……”","background":"/art/stories/zjm-099.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:17","scriptId":20117,"text":"“因为我们的队伍人数比较多，所以特别需要考虑性价比的问题，不然可是会出现赤字的。”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:18","scriptId":20117,"text":"“还好啦～没佩妮说的那么夸张，只不过是少拿点报酬而已～当然了，能提高性价比的话自然是好事。”","background":"/art/stories/zjm-099.webp","left":574,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:19","scriptId":20117,"text":"“请尽可能增收……”","background":"/art/stories/zjm-099.webp","left":574,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:20","scriptId":20117,"text":"“恩……我也想多赚点啦～”","background":"/art/stories/zjm-099.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:21","scriptId":20117,"text":"“话是这么说，但是这次并没有什么特别超值的任务呢……”","background":"/art/stories/zjm-099.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:22","scriptId":20117,"text":"我们小队七嘴八舌地讨论着表单上的任务。","background":"/art/stories/zjm-099.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:23","scriptId":20117,"text":"“那个……刚才正好有一个新的任务，书面文件还没正式过来，大概两个小时以后会送到吧。”","background":"/art/stories/zjm-099.webp","left":4,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:24","scriptId":20117,"text":"“哦？是什么样的任务？”","background":"/art/stories/zjm-099.webp","left":4,"right":11,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:25","scriptId":20117,"text":"芮蓓拿出一张便条，从上面的字迹可以看得出，这肯定是她刚才在接电话时记录的一些内容。","background":"/art/stories/zjm-099.webp","left":4,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:26","scriptId":20117,"text":"“大概是这样的一个任务……”","background":"/art/stories/zjm-099.webp","left":4,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:27","scriptId":20117,"text":"“我看看……哦，保护要员？海滩户外取景？？”","background":"/art/stories/zjm-099.webp","left":4,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:28","scriptId":20117,"text":"“哦？听上去挺有意思啊～给我看看～”","background":"/art/stories/zjm-099.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:29","scriptId":20117,"text":"奈特莉一把抢过我手里的便条，和佩妮她们分看了起来。","background":"/art/stories/zjm-099.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:30","scriptId":20117,"text":"“这个任务看上去很轻松的样子啊，不过让钢舞姬保护钢舞姬，这……”","background":"/art/stories/zjm-099.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:31","scriptId":20117,"text":"“恩，因为是护卫特勤局的明星小队啊，都是些文宣的队员。”","background":"/art/stories/zjm-099.webp","left":4,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:32","scriptId":20117,"text":"“哦，战斗力不高，所以要护送？”","background":"/art/stories/zjm-099.webp","left":4,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:33","scriptId":20117,"text":"“差不多这样，但是也并不全是，因为都是一线的明星，所以其实不能磕着碰着的……毕竟宣传可是颜面工程～”","background":"/art/stories/zjm-099.webp","left":4,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:34","scriptId":20117,"text":"“也是……”","background":"/art/stories/zjm-099.webp","left":4,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:35","scriptId":20117,"text":"“另外这个任务是需求两支小队而且其中一支小队已经被指定了。～”","background":"/art/stories/zjm-099.webp","left":4,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:36","scriptId":20117,"text":"“哦？这样么，那么我们可以接吗？感觉这报酬性价比很高啊。”","background":"/art/stories/zjm-099.webp","left":4,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:37","scriptId":20117,"text":"“是的，没有问题，另外指定的队伍是白银皇后，之后我会去传达给她们小队。”","background":"/art/stories/zjm-099.webp","left":4,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:38","scriptId":20117,"text":"“好啊好啊～是去夏威夷啊！我要准备好泳装～”","background":"/art/stories/zjm-099.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":589,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:39","scriptId":20117,"text":"“姐姐，不是去玩的啦，带好舞装就行了……”","background":"/art/stories/zjm-099.webp","left":589,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:40","scriptId":20117,"text":"“不过我想夏威夷应该没什么战车兽的样子，或许是个很轻松的任务吧～还可以当成小半个度假，多好～”","background":"/art/stories/zjm-099.webp","left":589,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:41","scriptId":20117,"text":"“一举两得，赞成！”","background":"/art/stories/zjm-099.webp","left":596,"right":574,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:42","scriptId":20117,"text":"小队成员全票通过，于是芮蓓替我们受理了这个任务。","background":"/art/stories/zjm-099.webp","left":596,"right":574,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:43","scriptId":20117,"text":"接下来就是前往指定地点与特勤局的明星小队汇合……","background":"/art/stories/zjm-099.webp","left":596,"right":574,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:44","scriptId":20117,"text":"这次因为要去夏威夷，所以我们在做完一系列的准备工作以后便前往死水的专用机场。","background":"/art/stories/zjm-099.webp","left":596,"right":574,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:46","scriptId":20117,"text":"前往死水机场的必经之路上——","background":"/art/stories/zjm-067.webp","left":596,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":594,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:47","scriptId":20117,"text":"“长官，前面的路口有三个人……呃……那是……波西娅和尤拉，还有艾丽莎？”","background":"/art/stories/zjm-067.webp","left":594,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:48","scriptId":20117,"text":"“呃……能绕开吗？”","background":"/art/stories/zjm-067.webp","left":594,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:49","scriptId":20117,"text":"“好像来不及了，我看波西娅在向这边招手呢～”","background":"/art/stories/zjm-067.webp","left":582,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:50","scriptId":20117,"text":"“……”","background":"/art/stories/zjm-067.webp","left":582,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:52","scriptId":20117,"text":"于是我们只得把车停在了波西娅前面……","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:53","scriptId":20117,"text":"“哟～有些日子不见了啊～看这样子你们也准备搭乘运输机？”","background":"/art/stories/zjm-067.webp","left":608,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:54","scriptId":20117,"text":"“对的……你们在这里干什么？”","background":"/art/stories/zjm-067.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:55","scriptId":20117,"text":"“我们？我们是准备去夏威夷，现在运输机正在维护中，估计还要一点点时间，正在等呢。”","background":"/art/stories/zjm-067.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:56","scriptId":20117,"text":"“诶！？难道芮蓓之前说的指定小队就是你们？”","background":"/art/stories/zjm-067.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:57","scriptId":20117,"text":"“那是什么？？指定小队？没听说过……我是去夏威夷的科研基地办点事情。”","background":"/art/stories/zjm-067.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:58","scriptId":20117,"text":"“哦……那是我搞错了～我们也是去夏威夷，听说还有一支小队也会去，我还以为是你们呢。”","background":"/art/stories/zjm-067.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:59","scriptId":20117,"text":"“那正好，一起等着吧，那辆JU52正在点检。”","background":"/art/stories/zjm-067.webp","left":608,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:62","scriptId":20117,"text":"和波西娅一起乘坐专用的运输机抵达了夏威夷群岛的科研基地。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:63","scriptId":20117,"text":"我们因为要去指定地点和另一支队伍汇合，所以下了运输机以后就准备和波西娅她们分道扬镳了。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:64","scriptId":20117,"text":"“那么我们就先告辞了。”","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:65","scriptId":20117,"text":"“去吧去吧～”","background":"/art/stories/zjm-101.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:66","scriptId":20117,"text":"“路上小心啊～”","background":"/art/stories/zjm-101.webp","left":728,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20117:20117:67","scriptId":20117,"text":"就在这时，基地的警报响起了。","background":"/art/stories/zjm-101.webp","left":728,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:68","scriptId":20117,"text":"“不是吧……刚来这里就遇袭？？”","background":"/art/stories/zjm-101.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:69","scriptId":20117,"text":"“看来你还挺晦气的嘛～不过不要紧，有我在～”","background":"/art/stories/zjm-101.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:70","scriptId":20117,"text":"“艾丽莎就先在基地等我们一下～等会儿就回来。”","background":"/art/stories/zjm-101.webp","left":728,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":13,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:71","scriptId":20117,"text":"“好的，我在这里等你们。”","background":"/art/stories/zjm-101.webp","left":728,"right":13,"section":0,"shake":false},{"kind":"dialogue","head":13,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20117:20117:72","scriptId":20117,"text":"（周围好像有同类的反应？这时候没有兰布达真是麻烦……不过和我没什么关系，我又可以进行对海洋的观测了～）","background":"/art/stories/zjm-101.webp","left":728,"right":13,"section":0,"shake":false}],"summaries":[]}
