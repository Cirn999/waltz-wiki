{"schemaVersion":1,"id":7,"sections":[{"id":"107004-PROLOGUE","name":"第 1 战 · 战前","scripts":[180],"start":0,"count":7},{"id":"107004-EPILOGUE","name":"第 1 战 · 战后","scripts":[10170],"start":7,"count":2},{"id":"107005-PROLOGUE","name":"第 2 战 · 战前","scripts":[190,191,192,193],"start":9,"count":24},{"id":"107005-EPILOGUE","name":"第 2 战 · 战后","scripts":[10180],"start":33,"count":8},{"id":"107006-PROLOGUE","name":"第 3 战 · 战前","scripts":[200],"start":41,"count":6},{"id":"107006-EPILOGUE","name":"第 3 战 · 战后","scripts":[10190],"start":47,"count":6}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"107004-PROLOGUE:180:2","scriptId":180,"text":"送走了奈乐一行，马上进入了紧张的司令部维护阶段。","background":"/art/stories/zjm-066.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107004-PROLOGUE:180:3","scriptId":180,"text":"“除了正常的炮台修理以外，还要增加高射炮和对空雷达的铺设。”","background":"/art/stories/zjm-066.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107004-PROLOGUE:180:4","scriptId":180,"text":"“真有指挥官的架子……我们都在忙。没空！”","background":"/art/stories/zjm-066.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107004-PROLOGUE:180:5","scriptId":180,"text":"“好吧，你们修理那些机械，文案申请我自己来吧……”","background":"/art/stories/zjm-066.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"107004-PROLOGUE:180:7","scriptId":180,"text":"过去了一周，佐伊等人花了一番功夫，终于把司令部的基本功能都恢复到了袭击之前。","background":"/art/stories/zjm-066.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107004-PROLOGUE:180:8","scriptId":180,"text":"“休息的也差不多了，该动身了！”","background":"/art/stories/zjm-066.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107004-PROLOGUE:180:9","scriptId":180,"text":"“动身？去哪？”","background":"/art/stories/zjm-066.webp","left":3,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107004-EPILOGUE:10170:1","scriptId":10170,"text":"“总该告诉我们一下去哪儿吧……这样乱走很容易吸引到别的战车兽的。”","background":"/art/stories/zdbjbz-01.webp","left":40,"right":41,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107004-EPILOGUE:10170:2","scriptId":10170,"text":"“好了，好了，等会儿就告诉你们。”","background":"/art/stories/zdbjbz-01.webp","left":40,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:190:2","scriptId":190,"text":"“这次的目标是齐格菲防线某处的研究所。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:190:3","scriptId":190,"text":"“从行径路线上来看，并不是直接去向齐格菲防线的啊。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:190:4","scriptId":190,"text":"“确实，我故意绕了点路。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:190:5","scriptId":190,"text":"“为什么？”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:190:6","scriptId":190,"text":"“一会儿你就知道了。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:190:7","scriptId":190,"text":"（哼，卖关子的本事和臭美的程度差不多……）","background":"/art/stories/zdbjbz-01.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:191:2","scriptId":191,"text":"“这次的目标是齐格菲防线某处的研究所。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:191:3","scriptId":191,"text":"“研究所我知道，但不是从这里走的吧。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":1171,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:191:4","scriptId":191,"text":"“确实，我故意绕了点路。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":1171,"section":2,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:191:5","scriptId":191,"text":"“为什么？”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:191:6","scriptId":191,"text":"“一会儿你就知道了。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:191:7","scriptId":191,"text":"（哼，卖关子的本事和臭美的程度差不多……）","background":"/art/stories/zdbjbz-01.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:192:2","scriptId":192,"text":"“这次的目标是齐格菲防线某处的研究所。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:192:3","scriptId":192,"text":"“但这并不是去齐格非菲防线的路。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":1146,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:192:4","scriptId":192,"text":"“确实，我故意绕了点路。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":1146,"section":2,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:192:5","scriptId":192,"text":"“为什么？”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:192:6","scriptId":192,"text":"“一会儿你就知道了。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:192:7","scriptId":192,"text":"（哼，卖关子的本事和臭美的程度差不多……）","background":"/art/stories/zdbjbz-01.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:193:2","scriptId":193,"text":"“这次的目标是齐格菲防线某处的研究所。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:193:3","scriptId":193,"text":"“长官，你这是什么意思，齐格菲可不是从这条路走的。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":1158,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:193:4","scriptId":193,"text":"“被看出来了吗？我故意绕了点路。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":1158,"section":2,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:193:5","scriptId":193,"text":"“为什么？”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:193:6","scriptId":193,"text":"“一会儿你就知道了。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-PROLOGUE:193:7","scriptId":193,"text":"（哼，卖关子的本事和臭美的程度差不多……）","background":"/art/stories/zdbjbz-01.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"107005-EPILOGUE:10180:1","scriptId":10180,"text":"收拾掉遭遇的战车兽以后，三个熟悉的身影出现在佐伊眼前。","background":"/art/stories/zdbjbz-01.webp","left":3,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-EPILOGUE:10180:2","scriptId":10180,"text":"“是奈乐和莉娜还有普莉玛！？”","background":"/art/stories/zdbjbz-01.webp","left":31,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-EPILOGUE:10180:3","scriptId":10180,"text":"“你们怎么在这里？”","background":"/art/stories/zdbjbz-01.webp","left":41,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-EPILOGUE:10180:4","scriptId":10180,"text":"“老爸让我们来支援你们，这次行动的敌人可能不太好对付。”","background":"/art/stories/zdbjbz-01.webp","left":41,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-EPILOGUE:10180:5","scriptId":10180,"text":"“隆美尔司令真是通情达理。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":92,"speaker":"普莉玛·派普","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-EPILOGUE:10180:6","scriptId":10180,"text":"“你好……”普莉玛的发音小到基本听不清。","background":"/art/stories/zdbjbz-01.webp","left":3,"right":92,"section":3,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107005-EPILOGUE:10180:7","scriptId":10180,"text":"“又要和吊车尾佐伊组队，看来前途多难啊。”","background":"/art/stories/zdbjbz-01.webp","left":81,"right":92,"section":3,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107005-EPILOGUE:10180:8","scriptId":10180,"text":"“我这边才是呢！每次和莉娜组队都会遇上大麻烦。”","background":"/art/stories/zdbjbz-01.webp","left":81,"right":32,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"107006-PROLOGUE:200:2","scriptId":200,"text":"到达了齐格菲研究所外围。","background":"/art/stories/zdbjbz-01.webp","left":81,"right":32,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107006-PROLOGUE:200:3","scriptId":200,"text":"“看那边……”我把望远镜递给奈乐。","background":"/art/stories/zdbjbz-01.webp","left":3,"right":32,"section":4,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107006-PROLOGUE:200:4","scriptId":200,"text":"“恩，跟情报一样，这研究所已经被战车兽占据了很久。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":103,"section":4,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107006-PROLOGUE:200:5","scriptId":200,"text":"“那为什么一直没有收到过救援信号呢？”","background":"/art/stories/zdbjbz-01.webp","left":41,"right":103,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107006-PROLOGUE:200:6","scriptId":200,"text":"“这就是我们此行的目的。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":103,"section":4,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107006-PROLOGUE:200:7","scriptId":200,"text":"“不过周围的战车兽需要清理一下。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":103,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"107006-EPILOGUE:10190:1","scriptId":10190,"text":"击退了一群守备的战车兽后，佐伊提了个奇怪的问题。","background":"/art/stories/zdbjbz-01.webp","left":3,"right":103,"section":5,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"107006-EPILOGUE:10190:2","scriptId":10190,"text":"“那个……我刚才好像有听到战车兽说话？好像在喊‘久久’？”","background":"/art/stories/zdbjbz-01.webp","left":41,"right":103,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107006-EPILOGUE:10190:3","scriptId":10190,"text":"“不止是说话，看看这里。”我指了指地面。","background":"/art/stories/zdbjbz-01.webp","left":41,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"107006-EPILOGUE:10190:4","scriptId":10190,"text":"地上写着歪歪扭扭的写着“救救”的字样。","background":"/art/stories/zdbjbz-01.webp","left":41,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"107006-EPILOGUE:10190:5","scriptId":10190,"text":"众人陷入了一片沉默。","background":"/art/stories/zdbjbz-01.webp","left":41,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"107006-EPILOGUE:10190:6","scriptId":10190,"text":"（这字迹不像是人类的手笔，是战车兽留下的？）","background":"/art/stories/zdbjbz-01.webp","left":41,"right":3,"section":5,"shake":false}],"summaries":["司令部的危机算是解除了，真是一场灾难，先维护一下基地吧。","要去齐格菲防线，我估计路上一定会有不少阻碍。","果然和文件上说的一样，这研究所有问题。"]}
