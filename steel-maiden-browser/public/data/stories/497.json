{"schemaVersion":1,"id":497,"sections":[{"id":"1916001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20673],"start":0,"count":18},{"id":"1916001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20674],"start":18,"count":19}],"frames":[{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:1","scriptId":20673,"text":"“报告，已经排除了北部区域的入侵者。”","background":"/art/stories/zjm-067.webp","left":1137,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:2","scriptId":20673,"text":"“很好，继续巡逻去吧。”","background":"/art/stories/zjm-067.webp","left":1137,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:3","scriptId":20673,"text":"“遵命。”","background":"/art/stories/zjm-067.webp","left":1137,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:5","scriptId":20673,"text":"“没想到人类的士兵比我们自己的部队好用那么多，柯西的意见确实有她的道理。”","background":"/art/stories/zjm-067.webp","left":null,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:6","scriptId":20673,"text":"“因为是同类所以才会放松警惕，被自己人攻击是完全在意料之外吧。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:7","scriptId":20673,"text":"“换做是我们或许也会如此吧。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:8","scriptId":20673,"text":"“但这个星球的文明根本不值得我们警惕这种问题，人类还不会操控其他生物的意识。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:9","scriptId":20673,"text":"“也是。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:10","scriptId":20673,"text":"“不过我们之前的据点也有被人类摧毁的例子，小心一点总没错。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:11","scriptId":20673,"text":"“其实没什么影响，本来据点这种东西就是消耗品，藏身之地偶尔少掉几个并无大碍。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:12","scriptId":20673,"text":"“但毁于人类之手这种事情，说出去有点丢人啊。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:13","scriptId":20673,"text":"“这倒是……”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:14","scriptId":20673,"text":"“好了，不聊那么多了，我该给上面的大人们做定期汇报了。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:15","scriptId":20673,"text":"“哦，是梅洛佩大人吧？”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:16","scriptId":20673,"text":"“是啊，上报其他三位大人们的情况……”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:17","scriptId":20673,"text":"“唉……又是大人们的那些事啊，可真是辛苦你了。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:18","scriptId":20673,"text":"“对了，我做汇报期间，你去帮我核对一下丝黛罗佩大人近期的动向。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1916001-PROLOGUE:20673:19","scriptId":20673,"text":"“……丝黛罗佩大人吗？了解。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1916001-EPILOGUE:20674:1","scriptId":20674,"text":"去往目的地的路上——","background":"/art/stories/zdbjbz-15.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":742,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:2","scriptId":20674,"text":"“长官，在想什么呢？一副心不在焉的样子。”","background":"/art/stories/zdbjbz-15.webp","left":742,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:3","scriptId":20674,"text":"“哦？连佐伊你都看出来了？”","background":"/art/stories/zdbjbz-15.webp","left":742,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":746,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:4","scriptId":20674,"text":"“什么话，你那傻样谁看不出来啊。”","background":"/art/stories/zdbjbz-15.webp","left":746,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:5","scriptId":20674,"text":"“呃……我只是有点不明白。”","background":"/art/stories/zdbjbz-15.webp","left":746,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:6","scriptId":20674,"text":"“不明白什么？”","background":"/art/stories/zdbjbz-15.webp","left":740,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:7","scriptId":20674,"text":"“既然多福莱尼自己掌握着那么多失踪钢舞姬的情报，那为什么自己不来找人？”","background":"/art/stories/zdbjbz-15.webp","left":740,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":748,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:8","scriptId":20674,"text":"“这么说也是啊……为什么呢？”","background":"/art/stories/zdbjbz-15.webp","left":748,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":592,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:9","scriptId":20674,"text":"“是想卖死水一个人情吧，而且自己搜索可能有风险还是佣兵更合适干这种活吧。”","background":"/art/stories/zdbjbz-15.webp","left":748,"right":592,"section":1,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:10","scriptId":20674,"text":"“真是精明的商人，不但有钱赚还能卖顺水人情。”","background":"/art/stories/zdbjbz-15.webp","left":582,"right":592,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:11","scriptId":20674,"text":"“我特意调查了一下多福莱尼，但这个铁道工会还蛮正经的，除了运费高得离谱以外，其他的业务都非常正常。”","background":"/art/stories/zdbjbz-15.webp","left":582,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:12","scriptId":20674,"text":"“诶？看不出还是个正经商会？这商会我一直都觉得有幕后黑手啊。”","background":"/art/stories/zdbjbz-15.webp","left":578,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:13","scriptId":20674,"text":"“不，奈特莉，你的直觉挺准的，就是太过正常反而才会让人觉得有问题。”","background":"/art/stories/zdbjbz-15.webp","left":578,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:14","scriptId":20674,"text":"“他们是在近几年一下子成长起来的工会，扩张速度快得不可思议，现在已经在大多数国家都铺设了办事处。”","background":"/art/stories/zdbjbz-15.webp","left":578,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:15","scriptId":20674,"text":"“是啊，我以前工作的那家航运公司都快倒闭了，这后来居上的多福莱尼倒是风生水起啊。”","background":"/art/stories/zdbjbz-15.webp","left":578,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:16","scriptId":20674,"text":"“啊哈，我明白了，你那直觉有一半还是来自嫉妒啊。”","background":"/art/stories/zdbjbz-15.webp","left":578,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:17","scriptId":20674,"text":"“长官真爱说笑，我只不过是感慨一下过去而已，现在我可是您的部下啊。”","background":"/art/stories/zdbjbz-15.webp","left":582,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:18","scriptId":20674,"text":"“也是，还是回过头来想想任务吧，还有半天的行程就该到目的地了。”","background":"/art/stories/zdbjbz-15.webp","left":582,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1916001-EPILOGUE:20674:19","scriptId":20674,"text":"（多福莱尼这个组织日后还要继续调查，情报太少。）","background":"/art/stories/zdbjbz-15.webp","left":582,"right":4,"section":1,"shake":false}],"summaries":[]}
