{"schemaVersion":1,"id":-40109,"sections":[{"id":"script-20109","name":"原始脚本 20109","scripts":[20109],"start":0,"count":14}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20109:20109:0","scriptId":20109,"text":"费了一番功夫终于把那些软泥一样的怪物干掉了。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":634,"speaker":"扎莉·魏特曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20109:20109:1","scriptId":20109,"text":"“还可以嘛，至少比战车兽打起来有感觉，虽然看上去没什么智力，但是反应速度却高战车兽一筹。”","background":"/art/stories/zjm-047.webp","left":634,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":535,"speaker":"伊达·布鲁克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20109:20109:2","scriptId":20109,"text":"“还好没被那爆散开的液体沾到……”","background":"/art/stories/zjm-047.webp","left":634,"right":535,"section":0,"shake":false},{"kind":"dialogue","head":698,"speaker":"米歇尔·法梅加","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20109:20109:3","scriptId":20109,"text":"“你仔细看看，就算被沾到也只是一时的，那些怪物都变成了数据链，和之前消灭的模拟战车兽一样都是数据而已。”","background":"/art/stories/zjm-047.webp","left":698,"right":535,"section":0,"shake":false},{"kind":"dialogue","head":535,"speaker":"伊达·布鲁克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20109:20109:4","scriptId":20109,"text":"“啊？是这样吗？”","background":"/art/stories/zjm-047.webp","left":698,"right":535,"section":0,"shake":false},{"kind":"dialogue","head":692,"speaker":"米歇尔·法梅加","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20109:20109:5","scriptId":20109,"text":"“不仔细观察，只知道瞎嚷嚷……”","background":"/art/stories/zjm-047.webp","left":692,"right":535,"section":0,"shake":false},{"kind":"dialogue","head":642,"speaker":"扎莉·魏特曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20109:20109:6","scriptId":20109,"text":"“好了好了，波西娅，人呢？软泥都清理掉了。”","background":"/art/stories/zjm-047.webp","left":692,"right":642,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20109:20109:7","scriptId":20109,"text":"扎莉这么一吼，果然波西娅瞬间出现在了众人面前。","background":"/art/stories/zjm-047.webp","left":692,"right":642,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20109:20109:8","scriptId":20109,"text":"“恩，很漂亮，那些战斗数据我都记录到了～”","background":"/art/stories/zjm-047.webp","left":608,"right":642,"section":0,"shake":false},{"kind":"dialogue","head":640,"speaker":"扎莉·魏特曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20109:20109:9","scriptId":20109,"text":"“那就好，那么我们可以回去了吗？”","background":"/art/stories/zjm-047.webp","left":608,"right":640,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20109:20109:10","scriptId":20109,"text":"波西娅摇了摇头，叹了口气。","background":"/art/stories/zjm-047.webp","left":608,"right":640,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20109:20109:11","scriptId":20109,"text":"“还没呢，刚才侦测到了那些入侵数据的源头，我想干掉那些的话就差不多了。”","background":"/art/stories/zjm-047.webp","left":608,"right":640,"section":0,"shake":false},{"kind":"dialogue","head":638,"speaker":"扎莉·魏特曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20109:20109:12","scriptId":20109,"text":"“哦？那些黏糊糊的东西还有吗？和它们打起来都比和战车兽战斗有趣，快传送我们过去！”","background":"/art/stories/zjm-047.webp","left":608,"right":638,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20109:20109:13","scriptId":20109,"text":"“恩，好的，我这就传送。”","background":"/art/stories/zjm-047.webp","left":608,"right":638,"section":0,"shake":false}],"summaries":[]}
