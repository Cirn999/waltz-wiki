{"schemaVersion":1,"id":-30361,"sections":[{"id":"script-10361","name":"原始脚本 10361","scripts":[10361],"start":0,"count":7}],"frames":[{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-10361:10361:0","scriptId":10361,"text":"“就你们这点三脚猫功夫还想阻止我？”","background":"/art/stories/zjm-047.webp","left":211,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-10361:10361:1","scriptId":10361,"text":"“怎么会，是长官命令我攻击的，而且还要我用魔改技……”","background":"/art/stories/zjm-047.webp","left":211,"right":36,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-10361:10361:2","scriptId":10361,"text":"“嗯？？”","background":"/art/stories/zjm-047.webp","left":219,"right":36,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-10361:10361:3","scriptId":10361,"text":"（我靠……佐伊这家伙，不但办事不利，关键时刻还把我卖了……）","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-10361:10361:4","scriptId":10361,"text":"“那个……好久没看到索菲亚教官英勇的战斗姿态了，于是想拜见一下。”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-10361:10361:5","scriptId":10361,"text":"“哦，这样啊……那我们先回学院再说吧……”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-10361:10361:6","scriptId":10361,"text":"（这下死定了……）","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false}],"summaries":[]}
