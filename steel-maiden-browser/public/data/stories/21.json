{"schemaVersion":1,"id":21,"sections":[{"id":"110010-PROLOGUE","name":"第 1 战 · 战前","scripts":[660],"start":0,"count":5},{"id":"110010-EPILOGUE","name":"第 1 战 · 战后","scripts":[10650],"start":5,"count":9},{"id":"110011-PROLOGUE","name":"第 2 战 · 战前","scripts":[670],"start":14,"count":19},{"id":"110011-EPILOGUE","name":"第 2 战 · 战后","scripts":[10660],"start":33,"count":2},{"id":"110012-PROLOGUE","name":"第 3 战 · 战前","scripts":[680],"start":35,"count":13},{"id":"110012-EPILOGUE","name":"第 3 战 · 战后","scripts":[10670],"start":48,"count":3},{"id":"110013-PROLOGUE","name":"第 4 战 · 战前","scripts":[690],"start":51,"count":4},{"id":"110013-EPILOGUE","name":"第 4 战 · 战后","scripts":[10680],"start":55,"count":3},{"id":"110014-PROLOGUE","name":"第 5 战 · 战前","scripts":[700],"start":58,"count":10},{"id":"110014-EPILOGUE","name":"第 5 战 · 战后","scripts":[10690],"start":68,"count":7}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110010-PROLOGUE:660:2","scriptId":660,"text":"继续向里深入，发现树林里面有好多战车兽的残骸。","background":"/art/stories/zdbjbz-15.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110010-PROLOGUE:660:3","scriptId":660,"text":"“这是你们上次来消灭的战车兽？”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110010-PROLOGUE:660:4","scriptId":660,"text":"“不可能，当时根本没打死多少。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":103,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110010-PROLOGUE:660:5","scriptId":660,"text":"就在这时突然----","background":"/art/stories/zdbjbz-15.webp","left":223,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":92,"speaker":"普莉玛·派普","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110010-PROLOGUE:660:6","scriptId":660,"text":"“哇！！！！”","background":"/art/stories/zdbjbz-15.webp","left":92,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":248,"speaker":"雷娅·古德里安","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110010-EPILOGUE:10650:1","scriptId":10650,"text":"“普莉玛！？发生了什么事情！？”","background":"/art/stories/zdbjbz-15.webp","left":248,"right":103,"section":1,"shake":false},{"kind":"dialogue","head":97,"speaker":"普莉玛·派普","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110010-EPILOGUE:10650:2","scriptId":10650,"text":"“那个……快看那边……”","background":"/art/stories/zdbjbz-15.webp","left":248,"right":97,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110010-EPILOGUE:10650:3","scriptId":10650,"text":"循着普莉玛手指的方向看过去……不由得让雷娅倒吸一口冷气。","background":"/art/stories/zdbjbz-15.webp","left":248,"right":97,"section":1,"shake":false},{"kind":"dialogue","head":256,"speaker":"雷娅·古德里安","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110010-EPILOGUE:10650:4","scriptId":10650,"text":"“这……这里到底发生过什么……”","background":"/art/stories/zdbjbz-15.webp","left":256,"right":97,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110010-EPILOGUE:10650:5","scriptId":10650,"text":"这时其他人也闻讯赶到了。","background":"/art/stories/zdbjbz-15.webp","left":256,"right":97,"section":1,"shake":false},{"kind":"dialogue","head":113,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110010-EPILOGUE:10650:6","scriptId":10650,"text":"“这里……这里简直是战车兽的坟场……”","background":"/art/stories/zdbjbz-15.webp","left":256,"right":113,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110010-EPILOGUE:10650:7","scriptId":10650,"text":"大量的战车兽尸骸堆积在一个巨大的土坑里……","background":"/art/stories/zdbjbz-15.webp","left":256,"right":113,"section":1,"shake":false},{"kind":"dialogue","head":84,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110010-EPILOGUE:10650:8","scriptId":10650,"text":"“怪不得这里有那么大的味道，我还以为只是动物的臭味呢……”","background":"/art/stories/zdbjbz-15.webp","left":84,"right":113,"section":1,"shake":false},{"kind":"dialogue","head":232,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110010-EPILOGUE:10650:9","scriptId":10650,"text":"“这里绝对隐藏着巨大的问题，大家一级戒备！”","background":"/art/stories/zdbjbz-15.webp","left":84,"right":232,"section":1,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:2","scriptId":670,"text":"“那么可以继续前进了？反正这里也就是大堆的战车兽尸体而已。”","background":"/art/stories/zdbjbz-15.webp","left":81,"right":232,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:3","scriptId":670,"text":"“恩，继续前进吧。”","background":"/art/stories/zdbjbz-15.webp","left":81,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:4","scriptId":670,"text":"“先等等。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":108,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:5","scriptId":670,"text":"“……”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":108,"section":2,"shake":false},{"kind":"dialogue","head":110,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:6","scriptId":670,"text":"“还有什么要看的吗？”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":110,"section":2,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:7","scriptId":670,"text":"“这些尸体有个共通点。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":110,"section":2,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:8","scriptId":670,"text":"“除了都是死的好像也没什么了。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":81,"section":2,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:9","scriptId":670,"text":"“……”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":81,"section":2,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:10","scriptId":670,"text":"“这些战车兽身上的装甲被剥离了。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":81,"section":2,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:11","scriptId":670,"text":"“啊，确实，被你这么一说，我也发现了。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":81,"section":2,"shake":false},{"kind":"dialogue","head":240,"speaker":"露米娜·施泰特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:12","scriptId":670,"text":"“而且没有流血的迹象。”","background":"/art/stories/zdbjbz-15.webp","left":240,"right":81,"section":2,"shake":false},{"kind":"dialogue","head":254,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:13","scriptId":670,"text":"“应该说是连血液都没了。”","background":"/art/stories/zdbjbz-15.webp","left":240,"right":254,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110011-PROLOGUE:670:14","scriptId":670,"text":"雷娅一边说着一边翻弄着那些战车兽尸体。","background":"/art/stories/zdbjbz-15.webp","left":240,"right":254,"section":2,"shake":false},{"kind":"dialogue","head":102,"speaker":"普莉玛·派普","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:15","scriptId":670,"text":"“雷娅不要碰啦，那个好脏的……”","background":"/art/stories/zdbjbz-15.webp","left":102,"right":254,"section":2,"shake":false},{"kind":"dialogue","head":247,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:16","scriptId":670,"text":"“习惯啦，调查本来就是脏活。”","background":"/art/stories/zdbjbz-15.webp","left":102,"right":247,"section":2,"shake":false},{"kind":"dialogue","head":254,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:17","scriptId":670,"text":"“恩……尸体的腐烂迹象轻微，全身的血液感觉就像被抽干了一样，加上身上装甲的缺失……”","background":"/art/stories/zdbjbz-15.webp","left":102,"right":254,"section":2,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:18","scriptId":670,"text":"“只有这点情报还远远不够，那么继续前进吧。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":254,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:19","scriptId":670,"text":"“恩，那就继续前进。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110011-PROLOGUE:670:20","scriptId":670,"text":"（这份冷静和观察力，沙狐小队在战场上的经验远远超过我们啊……）","background":"/art/stories/zdbjbz-15.webp","left":223,"right":103,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110011-EPILOGUE:10660:1","scriptId":10660,"text":"离开了那堆战车兽尸体后，继续前进，队伍中的气氛一下子变得非常沉闷。","background":"/art/stories/zdbjbz-15.webp","left":223,"right":103,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110011-EPILOGUE:10660:2","scriptId":10660,"text":"感到吃惊的同时那份挥之不去的疑惑缠绕着众人。","background":"/art/stories/zdbjbz-15.webp","left":223,"right":103,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110012-PROLOGUE:680:2","scriptId":680,"text":"一路深入，但是只是遇到一些零散的战车兽。","background":"/art/stories/zdbjbz-15.webp","left":223,"right":103,"section":4,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110012-PROLOGUE:680:3","scriptId":680,"text":"“搜索了好一阵子了，但是除了那些尸体以外就再也没有别的收获了。”","background":"/art/stories/zdbjbz-15.webp","left":103,"right":103,"section":4,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110012-PROLOGUE:680:4","scriptId":680,"text":"“抱团搜索很影响探索速度的说。”","background":"/art/stories/zdbjbz-15.webp","left":103,"right":81,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110012-PROLOGUE:680:5","scriptId":680,"text":"“但在这种情况下也不能冒然进行分兵搜索，太危险。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":81,"section":4,"shake":false},{"kind":"dialogue","head":99,"speaker":"普莉玛·派普","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110012-PROLOGUE:680:6","scriptId":680,"text":"“是的，万一再遇上那个人形怪物就遭了。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":99,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110012-PROLOGUE:680:7","scriptId":680,"text":"就在大家你一句我一句的讨论时----","background":"/art/stories/zdbjbz-15.webp","left":223,"right":99,"section":4,"shake":false},{"kind":"dialogue","head":84,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110012-PROLOGUE:680:8","scriptId":680,"text":"“啊！”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":84,"section":4,"shake":false},{"kind":"dialogue","head":232,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110012-PROLOGUE:680:9","scriptId":680,"text":"“什么情况！？”","background":"/art/stories/zdbjbz-15.webp","left":232,"right":84,"section":4,"shake":false},{"kind":"dialogue","head":86,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110012-PROLOGUE:680:10","scriptId":680,"text":"“踩到动物的粪便了……真倒霉……”","background":"/art/stories/zdbjbz-15.webp","left":232,"right":86,"section":4,"shake":false},{"kind":"dialogue","head":247,"speaker":"雷娅·古德里安","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110012-PROLOGUE:680:11","scriptId":680,"text":"“莉娜……这不是粪便吧……看看清楚。”","background":"/art/stories/zdbjbz-15.webp","left":247,"right":86,"section":4,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110012-PROLOGUE:680:13","scriptId":680,"text":"“这是什么？看上去确实挺像大块的狗屎……”","background":"/art/stories/zdbjbz-15.webp","left":247,"right":235,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110012-PROLOGUE:680:14","scriptId":680,"text":"“有点弹性，但上面也有点黏糊糊，像鳞片？或者说是某种动物蜕的皮？”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":235,"section":4,"shake":false},{"kind":"dialogue","head":229,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110012-PROLOGUE:680:15","scriptId":680,"text":"“恩，莉娜大功一件，这东西要带回去研究分析下～”","background":"/art/stories/zdbjbz-15.webp","left":229,"right":235,"section":4,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110012-EPILOGUE:10670:1","scriptId":10670,"text":"“这块‘东西’真的是线索？不是什么变异真菌之类的东西？”","background":"/art/stories/zdbjbz-15.webp","left":103,"right":235,"section":5,"shake":false},{"kind":"dialogue","head":84,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110012-EPILOGUE:10670:2","scriptId":10670,"text":"“呃……不要说的那么恶心，为拿着这块‘东西’的人想想……”","background":"/art/stories/zdbjbz-15.webp","left":103,"right":84,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110012-EPILOGUE:10670:3","scriptId":10670,"text":"谁的‘功劳’谁拿着……莉娜一脸嫌弃的拿着这块‘功劳’……","background":"/art/stories/zdbjbz-15.webp","left":103,"right":84,"section":5,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110013-PROLOGUE:690:2","scriptId":690,"text":"“已经离出发有一段时间了，除了刚才块‘线索’之外，也没有别的进展。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":84,"section":6,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110013-PROLOGUE:690:3","scriptId":690,"text":"“考虑到返程所需要的时间，这次搜索差不多已经要进入尾声了。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":235,"section":6,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110013-PROLOGUE:690:4","scriptId":690,"text":"“那么再搜索一小时左右就结束搜索吧，总指挥。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":235,"section":6,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110013-PROLOGUE:690:5","scriptId":690,"text":"“就这样吧。”","background":"/art/stories/zdbjbz-15.webp","left":223,"right":103,"section":6,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110013-EPILOGUE:10680:1","scriptId":10680,"text":"继续漫无目的地搜寻了一小时。","background":"/art/stories/zdbjbz-15.webp","left":223,"right":103,"section":7,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110013-EPILOGUE:10680:2","scriptId":10680,"text":"虽然又发现了一些尸体堆，但除此以外也没什么特别值得注意的东西了。","background":"/art/stories/zdbjbz-15.webp","left":223,"right":103,"section":7,"shake":false},{"kind":"dialogue","head":108,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110013-EPILOGUE:10680:3","scriptId":10680,"text":"“看来这次搜索就到此为止了……准备返程！”","background":"/art/stories/zdbjbz-15.webp","left":108,"right":103,"section":7,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110014-PROLOGUE:700:2","scriptId":700,"text":"在返程的路线上缓慢搜寻，然而也并没有什么可疑的地方。","background":"/art/stories/zdbjbz-15.webp","left":108,"right":103,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110014-PROLOGUE:700:3","scriptId":700,"text":"现在只能寄希望于那块黏糊糊的“东西”了。","background":"/art/stories/zdbjbz-15.webp","left":108,"right":103,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110014-PROLOGUE:700:5","scriptId":700,"text":"与此同时，在马奇诺军事研究所。","background":"/art/stories/zdjm-034.webp","left":108,"right":103,"section":8,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"110014-PROLOGUE:700:6","scriptId":700,"text":"“这里看来是个不错的研究所。”","background":"/art/stories/zdjm-034.webp","left":55,"right":103,"section":8,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"110014-PROLOGUE:700:7","scriptId":700,"text":"“又要开始你那无聊的实验了？”","background":"/art/stories/zdjm-034.webp","left":55,"right":53,"section":8,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"110014-PROLOGUE:700:8","scriptId":700,"text":"“哼，跟你说了你也不会懂。”","background":"/art/stories/zdjm-034.webp","left":55,"right":53,"section":8,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"110014-PROLOGUE:700:9","scriptId":700,"text":"“我也不想懂，先看看有多少东西吃吧～”","background":"/art/stories/zdjm-034.webp","left":55,"right":53,"section":8,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"110014-PROLOGUE:700:10","scriptId":700,"text":"“不要吃太多，不然样本数量会下降的。”","background":"/art/stories/zdjm-034.webp","left":55,"right":53,"section":8,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"110014-PROLOGUE:700:11","scriptId":700,"text":"“知道啦，我先出去看看这个狩猎场有多少猎物。”","background":"/art/stories/zdjm-034.webp","left":55,"right":53,"section":8,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"110014-PROLOGUE:700:12","scriptId":700,"text":"（抓紧时间，我们的存在应该已经开始引起人类的注意了。）","background":"/art/stories/zdjm-034.webp","left":55,"right":53,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110014-EPILOGUE:10690:1","scriptId":10690,"text":"最后还是一无所获，奈乐她们顺利和留守在外的佐伊小队汇合。","background":"/art/stories/zdbjbz-15.webp","left":55,"right":53,"section":9,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"110014-EPILOGUE:10690:2","scriptId":10690,"text":"简单的汇总了一下搜索的情况，众人踏上了返回伏龙芝学院的旅程。","background":"/art/stories/zdbjbz-15.webp","left":55,"right":53,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110014-EPILOGUE:10690:3","scriptId":10690,"text":"“这么说来，这次的搜索并没有遇到那个人形怪物？”","background":"/art/stories/zdbjbz-15.webp","left":3,"right":53,"section":9,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110014-EPILOGUE:10690:4","scriptId":10690,"text":"“能称得上线索的只有莉娜发现的那‘东西’。”","background":"/art/stories/zdbjbz-15.webp","left":3,"right":103,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110014-EPILOGUE:10690:5","scriptId":10690,"text":"“这个东西的颜色有点眼熟啊……可能是那个人形怪物身上的？”","background":"/art/stories/zdbjbz-15.webp","left":3,"right":103,"section":9,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"110014-EPILOGUE:10690:6","scriptId":10690,"text":"“颜色是有点像，但是应该没那么黏糊糊吧。”","background":"/art/stories/zdbjbz-15.webp","left":3,"right":103,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"110014-EPILOGUE:10690:7","scriptId":10690,"text":"“也是……，反正先拿回去给索菲亚教官看看吧。”","background":"/art/stories/zdbjbz-15.webp","left":3,"right":103,"section":9,"shake":false}],"summaries":["又是一堆战车兽，速度消灭。","发现战车兽集体死亡的情况。","继续探索，但是收获甚微。","虽然有所发现，但是剩下的时间不多了。","返程之路比较顺畅，稍微绕了点远路期望还能发现点什么，算是最后的挣扎。"]}
