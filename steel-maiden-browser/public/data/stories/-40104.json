{"schemaVersion":1,"id":-40104,"sections":[{"id":"script-20104","name":"原始脚本 20104","scripts":[20104],"start":0,"count":12}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20104:20104:0","scriptId":20104,"text":"应声倒地的战车兽，化为一团数据消失在扎莉等人面前。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":632,"speaker":"扎莉·魏特曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20104:20104:1","scriptId":20104,"text":"“恩，手感稍微有点轻，并没有真实战斗造成的武器磨损感，这点稍微有所欠缺，不过其他部分都还原得很真实。”","background":"/art/stories/zjm-047.webp","left":632,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":535,"speaker":"伊达·布鲁克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20104:20104:2","scriptId":20104,"text":"“是吗？两下就弄死了，战车兽的实力方面倒也是还原了，真没意思。”","background":"/art/stories/zjm-047.webp","left":632,"right":535,"section":0,"shake":false},{"kind":"dialogue","head":692,"speaker":"米歇尔·法梅加","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20104:20104:3","scriptId":20104,"text":"“确实还是有不少问题，这里的战车兽不会主动进攻，当你踏入了它们的侦察范围时才会有反应。”","background":"/art/stories/zjm-047.webp","left":692,"right":535,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20104:20104:4","scriptId":20104,"text":"“让你们参加真是找对人了～目前系统上的纰漏都可以让你们帮忙检查出来～”","background":"/art/stories/zjm-047.webp","left":692,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":535,"speaker":"伊达·布鲁克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20104:20104:5","scriptId":20104,"text":"“喵！？”","background":"/art/stories/zjm-047.webp","left":535,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20104:20104:6","scriptId":20104,"text":"突然出现的波西娅吓得伊达往后一跳。","background":"/art/stories/zjm-047.webp","left":535,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20104:20104:7","scriptId":20104,"text":"“啊哈～不好意思，那么你们继续～。”","background":"/art/stories/zjm-047.webp","left":535,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20104:20104:8","scriptId":20104,"text":"说完波西娅和最初出现的时候一样，又一下子消失在了模拟世界之中。","background":"/art/stories/zjm-047.webp","left":535,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":632,"speaker":"扎莉·魏特曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20104:20104:9","scriptId":20104,"text":"“真是拿她没办法，那么我们继续向前吧。”","background":"/art/stories/zjm-047.webp","left":632,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":535,"speaker":"伊达·布鲁克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20104:20104:10","scriptId":20104,"text":"“真是吓死我了……”","background":"/art/stories/zjm-047.webp","left":632,"right":535,"section":0,"shake":false},{"kind":"dialogue","head":692,"speaker":"米歇尔·法梅加","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20104:20104:11","scriptId":20104,"text":"“希望一切顺利。”","background":"/art/stories/zjm-047.webp","left":692,"right":535,"section":0,"shake":false}],"summaries":[]}
