{"schemaVersion":1,"id":-40015,"sections":[{"id":"script-20015","name":"原始脚本 20015","scripts":[20015],"start":0,"count":20}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20015:20015:1","scriptId":20015,"text":"炮火声此起彼伏……","background":"/art/stories/zdbjbz-07.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:2","scriptId":20015,"text":"“波西娅！波西娅博士！和刚才说好的不太一样，为什么有阿芙罗拉！那个跟教官是同等级的怪物啊……”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20015:20015:3","scriptId":20015,"text":"然而并无应答……波西娅又不知去向……","background":"/art/stories/zdbjbz-07.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:4","scriptId":20015,"text":"“完了完了……这把真的要抗不住了……”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":593,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:5","scriptId":20015,"text":"“长官不要放弃，至少可以测试一下我们队伍的极限！”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:6","scriptId":20015,"text":"“恩……也对……”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:7","scriptId":20015,"text":"“呵呵～佩妮越来越有副官的样子了～”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":578,"section":0,"shake":false},{"kind":"dialogue","head":588,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:8","scriptId":20015,"text":"“哪有！只是做了我应该做的。”","background":"/art/stories/zdbjbz-07.webp","left":588,"right":578,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20015:20015:9","scriptId":20015,"text":"突然从背后响起了炮火声。","background":"/art/stories/zdbjbz-07.webp","left":588,"right":578,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:10","scriptId":20015,"text":"“前后夹击？还有新的敌人？波西娅没说过啊。”","background":"/art/stories/zdbjbz-07.webp","left":588,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:11","scriptId":20015,"text":"“援军！”","background":"/art/stories/zdbjbz-07.webp","left":596,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20015:20015:12","scriptId":20015,"text":"听到维卡这么一说，我抬头一看——","background":"/art/stories/zdbjbz-07.webp","left":596,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20015:20015:13","scriptId":20015,"text":"是黑色闪电小队！","background":"/art/stories/zdbjbz-07.webp","left":596,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":633,"speaker":"扎莉·魏特曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:14","scriptId":20015,"text":"“波西娅说这里有场硬仗就把我们传送过来了。没想到是阿芙罗拉！太好了！这种级别的对手才值得一战啊！”","background":"/art/stories/zdbjbz-07.webp","left":633,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":702,"speaker":"米歇尔·法梅加","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:15","scriptId":20015,"text":"“队长……注意您的速度，当心履带滑脱……”","background":"/art/stories/zdbjbz-07.webp","left":633,"right":702,"section":0,"shake":false},{"kind":"dialogue","head":535,"speaker":"伊达·布鲁克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:16","scriptId":20015,"text":"“那不是还有你吗？好好援护！我也冲了！”","background":"/art/stories/zdbjbz-07.webp","left":535,"right":702,"section":0,"shake":false},{"kind":"dialogue","head":692,"speaker":"米歇尔·法梅加","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:17","scriptId":20015,"text":"“哎……真是……拿你们没办法……”","background":"/art/stories/zdbjbz-07.webp","left":535,"right":692,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20015:20015:18","scriptId":20015,"text":"黑色闪电小队的加入无疑是对我们亮起了希望之光。","background":"/art/stories/zdbjbz-07.webp","left":535,"right":692,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:19","scriptId":20015,"text":"“配合黑色闪电小队进行反击吧！”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":692,"section":0,"shake":false},{"kind":"dialogue","head":593,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20015:20015:20","scriptId":20015,"text":"“是！”","background":"/art/stories/zdbjbz-07.webp","left":4,"right":593,"section":0,"shake":false}],"summaries":[]}
