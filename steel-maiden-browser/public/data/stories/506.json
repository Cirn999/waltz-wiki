{"schemaVersion":1,"id":506,"sections":[{"id":"1925001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20691],"start":0,"count":16},{"id":"1925001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20692],"start":16,"count":34}],"frames":[{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:3","scriptId":20691,"text":"“怎么回事？这里遭到攻击了？”","background":"/art/stories/zjm-067.webp","left":12,"right":null,"section":0,"shake":true},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:4","scriptId":20691,"text":"“是的，我们遭到了超远距离攻击，那些该死的人类知道了我们据点的坐标。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:5","scriptId":20691,"text":"“结果你放跑了那些钢舞姬，还让她们用远距离炮击攻击我们？？”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:6","scriptId":20691,"text":"“……无地自容。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:7","scriptId":20691,"text":"“你先去加入防御作战，我随后就到。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:8","scriptId":20691,"text":"“麻烦你了。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:9","scriptId":20691,"text":"“看你平时挺能干的，怎么会犯这种错误？”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:10","scriptId":20691,"text":"“因为那些人和阿尔库涅大人有所关联，所以我没下死手，结果让他们反击成功……”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:11","scriptId":20691,"text":"“……”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:12","scriptId":20691,"text":"“原来是那个队伍……唉……”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:13","scriptId":20691,"text":"“阿尔库涅大人并不在他们身边，这明显是个抹消他们的好机会。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:14","scriptId":20691,"text":"“原来还能这样的？”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:15","scriptId":20691,"text":"“唉……你也太老实了，如果你能杀了这帮家伙，泰莱塔大人肯定会很高兴，到时候就算阿尔库涅大人生气也于事无补。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:16","scriptId":20691,"text":"“嗯，我下次会注意的。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:17","scriptId":20691,"text":"“下次？这次的机会不是还在吗？出击吧，这次可别失手了。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"1925001-PROLOGUE:20691:18","scriptId":20691,"text":"“好的！”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1925001-EPILOGUE:20692:1","scriptId":20692,"text":"原计划打算只摧毁旅行者的据点，避免与旅行者交手，但最后还是和她们打了一场。","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:2","scriptId":20692,"text":"“呼……真是危险，伊塔和西格玛联手的攻击不好对付啊……”","background":"/art/stories/zjm-067.webp","left":4,"right":411,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1925001-EPILOGUE:20692:3","scriptId":20692,"text":"虽然已经习惯和旅行者作战，但和指挥官级别的西格玛作战还是略显颓势。","background":"/art/stories/zjm-067.webp","left":4,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:4","scriptId":20692,"text":"“如果不是超远距离炮击成功破坏了据点，我们可就危险了。”","background":"/art/stories/zjm-067.webp","left":4,"right":591,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:5","scriptId":20692,"text":"“是啊，根本就是疲于奔命，没想到她们这次的攻击那么猛烈。”","background":"/art/stories/zjm-067.webp","left":4,"right":591,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1925001-EPILOGUE:20692:6","scriptId":20692,"text":"面对数倍于我们的敌人，只能不停地尝试游击作战。","background":"/art/stories/zjm-067.webp","left":4,"right":591,"section":1,"shake":false},{"kind":"dialogue","head":743,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:7","scriptId":20692,"text":"“跑得我履带快断了。”","background":"/art/stories/zjm-067.webp","left":4,"right":743,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1925001-EPILOGUE:20692:8","scriptId":20692,"text":"佐伊正在紧急抢修自己的履带。","background":"/art/stories/zjm-067.webp","left":4,"right":743,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:9","scriptId":20692,"text":"“回去要谢谢波西娅，要不是顺利破坏据点旅行者是不会选择撤退的，如果拖延下去还真不知道会变成什么样子……”","background":"/art/stories/zjm-067.webp","left":4,"right":743,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1925001-EPILOGUE:20692:11","scriptId":20692,"text":"开始调查据点的废墟，依照以往的经验，迪塔格项圈的解除台座就在这据点中。","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:12","scriptId":20692,"text":"“果然是这里。”","background":"/art/stories/zjm-067.webp","left":4,"right":null,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1925001-EPILOGUE:20692:13","scriptId":20692,"text":"我们在据点废墟的深处找到了权令台座。","background":"/art/stories/zjm-067.webp","left":4,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:14","scriptId":20692,"text":"“来，齐奈达，把手放上去。”","background":"/art/stories/zjm-067.webp","left":4,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:15","scriptId":20692,"text":"“遵命。”","background":"/art/stories/zjm-067.webp","left":4,"right":1137,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1925001-EPILOGUE:20692:16","scriptId":20692,"text":"戴在齐奈达脖子上的项圈突然碎裂了，看样子成功解除了迪塔格项圈。","background":"/art/stories/zjm-067.webp","left":4,"right":1137,"section":1,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:17","scriptId":20692,"text":"“………………………………………………”","background":"/art/stories/zjm-067.webp","left":4,"right":1137,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:18","scriptId":20692,"text":"“感觉怎么样？”","background":"/art/stories/zjm-067.webp","left":4,"right":1137,"section":1,"shake":false},{"kind":"dialogue","head":1138,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:19","scriptId":20692,"text":"“指挥官同志！”","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1925001-EPILOGUE:20692:20","scriptId":20692,"text":"面对齐奈达的飞扑，我一点也开心不起来，因为那力道更像是擒抱……","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:21","scriptId":20692,"text":"“嗯？看样子是恢复了？连对我的称呼都变了。”","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1925001-EPILOGUE:20692:22","scriptId":20692,"text":"之前缺乏生气的齐奈达恢复了血色，而且从她的表情来看精神控制也已经解除了。","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":1,"shake":false},{"kind":"dialogue","head":1138,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:23","scriptId":20692,"text":"“谢谢指挥官同志的救命之恩，我都不知道该说什么好了。”","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:24","scriptId":20692,"text":"“那个……大家都看着呢……”","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":1,"shake":false},{"kind":"dialogue","head":1138,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:25","scriptId":20692,"text":"“啊！”","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1925001-EPILOGUE:20692:26","scriptId":20692,"text":"齐奈达尴尬地从我身边挪开。","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":1,"shake":false},{"kind":"dialogue","head":1138,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:27","scriptId":20692,"text":"“也要谢谢奈特莉，佩妮，佐伊还有维卡～”","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":1,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:28","scriptId":20692,"text":"“小事。”","background":"/art/stories/zjm-067.webp","left":596,"right":1138,"section":1,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:29","scriptId":20692,"text":"“看来还记得我们啊～还担心会从零开始呢，那以后也要多多关照咯～齐奈达～”","background":"/art/stories/zjm-067.webp","left":574,"right":1138,"section":1,"shake":false},{"kind":"dialogue","head":1138,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:30","scriptId":20692,"text":"“嗯～”","background":"/art/stories/zjm-067.webp","left":574,"right":1138,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:31","scriptId":20692,"text":"“看来好像没有记忆缺失？照小说里的桥段，一般都会错乱或者沉睡一段时间呢。”","background":"/art/stories/zjm-067.webp","left":584,"right":1138,"section":1,"shake":false},{"kind":"dialogue","head":1138,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:32","scriptId":20692,"text":"“我都记得啊，只是身体完全不受控制，感觉就像在自己的身体里看电影。”","background":"/art/stories/zjm-067.webp","left":584,"right":1138,"section":1,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:33","scriptId":20692,"text":"“哦哦，我记一下，是个不错的小说材料。”","background":"/art/stories/zjm-067.webp","left":591,"right":1138,"section":1,"shake":false},{"kind":"dialogue","head":748,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:34","scriptId":20692,"text":"“履带修理完毕！唔……我好像错过了什么？”","background":"/art/stories/zjm-067.webp","left":591,"right":748,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1925001-EPILOGUE:20692:35","scriptId":20692,"text":"“回基地吧～终于可以和这个鬼地方说再见了～”","background":"/art/stories/zjm-067.webp","left":4,"right":748,"section":1,"shake":false}],"summaries":[]}
