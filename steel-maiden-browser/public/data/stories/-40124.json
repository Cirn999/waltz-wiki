{"schemaVersion":1,"id":-40124,"sections":[{"id":"script-20124","name":"原始脚本 20124","scripts":[20124],"start":0,"count":35}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20124:20124:1","scriptId":20124,"text":"结果我看了拍摄的内容才恍然大悟……","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:2","scriptId":20124,"text":"（呃……今天是泳装特辑……怪不得之前巴丽娜会那么说……）","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:3","scriptId":20124,"text":"“长官从刚才开始就一直在看巴丽娜她们那边呢～明星果然就是吸引眼球吗？”","background":"/art/stories/zjm-101.webp","left":4,"right":578,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:4","scriptId":20124,"text":"“呃……还好吧……不过这种任务确实少见。”","background":"/art/stories/zjm-101.webp","left":4,"right":578,"section":0,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:5","scriptId":20124,"text":"“嗯～所以长官就要抓紧一切机会多看几眼？”","background":"/art/stories/zjm-101.webp","left":4,"right":582,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:6","scriptId":20124,"text":"“不不……奈特莉又来了，老是喜欢拿我开玩笑，巴丽娜她们这种人群和我们所在的是两个世界啊……”","background":"/art/stories/zjm-101.webp","left":4,"right":582,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:7","scriptId":20124,"text":"“长官，你这样可不好啊，从一开始就擅自将别人划分三六九等。大家可都是平等的钢舞姬啊～”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:8","scriptId":20124,"text":"“是是是～所以我也应该多看你们几眼不是吗？”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":576,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:9","scriptId":20124,"text":"“诶！？那个……我可不是这个意思……”","background":"/art/stories/zjm-101.webp","left":4,"right":576,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:10","scriptId":20124,"text":"“哈哈，没想到奈特莉也有被我套话的一天～”","background":"/art/stories/zjm-101.webp","left":4,"right":576,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:11","scriptId":20124,"text":"“哼～不跟你玩了。对了，刚才我好像看到尤拉和艾丽莎了，佐伊和佩妮好像和她们在说些什么。”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:12","scriptId":20124,"text":"“是呢，她们可不像波西娅那样能二十四小时待在研究室里，出来透透气也很正常啦。”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:13","scriptId":20124,"text":"“论定力，维卡倒是不妨多让～”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20124:20124:14","scriptId":20124,"text":"奈特莉指了指不远处……维卡正环抱双膝坐在高台上对周边进行观察……","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:15","scriptId":20124,"text":"“是啊，每个人都像维卡那样认真，我可就能省心不少了～”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:16","scriptId":20124,"text":"“所以对于维卡，我觉得您还是需要给她点额外奖励呢～您说呢？”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:17","scriptId":20124,"text":"“恩，确实……不过我也不知道维卡喜欢什么啊？”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:18","scriptId":20124,"text":"“送点甜点就好啦～据我所知，其实维卡很喜欢吃甜点的样子哟～”","background":"/art/stories/zjm-101.webp","left":4,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:19","scriptId":20124,"text":"“是这样吗？完全没看出来呢……”","background":"/art/stories/zjm-101.webp","left":4,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:20","scriptId":20124,"text":"“哎……长官平常的观察能力都不错，一到这种事情上面就完全丧失主动权了呢～”","background":"/art/stories/zjm-101.webp","left":4,"right":578,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:21","scriptId":20124,"text":"“维卡每个月都省吃俭用给孤儿院送去固定份额的援助资金，这件事您总知道的吧。”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:22","scriptId":20124,"text":"“恩……听隆美尔将军说起过这事情……”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:23","scriptId":20124,"text":"“那就很简单了啊～之前在桑赫斯特维卡吃得最多的是什么？”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:24","scriptId":20124,"text":"“是什么？”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20124:20124:25","scriptId":20124,"text":"我摇了摇头，而奈特莉也摇了摇头……","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:26","scriptId":20124,"text":"“甜品啊！长官这观察力真是……”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":577,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:27","scriptId":20124,"text":"“因为是免费的，所以维卡那时才放下了顾忌吃得那么投入，您这点都漏看了，真是失职啊。”","background":"/art/stories/zjm-101.webp","left":4,"right":577,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:28","scriptId":20124,"text":"“诶？没有那么严重吧……”","background":"/art/stories/zjm-101.webp","left":4,"right":577,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:29","scriptId":20124,"text":"“唉～多观察观察自己的部下吧～特别是维卡这孩子，你不关心她，她可就一直要那样默默无闻了呀。”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:30","scriptId":20124,"text":"“好吧……我会注意的，谢谢你，奈特莉。”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":580,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:31","scriptId":20124,"text":"“这算是我给你的奖励啦～”","background":"/art/stories/zjm-101.webp","left":4,"right":580,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:32","scriptId":20124,"text":"“诶？奖励？我什么时候做过让你夸奖的事情了？”","background":"/art/stories/zjm-101.webp","left":4,"right":580,"section":0,"shake":false},{"kind":"dialogue","head":577,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:33","scriptId":20124,"text":"“哎……这点上面我觉得长官您还有待锻炼……”","background":"/art/stories/zjm-101.webp","left":4,"right":577,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20124:20124:34","scriptId":20124,"text":"“？？？？”","background":"/art/stories/zjm-101.webp","left":4,"right":577,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20124:20124:35","scriptId":20124,"text":"奈特莉深深地叹了口气……而我则完全不明所以……","background":"/art/stories/zjm-101.webp","left":4,"right":577,"section":0,"shake":false}],"summaries":[]}
