{"schemaVersion":1,"id":505,"sections":[{"id":"1924001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20689],"start":0,"count":15},{"id":"1924001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20690],"start":15,"count":19}],"frames":[{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1924001-PROLOGUE:20689:1","scriptId":20689,"text":"“怎么还没有赶走那批小队……”","background":"/art/stories/zjm-067.webp","left":411,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1924001-PROLOGUE:20689:2","scriptId":20689,"text":"伊塔非常诧异，都派出了好几队人马，但却完全没有达到预期的效果。","background":"/art/stories/zjm-067.webp","left":411,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1924001-PROLOGUE:20689:3","scriptId":20689,"text":"这让在控制台前的伊塔稍微有些焦虑。","background":"/art/stories/zjm-067.webp","left":411,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1924001-PROLOGUE:20689:4","scriptId":20689,"text":"“派过去的队伍都有去无回……这个小队还挺厉害，果然是被阿尔库涅大人看上的队伍。”","background":"/art/stories/zjm-067.webp","left":411,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"1924001-PROLOGUE:20689:5","scriptId":20689,"text":"“再派几队人过去好了……也就一队人，消耗战肯定坚持不了。”","background":"/art/stories/zjm-067.webp","left":411,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-PROLOGUE:20689:8","scriptId":20689,"text":"“呼……敌人变多了呢……”","background":"/art/stories/zdbjbz-04.webp","left":572,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-PROLOGUE:20689:9","scriptId":20689,"text":"“而且对我们位置的把控变得更加精准了……”","background":"/art/stories/zdbjbz-04.webp","left":572,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-PROLOGUE:20689:10","scriptId":20689,"text":"“是的，说明命令的间隔变短了，这意味着什么我想你们都知道了吧。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-PROLOGUE:20689:11","scriptId":20689,"text":"“嗯。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-PROLOGUE:20689:12","scriptId":20689,"text":"“什么意思？”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-PROLOGUE:20689:13","scriptId":20689,"text":"“意味着敌人的指挥塔离我们很近了，我想用不了多久我们就能找到他们的基地了。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-PROLOGUE:20689:14","scriptId":20689,"text":"“终于要找到了啊～”","background":"/art/stories/zdbjbz-04.webp","left":572,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1924001-PROLOGUE:20689:15","scriptId":20689,"text":"果不其然，一个小时之后，我们在一处沙丘找到了一个大型堡垒。","background":"/art/stories/zdbjbz-04.webp","left":572,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1924001-PROLOGUE:20689:16","scriptId":20689,"text":"从外观来看，基本可以确定绝非人类的建筑风格。","background":"/art/stories/zdbjbz-04.webp","left":572,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1924001-PROLOGUE:20689:17","scriptId":20689,"text":"我们终于找到了旅行者的基地。","background":"/art/stories/zdbjbz-04.webp","left":572,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1924001-EPILOGUE:20690:1","scriptId":20690,"text":"和守卫的敌人战斗过之后，我们发现一个严峻的问题……","background":"/art/stories/zdbjbz-04.webp","left":572,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1924001-EPILOGUE:20690:2","scriptId":20690,"text":"这个堡垒的防御力量超过了我们想象。","background":"/art/stories/zdbjbz-04.webp","left":572,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:3","scriptId":20690,"text":"“不行啊……完全攻不进去……敌人的数量太多了。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:4","scriptId":20690,"text":"“这里不会是养殖基地吧……怎么那么多骸虫和战车兽。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:5","scriptId":20690,"text":"“还有少量钢舞姬呢……我都不敢随便装榴弹，生怕错杀……”","background":"/art/stories/zdbjbz-04.webp","left":572,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1924001-EPILOGUE:20690:6","scriptId":20690,"text":"难攻不下的局势非常打击士气，佐伊她们面露难色。","background":"/art/stories/zdbjbz-04.webp","left":572,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:7","scriptId":20690,"text":"“看样子只能用老办法了。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:8","scriptId":20690,"text":"“什么老办法？”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:9","scriptId":20690,"text":"“波西娅的超远距离攻击啊，你们都忘了么。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:10","scriptId":20690,"text":"“呃……那要有人赶回去通知波西娅才行。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:11","scriptId":20690,"text":"“是的……而且那个武器已经不是测试阶段了，借用可是要花不少钱的。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:12","scriptId":20690,"text":"“钱钱钱，就知道钱，现在肯定是命重要啊！”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:13","scriptId":20690,"text":"“也是呢，那我先撤离去最近的中继站联络波西娅，缺了我的指挥你们行不行啊？”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:14","scriptId":20690,"text":"“长官也太傲慢了，我们可都是身经百战的钢舞姬了，缺了你我们只是打不出花哨的战术而已。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:15","scriptId":20690,"text":"“是啊，而且我们又不是白白挨打，可以打带跑嘛～”","background":"/art/stories/zdbjbz-04.webp","left":572,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:16","scriptId":20690,"text":"“好吧，既然你们都这样说了。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:17","scriptId":20690,"text":"“齐奈达，现在我命令你，配合这几位的钢舞姬进行作战，我不在的时候命令由佩妮接管。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":1138,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1924001-EPILOGUE:20690:18","scriptId":20690,"text":"“遵命。”","background":"/art/stories/zdbjbz-04.webp","left":4,"right":1138,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1924001-EPILOGUE:20690:19","scriptId":20690,"text":"我把齐奈达的指挥权转移给了佩妮之后，便开着吉普飞速脱离战场……","background":"/art/stories/zdbjbz-04.webp","left":4,"right":1138,"section":1,"shake":false}],"summaries":[]}
