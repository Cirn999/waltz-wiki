{"schemaVersion":1,"id":-40499,"sections":[{"id":"script-20499","name":"原始脚本 20499","scripts":[20499],"start":0,"count":27}],"frames":[{"kind":"dialogue","head":552,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:1","scriptId":20499,"text":"“嗯……”","background":"/art/stories/zjm-098.webp","left":552,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20499:20499:2","scriptId":20499,"text":"死水的团长维多利亚正在看一份来自特勤局的信。","background":"/art/stories/zjm-098.webp","left":552,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20499:20499:3","scriptId":20499,"text":"每次看到特勤局的来信维多利亚总会皱起眉头，因为这种信件就没有带来过好消息。","background":"/art/stories/zjm-098.webp","left":552,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:4","scriptId":20499,"text":"“是不是发生什么有意思的事情了？”","background":"/art/stories/zjm-098.webp","left":552,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20499:20499:5","scriptId":20499,"text":"说话的是副团长蒂娅，她身着招牌式的黑色正装，从门口走了进来。","background":"/art/stories/zjm-098.webp","left":552,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:6","scriptId":20499,"text":"“连门都不敲。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:7","scriptId":20499,"text":"“嘿嘿～这又没外人，无所谓啦～”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20499:20499:8","scriptId":20499,"text":"蒂娅咧嘴一笑，走到了维多利亚的身旁。","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:9","scriptId":20499,"text":"“也罢，先看看这个吧。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20499:20499:10","scriptId":20499,"text":"维多利亚把信纸递给了蒂娅，另一只手端起了桌上的红茶杯。","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:11","scriptId":20499,"text":"“军备测试？这种时候搞这种玩意？”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20499:20499:12","scriptId":20499,"text":"扫了一眼信中的内容，蒂娅发出了唏嘘。","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:13","scriptId":20499,"text":"“是吧，简直是浪费时间。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:14","scriptId":20499,"text":"“就是啊，真是没事找事。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20499:20499:15","scriptId":20499,"text":"看到蒂娅和自己的意见相同，维多利亚长舒一口气，抿了抿已经有点凉了的格雷伯爵茶。","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:16","scriptId":20499,"text":"“那什么时候开始呢？我好去准备一下～”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:17","scriptId":20499,"text":"“…………”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":554,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:18","scriptId":20499,"text":"“…………嗯？””","background":"/art/stories/zjm-098.webp","left":554,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20499:20499:19","scriptId":20499,"text":"没想到唏嘘过后，蒂娅表现出了一副非常期待的样子，这不由得让维多利亚一时语塞。","background":"/art/stories/zjm-098.webp","left":554,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:20","scriptId":20499,"text":"“因为旅行者的事情，都没办法离开这里，感觉身体都要生锈了。”","background":"/art/stories/zjm-098.webp","left":554,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:21","scriptId":20499,"text":"“那这件事就交给你去处理？”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:22","scriptId":20499,"text":"“没问题啊～不过最后还得您自己来验收。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:23","scriptId":20499,"text":"“你又在打什么鬼主意了？”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:24","scriptId":20499,"text":"“这要弄了之后才知道，我现在只能想到一个模糊的概念”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:25","scriptId":20499,"text":"“你可是死水的副团长，别做什么出格的事情。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:26","scriptId":20499,"text":"“知道知道，我可从来都没做过有损死水形象的事情，会掌握分寸的啦。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20499:20499:27","scriptId":20499,"text":"“好吧……”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false}],"summaries":[]}
