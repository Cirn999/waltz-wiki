{"schemaVersion":1,"id":-40756,"sections":[{"id":"script-20756","name":"原始脚本 20756","scripts":[20756],"start":0,"count":120}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:1","scriptId":20756,"text":"死水团长室——","background":"/art/stories/zjm-098.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:2","scriptId":20756,"text":"“这次要你去处理一件拍摄任务。”","background":"/art/stories/zjm-098.webp","left":547,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:3","scriptId":20756,"text":"“拍摄任务？护卫吗？”","background":"/art/stories/zjm-098.webp","left":547,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:4","scriptId":20756,"text":"由于之前接受过一些拍摄相关的任务，所以自然而然地脱口而出。","background":"/art/stories/zjm-098.webp","left":547,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:5","scriptId":20756,"text":"“不，这次有点特殊，是特勤局宣传部的特派记者，想搞次死水专访。”","background":"/art/stories/zjm-098.webp","left":547,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:6","scriptId":20756,"text":"“我希望你能展现出死水好的一面，毕竟之前旅行者的袭击事件让我们的处境有些微妙。”","background":"/art/stories/zjm-098.webp","left":547,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:7","scriptId":20756,"text":"“应该没什么问题，只是让她同行跟拍正常的战斗任务就行了吧。”","background":"/art/stories/zjm-098.webp","left":547,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:8","scriptId":20756,"text":"“不一定，根据资料来看这位特派记者还是钢舞姬来着，你就由着她的拍摄计划来好了。”","background":"/art/stories/zjm-098.webp","left":547,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:9","scriptId":20756,"text":"“呃……看来会是个麻烦的任务啊，应该有额外的报酬吧？”","background":"/art/stories/zjm-098.webp","left":547,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:10","scriptId":20756,"text":"“那是当然，做得好我还可以追加奖励。”","background":"/art/stories/zjm-098.webp","left":547,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:13","scriptId":20756,"text":"一周后，死水任务大厅——","background":"/art/stories/zjm-099.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:14","scriptId":20756,"text":"“您好，特勤局宣传部的特派记者到了。”","background":"/art/stories/zjm-099.webp","left":null,"right":11,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:15","scriptId":20756,"text":"芮蓓带着一位钢舞姬来到了众人的面前。","background":"/art/stories/zjm-099.webp","left":null,"right":11,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:16","scriptId":20756,"text":"“我是麦伊芽，特勤局记者。”","background":"/art/stories/zjm-099.webp","left":null,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:17","scriptId":20756,"text":"“幸会，我是这次协助你采访的小队负责人。”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:18","scriptId":20756,"text":"“就你一个人吗？我还以为会有一个拍摄小组呢。”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:19","scriptId":20756,"text":"“人多反而不好行动，尤其是我喜欢独自行动。”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:20","scriptId":20756,"text":"“你的舞装挺特殊的，是近战特化的吗？”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:21","scriptId":20756,"text":"“哈哈，如果之后用上的话，你就知道了。”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:22","scriptId":20756,"text":"“好吧……”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:23","scriptId":20756,"text":"“对了，这是我的队员，佐伊和佩妮。”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:24","scriptId":20756,"text":"“你好，我是佩妮·谢尔曼。”","background":"/art/stories/zjm-099.webp","left":584,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:25","scriptId":20756,"text":"“我是佩妮的姐姐，佐伊·谢尔曼。”","background":"/art/stories/zjm-099.webp","left":740,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:26","scriptId":20756,"text":"“哟，还是姐妹啊～这次的专访工作就拜托你们啦。”","background":"/art/stories/zjm-099.webp","left":740,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:27","scriptId":20756,"text":"“小事一桩～”","background":"/art/stories/zjm-099.webp","left":740,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:28","scriptId":20756,"text":"“因为其他的小队成员都在休假，所以人有点少，我还担心护卫人手不够。”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:29","scriptId":20756,"text":"“既然这样，那就把我当做你的临时队员好了，毕竟我也是钢舞姬。”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:30","scriptId":20756,"text":"“诶……？那采访计划呢？”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:31","scriptId":20756,"text":"“本来就没什么计划，跟着你们进行贴身采访也不错。”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:32","scriptId":20756,"text":"“…那…那么自由的吗？”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:33","scriptId":20756,"text":"“那就开始吧，今天你们有什么任务呢？”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:34","scriptId":20756,"text":"“呃……我想想……”","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:35","scriptId":20756,"text":"（没想到会变成这样，原本以为只要配合她就好了……这下反过来了。）","background":"/art/stories/zjm-099.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:38","scriptId":20756,"text":"由于完全没有想到麦伊芽会给出这样的采访方案，于是只能拿出备用计划。","background":"/art/stories/zdbjbz-17.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:39","scriptId":20756,"text":"“那么我们就进行佩妮新舞装的测试吧。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:40","scriptId":20756,"text":"考虑到宣传效果，肯定是展示舞装的战斗力了。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:41","scriptId":20756,"text":"正巧前阵子佩妮的新舞装已经入库，所以就把测试任务选为了预案之一。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:42","scriptId":20756,"text":"“这次的测试地点怎么在航天基地啊？”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":1202,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:43","scriptId":20756,"text":"“因为这里报告出现了战车兽，所以清理战车兽的同时进行舞装测试，一石二鸟。”","background":"/art/stories/zdbjbz-17.webp","left":1202,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:44","scriptId":20756,"text":"“如果再包含采访任务的话，可就是一次劳动三份报酬了哟～”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":747,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:45","scriptId":20756,"text":"“唉……这个财迷……”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":747,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:46","scriptId":20756,"text":"“可以开始了吗？”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:47","scriptId":20756,"text":"“嗯，和报告上的一样，南方出现了疑似战车兽的巢穴，去荡平那里吧。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:48","scriptId":20756,"text":"“麦伊芽就跟在佐伊身边好了，这次作战主要看佩妮的发挥。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:49","scriptId":20756,"text":"“要跟上我喔，可别掉队了。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:50","scriptId":20756,"text":"“哼哼，可不要小瞧我的速度。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:52","scriptId":20756,"text":"于是作战正式开始——","background":"/art/stories/zdbjbz-17.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:53","scriptId":20756,"text":"作为指挥，本人只是负责在高地进行观察。","background":"/art/stories/zdbjbz-17.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:54","scriptId":20756,"text":"“嗯，佩妮已经到达了作战地点。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:55","scriptId":20756,"text":"“援护的佐伊和麦伊芽的话……咦？”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:56","scriptId":20756,"text":"通过望远镜的观察能看到佐伊正在赶往指定地点，而麦伊芽——","background":"/art/stories/zdbjbz-17.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:57","scriptId":20756,"text":"“那是什么……？”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:58","scriptId":20756,"text":"能看到佐伊的身后有一团移动的黑影，速度基本保持和佐伊同步。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:59","scriptId":20756,"text":"“那个难道是麦伊芽的舞装效果？总觉得在哪里见过……”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:60","scriptId":20756,"text":"由于麦伊芽的资料里并没明确记载舞装的型号，所以并不清楚她那套舞装的来路。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1202,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:61","scriptId":20756,"text":"“长官，已经发现战车兽巢穴，是昆虫型，初步推测战车兽数量可能在二十头以上。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1202,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:62","scriptId":20756,"text":"“还挺多啊……不过没有形成包围网的情况下应该还能处理。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1202,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:63","scriptId":20756,"text":"“佩妮先进行第一轮炮击，结束后向佐伊的伏击点撤退。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1202,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:64","scriptId":20756,"text":"“记住，一定要最大火力投射，别吝惜弹药。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1202,"section":0,"shake":false},{"kind":"dialogue","head":1202,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:65","scriptId":20756,"text":"“遵命。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1202,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:66","scriptId":20756,"text":"话音刚落，佩妮方向就开始响起不绝于耳的炮击声。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1202,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:67","scriptId":20756,"text":"“佐伊和麦伊芽听令，炮击结束后佩妮会向你们方向撤退，准备迎敌。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1202,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:68","scriptId":20756,"text":"“好嘞！”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:69","scriptId":20756,"text":"“哼哼～”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1201,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:71","scriptId":20756,"text":"由于佩妮的奇袭，在巢穴外的战车兽受到了重创，新舞装的火力非常猛烈。","background":"/art/stories/zdbjbz-17.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:72","scriptId":20756,"text":"但未受波及的战车兽很快就从混乱中恢复了过来并开始追击佩妮。","background":"/art/stories/zdbjbz-17.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1113,"speaker":"追猎独角仙","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20756:20756:73","scriptId":20756,"text":"“唏！！”","background":"/art/stories/zdbjbz-17.webp","left":null,"right":1113,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:74","scriptId":20756,"text":"大批的昆虫战车兽倾巢而出，数量远比佩妮预估的要多。","background":"/art/stories/zdbjbz-17.webp","left":null,"right":1113,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:75","scriptId":20756,"text":"“不妙，我们低估了昆虫型的繁殖能力，这数量至少在五十头以上啊！！”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1113,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:76","scriptId":20756,"text":"“总之先把领头的那几只干掉！别让佩妮被追上了！”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:77","scriptId":20756,"text":"很快佩妮就撤退到了伏击点，佐伊持续对战车兽进行着火力阻击。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:78","scriptId":20756,"text":"但并没看到麦伊芽发动的攻击，只有佐伊在疯狂倾泻弹药。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:79","scriptId":20756,"text":"“啧，难道那个记者临阵脱逃了？”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:80","scriptId":20756,"text":"“算了，本来也没把她算入战力，她如果能安全跑掉也好。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:81","scriptId":20756,"text":"但昆虫战车兽的数量实在太多，火力阻击收效甚微，很快它们就冲进了佐伊和佩妮所在的掩体。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:82","scriptId":20756,"text":"扬起的烟尘遮蔽了视线，这下就很难对战局进行有效的指挥了。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:83","scriptId":20756,"text":"目前情况非常危急，这次错估了昆虫战车兽的数量，简直是致命的失误。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:84","scriptId":20756,"text":"然而在心里咒骂自己的轻敌行为也不是办法。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:85","scriptId":20756,"text":"“没想到那么快就要用上了……”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:86","scriptId":20756,"text":"我从上衣口袋里掏出了一张小卡片。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:87","scriptId":20756,"text":"“兰布达！！”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:88","scriptId":20756,"text":"一道白光从天而降，旅行者兰布达出现在了高地的一侧——","background":"/art/stories/zdbjbz-17.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:89","scriptId":20756,"text":"“怎么那么快就遇上麻烦了？”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:90","scriptId":20756,"text":"兰布达扫了一眼大量扬尘的方向。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:91","scriptId":20756,"text":"“快！佐伊和佩妮被那些战车兽包围了！”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:92","scriptId":20756,"text":"“……”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:93","scriptId":20756,"text":"兰布达没有作声，下一个瞬间她就化作一道白光射向了尘土飞扬的战场。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:94","scriptId":20756,"text":"“希望还来得及。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:96","scriptId":20756,"text":"兰布达传送到了战场后，很快便发现了昏迷的佐伊和佩妮。","background":"/art/stories/zdbjbz-17.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:97","scriptId":20756,"text":"同时她还发现了几只正在拼命刨沙的昆虫型战车兽，像是要逃离战场的样子。","background":"/art/stories/zdbjbz-17.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:98","scriptId":20756,"text":"但这些虫子就像被钉在了空中一样，根本无法移动。","background":"/art/stories/zdbjbz-17.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:99","scriptId":20756,"text":"“嗯？这是怎么回事？”","background":"/art/stories/zdbjbz-17.webp","left":null,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:100","scriptId":20756,"text":"“这不是兰布达吗？好久不见～你怎么来了？”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:101","scriptId":20756,"text":"“！！”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:102","scriptId":20756,"text":"兰布达一个转身，发现了站在她背后的那个人，然后她立刻单膝跪了下来。","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:103","scriptId":20756,"text":"“麦、麦伊芽大人！？您怎么在这里！？聚合姿态？难道您的义体已经完成了吗！？”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:104","scriptId":20756,"text":"“喂喂，不要用问题来回答我啊，而且你的问题也太多了吧。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:105","scriptId":20756,"text":"“属下罪该万死！我只是遵循阿尔库涅大人的授意帮助那名人类指挥官。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:106","scriptId":20756,"text":"“嗯，跟我从柔那里得到的消息差不多，没想到阿尔库涅竟然那么偏袒人类。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:107","scriptId":20756,"text":"“那您这是……？”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:108","scriptId":20756,"text":"“算是来看看这个人类有什么特别之处吧？目前还有待观察。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:109","scriptId":20756,"text":"“当然我此行来地球的主要目标并不是那个指挥官而是寻找派。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:110","scriptId":20756,"text":"“派？她之前不是被调回星团了吗？而且是很早以前的事情了。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:111","scriptId":20756,"text":"“嗯，她从禁闭室里溜了出来，对此伊莱克特拉非常不高兴，所以就让我来了呗。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:112","scriptId":20756,"text":"“但目前我也没法侦测出派的潜伏位置，所以先让柯西随便给我找了个人类身份，从长计议。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:113","scriptId":20756,"text":"“那……既然您已经处理完了这里的状况，属下就先行告退了……”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:114","scriptId":20756,"text":"“对了，说到义体，我的义体好像也不是完美状态，虽然可以维持聚合姿态但出力并不高的样子。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:115","scriptId":20756,"text":"“非常抱歉，目前我们还没有办法完美调整上位大人们的义体……”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:116","scriptId":20756,"text":"“柔好像也这么说过，不过我那时候没特别在意。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:117","scriptId":20756,"text":"“虽然不知道派犯了什么过错，但属下认为如果有派的协助，义体的调整工作应该可以顺利进行。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:118","scriptId":20756,"text":"“喔？那更要逮住她了。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:119","scriptId":20756,"text":"“那……”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:120","scriptId":20756,"text":"“行吧，这里没你的事了。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1201,"speaker":"麦依芽","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:121","scriptId":20756,"text":"“哦，等等，指挥官那边还得找个理由搪塞过去，你我要对一下口供。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20756:20756:122","scriptId":20756,"text":"“遵命。”","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:123","scriptId":20756,"text":"于是乎，在兰布达的帮助下轻松消灭了那群昆虫战车兽。","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:124","scriptId":20756,"text":"而佐伊和佩妮只是被撞晕了没有大碍，并且兰布达还在她们的附近找到了昏迷的麦伊芽。","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:125","scriptId":20756,"text":"在向总部汇报任务时隐瞒了清剿任务的具体过程，但对内还是告诉了佐伊和佩妮具体的实情。","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:126","scriptId":20756,"text":"庆幸的是麦伊芽好像并不清楚自己是怎么昏迷的，所以兰布达的事情也没必要向她解释。","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20756:20756:127","scriptId":20756,"text":"只不过由于她并没有拍到想要的素材，所以这位记者还会在我的小队逗留一段时间。","background":"/art/stories/zdbjbz-17.webp","left":1201,"right":1198,"section":0,"shake":false}],"summaries":[]}
