{"schemaVersion":1,"id":117,"sections":[{"id":"206067-PROLOGUE","name":"第 1 战 · 战前","scripts":[5670],"start":0,"count":31},{"id":"206067-EPILOGUE","name":"第 1 战 · 战后","scripts":[15670],"start":31,"count":23},{"id":"206068-PROLOGUE","name":"第 2 战 · 战前","scripts":[5680],"start":54,"count":28},{"id":"206068-EPILOGUE","name":"第 2 战 · 战后","scripts":[15680],"start":82,"count":30}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206067-PROLOGUE:5670:2","scriptId":5670,"text":"第二天一早，挖掘工人们便再次启动挖掘项目。","background":"/art/stories/zdbjbz-09.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206067-PROLOGUE:5670:3","scriptId":5670,"text":"不过很快，他们就遇到了问题。","background":"/art/stories/zdbjbz-09.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:4","scriptId":5670,"text":"“诶？洞内好像出现了疑似战车兽的东西？”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:5","scriptId":5670,"text":"“是的，因为已经把挖到的东西都整理到了一起，您可以来过目一下。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:6","scriptId":5670,"text":"“好的。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206067-PROLOGUE:5670:7","scriptId":5670,"text":"在病叶灰人的陪同下，艾莉丝来到了挖掘物的存放区。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:8","scriptId":5670,"text":"“这是战车兽的残骸吧，上次和我们战斗的战车兽应该就是这种零件。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":19,"speaker":"莫夏·梅列茨安娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:9","scriptId":5670,"text":"“是的，这个部分应该是狼型战车兽的后腿吧。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":19,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206067-PROLOGUE:5670:10","scriptId":5670,"text":"莫夏也确认了残骸。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":19,"section":0,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:11","scriptId":5670,"text":"“广间区域的进展比较缓慢，洞顶的部分塌陷了，清理起来需要不少时间。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:12","scriptId":5670,"text":"“一点点来吧，本来也不期望你在几天内就完成全部的清理工作。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:13","scriptId":5670,"text":"“那就继续了，如果有什么新发现我会再来找您的。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:14","scriptId":5670,"text":"“哦，好。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206067-PROLOGUE:5670:15","scriptId":5670,"text":"艾莉丝从洞窟边走到了扎营的帐篷，刚坐下来没几分钟。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":644,"speaker":"玛鲁夏·德米特里耶夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:16","scriptId":5670,"text":"“报告！北边的丛林区域出现了战车兽，死水的佣兵部队已经前去处理。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":644,"section":0,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:17","scriptId":5670,"text":"“旅行者离开以后这里的战车兽又重新活跃了啊。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":644,"section":0,"shake":false},{"kind":"dialogue","head":19,"speaker":"莫夏·梅列茨安娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:18","scriptId":5670,"text":"“我们也准备出击吗？”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":19,"section":0,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:19","scriptId":5670,"text":"“不，这次我们的人手不多，主要负责挖掘场地的安全就行。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":19,"section":0,"shake":false},{"kind":"dialogue","head":19,"speaker":"莫夏·梅列茨安娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:20","scriptId":5670,"text":"“遵命。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":19,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206067-PROLOGUE:5670:21","scriptId":5670,"text":"第二天晚饭时间——","background":"/art/stories/zdbjbz-09.webp","left":7,"right":19,"section":0,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:22","scriptId":5670,"text":"“今天挖掘出了不少战车兽的残骸，有部分还是从未见过的类型。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:23","scriptId":5670,"text":"“说明卡帕研究的战车兽数量很多，这些残骸带回去给科研组进一步研究吧。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:24","scriptId":5670,"text":"“是啊，新种的战车兽肯定有研究价值，应该会得到上层满意的评价吧。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:25","scriptId":5670,"text":"“但反过来想，难道就是旅行者让这些战车兽发生变异的？”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:26","scriptId":5670,"text":"“这些战车兽数量虽少，但个体的独立战斗力都提升了，如果成批出现定会造成难以估量的后果。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:27","scriptId":5670,"text":"“旅行者到底想干什么……强化战车兽对她们有什么好处？”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:28","scriptId":5670,"text":"“说不定她们想通过战车兽征服全世界？”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:29","scriptId":5670,"text":"“…………”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:30","scriptId":5670,"text":"“卡帕可是说过她对钢舞姬也很感兴趣来着……想必有些钢舞姬失踪的案件和她们也脱不了关系。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:31","scriptId":5670,"text":"“这或许只有逮住一个旅行者才能问清楚了。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-PROLOGUE:5670:32","scriptId":5670,"text":"“难度也太大了吧……很难想象怎么赢过她们。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206067-EPILOGUE:15670:2","scriptId":15670,"text":"第三天，挖掘队成功进入了广间，但坍塌的天顶对挖掘造成了相当大的阻碍。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:3","scriptId":15670,"text":"“天顶完全埋住了广间，两台挖掘机轮流工作都鲜有成效……”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:4","scriptId":15670,"text":"“这个广间非常大，现在最多也就挖了五分之一吧。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:5","scriptId":15670,"text":"“洞窟本身无法通过太多的挖掘机，两台就是极限了，所以无法再提高效率了。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:6","scriptId":15670,"text":"“运送泥土和碎屑消耗时间太多了，如果炸开一侧的通道是不是就能加快速度？”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:7","scriptId":15670,"text":"“嗯，说不定是个办法，定点爆破造出一个出口的话……”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206067-EPILOGUE:15670:8","scriptId":15670,"text":"于是按照艾莉丝的方法进行了爆破，成功制造出了另一个出口。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:9","scriptId":15670,"text":"“效率确实增加了很多，以这个速度的话，最多两天应该就可以清理完广间了。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:10","scriptId":15670,"text":"“广间以外的区域不知道会不会有旅行者相关的线索。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:11","scriptId":15670,"text":"“把广间挖穿以后就知道了。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206067-EPILOGUE:15670:12","scriptId":15670,"text":"在挖掘广间的时候发现了不少战车兽的尸骸，根据死因推断应该是没有及时逃离洞窟而被活埋的。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:13","scriptId":15670,"text":"“这些战车兽的尸体非常完整，对于研究来说是非常好的样本。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:14","scriptId":15670,"text":"“没想到还有那么多战车兽……当时我以为已经干掉很多了呢……”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:15","scriptId":15670,"text":"“如果那时候没有早早逃出来的话，肯定会被消耗殆尽……”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206067-EPILOGUE:15670:16","scriptId":15670,"text":"艾莉丝想到这里不禁打了个寒颤。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:17","scriptId":15670,"text":"“旅行者基本无视战车兽的死活，纯粹是把它们当做工具来处理。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:18","scriptId":15670,"text":"“这个就跟我们没关系了，善后部队只负责收集信息和挖掘剩余价值。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:19","scriptId":15670,"text":"“……”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:20","scriptId":15670,"text":"“看来需要呼叫大型的运输车来搬运了呢，我去联系一下，您在这里继续警戒。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:21","scriptId":15670,"text":"“嗯。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206067-EPILOGUE:15670:22","scriptId":15670,"text":"很快，来了两辆更大型的运输车。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:23","scriptId":15670,"text":"“这样的话，运输起来就更快了，省得夜长梦多。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206067-EPILOGUE:15670:24","scriptId":15670,"text":"“是的，快点弄完吧，睡了两天的睡袋感觉腰酸背痛疼……”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-PROLOGUE:5680:2","scriptId":5680,"text":"非常走运，整个施工期间都没有遇到暴雨天气，也没有出现山体滑坡和二次塌方。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-PROLOGUE:5680:3","scriptId":5680,"text":"工程的进展很顺利，预计将会在第六天完成全部的挖掘和清理工作。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:4","scriptId":5680,"text":"“完全无事可做啊……”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":19,"speaker":"莫夏·梅列茨安娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:5","scriptId":5680,"text":"“那可是好事啊，这里本来是战车兽的地盘，应该会频繁遭遇战车兽。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":19,"section":2,"shake":false},{"kind":"dialogue","head":19,"speaker":"莫夏·梅列茨安娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:6","scriptId":5680,"text":"“现在因为旅行者的关系，只有零星的战车兽出没，对我们来说轻松了不少。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":19,"section":2,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:7","scriptId":5680,"text":"“看着挖掘机一车车的运送泥土，很无聊啊。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":19,"section":2,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:8","scriptId":5680,"text":"“不无聊的事情来了。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-PROLOGUE:5680:9","scriptId":5680,"text":"病叶灰人不知从哪里突然冒了出来。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:10","scriptId":5680,"text":"“怎么了？出了什么事情？”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:11","scriptId":5680,"text":"“我们在连接大广间的某个小洞窟里发现了这个。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-PROLOGUE:5680:12","scriptId":5680,"text":"病叶灰人手里拿着一瓶红色的药剂。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:13","scriptId":5680,"text":"“这个难道是之前卡帕给我们的药水！？”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-PROLOGUE:5680:14","scriptId":5680,"text":"艾莉丝迫不及待地从病叶灰人手里抢了过来。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-PROLOGUE:5680:15","scriptId":5680,"text":"经过一系列的仔细端详，艾莉丝非常确定。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:16","scriptId":5680,"text":"“没有错，这瓶子的纹路和我见过的一样，而且里面液体的浓稠程度完全相同。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:17","scriptId":5680,"text":"“您见过这东西？”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:18","scriptId":5680,"text":"“这种液体可以瞬间将钢舞姬过载的状态恢复，非常神奇。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:19","scriptId":5680,"text":"“喔？已经知道这种药水的效果了啊。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:20","scriptId":5680,"text":"“不，只能说对钢舞姬的过载有效，对其他症状有没有效果还不知道，而且副作用什么的也不清楚。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:21","scriptId":5680,"text":"“那确实需要送去研究室进行进一步的分析。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:22","scriptId":5680,"text":"“如果能研究出成分并且量产的话，钢舞姬的战斗力应该会有一个飞跃的提升。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:23","scriptId":5680,"text":"“…………”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:24","scriptId":5680,"text":"“看来今天的收获不错啊，这可是重要的突破。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-PROLOGUE:5680:25","scriptId":5680,"text":"艾莉丝将红色的药水还给了病叶灰人。","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:26","scriptId":5680,"text":"“嗯，谢谢夸奖。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:27","scriptId":5680,"text":"“从进度上看，明天就是最后一天了吧。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":67,"speaker":"病叶灰人","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:28","scriptId":5680,"text":"“是的，就剩与大广间相连的几个小洞窟了，顺利的话明天就可以收工了。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-PROLOGUE:5680:29","scriptId":5680,"text":"“那我也是时候准备开始写报告了。”","background":"/art/stories/zdbjbz-09.webp","left":7,"right":67,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-EPILOGUE:15680:2","scriptId":15680,"text":"和病叶灰人的合作顺利完成，艾莉丝也上交了她的调查报告。","background":"/art/stories/zjm-066.webp","left":7,"right":67,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-EPILOGUE:15680:3","scriptId":15680,"text":"就这样过去了一周。","background":"/art/stories/zjm-066.webp","left":7,"right":67,"section":3,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:4","scriptId":15680,"text":"“唉……又是没反应啊……”","background":"/art/stories/zjm-066.webp","left":7,"right":67,"section":3,"shake":false},{"kind":"dialogue","head":19,"speaker":"莫夏·梅列茨安娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:5","scriptId":15680,"text":"“老爷可能在忙吧，没看到您的报告。”","background":"/art/stories/zjm-066.webp","left":7,"right":19,"section":3,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:6","scriptId":15680,"text":"“不行，我得去找他。”","background":"/art/stories/zjm-066.webp","left":7,"right":19,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-EPILOGUE:15680:7","scriptId":15680,"text":"就在这时，玛鲁夏跑了进来。","background":"/art/stories/zjm-066.webp","left":7,"right":19,"section":3,"shake":false},{"kind":"dialogue","head":644,"speaker":"玛鲁夏·德米特里耶夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:8","scriptId":15680,"text":"“特勤局来了一大队人，说是要找艾莉丝。”","background":"/art/stories/zjm-066.webp","left":7,"right":644,"section":3,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:9","scriptId":15680,"text":"“嗯？找我？”","background":"/art/stories/zjm-066.webp","left":7,"right":644,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-EPILOGUE:15680:10","scriptId":15680,"text":"还没等艾莉丝出门，特勤局的人就进到了艾莉丝的办公室。","background":"/art/stories/zjm-066.webp","left":7,"right":644,"section":3,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:11","scriptId":15680,"text":"“洛伦斯还有克莱尔？”","background":"/art/stories/zjm-066.webp","left":7,"right":644,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-EPILOGUE:15680:12","scriptId":15680,"text":"正当艾莉丝还在惊讶的时候，洛伦斯说道。","background":"/art/stories/zjm-066.webp","left":7,"right":644,"section":3,"shake":false},{"kind":"dialogue","head":967,"speaker":"洛伦斯·尼维尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:13","scriptId":15680,"text":"“艾莉丝·戴高乐，涉嫌泄露特勤局重要情报，使特勤局蒙受重大损失，现在我们要对你进行调查。”","background":"/art/stories/zjm-066.webp","left":7,"right":967,"section":3,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:14","scriptId":15680,"text":"“啊？这是怎么回事？”","background":"/art/stories/zjm-066.webp","left":7,"right":967,"section":3,"shake":false},{"kind":"dialogue","head":966,"speaker":"克莱尔·杜邦","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:15","scriptId":15680,"text":"“我们也想知道啊……你调查旅行者的事情也就算了，怎么还参与泄密？”","background":"/art/stories/zjm-066.webp","left":7,"right":966,"section":3,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:16","scriptId":15680,"text":"“我可没做过对不起特勤局的事情啊。”","background":"/art/stories/zjm-066.webp","left":7,"right":966,"section":3,"shake":false},{"kind":"dialogue","head":967,"speaker":"洛伦斯·尼维尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:17","scriptId":15680,"text":"“先跟我们上车吧，押送到总部再说，戴将军也在那里等你。”","background":"/art/stories/zjm-066.webp","left":7,"right":967,"section":3,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:18","scriptId":15680,"text":"“诶？父亲也在？”","background":"/art/stories/zjm-066.webp","left":7,"right":967,"section":3,"shake":false},{"kind":"dialogue","head":967,"speaker":"洛伦斯·尼维尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:19","scriptId":15680,"text":"“是啊，他老人家的脸色相当的不好看啊……”","background":"/art/stories/zjm-066.webp","left":7,"right":967,"section":3,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:20","scriptId":15680,"text":"“…………”","background":"/art/stories/zjm-066.webp","left":7,"right":967,"section":3,"shake":false},{"kind":"dialogue","head":19,"speaker":"莫夏·梅列茨安娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:21","scriptId":15680,"text":"“我也能一起去吗？”","background":"/art/stories/zjm-066.webp","left":19,"right":967,"section":3,"shake":false},{"kind":"dialogue","head":967,"speaker":"洛伦斯·尼维尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:22","scriptId":15680,"text":"“呃，倒是没传唤莫夏，但考虑你们之间的关系，一起去也没什么问题。”","background":"/art/stories/zjm-066.webp","left":19,"right":967,"section":3,"shake":false},{"kind":"dialogue","head":19,"speaker":"莫夏·梅列茨安娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:23","scriptId":15680,"text":"“谢谢。”","background":"/art/stories/zjm-066.webp","left":19,"right":967,"section":3,"shake":false},{"kind":"dialogue","head":967,"speaker":"洛伦斯·尼维尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:24","scriptId":15680,"text":"“谢就不必了，我得先跟你们撇清关系，倒时候上头迁怒到我可就不好了……”","background":"/art/stories/zjm-066.webp","left":19,"right":967,"section":3,"shake":false},{"kind":"dialogue","head":966,"speaker":"克莱尔·杜邦","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:25","scriptId":15680,"text":"“先给你们提个醒，感觉这次上面很重视旅行者的问题，对你们的处罚可就不好说了。”","background":"/art/stories/zjm-066.webp","left":19,"right":966,"section":3,"shake":false},{"kind":"dialogue","head":7,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:26","scriptId":15680,"text":"“这样啊……”","background":"/art/stories/zjm-066.webp","left":7,"right":966,"section":3,"shake":false},{"kind":"dialogue","head":967,"speaker":"洛伦斯·尼维尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:27","scriptId":15680,"text":"“克莱尔，少多嘴，人都齐了的话，就出发吧。”","background":"/art/stories/zjm-066.webp","left":7,"right":967,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-EPILOGUE:15680:28","scriptId":15680,"text":"于是玛鲁夏和多萝作为基地看守留下，其他人前往特勤局总部。","background":"/art/stories/zjm-066.webp","left":7,"right":967,"section":3,"shake":false},{"kind":"dialogue","head":11,"speaker":"芮蓓","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"206068-EPILOGUE:15680:31","scriptId":15680,"text":"“之后的剧情正在施工中……”","background":"/art/stories/zjm-054.webp","left":11,"right":null,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-EPILOGUE:15680:32","scriptId":15680,"text":"…………","background":"/art/stories/zjm-054.webp","left":11,"right":null,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"206068-EPILOGUE:15680:33","scriptId":15680,"text":"…………待续","background":"/art/stories/zjm-054.webp","left":11,"right":null,"section":3,"shake":false}],"summaries":[]}
