{"schemaVersion":1,"id":40,"sections":[{"id":"115007-PROLOGUE","name":"第 1 战 · 战前","scripts":[1330],"start":0,"count":20},{"id":"115007-EPILOGUE","name":"第 1 战 · 战后","scripts":[11320],"start":20,"count":15},{"id":"115008-PROLOGUE","name":"第 2 战 · 战前","scripts":[1340],"start":35,"count":26},{"id":"115008-EPILOGUE","name":"第 2 战 · 战后","scripts":[11330],"start":61,"count":13},{"id":"115009-PROLOGUE","name":"第 3 战 · 战前","scripts":[1350],"start":74,"count":11},{"id":"115009-EPILOGUE","name":"第 3 战 · 战后","scripts":[11340],"start":85,"count":15}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115007-PROLOGUE:1330:2","scriptId":1330,"text":"教官打开背包，把里面的东西拿了出来。","background":"/art/stories/zdbjbz-04.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":475,"speaker":"达克妮·戴维斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:4","scriptId":1330,"text":"“这软趴趴的是什么啊？”","background":"/art/stories/zdbjbz-04.webp","left":475,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:5","scriptId":1330,"text":"“看上去好恶心……”","background":"/art/stories/zdbjbz-04.webp","left":475,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":445,"speaker":"瓦什蒂·布雷德利","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:6","scriptId":1330,"text":"“好像还在动……”","background":"/art/stories/zdbjbz-04.webp","left":445,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:7","scriptId":1330,"text":"“浇水了以后这东西好像更活跃了。”","background":"/art/stories/zdbjbz-04.webp","left":445,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":92,"speaker":"普莉玛·派普","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:8","scriptId":1330,"text":"“周围的液体开始消退了，好神奇。”","background":"/art/stories/zdbjbz-04.webp","left":92,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:9","scriptId":1330,"text":"“教官大人，这是什么？？”","background":"/art/stories/zdbjbz-04.webp","left":92,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:10","scriptId":1330,"text":"“这个……其实就是那个不明物质啊……”","background":"/art/stories/zdbjbz-04.webp","left":211,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:11","scriptId":1330,"text":"“诶！？怎么变得那么油光光的了……我刚发现的时候可是很脏的说……”","background":"/art/stories/zdbjbz-04.webp","left":211,"right":81,"section":0,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:12","scriptId":1330,"text":"“恩，在马奇诺实验室里我把这个东西清洗了下，然后放了点实验药品做反应测试。”","background":"/art/stories/zdbjbz-04.webp","left":211,"right":81,"section":0,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:13","scriptId":1330,"text":"“没想到内核的蛋白酶开始活性化并且生物特征也出现了……”","background":"/art/stories/zdbjbz-04.webp","left":211,"right":81,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:14","scriptId":1330,"text":"“蛋白酶……生物特征……什么意思……”","background":"/art/stories/zdbjbz-04.webp","left":211,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:15","scriptId":1330,"text":"“就是说这个东西活了啦，还能动，那可以起个名字了吧～BT物质怎么样～”","background":"/art/stories/zdbjbz-04.webp","left":211,"right":81,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:16","scriptId":1330,"text":"“恩，说起来好像是可以命个名，那既然是莉娜发现的就叫L-蛋白质吧，简称LP。”","background":"/art/stories/zdbjbz-04.webp","left":219,"right":81,"section":0,"shake":false},{"kind":"dialogue","head":86,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:17","scriptId":1330,"text":"“啊？只留了个L？”","background":"/art/stories/zdbjbz-04.webp","left":219,"right":86,"section":0,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:18","scriptId":1330,"text":"“这本来就是代替名，其实我个人更想叫它X-蛋白质，给你留个L是最大的让步了～”","background":"/art/stories/zdbjbz-04.webp","left":211,"right":86,"section":0,"shake":false},{"kind":"dialogue","head":86,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:19","scriptId":1330,"text":"“好吧……LP就LP了……”","background":"/art/stories/zdbjbz-04.webp","left":211,"right":86,"section":0,"shake":false},{"kind":"dialogue","head":469,"speaker":"雷思丽·戴维斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:21","scriptId":1330,"text":"“前方发现少量战车兽，准备迎战了！”","background":"/art/stories/zdbjbz-04.webp","left":469,"right":86,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:22","scriptId":1330,"text":"“收到。那先散了，都进入战斗状态！”","background":"/art/stories/zdbjbz-04.webp","left":469,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-PROLOGUE:1330:23","scriptId":1330,"text":"“是！”","background":"/art/stories/zdbjbz-04.webp","left":81,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115007-EPILOGUE:11320:2","scriptId":11320,"text":"终于回到了伏龙芝学院。","background":"/art/stories/zjm-090.webp","left":81,"right":3,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115007-EPILOGUE:11320:3","scriptId":11320,"text":"一行人在校门口----","background":"/art/stories/zjm-090.webp","left":81,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-EPILOGUE:11320:4","scriptId":11320,"text":"“那么我们就在这里分道扬镳吧～”","background":"/art/stories/zjm-090.webp","left":211,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":460,"speaker":"雷思丽·戴维斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-EPILOGUE:11320:5","scriptId":11320,"text":"“恩，我们会在这里稍作补给，然后继续前往胜利女神特勤局总部。”","background":"/art/stories/zjm-090.webp","left":211,"right":460,"section":1,"shake":false},{"kind":"dialogue","head":475,"speaker":"达克妮·戴维斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-EPILOGUE:11320:6","scriptId":11320,"text":"“吃饭吃饭～好久没吃过像样的东西了。”","background":"/art/stories/zjm-090.webp","left":475,"right":460,"section":1,"shake":false},{"kind":"dialogue","head":460,"speaker":"雷思丽·戴维斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-EPILOGUE:11320:7","scriptId":11320,"text":"“就知道吃……”","background":"/art/stories/zjm-090.webp","left":475,"right":460,"section":1,"shake":false},{"kind":"dialogue","head":440,"speaker":"瓦什蒂·布雷德利","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-EPILOGUE:11320:8","scriptId":11320,"text":"“那我们就告辞了……”","background":"/art/stories/zjm-090.webp","left":440,"right":460,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115007-EPILOGUE:11320:9","scriptId":11320,"text":"背后冷不丁传来了瓦什蒂的声音，吓了我一跳。","background":"/art/stories/zjm-090.webp","left":440,"right":460,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-EPILOGUE:11320:10","scriptId":11320,"text":"“哦哦！好，那么就此别过了。”","background":"/art/stories/zjm-090.webp","left":440,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-EPILOGUE:11320:11","scriptId":11320,"text":"（存在感好低，这个队伍到底谁是队长……）","background":"/art/stories/zjm-090.webp","left":440,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":87,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-EPILOGUE:11320:12","scriptId":11320,"text":"“咻咻～又在看大胸妹子了！”","background":"/art/stories/zjm-090.webp","left":87,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-EPILOGUE:11320:13","scriptId":11320,"text":"“长官这个大色鬼！！”","background":"/art/stories/zjm-090.webp","left":87,"right":41,"section":1,"shake":false},{"kind":"dialogue","head":112,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115007-EPILOGUE:11320:14","scriptId":11320,"text":"“胸大有什么好的……”","background":"/art/stories/zjm-090.webp","left":112,"right":41,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115007-EPILOGUE:11320:15","scriptId":11320,"text":"“真是服了你们了……好了好了，我们也找个地方休息下吧。”","background":"/art/stories/zjm-090.webp","left":112,"right":3,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115007-EPILOGUE:11320:16","scriptId":11320,"text":"告别了利爪小队，我们也跟随教官的步伐向着伏龙芝学院大楼走去。","background":"/art/stories/zjm-090.webp","left":112,"right":3,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115008-PROLOGUE:1340:2","scriptId":1340,"text":"马奇诺研究所事件算是告了一个段落，奈乐她们预定向隆美尔司令报告详细情况，所以也离开了伏龙芝学院。","background":"/art/stories/zjm-090.webp","left":112,"right":3,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115008-PROLOGUE:1340:3","scriptId":1340,"text":"昨天晚上和索菲亚教官一起忙到很晚，自然是为了整理那该死的报告书……","background":"/art/stories/zjm-090.webp","left":112,"right":3,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115008-PROLOGUE:1340:4","scriptId":1340,"text":"于是睡到了中午才起来，不过由于没有下一步任务，我准备去图书馆打发时间。","background":"/art/stories/zjm-090.webp","left":112,"right":3,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115008-PROLOGUE:1340:5","scriptId":1340,"text":"刚离开休息室，就看到一个陌生的钢舞姬站在门口。","background":"/art/stories/zjm-090.webp","left":112,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":175,"speaker":"伊诺·赞佩里尼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:6","scriptId":1340,"text":"“您好……是佐伊的长官吗？”","background":"/art/stories/zjm-090.webp","left":175,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:7","scriptId":1340,"text":"“没错，你是哪位？”","background":"/art/stories/zjm-090.webp","left":175,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":183,"speaker":"伊诺·赞佩里尼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:8","scriptId":1340,"text":"“啊，忘记报名字了，我是伊诺·赞佩里尼。”","background":"/art/stories/zjm-090.webp","left":183,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:9","scriptId":1340,"text":"“那么有什么事吗？”","background":"/art/stories/zjm-090.webp","left":183,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:10","scriptId":1340,"text":"“等等……是不是佐伊又在哪里捅娄子了？”","background":"/art/stories/zjm-090.webp","left":183,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":175,"speaker":"伊诺·赞佩里尼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:11","scriptId":1340,"text":"“不是不是，是索菲亚教官来让我叫你过去一下……佐伊因为正在打扫学校的仓库忙不过来。”","background":"/art/stories/zjm-090.webp","left":175,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:12","scriptId":1340,"text":"“恩，了解了，那么我们走吧。”","background":"/art/stories/zjm-090.webp","left":175,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:13","scriptId":1340,"text":"（教官叫我？那准没好事……我还打算休息下呢……）","background":"/art/stories/zjm-090.webp","left":175,"right":3,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115008-PROLOGUE:1340:15","scriptId":1340,"text":"来到了索菲亚教官所在的会议室----","background":"/art/stories/zjm-047.webp","left":175,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:16","scriptId":1340,"text":"“恩，来了啊。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:17","scriptId":1340,"text":"“是的，教官大人有什么吩咐。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:18","scriptId":1340,"text":"“没什么，就是想让你帮我代下课，也就几天而已。我现在正在忙于LP的分析工作，过几天可能还会有专家团队过来一起配合分析工作。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:19","scriptId":1340,"text":"“代课！？我这水平行吗？”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:20","scriptId":1340,"text":"“不用太谦虚，在实战方面你的经验已经很丰富了，基础课程都比较简单的，理论课更不用说了。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:21","scriptId":1340,"text":"“好吧……把课程表和相关的教科书给我看看……”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:22","scriptId":1340,"text":"（我的天，还要当代课老师，这都什么情况啊……当我是万能打杂的？）","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:23","scriptId":1340,"text":"“恩～就这么定了～我记得下节课是野外教学。”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:24","scriptId":1340,"text":"“我靠，这也太危险了吧……”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:25","scriptId":1340,"text":"“你说什么？？”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:26","scriptId":1340,"text":"“啊……没什么，护卫的钢舞姬有吗……野外教学是钢舞姬的独有课程。”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:27","scriptId":1340,"text":"“没事没事，有辅佐的，是不会发生安全问题的。”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-PROLOGUE:1340:28","scriptId":1340,"text":"“希望如此……”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115008-EPILOGUE:11330:0","scriptId":11330,"text":"野外教学中……","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-EPILOGUE:11330:2","scriptId":11330,"text":"“呼……呼……上来就是战车兽？虽然数量比实战要少，但这也太危险了吧……”","background":"/art/stories/zjm-090.webp","left":3,"right":3,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115008-EPILOGUE:11330:3","scriptId":11330,"text":"野外教学是在学校周边以小队形式对付少量战车兽，也是新手钢舞姬的必修课。","background":"/art/stories/zjm-090.webp","left":3,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-EPILOGUE:11330:4","scriptId":11330,"text":"“前排那个……叫什么来着……”","background":"/art/stories/zjm-090.webp","left":3,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-EPILOGUE:11330:5","scriptId":11330,"text":"“是卡莉丹，长官。”","background":"/art/stories/zjm-090.webp","left":3,"right":115,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-EPILOGUE:11330:6","scriptId":11330,"text":"“啊！对，卡莉丹，往前去点，你现在这个位置是作为侦察来说是完全没有效果的！”","background":"/art/stories/zjm-090.webp","left":3,"right":115,"section":3,"shake":false},{"kind":"dialogue","head":43,"speaker":"卡莉丹","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-EPILOGUE:11330:7","scriptId":11330,"text":"“是，长官！”","background":"/art/stories/zjm-090.webp","left":3,"right":43,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-EPILOGUE:11330:8","scriptId":11330,"text":"“啊～谢谢芙琳，我对记忆学生名字这种事情不太在行啊。”","background":"/art/stories/zjm-090.webp","left":3,"right":43,"section":3,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-EPILOGUE:11330:9","scriptId":11330,"text":"“毕竟是第一次，没关系的。”","background":"/art/stories/zjm-090.webp","left":3,"right":115,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-EPILOGUE:11330:10","scriptId":11330,"text":"“不过没想到是芙琳做辅佐。”","background":"/art/stories/zjm-090.webp","left":3,"right":115,"section":3,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-EPILOGUE:11330:11","scriptId":11330,"text":"“恩，基本上离毕业已经不远了，所以课程不是很多，经常帮教官们做点琐事。”","background":"/art/stories/zjm-090.webp","left":3,"right":115,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115008-EPILOGUE:11330:12","scriptId":11330,"text":"“恩恩，有这份心意就很不错了。”","background":"/art/stories/zjm-090.webp","left":3,"right":115,"section":3,"shake":false},{"kind":"dialogue","head":119,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115008-EPILOGUE:11330:13","scriptId":11330,"text":"“哪里哪里……您过奖了。”","background":"/art/stories/zjm-090.webp","left":3,"right":119,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115009-PROLOGUE:1350:2","scriptId":1350,"text":"虽然是临时教学，但是自己读书和教人读书完全是两个不同层面上的事情……","background":"/art/stories/zjm-047.webp","left":3,"right":119,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115009-PROLOGUE:1350:3","scriptId":1350,"text":"这几天下来算是完全了解教学是件多么麻烦的事情……","background":"/art/stories/zjm-047.webp","left":3,"right":119,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115009-PROLOGUE:1350:4","scriptId":1350,"text":"“上午第二节课是战车理论和结构知识，第三节课是战车护理常识课，下午是什么来着？”","background":"/art/stories/zjm-047.webp","left":3,"right":119,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115009-PROLOGUE:1350:5","scriptId":1350,"text":"摸了摸口袋，发现忘带了课程表……","background":"/art/stories/zjm-047.webp","left":3,"right":119,"section":4,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115009-PROLOGUE:1350:6","scriptId":1350,"text":"“下午是军事战略研究和体能训练课。”","background":"/art/stories/zjm-047.webp","left":3,"right":115,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115009-PROLOGUE:1350:7","scriptId":1350,"text":"“哦哦，真是帮大忙了，怪不得索菲亚教官让芙琳来辅佐，真是太贴心了。”","background":"/art/stories/zjm-047.webp","left":3,"right":115,"section":4,"shake":false},{"kind":"dialogue","head":119,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115009-PROLOGUE:1350:8","scriptId":1350,"text":"“主要是户外课程的护卫工作和一些日程表，并没有什么大不了的啦。”","background":"/art/stories/zjm-047.webp","left":3,"right":119,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115009-PROLOGUE:1350:9","scriptId":1350,"text":"“要不，晚上一起吃个饭？我请客，就当是谢谢你的辅助工作。”","background":"/art/stories/zjm-047.webp","left":3,"right":119,"section":4,"shake":false},{"kind":"dialogue","head":123,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115009-PROLOGUE:1350:10","scriptId":1350,"text":"“好啊～”","background":"/art/stories/zjm-047.webp","left":3,"right":123,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115009-PROLOGUE:1350:11","scriptId":1350,"text":"一边的角落里，一双眼睛正盯着这两人……","background":"/art/stories/zjm-047.webp","left":3,"right":123,"section":4,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115009-PROLOGUE:1350:12","scriptId":1350,"text":"“我说这两天怎么一直看不见长官，原来在这里鬼混……”","background":"/art/stories/zjm-047.webp","left":3,"right":40,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115009-EPILOGUE:11340:1","scriptId":11340,"text":"作为人类来说，我在野外对付战车兽的经验已经非常充足，即便在没有钢舞姬的护卫下也能随机应变。","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115009-EPILOGUE:11340:2","scriptId":11340,"text":"所以也向军官学生们提供了一些在野外遭遇战车兽的应对方法。","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115009-EPILOGUE:11340:3","scriptId":11340,"text":"这些作为辅助教学的题材也受到了其他教官的好评。","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115009-EPILOGUE:11340:4","scriptId":11340,"text":"帮索菲亚教官代课快一周了，差不多她那边也应该完事了吧，抱着这样的想法，我准备去研究室找一下教官。","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":216,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115009-EPILOGUE:11340:6","scriptId":11340,"text":"“这下可麻烦了……这么说LP其实还有感应功能？那么我们可能已经被敌人锁定了位置？”","background":"/art/stories/zjm-047.webp","left":216,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":487,"speaker":"缪妮亚·阿罗谢娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115009-EPILOGUE:11340:7","scriptId":11340,"text":"“应该是这样，LP的体内一直散发着微弱的生态电波，而这电波一直在往一个特定的方向传送……”","background":"/art/stories/zjm-047.webp","left":216,"right":487,"section":5,"shake":false},{"kind":"dialogue","head":216,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115009-EPILOGUE:11340:8","scriptId":11340,"text":"“那我们这边能不能反向锁定敌人的位置？”","background":"/art/stories/zjm-047.webp","left":216,"right":487,"section":5,"shake":false},{"kind":"dialogue","head":487,"speaker":"缪妮亚·阿罗谢娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115009-EPILOGUE:11340:9","scriptId":11340,"text":"“从这生态电波的递减速度来反推的话，应该可以确定一个大概位置。”","background":"/art/stories/zjm-047.webp","left":216,"right":487,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115009-EPILOGUE:11340:10","scriptId":11340,"text":"刚来到研究室门口，就听到里面教官的声音，于是我就敲了敲门。","background":"/art/stories/zjm-047.webp","left":216,"right":487,"section":5,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115009-EPILOGUE:11340:11","scriptId":11340,"text":"“进来。”","background":"/art/stories/zjm-047.webp","left":211,"right":487,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115009-EPILOGUE:11340:12","scriptId":11340,"text":"“那个……教官大人，已经快一周，我想代课的事情应该差不多了吧？”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"115009-EPILOGUE:11340:13","scriptId":11340,"text":"教官看了看我，愣了一下，然后眼睛里散发出异样的光芒……","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"115009-EPILOGUE:11340:14","scriptId":11340,"text":"“恩，来的正好～代课问题没什么了，我有新的任务交给你～”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115009-EPILOGUE:11340:15","scriptId":11340,"text":"“什么！？”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"115009-EPILOGUE:11340:16","scriptId":11340,"text":"（我擦，这可真是我自找麻烦啊……看教官这脸色，肯定是什么麻烦的任务……）","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":5,"shake":false}],"summaries":["完全不知道教官在干什么","成功返回伏龙芝","马奇诺研究所事件也算是告一段落了。","教人读书真是挺麻烦的……"]}
