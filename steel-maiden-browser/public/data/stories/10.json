{"schemaVersion":1,"id":10,"sections":[{"id":"108001-PROLOGUE","name":"第 1 战 · 战前","scripts":[290,291,292,293],"start":0,"count":84},{"id":"108001-EPILOGUE","name":"第 1 战 · 战后","scripts":[10280],"start":84,"count":5},{"id":"108002-PROLOGUE","name":"第 2 战 · 战前","scripts":[300],"start":89,"count":6},{"id":"108002-EPILOGUE","name":"第 2 战 · 战后","scripts":[10290],"start":95,"count":4},{"id":"108003-PROLOGUE","name":"第 3 战 · 战前","scripts":[310,311,312,313],"start":99,"count":12},{"id":"108003-EPILOGUE","name":"第 3 战 · 战后","scripts":[10300,10301,10302,10303],"start":111,"count":36}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:290:2","scriptId":290,"text":"齐格菲研究所的某处","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:290:3","scriptId":290,"text":"“储备的粮食差不多要吃完了，要去下一个狩猎场了呀。”","background":"/art/stories/zdjm-034.webp","left":53,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:290:4","scriptId":290,"text":"“还不是因为你太能吃了。”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:290:5","scriptId":290,"text":"“啊哈哈哈哈～～话说，之前我遇到钢舞姬了哟。”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:290:6","scriptId":290,"text":"(又岔开话题了……算了……）","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:290:7","scriptId":290,"text":"“你被钢舞姬看到了？”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:290:8","scriptId":290,"text":"“本来想试吃看看的～结果让她们逃了。”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:290:9","scriptId":290,"text":"“你脑袋里除了吃还有别的吗！？”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:290:10","scriptId":290,"text":"（不过这个狩猎场的粮食也所剩无几，是时候离开了……）","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:290:13","scriptId":290,"text":"距离遭遇人形怪物已经过去了1个月之久。前线指挥部","background":"/art/stories/zjm-066.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:290:14","scriptId":290,"text":"“总部还没有给出回信吗？真是太让人着急了。”","background":"/art/stories/zjm-066.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:290:15","scriptId":290,"text":"“长官不要太着急嘛，耐心等待奈乐的回音就行了。”","background":"/art/stories/zjm-066.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:290:16","scriptId":290,"text":"“总部的对应速度真是慢得可以，”","background":"/art/stories/zjm-066.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:290:17","scriptId":290,"text":"就在这时，莱尼拿着一包文件袋匆匆忙忙的跑了进来。","background":"/art/stories/zjm-066.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:290:18","scriptId":290,"text":"“报告！”","background":"/art/stories/zjm-066.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:290:19","scriptId":290,"text":"“哦！来了吗！？”","background":"/art/stories/zjm-066.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:290:20","scriptId":290,"text":"“没错，这是总部的急件。”","background":"/art/stories/zjm-066.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:290:21","scriptId":290,"text":"我迫不及待的撕开文件的封条，阅读起信件的内容。","background":"/art/stories/zjm-066.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:290:22","scriptId":290,"text":"“等它好久了，准备出发！！”","background":"/art/stories/zjm-066.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:290:23","scriptId":290,"text":"“诶！？又是什么都不说就出发了？”","background":"/art/stories/zjm-066.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:290:24","scriptId":290,"text":"“时不我待。”","background":"/art/stories/zjm-066.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:291:2","scriptId":291,"text":"齐格菲研究所的某处","background":"/art/stories/zdjm-034.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:291:3","scriptId":291,"text":"“储备的粮食差不多要吃完了，要去下一个狩猎场了呀。”","background":"/art/stories/zdjm-034.webp","left":53,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:291:4","scriptId":291,"text":"“还不是因为你太能吃了。”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:291:5","scriptId":291,"text":"“啊哈哈哈哈～～话说，之前我遇到钢舞姬了哟。”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:291:6","scriptId":291,"text":"(又岔开话题了……算了……）","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:291:7","scriptId":291,"text":"“你被钢舞姬看到了？”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:291:8","scriptId":291,"text":"“本来想试吃看看的～结果让她们逃了。”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:291:9","scriptId":291,"text":"“你脑袋里除了吃还有别的吗！？”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:291:10","scriptId":291,"text":"（不过这个狩猎场的粮食也所剩无几，是时候离开了……）","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:291:13","scriptId":291,"text":"距离遭遇人形怪物已经过去了1个月之久。前线指挥部","background":"/art/stories/zjm-066.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:291:14","scriptId":291,"text":"“总部还没有给出回信吗？真是太让人着急了。”","background":"/art/stories/zjm-066.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:291:15","scriptId":291,"text":"“长官不要太着急嘛，耐心等待奈乐的回音就行了。”","background":"/art/stories/zjm-066.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:291:16","scriptId":291,"text":"“总部的对应速度真是慢得可以，”","background":"/art/stories/zjm-066.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:2