r":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:292:9","scriptId":292,"text":"“你脑袋里除了吃还有别的吗！？”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:292:10","scriptId":292,"text":"（不过这个狩猎场的粮食也所剩无几，是时候离开了……）","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:292:13","scriptId":292,"text":"距离遭遇人形怪物已经过去了1个月之久。前线指挥部","background":"/art/stories/zjm-066.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:292:14","scriptId":292,"text":"“总部还没有给出回信吗？真是太让人着急了。”","background":"/art/stories/zjm-066.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:292:15","scriptId":292,"text":"“长官不要太着急嘛，耐心等待奈乐的回音就行了。”","background":"/art/stories/zjm-066.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:292:16","scriptId":292,"text":"“总部的对应速度真是慢得可以，”","background":"/art/stories/zjm-066.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:292:17","scriptId":292,"text":"就在这时，嘉丝莉拿着一包文件袋匆匆忙忙的跑了进来。","background":"/art/stories/zjm-066.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:292:18","scriptId":292,"text":"“我回来了，有新的报告。”","background":"/art/stories/zjm-066.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:292:19","scriptId":292,"text":"“哦！来了吗！？”","background":"/art/stories/zjm-066.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:292:20","scriptId":292,"text":"“没错，这是总部的急件。”","background":"/art/stories/zjm-066.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:292:21","scriptId":292,"text":"我迫不及待的撕开文件的封条，阅读起信件的内容。","background":"/art/stories/zjm-066.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:292:22","scriptId":292,"text":"“等它好久了，准备出发！！”","background":"/art/stories/zjm-066.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:292:23","scriptId":292,"text":"“诶！？又是什么都不说就出发了？”","background":"/art/stories/zjm-066.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:292:24","scriptId":292,"text":"“时不我待。”","background":"/art/stories/zjm-066.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:293:2","scriptId":293,"text":"齐格菲研究所的某处","background":"/art/stories/zdjm-034.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:293:3","scriptId":293,"text":"“储备的粮食差不多要吃完了，要去下一个狩猎场了呀。”","background":"/art/stories/zdjm-034.webp","left":53,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:293:4","scriptId":293,"text":"“还不是因为你太能吃了。”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:293:5","scriptId":293,"text":"“啊哈哈哈哈～～话说，之前我遇到钢舞姬了哟。”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:293:6","scriptId":293,"text":"(又岔开话题了……算了……）","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:293:7","scriptId":293,"text":"“你被钢舞姬看到了？”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:293:8","scriptId":293,"text":"“本来想试吃看看的～结果让她们逃了。”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:293:9","scriptId":293,"text":"“你脑袋里除了吃还有别的吗！？”","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"108001-PROLOGUE:293:10","scriptId":293,"text":"（不过这个狩猎场的粮食也所剩无几，是时候离开了……）","background":"/art/stories/zdjm-034.webp","left":53,"right":55,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:293:13","scriptId":293,"text":"距离遭遇人形怪物已经过去了1个月之久。前线指挥部","background":"/art/stories/zjm-066.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:293:14","scriptId":293,"text":"“总部还没有给出回信吗？真是太让人着急了。”","background":"/art/stories/zjm-066.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:293:15","scriptId":293,"text":"“长官不要太着急嘛，耐心等待奈乐的回音就行了。”","background":"/art/stories/zjm-066.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:293:16","scriptId":293,"text":"“总部的对应速度真是慢得可以，”","background":"/art/stories/zjm-066.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:293:17","scriptId":293,"text":"就在这时，陈雯兰拿着一包文件袋匆匆忙忙的跑了进来。","background":"/art/stories/zjm-066.webp","left":3,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:293:18","scriptId":293,"text":"“总部的报告出来了。”","background":"/art/stories/zjm-066.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:293:19","scriptId":293,"text":"“哦！来了吗！？”","background":"/art/stories/zjm-066.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:293:20","scriptId":293,"text":"“是的，顺便还有些慰问品。”","background":"/art/stories/zjm-066.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108001-PROLOGUE:293:21","scriptId":293,"text":"我迫不及待的撕开文件的封条，阅读起信件的内容。","background":"/art/stories/zjm-066.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:293:22","scriptId":293,"text":"“等它好久了，准备出发！！”","background":"/art/stories/zjm-066.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:293:23","scriptId":293,"text":"“诶！？又是什么都不说就出发了？”","background":"/art/stories/zjm-066.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-PROLOGUE:293:24","scriptId":293,"text":"“时不我待。”","background":"/art/stories/zjm-066.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-EPILOGUE:10280:1","scriptId":10280,"text":"“这是要去哪里？”","background":"/art/stories/zdbjbz-07.webp","left":31,"right":40,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-EPILOGUE:10280:2","scriptId":10280,"text":"“去一个你熟悉的地方。”","background":"/art/stories/zdbjbz-07.webp","left":31,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-EPILOGUE:10280:3","scriptId":10280,"text":"“我熟悉的地方？”","background":"/art/stories/zdbjbz-07.webp","left":41,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108001-EPILOGUE:10280:4","scriptId":10280,"text":"“伏龙芝学院啦。”","background":"/art/stories/zdbjbz-07.webp","left":41,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108001-EPILOGUE:10280:5","scriptId":10280,"text":"“诶？”","background":"/art/stories/zdbjbz-07.webp","left":41,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108002-PROLOGUE:300:2","scriptId":300,"text":"“我们要去伏龙芝学院听听索菲亚教授的意见。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108002-PROLOGUE:300:3","scriptId":300,"text":"“呃……索菲亚教官……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108002-PROLOGUE:300:4","scriptId":300,"text":"“对，索菲亚·马利诺夫娜，既是伏龙芝学院的教官，同时也是战车兽权威研究者之一。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108002-PROLOGUE:300:5","scriptId":300,"text":"“每次假想战术报告都要我重写个三四次……简直是魔鬼……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108002-PROLOGUE:300:6","scriptId":300,"text":"“……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108002-PROLOGUE:300:7","scriptId":300,"text":"(战术课的报告一般都是一次就过的吧……)","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108002-EPILOGUE:10290:1","scriptId":10290,"text":"通往伏龙芝学院的路途非常遥远，当然也不乏战车兽的骚扰。","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108002-EPILOGUE:10290:2","scriptId":10290,"text":"为了对抗战车兽，在世界各地都配上了可供军事补给的中继站。","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108002-EPILOGUE:10290:3","scriptId":10290,"text":"“以前我就在想了，把学院造在战车兽穴附近，真是疯狂的校长。”","background":"/art/stories/zdbjbz-07.webp","left":41,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108002-EPILOGUE:10290:4","scriptId":10290,"text":"“为了进行实训锻炼而且方便研究战车兽的生态，一箭双雕。”","background":"/art/stories/zdbjbz-07.webp","left":41,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-PROLOGUE:310:2","scriptId":310,"text":"“恩？前方的小镇在冒烟？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108003-PROLOGUE:310:3","scriptId":310,"text":"“学院周围的小镇都是废弃的工事，可能正有学生队伍在进行模拟演练吧。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-PROLOGUE:310:4","scriptId":310,"text":"“那我们就先绕开，从河道走吧。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-PROLOGUE:311:2","scriptId":311,"text":"“恩？前方的小镇在冒烟？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108003-PROLOGUE:311:3","scriptId":311,"text":"“学院周围的小镇都是废弃的工事，可能正有学生队伍在进行模拟演练吧。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-PROLOGUE:311:4","scriptId":311,"text":"“那我们就先绕开，从河道走吧。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-PROLOGUE:312:2","scriptId":312,"text":"“恩？前方的小镇在冒烟？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":4,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108003-PROLOGUE:312:3","scriptId":312,"text":"“不知道啊，要不去侦查一下？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1146,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-PROLOGUE:312:4","scriptId":312,"text":"“不，我们就先绕开，从河道走吧。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1146,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-PROLOGUE:313:2","scriptId":313,"text":"“恩？前方的小镇在冒烟？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1146,"section":4,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108003-PROLOGUE:313:3","scriptId":313,"text":"“那种瓦砾堆称不上是小镇，可能是类似打靶场的地方吧。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1158,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-PROLOGUE:313:4","scriptId":313,"text":"“那我们就先绕开，从河道走吧。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1158,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108003-EPILOGUE:10300:1","scriptId":10300,"text":"日落西山，我们到达了一个废弃的中继站。","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1158,"section":5,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-EPILOGUE:10300:2","scriptId":10300,"text":"“这个中继站我们以前实训演习的时候也使用过，真是怀念啊。”","background":"/art/stories/zdbjbz-07.webp","left":31,"right":1158,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108003-EPILOGUE:10300:3","scriptId":10300,"text":"伏龙芝学院每半学期就会进行一次实训演习。","background":"/art/stories/zdbjbz-07.webp","left":31,"right":1158,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108003-EPILOGUE:10300:4","scriptId":10300,"text":"学生们会按小组被分配到各个中继站进行实训演习课程。","background":"/art/stories/zdbjbz-07.webp","left":31,"right":1158,"section":5,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108003-EPILOGUE:10300:5","scriptId":10300,"text":"“那我先站第一班岗，接下来依次是佐伊、拉伊莎，最后是长官。”","background":"/art/stories/zdbjbz-07.webp","left":31,"right":61,"section":5,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-EPILOGUE:10300:6","scriptId":10300,"text":"“好的。”","background":"/art/stories/zdbjbz-07.webp","left":71,"right":61,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108003-EPILOGUE:10300:7","scriptId":10300,"text":"“诶？我也要！？”","background":"/art/stories/zdbjbz-07.webp","left":71,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-EPILOGUE:10300:8","scriptId":10300,"text":"“最后一班岗自然是责任最大的人来站咯。”","background":"/art/stories/zdbjbz-07.webp","left":39,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108003-EPILOGUE:10300:9","scriptId":10300,"text":"“……好吧。”","background":"/art/stories/zdbjbz-07.webp","left":39,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108003-EPILOGUE:10301:1","scriptId":10301,"text":"日落西山，我们到达了一个废弃的中继站。","background":"/art/stories/zdbjbz-07.webp","left":39,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-EPILOGUE:10301:2","scriptId":10301,"text":"“这个中继站我们以前实训演习的时候也使用过，真是怀念啊。”","background":"/art/stories/zdbjbz-07.webp","left":31,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108003-EPILOGUE:10301:3","scriptId":10301,"text":"伏龙芝学院每半学期就会进行一次实训演习。","background":"/art/stories/zdbjbz-07.webp","left":31,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108003-EPILOGUE:10301:4","scriptId":10301,"text":"学生们会按小组被分配到各个中继站进行实训演习课程。","background":"/art/stories/zdbjbz-07.webp","left":31,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108003-EPILOGUE:10301:5","scriptId":10301,"text":"“那我先站第一班岗，接下来依次是佐伊、拉伊莎，最后是长官。”","background":"/art/stories/zdbjbz-07.webp","left":31,"right":1171,"section":5,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-EPILOGUE:10301:6","scriptId":10301,"text":"“好的。”","background":"/art/stories/zdbjbz-07.webp","left":71,"right":1171,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108003-EPILOGUE:10301:7","scriptId":10301,"text":"“诶？我也要！？”","background":"/art/stories/zdbjbz-07.webp","left":71,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108003-EPILOGUE:10301:8","scriptId":10301,"text":"“最后一班岗自然是责任最大的人来站咯。”","background":"/art/stories/zdbjbz-07.webp","left":39,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108003-EPILOGUE:10301:9","scriptId":10301,"text":"“……好吧。”","background":"/art/stories/zdbjbz-07.webp","left":39,"right":3,"section":5,"shake":false},{"kind":"na