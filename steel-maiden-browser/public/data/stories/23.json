{"schemaVersion":1,"id":23,"sections":[{"id":"111004-PROLOGUE","name":"第 1 战 · 战前","scripts":[740,741,742,743],"start":0,"count":63},{"id":"111004-EPILOGUE","name":"第 1 战 · 战后","scripts":[10730],"start":63,"count":5},{"id":"111005-PROLOGUE","name":"第 2 战 · 战前","scripts":[750],"start":68,"count":18},{"id":"111005-EPILOGUE","name":"第 2 战 · 战后","scripts":[10740],"start":86,"count":8},{"id":"111006-PROLOGUE","name":"第 3 战 · 战前","scripts":[760],"start":94,"count":7},{"id":"111006-EPILOGUE","name":"第 3 战 · 战后","scripts":[10750],"start":101,"count":4}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:740:2","scriptId":740,"text":"侦察任务算是顺利完成，索菲亚教官也很满意。","background":"/art/stories/zjm-090.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:740:3","scriptId":740,"text":"起了个大早准备返回基地。","background":"/art/stories/zjm-090.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:740:4","scriptId":740,"text":"“差不多也该回基地了，估计那个破基地又要长草了吧……”","background":"/art/stories/zjm-090.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:740:5","scriptId":740,"text":"来到学院的大门口，看见莱尼和拉伊莎已经等在那儿了。","background":"/art/stories/zjm-090.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:740:6","scriptId":740,"text":"“那我们就先回去了。”","background":"/art/stories/zjm-090.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:740:7","scriptId":740,"text":"“跟着长官东奔西跑的把自己的主要职务都懈怠了。”","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:740:8","scriptId":740,"text":"“恩？我们不是一起回去的吗？还有佐伊呢？”","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:740:9","scriptId":740,"text":"“诶！？长官大人没接到通知吗？”","background":"/art/stories/zjm-090.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:740:10","scriptId":740,"text":"“什么通知？”","background":"/art/stories/zjm-090.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:740:11","scriptId":740,"text":"“通知上写着你和佐伊要在伏龙芝学院多滞留一段时间，执行上级任务。”","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:740:12","scriptId":740,"text":"“？？？？”","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:740:13","scriptId":740,"text":"“那我们先走咯，不用担心，我们会代替长官把基地管理好的～”","background":"/art/stories/zjm-090.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:740:14","scriptId":740,"text":"说完莱尼和拉伊莎就向我打了个招呼转身离开了。","background":"/art/stories/zjm-090.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:740:15","scriptId":740,"text":"“上级任务？？我怎么没听说过？？”","background":"/art/stories/zjm-090.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:741:2","scriptId":741,"text":"侦察任务算是顺利完成，索菲亚教官也很满意。","background":"/art/stories/zjm-090.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:741:3","scriptId":741,"text":"起了个大早准备返回基地。","background":"/art/stories/zjm-090.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:741:4","scriptId":741,"text":"“差不多也该回基地了，估计那个破基地又要长草了吧……”","background":"/art/stories/zjm-090.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:741:5","scriptId":741,"text":"来到学院的大门口，看见莱尼和拉伊莎已经等在那儿了。","background":"/art/stories/zjm-090.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:741:6","scriptId":741,"text":"“那我们就先回去了。”","background":"/art/stories/zjm-090.webp","left":3,"right":1171,"section":0,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:741:7","scriptId":741,"text":"“跟着长官东奔西跑的把自己的主要职务都懈怠了。”","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:741:8","scriptId":741,"text":"“恩？我们不是一起回去的吗？还有佐伊呢？”","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:741:9","scriptId":741,"text":"“诶！？长官大人没接到通知吗？”","background":"/art/stories/zjm-090.webp","left":3,"right":1171,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:741:10","scriptId":741,"text":"“什么通知？”","background":"/art/stories/zjm-090.webp","left":3,"right":1171,"section":0,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:741:11","scriptId":741,"text":"“通知上写着你和佐伊要在伏龙芝学院多滞留一段时间，执行上级任务。”","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:741:12","scriptId":741,"text":"“？？？？”","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:741:13","scriptId":741,"text":"“而且我也该回到原来的队伍了，虽然事出有因，不过这种临时任务我觉得也挺有意思的。”","background":"/art/stories/zjm-090.webp","left":3,"right":1171,"section":0,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:741:14","scriptId":741,"text":"“有缘的话，我们会在战场上再相见的。”","background":"/art/stories/zjm-090.webp","left":3,"right":1171,"section":0,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:741:15","scriptId":741,"text":"“那我们先走咯，不用担心，我会代替长官把基地管理好的～”","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:741:16","scriptId":741,"text":"“嗯，那我就代替佐伊和你们告别了。”","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:741:17","scriptId":741,"text":"卓娅和拉伊莎向我道别之后便离开了学院。","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:741:18","scriptId":741,"text":"（哎？上级任务？？我怎么没听说过？？）","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:742:2","scriptId":742,"text":"侦察任务算是顺利完成，索菲亚教官也很满意。","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:742:3","scriptId":742,"text":"起了个大早准备返回基地。","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:742:4","scriptId":742,"text":"“差不多也该回基地了，估计那个破基地又要长草了吧……”","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:742:5","scriptId":742,"text":"来到学院的大门口，看见莱尼和拉伊莎已经等在那儿了。","background":"/art/stories/zjm-090.webp","left":3,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:742:6","scriptId":742,"text":"“那我们就先走一步了。”","background":"/art/stories/zjm-090.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:742:7","scriptId":742,"text":"“确实，好久没和队伍联络了，估计要被骂了。”","background":"/art/stories/zjm-090.webp","left":3,"right":968,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:742:8","scriptId":742,"text":"“恩？我们不是一起回去的吗？还有佐伊呢？”","background":"/art/stories/zjm-090.webp","left":3,"right":968,"section":0,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:742:9","scriptId":742,"text":"“诶！？长官大人没接到通知吗？”","background":"/art/stories/zjm-090.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:742:10","scriptId":742,"text":"“什么通知？”","background":"/art/stories/zjm-090.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:742:11","scriptId":742,"text":"“通知上写着你和佐伊要在伏龙芝学院多滞留一段时间，执行上级任务。”","background":"/art/stories/zjm-090.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:742:12","scriptId":742,"text":"“？？？？”","background":"/art/stories/zjm-090.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:742:13","scriptId":742,"text":"“本来也是临时队伍，能和长官一起跑任务也是一种缘分吧，再见咯~”","background":"/art/stories/zjm-090.webp","left":3,"right":968,"section":0,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:742:14","scriptId":742,"text":"“毕竟我的主要编制还是基地方面的防卫部队，和长官一起行动也差不多到极限了。”","background":"/art/stories/zjm-090.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:742:15","scriptId":742,"text":"“那你们也多保重了。”","background":"/art/stories/zjm-090.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:742:16","scriptId":742,"text":"说完索菲和嘉丝莉就向我打了个招呼转身离开了。","background":"/art/stories/zjm-090.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:742:17","scriptId":742,"text":"（等等，上级任务？？我怎么没听说过？？）","background":"/art/stories/zjm-090.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:743:2","scriptId":743,"text":"侦察任务算是顺利完成，索菲亚教官也很满意。","background":"/art/stories/zjm-090.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:743:3","scriptId":743,"text":"起了个大早准备返回基地。","background":"/art/stories/zjm-090.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:743:4","scriptId":743,"text":"“差不多也该回基地了，估计那个破基地又要长草了吧……”","background":"/art/stories/zjm-090.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:743:5","scriptId":743,"text":"来到学院的大门口，看见莱尼和拉伊莎已经等在那儿了。","background":"/art/stories/zjm-090.webp","left":3,"right":1146,"section":0,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:743:6","scriptId":743,"text":"“那我们就准备回学院了。”","background":"/art/stories/zjm-090.webp","left":3,"right":1170,"section":0,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:743:7","scriptId":743,"text":"“这次的出游也挺长时间了，是时候回学院了。”","background":"/art/stories/zjm-090.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:743:8","scriptId":743,"text":"“恩？我们不是一起回去的吗？还有佐伊呢？”","background":"/art/stories/zjm-090.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:743:9","scriptId":743,"text":"“诶！？长官大人没接到通知吗？”","background":"/art/stories/zjm-090.webp","left":3,"right":1170,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:743:10","scriptId":743,"text":"“什么通知？”","background":"/art/stories/zjm-090.webp","left":3,"right":1170,"section":0,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:743:11","scriptId":743,"text":"“通知上写着你和佐伊要在伏龙芝学院多滞留一段时间，执行上级任务。”","background":"/art/stories/zjm-090.webp","left":3,"right":1170,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:743:12","scriptId":743,"text":"“？？？？”","background":"/art/stories/zjm-090.webp","left":3,"right":1170,"section":0,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:743:13","scriptId":743,"text":"“本来我们也不是长官的编制只是临时队伍，不过依旧是度过了一段很有意思的时光。\"","background":"/art/stories/zjm-090.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:743:14","scriptId":743,"text":"\"就此别过了。”","background":"/art/stories/zjm-090.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:743:15","scriptId":743,"text":"“嗯，那你们也多保重了。”","background":"/art/stories/zjm-090.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-PROLOGUE:743:16","scriptId":743,"text":"陈雯兰和夏虹萤向我鞠躬行礼之后便离开了。","background":"/art/stories/zjm-090.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-PROLOGUE:743:17","scriptId":743,"text":"“等等，她们说有上级任务？？我怎么没听说过？？”","background":"/art/stories/zjm-090.webp","left":3,"right":1158,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111004-EPILOGUE:10730:1","scriptId":10730,"text":"一脸迷茫地回到宿舍，看到佐伊已经等在门口了。","background":"/art/stories/zjm-090.webp","left":3,"right":1158,"section":1,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-EPILOGUE:10730:2","scriptId":10730,"text":"“长官一早去哪插科打诨了？”","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-EPILOGUE:10730:3","scriptId":10730,"text":"“什么情况？我还想问呢？搜索任务完成，不是应该回基地了吗？”","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":1,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111004-EPILOGUE:10730:4","scriptId":10730,"text":"“啊，先不说这个了，索菲亚教官正在会议室等着呢。”","background":"/art/stories/zjm-090.webp","left":3,"right":31,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111004-EPILOGUE:10730:5","scriptId":10730,"text":"（到底是怎么回事？怎么感觉就我一个人不在状况内？）","background":"/art/stories/zjm-090.webp","left":3,"right":31,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111005-PROLOGUE:750:2","scriptId":750,"text":"随着佐伊来到了会议室----","background":"/art/stories/zjm-047.webp","left":3,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":225,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:3","scriptId":750,"text":"“早上好。”","background":"/art/stories/zjm-047.webp","left":225,"right":31,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111005-PROLOGUE:750:4","scriptId":750,"text":"会议室里沙狐小队已经就位，而猎虎小队也在。","background":"/art/stories/zjm-047.webp","left":225,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:5","scriptId":750,"text":"“既然都到齐了，那我就开始了。”","background":"/art/stories/zjm-047.webp","left":211,"right":31,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:6","scriptId":750,"text":"“等等等……现在是什么情况？”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:7","scriptId":750,"text":"“……”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:8","scriptId":750,"text":"“也对，昨天汇报的时候你小子没来啊，胆子不小，等会儿再处理你。”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:9","scriptId":750,"text":"“诶！？汇报不是奈乐的事情吗，和我没有关系吧……”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:10","scriptId":750,"text":"“闭嘴，那我在重复一遍这次任务的内容，为了缺席的某人。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:11","scriptId":750,"text":"“这次我们伏龙芝学院要和桑赫斯特军事学院进行联合军演。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:12","scriptId":750,"text":"“额，桑赫斯特……那个贵族学校？”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":212,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:13","scriptId":750,"text":"“我们不能给伏龙芝学院丢脸，一定要胜过桑赫斯特的那群小兔崽子！”","background":"/art/stories/zjm-047.webp","left":212,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:14","scriptId":750,"text":"“难道要我当裁判？”","background":"/art/stories/zjm-047.webp","left":212,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":221,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:15","scriptId":750,"text":"“当裁判？你还不够格。你和佐伊还有猎虎小队，作为伏龙芝的代表出战。而沙狐小队则作为这次军演的特邀嘉宾。”","background":"/art/stories/zjm-047.webp","left":221,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:16","scriptId":750,"text":"“嗯！？我们不是都已经毕业了么……毕业生参加学校的军演这明显是犯规吧……”","background":"/art/stories/zjm-047.webp","left":221,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":221,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:17","scriptId":750,"text":"“你们只要活在这世界上一天，就永远都是伏龙芝学院的学生，理解了吗？”","background":"/art/stories/zjm-047.webp","left":221,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:18","scriptId":750,"text":"“了解……”","background":"/art/stories/zjm-047.webp","left":221,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111005-PROLOGUE:750:19","scriptId":750,"text":"“那么要开始准备特训了。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111005-EPILOGUE:10740:1","scriptId":10740,"text":"“这次军演学校双方各派出1名指挥官和6名钢舞姬组成小队进行演习。”","background":"/art/stories/zjm-090.webp","left":211,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111005-EPILOGUE:10740:2","scriptId":10740,"text":"“报告，算上奈乐小队我们也就只有4名钢舞姬啊。”","background":"/art/stories/zjm-090.webp","left":211,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111005-EPILOGUE:10740:3","scriptId":10740,"text":"“恩，我在这里再介绍两位新的钢舞姬给你们认识。”","background":"/art/stories/zjm-090.webp","left":211,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":163,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111005-EPILOGUE:10740:4","scriptId":10740,"text":"“大家好，我是卓娅·朱可夫，莫斯科边防支队副队长。”","background":"/art/stories/zjm-090.webp","left":211,"right":163,"section":3,"shake":false},{"kind":"dialogue","head":350,"speaker":"茜罗娅·约德尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111005-EPILOGUE:10740:5","scriptId":10740,"text":"“我是茜罗娅·约德尔，在虎眼小队服役中。”","background":"/art/stories/zjm-090.webp","left":211,"right":350,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111005-EPILOGUE:10740:6","scriptId":10740,"text":"“哇……这不都是现役的钢舞姬么……”","background":"/art/stories/zjm-090.webp","left":211,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111005-EPILOGUE:10740:7","scriptId":10740,"text":"“说什么傻话，她们都是从伏龙芝毕业的学生啊～”","background":"/art/stories/zjm-090.webp","left":219,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111005-EPILOGUE:10740:8","scriptId":10740,"text":"（教官是多想赢这军演啊……）","background":"/art/stories/zjm-090.webp","left":219,"right":3,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111006-PROLOGUE:760:2","scriptId":760,"text":"参加军演的特训中----","background":"/art/stories/zjm-090.webp","left":219,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111006-PROLOGUE:760:3","scriptId":760,"text":"（终于坐回指挥室了，这才是我能发挥专长的地方嘛～）","background":"/art/stories/zjm-090.webp","left":3,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"111006-PROLOGUE:760:4","scriptId":760,"text":"这时无线电中传来佐伊的声音……","background":"/art/stories/zjm-090.webp","left":3,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111006-PROLOGUE:760:5","scriptId":760,"text":"“喂喂！？长官，能听到吗？”","background":"/art/stories/zjm-090.webp","left":3,"right":31,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111006-PROLOGUE:760:6","scriptId":760,"text":"“恩，听得很清楚。”","background":"/art/stories/zjm-090.webp","left":3,"right":31,"section":4,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111006-PROLOGUE:760:7","scriptId":760,"text":"“恩，信号没问题，请长官下达指示吧～”","background":"/art/stories/zjm-090.webp","left":3,"right":31,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111006-PROLOGUE:760:8","scriptId":760,"text":"“那么就开始吧！”","background":"/art/stories/zjm-090.webp","left":3,"right":31,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111006-EPILOGUE:10750:1","scriptId":10750,"text":"“A2地区已经排除，那么佐伊和莉娜继续向A3侦察，其他人也慢速向A3靠拢。”","background":"/art/stories/zjm-090.webp","left":3,"right":31,"section":5,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"111006-EPILOGUE:10750:2","scriptId":10750,"text":"“没有问题。”","background":"/art/stories/zjm-090.webp","left":3,"right":81,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111006-EPILOGUE:10750:3","scriptId":10750,"text":"（恩，现在的佐伊和莉娜的协同性要比之前好上不少。）","background":"/art/stories/zjm-090.webp","left":3,"right":81,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"111006-EPILOGUE:10750:4","scriptId":10750,"text":"（这主要是沙狐小队的功劳啊。）","background":"/art/stories/zjm-090.webp","left":3,"right":81,"section":5,"shake":false}],"summaries":["完成任务，准备回基地了……","到底什么情况……？","索菲亚教官的命令，只能乖乖地参加军演前的特训……"]}
