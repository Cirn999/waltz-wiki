{"schemaVersion":1,"id":-40105,"sections":[{"id":"script-20105","name":"原始脚本 20105","scripts":[20105],"start":0,"count":11}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20105:20105:0","scriptId":20105,"text":"经过一番战斗，终于把被反噬的钢舞姬数据都击败了。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20105:20105:1","scriptId":20105,"text":"“呼……真是捏了把冷汗……，波西娅博士你确定这些钢舞姬都只是数据吗……”","background":"/art/stories/zjm-047.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20105:20105:2","scriptId":20105,"text":"“哼哼～是不是很带劲，这可是百分之百还原的数据哟～虽然可能有些瑕疵。”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20105:20105:3","scriptId":20105,"text":"“能和沙漠之狐小队过招还真是连做梦都没想到……”","background":"/art/stories/zjm-047.webp","left":591,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20105:20105:4","scriptId":20105,"text":"“外加猎虎小队……真是强得可以。”","background":"/art/stories/zjm-047.webp","left":591,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20105:20105:5","scriptId":20105,"text":"“所谓的瑕疵就是智能模板比较单一，如果不是长官找到了她们的攻击规律还真是搞不定啊。”","background":"/art/stories/zjm-047.webp","left":572,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20105:20105:6","scriptId":20105,"text":"“毕竟是人工智能，和她们本人还是不能比的，只是运气好而已。”","background":"/art/stories/zjm-047.webp","left":572,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20105:20105:7","scriptId":20105,"text":"“谦逊。”","background":"/art/stories/zjm-047.webp","left":596,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20105:20105:8","scriptId":20105,"text":"“恩，不过能临机应变的指挥确实顶得上一支军队呢，你的能力是很出色，我承认～”","background":"/art/stories/zjm-047.webp","left":596,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20105:20105:9","scriptId":20105,"text":"“谢谢。”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20105:20105:10","scriptId":20105,"text":"（恩～收集这里的钢舞姬对战数据好像也非常有用的感觉～）","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false}],"summaries":[]}
