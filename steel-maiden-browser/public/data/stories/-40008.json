{"schemaVersion":1,"id":-40008,"sections":[{"id":"script-20008","name":"原始脚本 20008","scripts":[20008],"start":0,"count":21}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20008:20008:1","scriptId":20008,"text":"再次睁开眼睛的时候，已经被传送到了别的地方。","background":"/art/stories/zdbjbz-04.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:2","scriptId":20008,"text":"“该死的波西娅，这哪里是头晕……”","background":"/art/stories/zdbjbz-04.webp","left":8,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":644,"speaker":"玛鲁夏·德米特里耶夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:3","scriptId":20008,"text":"“长官，看一下周围，我们要面对的怪物好像并不是战车兽啊……”","background":"/art/stories/zdbjbz-04.webp","left":8,"right":644,"section":0,"shake":false},{"kind":"dialogue","head":24,"speaker":"莫夏·梅列茨安娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:4","scriptId":20008,"text":"“恩？这是什么东西……”","background":"/art/stories/zdbjbz-04.webp","left":24,"right":644,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20008:20008:5","scriptId":20008,"text":"目视距离大概在两百米之外有一堆奇怪的生物。","background":"/art/stories/zdbjbz-04.webp","left":24,"right":644,"section":0,"shake":false},{"kind":"dialogue","head":63,"speaker":"原核体-混乱","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20008:20008:6","scriptId":20008,"text":"“……”","background":"/art/stories/zdbjbz-04.webp","left":24,"right":63,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20008:20008:7","scriptId":20008,"text":"不过那些生物好像还没发现我们。","background":"/art/stories/zdbjbz-04.webp","left":24,"right":63,"section":0,"shake":false},{"kind":"dialogue","head":670,"speaker":"多萝·雷德尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:8","scriptId":20008,"text":"“看上去像是粘土一样的东西，挺可爱的啊～”","background":"/art/stories/zdbjbz-04.webp","left":24,"right":670,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:9","scriptId":20008,"text":"“……”","background":"/art/stories/zdbjbz-04.webp","left":8,"right":670,"section":0,"shake":false},{"kind":"dialogue","head":644,"speaker":"玛鲁夏·德米特里耶夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:10","scriptId":20008,"text":"“可爱……”","background":"/art/stories/zdbjbz-04.webp","left":8,"right":644,"section":0,"shake":false},{"kind":"dialogue","head":24,"speaker":"莫夏·梅列茨安娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:11","scriptId":20008,"text":"“独特的审美……”","background":"/art/stories/zdbjbz-04.webp","left":24,"right":644,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:12","scriptId":20008,"text":"“波西娅人呢？快出来解释一下，我知道你在！”","background":"/art/stories/zdbjbz-04.webp","left":24,"right":8,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20008:20008:13","scriptId":20008,"text":"对着空中大声得吼了一句，果不其然，波西娅又再次出现了。","background":"/art/stories/zdbjbz-04.webp","left":24,"right":8,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20008:20008:14","scriptId":20008,"text":"一堆堆数字快速勾砌出波西娅曼妙的身躯，不过这身躯并不完整，并且身体的某些部分时不时会有些不稳定的闪烁。","background":"/art/stories/zdbjbz-04.webp","left":24,"right":8,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:15","scriptId":20008,"text":"“你这是怎么了？几分钟不见开始喜欢起残缺美了吗？”","background":"/art/stories/zdbjbz-04.webp","left":24,"right":8,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:16","scriptId":20008,"text":"“怎么可能，现在是紧急情况，我就长话短说了，你们看到那些粘土一般的怪物了吧。消灭掉——”","background":"/art/stories/zdbjbz-04.webp","left":608,"right":8,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:17","scriptId":20008,"text":"“都听到了吗？那就动手吧。”","background":"/art/stories/zdbjbz-04.webp","left":608,"right":8,"section":0,"shake":false},{"kind":"dialogue","head":25,"speaker":"莫夏·梅列茨安娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:18","scriptId":20008,"text":"“没问题～即刻开始攻击！”","background":"/art/stories/zdbjbz-04.webp","left":25,"right":8,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:19","scriptId":20008,"text":"“诶？我还没解释完呢？”","background":"/art/stories/zdbjbz-04.webp","left":25,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:20","scriptId":20008,"text":"“没必要，等到干掉了以后再慢慢解释给我听就行了，而且你这声音其实听起来有点杂音，让人不舒服。”","background":"/art/stories/zdbjbz-04.webp","left":8,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20008:20008:21","scriptId":20008,"text":"“呃……是这样啊……好吧……”","background":"/art/stories/zdbjbz-04.webp","left":8,"right":608,"section":0,"shake":false}],"summaries":[]}
