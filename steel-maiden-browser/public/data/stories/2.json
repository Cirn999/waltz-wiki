{"schemaVersion":1,"id":2,"sections":[{"id":"106001-PROLOGUE","name":"第 1 战 · 战前","scripts":[11],"start":0,"count":9},{"id":"106001-EPILOGUE","name":"第 1 战 · 战后","scripts":[10000],"start":9,"count":2},{"id":"106002-PROLOGUE","name":"第 2 战 · 战前","scripts":[20,21,22,23],"start":11,"count":21},{"id":"106002-EPILOGUE","name":"第 2 战 · 战后","scripts":[10010,10011,10012,10013],"start":32,"count":26},{"id":"106003-PROLOGUE","name":"第 3 战 · 战前","scripts":[30,31,32,33],"start":58,"count":22},{"id":"106003-EPILOGUE","name":"第 3 战 · 战后","scripts":[10020,10021,10022,10023],"start":80,"count":30}],"frames":[{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106001-PROLOGUE:11:2","scriptId":11,"text":"“话说你不是昏过去了么？”","background":"/art/stories/zdbjbz-07.webp","left":38,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106001-PROLOGUE:11:3","scriptId":11,"text":"“哪有，我那叫沉思，在战场上无论遇到任何突发情况都要沉着冷静。”","background":"/art/stories/zdbjbz-07.webp","left":38,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106001-PROLOGUE:11:4","scriptId":11,"text":"“所以你就把我扔那儿，自己一声不吭的跑了？”","background":"/art/stories/zdbjbz-07.webp","left":40,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106001-PROLOGUE:11:5","scriptId":11,"text":"“情况紧急，而且我可是叫你等等了，可你跑得也太快了。”","background":"/art/stories/zdbjbz-07.webp","left":40,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106001-PROLOGUE:11:6","scriptId":11,"text":"“……好吧，你救了我这是事实，谢谢你，长官。”","background":"/art/stories/zdbjbz-07.webp","left":31,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106001-PROLOGUE:11:7","scriptId":11,"text":"“很好，你就在一边好好休息吧。”","background":"/art/stories/zdbjbz-07.webp","left":31,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106001-PROLOGUE:11:8","scriptId":11,"text":"“这可不行，我还能再战！”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"106001-PROLOGUE:11:9","scriptId":11,"text":"说完，佐伊也加入到了战斗序列之中。","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106001-PROLOGUE:11:10","scriptId":11,"text":"“唉……又跑掉了啊……”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106001-EPILOGUE:10000:1","scriptId":10000,"text":"“呼呼，轻松搞定。”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106001-EPILOGUE:10000:2","scriptId":10000,"text":"“有惊无险，不过大家都没事就好。”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:20:2","scriptId":20,"text":"“不要太放松，我们还没脱离战区，这个地方的战车兽群很松散。”","background":"/art/stories/zdbjbz-07.webp","left":61,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:20:3","scriptId":20,"text":"“莱尼说得对，趁着敌人还没聚集过来之前我们要快点离开这里。”","background":"/art/stories/zdbjbz-07.webp","left":61,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:20:4","scriptId":20,"text":"“话虽如此，不过看来不会那么容易。”我指了指前方。","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"106002-PROLOGUE:20:5","scriptId":20,"text":"远处已经出现了一小群黑压压的影子，是聚集过来的战车兽无误了。","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:21:2","scriptId":21,"text":"“哼，这些战车兽队伍太过松散，根本就是上来排队送死。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1171,"section":2,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:21:3","scriptId":21,"text":"“那是因为卓娅你太强了啦。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:21:4","scriptId":21,"text":"“我们主要目标是离开战区，不要惹太多麻烦。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:21:5","scriptId":21,"text":"“啊，我老毛病又犯了，不好意思啊。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1171,"section":2,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:21:6","scriptId":21,"text":"“干掉前面那堆战车兽应该就可以找到突破口了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:22:2","scriptId":22,"text":"“这个地区的战车兽怎么都零零散散的，真是不堪一击啊。”","background":"/art/stories/zdbjbz-07.webp","left":968,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:22:3","scriptId":22,"text":"“在敌人聚集起来之前快点前进吧。”","background":"/art/stories/zdbjbz-07.webp","left":968,"right":1146,"section":2,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:22:4","scriptId":22,"text":"“全歼这里的敌人都没问题，怕什么。”","background":"/art/stories/zdbjbz-07.webp","left":968,"right":1146,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:22:5","scriptId":22,"text":"“真的没问题吗？”","background":"/art/stories/zdbjbz-07.webp","left":968,"right":3,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"106002-PROLOGUE:22:6","scriptId":22,"text":"这时，周围的战车兽发现了我们并开始朝这里逼近。","background":"/art/stories/zdbjbz-07.webp","left":968,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:22:7","scriptId":22,"text":"“安啦~小场面。”","background":"/art/stories/zdbjbz-07.webp","left":968,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:23:2","scriptId":23,"text":"“目测还有六七队战车兽的样子，在这里战斗很容易吸引它们的注意力。”","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:23:3","scriptId":23,"text":"“是要撤离吗？”","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":1170,"section":2,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:23:4","scriptId":23,"text":"“没错，毕竟我们身边还有非战斗人员，和敌人厮杀起来就很难进行保护工作了。”","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":1170,"section":2,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:23:5","scriptId":23,"text":"“嗯……”","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":1170,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:23:6","scriptId":23,"text":"“我会躲好的，而且还有佐伊这个贴身防护，你们按自己的节奏来就行了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1170,"section":2,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-PROLOGUE:23:7","scriptId":23,"text":"“那么先从右边的战车兽开始吧，准备战斗。”","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":1170,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10010:1","scriptId":10010,"text":"“这个地区的战车兽聚集的速度比想象中的要快了不少。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1170,"section":3,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10010:2","scriptId":10010,"text":"“难道是为了狙击你们？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":61,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10010:3","scriptId":10010,"text":"“也有可能，我可是伏龙芝军官学院首席的毕业生。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":61,"section":3,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10010:4","scriptId":10010,"text":"“……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10010:5","scriptId":10010,"text":"（臭美能力倒是一流）","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10011:1","scriptId":10011,"text":"“这个地区的战车兽聚集的速度比想象中的要快了不少。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":163,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10011:2","scriptId":10011,"text":"“还行吧，因为地形的关系，也不能说特别快。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":163,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10011:3","scriptId":10011,"text":"“但同样我们也很难甩开它们。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":163,"section":3,"shake":false},{"kind":"dialogue","head":163,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10011:4","scriptId":10011,"text":"“可能觉得我们比较弱，所以就穷追猛打吧。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":163,"section":3,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10011:5","scriptId":10011,"text":"“难道我们很弱吗？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":163,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10011:6","scriptId":10011,"text":"“战车兽也是凭直觉的动物，可能觉得我们是软柿子？？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":163,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10011:7","scriptId":10011,"text":"“也对，佐伊之前还被它们暴揍了一顿呢。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":163,"section":3,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10011:8","scriptId":10011,"text":"“那是敌众我寡！而且我还要保护废柴指挥官！”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10011:9","scriptId":10011,"text":"“呃，保护我才是你主要的职责吧……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10012:1","scriptId":10012,"text":"“这个地区的战车兽聚集的速度比想象中的要快了不少。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10012:2","scriptId":10012,"text":"“难道是为了狙击我？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":968,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10012:3","scriptId":10012,"text":"“只是一种猜测。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":968,"section":3,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10012:4","scriptId":10012,"text":"“确实有这种可能，毕竟我可是战车兽清道夫啊。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":968,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10012:5","scriptId":10012,"text":"“哦？原来你还有这种头衔？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":968,"section":3,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10012:6","scriptId":10012,"text":"“啊，那当然，我自己封的~”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":968,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10012:7","scriptId":10012,"text":"“……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":968,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10013:1","scriptId":10013,"text":"“这个地区的战车兽聚集的速度比想象中的要快了不少。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":968,"section":3,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10013:2","scriptId":10013,"text":"“很快吗？这种乌龟速度，无异于一个个冲过来自杀。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1158,"section":3,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10013:3","scriptId":10013,"text":"“比起在学校训练那会儿，这种速度根本不值一提。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1170,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10013:4","scriptId":10013,"text":"“……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1170,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106002-EPILOGUE:10013:5","scriptId":10013,"text":"（这就是强者的从容吗……）","background":"/art/stories/zdbjbz-07.webp","left":3,"right":1170,"section":3,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:30:2","scriptId":30,"text":"“干掉下一批战车兽应该就能到安全地区了。”","background":"/art/stories/zdbjbz-07.webp","left":71,"right":1170,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:30:3","scriptId":30,"text":"“哦？是吗？对这个地区我还不是很熟悉。”","background":"/art/stories/zdbjbz-07.webp","left":71,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:30:4","scriptId":30,"text":"“给，这是本区域的势力分布地图。”","background":"/art/stories/zdbjbz-07.webp","left":61,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:30:5","scriptId":30,"text":"“恩，我来看看……很好，马上就要进入安全范围了，大家再努力一下。”","background":"/art/stories/zdbjbz-07.webp","left":61,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:30:6","scriptId":30,"text":"“就交给我们吧。”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:31:2","scriptId":31,"text":"“干掉下一批战车兽应该就能到安全地区了。”","background":"/art/stories/zdbjbz-07.webp","left":71,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:31:3","scriptId":31,"text":"“哦？是吗？对这个地区我还不是很熟悉。”","background":"/art/stories/zdbjbz-07.webp","left":71,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:31:4","scriptId":31,"text":"“没关系，我也不熟悉，兵来将挡就完事了。”","background":"/art/stories/zdbjbz-07.webp","left":1171,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:31:5","scriptId":31,"text":"“呃……我看看地图……”","background":"/art/stories/zdbjbz-07.webp","left":1171,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:31:6","scriptId":31,"text":"“嗯，确实马上就到基地了，大家再努力下。”","background":"/art/stories/zdbjbz-07.webp","left":1171,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:32:2","scriptId":32,"text":"“基本已经脱离战车兽的包围，马上就能进入安全地区了。”","background":"/art/stories/zdbjbz-07.webp","left":1146,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:32:3","scriptId":32,"text":"“还挺快的嘛，我之前还担心体力透支的问题。”","background":"/art/stories/zdbjbz-07.webp","left":1146,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:32:4","scriptId":32,"text":"“长官这是缺乏锻炼啊，这点程度的战斗完全算不上什么。”","background":"/art/stories/zdbjbz-07.webp","left":968,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:32:5","scriptId":32,"text":"“你们可要好好保存实力，我只想安安稳稳地到达基地。”","background":"/art/stories/zdbjbz-07.webp","left":968,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:32:6","scriptId":32,"text":"“就交给我们吧。”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:32:7","scriptId":32,"text":"“你确实没怎么发力，因为都是索菲她们在打，你也就补补刀。”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:32:8","scriptId":32,"text":"“我这是为了不让作战出现漏网之鱼。”","background":"/art/stories/zdbjbz-07.webp","left":37,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:33:2","scriptId":33,"text":"“道路阻碍已经铲除，但从周边的数量来看还差得很远。”","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:33:3","scriptId":33,"text":"“不用不用，我们不是来做清剿任务的。”","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:33:4","scriptId":33,"text":"“只是顺手清理一下这附近的巢穴，不费事。”","background":"/art/stories/zdbjbz-07.webp","left":1170,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:33:5","scriptId":33,"text":"“……太强了，佐伊，好好看，跟着学点。”","background":"/art/stories/zdbjbz-07.webp","left":1170,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-PROLOGUE:33:6","scriptId":33,"text":"“呃……”","background":"/art/stories/zdbjbz-07.webp","left":38,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10020:1","scriptId":10020,"text":"“没想到这片区域的战车兽会多到如此地步。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10020:2","scriptId":10020,"text":"“有我和小飞象保护你，还需要担心什么？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":37,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10020:3","scriptId":10020,"text":"“如果真是那样，就不用我去找援军了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":37,"section":5,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10020:4","scriptId":10020,"text":"“呜……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10020:5","scriptId":10020,"text":"“好了好了，不要再斗嘴了，我们已经到根据地了。”","background":"/art/stories/zdbjbz-07.webp","left":61,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10020:6","scriptId":10020,"text":"“我先去前面和守备员交接下。”","background":"/art/stories/zdbjbz-07.webp","left":71,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10020:7","scriptId":10020,"text":"“OK，那就交给你了。”","background":"/art/stories/zdbjbz-07.webp","left":61,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10021:1","scriptId":10021,"text":"“没想到这片区域的战车兽会多到如此地步。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10021:2","scriptId":10021,"text":"“有我和小飞象保护你，还需要担心什么？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":37,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10021:3","scriptId":10021,"text":"“如果真是那样，就不用我去找援军了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":37,"section":5,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10021:4","scriptId":10021,"text":"“呜……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":163,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10021:5","scriptId":10021,"text":"“佐伊明显还是新手，在真正战斗的时候有些僵硬，不过慢慢会好起来的。”","background":"/art/stories/zdbjbz-07.webp","left":163,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10021:6","scriptId":10021,"text":"“是的，我就算现在偶尔也会有犯错的时候。”","background":"/art/stories/zdbjbz-07.webp","left":71,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10021:7","scriptId":10021,"text":"“就是嘛，等我习惯了战场就会变强的啦。”","background":"/art/stories/zdbjbz-07.webp","left":71,"right":31,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10021:8","scriptId":10021,"text":"“那可真是期待啊，快点强力起来吧。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":31,"section":5,"shake":false},{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10021:9","scriptId":10021,"text":"“总觉得长官说的不是真心话……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":38,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10022:1","scriptId":10022,"text":"“没想到这片区域的战车兽会多到如此地步。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":38,"section":5,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10022:2","scriptId":10022,"text":"“有我和小飞象保护你，还需要担心什么？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":37,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10022:3","scriptId":10022,"text":"“如果真是那样，就不用我去找援军了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":37,"section":5,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10022:4","scriptId":10022,"text":"“呜……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10022:5","scriptId":10022,"text":"“你们很幸运，遇到了我和嘉丝莉，否则后果不堪设想。”","background":"/art/stories/zdbjbz-07.webp","left":968,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":1152,"speaker":"嘉丝莉·鲍恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10022:6","scriptId":10022,"text":"“好啦，趁这个机会稍微多休息一下吧。”","background":"/art/stories/zdbjbz-07.webp","left":1152,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10022:7","scriptId":10022,"text":"“嗯，大衣都有点脏了，我去掸掸灰。”","background":"/art/stories/zdbjbz-07.webp","left":968,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10023:1","scriptId":10023,"text":"“没想到这片区域的战车兽会多到如此地步。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10023:2","scriptId":10023,"text":"“有我和小飞象保护你，还需要担心什么？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":37,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10023:3","scriptId":10023,"text":"“如果真是那样，就不用我去找援军了。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":37,"section":5,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10023:4","scriptId":10023,"text":"“呜……”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10023:5","scriptId":10023,"text":"“自律炮台是好东西，不过要多加锻炼才能用好。”","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10023:6","scriptId":10023,"text":"“这也算是比较新颖的科技兵器了。”","background":"/art/stories/zdbjbz-07.webp","left":1170,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"106003-EPILOGUE:10023:7","scriptId":10023,"text":"“嗯，虽然也推荐过我用这种兵器，不过杀伤力有限，而且还有不少多余功能……”","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":40,"section":5,"shake":false}],"summaries":["佐伊的胡乱攻击为我呼叫援军争取了不少时间。","前方又出现一小群战车兽，真是烦人，反正有佐伊她们在应该没有什么大问题吧……","路上的障碍也清理得差不多，快要到达前线指挥部了，再加把劲吧。"]}
