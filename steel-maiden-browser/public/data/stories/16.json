{"schemaVersion":1,"id":16,"sections":[{"id":"109007-PROLOGUE","name":"第 1 战 · 战前","scripts":[490],"start":0,"count":11},{"id":"109007-EPILOGUE","name":"第 1 战 · 战后","scripts":[10480],"start":11,"count":5},{"id":"109008-PROLOGUE","name":"第 2 战 · 战前","scripts":[500,501,502,503],"start":16,"count":42},{"id":"109008-EPILOGUE","name":"第 2 战 · 战后","scripts":[10490],"start":58,"count":15},{"id":"109009-PROLOGUE","name":"第 3 战 · 战前","scripts":[510,511,512,513],"start":73,"count":32},{"id":"109009-EPILOGUE","name":"第 3 战 · 战后","scripts":[10500],"start":105,"count":8}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109007-PROLOGUE:490:2","scriptId":490,"text":"改成步行以后，速度一下子慢了下来。","background":"/art/stories/zdbjbz-06.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109007-PROLOGUE:490:3","scriptId":490,"text":"“好累……稍微再走慢点吧各位……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109007-PROLOGUE:490:4","scriptId":490,"text":"“哼～～哼～～哼～～”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":39,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109007-PROLOGUE:490:5","scriptId":490,"text":"“根本就没在听……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":39,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109007-PROLOGUE:490:8","scriptId":490,"text":"突然，从远处传来一声炮鸣。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":39,"section":0,"shake":true},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109007-PROLOGUE:490:9","scriptId":490,"text":"炮弹从佐伊的右侧呼啸而过……","background":"/art/stories/zdbjbz-06.webp","left":3,"right":39,"section":0,"shake":false},{"kind":"dialogue","head":34,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109007-PROLOGUE:490:10","scriptId":490,"text":"“呜呜呜……吓死我了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":34,"section":0,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109007-PROLOGUE:490:11","scriptId":490,"text":"“难道又是该死的猴子！？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":32,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109007-PROLOGUE:490:12","scriptId":490,"text":"“明显不是……麻烦的来了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":32,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109007-PROLOGUE:490:13","scriptId":490,"text":"从炮弹的发射方向望去，那里并不是战车兽而是钢舞姬……","background":"/art/stories/zdbjbz-06.webp","left":3,"right":32,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109007-PROLOGUE:490:14","scriptId":490,"text":"比起战车兽更棘手的敌人。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":32,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109007-EPILOGUE:10480:1","scriptId":10480,"text":"“虽说对面是我们后辈，不过战斗力还是很高的嘛。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":32,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109007-EPILOGUE:10480:2","scriptId":10480,"text":"“没问题的，对面的命中精度不是很高，而且好像刻意在于我们保持距离。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109007-EPILOGUE:10480:3","scriptId":10480,"text":"“从对面炮击的感觉来看，好像不是能和我们进行缠斗的阵容。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109007-EPILOGUE:10480:4","scriptId":10480,"text":"“那我们就冲上去和她们打接近战！”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109007-EPILOGUE:10480:5","scriptId":10480,"text":"“我话还没说完呢……无脑冲锋的速度还真是让人佩服。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-PROLOGUE:500:2","scriptId":500,"text":"佐伊以势不可挡的气势冲向对面阵地。","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:500:3","scriptId":500,"text":"“佐伊又脑子过热了，莱尼和拉伊莎快去援护她！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:500:4","scriptId":500,"text":"“遵命！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:500:5","scriptId":500,"text":"“没问题。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":61,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:500:6","scriptId":500,"text":"“莱尼等等，把旗帜留下。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":61,"section":2,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:500:7","scriptId":500,"text":"“哦。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":61,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-PROLOGUE:500:8","scriptId":500,"text":"莱尼把旗杆交给我以后转身就离开了。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":61,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:500:9","scriptId":500,"text":"“这时候就该这样……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":61,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-PROLOGUE:500:10","scriptId":500,"text":"我把旗帜从旗杆上拆了下来，折叠成手帕大小塞进了衣服口袋。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":61,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:500:11","scriptId":500,"text":"“闪人的时间到了～”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":61,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-PROLOGUE:501:2","scriptId":501,"text":"佐伊以势不可挡的气势冲向对面阵地。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":61,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:501:3","scriptId":501,"text":"“佐伊又脑子过热了，卓娅和拉伊莎快去援护她！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":61,"section":2,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:501:4","scriptId":501,"text":"“遵命！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":71,"section":2,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:501:5","scriptId":501,"text":"“小事一桩。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1171,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:501:6","scriptId":501,"text":"“卓娅，你等等，把旗帜留下。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1171,"section":2,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:501:7","scriptId":501,"text":"“哦。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1171,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-PROLOGUE:501:8","scriptId":501,"text":"卓娅把旗杆交给我以后转身就离开了。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1171,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:501:9","scriptId":501,"text":"“这时候就该这样……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1171,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-PROLOGUE:501:10","scriptId":501,"text":"我把旗帜从旗杆上拆了下来，折叠成手帕大小塞进了衣服口袋。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1171,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:501:11","scriptId":501,"text":"“闪人的时间到了～”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1171,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-PROLOGUE:502:2","scriptId":502,"text":"佐伊以势不可挡的气势冲向对面阵地。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1171,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:502:3","scriptId":502,"text":"“佐伊又脑子过热了，嘉丝莉和索菲快去援护她！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1171,"section":2,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:502:4","scriptId":502,"text":"“了解。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1146,"section":2,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:502:5","scriptId":502,"text":"“跑得还挺快啊。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":968,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:502:6","scriptId":502,"text":"“索菲，等等，把旗帜留下。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":968,"section":2,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:502:7","scriptId":502,"text":"“拿去。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":968,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-PROLOGUE:502:8","scriptId":502,"text":"索菲把旗杆交给我以后转身就开始追赶佐伊。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":968,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:502:9","scriptId":502,"text":"“这时候就该这样……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":968,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-PROLOGUE:502:10","scriptId":502,"text":"我把旗帜从旗杆上拆了下来，折叠成手帕大小塞进了衣服口袋。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":968,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:502:11","scriptId":502,"text":"“闪人的时间到了～”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":968,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-PROLOGUE:503:2","scriptId":503,"text":"佐伊以势不可挡的气势冲向对面阵地。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":968,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:503:3","scriptId":503,"text":"“佐伊又脑子过热了，夏虹萤和陈雯兰快去援护她！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":968,"section":2,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:503:4","scriptId":503,"text":"“我们两个都去吗？那长官怎么办？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1170,"section":2,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:503:5","scriptId":503,"text":"“没事的，我们很快就能把佐伊带回来。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:503:6","scriptId":503,"text":"“等等，把旗帜留下。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":2,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:503:7","scriptId":503,"text":"“嗯？长官难道另有想法？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:503:8","scriptId":503,"text":"“是的。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":2,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:503:9","scriptId":503,"text":"“那就看长官的表现了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-PROLOGUE:503:10","scriptId":503,"text":"陈雯兰把旗杆交给我以后转身开始追击佐伊。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:503:11","scriptId":503,"text":"“这时候就该这样……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-PROLOGUE:503:12","scriptId":503,"text":"我把旗帜从旗杆上拆了下来，折叠成手帕大小塞进了衣服口袋。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-PROLOGUE:503:13","scriptId":503,"text":"“闪人的时间到了～”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-EPILOGUE:10490:1","scriptId":10490,"text":"佐伊优先一步率先杀入敌阵。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-EPILOGUE:10490:2","scriptId":10490,"text":"正如长官所说的，敌人的火炮命中率很低，基本没有蹭到佐伊分毫。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":3,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-EPILOGUE:10490:3","scriptId":10490,"text":"“哼哼，这点水平还想碰到我？”","background":"/art/stories/zdbjbz-06.webp","left":37,"right":1158,"section":3,"shake":false},{"kind":"dialogue","head":182,"speaker":"伊诺·赞佩里尼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109008-EPILOGUE:10490:4","scriptId":10490,"text":"“可恶！”","background":"/art/stories/zdbjbz-06.webp","left":37,"right":182,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-EPILOGUE:10490:7","scriptId":10490,"text":"又是一发没有命中，然而对方已经完全进入了佐伊的有效射程。","background":"/art/stories/zdbjbz-06.webp","left":37,"right":182,"section":3,"shake":true},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-EPILOGUE:10490:8","scriptId":10490,"text":"“打不着打不着～该换我进攻咯～”","background":"/art/stories/zdbjbz-06.webp","left":37,"right":182,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-EPILOGUE:10490:9","scriptId":10490,"text":"趁着对面填装的空隙，佐伊开始不紧不慢地锁定目标。","background":"/art/stories/zdbjbz-06.webp","left":37,"right":182,"section":3,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-EPILOGUE:10490:10","scriptId":10490,"text":"“再见咯～”","background":"/art/stories/zdbjbz-06.webp","left":37,"right":182,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-EPILOGUE:10490:11","scriptId":10490,"text":"炮弹直接命中目标，扬起了大量的灰尘。","background":"/art/stories/zdbjbz-06.webp","left":37,"right":182,"section":3,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-EPILOGUE:10490:13","scriptId":10490,"text":"“搞定～哦也～”","background":"/art/stories/zdbjbz-06.webp","left":37,"right":null,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-EPILOGUE:10490:14","scriptId":10490,"text":"尘埃散尽，结果并没有像佐伊期待的那样重创对手。","background":"/art/stories/zdbjbz-06.webp","left":37,"right":null,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-EPILOGUE:10490:15","scriptId":10490,"text":"原来是有人出手挡住了佐伊刚才的炮击。","background":"/art/stories/zdbjbz-06.webp","left":37,"right":null,"section":3,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109008-EPILOGUE:10490:16","scriptId":10490,"text":"“什么？”","background":"/art/stories/zdbjbz-06.webp","left":41,"right":null,"section":3,"shake":false},{"kind":"dialogue","head":195,"speaker":"洛伦·劳伦斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"109008-EPILOGUE:10490:17","scriptId":10490,"text":"“不要欺负伊诺，她还是个新手，你的对手在这里。”","background":"/art/stories/zdbjbz-06.webp","left":41,"right":195,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109008-EPILOGUE:10490:18","scriptId":10490,"text":"杀出的不是一名钢舞姬，而是三人！？这下情况急转直下。","background":"/art/stories/zdbjbz-06.webp","left":41,"right":195,"section":3,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:510:2","scriptId":510,"text":"“想抢我们的旗帜，门都没有！”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":195,"section":4,"shake":false},{"kind":"dialogue","head":196,"speaker":"洛伦·劳伦斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"109009-PROLOGUE:510:3","scriptId":510,"text":"“乖乖把旗帜交出来，反正你们也没有胜算了。”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":196,"section":4,"shake":false},{"kind":"dialogue","head":205,"speaker":"汉尼·蒙哥马利","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"109009-PROLOGUE:510:4","scriptId":510,"text":"“还不知道自己的实力差距吗？真是可悲～”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":205,"section":4,"shake":false},{"kind":"dialogue","head":139,"speaker":"米赫伊·罗卡芙","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"109009-PROLOGUE:510:5","scriptId":510,"text":"“数量差距太明显了，一个人冲过来也真是太小看我们了。”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":139,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109009-PROLOGUE:510:8","scriptId":510,"text":"双方对峙之时，莱尼和拉伊莎也已经赶到了。","background":"/art/stories/zdbjbz-06.webp","left":32,"right":139,"section":4,"shake":true},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:510:9","scriptId":510,"text":"“现在数量对等了吧。”","background":"/art/stories/zdbjbz-06.webp","left":61,"right":139,"section":4,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:510:10","scriptId":510,"text":"“佐伊没被秒杀真是奇迹～”","background":"/art/stories/zdbjbz-06.webp","left":71,"right":139,"section":4,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:510:11","scriptId":510,"text":"“你们到底是不是我的队友……”","background":"/art/stories/zdbjbz-06.webp","left":71,"right":40,"section":4,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:511:2","scriptId":511,"text":"“想抢我们的旗帜，门都没有！”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":40,"section":4,"shake":false},{"kind":"dialogue","head":196,"speaker":"洛伦·劳伦斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"109009-PROLOGUE:511:3","scriptId":511,"text":"“乖乖把旗帜交出来，反正你们也没有胜算了。”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":196,"section":4,"shake":false},{"kind":"dialogue","head":205,"speaker":"汉尼·蒙哥马利","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"109009-PROLOGUE:511:4","scriptId":511,"text":"“还不知道自己的实力差距吗？真是可悲～”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":205,"section":4,"shake":false},{"kind":"dialogue","head":139,"speaker":"米赫伊·罗卡芙","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"109009-PROLOGUE:511:5","scriptId":511,"text":"“数量差距太明显了，一个人冲过来也真是太小看我们了。”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":139,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109009-PROLOGUE:511:8","scriptId":511,"text":"双方对峙之时，卓娅和拉伊莎也已经赶到了。","background":"/art/stories/zdbjbz-06.webp","left":32,"right":139,"section":4,"shake":true},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:511:9","scriptId":511,"text":"“让我们来一场堂堂正正的较量吧。”","background":"/art/stories/zdbjbz-06.webp","left":1171,"right":139,"section":4,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:511:10","scriptId":511,"text":"“佐伊没被秒杀真是奇迹～”","background":"/art/stories/zdbjbz-06.webp","left":71,"right":139,"section":4,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:511:11","scriptId":511,"text":"“你们到底是不是我的队友……”","background":"/art/stories/zdbjbz-06.webp","left":71,"right":40,"section":4,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:512:2","scriptId":512,"text":"“想抢我们的旗帜，门都没有！”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":40,"section":4,"shake":false},{"kind":"dialogue","head":196,"speaker":"洛伦·劳伦斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"109009-PROLOGUE:512:3","scriptId":512,"text":"“乖乖把旗帜交出来，反正你们也没有胜算了。”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":196,"section":4,"shake":false},{"kind":"dialogue","head":205,"speaker":"汉尼·蒙哥马利","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"109009-PROLOGUE:512:4","scriptId":512,"text":"“还不知道自己的实力差距吗？真是可悲～”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":205,"section":4,"shake":false},{"kind":"dialogue","head":139,"speaker":"米赫伊·罗卡芙","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"109009-PROLOGUE:512:5","scriptId":512,"text":"“数量差距太明显了，一个人冲过来也真是太小看我们了。”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":139,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109009-PROLOGUE:512:8","scriptId":512,"text":"双方对峙之时，嘉丝莉和索菲也已经赶到了。","background":"/art/stories/zdbjbz-06.webp","left":32,"right":139,"section":4,"shake":true},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:512:9","scriptId":512,"text":"“看上去也不是什么特别厉害的阵容。”","background":"/art/stories/zdbjbz-06.webp","left":1146,"right":139,"section":4,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:512:10","scriptId":512,"text":"“哟，让我给你展示下什么叫实力的差距吧。”","background":"/art/stories/zdbjbz-06.webp","left":968,"right":139,"section":4,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:512:11","scriptId":512,"text":"“这下不会输了啊。”","background":"/art/stories/zdbjbz-06.webp","left":968,"right":31,"section":4,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:513:2","scriptId":513,"text":"“想抢我们的旗帜，门都没有！”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":31,"section":4,"shake":false},{"kind":"dialogue","head":196,"speaker":"洛伦·劳伦斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"109009-PROLOGUE:513:3","scriptId":513,"text":"“乖乖把旗帜交出来，反正你们也没有胜算了。”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":196,"section":4,"shake":false},{"kind":"dialogue","head":205,"speaker":"汉尼·蒙哥马利","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"109009-PROLOGUE:513:4","scriptId":513,"text":"“还不知道自己的实力差距吗？真是可悲～”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":205,"section":4,"shake":false},{"kind":"dialogue","head":139,"speaker":"米赫伊·罗卡芙","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"109009-PROLOGUE:513:5","scriptId":513,"text":"“数量差距太明显了，一个人冲过来也真是太小看我们了。”","background":"/art/stories/zdbjbz-06.webp","left":32,"right":139,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109009-PROLOGUE:513:8","scriptId":513,"text":"双方对峙之时，莱尼和拉伊莎也已经赶到了。","background":"/art/stories/zdbjbz-06.webp","left":32,"right":139,"section":4,"shake":true},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:513:9","scriptId":513,"text":"“对面竟然还没解决掉佐伊，看来也不过如此。”","background":"/art/stories/zdbjbz-06.webp","left":1170,"right":139,"section":4,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:513:10","scriptId":513,"text":"“确实，我们赶时间，你们一起上吧。”","background":"/art/stories/zdbjbz-06.webp","left":1158,"right":139,"section":4,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109009-PROLOGUE:513:11","scriptId":513,"text":"“呃，我完全成了摆设啊……”","background":"/art/stories/zdbjbz-06.webp","left":1158,"right":40,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"109009-EPILOGUE:10500:1","scriptId":10500,"text":"对面小队的实力确实不容小觑，佐伊三人渐渐处于下风。","background":"/art/stories/zdbjbz-06.webp","left":1158,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":187,"speaker":"洛伦·劳伦斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"109009-EPILOGUE:10500:2","scriptId":10500,"text":"“我想你们也已经清楚自己的处境了吧～”","background":"/art/stories/zdbjbz-06.webp","left":187,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109009-EPILOGUE:10500:3","scriptId":10500,"text":"“不就是输了嘛，哼！”","background":"/art/stories/zdbjbz-06.webp","left":187,"right":32,"section":5,"shake":false},{"kind":"dialogue","head":195,"speaker":"洛伦·劳伦斯","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"109009-EPILOGUE:10500:4","scriptId":10500,"text":"“那就把旗帜交出来吧～”","background":"/art/stories/zdbjbz-06.webp","left":195,"right":32,"section":5,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109009-EPILOGUE:10500:5","scriptId":10500,"text":"“旗帜？我没有旗帜啊？源奶要不要？我还有半瓶。”","background":"/art/stories/zdbjbz-06.webp","left":195,"right":41,"section":5,"shake":false},{"kind":"dialogue","head":139,"speaker":"米赫伊·罗卡芙","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"109009-EPILOGUE:10500:6","scriptId":10500,"text":"“难道她们小队还有别的人？”","background":"/art/stories/zdbjbz-06.webp","left":139,"right":41,"section":5,"shake":false},{"kind":"dialogue","head":208,"speaker":"汉尼·蒙哥马利","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"109009-EPILOGUE:10500:7","scriptId":10500,"text":"“不会吧，从履带的数量上来看，她们确实只有三人啊。”","background":"/art/stories/zdbjbz-06.webp","left":208,"right":41,"section":5,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"109009-EPILOGUE:10500:8","scriptId":10500,"text":"（她们没发现长官？看这样子是丢下我们自己溜了？）","background":"/art/stories/zdbjbz-06.webp","left":208,"right":40,"section":5,"shake":false}],"summaries":["遭遇钢舞姬夺旗部队，该来的还是来了，应战吧。","僵持战明显不利，得想个办法打开一条出路。","夺旗战现在进行时"]}
