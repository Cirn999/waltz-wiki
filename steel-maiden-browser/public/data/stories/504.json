{"schemaVersion":1,"id":504,"sections":[{"id":"1923001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20687],"start":0,"count":19},{"id":"1923001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20688],"start":19,"count":12}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1923001-PROLOGUE:20687:1","scriptId":20687,"text":"在前一天晚上受到了一组来自钢舞姬旅行者和战车兽的混成攻击。","background":"/art/stories/zdbjbz-02.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:2","scriptId":20687,"text":"“不妙啊……可以确定敌人对我们的位置了如指掌，正在源源不断派部队过来。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:3","scriptId":20687,"text":"“混合部队很难处理……”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:4","scriptId":20687,"text":"“……都没好好睡，看来得加快进度了，不然要被他们车轮战拖住的。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:5","scriptId":20687,"text":"“哈啊……是啊，结果才睡了没几个小时敌人就来了，真烦。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1923001-PROLOGUE:20687:6","scriptId":20687,"text":"佐伊打了个哈欠，睡眼稀松地开始嚼起军用干粮。","background":"/art/stories/zdbjbz-02.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:7","scriptId":20687,"text":"“给，源奶。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1923001-PROLOGUE:20687:8","scriptId":20687,"text":"佩妮递给佐伊一瓶源奶。","background":"/art/stories/zdbjbz-02.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:9","scriptId":20687,"text":"“我们差不多已经穿过了四片不同的大区域，今天还要继续吧。”","background":"/art/stories/zdbjbz-02.webp","left":572,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:10","scriptId":20687,"text":"“昨晚的情况非常不乐观，战车兽和钢舞姬的联合攻击没想到那么棘手……”","background":"/art/stories/zdbjbz-02.webp","left":572,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:11","scriptId":20687,"text":"“是啊，机动性高的战车兽在钢舞姬的援护下，突破力非常强。”","background":"/art/stories/zdbjbz-02.webp","left":572,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:12","scriptId":20687,"text":"“如果不是占据地理优势，我们可能会输。”","background":"/art/stories/zdbjbz-02.webp","left":572,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:13","scriptId":20687,"text":"“是的，我也为你们捏一把汗。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:14","scriptId":20687,"text":"“总之先进行转移，要时刻提防敌人的攻击。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:15","scriptId":20687,"text":"“目前周围一切正常。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:16","scriptId":20687,"text":"“嗯，维卡你也先休息一下好了，佐伊她们都已经起来了，我们准备出发。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:17","scriptId":20687,"text":"“……嗯。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1923001-PROLOGUE:20687:18","scriptId":20687,"text":"从昨晚后半夜就没合过眼的维卡乖乖坐上了吉普车。","background":"/art/stories/zdbjbz-02.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-PROLOGUE:20687:19","scriptId":20687,"text":"“收拾完帐篷就准备出发。大家速度。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1923001-EPILOGUE:20688:1","scriptId":20688,"text":"在转移阵地的时候确实也遭遇到了来自钢舞姬和战车兽的混合部队。","background":"/art/stories/zdbjbz-02.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1923001-EPILOGUE:20688:2","scriptId":20688,"text":"不过由于我们转移的速度很快，反倒是抢在它们发现我们之前打了一手伏击。","background":"/art/stories/zdbjbz-02.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-EPILOGUE:20688:3","scriptId":20688,"text":"“漂亮，看来敌人并不是实时掌握我们的动态或者是命令不同步。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":596,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-EPILOGUE:20688:4","scriptId":20688,"text":"“嗯，只要有时间差，我们就有机会。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-EPILOGUE:20688:5","scriptId":20688,"text":"“长官真是果断，早上让我们转移的时候我心里还嫌你烦，真是对不起。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-EPILOGUE:20688:6","scriptId":20688,"text":"“果然还是太早了吗？我还觉得你们应该已经睡够了……”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-EPILOGUE:20688:7","scriptId":20688,"text":"“哈哈～我也就是心里抱怨下～”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-EPILOGUE:20688:8","scriptId":20688,"text":"“对方完全被我们打乱了节奏，即使是混合部队也完全不是对手。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-EPILOGUE:20688:9","scriptId":20688,"text":"“耍得它们团团转还真有意思。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-EPILOGUE:20688:10","scriptId":20688,"text":"“不要大意，敌人也不是白痴，几次偷袭得手并不会对大局造成颠覆性的影响，况且我们还不清楚敌人的规模。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-EPILOGUE:20688:11","scriptId":20688,"text":"“是是是，长官一直都是这样未雨绸缪啦～”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1923001-EPILOGUE:20688:12","scriptId":20688,"text":"“嗯，小心驶得万年船。”","background":"/art/stories/zdbjbz-02.webp","left":4,"right":740,"section":1,"shake":false}],"summaries":[]}
