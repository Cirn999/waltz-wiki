{"schemaVersion":1,"id":33,"sections":[{"id":"113010-PROLOGUE","name":"第 1 战 · 战前","scripts":[1080],"start":0,"count":10},{"id":"113010-EPILOGUE","name":"第 1 战 · 战后","scripts":[11070],"start":10,"count":8},{"id":"113011-PROLOGUE","name":"第 2 战 · 战前","scripts":[1090],"start":18,"count":11},{"id":"113011-EPILOGUE","name":"第 2 战 · 战后","scripts":[11080],"start":29,"count":6},{"id":"113012-PROLOGUE","name":"第 3 战 · 战前","scripts":[1100],"start":35,"count":15},{"id":"113012-EPILOGUE","name":"第 3 战 · 战后","scripts":[11090],"start":50,"count":5},{"id":"113013-PROLOGUE","name":"第 4 战 · 战前","scripts":[1110],"start":55,"count":4},{"id":"113014-PROLOGUE","name":"第 5 战 · 战前","scripts":[1120],"start":59,"count":5},{"id":"113014-EPILOGUE","name":"第 5 战 · 战后","scripts":[11110],"start":64,"count":22}],"frames":[{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113010-PROLOGUE:1080:2","scriptId":1080,"text":"“战车兽这么成群结队的聚集在研究所周围肯定有古怪。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113010-PROLOGUE:1080:3","scriptId":1080,"text":"“不过我们这点兵力肯定是不够一下子突破的。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113010-PROLOGUE:1080:4","scriptId":1080,"text":"“那就慢慢的引诱出来，逐群击破，虽然有点费时间。”","background":"/art/stories/zdbjbz-03.webp","left":211,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":92,"speaker":"普莉玛·派普","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113010-PROLOGUE:1080:5","scriptId":1080,"text":"“那谁来当诱饵呢？”","background":"/art/stories/zdbjbz-03.webp","left":211,"right":92,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113010-PROLOGUE:1080:6","scriptId":1080,"text":"“佐伊和莉娜，准备去诱敌。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":92,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113010-PROLOGUE:1080:7","scriptId":1080,"text":"“就知道肯定要让我去……”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113010-PROLOGUE:1080:8","scriptId":1080,"text":"“佐伊，别在那里唧唧歪歪了，准备出发了。”","background":"/art/stories/zdbjbz-03.webp","left":81,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113010-PROLOGUE:1080:9","scriptId":1080,"text":"“诶？现在就出发了？我还打算给小飞象做护理呢。”","background":"/art/stories/zdbjbz-03.webp","left":81,"right":36,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113010-PROLOGUE:1080:10","scriptId":1080,"text":"“现在出发？听到了没？？”","background":"/art/stories/zdbjbz-03.webp","left":219,"right":36,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113010-PROLOGUE:1080:11","scriptId":1080,"text":"“没问题……立刻出发……”","background":"/art/stories/zdbjbz-03.webp","left":219,"right":40,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113010-EPILOGUE:11070:1","scriptId":11070,"text":"干掉了佐伊她们引来的战车兽。","background":"/art/stories/zdbjbz-03.webp","left":219,"right":40,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113010-EPILOGUE:11070:2","scriptId":11070,"text":"“一次只能干掉这么点战车兽的话，要什么时候才能清理完啊……”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":40,"section":1,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113010-EPILOGUE:11070:3","scriptId":11070,"text":"“比较慢的话就只能用次数来弥补了，佐伊、莉娜继续！”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":1,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113010-EPILOGUE:11070:4","scriptId":11070,"text":"“什么！？还要再来一次啊……”","background":"/art/stories/zdbjbz-03.webp","left":40,"right":211,"section":1,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113010-EPILOGUE:11070:5","scriptId":11070,"text":"“随时可以出发。”","background":"/art/stories/zdbjbz-03.webp","left":81,"right":211,"section":1,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113010-EPILOGUE:11070:6","scriptId":11070,"text":"“辛苦你们了。”","background":"/art/stories/zdbjbz-03.webp","left":81,"right":219,"section":1,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113010-EPILOGUE:11070:7","scriptId":11070,"text":"“恩……没什么大不了的……”","background":"/art/stories/zdbjbz-03.webp","left":31,"right":219,"section":1,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113010-EPILOGUE:11070:8","scriptId":11070,"text":"（这是折返马拉松吧……）","background":"/art/stories/zdbjbz-03.webp","left":40,"right":219,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113011-PROLOGUE:1090:2","scriptId":1090,"text":"通过佐伊和莉娜的诱敌行动，清理掉了很多战车兽。","background":"/art/stories/zdbjbz-03.webp","left":40,"right":219,"section":2,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113011-PROLOGUE:1090:3","scriptId":1090,"text":"“不行了不行了……跑不动了……”","background":"/art/stories/zdbjbz-03.webp","left":36,"right":219,"section":2,"shake":false},{"kind":"dialogue","head":88,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113011-PROLOGUE:1090:4","scriptId":1090,"text":"“呃，有点累了……”","background":"/art/stories/zdbjbz-03.webp","left":36,"right":88,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113011-PROLOGUE:1090:5","scriptId":1090,"text":"“效果不是很理想，但是也没更好的办法了。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":88,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113011-PROLOGUE:1090:6","scriptId":1090,"text":"“如果有什么办法绕到研究所里面就好了。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113011-PROLOGUE:1090:7","scriptId":1090,"text":"“你是说要找研究所的后门？？”","background":"/art/stories/zdbjbz-03.webp","left":211,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113011-PROLOGUE:1090:8","scriptId":1090,"text":"“我记得……好像是有，给我下地图。”","background":"/art/stories/zdbjbz-03.webp","left":211,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113011-PROLOGUE:1090:9","scriptId":1090,"text":"“给，这是地图。”","background":"/art/stories/zdbjbz-03.webp","left":211,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113011-PROLOGUE:1090:10","scriptId":1090,"text":"“好像是在这块地方。”","background":"/art/stories/zdbjbz-03.webp","left":211,"right":103,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113011-PROLOGUE:1090:11","scriptId":1090,"text":"索菲亚教官大致指了指地图上的方位。","background":"/art/stories/zdbjbz-03.webp","left":211,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113011-PROLOGUE:1090:12","scriptId":1090,"text":"“恩，就先到那里看看吧。”","background":"/art/stories/zdbjbz-03.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113011-EPILOGUE:11080:1","scriptId":11080,"text":"顺着地图的标识，向9点钟位置行进了很久，中途还干掉了几批战车兽。","background":"/art/stories/zdbjbz-03.webp","left":211,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113011-EPILOGUE:11080:2","scriptId":11080,"text":"“怎么还没看到后门啊。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113011-EPILOGUE:11080:3","scriptId":11080,"text":"“大概再往前一点？？”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113011-EPILOGUE:11080:4","scriptId":11080,"text":"“……”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":3,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113011-EPILOGUE:11080:5","scriptId":11080,"text":"“不用担心啦，虽然我很久没来了，但是后门大概的方向还是知道的。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113011-EPILOGUE:11080:6","scriptId":11080,"text":"（越发让人担心……）","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113012-PROLOGUE:1100:2","scriptId":1100,"text":"研究所中的某间研究室----","background":"/art/stories/zdjm-034.webp","left":3,"right":211,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113012-PROLOGUE:1100:3","scriptId":1100,"text":"实验床上正躺着一只战车兽，而两个人形生物就站在它的身边。","background":"/art/stories/zdjm-034.webp","left":3,"right":211,"section":4,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"113012-PROLOGUE:1100:4","scriptId":1100,"text":"“外面好像有点动静？？”","background":"/art/stories/zdjm-034.webp","left":55,"right":211,"section":4,"shake":false},{"kind":"dialogue","head":57,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"113012-PROLOGUE:1100:5","scriptId":1100,"text":"“有吗？我怎么没听到？？”","background":"/art/stories/zdjm-034.webp","left":55,"right":57,"section":4,"shake":false},{"kind":"dialogue","head":55,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"113012-PROLOGUE:1100:6","scriptId":1100,"text":"“我只是说好像而已，从战车兽的波长来看，西边有点骚动。”","background":"/art/stories/zdjm-034.webp","left":55,"right":57,"section":4,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"113012-PROLOGUE:1100:7","scriptId":1100,"text":"“哦哦～被你这么一说，我好像也感觉到了。”","background":"/art/stories/zdjm-034.webp","left":55,"right":53,"section":4,"shake":false},{"kind":"dialogue","head":53,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"113012-PROLOGUE:1100:8","scriptId":1100,"text":"“兰布达的波长感应能力果然了得。”","background":"/art/stories/zdjm-034.webp","left":55,"right":53,"section":4,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"113012-PROLOGUE:1100:9","scriptId":1100,"text":"“哼，就算夸我也不会有什么好处的。”","background":"/art/stories/zdjm-034.webp","left":56,"right":53,"section":4,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"113012-PROLOGUE:1100:10","scriptId":1100,"text":"“既然已经感觉到了的话，那就去看看，不要打扰我的实验。”","background":"/art/stories/zdjm-034.webp","left":56,"right":53,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113012-PROLOGUE:1100:11","scriptId":1100,"text":"被称为兰布达的人形生物一边不紧不慢地下达着指示，一边仍在不停地操作着研究室里的器械。","background":"/art/stories/zdjm-034.webp","left":56,"right":53,"section":4,"shake":false},{"kind":"dialogue","head":57,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"113012-PROLOGUE:1100:12","scriptId":1100,"text":"“好好好～马上去。”","background":"/art/stories/zdjm-034.webp","left":56,"right":57,"section":4,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"113012-PROLOGUE:1100:13","scriptId":1100,"text":"“对了，只是让你去看看，千万别给我闹出很大的动静，埃普西隆。”","background":"/art/stories/zdjm-034.webp","left":56,"right":57,"section":4,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"113012-PROLOGUE:1100:14","scriptId":1100,"text":"“唯独这个我不能保证～”","background":"/art/stories/zdjm-034.webp","left":56,"right":48,"section":4,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"113012-PROLOGUE:1100:15","scriptId":1100,"text":"“……”","background":"/art/stories/zdjm-034.webp","left":56,"right":48,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113012-PROLOGUE:1100:16","scriptId":1100,"text":"说完，埃普西隆就离开了兰布达所在的研究室。","background":"/art/stories/zdjm-034.webp","left":56,"right":48,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113012-EPILOGUE:11090:1","scriptId":11090,"text":"镜头回到教官一行。","background":"/art/stories/zdbjbz-03.webp","left":56,"right":48,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113012-EPILOGUE:11090:2","scriptId":11090,"text":"“从这边突破应该就没问题了吧。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":48,"section":5,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113012-EPILOGUE:11090:3","scriptId":11090,"text":"“恩，一直往前，就能到研究所的后门了。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113012-EPILOGUE:11090:4","scriptId":11090,"text":"望了一眼前方，密密麻麻的一大批战车兽……","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113012-EPILOGUE:11090:5","scriptId":11090,"text":"“好像也没比正面突破好到哪去……”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113013-PROLOGUE:1110:2","scriptId":1110,"text":"“现在这位置，如果受到左右包夹，我们估计很难全身而退啊……”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":6,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113013-PROLOGUE:1110:3","scriptId":1110,"text":"“所以才要快点突破这里，攻到研究所周边区域的话，就不会被包夹了。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":6,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113013-PROLOGUE:1110:4","scriptId":1110,"text":"“休息的也差不多了，继续开路。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":6,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113013-PROLOGUE:1110:5","scriptId":1110,"text":"索菲亚教官说完，再次投身到前方激烈的战斗中去了。","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113014-PROLOGUE:1120:2","scriptId":1120,"text":"“哦，终于要到了吗？”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":7,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113014-PROLOGUE:1120:3","scriptId":1120,"text":"“恩，我们这边清理完以后，你就和普莉玛一起过来吧。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":7,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113014-PROLOGUE:1120:4","scriptId":1120,"text":"有教官一起战斗，即使敌众我寡也能处于绝对优势，真是可靠至极。","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113014-PROLOGUE:1120:5","scriptId":1120,"text":"“好的，那么教官大人加油。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":7,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113014-PROLOGUE:1120:6","scriptId":1120,"text":"“恩，不用你说我也会这么做的。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":7,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113014-EPILOGUE:11110:1","scriptId":11110,"text":"费了九牛二虎之力，终于到达了‘后门’？","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113014-EPILOGUE:11110:2","scriptId":11110,"text":"众人面前矗立着一堵高耸的围墙。","background":"/art/stories/zdbjbz-03.webp","left":3,"right":211,"section":8,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:3","scriptId":11110,"text":"“这里就是后门？我怎么什么都没看到啊……”","background":"/art/stories/zdbjbz-03.webp","left":41,"right":211,"section":8,"shake":false},{"kind":"dialogue","head":108,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:4","scriptId":11110,"text":"“不会是走错了吧？”","background":"/art/stories/zdbjbz-03.webp","left":41,"right":108,"section":8,"shake":false},{"kind":"dialogue","head":221,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:5","scriptId":11110,"text":"“怎么可能～我看看……开门机关在哪里。”","background":"/art/stories/zdbjbz-03.webp","left":221,"right":108,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:6","scriptId":11110,"text":"“果然是有秘密开门按钮。”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":108,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113014-EPILOGUE:11110:7","scriptId":11110,"text":"我和索菲亚教官一样也开始在墙壁上摸索着。","background":"/art/stories/zdbjbz-03.webp","left":3,"right":108,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113014-EPILOGUE:11110:8","scriptId":11110,"text":"半个小时过去了……整个小队的人都在墙壁周边寻找着‘开关’……","background":"/art/stories/zdbjbz-03.webp","left":3,"right":108,"section":8,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:9","scriptId":11110,"text":"“摸了那么久什么都没有，总觉得是走错了……”（小声）","background":"/art/stories/zdbjbz-03.webp","left":40,"right":108,"section":8,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:10","scriptId":11110,"text":"“你这话可别让教官听到了……”（小声）","background":"/art/stories/zdbjbz-03.webp","left":40,"right":81,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:11","scriptId":11110,"text":"“没办法，我们必须陪着教官死撑……”（小声）","background":"/art/stories/zdbjbz-03.webp","left":3,"right":81,"section":8,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:12","scriptId":11110,"text":"“你们在讨论什么呢？”","background":"/art/stories/zdbjbz-03.webp","left":219,"right":81,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:13","scriptId":11110,"text":"“没什么，只是在想这个开关藏得好隐蔽，完全找不到啊～”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":81,"section":8,"shake":false},{"kind":"dialogue","head":221,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:14","scriptId":11110,"text":"“哼哼哼哼，大家都不用找了，我知道怎么开门了。”","background":"/art/stories/zdbjbz-03.webp","left":221,"right":81,"section":8,"shake":false},{"kind":"dialogue","head":92,"speaker":"普莉玛·派普","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:15","scriptId":11110,"text":"“真的吗？”","background":"/art/stories/zdbjbz-03.webp","left":221,"right":92,"section":8,"shake":false},{"kind":"dialogue","head":221,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:16","scriptId":11110,"text":"“当然，千真万确～大家都让开点。”","background":"/art/stories/zdbjbz-03.webp","left":221,"right":92,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113014-EPILOGUE:11110:18","scriptId":11110,"text":"说罢，索菲亚教官摆开出了一个战斗架势……","background":"/art/stories/zdbjbz-03.webp","left":221,"right":null,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:19","scriptId":11110,"text":"“这……难道是！！？”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":null,"section":8,"shake":false},{"kind":"dialogue","head":220,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:20","scriptId":11110,"text":"“呵…………哈！！！！！”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":220,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113014-EPILOGUE:11110:22","scriptId":11110,"text":"一声巨响过后，研究所外壁上出现了一个巨大的窟窿……教官铁锤般的一击轻松贯穿了厚实的外壁。","background":"/art/stories/zdbjbz-03.webp","left":3,"right":220,"section":8,"shake":true},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:23","scriptId":11110,"text":"“我们走吧～”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":219,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113014-EPILOGUE:11110:24","scriptId":11110,"text":"“……”","background":"/art/stories/zdbjbz-03.webp","left":3,"right":219,"section":8,"shake":false}],"summaries":["扎营之后----","清理掉了不少战车兽，但是好像还是远远不够……","绕到了研究所的侧面方向。","侧面的战车兽也真是多得可以……","经过一天的激战，离研究所就差一步了。"]}
