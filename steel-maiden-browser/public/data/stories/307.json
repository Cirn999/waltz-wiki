{"schemaVersion":1,"id":307,"sections":[{"id":"607005-PROLOGUE","name":"第 1 战 · 战前","scripts":[20509],"start":0,"count":24},{"id":"607005-EPILOGUE","name":"第 1 战 · 战后","scripts":[20510],"start":24,"count":15}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607005-PROLOGUE:20509:1","scriptId":20509,"text":"死亡彗星小队方面——","background":"/art/stories/zdbjbz-03.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:2","scriptId":20509,"text":"“你们那边怎么样了？奥德莉。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":768,"speaker":"奥德莉·埃斯特拉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:3","scriptId":20509,"text":"“差不多了，分工区域的信号旗基本都已经回收好了，你们呢？”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":768,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:4","scriptId":20509,"text":"“也快了。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":768,"section":0,"shake":false},{"kind":"dialogue","head":768,"speaker":"奥德莉·埃斯特拉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:5","scriptId":20509,"text":"“话说回来，没想到这次你会主动找上我们小队。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":768,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:6","scriptId":20509,"text":"“是吗？我倒是觉得挺合适的，毕竟没有禁止小队间的联手。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":768,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:7","scriptId":20509,"text":"“既能快速收集区域内的信号旗，又能抵御其他队伍的偷袭，收集效率也会提高不少。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":768,"section":0,"shake":false},{"kind":"dialogue","head":776,"speaker":"奥德莉·埃斯特拉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:8","scriptId":20509,"text":"“此言不虚，但是我总觉得你会在最后关头来个倒戈一击啊～”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":776,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:9","scriptId":20509,"text":"“呵呵，虽然我的小队在外面的风评不是很好，但是出尔反尔的情况还是很少有的，这点你尽管放心。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":776,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:10","scriptId":20509,"text":"“再说了，这次的任务奖励也就那样了，不值得同室操戈啦。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":776,"section":0,"shake":false},{"kind":"dialogue","head":770,"speaker":"奥德莉·埃斯特拉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:11","scriptId":20509,"text":"“但愿如此～”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":770,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:12","scriptId":20509,"text":"“你也不要对我放黑枪哟。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":770,"section":0,"shake":false},{"kind":"dialogue","head":768,"speaker":"奥德莉·埃斯特拉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:13","scriptId":20509,"text":"“莉安娜，你的玩笑可真是很好笑呢～”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":768,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607005-PROLOGUE:20509:14","scriptId":20509,"text":"奥德莉把一枚纸片塞入自己的口袋，这是她们小队找到的旗语线索——“MILK”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":768,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607005-PROLOGUE:20509:15","scriptId":20509,"text":"不过纵使小队间有合作关系，奥德莉也不认为旗语线索是可以共享的，因为这样就会导致最终信号旗的分配上出现偏向问题。","background":"/art/stories/zdbjbz-03.webp","left":780,"right":768,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607005-PROLOGUE:20509:16","scriptId":20509,"text":"突然，通信器里传来了嘈杂的声音。","background":"/art/stories/zdbjbz-03.webp","left":780,"right":768,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:17","scriptId":20509,"text":"“恩？什么情况？请回话。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":768,"section":0,"shake":false},{"kind":"dialogue","head":859,"speaker":"莎娃·叶尔马科夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:18","scriptId":20509,"text":"“十一点钟的方向有一支队伍朝我们过来了。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":859,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:19","scriptId":20509,"text":"“是特勤局还是死水的？”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":859,"section":0,"shake":false},{"kind":"dialogue","head":859,"speaker":"莎娃·叶尔马科夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:20","scriptId":20509,"text":"“是死水的。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":859,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:21","scriptId":20509,"text":"“吼喔～自己人啊～那更好，知己知彼。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":859,"section":0,"shake":false},{"kind":"dialogue","head":775,"speaker":"奥德莉·埃斯特拉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:22","scriptId":20509,"text":"“是准备进攻了？不考虑一起合作吗？”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":775,"section":0,"shake":false},{"kind":"dialogue","head":780,"speaker":"莉安娜·弗洛森","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:23","scriptId":20509,"text":"“当然不考虑，两小队平分战利品已经是我容忍的极限了。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":775,"section":0,"shake":false},{"kind":"dialogue","head":768,"speaker":"奥德莉·埃斯特拉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-PROLOGUE:20509:24","scriptId":20509,"text":"“ＯＫＯＫ，准备进攻。”","background":"/art/stories/zdbjbz-03.webp","left":780,"right":768,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607005-EPILOGUE:20510:1","scriptId":20510,"text":"费了九牛二虎之力终于撤出了刚才的战斗区域。","background":"/art/stories/zdbjbz-03.webp","left":780,"right":768,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607005-EPILOGUE:20510:2","scriptId":20510,"text":"虽然是遗失了一些刚收集到的信号旗，但从结果来说还是可以接受的程度。","background":"/art/stories/zdbjbz-03.webp","left":780,"right":768,"section":1,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-EPILOGUE:20510:3","scriptId":20510,"text":"“呼……没想到要同时对付莉安娜和奥德莉她们两队人……”","background":"/art/stories/zdbjbz-03.webp","left":578,"right":768,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-EPILOGUE:20510:4","scriptId":20510,"text":"“这真是犯规啊，两支队伍一起行动，人数占尽了优势。”","background":"/art/stories/zdbjbz-03.webp","left":578,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-EPILOGUE:20510:5","scriptId":20510,"text":"“很合理的联手模式，而且没有明令禁止队伍间的合作，她们这倒是提醒了我……”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-EPILOGUE:20510:6","scriptId":20510,"text":"“长官是不是认为我们也应该去找个队伍联手？”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-EPILOGUE:20510:7","scriptId":20510,"text":"“是啊，人数优势在这地域宽广的乱战环境中是很有用处的，无论是自卫防守还是主动出击。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":747,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-EPILOGUE:20510:8","scriptId":20510,"text":"“但是现在我们上哪儿去找可以联手的队伍啊……我们可是最后一个出发的队伍啊。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":747,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-EPILOGUE:20510:9","scriptId":20510,"text":"“这倒是个问题……”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":747,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-EPILOGUE:20510:10","scriptId":20510,"text":"“还是先专注在当前的回收工作吧。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-EPILOGUE:20510:11","scriptId":20510,"text":"“确实如此。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-EPILOGUE:20510:12","scriptId":20510,"text":"“对了，这TUBE是一组正确的兑换旗语吧？”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-EPILOGUE:20510:13","scriptId":20510,"text":"“不知道啊，怎么突然说这个？”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607005-EPILOGUE:20510:14","scriptId":20510,"text":"“我刚才捡到的纸片上有写着这组单词，感觉上应该是散落的线索。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607005-EPILOGUE:20510:15","scriptId":20510,"text":"“那就去换换看咯，反正换错了也不吃亏～”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":572,"section":1,"shake":false}],"summaries":[]}
