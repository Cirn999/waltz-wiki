{"schemaVersion":1,"id":394,"sections":[{"id":"913001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20666],"start":0,"count":22},{"id":"913001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20667],"start":22,"count":16}],"frames":[{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:1","scriptId":20666,"text":"“啊哈，原来是这家伙带的队伍……我就知道……”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:2","scriptId":20666,"text":"“这家伙的队伍怎么了？”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:3","scriptId":20666,"text":"“诶……奥米克戎队长！？”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:4","scriptId":20666,"text":"“我看你鬼鬼祟祟的，果然在搞什么名堂。”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"913001-PROLOGUE:20666:5","scriptId":20666,"text":"不过奥米克戎好像并没有生气的样子。","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:6","scriptId":20666,"text":"“之前西格玛让我处理掉老的据点，我来确认一下实验体干得如何了。”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:7","scriptId":20666,"text":"“然后就发现这些实验体被消灭了大半？”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"913001-PROLOGUE:20666:8","scriptId":20666,"text":"奥米克戎看到了地上正在冒烟的实验体，已经猜到了事情的大概。","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:9","scriptId":20666,"text":"“是的，这家伙就是和阿尔库涅大人发生接触的人类。”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"913001-PROLOGUE:20666:10","scriptId":20666,"text":"听到阿尔库涅的名字奥米克戎眯起了眼睛。","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:11","scriptId":20666,"text":"“你这么一说我有点印象了。”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:12","scriptId":20666,"text":"“好像是会玩点战术的人类，你让实验体都撤回来了？”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:13","scriptId":20666,"text":"“是的。”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:14","scriptId":20666,"text":"“正确的判断，实验体在没有指挥的情况下也就是点虾兵蟹将。”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:15","scriptId":20666,"text":"“而且你的处理工作不够干净，怎么会有带着迪塔格项圈的钢舞姬？”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:16","scriptId":20666,"text":"“那个……”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"913001-PROLOGUE:20666:17","scriptId":20666,"text":"柯西一时语塞。","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:18","scriptId":20666,"text":"“算了，这种意料之外的情况我也能够理解。”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:19","scriptId":20666,"text":"“那接下来……？”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:20","scriptId":20666,"text":"“当然是和他玩玩，要让人类了解下在纯粹的力量面前战术不过是徒劳的挣扎。”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:21","scriptId":20666,"text":"“哦哦。”","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"913001-PROLOGUE:20666:22","scriptId":20666,"text":"（也好，我只要跟在后面看戏就行了。）","background":"/art/stories/zdbjbz-05.webp","left":430,"right":421,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:1","scriptId":20667,"text":"“这些敌人好像突然换了一种战术……”","background":"/art/stories/zdbjbz-05.webp","left":584,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:2","scriptId":20667,"text":"“分了一批人专门进行防御，然后向我们这边慢慢推进，是兵力优势时喜欢使用的蚕食战术啊……”","background":"/art/stories/zdbjbz-05.webp","left":584,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:3","scriptId":20667,"text":"“嗯，比起刚才来变得非常有组织，不再是径直突击的模式了。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:4","scriptId":20667,"text":"“可能是敌人的指挥官来了吧……”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:5","scriptId":20667,"text":"“旅行者的指挥官？”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1135,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:6","scriptId":20667,"text":"“是的，在这里遇上的话，我们的胜率一下子就跌到了谷底……”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1135,"section":1,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:7","scriptId":20667,"text":"“那怎么办……”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1135,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:8","scriptId":20667,"text":"“好在临走波西娅给了一件宝贝，不到万不得已的时候我不会使用。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1135,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"913001-EPILOGUE:20667:9","scriptId":20667,"text":"我从行李的包裹里拿出了一个类似发报机的东西。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1135,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:10","scriptId":20667,"text":"“这个是超距离远程火炮的控制器之一，可以用来呼叫远程火力支援。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1135,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:11","scriptId":20667,"text":"“不过就一次机会，所以要好好利用。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1135,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:12","scriptId":20667,"text":"“哦哦！？意思是把敌人骗到一起，然后用远程火力一口气消灭？”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:13","scriptId":20667,"text":"“不得了，今天没下雪啊，佐伊你竟然知道我接下来要说的？”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:14","scriptId":20667,"text":"“哼哼，诱敌这种事情就交给我们吧，特别还有安妮这个大诱饵在，小菜一碟啦~”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:15","scriptId":20667,"text":"“确实，跟了我那么久至少也会学到点皮毛~那么我们先制定一下诱饵计划。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"913001-EPILOGUE:20667:16","scriptId":20667,"text":"“又臭美。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false}],"summaries":[]}
