{"schemaVersion":1,"id":-40110,"sections":[{"id":"script-20110","name":"原始脚本 20110","scripts":[20110],"start":0,"count":16}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20110:20110:0","scriptId":20110,"text":"费了一番功夫终于把那些软泥一样的怪物干掉了。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":634,"speaker":"扎莉·魏特曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20110:20110:1","scriptId":20110,"text":"“还可以嘛，至少比战车兽打起来有感觉，虽然看上去没什么智力，但是反应速度却高战车兽一筹。”","background":"/art/stories/zjm-047.webp","left":634,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":535,"speaker":"伊达·布鲁克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20110:20110:2","scriptId":20110,"text":"“还好没被那爆散开的液体沾到……”","background":"/art/stories/zjm-047.webp","left":634,"right":535,"section":0,"shake":false},{"kind":"dialogue","head":698,"speaker":"米歇尔·法梅加","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20110:20110:3","scriptId":20110,"text":"“你仔细看看，就算被沾到也只是一时的，那些怪物都变成了数据链，和之前消灭的模拟战车兽一样都是数据而已。”","background":"/art/stories/zjm-047.webp","left":698,"right":535,"section":0,"shake":false},{"kind":"dialogue","head":535,"speaker":"伊达·布鲁克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20110:20110:4","scriptId":20110,"text":"“啊？是这样吗？”","background":"/art/stories/zjm-047.webp","left":698,"right":535,"section":0,"shake":false},{"kind":"dialogue","head":692,"speaker":"米歇尔·法梅加","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20110:20110:5","scriptId":20110,"text":"“不仔细观察，只知道瞎嚷嚷……”","background":"/art/stories/zjm-047.webp","left":692,"right":535,"section":0,"shake":false},{"kind":"dialogue","head":642,"speaker":"扎莉·魏特曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20110:20110:6","scriptId":20110,"text":"“好了好了，波西娅，人呢？软泥都清理掉了。”","background":"/art/stories/zjm-047.webp","left":692,"right":642,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20110:20110:7","scriptId":20110,"text":"扎莉这么一吼，果然波西娅瞬间出现在了众人面前。","background":"/art/stories/zjm-047.webp","left":692,"right":642,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20110:20110:8","scriptId":20110,"text":"“恩，很漂亮，那些战斗数据我都记录到了～”","background":"/art/stories/zjm-047.webp","left":608,"right":642,"section":0,"shake":false},{"kind":"dialogue","head":640,"speaker":"扎莉·魏特曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20110:20110:9","scriptId":20110,"text":"“那就好，那么我们可以回去了吗？”","background":"/art/stories/zjm-047.webp","left":608,"right":640,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20110:20110:10","scriptId":20110,"text":"波西娅两眼发光～","background":"/art/stories/zjm-047.webp","left":608,"right":640,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20110:20110:11","scriptId":20110,"text":"“要不要挑战一下阿芙罗拉……的数据～？”","background":"/art/stories/zjm-047.webp","left":608,"right":640,"section":0,"shake":false},{"kind":"dialogue","head":638,"speaker":"扎莉·魏特曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20110:20110:12","scriptId":20110,"text":"“哦！？听上去不错。”","background":"/art/stories/zjm-047.webp","left":608,"right":638,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20110:20110:13","scriptId":20110,"text":"“还有一个么，有不明的数据敌人等待处理，看上去很强大的样子，你要去哪个？”","background":"/art/stories/zjm-047.webp","left":608,"right":638,"section":0,"shake":false},{"kind":"dialogue","head":635,"speaker":"扎莉·魏特曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20110:20110:14","scriptId":20110,"text":"“真是个难题……让我想想……”","background":"/art/stories/zjm-047.webp","left":608,"right":635,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20110:20110:15","scriptId":20110,"text":"“快点想吧，想好了我就传送了哟～”","background":"/art/stories/zjm-047.webp","left":608,"right":635,"section":0,"shake":false}],"summaries":[]}
