{"schemaVersion":1,"id":499,"sections":[{"id":"1918001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20677],"start":0,"count":21},{"id":"1918001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20678],"start":21,"count":46}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-PROLOGUE:20677:1","scriptId":20677,"text":"不知道为什么犬次郎并没跑出中继站，而是在这个中继站来回转悠，最终它停在了一间小屋门口。","background":"/art/stories/zdbjbz-05.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-PROLOGUE:20677:2","scriptId":20677,"text":"这间小屋是这个中继站的营房，士兵们休息的地方。","background":"/art/stories/zdbjbz-05.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:3","scriptId":20677,"text":"“嗯？”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-PROLOGUE:20677:4","scriptId":20677,"text":"就在我们走近小屋的时候，小屋的门“吱呀”一声打开了。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-PROLOGUE:20677:5","scriptId":20677,"text":"从里面走出的人物让我们大吃一惊——是齐奈达·维尔金斯卡娅！","background":"/art/stories/zdbjbz-05.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:6","scriptId":20677,"text":"“…………”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:7","scriptId":20677,"text":"“什么！？齐奈达！？”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-PROLOGUE:20677:8","scriptId":20677,"text":"我赶忙掏出照片比对。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:9","scriptId":20677,"text":"“啊，是齐奈达～你怎么在这里啊？”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":742,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:10","scriptId":20677,"text":"“啊哈～我们把她带回去是不是完成任务了？这次真是白捡个大便宜。”","background":"/art/stories/zdbjbz-05.webp","left":742,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:11","scriptId":20677,"text":"“确实省了不少功夫。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:12","scriptId":20677,"text":"“…………”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:13","scriptId":20677,"text":"“异常目标发现，驱逐。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-PROLOGUE:20677:14","scriptId":20677,"text":"让我们出乎意料，这位刚见面的钢舞姬突然举起了手里的武器！","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":593,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:15","scriptId":20677,"text":"“长官小心！！”","background":"/art/stories/zdbjbz-05.webp","left":593,"right":1137,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-PROLOGUE:20677:18","scriptId":20677,"text":"由于佩妮的及时反应，瞄准我的炮弹被佩妮用舞装挡下了。","background":"/art/stories/zdbjbz-05.webp","left":593,"right":1137,"section":0,"shake":true},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:19","scriptId":20677,"text":"“怎么回事！？我们被攻击了？佩妮你不要紧吧！？”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":589,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:20","scriptId":20677,"text":"“还行，只是舞装可能报废了一半。”","background":"/art/stories/zdbjbz-05.webp","left":589,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:21","scriptId":20677,"text":"“别说这些了！在硝烟散去之前，我们先要和这个中继站拉开距离！那些士兵也跑来了！”","background":"/art/stories/zdbjbz-05.webp","left":589,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:22","scriptId":20677,"text":"“这……难道整个中继站的人都是敌人？？”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-PROLOGUE:20677:23","scriptId":20677,"text":"“优先撤出敌人的包围网！！然后找机会开始反击！！”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:1","scriptId":20678,"text":"由于我们趁着炮弹造成的烟雾，迅速脱离中继站，敌人的包围网并没有形成。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:2","scriptId":20678,"text":"在平原上交战一番之后，我们成功击败了以齐奈达为首的一批钢舞姬，当然也包括那些中继站的士兵。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:3","scriptId":20678,"text":"“呼……真是没想到会遇到这种事情……”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":579,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:4","scriptId":20678,"text":"“是啊……齐奈达的性格应该不是这样的，她可是个非常活泼的妹子啊……”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":579,"section":1,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:5","scriptId":20678,"text":"“我相信奈特莉，但我们被攻击也是事实，看来要进行深入调查了……”","background":"/art/stories/zdbjbz-05.webp","left":591,"right":579,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:6","scriptId":20678,"text":"佩妮一边在给自己的舞装做紧急修理，一边也在积极商讨策略。","background":"/art/stories/zdbjbz-05.webp","left":591,"right":579,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:7","scriptId":20678,"text":"“这个中继站的气氛就有问题，死气沉沉的但又感觉无时无刻不被盯着。”","background":"/art/stories/zdbjbz-05.webp","left":591,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:8","scriptId":20678,"text":"“开始清理战场吧，趁药效还没过。”","background":"/art/stories/zdbjbz-05.webp","left":596,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:9","scriptId":20678,"text":"这次我们作战采用的是对战车兽用的麻醉弹，尽管或多或少会造成一些伤害，但总得来说并不致命。","background":"/art/stories/zdbjbz-05.webp","left":596,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:10","scriptId":20678,"text":"给沉睡的士兵们都绑上绳子，但钢舞姬就没那么简单了，一般的绳索对她们没有束缚力。","background":"/art/stories/zdbjbz-05.webp","left":596,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:11","scriptId":20678,"text":"“先把她们都吊起来？”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:12","scriptId":20678,"text":"“噫……长官你原来那么鬼畜的吗？”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:13","scriptId":20678,"text":"“好好说话，我们现在没有专门让钢舞姬无力化的东西，她们醒过来要是反抗的话，我们只能再继续用麻醉弹……”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":588,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:14","scriptId":20678,"text":"“吊起来的话，让她们有力也没处使，倒是个方法……但从长官嘴里说出来确实有点……”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":588,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:15","scriptId":20678,"text":"“佩妮，怎么连你也……”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":588,"section":1,"shake":false},{"kind":"dialogue","head":590,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:16","scriptId":20678,"text":"“开玩笑的。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":590,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:18","scriptId":20678,"text":"于是我们把这些沉睡的钢舞姬都一个个用钢索吊了起来。","background":"/art/stories/zdbjbz-05.webp","left":null,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:19","scriptId":20678,"text":"“报告，已经联络其他队伍过来帮忙。”","background":"/art/stories/zdbjbz-05.webp","left":null,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:20","scriptId":20678,"text":"“嗯，这样就好，接下来就是等援军来了。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:21","scriptId":20678,"text":"不过在援军到来之前，我们的目标人物齐奈达倒是先醒了过来。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:22","scriptId":20678,"text":"“……”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1137,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:23","scriptId":20678,"text":"和之前遇到的时候一样，她并没有说话，而是开始拼命挣扎。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1137,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:24","scriptId":20678,"text":"“挣扎是徒劳的，就算您能挣脱，你的弹药我们也已经都卸了，根本没有胜算。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1137,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:25","scriptId":20678,"text":"但齐奈达就像是没有听到我说的一样，还是在那儿疯狂挣扎。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1137,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:26","scriptId":20678,"text":"考虑到绳索的耐久度，于是不得只能再消耗一枚麻醉弹。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1137,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:27","scriptId":20678,"text":"“真是没办法，佐伊，给她来发麻醉弹。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1137,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:28","scriptId":20678,"text":"“好嘞～”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:29","scriptId":20678,"text":"佐伊麻利地换上麻醉弹。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:30","scriptId":20678,"text":"“注意爆炸范围……我可不想被殃及池鱼。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:31","scriptId":20678,"text":"这么说着，我退到了佐伊的身后并拿出手帕捂住口鼻。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:32","scriptId":20678,"text":"“砰”地一声，佐伊射出了麻醉弹，但没想到是颗哑弹……","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:33","scriptId":20678,"text":"“诶！？哑弹？那我再来一发。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":589,"speaker":"佩妮·谢尔曼","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:34","scriptId":20678,"text":"“不用了……姐姐刚才的那发炮弹擦到了人家的脑袋，她晕过去了……”","background":"/art/stories/zdbjbz-05.webp","left":589,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:35","scriptId":20678,"text":"由于齐奈达在挣扎的关系，佐伊的哑弹碰巧也发挥了效果，这就是所谓的“物理麻醉”吧。","background":"/art/stories/zdbjbz-05.webp","left":589,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:37","scriptId":20678,"text":"大约一个多小时后，蕾贝卡小队抵达。","background":"/art/stories/zdbjbz-05.webp","left":null,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:38","scriptId":20678,"text":"“哟，蕾贝卡，这次要劳烦你们了。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":null,"section":1,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:39","scriptId":20678,"text":"“几天不见竟然又有麻烦了啊，长官可真是多灾多难啊。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1140,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:40","scriptId":20678,"text":"“这些人的精神可能发生了异常，竟然会无端攻击我们，你把他们带回总部去检查一下。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1140,"section":1,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:41","scriptId":20678,"text":"“那这位可爱的小姑娘呢？”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1140,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:42","scriptId":20678,"text":"蕾贝卡指了指齐奈达，因为只有她是被我指明留下的。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1140,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:43","scriptId":20678,"text":"“因为只有她是戴着迪塔格项圈，她可能无法离开这个区域。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1140,"section":1,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:44","scriptId":20678,"text":"“这是什么意思？”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1140,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:45","scriptId":20678,"text":"于是我们把关于迪塔格项圈的事情告诉了蕾贝卡。","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1140,"section":1,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:46","scriptId":20678,"text":"“这样的话，确实没什么好办法了呢……那先行动吧，趁着麻醉还没过我就带队先把其他人带回去了。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1140,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1918001-EPILOGUE:20678:47","scriptId":20678,"text":"“嗯，有劳。”","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1140,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1918001-EPILOGUE:20678:48","scriptId":20678,"text":"告别蕾贝卡之后，大约过了两个小时，齐奈达又醒了，不过这一次……","background":"/art/stories/zdbjbz-05.webp","left":4,"right":1140,"section":1,"shake":false}],"summaries":[]}
