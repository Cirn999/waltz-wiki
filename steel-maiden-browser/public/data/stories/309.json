{"schemaVersion":1,"id":309,"sections":[{"id":"607007-PROLOGUE","name":"第 1 战 · 战前","scripts":[20513],"start":0,"count":21},{"id":"607007-EPILOGUE","name":"第 1 战 · 战后","scripts":[20514],"start":21,"count":15}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607007-PROLOGUE:20513:1","scriptId":20513,"text":"沙狐小队被指名要参加这次军备测试。","background":"/art/stories/zdbjbz-12.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:2","scriptId":20513,"text":"“哈啊——这种活动真是没劲啊～”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607007-PROLOGUE:20513:3","scriptId":20513,"text":"蕾贝卡打了个哈欠，一脸无精打采。","background":"/art/stories/zdbjbz-12.webp","left":223,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:4","scriptId":20513,"text":"“没办法啦～从一上午的战况来看就没有一支小队敢主动靠过来的～”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":235,"section":0,"shake":false},{"kind":"dialogue","head":247,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:5","scriptId":20513,"text":"“因为规则里注明可以互相夺旗，那谁还敢靠近我们啊……”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":247,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:6","scriptId":20513,"text":"“没有硬性规定小队之间遇到了就一定要互相战斗的啊……我们小队的形象有那么凶神恶煞吗？”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":247,"section":0,"shake":false},{"kind":"dialogue","head":253,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:7","scriptId":20513,"text":"“实力摆在那里嘛～嗯嗯，强者都是孤独的～”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":253,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:8","scriptId":20513,"text":"“就凭你那三脚猫功夫，还是别那么骄傲自大，容易打脸。”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":253,"section":0,"shake":false},{"kind":"dialogue","head":253,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:9","scriptId":20513,"text":"“哼哼哼～就算蕾贝卡你这么说，然而现实就是根本不会有人来挑战我们的嘛～”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":253,"section":0,"shake":false},{"kind":"dialogue","head":240,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:10","scriptId":20513,"text":"“好好回收信号旗也不错啊，收益也挺好，为什么就一定要打来打去的啊……”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":240,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:11","scriptId":20513,"text":"“因为好玩啊～平时根本没有时间啦～”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":240,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607007-PROLOGUE:20513:12","scriptId":20513,"text":"蕾贝卡手里捏着一张纸条，这是刚才从战场里拾到的重要旗语，上面写着“HINT＂","background":"/art/stories/zdbjbz-12.webp","left":223,"right":240,"section":0,"shake":false},{"kind":"dialogue","head":242,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:13","scriptId":20513,"text":"“……”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":242,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:14","scriptId":20513,"text":"“我们主动出击吧，我看到合适的目标了～”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":242,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607007-PROLOGUE:20513:15","scriptId":20513,"text":"蕾贝卡好像观察到了什么。","background":"/art/stories/zdbjbz-12.webp","left":223,"right":242,"section":0,"shake":false},{"kind":"dialogue","head":253,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:16","scriptId":20513,"text":"“哦？难道是扎莉她们？和黑色闪电过招说不定挺带感。”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":253,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:17","scriptId":20513,"text":"“不不，是更有趣的家伙～七点方向，你看看，谁来了？”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":253,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607007-PROLOGUE:20513:18","scriptId":20513,"text":"蕾贝卡把望远镜递给了雷娅。","background":"/art/stories/zdbjbz-12.webp","left":223,"right":253,"section":0,"shake":false},{"kind":"dialogue","head":253,"speaker":"雷娅·古德里安","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:19","scriptId":20513,"text":"“呜呼呼～～原来是他们啊～那真是有点意思了。”","background":"/art/stories/zdbjbz-12.webp","left":253,"right":253,"section":0,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:20","scriptId":20513,"text":"“真是的，你们两个可要注意分寸啊。”","background":"/art/stories/zdbjbz-12.webp","left":253,"right":235,"section":0,"shake":false},{"kind":"dialogue","head":253,"speaker":"雷娅·古德里安","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-PROLOGUE:20513:21","scriptId":20513,"text":"“安啦～”","background":"/art/stories/zdbjbz-12.webp","left":253,"right":235,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607007-EPILOGUE:20514:1","scriptId":20514,"text":"","background":"/art/stories/zdbjbz-12.webp","left":253,"right":235,"section":1,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:2","scriptId":20514,"text":"“没想到让他们逃了～”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":235,"section":1,"shake":false},{"kind":"dialogue","head":253,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:3","scriptId":20514,"text":"“能从我们手里逃掉，他们也算是有些长进啊。”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":253,"section":1,"shake":false},{"kind":"dialogue","head":237,"speaker":"露米娜·施泰特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:4","scriptId":20514,"text":"“这不就是所谓的成长吗～应该替她们高兴才是。”","background":"/art/stories/zdbjbz-12.webp","left":237,"right":253,"section":1,"shake":false},{"kind":"dialogue","head":253,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:5","scriptId":20514,"text":"“嘛～也不是正面对决，中间还混进来了几支想浑水摸鱼的队伍。”","background":"/art/stories/zdbjbz-12.webp","left":237,"right":253,"section":1,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:6","scriptId":20514,"text":"“恩，是特勤局的队伍……虽然不是什么知名小队，但也有点实力。”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":253,"section":1,"shake":false},{"kind":"dialogue","head":247,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:7","scriptId":20514,"text":"“但我有点奇怪，特勤局的队伍好像并不在意信号旗。”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":247,"section":1,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:8","scriptId":20514,"text":"“是啊，明明旗帜都在我这里，但目标却都集中在蕾贝卡那里。”","background":"/art/stories/zdbjbz-12.webp","left":235,"right":247,"section":1,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:9","scriptId":20514,"text":"“哼，特勤局这点小伎俩……应该是在观测我们死水的战斗力吧。”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":247,"section":1,"shake":false},{"kind":"dialogue","head":256,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:10","scriptId":20514,"text":"“就是说这次行动只是障眼法咯。”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":256,"section":1,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:11","scriptId":20514,"text":"“没错，不然他们怎么会那么好心提供物资援助。”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":256,"section":1,"shake":false},{"kind":"dialogue","head":237,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:12","scriptId":20514,"text":"“不过观测就观测咯，知道我们的战力也好对我们尊重些不是吗～”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":237,"section":1,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:13","scriptId":20514,"text":"“展现过强的实力会成为祸患。”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":237,"section":1,"shake":false},{"kind":"dialogue","head":254,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:14","scriptId":20514,"text":"“……蕾贝卡你不会在刚才的战斗里放水了吧？”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":254,"section":1,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607007-EPILOGUE:20514:15","scriptId":20514,"text":"“哈哈～我也不知道啊～”","background":"/art/stories/zdbjbz-12.webp","left":223,"right":254,"section":1,"shake":false}],"summaries":[]}
