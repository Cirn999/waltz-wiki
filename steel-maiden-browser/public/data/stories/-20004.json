{"schemaVersion":1,"id":-20004,"sections":[{"id":"script-4","name":"原始脚本 4","scripts":[4],"start":0,"count":7}],"frames":[{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-4:4:1","scriptId":4,"text":"“认识一下，我是拉伊莎·斯维特兰娜，负责这片区域的侦察工作。旁边这位是负责侦察的莱尼·博克。”","background":"/art/stories/zjm-166.webp","left":71,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-4:4:2","scriptId":4,"text":"“你好。”","background":"/art/stories/zjm-166.webp","left":71,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-4:4:3","scriptId":4,"text":"“她是佐伊·谢尔曼，情况非常，介绍就到这里。”","background":"/art/stories/zjm-166.webp","left":3,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-4:4:4","scriptId":4,"text":"“诶！？就这么省略掉了？”","background":"/art/stories/zjm-166.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-4:4:5","scriptId":4,"text":"“那接下来的战斗就拜托两位了。”","background":"/art/stories/zjm-166.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-4:4:6","scriptId":4,"text":"“好嘞。”","background":"/art/stories/zjm-166.webp","left":61,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-4:4:7","scriptId":4,"text":"“了解。”","background":"/art/stories/zjm-166.webp","left":61,"right":71,"section":0,"shake":false}],"summaries":[]}
