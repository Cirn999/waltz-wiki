{"schemaVersion":1,"id":390,"sections":[{"id":"909001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20658],"start":0,"count":18},{"id":"909001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20659],"start":18,"count":11}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"909001-PROLOGUE:20658:1","scriptId":20658,"text":"旅行者的某处据点——","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:2","scriptId":20658,"text":"“柯西，之前让你处理的那个据点怎么样了？”","background":"/art/stories/zdjm-034.webp","left":12,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"909001-PROLOGUE:20658:3","scriptId":20658,"text":"西格玛正在研究她的星门。","background":"/art/stories/zdjm-034.webp","left":12,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:4","scriptId":20658,"text":"“啊？你说哪个据点？”","background":"/art/stories/zdjm-034.webp","left":12,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:5","scriptId":20658,"text":"“你不会是忘了吧？”","background":"/art/stories/zdjm-034.webp","left":12,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:6","scriptId":20658,"text":"“怎么会，我都有清理过啦。”","background":"/art/stories/zdjm-034.webp","left":12,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:7","scriptId":20658,"text":"“真的？”","background":"/art/stories/zdjm-034.webp","left":12,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:8","scriptId":20658,"text":"“当然是真的。”","background":"/art/stories/zdjm-034.webp","left":12,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:9","scriptId":20658,"text":"“你可是最会玩忽职守的，别以为我不知道。”","background":"/art/stories/zdjm-034.webp","left":12,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:10","scriptId":20658,"text":"“啊哈哈，我不过是兴趣使然，在工作之余找一些乐子而已。”","background":"/art/stories/zdjm-034.webp","left":12,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:11","scriptId":20658,"text":"“哦？是吗？我已经不止一次看到你把人类实验体喂骸虫了。”","background":"/art/stories/zdjm-034.webp","left":421,"right":430,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"909001-PROLOGUE:20658:12","scriptId":20658,"text":"奥米克戎的出现让柯西打了个颤。","background":"/art/stories/zdjm-034.webp","left":421,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:13","scriptId":20658,"text":"“啊……是奥米克戎队长。”","background":"/art/stories/zdjm-034.webp","left":421,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:14","scriptId":20658,"text":"“西格玛，你让柯西去处理据点？”","background":"/art/stories/zdjm-034.webp","left":421,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:15","scriptId":20658,"text":"“是啊，有什么不妥么？”","background":"/art/stories/zdjm-034.webp","left":421,"right":12,"section":0,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:16","scriptId":20658,"text":"“不，我只是确认下，虽然目前柯西也没有失手过，但这家伙的处理方式有些粗糙。”","background":"/art/stories/zdjm-034.webp","left":421,"right":12,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:17","scriptId":20658,"text":"“……”","background":"/art/stories/zdjm-034.webp","left":421,"right":12,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"909001-PROLOGUE:20658:18","scriptId":20658,"text":"“保险起见，派些人手过去查看一下吧。”","background":"/art/stories/zdjm-034.webp","left":421,"right":12,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"909001-EPILOGUE:20659:1","scriptId":20659,"text":"“果然啊，一想到和旅行者有关，这事情就不简单。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":12,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"909001-EPILOGUE:20659:2","scriptId":20659,"text":"搜索波谱坐标集的路上遭遇了一些旅行者队伍。","background":"/art/stories/zdbjbz-10.webp","left":4,"right":12,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"909001-EPILOGUE:20659:3","scriptId":20659,"text":"“不过看上去大都是实验体和软泥，问题不大。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":12,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"909001-EPILOGUE:20659:4","scriptId":20659,"text":"“嗯，这点程度对我们来说已经算不上什么了。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"909001-EPILOGUE:20659:5","scriptId":20659,"text":"“你们好厉害，我看到她们都不敢举枪……特别是那些软泥怪。”","background":"/art/stories/zdbjbz-10.webp","left":1135,"right":572,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"909001-EPILOGUE:20659:6","scriptId":20659,"text":"“没事的啦，你把她们看成大号的水果布丁或者是陆行八爪鱼就行啦~”","background":"/art/stories/zdbjbz-10.webp","left":1135,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"909001-EPILOGUE:20659:7","scriptId":20659,"text":"“……”","background":"/art/stories/zdbjbz-10.webp","left":1135,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"909001-EPILOGUE:20659:8","scriptId":20659,"text":"“姐姐，哪有你这么比喻的，这可是能要你性命的危险敌人，请认真点。”","background":"/art/stories/zdbjbz-10.webp","left":1135,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"909001-EPILOGUE:20659:9","scriptId":20659,"text":"“没事……佐伊也是为了我好……”","background":"/art/stories/zdbjbz-10.webp","left":1135,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"909001-EPILOGUE:20659:10","scriptId":20659,"text":"“没关系，对旅行者有阴影是可以理解的，你尽量回避攻击，保护好长官和自己就行了。”","background":"/art/stories/zdbjbz-10.webp","left":1135,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":1135,"speaker":"安妮·沃佳诺娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"909001-EPILOGUE:20659:11","scriptId":20659,"text":"“嗯，好的。”","background":"/art/stories/zdbjbz-10.webp","left":1135,"right":584,"section":1,"shake":false}],"summaries":[]}
