{"schemaVersion":1,"id":30,"sections":[{"id":"113001-PROLOGUE","name":"第 1 战 · 战前","scripts":[990],"start":0,"count":17},{"id":"113001-EPILOGUE","name":"第 1 战 · 战后","scripts":[10980],"start":17,"count":13},{"id":"113002-PROLOGUE","name":"第 2 战 · 战前","scripts":[1000],"start":30,"count":10},{"id":"113002-EPILOGUE","name":"第 2 战 · 战后","scripts":[10990],"start":40,"count":5},{"id":"113003-PROLOGUE","name":"第 3 战 · 战前","scripts":[1010],"start":45,"count":16},{"id":"113003-EPILOGUE","name":"第 3 战 · 战后","scripts":[11000],"start":61,"count":10}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113001-PROLOGUE:990:2","scriptId":990,"text":"搞定了军演，以为可以安心地睡一个懒觉，结果----","background":"/art/stories/zjm-090.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:3","scriptId":990,"text":"“长官！长官！起来了！！”","background":"/art/stories/zjm-090.webp","left":31,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:4","scriptId":990,"text":"“Zzz……Zzz……Zzz……”","background":"/art/stories/zjm-090.webp","left":31,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:5","scriptId":990,"text":"“看来只能使用究极奥义了……”","background":"/art/stories/zjm-090.webp","left":40,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:6","scriptId":990,"text":"“小飞象，对着窗外开炮！”","background":"/art/stories/zjm-090.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:9","scriptId":990,"text":"“！！！！！！！！！！！！！”","background":"/art/stories/zjm-090.webp","left":32,"right":3,"section":0,"shake":true},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:10","scriptId":990,"text":"“什么情况！！我们被攻击了！？”","background":"/art/stories/zjm-090.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:11","scriptId":990,"text":"“终于起来了啊……索菲亚教官说有重要的事情要发表，让我们到会议室集合。”","background":"/art/stories/zjm-090.webp","left":40,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:12","scriptId":990,"text":"“我靠……不是刚解决军演么，还能有什么事情……”","background":"/art/stories/zjm-090.webp","left":40,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113001-PROLOGUE:990:14","scriptId":990,"text":"半梦半醒的状况下跟着佐伊来到了会议室----","background":"/art/stories/zjm-090.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113001-PROLOGUE:990:16","scriptId":990,"text":"会议室里猎虎小队已经全部到位。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:17","scriptId":990,"text":"“都到这个点了，还没有睡醒？？”","background":"/art/stories/zjm-047.webp","left":null,"right":219,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:18","scriptId":990,"text":"“没有的事！我这是在沉思。”","background":"/art/stories/zjm-047.webp","left":3,"right":219,"section":0,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:19","scriptId":990,"text":"“那就好，接下来我们要出发去一次马奇诺研究所。”","background":"/art/stories/zjm-047.webp","left":3,"right":211,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:20","scriptId":990,"text":"“马奇诺？？？去那里干什么？？”","background":"/art/stories/zjm-047.webp","left":3,"right":211,"section":0,"shake":false},{"kind":"dialogue","head":221,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:21","scriptId":990,"text":"“废话不要多，给我乖乖地跟着就是了。还是说你想留在这里替我批改学生的论文？”","background":"/art/stories/zjm-047.webp","left":3,"right":221,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113001-PROLOGUE:990:22","scriptId":990,"text":"“我这就去准备行李……”","background":"/art/stories/zjm-047.webp","left":3,"right":221,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113001-EPILOGUE:10980:1","scriptId":10980,"text":"竟然会和索菲亚教官同行，简直是噩梦……不，做梦都没想到。","background":"/art/stories/zdbjbz-02.webp","left":3,"right":221,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113001-EPILOGUE:10980:2","scriptId":10980,"text":"索菲亚教官坐在吉普车的副驾驶座上，让我压力倍增……还是想点东西来聊聊吧……","background":"/art/stories/zdbjbz-02.webp","left":3,"right":221,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113001-EPILOGUE:10980:3","scriptId":10980,"text":"“这次我们去马奇诺研究所难道是因为我们之前搜索到的那块不明物质？”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":221,"section":1,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113001-EPILOGUE:10980:4","scriptId":10980,"text":"“恩，伏龙芝这里的分析报告说，这不明物质中含有大量的突变战车兽内核。”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":211,"section":1,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113001-EPILOGUE:10980:5","scriptId":10980,"text":"“而马奇诺研究所那边前一段时间正在研究某种突变的战车兽内核，因此需要拿这块物质去比对一下具体差异。”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":211,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113001-EPILOGUE:10980:6","scriptId":10980,"text":"索菲亚教官指了指后备箱，看来不明物质就装在吉普车的后备箱中。","background":"/art/stories/zdbjbz-02.webp","left":3,"right":211,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113001-EPILOGUE:10980:7","scriptId":10980,"text":"“那让我们送去就行了，何必教官亲自去送？”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":211,"section":1,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113001-EPILOGUE:10980:8","scriptId":10980,"text":"“因为和马奇诺研究所失联了……”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":103,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113001-EPILOGUE:10980:9","scriptId":10980,"text":"一旁的奈乐靠了过来，猎虎小队依然和之前一样随我们同行。","background":"/art/stories/zdbjbz-02.webp","left":3,"right":103,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113001-EPILOGUE:10980:10","scriptId":10980,"text":"不过蕾贝卡的沙狐小队就直接返回死水佣兵总部去了。","background":"/art/stories/zdbjbz-02.webp","left":3,"right":103,"section":1,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113001-EPILOGUE:10980:11","scriptId":10980,"text":"“失联倒没什么，马奇诺的通信设备有点老化，经常的事情啦……”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":211,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113001-EPILOGUE:10980:12","scriptId":10980,"text":"（这也行？那可是军事研究所啊……等等，难道和齐格菲研究所一样被战车兽袭击了？）","background":"/art/stories/zdbjbz-02.webp","left":3,"right":211,"section":1,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113001-EPILOGUE:10980:13","scriptId":10980,"text":"“多半不会有事的，我对马奇诺的研究报告比较有兴趣，这次就当去参观下研究成果了。”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":211,"section":1,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113002-PROLOGUE:1000:2","scriptId":1000,"text":"“之前看到报告里面提到没有血液的动物尸体？”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":211,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113002-PROLOGUE:1000:3","scriptId":1000,"text":"“恩，正确的说是没有装甲和血液的战车兽尸体。”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113002-PROLOGUE:1000:4","scriptId":1000,"text":"“因为战车兽身上的装甲里是有特殊的血液和神经的，不能随意剥离。”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113002-PROLOGUE:1000:5","scriptId":1000,"text":"“强行剥离战车兽的装甲应该会造成神经元崩溃，并出现大量出血的情况。”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113002-PROLOGUE:1000:6","scriptId":1000,"text":"“从尸体周围只发现了少量血液，但是并没有大出血的迹象。”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113002-PROLOGUE:1000:7","scriptId":1000,"text":"“所以我也是奇怪这一点。”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113002-PROLOGUE:1000:8","scriptId":1000,"text":"“有没有可能是被麻醉了以后再剥离的装甲？”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113002-PROLOGUE:1000:9","scriptId":1000,"text":"“麻醉？这么说有可能，但是麻醉战车兽是需要的剂量非常大，研究实验才会用到。”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113002-PROLOGUE:1000:10","scriptId":1000,"text":"“不过考虑到尸体的数量，应该没办法准备那么多麻醉剂吧。”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113002-PROLOGUE:1000:11","scriptId":1000,"text":"“唔……也是。”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113002-EPILOGUE:10990:1","scriptId":10990,"text":"“不过还有一种可能，就是先把战车兽的血抽干，然后再拆除装甲，这个办法也同样不会造成出血。”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113002-EPILOGUE:10990:2","scriptId":10990,"text":"“这也可以？”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":41,"section":3,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113002-EPILOGUE:10990:3","scriptId":10990,"text":"“恩，理论上可以，当然也仅限理论了。”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":41,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113002-EPILOGUE:10990:4","scriptId":10990,"text":"“抽血机？”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113002-EPILOGUE:10990:5","scriptId":10990,"text":"“瞎猜也没用，还不如先分析下那块物质。”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:2","scriptId":1010,"text":"“就是说伏龙芝的研究室也没完全分析出那个不明物质？？”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:3","scriptId":1010,"text":"“恩，军演期间我也去研究室里看过，不过得出的结论基本相同。”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":211,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:4","scriptId":1010,"text":"“什么结论？”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":211,"section":4,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:5","scriptId":1010,"text":"“首先，战车兽内核都知道吧。”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":211,"section":4,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:6","scriptId":1010,"text":"“不知道。”","background":"/art/stories/zdbjbz-02.webp","left":41,"right":211,"section":4,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:7","scriptId":1010,"text":"“不知道。”","background":"/art/stories/zdbjbz-02.webp","left":81,"right":211,"section":4,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:8","scriptId":1010,"text":"“……”","background":"/art/stories/zdbjbz-02.webp","left":81,"right":211,"section":4,"shake":false},{"kind":"dialogue","head":221,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:9","scriptId":1010,"text":"“我想你们是需要返校补课了。”","background":"/art/stories/zdbjbz-02.webp","left":81,"right":221,"section":4,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:10","scriptId":1010,"text":"“所谓战车兽内核就是动物与装甲的结合产物，内核的粘质度决定了装甲和动物的结合深度。”","background":"/art/stories/zdbjbz-02.webp","left":103,"right":221,"section":4,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:11","scriptId":1010,"text":"“钢舞姬的舞装内核其实除了化学键的排列不同以外和战车兽内核非常接近。”","background":"/art/stories/zdbjbz-02.webp","left":103,"right":221,"section":4,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:12","scriptId":1010,"text":"（额……课本里好像说过，又好像没说过……反正听不懂……）","background":"/art/stories/zdbjbz-02.webp","left":103,"right":40,"section":4,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:13","scriptId":1010,"text":"“恩，简单概括内核就是粘合剂一类的东西。”","background":"/art/stories/zdbjbz-02.webp","left":103,"right":211,"section":4,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:14","scriptId":1010,"text":"“不明物质中检测出大量的战车兽内核，但都发生了一定的突变。”","background":"/art/stories/zdbjbz-02.webp","left":103,"right":211,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:15","scriptId":1010,"text":"“突变战车兽内核……会不会就和我们遇到的龟型战车兽有关系。”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":211,"section":4,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:16","scriptId":1010,"text":"“有可能。但最不可思议的是这种突变内核过了那么久竟然还没有完全死亡，一般战车兽内核在体外可没办法活那么久。”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":211,"section":4,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113003-PROLOGUE:1010:17","scriptId":1010,"text":"（啊……已经完全听不懂了……）","background":"/art/stories/zdbjbz-02.webp","left":3,"right":40,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113003-EPILOGUE:11000:1","scriptId":11000,"text":"简直就和开研讨会一样，和索菲亚教官讨论也挺开心的。","background":"/art/stories/zdbjbz-02.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"113003-EPILOGUE:11000:2","scriptId":11000,"text":"只不过像佐伊和莉娜这种的就完全无法加入讨论……","background":"/art/stories/zdbjbz-02.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113003-EPILOGUE:11000:3","scriptId":11000,"text":"“从理论上来说，无论是战车兽内核还是钢舞姬内核在体外只能存活24小时。”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113003-EPILOGUE:11000:4","scriptId":11000,"text":"“过了那么久还有生命迹象的话，这种突变内核还真是不得了……”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113003-EPILOGUE:11000:5","scriptId":11000,"text":"“如果这种突变内核是你们之前报告中提到的那人形怪物身上的话，我觉得这事情可能就说得通了。”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113003-EPILOGUE:11000:6","scriptId":11000,"text":"“那我们就是首例发现这种突变内核的人了？”","background":"/art/stories/zdbjbz-02.webp","left":211,"right":103,"section":5,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113003-EPILOGUE:11000:7","scriptId":11000,"text":"“发现人是我，那我就命名它为BT内核！！”","background":"/art/stories/zdbjbz-02.webp","left":81,"right":103,"section":5,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113003-EPILOGUE:11000:8","scriptId":11000,"text":"“……”","background":"/art/stories/zdbjbz-02.webp","left":81,"right":103,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"113003-EPILOGUE:11000:9","scriptId":11000,"text":"“……”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":103,"section":5,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"113003-EPILOGUE:11000:10","scriptId":11000,"text":"“虽然没怎么听懂，但我觉得这个命名肯定不会通过……”","background":"/art/stories/zdbjbz-02.webp","left":3,"right":40,"section":5,"shake":false}],"summaries":["距离马奇诺还有很长的一段路程。","一路上简直像在开茶会……"]}
