{"schemaVersion":1,"id":28,"sections":[{"id":"112007-PROLOGUE","name":"第 1 战 · 战前","scripts":[910],"start":0,"count":6},{"id":"112007-EPILOGUE","name":"第 1 战 · 战后","scripts":[10900],"start":6,"count":4},{"id":"112008-PROLOGUE","name":"第 2 战 · 战前","scripts":[920],"start":10,"count":11},{"id":"112008-EPILOGUE","name":"第 2 战 · 战后","scripts":[10910],"start":21,"count":15},{"id":"112009-PROLOGUE","name":"第 3 战 · 战前","scripts":[930],"start":36,"count":3},{"id":"112009-EPILOGUE","name":"第 3 战 · 战后","scripts":[10920],"start":39,"count":10}],"frames":[{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112007-PROLOGUE:910:2","scriptId":910,"text":"“攻防战了，作为进攻方，我们是稳赢的，大家不要有太多压力。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112007-PROLOGUE:910:3","scriptId":910,"text":"“诶？稳赢？为什么？”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112007-PROLOGUE:910:4","scriptId":910,"text":"“因为我们有攻城小钢炮--茜罗娅啊～”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":356,"speaker":"茜罗娅·约德尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112007-PROLOGUE:910:5","scriptId":910,"text":"“嘿嘿～大家只要看好我的位置就行了。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":356,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112007-PROLOGUE:910:6","scriptId":910,"text":"“那之后就拜托了。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":356,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112007-PROLOGUE:910:7","scriptId":910,"text":"“这场战斗直接关系到整场军演的输赢了，可别失手咯～”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":356,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"112007-EPILOGUE:10900:1","scriptId":10900,"text":"开始正式攻防战了，双方人员进入作战区域。","background":"/art/stories/zdbjbz-01.webp","left":3,"right":356,"section":1,"shake":false},{"kind":"dialogue","head":259,"speaker":"丹妮丝·奥金莱克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112007-EPILOGUE:10900:2","scriptId":10900,"text":"“目前防御部署已经完成，随时可以应对敌人的攻击。”","background":"/art/stories/zdbjbz-01.webp","left":259,"right":356,"section":1,"shake":false},{"kind":"dialogue","head":758,"speaker":"奥菲利亚·布鲁克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112007-EPILOGUE:10900:3","scriptId":10900,"text":"“很好，坐等他们送上门来吧。”","background":"/art/stories/zdbjbz-01.webp","left":259,"right":758,"section":1,"shake":false},{"kind":"dialogue","head":296,"speaker":"芬妮·朱安","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112007-EPILOGUE:10900:4","scriptId":10900,"text":"“面对我们的连射，他们根本不可能攻得进来。”","background":"/art/stories/zdbjbz-01.webp","left":296,"right":758,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"112008-PROLOGUE:920:2","scriptId":920,"text":"伏龙芝方面----","background":"/art/stories/zdbjbz-01.webp","left":296,"right":758,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112008-PROLOGUE:920:3","scriptId":920,"text":"“已经到达指定位置了吗？”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":758,"section":2,"shake":false},{"kind":"dialogue","head":356,"speaker":"茜罗娅·约德尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112008-PROLOGUE:920:4","scriptId":920,"text":"“OK，可以随时发动攻击。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":356,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112008-PROLOGUE:920:5","scriptId":920,"text":"“其他的呢？”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":356,"section":2,"shake":false},{"kind":"dialogue","head":165,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112008-PROLOGUE:920:6","scriptId":920,"text":"“正面入口处的瞄准已经就位。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":165,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112008-PROLOGUE:920:7","scriptId":920,"text":"“同上，也已经到位。”","background":"/art/stories/zdbjbz-01.webp","left":103,"right":165,"section":2,"shake":false},{"kind":"dialogue","head":92,"speaker":"普莉玛·派普","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112008-PROLOGUE:920:8","scriptId":920,"text":"“辅助火炮位已经准备就绪。”","background":"/art/stories/zdbjbz-01.webp","left":103,"right":92,"section":2,"shake":false},{"kind":"dialogue","head":91,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112008-PROLOGUE:920:9","scriptId":920,"text":"“我和佐伊已经到达后门外围。”","background":"/art/stories/zdbjbz-01.webp","left":91,"right":92,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112008-PROLOGUE:920:10","scriptId":920,"text":"“莉娜不要抢我台词，佐伊已经就位。”","background":"/art/stories/zdbjbz-01.webp","left":91,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":0,"speaker":"？？？","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112008-PROLOGUE:920:11","scriptId":920,"text":"“很好，那么就让我们开始吧～各就各位----”","background":"/art/stories/zdbjbz-01.webp","left":0,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":0,"speaker":"？？？","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112008-PROLOGUE:920:12","scriptId":920,"text":"“第一轮，茜罗娅臼炮发射，普莉玛火炮协同发射！”","background":"/art/stories/zdbjbz-01.webp","left":0,"right":40,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"112008-EPILOGUE:10910:1","scriptId":10910,"text":"震天的巨响划破长空预示着战斗的开幕。","background":"/art/stories/zdbjbz-01.webp","left":0,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":260,"speaker":"丹妮丝·奥金莱克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112008-EPILOGUE:10910:2","scriptId":10910,"text":"“这个声音，对面发动攻击了！”","background":"/art/stories/zdbjbz-01.webp","left":260,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":277,"speaker":"利薇尔·霍伯特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112008-EPILOGUE:10910:3","scriptId":10910,"text":"“只是远程炮击而已，不构成威胁的～”","background":"/art/stories/zdbjbz-01.webp","left":260,"right":277,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"112008-EPILOGUE:10910:6","scriptId":10910,"text":"据点发生了剧烈的震动，整个大地都随之颤抖。","background":"/art/stories/zdbjbz-01.webp","left":260,"right":277,"section":3,"shake":true},{"kind":"dialogue","head":260,"speaker":"丹妮丝·奥金莱克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112008-EPILOGUE:10910:7","scriptId":10910,"text":"“刚才那个攻击看上去很凶猛啊……利薇尔你那边情况怎么样？”","background":"/art/stories/zdbjbz-01.webp","left":260,"right":277,"section":3,"shake":false},{"kind":"dialogue","head":276,"speaker":"利薇尔·霍伯特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112008-EPILOGUE:10910:8","scriptId":10910,"text":"“据点后墙全部崩塌……我被埋住了，啊！”","background":"/art/stories/zdbjbz-01.webp","left":260,"right":276,"section":3,"shake":false},{"kind":"dialogue","head":260,"speaker":"丹妮丝·奥金莱克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112008-EPILOGUE:10910:10","scriptId":10910,"text":"“利薇尔？利薇尔？？快回答！”","background":"/art/stories/zdbjbz-01.webp","left":260,"right":null,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"112008-EPILOGUE:10910:11","scriptId":10910,"text":"利薇尔的无线电中只留下一片噪音……","background":"/art/stories/zdbjbz-01.webp","left":260,"right":null,"section":3,"shake":false},{"kind":"dialogue","head":260,"speaker":"丹妮丝·奥金莱克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112008-EPILOGUE:10910:12","scriptId":10910,"text":"“队长大人，我去看看利薇尔的情况。”","background":"/art/stories/zdbjbz-01.webp","left":260,"right":null,"section":3,"shake":false},{"kind":"dialogue","head":752,"speaker":"奥菲利亚·布鲁克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112008-EPILOGUE:10910:13","scriptId":10910,"text":"“好的，多加小心。”","background":"/art/stories/zdbjbz-01.webp","left":260,"right":752,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"112008-EPILOGUE:10910:14","scriptId":10910,"text":"就在这时，又一发炮弹命中墙壁，正好在丹妮丝刚才所在的位置。","background":"/art/stories/zdbjbz-01.webp","left":260,"right":752,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"112008-EPILOGUE:10910:15","scriptId":10910,"text":"整个侧墙被炸瘫，吓得丹妮丝半天没说出话来……","background":"/art/stories/zdbjbz-01.webp","left":260,"right":752,"section":3,"shake":false},{"kind":"dialogue","head":260,"speaker":"丹妮丝·奥金莱克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112008-EPILOGUE:10910:16","scriptId":10910,"text":"“报告队长！我们在这里守着是不行了，敌人的炮击可以完全摧毁据点建筑！？”","background":"/art/stories/zdbjbz-01.webp","left":260,"right":752,"section":3,"shake":false},{"kind":"dialogue","head":752,"speaker":"奥菲利亚·布鲁克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112008-EPILOGUE:10910:17","scriptId":10910,"text":"“什么！？能摧毁据点？撤离据点！”","background":"/art/stories/zdbjbz-01.webp","left":260,"right":752,"section":3,"shake":false},{"kind":"dialogue","head":260,"speaker":"丹妮丝·奥金莱克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112008-EPILOGUE:10910:18","scriptId":10910,"text":"“是！”","background":"/art/stories/zdbjbz-01.webp","left":260,"right":752,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"112009-PROLOGUE:930:2","scriptId":930,"text":"面对从据点中冲出来的桑赫斯特队员，所要做的事情就是补漏啦～","background":"/art/stories/zdbjbz-01.webp","left":260,"right":752,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112009-PROLOGUE:930:3","scriptId":930,"text":"“集中攻击冲出来的敌人！”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":752,"section":4,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112009-PROLOGUE:930:4","scriptId":930,"text":"“就交给我们吧～”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":37,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"112009-EPILOGUE:10920:1","scriptId":10920,"text":"攻防战结束，胜利方--伏龙芝。","background":"/art/stories/zdbjbz-01.webp","left":3,"right":37,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"112009-EPILOGUE:10920:2","scriptId":10920,"text":"成功阻截了丹妮丝和塞姬的突围，然而正面却被奥菲利亚和芬妮突破，奈乐和卓娅受到了很大程度的损伤。","background":"/art/stories/zdbjbz-01.webp","left":3,"right":37,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"112009-EPILOGUE:10920:3","scriptId":10920,"text":"没有看见安娜和利薇尔出来，估计是被臼炮一起轰塌了……","background":"/art/stories/zdbjbz-01.webp","left":3,"right":37,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112009-EPILOGUE:10920:4","scriptId":10920,"text":"“这场比我预计中的要惨烈一点，虽然我们占据绝对优势，但是还是付出了一定的代价。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":37,"section":5,"shake":false},{"kind":"dialogue","head":166,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112009-EPILOGUE:10920:5","scriptId":10920,"text":"“恩……不得不说桑赫斯特的队员实力还是不容小觑的……”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":166,"section":5,"shake":false},{"kind":"dialogue","head":108,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112009-EPILOGUE:10920:6","scriptId":10920,"text":"“要不是卓娅帮我挡了两下，我估计就先退场了……真是对不起，拖累了大家……”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":108,"section":5,"shake":false},{"kind":"dialogue","head":166,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112009-EPILOGUE:10920:7","scriptId":10920,"text":"“这点小伤不碍事的。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":166,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112009-EPILOGUE:10920:8","scriptId":10920,"text":"“结果不错，因为我们补给比较充足的，所以这点损伤都在可接受范围之内。”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":166,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"112009-EPILOGUE:10920:9","scriptId":10920,"text":"“不过对面的补给应该已经见底了。下一场我们要利用防守优势来一口气获得胜利！”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":166,"section":5,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"112009-EPILOGUE:10920:10","scriptId":10920,"text":"“哼哼，看来是胜券在握了啊～”","background":"/art/stories/zdbjbz-01.webp","left":3,"right":37,"section":5,"shake":false}],"summaries":["目测稳赢的战斗，至于为什么稳赢……","恩恩，准备开战，我就命名这个作战叫雷霆作战吧～","果不其然，桑赫斯特的钢舞姬都从据点中冲了出来。"]}
