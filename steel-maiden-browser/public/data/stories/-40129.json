{"schemaVersion":1,"id":-40129,"sections":[{"id":"script-20129","name":"原始脚本 20129","scripts":[20129],"start":0,"count":32}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:2","scriptId":20129,"text":"返回拍摄地点的路上，我们听到了炮弹的声音……","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":true},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20129:20129:3","scriptId":20129,"text":"“这……难道是伊诺娜那边！快，加快速度！”","background":"/art/stories/zjm-047.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:4","scriptId":20129,"text":"没想到刚处理完度假村那边的战车兽，拍摄地点又有突发事件……","background":"/art/stories/zjm-047.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20129:20129:5","scriptId":20129,"text":"“希望伊诺娜她们不要出事啊……”","background":"/art/stories/zjm-047.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":593,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20129:20129:6","scriptId":20129,"text":"“应该还不至于，从目前炮弹爆炸声的数量来看，应该是在火热交战中……”","background":"/art/stories/zjm-047.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:7","scriptId":20129,"text":"大约又行进了十分钟，终于能看到伊诺娜那边到底发生什么了……","background":"/art/stories/zjm-047.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:8","scriptId":20129,"text":"伊诺娜小队和塞西尔她们正躲在掩体后面和一大群战车兽进行对峙。","background":"/art/stories/zjm-047.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:9","scriptId":20129,"text":"不过……那群战车兽之后，还有一个令人背脊发凉的身影——旅行者。","background":"/art/stories/zjm-047.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:10","scriptId":20129,"text":"从外表来看，那个旅行者个子比较矮小，但是着装基本和埃普西隆一致，手上的那门巨炮让人不寒而栗。","background":"/art/stories/zjm-047.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20129:20129:11","scriptId":20129,"text":"“该死！真的是旅行者！”","background":"/art/stories/zjm-047.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:12","scriptId":20129,"text":"本来在这种情况下是不能冒然攻击的，但是情况危急，于是我立刻对维卡下令。","background":"/art/stories/zjm-047.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20129:20129:13","scriptId":20129,"text":"“维卡！对着那边小矮子进行炮击！”","background":"/art/stories/zjm-047.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20129:20129:14","scriptId":20129,"text":"“Да！”","background":"/art/stories/zjm-047.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:15","scriptId":20129,"text":"维卡停下脚步，稍作瞄准，对着那个小个子的旅行者就是一发榴弹……","background":"/art/stories/zjm-047.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:16","scriptId":20129,"text":"这时，那个小个子头上两个兔耳一样的东西发生了反应，其中一个突然扭向维卡这边，应该是发现了维卡的攻击——","background":"/art/stories/zjm-047.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:19","scriptId":20129,"text":"硝烟散去，小个子旅行者所在的位置被炸出了一个大坑……","background":"/art/stories/zjm-047.webp","left":4,"right":596,"section":0,"shake":true},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20129:20129:20","scriptId":20129,"text":"“哦呀～竟然还有援军……”","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20129:20129:21","scriptId":20129,"text":"“干得还不错，差点打中我了～”","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20129:20129:22","scriptId":20129,"text":"“那么礼尚往来，我也还你一发。”","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:23","scriptId":20129,"text":"旅行者把炮口朝向我们，接着炮口中迸发出强烈的光芒——","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20129:20129:24","scriptId":20129,"text":"“！！！”","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:25","scriptId":20129,"text":"本能的反应告诉我这一击非常不妙，我死命地扭转吉普车的方向盘。","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20129:20129:26","scriptId":20129,"text":"“大家快散开！”","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:27","scriptId":20129,"text":"一道激光从那巨大的炮口中冲出，把地面灼烧出了一条深深的痕迹。","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20129:20129:28","scriptId":20129,"text":"“反应很好，竟然第一次就能躲过我的攻击呢。”","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:29","scriptId":20129,"text":"接着她小手朝我们的方向一挥，成群的战车兽从树林中跳了出来……把我们与伊诺娜完全隔开。","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20129:20129:30","scriptId":20129,"text":"“这可真是麻烦了……”","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:31","scriptId":20129,"text":"于是我第三次用通信器呼叫起了波西娅……","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20129:20129:32","scriptId":20129,"text":"“我靠！不是吧……偏偏在这种时候……”","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:33","scriptId":20129,"text":"因为刚才的紧急闪避，通信器摔在了地上，上面的天线折断了……","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20129:20129:34","scriptId":20129,"text":"没有办法，硬着头皮也要上了。","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20129:20129:35","scriptId":20129,"text":"“大家注意，作战的时候要极度小心对方的激光武器。”","background":"/art/stories/zjm-047.webp","left":4,"right":400,"section":0,"shake":false}],"summaries":[]}
