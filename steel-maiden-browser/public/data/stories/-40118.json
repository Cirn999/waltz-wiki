{"schemaVersion":1,"id":-40118,"sections":[{"id":"script-20118","name":"原始脚本 20118","scripts":[20118],"start":0,"count":59}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20118:20118:0","scriptId":20118,"text":"我们小队也算是小有实力，再配合上一些科研基地的守卫，很轻松就干掉了突然袭来的敌人。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:1","scriptId":20118,"text":"“这里时常有战车兽出没吗？明明是群岛，很容易就能把战车兽完全清理的吧。”","background":"/art/stories/zjm-047.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:2","scriptId":20118,"text":"“不要想太多了……这里有很多小岛都是未开化的，去扫除这些原始森林里的战车兽简直是浪费人力物力。”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:3","scriptId":20118,"text":"“所以就丢在那里不管了嘛……”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:4","scriptId":20118,"text":"“因为地域本来就不大，再怎么繁衍也不会到不可控制的地步，所以只要圈地自守即可。”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:5","scriptId":20118,"text":"“这么一说也还算情理之中……好了，那么我们也该告辞了。”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:6","scriptId":20118,"text":"“哎！等等这个东西给你。”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20118:20118:7","scriptId":20118,"text":"波西娅从口袋里掏出一个对讲机一样的东西给我。","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:8","scriptId":20118,"text":"“如果遇到什么意外的话，可以用这个呼叫器通知我～”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:9","scriptId":20118,"text":"“哦！真是用意周道。那就谢谢啦～”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:10","scriptId":20118,"text":"“哪里～如果债务人发生意外我可是很困扰的说～”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:11","scriptId":20118,"text":"“呃……”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:12","scriptId":20118,"text":"（嘻嘻嘻～希望长官能遇到点麻烦，这样我正好可以测试ＣＫ计划～）","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20118:20118:13","scriptId":20118,"text":"告别波西娅以后我们向着汇合地点出发，一路上——","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20118:20118:14","scriptId":20118,"text":"我们这次的集合地点是离科研基地不算太远的度假村，这里是富豪或者政要时常光顾的地方，所以还配有一些私人佣兵。","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:15","scriptId":20118,"text":"“从地图上看，大概还有二十分钟路程就能看到度假村了～”","background":"/art/stories/zjm-047.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20118:20118:18","scriptId":20118,"text":"度假村——这次汇合的地点。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20118:20118:19","scriptId":20118,"text":"我们还没有进到度假村之前，就看到好几位钢舞姬坐在大型的遮阳伞下。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:20","scriptId":20118,"text":"“我如果没猜错的话，应该就是她们了吧，毕竟看上去不像是守卫的样子。”","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:21","scriptId":20118,"text":"“恩，长官好眼力，没错～那正是白银皇后小队，我之前和她们合作过几次～另外队长诺伊娜很漂亮性格也好～”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:22","scriptId":20118,"text":"“哦～那可真是太好了。”","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":748,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:23","scriptId":20118,"text":"“长官，我们是来做任务的～你‘太好’个什么劲啊～”","background":"/art/stories/zjm-101.webp","left":4,"right":748,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:24","scriptId":20118,"text":"“我只不过是觉得可能比较好相处啦，有益团队合作。”","background":"/art/stories/zjm-101.webp","left":4,"right":748,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:25","scriptId":20118,"text":"“不过她们小队有那么多人吗？我没见过这个小队，不是很清楚。”","background":"/art/stories/zjm-101.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":746,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:26","scriptId":20118,"text":"“那个我知道！”","background":"/art/stories/zjm-101.webp","left":746,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:27","scriptId":20118,"text":"“姐姐认识？不会吧……”","background":"/art/stories/zjm-101.webp","left":746,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":746,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:28","scriptId":20118,"text":"“哼哼～佩妮不认识也是理所当然，那个粉色头发的是特勤局的歌姬～我看过她的表演～叫什么来着？”","background":"/art/stories/zjm-101.webp","left":746,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:29","scriptId":20118,"text":"“呃……原来是这么个‘认识’啊，确实……我对文宣节目没什么兴趣。”","background":"/art/stories/zjm-101.webp","left":746,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:30","scriptId":20118,"text":"“那她们就是这次的护卫对象了咯？”","background":"/art/stories/zjm-101.webp","left":572,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:31","scriptId":20118,"text":"“应该是了。”","background":"/art/stories/zjm-101.webp","left":572,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:32","scriptId":20118,"text":"（果然是塞西尔她们嘛……我也没少看她们的宣传演出……）","background":"/art/stories/zjm-101.webp","left":572,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20118:20118:33","scriptId":20118,"text":"和几位钢舞姬汇合——","background":"/art/stories/zjm-101.webp","left":572,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:34","scriptId":20118,"text":"“你们好，我是这次负责援护的另一——”","background":"/art/stories/zjm-101.webp","left":572,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:35","scriptId":20118,"text":"“好慢啊……你知道我们等多久了嘛？”","background":"/art/stories/zjm-101.webp","left":572,"right":786,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20118:20118:36","scriptId":20118,"text":"没等我话说完，就被一堆牢骚声打断了。","background":"/art/stories/zjm-101.webp","left":572,"right":786,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:37","scriptId":20118,"text":"“塞西尔，谨慎措辞，我们也算是公众人物了，注意影响。”","background":"/art/stories/zjm-101.webp","left":798,"right":786,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:38","scriptId":20118,"text":"“你好，我是巴丽娜·波克罗夫卡，旁边这位是塞西尔·霞飞，请多多关照。”","background":"/art/stories/zjm-101.webp","left":798,"right":786,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:39","scriptId":20118,"text":"“哪里哪里，我们才是，还让委托对象等待，真是对不起啊。”","background":"/art/stories/zjm-101.webp","left":4,"right":786,"section":0,"shake":false},{"kind":"dialogue","head":784,"speaker":"奥莉娅·契科娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:40","scriptId":20118,"text":"“哼哼～态度还不错，我是奥莉娅·契科娃，作为赔礼等会儿请我吃蛋糕，我就饶了你～”","background":"/art/stories/zjm-101.webp","left":4,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:41","scriptId":20118,"text":"“一定一定～我会准备最好的蛋糕给几位作为赔礼的。”","background":"/art/stories/zjm-101.webp","left":4,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":788,"speaker":"塞西尔·霞飞","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:42","scriptId":20118,"text":"“那还差不多～”","background":"/art/stories/zjm-101.webp","left":4,"right":788,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20118:20118:43","scriptId":20118,"text":"正当我在忙着给委托人赔不是的时候，另一边——","background":"/art/stories/zjm-101.webp","left":4,"right":788,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:44","scriptId":20118,"text":"“奈特莉，那个就是你的新队长？”","background":"/art/stories/zjm-101.webp","left":680,"right":788,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:45","scriptId":20118,"text":"“对啊，刚组建的新人小队啦～诺伊娜这边看来没什么变化嘛～”","background":"/art/stories/zjm-101.webp","left":680,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:46","scriptId":20118,"text":"“恩，还挺好，最近的委托都比较顺利。”","background":"/art/stories/zjm-101.webp","left":680,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":799,"speaker":"波比·克里斯蒂安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:47","scriptId":20118,"text":"“不过第一次合作就迟到，这可不怎么好啊，印象分大减。”","background":"/art/stories/zjm-101.webp","left":680,"right":799,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:48","scriptId":20118,"text":"“还好吧～刚才因为处理了几只挡路的战车兽，耽误了点时间啦～我想应该不要紧吧～”","background":"/art/stories/zjm-101.webp","left":572,"right":799,"section":0,"shake":false},{"kind":"dialogue","head":799,"speaker":"波比·克里斯蒂安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:49","scriptId":20118,"text":"“哼，奈特莉也是老样子，油嘴滑舌。”","background":"/art/stories/zjm-101.webp","left":572,"right":799,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:50","scriptId":20118,"text":"“啊哈哈～这叫处世之道～”","background":"/art/stories/zjm-101.webp","left":572,"right":799,"section":0,"shake":false},{"kind":"dialogue","head":785,"speaker":"路易斯·华盛顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:51","scriptId":20118,"text":"“人类指挥官的小队，在死水有点名气，没想到来合作的是这个队伍。”","background":"/art/stories/zjm-101.webp","left":572,"right":785,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:52","scriptId":20118,"text":"“恩，不过这个任务相对轻松，我们护卫过那么多次了，已经是轻车熟路。”","background":"/art/stories/zjm-101.webp","left":680,"right":785,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20118:20118:53","scriptId":20118,"text":"问候寒暄和自我介绍用去了不少时间，不过这是开工之前的必要礼节。","background":"/art/stories/zjm-101.webp","left":680,"right":785,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20118:20118:54","scriptId":20118,"text":"这次的任务简单来说就是在巴丽娜她们拍摄新宣传片的时候充当警卫。","background":"/art/stories/zjm-101.webp","left":680,"right":785,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20118:20118:56","scriptId":20118,"text":"去往拍摄地点的路上。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:57","scriptId":20118,"text":"“我有一事不明啊，诺伊娜队长，既然对特勤局那么重要的人物，为什么需要请死水来护卫？”","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:58","scriptId":20118,"text":"“长官真的不知道？”","background":"/art/stories/zjm-101.webp","left":4,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:59","scriptId":20118,"text":"“是的，因为这段时间基本都在外出执行任务。”","background":"/art/stories/zjm-101.webp","left":4,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:60","scriptId":20118,"text":"“非洲目前有点乱，好像有数以万计的战车兽正在集结的样子，特勤局把大部分能用的兵力都抽调到非洲总部了，就连死水也派去了好几个队伍。”","background":"/art/stories/zjm-101.webp","left":4,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20118:20118:61","scriptId":20118,"text":"“这样啊……好像在我不知道的情况下发生不得了的事情了。”","background":"/art/stories/zjm-101.webp","left":4,"right":680,"section":0,"shake":false}],"summaries":[]}
