{"schemaVersion":1,"id":151,"sections":[{"id":"207022-PROLOGUE","name":"第 1 战 · 战前","scripts":[20755],"start":0,"count":7}],"frames":[{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207022-PROLOGUE:20755:0","scriptId":20755,"text":"“弄了半天还是没搞清楚旅行者的目的。”","background":"/art/stories/zjm-099.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207022-PROLOGUE:20755:1","scriptId":20755,"text":"“我虽然知道一些内容，但无权告诉你们。”","background":"/art/stories/zjm-099.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207022-PROLOGUE:20755:2","scriptId":20755,"text":"“只要不放弃沟通，早晚能够互相理解的。”","background":"/art/stories/zjm-099.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207022-PROLOGUE:20755:3","scriptId":20755,"text":"“你就放弃这个想法吧，那些大人一直都是变幻无常捉摸不定的。”","background":"/art/stories/zjm-099.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207022-PROLOGUE:20755:4","scriptId":20755,"text":"“人类个体的时间是有限的，还是先想想你眼前需要处理的事情吧。”","background":"/art/stories/zjm-099.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207022-PROLOGUE:20755:5","scriptId":20755,"text":"“或许你说的没错，谢了，兰布达。”","background":"/art/stories/zjm-099.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207022-PROLOGUE:20755:6","scriptId":20755,"text":"“……不客气。”","background":"/art/stories/zjm-099.webp","left":4,"right":56,"section":0,"shake":false}],"summaries":[]}
