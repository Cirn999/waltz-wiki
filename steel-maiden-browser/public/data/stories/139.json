{"schemaVersion":1,"id":139,"sections":[{"id":"207010-PROLOGUE","name":"第 1 战 · 战前","scripts":[20752],"start":0,"count":9}],"frames":[{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207010-PROLOGUE:20752:1","scriptId":20752,"text":"“没想到我还能成为死水佣兵。”","background":"/art/stories/zjm-099.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207010-PROLOGUE:20752:2","scriptId":20752,"text":"“那应该感谢蕾贝卡吧，没有她的推荐长官可就麻烦大咯。”","background":"/art/stories/zjm-099.webp","left":4,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207010-PROLOGUE:20752:3","scriptId":20752,"text":"“是啊，本来都已经打算回家种土豆了，时运这种东西真是难以捉摸啊。”","background":"/art/stories/zjm-099.webp","left":4,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207010-PROLOGUE:20752:4","scriptId":20752,"text":"“种土豆？原来您还会干农活啊？”","background":"/art/stories/zjm-099.webp","left":4,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207010-PROLOGUE:20752:5","scriptId":20752,"text":"“如果真的到了那一步，为了糊口干粗活也是没有办法的事情。”","background":"/art/stories/zjm-099.webp","left":4,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207010-PROLOGUE:20752:6","scriptId":20752,"text":"“我觉得长官去教书应该也不错。”","background":"/art/stories/zjm-099.webp","left":4,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207010-PROLOGUE:20752:7","scriptId":20752,"text":"“哦，助教啊，那倒也是个出路。”","background":"/art/stories/zjm-099.webp","left":4,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"207010-PROLOGUE:20752:8","scriptId":20752,"text":"“但教书不符合我的性格，我的生活作风可不适合作为学习榜样。”","background":"/art/stories/zjm-099.webp","left":4,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"207010-PROLOGUE:20752:9","scriptId":20752,"text":"“您倒是还有点自知之明啊。”","background":"/art/stories/zjm-099.webp","left":4,"right":31,"section":0,"shake":false}],"summaries":[]}
