{"schemaVersion":1,"id":357,"sections":[{"id":"816001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20589],"start":0,"count":26},{"id":"816001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20590],"start":26,"count":20}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"816001-PROLOGUE:20589:1","scriptId":20589,"text":"因为要提交任务报告的关系，我来到了亚当斯的办公室。","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"816001-PROLOGUE:20589:2","scriptId":20589,"text":"办公室的门开着，里面传出了亚当斯的声音。","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:3","scriptId":20589,"text":"“那么这件事就交给我们了。”","background":"/art/stories/zjm-132.webp","left":1111,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"816001-PROLOGUE:20589:4","scriptId":20589,"text":"亚当斯和维多利亚团长的风格不同，在基地的时候一直都不是很在意礼节的样子。","background":"/art/stories/zjm-132.webp","left":1111,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"816001-PROLOGUE:20589:5","scriptId":20589,"text":"本来打算先回避一下，但很快我听到了电话挂断的声音，所以我判断可以进去了。","background":"/art/stories/zjm-132.webp","left":1111,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:6","scriptId":20589,"text":"“新防空装备的测试已经好了，这是报告。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:7","scriptId":20589,"text":"“哦？挺快的嘛，我看看。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"816001-PROLOGUE:20589:8","scriptId":20589,"text":"亚当斯接过我的报告快速阅览了起来。","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:9","scriptId":20589,"text":"“对空联装机炮……嗯嗯……伞雷……嗯……”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:10","scriptId":20589,"text":"“陆战钢舞姬使用这些装备以后好像对飞行战车兽也有一定的歼灭能力，不错不错。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:11","scriptId":20589,"text":"“但对空的弹药消耗量有点大，配合航空钢舞姬一同作战或许会更有效率。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:12","scriptId":20589,"text":"“嗯，有意思的提议，不过也会有误射己方的危险。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:13","scriptId":20589,"text":"“也是，不过可以作为对空域的封锁，我想是有帮助的。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:14","scriptId":20589,"text":"“嗯，不过这就要增加陆战钢舞姬对空射击练习了。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:15","scriptId":20589,"text":"“也是。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"816001-PROLOGUE:20589:16","scriptId":20589,"text":"亚当斯把报告放到了一个文件袋内。","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:17","scriptId":20589,"text":"“对了，正好有件事要你办一下。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:18","scriptId":20589,"text":"“什么事？”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:19","scriptId":20589,"text":"“空务设计局的建筑工程马上要开始了，打算派你的队伍过去做一下护卫工作。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:20","scriptId":20589,"text":"“没什么问题，不过这好像是个中长期的任务吧？我手里的工作会因此而延后，这不要紧吗？”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:21","scriptId":20589,"text":"“啊，你误会了，这个任务最多要个一周就行了。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:22","scriptId":20589,"text":"“诶？那么快的？”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:23","scriptId":20589,"text":"“嗯，你去过就知道了，伊万诺夫财团的实力可是很恐怖的。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:24","scriptId":20589,"text":"“伊万诺夫财团？好像在哪儿听到过。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":1111,"speaker":"亚当斯·哈柏林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:25","scriptId":20589,"text":"“嗯，我先把地址给你，离我们不远你直接带着小队过去好了。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-PROLOGUE:20589:26","scriptId":20589,"text":"“了解。”","background":"/art/stories/zjm-132.webp","left":1111,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"816001-EPILOGUE:20590:1","scriptId":20590,"text":"三天后——","background":"/art/stories/zdbjbz-13.webp","left":1111,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:2","scriptId":20590,"text":"“真是没想到……竟然那么快就竣工了。”","background":"/art/stories/zdbjbz-13.webp","left":4,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"816001-EPILOGUE:20590:3","scriptId":20590,"text":"眼前矗立着的是已经完成施工的空务设计局大楼。","background":"/art/stories/zdbjbz-13.webp","left":4,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":745,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:4","scriptId":20590,"text":"“但为什么会有那么多飞行战车兽，明明是没什么人气的地方……”","background":"/art/stories/zdbjbz-13.webp","left":4,"right":745,"section":1,"shake":false},{"kind":"dialogue","head":897,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:5","scriptId":20590,"text":"“可能是被施工的动静吸引过来的？”","background":"/art/stories/zdbjbz-13.webp","left":897,"right":745,"section":1,"shake":false},{"kind":"dialogue","head":745,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:6","scriptId":20590,"text":"“这工作强度，一天就要来好几次……需要快点吧‘RHO屋’铺设过来啊，一直抬着脑袋进行对空射击弄得我脖子都僵了。”","background":"/art/stories/zdbjbz-13.webp","left":897,"right":745,"section":1,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:7","scriptId":20590,"text":"“RHO屋毕竟是旅行者的技术，不是你想铺就能铺的。”","background":"/art/stories/zdbjbz-13.webp","left":591,"right":745,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:8","scriptId":20590,"text":"“让柔再来一次就好了嘛。”","background":"/art/stories/zdbjbz-13.webp","left":591,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:9","scriptId":20590,"text":"“很遗憾，我并没有办法直接联系柔，不要把事情说得太轻巧……”","background":"/art/stories/zdbjbz-13.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:10","scriptId":20590,"text":"“真没用。”","background":"/art/stories/zdbjbz-13.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:11","scriptId":20590,"text":"（虽然我有办法联系兰布达，但不到关键时刻，最好还是不要麻烦她。）","background":"/art/stories/zdbjbz-13.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:12","scriptId":20590,"text":"“只能等她们下次来检查RHO屋的时候顺便让她们在这空务设计局也部署一个。”","background":"/art/stories/zdbjbz-13.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":747,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:13","scriptId":20590,"text":"“那还要多久啊？”","background":"/art/stories/zdbjbz-13.webp","left":4,"right":747,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:14","scriptId":20590,"text":"“不知道啊，从现在兰布达她们出现的频率看，至少要两三周吧。”","background":"/art/stories/zdbjbz-13.webp","left":4,"right":747,"section":1,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:15","scriptId":20590,"text":"“嗯，虽说旅行者目前也不能完全算敌人，但也称不上友军，不能完全信任。”","background":"/art/stories/zdbjbz-13.webp","left":4,"right":591,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:16","scriptId":20590,"text":"“兰布达的话，我觉得可以信任，至于柔的话，我也有点说不好，她好像蛮讨厌我的，特别是她的骸虫有些吓人……”","background":"/art/stories/zdbjbz-13.webp","left":4,"right":591,"section":1,"shake":false},{"kind":"dialogue","head":747,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:17","scriptId":20590,"text":"“是啊，上次想靠近看看，差点被那些骸虫攻击呢。”","background":"/art/stories/zdbjbz-13.webp","left":4,"right":747,"section":1,"shake":false},{"kind":"dialogue","head":897,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:18","scriptId":20590,"text":"“所以说旅行者和我们还是有许多不同的，借用她们的力量要适可而止。”","background":"/art/stories/zdbjbz-13.webp","left":897,"right":747,"section":1,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:19","scriptId":20590,"text":"“我总觉得她们在暗地里有搞些什么。”","background":"/art/stories/zdbjbz-13.webp","left":897,"right":591,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"816001-EPILOGUE:20590:20","scriptId":20590,"text":"“嗯，下次再观察下吧。”","background":"/art/stories/zdbjbz-13.webp","left":4,"right":591,"section":1,"shake":false}],"summaries":[]}
