{"schemaVersion":1,"id":-40600,"sections":[{"id":"script-20600","name":"原始脚本 20600","scripts":[20600],"start":0,"count":63}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:1","scriptId":20600,"text":"死水的地下室中——","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20600:20600:2","scriptId":20600,"text":"“你这算是完成了？”","background":"/art/stories/zdjm-034.webp","left":1124,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:3","scriptId":20600,"text":"“嗯，骨骼的强度已经达到了标准，肌肉构筑也很完善，其他的你可以自己看。”","background":"/art/stories/zdjm-034.webp","left":1124,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:4","scriptId":20600,"text":"兰布达和柔正在对一个实验体进行总结性讨论。","background":"/art/stories/zdjm-034.webp","left":1124,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:5","scriptId":20600,"text":"把一份资料表交给了柔，上面记载着密密麻麻的数据，由于是用外星文字写成的，所以一般人根本看不懂。","background":"/art/stories/zdjm-034.webp","left":1124,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20600:20600:6","scriptId":20600,"text":"“我看看……”","background":"/art/stories/zdjm-034.webp","left":1124,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:7","scriptId":20600,"text":"对于同为研究者的柔来说读懂这些轻而易举。","background":"/art/stories/zdjm-034.webp","left":1124,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20600:20600:8","scriptId":20600,"text":"“各项硬性指标倒是都达到了基准线……”","background":"/art/stories/zdjm-034.webp","left":1124,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:9","scriptId":20600,"text":"柔阅览着兰布达的资料，与此同时她身旁的蛇形骸虫正在打量着站在兰布达身边的大型培养槽。","background":"/art/stories/zdjm-034.webp","left":1124,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:10","scriptId":20600,"text":"“这次是偶然造成的，因为埃普西隆的失手，结果搞错了虹氨酸和活体硅的投放顺序，还把试剂配比都弄乱了。”","background":"/art/stories/zdjm-034.webp","left":1124,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:11","scriptId":20600,"text":"“越帮越忙的典型。”","background":"/art/stories/zdjm-034.webp","left":1124,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:12","scriptId":20600,"text":"兰布达瞄了一眼被放在实验台另一边的某旅行者。","background":"/art/stories/zdjm-034.webp","left":1124,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":853,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:13","scriptId":20600,"text":"“唔……唔……”","background":"/art/stories/zdjm-034.webp","left":1124,"right":853,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:14","scriptId":20600,"text":"埃普西隆被五花大绑，远远看去就像个粽子。","background":"/art/stories/zdjm-034.webp","left":1124,"right":853,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20600:20600:15","scriptId":20600,"text":"“哼哼，这次是歪打正着咯？”","background":"/art/stories/zdjm-034.webp","left":1124,"right":853,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:16","scriptId":20600,"text":"柔没有动，但是她的骸虫却伸长了躯干，一口便把埃普西隆叼了过来。","background":"/art/stories/zdjm-034.webp","left":1124,"right":853,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20600:20600:17","scriptId":20600,"text":"“那你还这样对待我们的小功臣？”","background":"/art/stories/zdjm-034.webp","left":1124,"right":853,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:18","scriptId":20600,"text":"骸虫对着埃普西隆轻轻一咬，锋利的牙齿就切断了捆住的绳子。","background":"/art/stories/zdjm-034.webp","left":1124,"right":853,"section":0,"shake":false},{"kind":"dialogue","head":855,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:19","scriptId":20600,"text":"“兰布达啊，你可要学学柔，我是功臣，你竟然这么对我！”","background":"/art/stories/zdjm-034.webp","left":1124,"right":855,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:20","scriptId":20600,"text":"被释放的埃普西隆可以挣脱了绳子，跳到了柔所倚靠的桌子上。","background":"/art/stories/zdjm-034.webp","left":1124,"right":855,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20600:20600:21","scriptId":20600,"text":"“你这身体怎么还没恢复啊，要不要我帮你一下？”","background":"/art/stories/zdjm-034.webp","left":1124,"right":855,"section":0,"shake":false},{"kind":"dialogue","head":854,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:22","scriptId":20600,"text":"“好啊好啊！每次让兰布达弄她都推三阻四的。”","background":"/art/stories/zdjm-034.webp","left":1124,"right":854,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:23","scriptId":20600,"text":"“这个实验体虽然可以说成功了，但也因为埃普西隆的关系，我现在无法复制出第二个……”","background":"/art/stories/zdjm-034.webp","left":1124,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20600:20600:24","scriptId":20600,"text":"“原来是这样……那这次的实验并不成功，对了，让柯西来读一下埃普西隆的记忆，说不定能有所突破。”","background":"/art/stories/zdjm-034.webp","left":1124,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":853,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:25","scriptId":20600,"text":"“柯……柯西？不太好吧，她下手一直都没轻没重的，万一让我的脑袋受损了呢！？”","background":"/art/stories/zdjm-034.webp","left":1124,"right":853,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:26","scriptId":20600,"text":"“确实是一种可行的方案，我这就去办。”","background":"/art/stories/zdjm-034.webp","left":1124,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":853,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:27","scriptId":20600,"text":"“不要啊！再想想别的办法？我能回忆起来的啦！兰布达！你快回来！！”","background":"/art/stories/zdjm-034.webp","left":1124,"right":853,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:28","scriptId":20600,"text":"虽然埃普西隆这么叫着，但兰布达头也不回地走出了研究室……","background":"/art/stories/zdjm-034.webp","left":1124,"right":853,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:31","scriptId":20600,"text":"就这样过去了一周，","background":"/art/stories/zdbjbz-17.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:32","scriptId":20600,"text":"某演习靶场的外围——","background":"/art/stories/zdbjbz-17.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:37","scriptId":20600,"text":"“这样真的没问题吗？万一弄伤了莉姆乐丝可不好。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":null,"section":0,"shake":true},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:38","scriptId":20600,"text":"“没问题，刚才的攻击完全没有效果。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:39","scriptId":20600,"text":"“哦？”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:40","scriptId":20600,"text":"狂轰滥炸的浓烟退去之后，我们能看到一个小小的身影屹立在一块废土之上，周围满是大大小小的弹坑。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:41","scriptId":20600,"text":"这个坐在棘尾骸虫上的小家伙名叫莉姆乐丝，是兰布达最新的实验体。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":1132,"speaker":"莉姆乐丝","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:42","scriptId":20600,"text":"“推测损伤率0%，骸鲎方阵虫活动正常，预计活动持续时间2592000秒……”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1132,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:43","scriptId":20600,"text":"“这个叫骸鲎什么的东西也太强了吧，轻而易举地挡住了两轮炮击。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1132,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:44","scriptId":20600,"text":"通过望远镜能看见，莉姆乐丝的周身漂浮环绕着好几只奇异的生物，从外观推断应该也是骸虫的一种。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":1132,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:45","scriptId":20600,"text":"“通过吞噬空间来偏转物理层面的攻击，原理类似埃普西隆的能力但更加全面。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:46","scriptId":20600,"text":"“那这个测试结果你满意了吗？”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:47","scriptId":20600,"text":"“莉姆乐丝，过来。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:48","scriptId":20600,"text":"听到兰布达的呼唤，莉姆乐丝便乘着棘尾骸虫跑了过来。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":1132,"speaker":"莉姆乐丝","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:49","scriptId":20600,"text":"“在，请吩咐。”","background":"/art/stories/zdbjbz-17.webp","left":1132,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:50","scriptId":20600,"text":"“跟着他们小队，测试一下你的防御活动极限。”","background":"/art/stories/zdbjbz-17.webp","left":1132,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":1132,"speaker":"莉姆乐丝","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:51","scriptId":20600,"text":"“了解。”","background":"/art/stories/zdbjbz-17.webp","left":1132,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:52","scriptId":20600,"text":"莉姆乐丝点了点头，然后就看向了我。","background":"/art/stories/zdbjbz-17.webp","left":1132,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:53","scriptId":20600,"text":"“又来？你知道我这个队伍有多少旅行者了吗？”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:54","scriptId":20600,"text":"“这有什么关系，每次只测试一人，从概率上来说是不会暴露的。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:55","scriptId":20600,"text":"“话是这样讲没错……但总有纸包不住火的那一天。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:56","scriptId":20600,"text":"“到那时我们或许已经分道扬镳了。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:57","scriptId":20600,"text":"“……”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:58","scriptId":20600,"text":"（确实，兰布达不会永远待在死水，和她交流能得到更多旅行者的信息，虽然麻烦了点，但还是利大于弊。）","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:59","scriptId":20600,"text":"“好吧，不过让这么瘦小的女孩子在第一线替我挡子弹，总觉得有点……”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:60","scriptId":20600,"text":"“扔掉你的多愁善感吧，人类，你刚才也看到了，她根本就比在场的所有人都要强悍，包括我在内。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:61","scriptId":20600,"text":"“万一出点差错可就……”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:62","scriptId":20600,"text":"“这才是她作为实验生命应尽的义务。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:63","scriptId":20600,"text":"“呃……”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:64","scriptId":20600,"text":"（虽然能够交流，但这价值观完全不同啊……）","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:65","scriptId":20600,"text":"“你作为人类的善意我能感受到，但我也有自己的使命。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:66","scriptId":20600,"text":"“嗯，总之虽然会让她在前线进行防御测试，但我也会尽量不让她受伤的。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:67","scriptId":20600,"text":"“…………”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20600:20600:68","scriptId":20600,"text":"兰布达带着不解的目光看着我沉默了片刻。","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20600:20600:69","scriptId":20600,"text":"“…………谢谢。”","background":"/art/stories/zdbjbz-17.webp","left":4,"right":56,"section":0,"shake":false}],"summaries":[]}
