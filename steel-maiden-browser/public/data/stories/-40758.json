{"schemaVersion":1,"id":-40758,"sections":[{"id":"script-20758","name":"原始脚本 20758","scripts":[20758],"start":0,"count":27}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20758:20758:1","scriptId":20758,"text":"特别空勤队基地外围——","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:2","scriptId":20758,"text":"“一段时间没有来看，这RHO屋竟然被那群人类用得有声有色啊。”","background":"/art/stories/zjm-132.webp","left":1124,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:3","scriptId":20758,"text":"“是你太小瞧人类了，柔。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:4","scriptId":20758,"text":"“哼，我也有看走眼的时候嘛，这次是你赢了。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:5","scriptId":20758,"text":"“我们之间的输赢毫无意义，我只是帮助阿尔库涅大人完成愿望罢了。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:6","scriptId":20758,"text":"“喔？是吗？以前的你可没这么袒护人类。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:7","scriptId":20758,"text":"“袒护人类？上位的任务罢了，我向来如此，是你观察不仔细而已。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:8","scriptId":20758,"text":"“……”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:9","scriptId":20758,"text":"“对了，那个获得阿尔库涅大人庇护的人类现在怎么样了？”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:10","scriptId":20758,"text":"“作为一位佣兵队伍的指挥官来说不太可靠，但每次都能圆满完成任务……这点真是让人惊讶。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:11","scriptId":20758,"text":"“平庸但绝不平凡，这种例子很少见。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:12","scriptId":20758,"text":"“听你这口气，已经大致摸清了那个人类了喽？”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:13","scriptId":20758,"text":"“因为阿尔库涅大人送了他信标卡片，我现在偶尔还要帮助他处理麻烦事。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:14","scriptId":20758,"text":"“而且我算是和他接触最多的旅行者了，应该没有比我更了解他的旅行者了。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:15","scriptId":20758,"text":"“喔？看来你已经不满足于接触他了啊。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:16","scriptId":20758,"text":"“我不明白你的意思。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:17","scriptId":20758,"text":"“真是的……你来地球以后已经变了很多，没人提醒你吗？”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:18","scriptId":20758,"text":"“有吗？或许吧……但我个人并没有什么实感。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:19","scriptId":20758,"text":"“哼哼，这是好事，以前在星团实验室的你很无聊的说。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:20","scriptId":20758,"text":"“是吗？我只是努力做好自己的分内工作而已。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:21","scriptId":20758,"text":"“有意思，我开始对改变你的人类有点兴趣了。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:22","scriptId":20758,"text":"“你可别来添乱啊，处理他的事情已经很让人头疼了。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:23","scriptId":20758,"text":"“怎么会，反正协助人类那边的工作我也有参与过一点，名正言顺嘛。”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:24","scriptId":20758,"text":"“……”","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"dialogue","head":1124,"speaker":"柔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20758:20758:25","scriptId":20758,"text":"（这么有意思的事情，我之前怎么没注意到呢？）","background":"/art/stories/zjm-132.webp","left":1124,"right":1198,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20758:20758:27","scriptId":20758,"text":"至此之后，作为RHO屋名义上的技术顾问，柔经常会偷偷跑来特别空勤队。","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20758:20758:28","scriptId":20758,"text":"但由于每次出入她都搞得神秘兮兮的，反而基地里闹出了RHO屋里有个奇怪女性的传闻……","background":"/art/stories/zjm-132.webp","left":null,"right":null,"section":0,"shake":false}],"summaries":[]}
