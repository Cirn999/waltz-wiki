{"schemaVersion":1,"id":-40002,"sections":[{"id":"script-20002","name":"原始脚本 20002","scripts":[20002],"start":0,"count":22}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20002:20002:1","scriptId":20002,"text":"离开了最初所在的场所，开始向着北边行进，那边有不少可以当做掩体的场所。","background":"/art/stories/zdbjbz-11.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20002:20002:2","scriptId":20002,"text":"果不其然，找到了一家废弃的兵工厂，虽然是虚拟的，但是不得不说内部构建还挺像那么回事。","background":"/art/stories/zdbjbz-11.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:3","scriptId":20002,"text":"“不错不错，竟然连代步工具都有。”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:4","scriptId":20002,"text":"“长官很擅长开车吗？”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:5","scriptId":20002,"text":"“之前还是佐伊开得多，不过我开车的时候也不少，自己握方向盘的感觉更安全点……”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:6","scriptId":20002,"text":"“没想到姐姐还有这种天赋……”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":577,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:7","scriptId":20002,"text":"“长官，你刚才发动的引擎，好像触发了什么机关……”","background":"/art/stories/zdbjbz-11.webp","left":577,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:8","scriptId":20002,"text":"“敌人……大量。”","background":"/art/stories/zdbjbz-11.webp","left":577,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:9","scriptId":20002,"text":"“我看看……”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20002:20002:10","scriptId":20002,"text":"拿出望远镜往远处望了一下。","background":"/art/stories/zdbjbz-11.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":0,"speaker":"？？？","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:11","scriptId":20002,"text":"“那东西真的是战车兽？？”","background":"/art/stories/zdbjbz-11.webp","left":0,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20002:20002:12","scriptId":20002,"text":"滚滚尘土中出现的并不是战车兽，而是一种奇怪的生物。","background":"/art/stories/zdbjbz-11.webp","left":0,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":63,"speaker":"原核体-混乱","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20002:20002:13","scriptId":20002,"text":"“吼！！！！！”","background":"/art/stories/zdbjbz-11.webp","left":0,"right":63,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:14","scriptId":20002,"text":"“我靠，怎么看都不像是战车兽啊！！？？等等，主办！？波西娅博士？？”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":63,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20002:20002:15","scriptId":20002,"text":"呼唤了波西娅的名字，波西娅倒也是出现了。","background":"/art/stories/zdbjbz-11.webp","left":4,"right":63,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:16","scriptId":20002,"text":"“你们好像遇到麻烦了～”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:17","scriptId":20002,"text":"“可以解释一下这种是什么生物吗？我看着不像是战车兽啊……”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:18","scriptId":20002,"text":"“恩……是的，我这边也遇到点麻烦～有不明人士正在入侵我的主控制系统，我正忙着防御电子攻势，你们见招拆招吧～”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20002:20002:19","scriptId":20002,"text":"波西娅说完就切断了通信，变成一道字符消失了……","background":"/art/stories/zdbjbz-11.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:20","scriptId":20002,"text":"“……看来只能我们自己上了啊，大家都准备好了。”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":593,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:21","scriptId":20002,"text":"“敌人已经进入射程，请求攻击。”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":593,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20002:20002:22","scriptId":20002,"text":"“先尝试一批火力铺设！”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":593,"section":0,"shake":false}],"summaries":[]}
