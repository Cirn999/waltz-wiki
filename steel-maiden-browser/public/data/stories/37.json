{"schemaVersion":1,"id":37,"sections":[{"id":"114010-PROLOGUE","name":"第 1 战 · 战前","scripts":[1220],"start":0,"count":13},{"id":"114010-EPILOGUE","name":"第 1 战 · 战后","scripts":[11210],"start":13,"count":4},{"id":"114011-PROLOGUE","name":"第 2 战 · 战前","scripts":[1230],"start":17,"count":7},{"id":"114011-EPILOGUE","name":"第 2 战 · 战后","scripts":[11220],"start":24,"count":7},{"id":"114012-PROLOGUE","name":"第 3 战 · 战前","scripts":[1240],"start":31,"count":8},{"id":"114012-EPILOGUE","name":"第 3 战 · 战后","scripts":[11230],"start":39,"count":16},{"id":"114013-PROLOGUE","name":"第 4 战 · 战前","scripts":[1250],"start":55,"count":13},{"id":"114013-EPILOGUE","name":"第 4 战 · 战后","scripts":[11240],"start":68,"count":18},{"id":"114014-PROLOGUE","name":"第 5 战 · 战前","scripts":[1260],"start":86,"count":17},{"id":"114014-EPILOGUE","name":"第 5 战 · 战后","scripts":[11250],"start":103,"count":28}],"frames":[{"kind":"dialogue","head":217,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114010-PROLOGUE:1220:2","scriptId":1220,"text":"“让你们久等了～”","background":"/art/stories/zdjm-034.webp","left":217,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114010-PROLOGUE:1220:3","scriptId":1220,"text":"“教官！”","background":"/art/stories/zdjm-034.webp","left":217,"right":81,"section":0,"shake":false},{"kind":"dialogue","head":34,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114010-PROLOGUE:1220:4","scriptId":1220,"text":"“吓死我了……还以为死定了……”","background":"/art/stories/zdjm-034.webp","left":34,"right":81,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114010-PROLOGUE:1220:5","scriptId":1220,"text":"我回头朝大楼的方向望了望。","background":"/art/stories/zdjm-034.webp","left":34,"right":81,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114010-PROLOGUE:1220:6","scriptId":1220,"text":"“教官您不会是从楼上跳下来的吧……只有六楼那层的窗户是开着的……”","background":"/art/stories/zdjm-034.webp","left":34,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114010-PROLOGUE:1220:7","scriptId":1220,"text":"“啊哈，那个啊，情况紧急嘛～”","background":"/art/stories/zdjm-034.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114010-PROLOGUE:1220:8","scriptId":1220,"text":"（呃……虽说钢舞姬的身体经过改造得到了大幅强化，但教官这身体性能简直是物种进化了吧……）","background":"/art/stories/zdjm-034.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114010-PROLOGUE:1220:9","scriptId":1220,"text":"“听着无线电里你们的对话真是着急死我了。”","background":"/art/stories/zdjm-034.webp","left":211,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":35,"speaker":"佐伊·谢尔曼","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114010-PROLOGUE:1220:10","scriptId":1220,"text":"“确实，教官您来得太及时了！谢谢您！”","background":"/art/stories/zdjm-034.webp","left":211,"right":35,"section":0,"shake":false},{"kind":"dialogue","head":217,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114010-PROLOGUE:1220:11","scriptId":1220,"text":"“好了！我去对付那个叫埃普西隆的家伙，你们快速清理掉周围的战车兽。”","background":"/art/stories/zdjm-034.webp","left":217,"right":35,"section":0,"shake":false},{"kind":"dialogue","head":104,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114010-PROLOGUE:1220:12","scriptId":1220,"text":"“是！”","background":"/art/stories/zdjm-034.webp","left":217,"right":104,"section":0,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114010-PROLOGUE:1220:13","scriptId":1220,"text":"“终于来了个有点能耐的家伙了啊～可以让我开心开心了～”","background":"/art/stories/zdjm-034.webp","left":217,"right":48,"section":0,"shake":false},{"kind":"dialogue","head":212,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114010-PROLOGUE:1220:14","scriptId":1220,"text":"“口气不小么……我倒是要看你的笑容还能持续多久！”","background":"/art/stories/zdjm-034.webp","left":212,"right":48,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114010-EPILOGUE:11210:1","scriptId":11210,"text":"周围还是不断有战车兽涌出来。","background":"/art/stories/zdjm-034.webp","left":212,"right":48,"section":1,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114010-EPILOGUE:11210:2","scriptId":11210,"text":"“既然教官已经回来了，我们就准备撤退了。”","background":"/art/stories/zdjm-034.webp","left":103,"right":48,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114010-EPILOGUE:11210:3","scriptId":11210,"text":"“恩，那就从来的地方撤退出去吧。教官听得到吗？”","background":"/art/stories/zdjm-034.webp","left":103,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":212,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114010-EPILOGUE:11210:4","scriptId":11210,"text":"“好的，已经听到了，你们先走，我殿后。”","background":"/art/stories/zdjm-034.webp","left":212,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114011-PROLOGUE:1230:2","scriptId":1230,"text":"“前面，啊不，四周都已经被战车兽围堵了，怎么办？”","background":"/art/stories/zdjm-034.webp","left":36,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":104,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114011-PROLOGUE:1230:3","scriptId":1230,"text":"“只能强行突破了。”","background":"/art/stories/zdjm-034.webp","left":36,"right":104,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114011-PROLOGUE:1230:4","scriptId":1230,"text":"“等等！既然已经打算放弃这里，那么就一不做二不休了。”","background":"/art/stories/zdjm-034.webp","left":3,"right":104,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114011-PROLOGUE:1230:5","scriptId":1230,"text":"“什么意思？”","background":"/art/stories/zdjm-034.webp","left":3,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114011-PROLOGUE:1230:6","scriptId":1230,"text":"“把周围的建筑全部炸塌。封住两边的通道，这样的一来就只需要应付来自前方的敌人了。”","background":"/art/stories/zdjm-034.webp","left":3,"right":103,"section":2,"shake":false},{"kind":"dialogue","head":92,"speaker":"普莉玛·派普","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114011-PROLOGUE:1230:7","scriptId":1230,"text":"“收到，立刻执行！”","background":"/art/stories/zdjm-034.webp","left":3,"right":92,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114011-PROLOGUE:1230:8","scriptId":1230,"text":"“呃，对了，不要炸得太过火，不然连我们也会被一起埋了……”","background":"/art/stories/zdjm-034.webp","left":3,"right":92,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114011-EPILOGUE:11220:3","scriptId":11220,"text":"随着周围大楼的轰然倒塌，两侧的路口都被残垣断壁堵得严严实实，顺便也直接埋掉了一批战车兽。","background":"/art/stories/zdjm-034.webp","left":3,"right":92,"section":3,"shake":true},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114011-EPILOGUE:11220:4","scriptId":11220,"text":"“嗯～强拆成功。”","background":"/art/stories/zdjm-034.webp","left":3,"right":92,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114011-EPILOGUE:11220:5","scriptId":11220,"text":"“两边的路口都已封锁，现在就只要把挡在前面的敌人全部清除就行了。”","background":"/art/stories/zdjm-034.webp","left":3,"right":92,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114011-EPILOGUE:11220:6","scriptId":11220,"text":"“一下子就没多少障碍了，除了那个埃普西隆。”","background":"/art/stories/zdjm-034.webp","left":3,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114011-EPILOGUE:11220:7","scriptId":11220,"text":"“有教官在应该没问题吧。”","background":"/art/stories/zdjm-034.webp","left":31,"right":103,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114011-EPILOGUE:11220:8","scriptId":11220,"text":"回头看了看教官的位置，那里只能看到巨大的烟尘和时不时炸裂的火光……","background":"/art/stories/zdjm-034.webp","left":31,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114011-EPILOGUE:11220:9","scriptId":11220,"text":"“不好说……看来对手也不是三两下就能被摆平的。”","background":"/art/stories/zdjm-034.webp","left":3,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114012-PROLOGUE:1240:2","scriptId":1240,"text":"“快看！马上就要到出口了。”","background":"/art/stories/zdjm-034.webp","left":81,"right":103,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114012-PROLOGUE:1240:3","scriptId":1240,"text":"抬头往前一看，现在的位置距离教官打出的那个“洞口”已经没剩多远了。","background":"/art/stories/zdjm-034.webp","left":81,"right":103,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114012-PROLOGUE:1240:4","scriptId":1240,"text":"“不过那个洞口周围已经有一些战车兽了啊，在外围游荡的战车兽从那个洞口钻进来了……”","background":"/art/stories/zdjm-034.webp","left":81,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114012-PROLOGUE:1240:5","scriptId":1240,"text":"“那就先清理一下。”","background":"/art/stories/zdjm-034.webp","left":103,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114012-PROLOGUE:1240:6","scriptId":1240,"text":"“对了，不要对墙壁造成太大负担，吉普车还在下面……”","background":"/art/stories/zdjm-034.webp","left":103,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114012-PROLOGUE:1240:7","scriptId":1240,"text":"“现在还哪有功夫管那些，清理了再说，开炮。”","background":"/art/stories/zdjm-034.webp","left":103,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":92,"speaker":"普莉玛·派普","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114012-PROLOGUE:1240:8","scriptId":1240,"text":"“收到。”","background":"/art/stories/zdjm-034.webp","left":92,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114012-PROLOGUE:1240:9","scriptId":1240,"text":"（万一吉普车被埋了，我岂不是要走回去……）","background":"/art/stories/zdjm-034.webp","left":92,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114012-EPILOGUE:11230:1","scriptId":11230,"text":"“很好吉普车没事！”","background":"/art/stories/zdjm-034.webp","left":3,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114012-EPILOGUE:11230:2","scriptId":11230,"text":"我仔细检查了一下吉普车，确保一切正常以后就以最快速度把吉普车驶离围墙。","background":"/art/stories/zdjm-034.webp","left":3,"right":3,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114012-EPILOGUE:11230:3","scriptId":11230,"text":"离开一定距离以后，我停下车开始进行必要的补给。","background":"/art/stories/zdjm-034.webp","left":3,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114012-EPILOGUE:11230:4","scriptId":11230,"text":"“应急的工具箱在后备箱里，可以先抢修下你们的舞装。”","background":"/art/stories/zdjm-034.webp","left":3,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114012-EPILOGUE:11230:5","scriptId":11230,"text":"“对了，源奶也一起补充下，不要忘了。”","background":"/art/stories/zdjm-034.webp","left":3,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114012-EPILOGUE:11230:6","scriptId":11230,"text":"“恩，马上进行补给。”","background":"/art/stories/zdjm-034.webp","left":3,"right":103,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114012-EPILOGUE:11230:9","scriptId":11230,"text":"一声巨响，一个身影穿过围墙飞了出来，伴随着飞出的人影，墙壁开始向内部崩塌。定睛一看……","background":"/art/stories/zdjm-034.webp","left":3,"right":null,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114012-EPILOGUE:11230:10","scriptId":11230,"text":"“那个飞出来的人是教官！？”","background":"/art/stories/zdjm-034.webp","left":3,"right":null,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114012-EPILOGUE:11230:11","scriptId":11230,"text":"只见教官腰部翻过身子，一跃而起，顺手把掉在地上的帽子也捡了起来，掸了掸灰。","background":"/art/stories/zdjm-034.webp","left":3,"right":null,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114012-EPILOGUE:11230:12","scriptId":11230,"text":"“教官，你没事吧？”","background":"/art/stories/zdjm-034.webp","left":3,"right":null,"section":5,"shake":false},{"kind":"dialogue","head":216,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114012-EPILOGUE:11230:13","scriptId":11230,"text":"“没事没事，只是埃普西隆那家伙有点难对付啊。”","background":"/art/stories/zdjm-034.webp","left":3,"right":216,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114012-EPILOGUE:11230:14","scriptId":11230,"text":"“教官都搞不定的话……那我们是不是该脚底抹油了？”","background":"/art/stories/zdjm-034.webp","left":3,"right":216,"section":5,"shake":false},{"kind":"dialogue","head":221,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114012-EPILOGUE:11230:15","scriptId":11230,"text":"“呵呵……如果逃得掉的话……她已经来了。”","background":"/art/stories/zdjm-034.webp","left":3,"right":221,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114012-EPILOGUE:11230:16","scriptId":11230,"text":"“……”","background":"/art/stories/zdjm-034.webp","left":3,"right":221,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114012-EPILOGUE:11230:18","scriptId":11230,"text":"废墟那边发出一声巨响，墙壁的瓦砾和破片被一股不明的力量推开，形成了一条道路，而埃普西隆则顺着这条‘路’缓缓走了出来。","background":"/art/stories/zdjm-034.webp","left":3,"right":221,"section":5,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"114012-EPILOGUE:11230:19","scriptId":11230,"text":"“哦呀～就这点本事？一开始的气势去哪儿了？”","background":"/art/stories/zdjm-034.webp","left":48,"right":221,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114013-PROLOGUE:1250:2","scriptId":1250,"text":"教官虽然没受伤，但是从现状来看，属于是逃跑有难度，正面又打不过的节奏……","background":"/art/stories/zdjm-034.webp","left":48,"right":221,"section":6,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114013-PROLOGUE:1250:3","scriptId":1250,"text":"“所有的炮弹对埃普西隆都是无效的……”","background":"/art/stories/zdjm-034.webp","left":211,"right":221,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114013-PROLOGUE:1250:4","scriptId":1250,"text":"“此话怎讲？”","background":"/art/stories/zdjm-034.webp","left":211,"right":3,"section":6,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114013-PROLOGUE:1250:5","scriptId":1250,"text":"“我的炮弹都还没有接触到埃普西隆就被弹飞了。”","background":"/art/stories/zdjm-034.webp","left":211,"right":3,"section":6,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114013-PROLOGUE:1250:6","scriptId":1250,"text":"“看上去就像有一层看不见的墙挡在了我和她之间。”","background":"/art/stories/zdjm-034.webp","left":211,"right":3,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114013-PROLOGUE:1250:7","scriptId":1250,"text":"“既然不能接触，那教官刚才是怎么被打得飞出来的……？”","background":"/art/stories/zdjm-034.webp","left":211,"right":3,"section":6,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114013-PROLOGUE:1250:8","scriptId":1250,"text":"“那个啊……我也不太明白，我是被一股气流给击飞的。”","background":"/art/stories/zdjm-034.webp","left":211,"right":3,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114013-PROLOGUE:1250:9","scriptId":1250,"text":"“气流？”","background":"/art/stories/zdjm-034.webp","left":211,"right":3,"section":6,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114013-PROLOGUE:1250:10","scriptId":1250,"text":"“恩，只看到她的炮管发亮，我就下意识的进行了防御，于是就被气流给推出来了……”","background":"/art/stories/zdjm-034.webp","left":211,"right":3,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114013-PROLOGUE:1250:11","scriptId":1250,"text":"“……空气炮？”","background":"/art/stories/zdjm-034.webp","left":211,"right":3,"section":6,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114013-PROLOGUE:1250:12","scriptId":1250,"text":"“那种东西也太科幻了吧，不可能有的啦。”","background":"/art/stories/zdjm-034.webp","left":40,"right":3,"section":6,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114013-PROLOGUE:1250:13","scriptId":1250,"text":"“报告，埃普西隆开始向我们这边来了！”","background":"/art/stories/zdjm-034.webp","left":81,"right":3,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114013-PROLOGUE:1250:14","scriptId":1250,"text":"“先不管那么多了，准备迎战！”","background":"/art/stories/zdjm-034.webp","left":81,"right":3,"section":6,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114013-EPILOGUE:11240:1","scriptId":11240,"text":"战斗如火如荼地进行着，一时间轰声四起，弹片横飞。","background":"/art/stories/zdjm-034.webp","left":81,"right":3,"section":7,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114013-EPILOGUE:11240:6","scriptId":11240,"text":"顺利清理掉了埃普西隆周围的战车兽，但是对埃普西隆本人却没有任何办法。","background":"/art/stories/zdjm-034.webp","left":81,"right":3,"section":7,"shake":true},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114013-EPILOGUE:11240:7","scriptId":11240,"text":"我们这边无法碰触到埃普西隆一丝一毫，所有炮弹在接触到埃普西隆之前就被弹飞。","background":"/art/stories/zdjm-034.webp","left":81,"right":3,"section":7,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114013-EPILOGUE:11240:8","scriptId":11240,"text":"“实在是太弱了～真是高看你们了～”","background":"/art/stories/zdjm-034.webp","left":81,"right":48,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114013-EPILOGUE:11240:9","scriptId":11240,"text":"“不要停止攻击！”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":7,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114013-EPILOGUE:11240:10","scriptId":11240,"text":"“无谓的挣扎～好了，我也玩够了，该送你们上路——”","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":7,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114013-EPILOGUE:11240:11","scriptId":11240,"text":"又一轮齐射，不过这一次有一枚炮弹打偏了，正好在埃普西隆的脚边炸了开来。","background":"/art/stories/zdjm-034.webp","left":3,"right":48,"section":7,"shake":false},{"kind":"dialogue","head":49,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114013-EPILOGUE:11240:15","scriptId":11240,"text":"“呀！！！！！！”","background":"/art/stories/zdjm-034.webp","left":3,"right":49,"section":7,"shake":true},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114013-EPILOGUE:11240:16","scriptId":11240,"text":"谁都没想到这枚射偏了的炮弹，让埃普西隆猝不及防，脚腕处被溅射出的炮弹碎片擦出了一道口子。","background":"/art/stories/zdjm-034.webp","left":3,"right":49,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114013-EPILOGUE:11240:17","scriptId":11240,"text":"“！！！！”","background":"/art/stories/zdjm-034.webp","left":3,"right":49,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114013-EPILOGUE:11240:18","scriptId":11240,"text":"“刚才是谁射的那发？？”","background":"/art/stories/zdjm-034.webp","left":3,"right":49,"section":7,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114013-EPILOGUE:11240:19","scriptId":11240,"text":"“啊……好像是我射偏了……”","background":"/art/stories/zdjm-034.webp","left":3,"right":40,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114013-EPILOGUE:11240:20","scriptId":11240,"text":"“干得漂亮！”","background":"/art/stories/zdjm-034.webp","left":3,"right":40,"section":7,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114013-EPILOGUE:11240:21","scriptId":11240,"text":"“诶！？”","background":"/art/stories/zdjm-034.webp","left":3,"right":41,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114013-EPILOGUE:11240:22","scriptId":11240,"text":"“刚才那枚炮弹的破片是从埃普西隆的视野范围之外射入的。”","background":"/art/stories/zdjm-034.webp","left":3,"right":41,"section":7,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114013-EPILOGUE:11240:23","scriptId":11240,"text":"“另外我仔细观察了一下，埃普西隆的防弹能力可能来自于她的炮口，不过只限于她视野能看到的范围。”","background":"/art/stories/zdjm-034.webp","left":3,"right":41,"section":7,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114013-EPILOGUE:11240:24","scriptId":11240,"text":"“也就是说，从她视野以外的地方发动突袭，就能避免炮弹被她弹开！”","background":"/art/stories/zdjm-034.webp","left":3,"right":211,"section":7,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114013-EPILOGUE:11240:25","scriptId":11240,"text":"“观察得很仔细嘛，这下有办法对付她了！”","background":"/art/stories/zdjm-034.webp","left":3,"right":211,"section":7,"shake":false},{"kind":"dialogue","head":49,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114014-PROLOGUE:1260:2","scriptId":1260,"text":"“唔……”","background":"/art/stories/zdjm-034.webp","left":3,"right":49,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-PROLOGUE:1260:3","scriptId":1260,"text":"埃普西隆摸了摸自己的脚腕，看来这家伙不太吃痛……","background":"/art/stories/zdjm-034.webp","left":3,"right":49,"section":8,"shake":false},{"kind":"dialogue","head":47,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114014-PROLOGUE:1260:5","scriptId":1260,"text":"“疼死我了，你们好大的胆子！”","background":"/art/stories/zdjm-034.webp","left":3,"right":47,"section":8,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114014-PROLOGUE:1260:6","scriptId":1260,"text":"“哼哼，该轮到我们反击了，就剩你一个，乖乖投降吧。”","background":"/art/stories/zdjm-034.webp","left":211,"right":47,"section":8,"shake":false},{"kind":"dialogue","head":47,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114014-PROLOGUE:1260:7","scriptId":1260,"text":"“侥幸让你们得手了一次而已，不要太得意了。”","background":"/art/stories/zdjm-034.webp","left":211,"right":47,"section":8,"shake":false},{"kind":"dialogue","head":47,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114014-PROLOGUE:1260:8","scriptId":1260,"text":"“我决定了！让你们死无全尸！”","background":"/art/stories/zdjm-034.webp","left":211,"right":47,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-PROLOGUE:1260:9","scriptId":1260,"text":"惊人的一幕出现了，埃普西隆身体开始散发出白光，接着在众目睽睽之下分裂成好几个一模一样的身体。","background":"/art/stories/zdjm-034.webp","left":211,"right":47,"section":8,"shake":false},{"kind":"dialogue","head":54,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"114014-PROLOGUE:1260:11","scriptId":1260,"text":"“……”","background":"/art/stories/zdjm-034.webp","left":54,"right":null,"section":8,"shake":false},{"kind":"dialogue","head":54,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114014-PROLOGUE:1260:12","scriptId":1260,"text":"“……”","background":"/art/stories/zdjm-034.webp","left":54,"right":54,"section":8,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114014-PROLOGUE:1260:13","scriptId":1260,"text":"“1、2、3、4、5、6……啊！怎么一下子就变出了六个？”","background":"/art/stories/zdjm-034.webp","left":41,"right":54,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114014-PROLOGUE:1260:14","scriptId":1260,"text":"“我的天，这是什么魔法……我的思维有点跟不上了……”","background":"/art/stories/zdjm-034.webp","left":41,"right":3,"section":8,"shake":false},{"kind":"dialogue","head":113,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114014-PROLOGUE:1260:15","scriptId":1260,"text":"“光是应付一个就已经很勉强了……六个……这简直……”","background":"/art/stories/zdjm-034.webp","left":113,"right":3,"section":8,"shake":false},{"kind":"dialogue","head":92,"speaker":"普莉玛·派普","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114014-PROLOGUE:1260:16","scriptId":1260,"text":"“怎么办，怎么办……”","background":"/art/stories/zdjm-034.webp","left":92,"right":3,"section":8,"shake":false},{"kind":"dialogue","head":86,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114014-PROLOGUE:1260:17","scriptId":1260,"text":"“这分明是作弊啊，怎么可能有分身这种不科学的能力！？”","background":"/art/stories/zdjm-034.webp","left":92,"right":86,"section":8,"shake":false},{"kind":"dialogue","head":220,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114014-PROLOGUE:1260:18","scriptId":1260,"text":"“别管科不科学了！都已经摆在眼前了，只能迎战了！”","background":"/art/stories/zdjm-034.webp","left":220,"right":86,"section":8,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114014-PROLOGUE:1260:19","scriptId":1260,"text":"“受死吧！”","background":"/art/stories/zdjm-034.webp","left":220,"right":48,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-PROLOGUE:1260:20","scriptId":1260,"text":"伴随着巨大的绝望感，埃普西隆和她的分身向众人袭来……","background":"/art/stories/zdjm-034.webp","left":220,"right":48,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-EPILOGUE:11250:1","scriptId":11250,"text":"虽然埃普西隆像变魔术一样变出了好几个分身，不过那些分身好像并没有她的防弹能力。","background":"/art/stories/zdjm-034.webp","left":220,"right":48,"section":9,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-EPILOGUE:11250:2","scriptId":11250,"text":"费了一番功夫把埃普西隆的分身都处理掉了。","background":"/art/stories/zdjm-034.webp","left":220,"right":48,"section":9,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114014-EPILOGUE:11250:3","scriptId":11250,"text":"“有点小本事嘛～我看你们还能坚持到什么时候！”","background":"/art/stories/zdjm-034.webp","left":220,"right":48,"section":9,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-EPILOGUE:11250:4","scriptId":11250,"text":"说完，埃普西隆又变出了好多个分身……","background":"/art/stories/zdjm-034.webp","left":220,"right":48,"section":9,"shake":false},{"kind":"dialogue","head":54,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"114014-EPILOGUE:11250:6","scriptId":11250,"text":"“……”","background":"/art/stories/zdjm-034.webp","left":54,"right":null,"section":9,"shake":false},{"kind":"dialogue","head":54,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114014-EPILOGUE:11250:7","scriptId":11250,"text":"“……”","background":"/art/stories/zdjm-034.webp","left":54,"right":54,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114014-EPILOGUE:11250:8","scriptId":11250,"text":"“我靠！这还怎么玩……这无限制的分身，消耗战根本不是对手啊……”","background":"/art/stories/zdjm-034.webp","left":3,"right":54,"section":9,"shake":false},{"kind":"dialogue","head":220,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114014-EPILOGUE:11250:9","scriptId":11250,"text":"“抱怨也没有用，只能走一步算一步了……”","background":"/art/stories/zdjm-034.webp","left":3,"right":220,"section":9,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-EPILOGUE:11250:10","scriptId":11250,"text":"虽然教官这么说，但其实我们战况非常不利，除了教官以外其他人都已经气喘吁吁……","background":"/art/stories/zdjm-034.webp","left":3,"right":220,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114014-EPILOGUE:11250:11","scriptId":11250,"text":"（疲劳作战可是兵家大忌……得快点想个办法摆脱目前这个局势，怎么办呢……）","background":"/art/stories/zdjm-034.webp","left":3,"right":220,"section":9,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-EPILOGUE:11250:12","scriptId":11250,"text":"就在我方一筹莫展之际，另一个身影出现在了埃普西隆身后----","background":"/art/stories/zdjm-034.webp","left":3,"right":220,"section":9,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114014-EPILOGUE:11250:13","scriptId":11250,"text":"“还没好吗？奥密克戎队长要我们回去了。”","background":"/art/stories/zdjm-034.webp","left":3,"right":56,"section":9,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-EPILOGUE:11250:14","scriptId":11250,"text":"让众人目瞪口呆的事情，又一只人形生物出现了……","background":"/art/stories/zdjm-034.webp","left":3,"right":56,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114014-EPILOGUE:11250:15","scriptId":11250,"text":"（怎么还有一个！？完了完了完了……这下死定了……）","background":"/art/stories/zdjm-034.webp","left":3,"right":56,"section":9,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"114014-EPILOGUE:11250:16","scriptId":11250,"text":"“就快了！还差一点点啦！兰布达。”","background":"/art/stories/zdjm-034.webp","left":48,"right":56,"section":9,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114014-EPILOGUE:11250:17","scriptId":11250,"text":"“这种话我已经听你说过无数次了……而且还浪费了那么多实验体。”","background":"/art/stories/zdjm-034.webp","left":48,"right":56,"section":9,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"114014-EPILOGUE:11250:18","scriptId":11250,"text":"“走了，反正他们继续留在这里也是死路一条。”","background":"/art/stories/zdjm-034.webp","left":48,"right":56,"section":9,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-EPILOGUE:11250:19","scriptId":11250,"text":"兰布达一把抓住埃普西隆的肩膀，用力往后拖。","background":"/art/stories/zdjm-034.webp","left":48,"right":56,"section":9,"shake":false},{"kind":"dialogue","head":49,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"114014-EPILOGUE:11250:21","scriptId":11250,"text":"“诶！？等等……兰布达----”","background":"/art/stories/zdjm-034.webp","left":49,"right":56,"section":9,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-EPILOGUE:11250:22","scriptId":11250,"text":"没等埃普西隆说完，兰布达和埃普西隆两人身上同时发出个非常耀眼的光芒----","background":"/art/stories/zdjm-034.webp","left":49,"right":56,"section":9,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-EPILOGUE:11250:25","scriptId":11250,"text":"眨眼间两人化作一道白光消失了……留下我们一堆人在原地发呆……","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114014-EPILOGUE:11250:26","scriptId":11250,"text":"（这到底是什么情况……）","background":"/art/stories/zdjm-034.webp","left":3,"right":null,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114014-EPILOGUE:11250:30","scriptId":11250,"text":"“这是什么声音！？”","background":"/art/stories/zdjm-034.webp","left":3,"right":null,"section":9,"shake":false},{"kind":"dialogue","head":220,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114014-EPILOGUE:11250:31","scriptId":11250,"text":"“这是研究所的自毁警告！！！”","background":"/art/stories/zdjm-034.webp","left":3,"right":220,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"114014-EPILOGUE:11250:32","scriptId":11250,"text":"“什么！？还有这种玩意！？”","background":"/art/stories/zdjm-034.webp","left":3,"right":220,"section":9,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-EPILOGUE:11250:34","scriptId":11250,"text":"教官对着旁边的吉普车用力一踹，把这个整个车身掀翻起来，作为一个临时掩体。","background":"/art/stories/zdjm-034.webp","left":3,"right":220,"section":9,"shake":true},{"kind":"dialogue","head":220,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"114014-EPILOGUE:11250:35","scriptId":11250,"text":"“大家快躲进来！怪不得她们刚才说留在这里也是死，竟然启动了自毁……”","background":"/art/stories/zdjm-034.webp","left":3,"right":220,"section":9,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"114014-EPILOGUE:11250:40","scriptId":11250,"text":"没过多久，从研究所内部开始了大规模的连环爆炸……","background":"/art/stories/zdjm-034.webp","left":3,"right":220,"section":9,"shake":true}],"summaries":["索菲亚教官成功救场。","开始顺着来的方向撤退。","终于退到了来时的“洞口”","教官竟然都赢不了埃普西隆，这可怎么办……","终于找到了埃普西隆的弱点？"]}
