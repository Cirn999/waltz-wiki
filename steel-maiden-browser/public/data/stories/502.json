{"schemaVersion":1,"id":502,"sections":[{"id":"1921001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20683],"start":0,"count":36},{"id":"1921001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20684],"start":36,"count":12}],"frames":[{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:1","scriptId":20683,"text":"“……”","background":"/art/stories/zdbjbz-10.webp","left":null,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:2","scriptId":20683,"text":"“……”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1921001-PROLOGUE:20683:3","scriptId":20683,"text":"由于佐伊她们都去侦查周围情况了，待在原地的我由齐奈达守护着。","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:4","scriptId":20683,"text":"（她这么一直跟着我感觉好不舒服……）","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:5","scriptId":20683,"text":"“蹲下。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:6","scriptId":20683,"text":"“是。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:7","scriptId":20683,"text":"“起立。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:8","scriptId":20683,"text":"“是。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:9","scriptId":20683,"text":"“坐下。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:10","scriptId":20683,"text":"“是。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1921001-PROLOGUE:20683:11","scriptId":20683,"text":"无所事事地我对齐奈达产生了些许兴趣，抱着半开玩笑的心态随口下了几个命令。","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:12","scriptId":20683,"text":"（好听话……有点像小狗……）","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:13","scriptId":20683,"text":"“对命令的响应速度很快……”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:14","scriptId":20683,"text":"“齐奈达，卸下项圈。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:15","scriptId":20683,"text":"“缺少命令台座，无法完成此项任务。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:16","scriptId":20683,"text":"“嗯……看来也有无法做到的命令。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1921001-PROLOGUE:20683:17","scriptId":20683,"text":"对提问有些心得，于是我想试试能否从齐奈达那边得到一些线索。","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:18","scriptId":20683,"text":"“你在之前的中继站干什么？”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:19","scriptId":20683,"text":"“神经控制节点损伤前的命令已丢失。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:20","scriptId":20683,"text":"（看来佐伊的误伤造成的损伤还不小……）","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1921001-PROLOGUE:20683:21","scriptId":20683,"text":"没想到一上来就碰壁，于是只能另辟蹊径。","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:22","scriptId":20683,"text":"“那……神经控制节点损伤前的记忆你存有多少？”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:23","scriptId":20683,"text":"“控制介入前的记忆全部完好，控制介入后直至损伤前的记忆只存有片段，但无法拼接。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1921001-PROLOGUE:20683:24","scriptId":20683,"text":"齐奈达的眼神非常空洞，就像丢了魂一样。","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:25","scriptId":20683,"text":"“有恢复记忆的可能吗？”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:26","scriptId":20683,"text":"“………………不可估算。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:27","scriptId":20683,"text":"“呃……”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":1137,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:28","scriptId":20683,"text":"“长官！你在干嘛呢？难道是趁我们不在就对齐奈达下什么龌龊的命令！？”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1921001-PROLOGUE:20683:29","scriptId":20683,"text":"看样子佐伊已经完成侦查，接着佩妮奈特莉维卡也都陆续出现在视野中。","background":"/art/stories/zdbjbz-10.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:30","scriptId":20683,"text":"“你说什么呢，我不过是在问齐奈达一些记忆方面的问题。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:31","scriptId":20683,"text":"“那问出什么没有？”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:32","scriptId":20683,"text":"“很遗憾，貌似被佐伊误伤后所造成的损伤很严重，记忆只有断片了。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:33","scriptId":20683,"text":"“诶？那么严重吗？”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:34","scriptId":20683,"text":"“总之从齐奈达这里也得不到什么有用的情报。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:35","scriptId":20683,"text":"“我们这里倒是有些收获。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-PROLOGUE:20683:36","scriptId":20683,"text":"“哦？”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1921001-EPILOGUE:20684:1","scriptId":20684,"text":"根据佩妮她们侦查的结果，我们轻松拿下了一座可疑的仓库。","background":"/art/stories/zdbjbz-10.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1921001-EPILOGUE:20684:2","scriptId":20684,"text":"虽然看守仓库的钢舞姬冷不丁对我们发动了奇袭，但我们早有提防，轻松反制了对方。","background":"/art/stories/zdbjbz-10.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-EPILOGUE:20684:3","scriptId":20684,"text":"“这仓库的东西有点眼熟啊……是骸虫的幼崽吧，在兰布达那儿看到过。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1921001-EPILOGUE:20684:4","scriptId":20684,"text":"走到仓库里，我们看到了熟悉的东西。","background":"/art/stories/zdbjbz-10.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-EPILOGUE:20684:5","scriptId":20684,"text":"“是的，是骸虫的幼虫……这饲料难道是……”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1921001-EPILOGUE:20684:6","scriptId":20684,"text":"可以看到一堆咖啡色的甲壳生物正在啃食着一段动物的残肢。","background":"/art/stories/zdbjbz-10.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1921001-EPILOGUE:20684:7","scriptId":20684,"text":"深究这饲料究竟是何种动物并没有多大的意义而且可能还会散乱军心，于是——","background":"/art/stories/zdbjbz-10.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-EPILOGUE:20684:8","scriptId":20684,"text":"“看来我们离目标越来越近了，说不定还能顺藤摸瓜找到旅行者的基地。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":577,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-EPILOGUE:20684:9","scriptId":20684,"text":"“如果是那样就好了，顺便先烧了这个仓库吧，这些骸虫看着就恶心……”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":577,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-EPILOGUE:20684:10","scriptId":20684,"text":"“烧，就这么放着觉得会出大问题。”","background":"/art/stories/zdbjbz-10.webp","left":4,"right":577,"section":1,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"1921001-EPILOGUE:20684:11","scriptId":20684,"text":"“我去拿汽油。”","background":"/art/stories/zdbjbz-10.webp","left":596,"right":577,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"1921001-EPILOGUE:20684:12","scriptId":20684,"text":"于是我们锁上库门把整个仓库付之一炬，骸虫的惨叫声不绝于耳。","background":"/art/stories/zdbjbz-10.webp","left":596,"right":577,"section":1,"shake":false}],"summaries":[]}
