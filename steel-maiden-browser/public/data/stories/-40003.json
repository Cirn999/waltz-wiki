{"schemaVersion":1,"id":-40003,"sections":[{"id":"script-20003","name":"原始脚本 20003","scripts":[20003],"start":0,"count":21}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20003:20003:1","scriptId":20003,"text":"从波西娅博士那边得到了解释，虽然这次是征召了三个队伍，但好像并不需要集团行动的样子，所以即使和其他小队分散也不影响行动。","background":"/art/stories/zdbjbz-03.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:2","scriptId":20003,"text":"“莫夏，确认一下队伍情况，有没有什么问题。”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":22,"speaker":"莫夏·梅列茨安娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:3","scriptId":20003,"text":"“玛鲁夏和我都没有什么问题，问题是多萝……”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":22,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:4","scriptId":20003,"text":"“多萝怎么了！？”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":22,"section":0,"shake":false},{"kind":"dialogue","head":29,"speaker":"莫夏·梅列茨安娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:5","scriptId":20003,"text":"“那家伙又睡着了……”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":29,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:6","scriptId":20003,"text":"“……”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":29,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:7","scriptId":20003,"text":"“给我把她拖起来！”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":29,"section":0,"shake":false},{"kind":"dialogue","head":27,"speaker":"莫夏·梅列茨安娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:8","scriptId":20003,"text":"“遵命～”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":27,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20003:20003:9","scriptId":20003,"text":"莫夏走到躺在地上的多萝身边，推了推她……","background":"/art/stories/zdbjbz-03.webp","left":8,"right":27,"section":0,"shake":false},{"kind":"dialogue","head":26,"speaker":"莫夏·梅列茨安娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:10","scriptId":20003,"text":"“多萝，快起来了！现在不是睡觉的时候啦。”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":26,"section":0,"shake":false},{"kind":"dialogue","head":675,"speaker":"多萝·雷德尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:11","scriptId":20003,"text":"“啊……嗯……啊，到起床时间了吗？”","background":"/art/stories/zdbjbz-03.webp","left":675,"right":26,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20003:20003:12","scriptId":20003,"text":"把多萝弄醒了以后，一旁的玛鲁夏发话了。","background":"/art/stories/zdbjbz-03.webp","left":675,"right":26,"section":0,"shake":false},{"kind":"dialogue","head":644,"speaker":"玛鲁夏·德米特里耶夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:13","scriptId":20003,"text":"“这里的空旷地形比较适合我们作战，作为测试的话，只要干掉那边的战车兽就行了吧。","background":"/art/stories/zdbjbz-03.webp","left":675,"right":644,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:14","scriptId":20003,"text":"“确实，既然波西娅博士只是要收集和模拟战车兽的作战数据，那直接开打也不会有什么问题。”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":644,"section":0,"shake":false},{"kind":"dialogue","head":25,"speaker":"莫夏·梅列茨安娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:15","scriptId":20003,"text":"“那么顺主人的意思，已经可以开始轰炸了吧～”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":25,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:16","scriptId":20003,"text":"“没错。直接用最大火力攻击那边的战车兽，扫平这里的所有战车兽。”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":25,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:17","scriptId":20003,"text":"“早早摆平的话，回去以后就有时间睡觉了，多萝。”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":25,"section":0,"shake":false},{"kind":"dialogue","head":670,"speaker":"多萝·雷德尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:18","scriptId":20003,"text":"“哦～那么多萝开动了～”","background":"/art/stories/zdbjbz-03.webp","left":670,"right":25,"section":0,"shake":false},{"kind":"dialogue","head":8,"speaker":"艾莉丝·戴高乐","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:19","scriptId":20003,"text":"“都行动起来，不要拖拖拉拉的。”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":25,"section":0,"shake":false},{"kind":"dialogue","head":644,"speaker":"玛鲁夏·德米特里耶夫娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:20","scriptId":20003,"text":"“OK～”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":644,"section":0,"shake":false},{"kind":"dialogue","head":25,"speaker":"莫夏·梅列茨安娜","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20003:20003:21","scriptId":20003,"text":"“遵命～”","background":"/art/stories/zdbjbz-03.webp","left":8,"right":25,"section":0,"shake":false}],"summaries":[]}
