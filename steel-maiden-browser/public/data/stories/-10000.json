{"schemaVersion":1,"id":-10000,"sections":[{"id":"opening","name":"启程","scripts":[1,2,3],"start":0,"count":37}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"opening:1:1","scriptId":1,"text":"早晨 05:00 莱茵河谷基地","background":"/art/stories/zjm-156.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:1:2","scriptId":1,"text":"“我是佐伊·谢尔曼，是负责来接您前往阿尔萨斯的。”","background":"/art/stories/zjm-156.webp","left":31,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"opening:1:3","scriptId":1,"text":"“Zzz……Zzz……”","background":"/art/stories/zjm-156.webp","left":31,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":38,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:1:4","scriptId":1,"text":"“长官？”","background":"/art/stories/zjm-156.webp","left":38,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"opening:1:5","scriptId":1,"text":"“好的好的，行李在那里。”我指了指角落里的一大堆行李。","background":"/art/stories/zjm-156.webp","left":38,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"opening:1:6","scriptId":1,"text":"“你提得动吗？”看佐伊那小巧的身躯，我不禁问道。","background":"/art/stories/zjm-156.webp","left":38,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:1:7","scriptId":1,"text":"“我也是钢舞姬的一员，这点行李不在话下。”","background":"/art/stories/zjm-156.webp","left":37,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"opening:1:8","scriptId":1,"text":"“哦，这就是你的正式舞装？”","background":"/art/stories/zjm-156.webp","left":37,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:1:9","scriptId":1,"text":"“是的！”说罢，佐伊拿出了自己的军官证。","background":"/art/stories/zjm-156.webp","left":39,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"opening:2:1","scriptId":2,"text":"早晨 07:00  F国东北部—阿尔萨斯附近","background":"/art/stories/zjm-168.webp","left":39,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":33,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:2:2","scriptId":2,"text":"“距离市区还剩大约1小时的车程，马上就能看到市区了，长官。”","background":"/art/stories/zjm-168.webp","left":33,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"opening:2:3","scriptId":2,"text":"“Zzz……Zzz……”","background":"/art/stories/zjm-168.webp","left":33,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:2:4","scriptId":2,"text":"“长官？”","background":"/art/stories/zjm-168.webp","left":41,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"opening:2:5","scriptId":2,"text":"“知道了知道了，到司令部再叫醒我……”","background":"/art/stories/zjm-168.webp","left":41,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:2:6","scriptId":2,"text":"（唉，看来这次总部派来的指挥官又是个不太靠谱的家伙啊……）","background":"/art/stories/zjm-168.webp","left":40,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":33,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:2:7","scriptId":2,"text":"“长官，接下来我们要穿越斯特拉斯堡小镇。”","background":"/art/stories/zjm-168.webp","left":33,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"opening:2:8","scriptId":2,"text":"“……斯特拉斯堡？那个争夺中的小镇？”","background":"/art/stories/zjm-168.webp","left":33,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:2:9","scriptId":2,"text":"“是的，也是我的故乡。”","background":"/art/stories/zjm-168.webp","left":37,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"opening:2:12","scriptId":2,"text":"突然，感到吉普车飞起来了，耳中被灌入一声巨响，瞬间又变成了耳鸣声。","background":"/art/stories/zjm-168.webp","left":37,"right":3,"section":0,"shake":true},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:2:13","scriptId":2,"text":"“长官，我们被袭击了！目标距离20！战车兽小群。”","background":"/art/stories/zjm-168.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"opening:2:14","scriptId":2,"text":"“什么？？”","background":"/art/stories/zjm-168.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:2:15","scriptId":2,"text":"“不管那么多了，这里就先交给我了！”","background":"/art/stories/zjm-168.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"opening:2:16","scriptId":2,"text":"“等等……” 我的大脑试图整理现在的突发状况，但是身体还没缓过来。","background":"/art/stories/zjm-168.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"opening:2:17","scriptId":2,"text":"眼前的这位少女头也不回地冲向了目标……","background":"/art/stories/zjm-168.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"opening:3:1","scriptId":3,"text":"战车兽的攻击非常凶狠，佐伊的体力渐渐不支，眼看就要败于战车兽们的连续攻势。","background":"/art/stories/zjm-166.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":36,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:3:2","scriptId":3,"text":"“可恶……明明就差一点点了。”","background":"/art/stories/zjm-166.webp","left":36,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":51,"speaker":"阿基米德","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"opening:3:3","scriptId":3,"text":"“呜呜呜！”","background":"/art/stories/zjm-166.webp","left":36,"right":51,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"opening:3:4","scriptId":3,"text":"战车兽发出了得意的鸣叫，背上的炮管已经锁定佐伊。","background":"/art/stories/zjm-166.webp","left":36,"right":51,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"opening:3:7","scriptId":3,"text":"就在这时，一发炮弹直接命中战车兽的面门。","background":"/art/stories/zjm-166.webp","left":36,"right":51,"section":0,"shake":true},{"kind":"dialogue","head":51,"speaker":"阿基米德","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"opening:3:9","scriptId":3,"text":"“呜呜呜呜！”","background":"/art/stories/zjm-166.webp","left":36,"right":51,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"opening:3:10","scriptId":3,"text":"其中一只战车兽应声倒地。","background":"/art/stories/zjm-166.webp","left":36,"right":51,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:3:11","scriptId":3,"text":"“什么？”","background":"/art/stories/zjm-166.webp","left":41,"right":51,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"opening:3:12","scriptId":3,"text":"佐伊对眼前发生的事情有些摸不着头脑。","background":"/art/stories/zjm-166.webp","left":41,"right":51,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"opening:3:13","scriptId":3,"text":"“刚才都让你等等了，也罢，从结果上来看，你确实给我们争取了不少时间。”","background":"/art/stories/zjm-166.webp","left":41,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"opening:3:14","scriptId":3,"text":"“长官！？”","background":"/art/stories/zjm-166.webp","left":37,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"opening:3:15","scriptId":3,"text":"佐伊循声望去，一下子豁然开朗。","background":"/art/stories/zjm-166.webp","left":37,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"opening:3:16","scriptId":3,"text":"只见，指挥官威风凛凛的出现在战场不远处，身边站着另外两位钢舞姬。","background":"/art/stories/zjm-166.webp","left":37,"right":3,"section":0,"shake":false}],"summaries":[]}
