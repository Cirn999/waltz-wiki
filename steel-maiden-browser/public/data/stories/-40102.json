{"schemaVersion":1,"id":-40102,"sections":[{"id":"script-20102","name":"原始脚本 20102","scripts":[20102],"start":0,"count":13}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20102:20102:0","scriptId":20102,"text":"解决了冲过来的不明敌人，准备过去看个究竟，但是敌人的尸体在死亡以后就变成一串数据消失了……。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20102:20102:1","scriptId":20102,"text":"“这到底是什么东西？”","background":"/art/stories/zjm-047.webp","left":584,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":575,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20102:20102:2","scriptId":20102,"text":"“看上去黏糊糊，怪恶心的……”","background":"/art/stories/zjm-047.webp","left":584,"right":575,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20102:20102:3","scriptId":20102,"text":"“那种材质我以前见过，如果没猜错，应该是不明人形相关的东西吧……但是这里是虚拟世界，怎么会有这种东西。”","background":"/art/stories/zjm-047.webp","left":4,"right":575,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20102:20102:4","scriptId":20102,"text":"“我来解答你的问题。”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20102:20102:5","scriptId":20102,"text":"耳朵里传来了波西娅博士的声音，随后波西娅的身姿又出现在众人的面前。","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20102:20102:6","scriptId":20102,"text":"“刚才的电子入侵基本已经稳定，但是已经有大量的不明数据传入了我的程式。”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20102:20102:7","scriptId":20102,"text":"“于是我们就会遇到那种生物？”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20102:20102:8","scriptId":20102,"text":"“对的，我现在在这里正式追加委托，消灭程式中的所有不明数据！”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20102:20102:9","scriptId":20102,"text":"“哦！？那么报酬方面……”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20102:20102:10","scriptId":20102,"text":"“我给出的委托报酬让你不满意过吗？”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20102:20102:11","scriptId":20102,"text":"“没……没有……”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20102:20102:12","scriptId":20102,"text":"“那就行了，开工吧！”","background":"/art/stories/zjm-047.webp","left":4,"right":608,"section":0,"shake":false}],"summaries":[]}
