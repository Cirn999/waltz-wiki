{"schemaVersion":1,"id":-40125,"sections":[{"id":"script-20125","name":"原始脚本 20125","scripts":[20125],"start":0,"count":30}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20125:20125:1","scriptId":20125,"text":"下午时分，岗位交替，白银皇后小队接替我们进行值班任务，终于得以休息——","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:2","scriptId":20125,"text":"“熬夜还真是挺累的呢……”","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20125:20125:3","scriptId":20125,"text":"本来打算回度假村的旅馆睡一个下午来着，结果佐伊和佩妮把尤拉和艾丽莎给找来了……","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20125:20125:4","scriptId":20125,"text":"结果我变成了半强制的陪玩状态。","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20125:20125:5","scriptId":20125,"text":"沙滩边——","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20125:20125:6","scriptId":20125,"text":"佐伊她们卸下了舞装换上了泳装，有说有笑地在前面走着，而我则是一副无精打采的样子。","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:7","scriptId":20125,"text":"“长官好像很累的样子呢～你们昨天晚上折腾得那么凶啊～”","background":"/art/stories/zjm-101.webp","left":728,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":748,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:8","scriptId":20125,"text":"“怎么会，只不过就熬夜一个晚上而已，长官自己身体虚～”","background":"/art/stories/zjm-101.webp","left":728,"right":748,"section":0,"shake":false},{"kind":"dialogue","head":13,"speaker":"艾丽莎","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:9","scriptId":20125,"text":"“恩，精神状态萎靡，如果不休息好的话就会变成这个样子啊……”","background":"/art/stories/zjm-101.webp","left":13,"right":748,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:10","scriptId":20125,"text":"“我觉得可以让长官去休息一下……”","background":"/art/stories/zjm-101.webp","left":13,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:11","scriptId":20125,"text":"“毕竟没有男士陪同，周边上来搭讪的‘苍蝇’真是络绎不绝……好烦的说。”","background":"/art/stories/zjm-101.webp","left":728,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:12","scriptId":20125,"text":"（我就是被当成挡箭牌了啊……）","background":"/art/stories/zjm-101.webp","left":728,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:13","scriptId":20125,"text":"“接下来我们先去吃点夏威夷的特产吧～”","background":"/art/stories/zjm-101.webp","left":728,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":13,"speaker":"艾丽莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:14","scriptId":20125,"text":"“恩，食物摄取对身体非常有帮助。”","background":"/art/stories/zjm-101.webp","left":728,"right":13,"section":0,"shake":false},{"kind":"dialogue","head":748,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:15","scriptId":20125,"text":"“赞成～好久没有那么自由地吃喝玩乐了～”","background":"/art/stories/zjm-101.webp","left":748,"right":13,"section":0,"shake":false},{"kind":"dialogue","head":589,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:16","scriptId":20125,"text":"“姐姐不要太过放松，我们现在仍旧是在任务之中，一旦发生什么情况，要立即应对的。”","background":"/art/stories/zjm-101.webp","left":748,"right":589,"section":0,"shake":false},{"kind":"dialogue","head":748,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:17","scriptId":20125,"text":"“知道啦～佩妮真爱操心。”","background":"/art/stories/zjm-101.webp","left":748,"right":589,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20125:20125:19","scriptId":20125,"text":"白银皇后小队那里——","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":785,"speaker":"路易斯·华盛顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:20","scriptId":20125,"text":"“诺伊娜，对面山崖边好像有几只战车兽。”","background":"/art/stories/zjm-101.webp","left":785,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":799,"speaker":"波比·克里斯蒂安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:21","scriptId":20125,"text":"“我这边也发现几只。”","background":"/art/stories/zjm-101.webp","left":785,"right":799,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:22","scriptId":20125,"text":"“恩，我这就过来。”","background":"/art/stories/zjm-101.webp","left":680,"right":799,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20125:20125:23","scriptId":20125,"text":"看到诺伊娜在那里东奔西走，正在一边休息的奥莉娅问道。","background":"/art/stories/zjm-101.webp","left":680,"right":799,"section":0,"shake":false},{"kind":"dialogue","head":784,"speaker":"奥莉娅·契科娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:24","scriptId":20125,"text":"“诺伊娜你好像很忙的样子，这次的战车兽有那么多吗？”","background":"/art/stories/zjm-101.webp","left":680,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:25","scriptId":20125,"text":"“是啊……不知道是什么情况，从刚才开始就有战车兽陆陆续续向这里靠近，虽然没有明显的攻击行为，但是这也太蹊跷了。”","background":"/art/stories/zjm-101.webp","left":680,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":784,"speaker":"奥莉娅·契科娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:26","scriptId":20125,"text":"“要不要我也来帮忙～正好休息着，闲着也是闲着～”","background":"/art/stories/zjm-101.webp","left":680,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:27","scriptId":20125,"text":"“这怎么行，万一出了什么问题，我可担待不起啊……”","background":"/art/stories/zjm-101.webp","left":680,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":784,"speaker":"奥莉娅·契科娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:28","scriptId":20125,"text":"“哈～哈～没事的啦～就当我自己突然跑到那个地方去了。”","background":"/art/stories/zjm-101.webp","left":680,"right":784,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20125:20125:29","scriptId":20125,"text":"奥莉娅很快就把舞装给穿戴好了……发现自己阻止不了奥莉娅，诺伊娜无可奈何地说道。","background":"/art/stories/zjm-101.webp","left":680,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:30","scriptId":20125,"text":"“好吧，不要太勉强，虽然可以带你去但只能跟在我身边！”","background":"/art/stories/zjm-101.webp","left":680,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":784,"speaker":"奥莉娅·契科娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20125:20125:31","scriptId":20125,"text":"“好的！”","background":"/art/stories/zjm-101.webp","left":680,"right":784,"section":0,"shake":false}],"summaries":[]}
