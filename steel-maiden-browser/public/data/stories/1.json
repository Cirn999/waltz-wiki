{"schemaVersion":1,"id":1,"sections":[{"id":"11-PROLOGUE","name":"第 1 战 · 战前","scripts":[5],"start":0,"count":47},{"id":"11-EPILOGUE","name":"第 1 战 · 战后","scripts":[6],"start":47,"count":13}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"11-PROLOGUE:5:1","scriptId":5,"text":"C国----花园大桥周边地区，现场直播中……","background":"/art/stories/zjm-084.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:2","scriptId":5,"text":"“咳咳，测试麦克风……”","background":"/art/stories/zjm-084.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:3","scriptId":5,"text":"“长官，已经开始了啦～”","background":"/art/stories/zjm-084.webp","left":4,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:4","scriptId":5,"text":"“哦哦……各位观众，大家好，这里是卫星专场。”","background":"/art/stories/zjm-084.webp","left":4,"right":31,"section":0,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:5","scriptId":5,"text":"“今天要放什么卫星？”","background":"/art/stories/zjm-084.webp","left":4,"right":81,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:6","scriptId":5,"text":"“不用着急，马上就会公布的～”","background":"/art/stories/zjm-084.webp","left":4,"right":81,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:7","scriptId":5,"text":"“呃……长官，您的制服好像透露了一个非常大的秘密……”","background":"/art/stories/zjm-084.webp","left":4,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:8","scriptId":5,"text":"“去去……台下的别插嘴，一边凉快去。”","background":"/art/stories/zjm-084.webp","left":4,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:9","scriptId":5,"text":"“……”","background":"/art/stories/zjm-084.webp","left":4,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:11","scriptId":5,"text":"“今天主要是来为大家介绍下目前最受人瞩目的卫星角色——”","background":"/art/stories/zjm-084.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:14","scriptId":5,"text":"“这位就是59式，C国制造的精锐钢舞姬，目前还没有批准正式加入胜利女神特勤局。”","background":"/art/stories/zjm-084.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:15","scriptId":5,"text":"“说到59式，那就必须要说S国的T-54了，简直是钢舞姬中的绝对代表，战斗能力拔群，可靠又耐用。”","background":"/art/stories/zjm-084.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"notice","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","item":"/art/stories/tx-520.webp","id":"11-PROLOGUE:5:16","scriptId":5,"text":"T-54","background":"/art/stories/zjm-084.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:17","scriptId":5,"text":"“现在想想，其实介绍T-54……”","background":"/art/stories/zjm-084.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":370,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:19","scriptId":5,"text":"“这位指挥官……您的楼歪了，快给我掰回来，好吗～”","background":"/art/stories/zjm-084.webp","left":4,"right":370,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"11-PROLOGUE:5:20","scriptId":5,"text":"感到脑门后面有股凉气……回头一看……","background":"/art/stories/zjm-084.webp","left":4,"right":370,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:21","scriptId":5,"text":"“女侠，我们有话好好说～放下您的105MM大炮……”","background":"/art/stories/zjm-084.webp","left":4,"right":370,"section":0,"shake":false},{"kind":"dialogue","head":370,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:22","scriptId":5,"text":"“那就看你表现了～”","background":"/art/stories/zjm-084.webp","left":4,"right":370,"section":0,"shake":false},{"kind":"dialogue","head":370,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:23","scriptId":5,"text":"“另外，不要装逼说英文，好吗～我的舞装编号是59式，不要用老外起的名字叫我！”","background":"/art/stories/zjm-084.webp","left":4,"right":370,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:24","scriptId":5,"text":"（嗯，冷静……保持冷静……既然装了逼绝对就不能轻易退缩……）","background":"/art/stories/zjm-084.webp","left":4,"right":370,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:25","scriptId":5,"text":"“那个……说到59式的特色，摄影师来个特写！”","background":"/art/stories/zjm-084.webp","left":4,"right":370,"section":0,"shake":false},{"kind":"notice","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","item":"/art/stories/djtx-002.webp","id":"11-PROLOGUE:5:26","scriptId":5,"text":"59式履带特写","background":"/art/stories/zjm-084.webp","left":4,"right":370,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:28","scriptId":5,"text":"“看到了没有！五对负重轮啊！这可是货真价实的五对负重轮！童叟无欺～”","background":"/art/stories/zjm-084.webp","left":4,"right":370,"section":0,"shake":false},{"kind":"dialogue","head":366,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:29","scriptId":5,"text":"“不要老拍人家的脚啊！给个正面镜头好吗？”","background":"/art/stories/zjm-084.webp","left":4,"right":366,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:30","scriptId":5,"text":"“包子头有什么好看的，不就能跳弹么，59式的特点不是负重轮吗？”","background":"/art/stories/zjm-084.webp","left":4,"right":366,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"11-PROLOGUE:5:34","scriptId":5,"text":"摄影师炸了……","background":"/art/stories/zjm-084.webp","left":4,"right":366,"section":0,"shake":true},{"kind":"dialogue","head":370,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:35","scriptId":5,"text":"“啊呀，不小心走火了～”","background":"/art/stories/zjm-084.webp","left":4,"right":370,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:36","scriptId":5,"text":"（我靠！估计再这样下去我会有生命危险的……）","background":"/art/stories/zjm-084.webp","left":4,"right":370,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:37","scriptId":5,"text":"“咳哼……那个……时间宝贵，我们直奔主题，这次是为了让大家了解59式的实战能力，所以特地来次实战演习。”","background":"/art/stories/zjm-084.webp","left":4,"right":370,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:38","scriptId":5,"text":"“附带一提，对手可是大有来头的特邀嘉宾哟～”","background":"/art/stories/zjm-084.webp","left":4,"right":370,"section":0,"shake":false},{"kind":"dialogue","head":372,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:39","scriptId":5,"text":"“还真是有点小紧张呢～那么我的对手呢？”","background":"/art/stories/zjm-084.webp","left":4,"right":372,"section":0,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"11-PROLOGUE:5:40","scriptId":5,"text":"“哼哼，在这里！”","background":"/art/stories/zjm-084.webp","left":48,"right":372,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"11-PROLOGUE:5:41","scriptId":5,"text":"从舞台对面出现了本次请来的特邀嘉宾。","background":"/art/stories/zjm-084.webp","left":48,"right":372,"section":0,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"11-PROLOGUE:5:42","scriptId":5,"text":"“就让我来当你的对手吧～看上去很好玩的样子～”","background":"/art/stories/zjm-084.webp","left":48,"right":372,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"11-PROLOGUE:5:43","scriptId":5,"text":"“埃普西隆，你已经给我们丢过脸了，所以这次还是我来吧。”","background":"/art/stories/zjm-084.webp","left":48,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"11-PROLOGUE:5:44","scriptId":5,"text":"“哼，那时只不过是小失误而已啦。”","background":"/art/stories/zjm-084.webp","left":48,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"11-PROLOGUE:5:45","scriptId":5,"text":"“等等……你们两个的戏份太多了，也让我亮个相吧～”","background":"/art/stories/zjm-084.webp","left":48,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"11-PROLOGUE:5:46","scriptId":5,"text":"“有你们这讨论的时间，战斗都打完了……不管是谁，快点上吧。”","background":"/art/stories/zjm-084.webp","left":400,"right":411,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"11-PROLOGUE:5:47","scriptId":5,"text":"（这堆人每次聚在一起就会好吵……）","background":"/art/stories/zjm-084.webp","left":400,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"11-PROLOGUE:5:48","scriptId":5,"text":"“一个个都那么放肆！我都没发话，你们在那里吵什么吵！这次必须由本座亲自出马。”","background":"/art/stories/zjm-084.webp","left":421,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:49","scriptId":5,"text":"“那到底谁上啊……？”","background":"/art/stories/zjm-084.webp","left":421,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":368,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:50","scriptId":5,"text":"“吵吵嚷嚷的，烦死了，让她们一起上吧～”","background":"/art/stories/zjm-084.webp","left":368,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:51","scriptId":5,"text":"“诶！？一起上？你确定？？”","background":"/art/stories/zjm-084.webp","left":368,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":370,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:52","scriptId":5,"text":"“恩，没问题的，放心吧～”","background":"/art/stories/zjm-084.webp","left":370,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:53","scriptId":5,"text":"“既然你这么说了……”","background":"/art/stories/zjm-084.webp","left":370,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"11-PROLOGUE:5:54","scriptId":5,"text":"“真是初生牛犊不怕虎啊，等会儿不要哭。”","background":"/art/stories/zjm-084.webp","left":48,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":368,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-PROLOGUE:5:55","scriptId":5,"text":"“你们还真是什么都不懂啊～让我来教教你们什么叫差距～”","background":"/art/stories/zjm-084.webp","left":48,"right":368,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"11-EPILOGUE:6:1","scriptId":6,"text":"经过一场“激烈？”的角逐，分出了胜负。","background":"/art/stories/zjm-084.webp","left":48,"right":368,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-EPILOGUE:6:2","scriptId":6,"text":"（我靠，这分明是一边倒……这能力也实在太逆天了，必须和谐！）","background":"/art/stories/zjm-084.webp","left":48,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":368,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-EPILOGUE:6:3","scriptId":6,"text":"“哎……只有这点本事吗？连热身都谈不上啊～实在是太渣渣了～”","background":"/art/stories/zjm-084.webp","left":368,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":47,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"11-EPILOGUE:6:4","scriptId":6,"text":"“什么！？不要太得意了，我还没拿出真本事呢！”","background":"/art/stories/zjm-084.webp","left":368,"right":47,"section":1,"shake":false},{"kind":"dialogue","head":370,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-EPILOGUE:6:5","scriptId":6,"text":"“啊，不好意思，我这话不是说你一个，我是说你们各位都是渣渣。”","background":"/art/stories/zjm-084.webp","left":370,"right":47,"section":1,"shake":false},{"kind":"dialogue","head":420,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"11-EPILOGUE:6:6","scriptId":6,"text":"“呵呵呵呵……胆子真不小，放放水还当真了！”","background":"/art/stories/zjm-084.webp","left":370,"right":420,"section":1,"shake":false},{"kind":"dialogue","head":410,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"11-EPILOGUE:6:7","scriptId":6,"text":"“看来今天必须灭了你个小妮子！”","background":"/art/stories/zjm-084.webp","left":370,"right":410,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"11-EPILOGUE:6:8","scriptId":6,"text":"“呃……各位观众们，看来第二场战斗在所难免，我先找个地方避避去了……”","background":"/art/stories/zjm-084.webp","left":4,"right":410,"section":1,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"11-EPILOGUE:6:9","scriptId":6,"text":"“诶！？长官，等等我！”","background":"/art/stories/zjm-084.webp","left":4,"right":41,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"11-EPILOGUE:6:16","scriptId":6,"text":"瞬时间炮声如雷霆般响亮，此起彼伏，整个会场尘土飞扬。","background":"/art/stories/zjm-084.webp","left":null,"right":null,"section":1,"shake":true},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"11-EPILOGUE:6:17","scriptId":6,"text":"（全剧终）","background":"/art/stories/zjm-084.webp","left":null,"right":null,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"11-EPILOGUE:6:19","scriptId":6,"text":"各位看官们，目前59式卫星已经进入发射轨道，但是距离落地还有一段不长不短的时间……","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"11-EPILOGUE:6:20","scriptId":6,"text":"介于59式的战斗能力实在太过强悍，大家是不是觉得应该先把这个卫星射到银河系之外会比较好？？","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":1,"shake":false}],"summaries":[]}
