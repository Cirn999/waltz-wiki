{"schemaVersion":1,"id":-40007,"sections":[{"id":"script-20007","name":"原始脚本 20007","scripts":[20007],"start":0,"count":17}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20007:20007:1","scriptId":20007,"text":"由于任务的内容有临时追加，所以作战的方针有比较明显的变化。","background":"/art/stories/zdbjbz-16.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20007:20007:2","scriptId":20007,"text":"“从你们的方向往前一百公里，有一组不明数据，最好过去清理一下。","background":"/art/stories/zdbjbz-16.webp","left":null,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20007:20007:3","scriptId":20007,"text":"“一百公里……这可要很久才能到啊……”","background":"/art/stories/zdbjbz-16.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20007:20007:4","scriptId":20007,"text":"“这样啊～稍等，我给你们重新定一下地理位置～”","background":"/art/stories/zdbjbz-16.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20007:20007:6","scriptId":20007,"text":"过了大致五分钟后，突然感到一阵头晕……眼前的景象开始变得模糊。","background":"/art/stories/zdbjbz-16.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20007:20007:7","scriptId":20007,"text":"等到醒来的时候……","background":"/art/stories/zdbjbz-16.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20007:20007:8","scriptId":20007,"text":"“长官……我们已经到了。”","background":"/art/stories/zdbjbz-16.webp","left":584,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20007:20007:9","scriptId":20007,"text":"“诶！？”","background":"/art/stories/zdbjbz-16.webp","left":584,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20007:20007:10","scriptId":20007,"text":"“前方五百米左右，已经能看到一些不明生物了……”","background":"/art/stories/zdbjbz-16.webp","left":584,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20007:20007:11","scriptId":20007,"text":"“呜咻～那个是什么？好像是个美女哟～”","background":"/art/stories/zdbjbz-16.webp","left":584,"right":574,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20007:20007:12","scriptId":20007,"text":"我拿起望远镜——随后不由得倒抽一口冷气。","background":"/art/stories/zdbjbz-16.webp","left":584,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20007:20007:13","scriptId":20007,"text":"“埃普西隆……”","background":"/art/stories/zdbjbz-16.webp","left":4,"right":574,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20007:20007:14","scriptId":20007,"text":"只看到埃普西隆他们正在和钢舞姬战斗的样子……","background":"/art/stories/zdbjbz-16.webp","left":4,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20007:20007:15","scriptId":20007,"text":"“诶？已经有人在战斗了啊……”","background":"/art/stories/zdbjbz-16.webp","left":4,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20007:20007:16","scriptId":20007,"text":"“那个是我设置的防御程式，虽然有启动，但是效果不太好啊，看上去马上要被清理掉了嘛……上去支援吧。”","background":"/art/stories/zdbjbz-16.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20007:20007:17","scriptId":20007,"text":"“好的……”","background":"/art/stories/zdbjbz-16.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20007:20007:18","scriptId":20007,"text":"（嘿嘿……能拿到这种意外数据真是让我好兴奋啊～）","background":"/art/stories/zdbjbz-16.webp","left":4,"right":608,"section":0,"shake":false}],"summaries":[]}
