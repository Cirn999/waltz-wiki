{"schemaVersion":1,"id":-40475,"sections":[{"id":"script-20475","name":"原始脚本 20475","scripts":[20475],"start":0,"count":47}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:0","scriptId":20475,"text":"两个人影出现在某小镇的入口。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":992,"speaker":"蕾莎·亨特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:1","scriptId":20475,"text":"“呼，终于到了这个边境小镇了……今天有床睡了～”","background":"/art/stories/zjm-047.webp","left":992,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:2","scriptId":20475,"text":"“不好说啊，看上去这个镇子可能有不少问题。”","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:3","scriptId":20475,"text":"小镇的街道上没有什么行人，只有几个老人正坐在躺椅上，呆呆地望着天空。","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":992,"speaker":"蕾莎·亨特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:4","scriptId":20475,"text":"“是吗？这不是和一般的镇子没区别吗？虽然多少有点被战车兽袭击过的迹象。”","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:5","scriptId":20475,"text":"“总之先调查下吧。”","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":992,"speaker":"蕾莎·亨特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:6","scriptId":20475,"text":"“是是……”","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:7","scriptId":20475,"text":"蕾莎把披在身上的军用斗篷拿了下来，","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:8","scriptId":20475,"text":"没想到这个动作立刻吸引到了那几个老人的注意。","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":992,"speaker":"蕾莎·亨特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:9","scriptId":20475,"text":"“诶诶诶！？？”","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:10","scriptId":20475,"text":"看到一群年过古稀的老人朝自己奔来，这不由得把蕾莎吓了一大跳。","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:11","scriptId":20475,"text":"她反射性地往后跳了一步。","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":992,"speaker":"蕾莎·亨特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:12","scriptId":20475,"text":"“这都是什么情况！？？”","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:13","scriptId":20475,"text":"“雷娅别激动，看他们说些什么。”","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:14","scriptId":20475,"text":"蒂娅挺直了身子，站到了蕾莎前面。","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:15","scriptId":20475,"text":"这时候那群老人已经来到了两位钢舞姬的面前。","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":1,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:16","scriptId":20475,"text":"“那个……你们是钢舞姬吧！是钢舞姬没错吧！！？？”","background":"/art/stories/zjm-047.webp","left":1,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:17","scriptId":20475,"text":"老人的眼睛里充满了惊讶和欣喜的神情，同时还夹杂着一些别的感情。","background":"/art/stories/zjm-047.webp","left":1,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:18","scriptId":20475,"text":"“是的。”","background":"/art/stories/zjm-047.webp","left":1,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":1,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:19","scriptId":20475,"text":"“感谢上帝！！真的是钢舞姬！！大伙快过来，有钢舞姬来救我们了！？”","background":"/art/stories/zjm-047.webp","left":1,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:20","scriptId":20475,"text":"经走上前来的老人这么一喊，又有更多的人从破败的房屋和小巷里走了出来，纷纷向蒂娅和蕾莎的方向聚集过来。","background":"/art/stories/zjm-047.webp","left":1,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":992,"speaker":"蕾莎·亨特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:21","scriptId":20475,"text":"“喂，我们确实是钢舞姬没错，不过我们不是来救你们的啊，只是路过罢了。”","background":"/art/stories/zjm-047.webp","left":1,"right":992,"section":0,"shake":false},{"kind":"dialogue","head":1,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:22","scriptId":20475,"text":"“什么！？”","background":"/art/stories/zjm-047.webp","left":1,"right":992,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:23","scriptId":20475,"text":"“蕾莎，不要多嘴。”","background":"/art/stories/zjm-047.webp","left":1,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":992,"speaker":"蕾莎·亨特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:24","scriptId":20475,"text":"“哼，我不过说了实话而已。”","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:25","scriptId":20475,"text":"蕾莎嘟了嘟嘴，摆出了一副不满的表情。","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:26","scriptId":20475,"text":"“不要着急，虽然我们只是路过的，但是如果有什么可以帮忙的话，一定会尽全力帮助你们的。”","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:27","scriptId":20475,"text":"听到蒂娅这么说，老人们纷纷展露出了放心的表情。","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":1,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:28","scriptId":20475,"text":"“那个是这样的……”","background":"/art/stories/zjm-047.webp","left":1,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:30","scriptId":20475,"text":"老人开始慢慢叙述这个小镇上发生的事情。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:31","scriptId":20475,"text":"这个镇子叫诺玛，在蒂娅和蕾莎来之前，这里曾遭受过战车兽的多次袭击。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:32","scriptId":20475,"text":"特勤局的钢舞姬来过这里，但是没有多久便以南边战势紧迫为由，撤出了这个小镇。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:33","scriptId":20475,"text":"考虑到长时间没有增援，大家猜想特勤局可能已经决定放弃了这个地方，很多镇民都开始盘算着离开这里。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:34","scriptId":20475,"text":"几周后相继有人开始陆续搬离这个镇子，但是很多年迈的老人们并不打算离开自己落叶生根的地方。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:35","scriptId":20475,"text":"他们又一次央求特勤局派军支援，但是自从那之后就一直没有过特勤局的消息。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:36","scriptId":20475,"text":"直到今天看到蒂娅和蕾莎的到来……","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":992,"speaker":"蕾莎·亨特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:37","scriptId":20475,"text":"“什么嘛，原来是特勤局那边留下的烂摊子啊。”","background":"/art/stories/zjm-047.webp","left":992,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:38","scriptId":20475,"text":"蕾莎没好气地说了一句。","background":"/art/stories/zjm-047.webp","left":992,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:39","scriptId":20475,"text":"“虽说这里地处偏远，但是特勤局应该不会轻易放弃这里，我想其中可能有什么蹊跷。”","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:40","scriptId":20475,"text":"“这位老伯，特勤局的钢舞姬来这里以后发生的事情能详细跟我说说吗？”","background":"/art/stories/zjm-047.webp","left":992,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":1,"speaker":"？？？","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:41","scriptId":20475,"text":"“好的。”","background":"/art/stories/zjm-047.webp","left":1,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:42","scriptId":20475,"text":"这下子更多的老人围了上来，每个人都七嘴八舌地把自己的所见所闻告诉给了蒂娅……","background":"/art/stories/zjm-047.webp","left":1,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":992,"speaker":"蕾莎·亨特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:44","scriptId":20475,"text":"“呼……仔细看了看，这个镇子还真没有年轻人的样子，难道都已经离开了吗？”","background":"/art/stories/zjm-047.webp","left":null,"right":992,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:45","scriptId":20475,"text":"趁着蒂娅吸引住了人群，蕾莎开始环顾起四周的情况。","background":"/art/stories/zjm-047.webp","left":null,"right":992,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:46","scriptId":20475,"text":"镇子不算很大，房屋也很陈旧，道路也只是简单的用石子铺了铺，周围还有一些农田。","background":"/art/stories/zjm-047.webp","left":null,"right":992,"section":0,"shake":false},{"kind":"dialogue","head":992,"speaker":"蕾莎·亨特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20475:20475:47","scriptId":20475,"text":"“不就是一般的乡下小镇嘛……”","background":"/art/stories/zjm-047.webp","left":null,"right":992,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20475:20475:48","scriptId":20475,"text":"蕾莎一边小声嘀咕一边继续往前走着。","background":"/art/stories/zjm-047.webp","left":null,"right":992,"section":0,"shake":false}],"summaries":[]}
