{"schemaVersion":1,"id":11,"sections":[{"id":"108004-PROLOGUE","name":"第 1 战 · 战前","scripts":[320,321,322,323],"start":0,"count":40},{"id":"108004-EPILOGUE","name":"第 1 战 · 战后","scripts":[10310],"start":40,"count":14},{"id":"108005-PROLOGUE","name":"第 2 战 · 战前","scripts":[330],"start":54,"count":8},{"id":"108005-EPILOGUE","name":"第 2 战 · 战后","scripts":[10320],"start":62,"count":5},{"id":"108006-PROLOGUE","name":"第 3 战 · 战前","scripts":[340],"start":67,"count":19},{"id":"108006-EPILOGUE","name":"第 3 战 · 战后","scripts":[10330],"start":86,"count":3}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:320:4","scriptId":320,"text":"耳畔传来一声巨响，地面也随之有些轻微震动。","background":"/art/stories/zdbjbz-07.webp","left":null,"right":null,"section":0,"shake":true},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:320:5","scriptId":320,"text":"“我们被袭击了！？小飞象出击！！！”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:320:6","scriptId":320,"text":"“……等，等，等”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:320:7","scriptId":320,"text":"我一把抓住正要冲出去的佐伊。","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:320:8","scriptId":320,"text":"“看看清楚敌人在哪里……你这种胡乱行动在战术课程里叫自我暴露，扣20分。”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:320:10","scriptId":320,"text":"不远处传来了战车兽的叫声。","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:320:11","scriptId":320,"text":"“看来和我们没什么关系，多半是实训演习的队伍。”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:320:12","scriptId":320,"text":"“虽说没什么关系，但是如果挡在我们行进的路上，就必须清除了。”","background":"/art/stories/zdbjbz-07.webp","left":61,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:320:13","scriptId":320,"text":"由于刚才的叫声，开始有不少战车兽闻风而来。","background":"/art/stories/zdbjbz-07.webp","left":61,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:320:14","scriptId":320,"text":"“……我们是被殃及的池鱼啊。”","background":"/art/stories/zdbjbz-07.webp","left":61,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:321:4","scriptId":321,"text":"耳畔传来一声巨响，地面也随之有些轻微震动。","background":"/art/stories/zdbjbz-07.webp","left":61,"right":3,"section":0,"shake":true},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:321:5","scriptId":321,"text":"“我们被袭击了！？小飞象出击！！！”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:321:6","scriptId":321,"text":"“……等，等，等”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:321:7","scriptId":321,"text":"我一把抓住正要冲出去的佐伊。","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:321:8","scriptId":321,"text":"“看看清楚敌人在哪里……你这种胡乱行动在战术课程里叫自我暴露，扣20分。”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:321:10","scriptId":321,"text":"不远处传来了战车兽的叫声。","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:321:11","scriptId":321,"text":"“看来和我们没什么关系，多半是实训演习的队伍。”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:321:12","scriptId":321,"text":"“但我觉得还是会有漏网之鱼的，这么大的地方，战车兽总会跑来跑去的。”","background":"/art/stories/zdbjbz-07.webp","left":1171,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:321:13","scriptId":321,"text":"由于刚才的叫声，开始有不少战车兽闻风而来。","background":"/art/stories/zdbjbz-07.webp","left":1171,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:321:14","scriptId":321,"text":"“……我们是被殃及的池鱼啊。”","background":"/art/stories/zdbjbz-07.webp","left":1171,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:322:4","scriptId":322,"text":"耳畔传来一声巨响，地面也随之有些轻微震动。","background":"/art/stories/zdbjbz-07.webp","left":1171,"right":3,"section":0,"shake":true},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:322:5","scriptId":322,"text":"“我们被袭击了！？小飞象出击！！！”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:322:6","scriptId":322,"text":"“……等，等，等”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:322:7","scriptId":322,"text":"我一把抓住正要冲出去的佐伊。","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:322:8","scriptId":322,"text":"“看看清楚敌人在哪里……你这种胡乱行动在战术课程里叫自我暴露，扣20分。”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:322:10","scriptId":322,"text":"不远处传来了战车兽的叫声。","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:322:11","scriptId":322,"text":"“看来和我们没什么关系，多半是实训演习的队伍。”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:322:12","scriptId":322,"text":"“这倒不一定，我好像感觉到周遭的骚动，应该是战车兽哦。”","background":"/art/stories/zdbjbz-07.webp","left":968,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:322:13","scriptId":322,"text":"由于刚才的叫声，开始有不少战车兽闻风而来。","background":"/art/stories/zdbjbz-07.webp","left":968,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:322:14","scriptId":322,"text":"“……我们是被殃及的池鱼啊。”","background":"/art/stories/zdbjbz-07.webp","left":968,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:323:4","scriptId":323,"text":"耳畔传来一声巨响，地面也随之有些轻微震动。","background":"/art/stories/zdbjbz-07.webp","left":968,"right":3,"section":0,"shake":true},{"kind":"dialogue","head":32,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:323:5","scriptId":323,"text":"“我们被袭击了！？小飞象出击！！！”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:323:6","scriptId":323,"text":"“……等，等，等”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:323:7","scriptId":323,"text":"我一把抓住正要冲出去的佐伊。","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:323:8","scriptId":323,"text":"“看看清楚敌人在哪里……你这种胡乱行动在战术课程里叫自我暴露，扣20分。”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:323:10","scriptId":323,"text":"不远处传来了战车兽的叫声。","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:323:11","scriptId":323,"text":"“看来和我们没什么关系，多半是实训演习的队伍。”","background":"/art/stories/zdbjbz-07.webp","left":32,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:323:12","scriptId":323,"text":"“多少有点影响，你看到不远处的灰尘了吗？是逃窜的战车兽。”","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-PROLOGUE:323:13","scriptId":323,"text":"由于刚才的叫声，开始有不少战车兽闻风而来。","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-PROLOGUE:323:14","scriptId":323,"text":"“……我们是被殃及的池鱼啊。”","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-EPILOGUE:10310:1","scriptId":10310,"text":"激战过后，硝烟散去。","background":"/art/stories/zdbjbz-07.webp","left":1158,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108004-EPILOGUE:10310:2","scriptId":10310,"text":"“呼……搞定，继续前进。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":3,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-EPILOGUE:10310:3","scriptId":10310,"text":"正要离开废墟中继站，被一个声音叫住了。","background":"/art/stories/zdbjbz-07.webp","left":3,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":124,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-EPILOGUE:10310:4","scriptId":10310,"text":"“你们是哪里的部队！？我怎么没见过你们？”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":124,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108004-EPILOGUE:10310:5","scriptId":10310,"text":"“事出有因，我们需要赶往伏龙芝学院。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":124,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-EPILOGUE:10310:6","scriptId":10310,"text":"我从怀里掏出指令信。","background":"/art/stories/zdbjbz-07.webp","left":3,"right":124,"section":1,"shake":false},{"kind":"dialogue","head":118,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-EPILOGUE:10310:7","scriptId":10310,"text":"“啊……是胜利女神特勤局的印章。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":118,"section":1,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-EPILOGUE:10310:8","scriptId":10310,"text":"“你好，长官，我是芙琳·勒布，所属猎户座小队，正在执行实训演习任务。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":115,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108004-EPILOGUE:10310:9","scriptId":10310,"text":"“恩，那你们继续。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":115,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108004-EPILOGUE:10310:10","scriptId":10310,"text":"刚想离开，但是反被芙琳一把拉住。","background":"/art/stories/zdbjbz-07.webp","left":3,"right":115,"section":1,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-EPILOGUE:10310:11","scriptId":10310,"text":"“长官，现在是实训演习，学院外围的战车兽比以往更加多，所以还请让我小队同行。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":115,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108004-EPILOGUE:10310:12","scriptId":10310,"text":"“好好好……先放手。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":115,"section":1,"shake":false},{"kind":"dialogue","head":119,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108004-EPILOGUE:10310:13","scriptId":10310,"text":"“啊……不好意思。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":119,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108004-EPILOGUE:10310:14","scriptId":10310,"text":"(好大的力气，胳膊感觉都要脱臼了……）","background":"/art/stories/zdbjbz-07.webp","left":3,"right":119,"section":1,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108005-PROLOGUE:330:2","scriptId":330,"text":"“先介绍一下，这是我小队的狙击手达利波娃·戈沃罗夫娜和主要攻击手丽达·詹姆士。”","background":"/art/stories/zdbjbz-07.webp","left":115,"right":119,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108005-PROLOGUE:330:3","scriptId":330,"text":"“恩恩，有劳大家了。”","background":"/art/stories/zdbjbz-07.webp","left":115,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":151,"speaker":"丽达·麦克阿瑟","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108005-PROLOGUE:330:4","scriptId":330,"text":"“Hello～长官。”","background":"/art/stories/zdbjbz-07.webp","left":151,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":135,"speaker":"达利波娃·戈沃罗夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108005-PROLOGUE:330:5","scriptId":330,"text":"“长官的队员们也是这个学院毕业的吧，那就是我们的前辈了咯？”","background":"/art/stories/zdbjbz-07.webp","left":135,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108005-PROLOGUE:330:6","scriptId":330,"text":"“哼哼～正是，我是佐伊，我在伏龙芝的事迹----","background":"/art/stories/zdbjbz-07.webp","left":135,"right":39,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108005-PROLOGUE:330:7","scriptId":330,"text":"“介绍就到这儿吧。继续赶路，我们天黑之前要到达伏龙芝学院的。”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":39,"section":2,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108005-PROLOGUE:330:8","scriptId":330,"text":"“遵命！”","background":"/art/stories/zdbjbz-07.webp","left":3,"right":115,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108005-PROLOGUE:330:9","scriptId":330,"text":"（真是讨厌，又打断我……）","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108005-EPILOGUE:10320:0","scriptId":10320,"text":"终于达到了伏龙芝军事学院。","background":"/art/stories/zdbjbz-07.webp","left":3,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108005-EPILOGUE:10320:2","scriptId":10320,"text":"“我去通报一下。”","background":"/art/stories/zjm-090.webp","left":115,"right":40,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108005-EPILOGUE:10320:3","scriptId":10320,"text":"“好的。”","background":"/art/stories/zjm-090.webp","left":115,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":127,"speaker":"达利波娃·戈沃罗夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108005-EPILOGUE:10320:4","scriptId":10320,"text":"“队长真是热心，做什么都是亲力亲为。”","background":"/art/stories/zjm-090.webp","left":127,"right":3,"section":3,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108005-EPILOGUE:10320:5","scriptId":10320,"text":"“是啊，某人形成鲜明对比～只会发号施令。”","background":"/art/stories/zjm-090.webp","left":127,"right":40,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108006-PROLOGUE:340:2","scriptId":340,"text":"终于到达了学院。","background":"/art/stories/zjm-090.webp","left":127,"right":40,"section":4,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:3","scriptId":340,"text":"“索菲亚教官已经在会议室等着各位了。”","background":"/art/stories/zjm-090.webp","left":115,"right":40,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:4","scriptId":340,"text":"“好的，谢谢。”","background":"/art/stories/zjm-090.webp","left":115,"right":3,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108006-PROLOGUE:340:5","scriptId":340,"text":"和猎户座小队就此别过以后，我们赶赴会议室。","background":"/art/stories/zjm-090.webp","left":115,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":213,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:7","scriptId":340,"text":"“好久不见啊～我的学生们～”","background":"/art/stories/zjm-047.webp","left":213,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:8","scriptId":340,"text":"“别来无恙啊，索菲亚教授。”","background":"/art/stories/zjm-047.webp","left":213,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:9","scriptId":340,"text":"“好，好久不见……索菲亚教授……”","background":"/art/stories/zjm-047.webp","left":213,"right":40,"section":4,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:10","scriptId":340,"text":"“别老教授教授的……，还是叫我教官吧，习惯了。”","background":"/art/stories/zjm-047.webp","left":211,"right":40,"section":4,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:11","scriptId":340,"text":"“接下来进入主题吧，时间宝贵，大致情况我已经了解。”","background":"/art/stories/zjm-047.webp","left":211,"right":40,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:12","scriptId":340,"text":"“那教官对那人形怪物的看法是什么？”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:13","scriptId":340,"text":"“看法就是一切都是谜～”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:14","scriptId":340,"text":"“哈！！？？”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:15","scriptId":340,"text":"“确切的说，光从报告上来看，完全没有头绪，所以需要你们的协力咯。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:16","scriptId":340,"text":"“也就是说，你们下一个任务是返回现场，寻找线索。注意不要被人形怪物发现哦～”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:17","scriptId":340,"text":"“……，您确定？那可是非常危险的。”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:18","scriptId":340,"text":"“还有什么问题吗？”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:19","scriptId":340,"text":"“没，没有了……”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":222,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:20","scriptId":340,"text":"“那就散会，明天一早就给我出发！”","background":"/art/stories/zjm-047.webp","left":222,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108006-PROLOGUE:340:21","scriptId":340,"text":"（果然是魔鬼……）","background":"/art/stories/zjm-047.webp","left":222,"right":40,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108006-EPILOGUE:10330:1","scriptId":10330,"text":"没有办法，只能再返回一次齐格菲研究所了。","background":"/art/stories/zjm-090.webp","left":222,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108006-EPILOGUE:10330:2","scriptId":10330,"text":"“索菲亚教官雷厉风行的性格还是没变啊……”","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108006-EPILOGUE:10330:3","scriptId":10330,"text":"“感觉又被卷进大麻烦了……”","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":5,"shake":false}],"summaries":["离开中继站，继续向着伏龙芝学院进发。","由于有了猎户座小队的护送，一路上顺畅了更多。","平安无事到达伏龙芝学院，先去见见索菲亚教授吧。"]}
