{"schemaVersion":1,"id":-40474,"sections":[{"id":"script-20474","name":"原始脚本 20474","scripts":[20474],"start":0,"count":83}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:1","scriptId":20474,"text":"","background":"/art/stories/zjm-066.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:2","scriptId":20474,"text":"“欢迎来到《GirlsTalk》，今天是本节目的第一期——","background":"/art/stories/zjm-066.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:3","scriptId":20474,"text":"“请看看标题再出来，这里没你什么事情，导演说你可以走了～”","background":"/art/stories/zjm-066.webp","left":4,"right":786,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:4","scriptId":20474,"text":"“？？？”","background":"/art/stories/zjm-066.webp","left":4,"right":786,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:5","scriptId":20474,"text":"塞西尔一把夺过话筒，顺势给我来了个回旋踢。","background":"/art/stories/zjm-066.webp","left":4,"right":786,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:6","scriptId":20474,"text":"“哇！！？？”","background":"/art/stories/zjm-066.webp","left":4,"right":786,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:8","scriptId":20474,"text":"“真是个不识趣的家伙。”","background":"/art/stories/zjm-066.webp","left":null,"right":786,"section":0,"shake":false},{"kind":"dialogue","head":788,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:10","scriptId":20474,"text":"“好了，碍事的人已经滚蛋了，这次就由我——人见人爱花见花开的塞西尔·霞飞来为大家主持～”","background":"/art/stories/zjm-066.webp","left":788,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:11","scriptId":20474,"text":"“接下来就介绍一下来宾吧。”","background":"/art/stories/zjm-066.webp","left":786,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":748,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:12","scriptId":20474,"text":"“诶嘿嘿～我是佐伊·谢尔曼，大家好——”","background":"/art/stories/zjm-066.webp","left":786,"right":748,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:13","scriptId":20474,"text":"（不是长官主持，有点不太习惯啊……）","background":"/art/stories/zjm-066.webp","left":786,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":792,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:14","scriptId":20474,"text":"“好了，女主角就介绍到这里了，毕竟大家平常都有见面，没什么可介绍的。”","background":"/art/stories/zjm-066.webp","left":792,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":749,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:15","scriptId":20474,"text":"“诶！？”","background":"/art/stories/zjm-066.webp","left":792,"right":749,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:16","scriptId":20474,"text":"“有请第二位。”","background":"/art/stories/zjm-066.webp","left":786,"right":749,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:17","scriptId":20474,"text":"“我是佩妮·谢尔曼，佐伊的妹妹。”","background":"/art/stories/zjm-066.webp","left":786,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:18","scriptId":20474,"text":"“没想到前两位嘉宾竟然是姐妹关系啊，请入座吧。”","background":"/art/stories/zjm-066.webp","left":786,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:19","scriptId":20474,"text":"“谢谢。”","background":"/art/stories/zjm-066.webp","left":786,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:20","scriptId":20474,"text":"“接下来两位分别是奈特莉、尤拉和维卡。”","background":"/art/stories/zjm-066.webp","left":786,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:21","scriptId":20474,"text":"“哟吼～我是奈特莉·勒克莱尔，大家好～”","background":"/art/stories/zjm-066.webp","left":786,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":730,"speaker":"尤拉·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:22","scriptId":20474,"text":"“哼哼～我是尤拉·波尔舍～。”","background":"/art/stories/zjm-066.webp","left":786,"right":730,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:23","scriptId":20474,"text":"“嗯？怎么少了一个？维卡呢？”","background":"/art/stories/zjm-066.webp","left":786,"right":730,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:24","scriptId":20474,"text":"“啊哈哈……维卡她拒绝参加这种活动……”","background":"/art/stories/zjm-066.webp","left":786,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:25","scriptId":20474,"text":"“……”","background":"/art/stories/zjm-066.webp","left":786,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":792,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:26","scriptId":20474,"text":"“……好吧，可爱的塞西尔不介意这小小的意外。”","background":"/art/stories/zjm-066.webp","left":792,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:28","scriptId":20474,"text":"“好了，各位都入座了，那么我们开始今天的主题吧。”","background":"/art/stories/zjm-066.webp","left":786,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:29","scriptId":20474,"text":"“啪啪啪——”","background":"/art/stories/zjm-066.webp","left":786,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:30","scriptId":20474,"text":"塞西尔拍响清脆的掌声，与此同时身后的大荧幕缓缓地降了下来。","background":"/art/stories/zjm-066.webp","left":786,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:31","scriptId":20474,"text":"（怪不得导演让我把指挥官踹走，原来是这么回事……）","background":"/art/stories/zjm-066.webp","left":786,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":749,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:32","scriptId":20474,"text":"“呃……这个主题有点……”","background":"/art/stories/zjm-066.webp","left":786,"right":749,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:33","scriptId":20474,"text":"“……”","background":"/art/stories/zjm-066.webp","left":584,"right":749,"section":0,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:34","scriptId":20474,"text":"“哦呀呀～这可真是个有意思的主题啊～不过为什么要选我呢？”","background":"/art/stories/zjm-066.webp","left":584,"right":582,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:35","scriptId":20474,"text":"“这答案很简单嘛～”","background":"/art/stories/zjm-066.webp","left":728,"right":582,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:36","scriptId":20474,"text":"众嘉宾反映各异，原来荧幕上写的是——“请描述一下对自己长官的看法”","background":"/art/stories/zjm-066.webp","left":728,"right":582,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:37","scriptId":20474,"text":"“回答顺序的话，就抽签开始吧～”","background":"/art/stories/zjm-066.webp","left":728,"right":786,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:38","scriptId":20474,"text":"塞西尔拿出四根签条，让佐伊她们按顺序抽选。","background":"/art/stories/zjm-066.webp","left":728,"right":786,"section":0,"shake":false},{"kind":"dialogue","head":749,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:39","scriptId":20474,"text":"“呃……三号。”","background":"/art/stories/zjm-066.webp","left":749,"right":786,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:40","scriptId":20474,"text":"“四……”","background":"/art/stories/zjm-066.webp","left":749,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:41","scriptId":20474,"text":"“我是二号～”","background":"/art/stories/zjm-066.webp","left":572,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:42","scriptId":20474,"text":"“一号～拔得头筹～”","background":"/art/stories/zjm-066.webp","left":572,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:43","scriptId":20474,"text":"“那么我们就开始吧～”","background":"/art/stories/zjm-066.webp","left":786,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:44","scriptId":20474,"text":"“长官嘛～英姿飒爽、玉树临风、足智多谋、一举一动都充满着魅力，知识渊博又见多识广，礼节方面也非常绅士——","background":"/art/stories/zjm-066.webp","left":786,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:45","scriptId":20474,"text":"“虽然共事时间不长但是给人一种很可靠的感觉，我想崇拜长官的人肯定多得数不胜数，还有——”","background":"/art/stories/zjm-066.webp","left":786,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:46","scriptId":20474,"text":"“停！”","background":"/art/stories/zjm-066.webp","left":786,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:47","scriptId":20474,"text":"“？？？”","background":"/art/stories/zjm-066.webp","left":786,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:48","scriptId":20474,"text":"“我还没说完呢？”","background":"/art/stories/zjm-066.webp","left":786,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":794,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:49","scriptId":20474,"text":"“你的意思已经很明确地传达给我了～”","background":"/art/stories/zjm-066.webp","left":794,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:50","scriptId":20474,"text":"“也行吧～说多了增加竞争对手可不好。”","background":"/art/stories/zjm-066.webp","left":794,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:51","scriptId":20474,"text":"“……”","background":"/art/stories/zjm-066.webp","left":786,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:52","scriptId":20474,"text":"“那么接下来，奈特莉呢？”","background":"/art/stories/zjm-066.webp","left":786,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:53","scriptId":20474,"text":"“关于长官啊～我想想……”","background":"/art/stories/zjm-066.webp","left":786,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:54","scriptId":20474,"text":"“人很聪明这个我是承认的～在战术指挥上也是很有才干，只不过偶尔会有犹豫不决的时候，这可是扣分点啊～”","background":"/art/stories/zjm-066.webp","left":786,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:55","scriptId":20474,"text":"“而且长官最近女难之相比较严重，再加悠游寡断，那可真是灾难啊～”","background":"/art/stories/zjm-066.webp","left":786,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:56","scriptId":20474,"text":"“哦哦。”","background":"/art/stories/zjm-066.webp","left":786,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:57","scriptId":20474,"text":"（总算是个正常点的了。）","background":"/art/stories/zjm-066.webp","left":786,"right":572,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:58","scriptId":20474,"text":"镜头转向佐伊。","background":"/art/stories/zjm-066.webp","left":786,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":794,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:59","scriptId":20474,"text":"“让我们来听听佐伊的看法吧～”","background":"/art/stories/zjm-066.webp","left":794,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":749,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:60","scriptId":20474,"text":"“哼，长官有什么好的，虽然精明能干这点没错，但却总是喜欢耍小聪明把别人当傻瓜。”","background":"/art/stories/zjm-066.webp","left":794,"right":749,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:61","scriptId":20474,"text":"“作为军人出身，体力却很差，干不了重活，还经常要我们帮忙。”","background":"/art/stories/zjm-066.webp","left":794,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:62","scriptId":20474,"text":"“睡觉喜欢打呼噜，还有爱偷懒的毛病，不过爱偷懒这点最近已经好了不少，但你不盯着他肯定又会找机会偷懒的。”","background":"/art/stories/zjm-066.webp","left":794,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:63","scriptId":20474,"text":"“恩，这可真是重要的评价啊，谢谢你的发言。”","background":"/art/stories/zjm-066.webp","left":786,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:64","scriptId":20474,"text":"“嘿嘿～”","background":"/art/stories/zjm-066.webp","left":786,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:65","scriptId":20474,"text":"（呃……基本都是负面评价……但如果不是很了解长官的话，应该是说不出那么多毛病的吧……）","background":"/art/stories/zjm-066.webp","left":786,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":794,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:66","scriptId":20474,"text":"“那接下来就是最后的佩妮小姐了。”","background":"/art/stories/zjm-066.webp","left":794,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:67","scriptId":20474,"text":"“恩，长官的优点和缺点都已经分别让姐姐和尤拉说光了，我就补充一下我个人的看法吧。”","background":"/art/stories/zjm-066.webp","left":794,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:68","scriptId":20474,"text":"“长官在大局观上有点模糊，特别是对待旅行者的时候。”","background":"/art/stories/zjm-066.webp","left":794,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:69","scriptId":20474,"text":"“不过这并不是批评，长官喜欢平和的处事方针这点我觉得还是很有远见的，毕竟凡事只靠战争是解决不了争端的。”","background":"/art/stories/zjm-066.webp","left":794,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:70","scriptId":20474,"text":"“哇～佩妮真是非常理性的发言呢，没想到会得到这样的答案呢～”","background":"/art/stories/zjm-066.webp","left":786,"right":584,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:71","scriptId":20474,"text":"这时，塞西尔看了看时间。","background":"/art/stories/zjm-066.webp","left":786,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:72","scriptId":20474,"text":"“恩，时间也差不多了～那么今天谢谢各位的参与，之后我们制作组会送特别的礼物给你们～”","background":"/art/stories/zjm-066.webp","left":786,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:73","scriptId":20474,"text":"“哦哦～那就谢谢啦～”","background":"/art/stories/zjm-066.webp","left":786,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:76","scriptId":20474,"text":"节目结束后","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:77","scriptId":20474,"text":"“嘻嘻嘻～估计这次节目效果不错～”","background":"/art/stories/zdjm-034.webp","left":786,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:78","scriptId":20474,"text":"在走廊的转角处，突然——","background":"/art/stories/zdjm-034.webp","left":786,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:79","scriptId":20474,"text":"“咚”","background":"/art/stories/zdjm-034.webp","left":786,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:80","scriptId":20474,"text":"塞西尔不小心和什么人撞了个满怀。","background":"/art/stories/zdjm-034.webp","left":786,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:81","scriptId":20474,"text":"“诶呦，不好意思啊，我走路忘记看前面了。”","background":"/art/stories/zdjm-034.webp","left":786,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:82","scriptId":20474,"text":"“没关系～”","background":"/art/stories/zdjm-034.webp","left":786,"right":223,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:83","scriptId":20474,"text":"“那么，我赶时间。”","background":"/art/stories/zdjm-034.webp","left":786,"right":223,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:84","scriptId":20474,"text":"塞西尔打了个招呼之后匆忙离开。","background":"/art/stories/zdjm-034.webp","left":786,"right":223,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:86","scriptId":20474,"text":"“哎呀呀～虽然在物归原主前偷看里面的内容有点不太好，但这本小册子上记录的东西真有趣～”","background":"/art/stories/zdjm-034.webp","left":null,"right":223,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20474:20474:87","scriptId":20474,"text":"“原来大家都是这么看待长官的啊～”","background":"/art/stories/zdjm-034.webp","left":null,"right":223,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:88","scriptId":20474,"text":"蕾贝卡手里拿着的正是塞西尔掉落的笔记本……","background":"/art/stories/zdjm-034.webp","left":null,"right":223,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20474:20474:90","scriptId":20474,"text":"…………待续？？","background":"/art/stories/zdjm-034.webp","left":null,"right":null,"section":0,"shake":false}],"summaries":[]}
