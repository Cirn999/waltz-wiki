{"schemaVersion":1,"id":303,"sections":[{"id":"607001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20501],"start":0,"count":42},{"id":"607001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20502],"start":42,"count":17}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607001-PROLOGUE:20501:1","scriptId":20501,"text":"一周后，死水大厅中","background":"/art/stories/zjm-099.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:2","scriptId":20501,"text":"“今天这是有什么事情啊？”","background":"/art/stories/zjm-099.webp","left":740,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:3","scriptId":20501,"text":"“还不清楚，昨天被通知如果手头没有任务的话，今天就要去团长室报到一下。”","background":"/art/stories/zjm-099.webp","left":740,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:4","scriptId":20501,"text":"“难道是因为这个月的份额没做到，让我们去做些追加任务？”","background":"/art/stories/zjm-099.webp","left":591,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:5","scriptId":20501,"text":"“应该不会吧，我们这个月才过一半，按我们目前的进度还是绰绰有余的。”","background":"/art/stories/zjm-099.webp","left":572,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:6","scriptId":20501,"text":"“嗯……猜也猜不出，我最近也没犯什么事情才对……”","background":"/art/stories/zjm-099.webp","left":572,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:7","scriptId":20501,"text":"“如果是长官犯事的话，应该不至于让我们全队都过去。”","background":"/art/stories/zjm-099.webp","left":584,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:8","scriptId":20501,"text":"“佩妮……你这说法真是让我高兴不起来啊……”","background":"/art/stories/zjm-099.webp","left":584,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:9","scriptId":20501,"text":"“时间差不多了。”","background":"/art/stories/zjm-099.webp","left":596,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607001-PROLOGUE:20501:10","scriptId":20501,"text":"这时在一旁默不作声的维卡提醒我们可以出发了。","background":"/art/stories/zjm-099.webp","left":596,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607001-PROLOGUE:20501:13","scriptId":20501,"text":"来到了死水团长室。","background":"/art/stories/zjm-098.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607001-PROLOGUE:20501:14","scriptId":20501,"text":"一进门就看到了副团长蒂娅，而团长维多利亚还是一如既往地坐在她那办公桌前。","background":"/art/stories/zjm-098.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:15","scriptId":20501,"text":"“哟，来了啊，你们是最后一组了，我就长话短说了。”","background":"/art/stories/zjm-098.webp","left":980,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:16","scriptId":20501,"text":"“？？？”","background":"/art/stories/zjm-098.webp","left":980,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607001-PROLOGUE:20501:17","scriptId":20501,"text":"虽然一开始没有进入状况，但随着蒂娅的讲解，我们很快就理解了这次召集我们的缘由。","background":"/art/stories/zjm-098.webp","left":980,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:18","scriptId":20501,"text":"“都听懂了吗？”","background":"/art/stories/zjm-098.webp","left":980,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:19","scriptId":20501,"text":"“呃……就是说把散落的信号旗都回收掉就行了吧？”","background":"/art/stories/zjm-098.webp","left":980,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:20","scriptId":20501,"text":"“是的，如果按特定的组合上交的话，还可以得到额外的奖励哟～”","background":"/art/stories/zjm-098.webp","left":980,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:21","scriptId":20501,"text":"“特定组合是什么意思？”","background":"/art/stories/zjm-098.webp","left":980,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:22","scriptId":20501,"text":"“这个么～就看维多利亚的心情了～”","background":"/art/stories/zjm-098.webp","left":980,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:23","scriptId":20501,"text":"“虽然特定组合不多，但会有很多提示给你们的，自己留心多观察。”","background":"/art/stories/zjm-098.webp","left":547,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:24","scriptId":20501,"text":"“看来不是单纯的回收任务？”","background":"/art/stories/zjm-098.webp","left":547,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:25","scriptId":20501,"text":"“咳哼，正是如此。”","background":"/art/stories/zjm-098.webp","left":547,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:26","scriptId":20501,"text":"“对了，忘了说，区域里的队伍可以互相攻击，争夺旗帜。”","background":"/art/stories/zjm-098.webp","left":980,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:27","scriptId":20501,"text":"“诶！？”","background":"/art/stories/zjm-098.webp","left":980,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:28","scriptId":20501,"text":"“好了，不要磨磨蹭蹭的了，拿上给你们的地图，快点出发吧，你们是最后一组了。”","background":"/art/stories/zjm-098.webp","left":980,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:29","scriptId":20501,"text":"“好……好的。”","background":"/art/stories/zjm-098.webp","left":980,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607001-PROLOGUE:20501:31","scriptId":20501,"text":"出了死水基地没多远，我们就看到了几辆大型运输车，另外波西娅和尤拉两人也在车旁。","background":"/art/stories/zdbjbz-03.webp","left":980,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:32","scriptId":20501,"text":"“出发地点是这里没错了……但波西娅和尤拉，你们怎么在这里？”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:33","scriptId":20501,"text":"“我是来观摩的～”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:34","scriptId":20501,"text":"“尤拉不要插嘴，我们在这里是为了分发特制炮弹，你们难道还准备上实弹？”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607001-PROLOGUE:20501:35","scriptId":20501,"text":"波西娅指了指身旁的弹药箱。","background":"/art/stories/zdbjbz-03.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:36","scriptId":20501,"text":"“哦，这样啊。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607001-PROLOGUE:20501:37","scriptId":20501,"text":"想来这次的任务有点匆忙，确实是还没拿到演习用炮弹。","background":"/art/stories/zdbjbz-03.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:38","scriptId":20501,"text":"“给，这是配给的弹药，数量有限。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":728,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607001-PROLOGUE:20501:39","scriptId":20501,"text":"这时尤拉已经把弹药箱给提了过来，看上去很重……为防止手腕脱臼我是没敢接，于是让佐伊她们开始搬运弹药箱。","background":"/art/stories/zdbjbz-03.webp","left":4,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:40","scriptId":20501,"text":"“诶？竟然还是配给供应？”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":728,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:41","scriptId":20501,"text":"“恩，是这样的，这次不是让你们回收信号旗吗？按特定组合上交的话，就可以换到弹药了。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:42","scriptId":20501,"text":"“啊……好像副团长是有说过这么回事。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:43","scriptId":20501,"text":"“嘛，这里先给你们一个提示好了，‘FOOD’这个是换取补给食物用的。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":733,"speaker":"尤拉·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:44","scriptId":20501,"text":"“啊！姐姐！那本来是打算由我来告诉长官的啦！”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":733,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-PROLOGUE:20501:45","scriptId":20501,"text":"“哦？那可真是不好意思啦～”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607001-EPILOGUE:20502:1","scriptId":20502,"text":"正如蒂娅所说，在收集信号旗的过程中确实遇到了一些队伍的干扰。","background":"/art/stories/zdbjbz-03.webp","left":4,"right":608,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:2","scriptId":20502,"text":"“刚才的两支队伍好像不是死水的啊？难道特勤局也有队伍参加？”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":608,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:3","scriptId":20502,"text":"“有可能，不过不管怎么说，回收信号旗是我们的当务之急。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:4","scriptId":20502,"text":"“先看看我们有多少‘FOOD’的旗帜吧，这次任务要持续一周，就像波西娅她们说的那样，食物确保是关键。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":743,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:5","scriptId":20502,"text":"“那个……旗语我有点忘了……挥来挥去老是记不住。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":743,"section":1,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:6","scriptId":20502,"text":"“不，我们手里的是国际信号旗，每面旗帜都和一个英文字母对应，所以只是把字母拼成单词而已，很简单的啦～”","background":"/art/stories/zdbjbz-03.webp","left":572,"right":743,"section":1,"shake":false},{"kind":"dialogue","head":747,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:7","scriptId":20502,"text":"“是……是吗？我怎么一点印象都没有……”","background":"/art/stories/zdbjbz-03.webp","left":572,"right":747,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:8","scriptId":20502,"text":"“也难怪，这套信号旗应该是海军用得多，以前学校确实有教过，但也只不过是过眼云烟而已。","background":"/art/stories/zdbjbz-03.webp","left":4,"right":747,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:9","scriptId":20502,"text":"“哦，那就好，我还以为是很重要的内容呢。”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:10","scriptId":20502,"text":"“对对对，还是节约一下你那脑容量吧～”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":745,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:11","scriptId":20502,"text":"“呜呜，佩妮，长官欺负我……”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":745,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:12","scriptId":20502,"text":"“姐姐……你跟着我们就行了，只要信号旗都收集到自然会有办法拼成指定的组合。”","background":"/art/stories/zdbjbz-03.webp","left":584,"right":745,"section":1,"shake":false},{"kind":"dialogue","head":742,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:13","scriptId":20502,"text":"“哦！佩妮最好了～”","background":"/art/stories/zdbjbz-03.webp","left":584,"right":742,"section":1,"shake":false},{"kind":"dialogue","head":588,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:14","scriptId":20502,"text":"“……”","background":"/art/stories/zdbjbz-03.webp","left":588,"right":742,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:15","scriptId":20502,"text":"“不过话说回来？没有数字旗吗？”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":742,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:16","scriptId":20502,"text":"“是的，目前的情况，只拿到了一些字母旗。”","background":"/art/stories/zdbjbz-03.webp","left":584,"right":742,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607001-EPILOGUE:20502:17","scriptId":20502,"text":"“那看来不会特别困难，只是单纯字母组合的话，就看是什么组合规律了，说不定能瞎猫撞上死耗子～”","background":"/art/stories/zdbjbz-03.webp","left":4,"right":742,"section":1,"shake":false}],"summaries":[]}
