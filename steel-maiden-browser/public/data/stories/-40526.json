{"schemaVersion":1,"id":-40526,"sections":[{"id":"script-20526","name":"原始脚本 20526","scripts":[20526],"start":0,"count":66}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:1","scriptId":20526,"text":"死水团长室中——","background":"/art/stories/zjm-098.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:2","scriptId":20526,"text":"维多利亚正在批阅她那堆积如山的文件，特别是那几封带着火漆印的密函，尤为让她心烦。","background":"/art/stories/zjm-098.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:3","scriptId":20526,"text":"这时，一阵急促的敲门声打断了她。","background":"/art/stories/zjm-098.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:4","scriptId":20526,"text":"“进来。”","background":"/art/stories/zjm-098.webp","left":547,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:5","scriptId":20526,"text":"维多利亚伸手把密函收入抽屉，然后整了整衣领。","background":"/art/stories/zjm-098.webp","left":547,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:6","scriptId":20526,"text":"“最新进展来了！！”","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:7","scriptId":20526,"text":"波西娅一脸兴奋地冲进了办公室，那股冲劲带来了一阵小型飓风。","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:8","scriptId":20526,"text":"一看是波西娅来了，维多利亚赶忙扶住那摇摇欲坠的文件小山。","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:9","scriptId":20526,"text":"“冷静点，波西娅。是什么最近进展？”","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:10","scriptId":20526,"text":"“你猜猜看？”","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:11","scriptId":20526,"text":"波西娅一脸得意的坏笑，这让维多利亚心里有种不祥的预感。","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:12","scriptId":20526,"text":"“我的时间很宝贵，到底是什么事情？”","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:13","scriptId":20526,"text":"“真没劲～就是这样你才会被人家说死板啊！”","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:14","scriptId":20526,"text":"“我就是这么不解风情的女人，不好意思啊。”","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:15","scriptId":20526,"text":"维多利亚没好气的应道。","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:16","scriptId":20526,"text":"“是新旅行者！除了埃普西隆和兰布达以外的第三人诞生了！！”","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:17","scriptId":20526,"text":"虽然维多利亚隐约感觉到波西娅的兴奋会和旅行者有关系，但没想到这爆炸性的消息还是让她大吃一惊。","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:18","scriptId":20526,"text":"“你这句话的信息量有点多……第三人我还能理解，但诞生是什么意思？埃普西隆生的，还是兰布达生的？”","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:19","scriptId":20526,"text":"看到维多利亚一脸问号的样子，波西娅得意地翘高了鼻子。","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:20","scriptId":20526,"text":"“嘻嘻嘻～不是啦～应该说是兰布达的研究成果吧，呃……说起来有点复杂，你现在有空吗？亲眼见识一下就方便多了。”","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:21","scriptId":20526,"text":"维多利亚看了看桌上的文件，又看了看波西娅那兴奋的脸庞，接着她叹了口气。","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:22","scriptId":20526,"text":"“唉……那我还能说什么呢，走吧。”","background":"/art/stories/zjm-098.webp","left":547,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:25","scriptId":20526,"text":"跟着波西娅一路小跑，维多利亚她们来到了波西娅的研究室。","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:26","scriptId":20526,"text":"此时研究室里已经有另外一个小队先一步到场了。","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:27","scriptId":20526,"text":"“诶，连维多利亚团长都来了啊？我还以为波西娅去报告一下就完事了呢。”","background":"/art/stories/zjm-094.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:28","scriptId":20526,"text":"“波西娅都没带报告书，从常识上来说这类报告不适合口头传达。”（小声）","background":"/art/stories/zjm-094.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:29","scriptId":20526,"text":"“但她可是波西娅啊～”（小声）","background":"/art/stories/zjm-094.webp","left":572,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":746,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:30","scriptId":20526,"text":"“不过没想到团长都来了啊……怎么感觉事情会变麻烦……”（小声）","background":"/art/stories/zjm-094.webp","left":572,"right":746,"section":0,"shake":false},{"kind":"dialogue","head":554,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:31","scriptId":20526,"text":"“新旅行者在哪里？”","background":"/art/stories/zjm-094.webp","left":554,"right":746,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:32","scriptId":20526,"text":"维多利亚一进来就直接环视了整个房间，但除了一个打开的大型水槽比较可疑以外并没看到什么旅行者。","background":"/art/stories/zjm-094.webp","left":554,"right":746,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:33","scriptId":20526,"text":"“在这里。”","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:34","scriptId":20526,"text":"回答维多利亚的人是兰布达，由于被尤拉挡着，所以维多利亚并没有第一时间看到兰布达。","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":554,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:35","scriptId":20526,"text":"“嗯？”","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:36","scriptId":20526,"text":"看向兰布达的时候，维多利亚终于察觉到了异样。","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:37","scriptId":20526,"text":"兰布达身边站着一个和兰布达差不多高的生物。","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:38","scriptId":20526,"text":"不过和兰布达，这个旅行者没有手臂，取而代之的是几根类似章鱼的触手。","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":1104,"speaker":"NO.33","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:39","scriptId":20526,"text":"“……”","background":"/art/stories/zjm-094.webp","left":554,"right":1104,"section":0,"shake":false},{"kind":"dialogue","head":554,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:40","scriptId":20526,"text":"“是这家伙吧？新的旅行者？”","background":"/art/stories/zjm-094.webp","left":554,"right":1104,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:41","scriptId":20526,"text":"“波西娅没跟你做简单的说明吗？”","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":554,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:42","scriptId":20526,"text":"“没有。”","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:43","scriptId":20526,"text":"“……”","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:44","scriptId":20526,"text":"兰布达看向波西娅，而波西娅则是回了个鬼脸。","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:45","scriptId":20526,"text":"“那就由我来解释吧，这个是用我的细胞制作的义体，从种类定义上来说跟我和埃普西隆一样，都是旅行者中的歼灭姬分属。”","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:46","scriptId":20526,"text":"“为了方便，你们就叫她代号33吧。”","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":1104,"speaker":"NO.33","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:47","scriptId":20526,"text":"“……”","background":"/art/stories/zjm-094.webp","left":554,"right":1104,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:48","scriptId":20526,"text":"“嗯……”","background":"/art/stories/zjm-094.webp","left":547,"right":1104,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:49","scriptId":20526,"text":"“接下来我打算让这位长官带着她去收集战斗数据，主从关系已经设置好了。”","background":"/art/stories/zjm-094.webp","left":547,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":554,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:50","scriptId":20526,"text":"“嗯……嗯！？等等，波西娅连这么重要的事情……你都不事先跟我打声招呼啊？”","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:51","scriptId":20526,"text":"听到兰布达这么说，维多利亚立刻转头质问波西娅。","background":"/art/stories/zjm-094.webp","left":554,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:52","scriptId":20526,"text":"“诶嘿～兰布达愿意把收集到的战斗数据和我们共享，所以我觉得是一个比较合算的交易。”","background":"/art/stories/zjm-094.webp","left":554,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":554,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:53","scriptId":20526,"text":"“你这先斩后奏也真是让我无话可说，如果这事情让特勤局知道了，怕是要惹来巨大的麻烦。”","background":"/art/stories/zjm-094.webp","left":554,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:54","scriptId":20526,"text":"“不被发现不就好了嘛～反正也就是一小会儿啦～”","background":"/art/stories/zjm-094.webp","left":554,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:55","scriptId":20526,"text":"听上去波西娅已经和兰布达都商量好了的样子，维多利亚摇了摇头。","background":"/art/stories/zjm-094.webp","left":554,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":554,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:56","scriptId":20526,"text":"“好吧……那就交给这小子了，但波西娅，这件事情的总负责人是你，出了问题你自己解决。”","background":"/art/stories/zjm-094.webp","left":554,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:57","scriptId":20526,"text":"“知道啦知道啦～”","background":"/art/stories/zjm-094.webp","left":554,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:59","scriptId":20526,"text":"当维多利亚瞪着波西娅的时候，我感觉到一样软绵绵的东西抓住了我的手。","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:60","scriptId":20526,"text":"“？”","background":"/art/stories/zjm-094.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1104,"speaker":"NO.33","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:61","scriptId":20526,"text":"“……”","background":"/art/stories/zjm-094.webp","left":4,"right":1104,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:62","scriptId":20526,"text":"我发现代号33正用她那宛如大型章鱼脚一般的手臂（？）触碰着我的手心。","background":"/art/stories/zjm-094.webp","left":4,"right":1104,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:63","scriptId":20526,"text":"（这软绵绵的触感……虽然比较奇怪，但摸起来感觉好像还不错……）","background":"/art/stories/zjm-094.webp","left":4,"right":1104,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20526:20526:64","scriptId":20526,"text":"维多利亚走了过来。","background":"/art/stories/zjm-094.webp","left":4,"right":1104,"section":0,"shake":false},{"kind":"dialogue","head":554,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:65","scriptId":20526,"text":"“那这代号33的事情就拜托你了，小子。你和旅行者接触那么久了也没惹出什么乱子，你的实力我是相信的。”","background":"/art/stories/zjm-094.webp","left":4,"right":554,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:66","scriptId":20526,"text":"“感谢团长的厚爱，我一定不会辜负您的厚望。”","background":"/art/stories/zjm-094.webp","left":4,"right":554,"section":0,"shake":false},{"kind":"dialogue","head":552,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:67","scriptId":20526,"text":"“客套话就免了……报告书你也要另给我一份，光看波西娅的那份我不放心……”","background":"/art/stories/zjm-094.webp","left":4,"right":552,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:68","scriptId":20526,"text":"“是，我知道了……”","background":"/art/stories/zjm-094.webp","left":4,"right":552,"section":0,"shake":false},{"kind":"dialogue","head":552,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20526:20526:69","scriptId":20526,"text":"“没什么其他事情的话，我先回去，总觉得胃有点隐隐作痛……”","background":"/art/stories/zjm-094.webp","left":4,"right":552,"section":0,"shake":false}],"summaries":[]}
