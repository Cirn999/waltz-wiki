{"schemaVersion":1,"id":47,"sections":[{"id":"117004-PROLOGUE","name":"第 1 战 · 战前","scripts":[1580],"start":0,"count":35},{"id":"117004-EPILOGUE","name":"第 1 战 · 战后","scripts":[11570],"start":35,"count":18},{"id":"117005-PROLOGUE","name":"第 2 战 · 战前","scripts":[1590],"start":53,"count":14},{"id":"117005-EPILOGUE","name":"第 2 战 · 战后","scripts":[11580],"start":67,"count":13},{"id":"117006-PROLOGUE","name":"第 3 战 · 战前","scripts":[1600],"start":80,"count":27},{"id":"117006-EPILOGUE","name":"第 3 战 · 战后","scripts":[11590],"start":107,"count":15}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-PROLOGUE:1580:1","scriptId":1580,"text":"过了很久，我把马奇诺研究所到伏龙芝遇袭的来龙去脉都告诉了海伦娜。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-PROLOGUE:1580:2","scriptId":1580,"text":"不过就算我讲完了，蕾贝卡也还没回来，真是有够慢的……","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:3","scriptId":1580,"text":"（呃，海伦娜听完以后到现在还一言未发……气氛好尴尬……）","background":"/art/stories/zjm-047.webp","left":3,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":560,"speaker":"海伦娜·潘兴","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:4","scriptId":1580,"text":"“……”","background":"/art/stories/zjm-047.webp","left":3,"right":560,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:5","scriptId":1580,"text":"（这脸从刚才开始就阴沉在那里，我是不是说错什么话了……）","background":"/art/stories/zjm-047.webp","left":3,"right":560,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-PROLOGUE:1580:6","scriptId":1580,"text":"这时大门被“咔嚓”一声打开了，蕾贝卡满面笑容得走了进来，后面还跟了好几位钢舞姬。","background":"/art/stories/zjm-047.webp","left":3,"right":560,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:7","scriptId":1580,"text":"“不好意思让你们久等了～”","background":"/art/stories/zjm-047.webp","left":223,"right":560,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-PROLOGUE:1580:8","scriptId":1580,"text":"看到蕾贝卡回来了，海伦娜立刻收起刚才阴沉的表情。","background":"/art/stories/zjm-047.webp","left":223,"right":560,"section":0,"shake":false},{"kind":"dialogue","head":559,"speaker":"海伦娜·潘兴","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:9","scriptId":1580,"text":"“哦～大家好。”","background":"/art/stories/zjm-047.webp","left":223,"right":559,"section":0,"shake":false},{"kind":"dialogue","head":225,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:10","scriptId":1580,"text":"“这位就是你们的新指挥官，大家先自我介绍一下吧～”","background":"/art/stories/zjm-047.webp","left":225,"right":559,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-PROLOGUE:1580:11","scriptId":1580,"text":"蕾贝卡笑了笑，示意大家开始介绍。","background":"/art/stories/zjm-047.webp","left":225,"right":559,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:12","scriptId":1580,"text":"“维卡·阿格丽普皮娜……火炮担当。”","background":"/art/stories/zjm-047.webp","left":225,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:13","scriptId":1580,"text":"（诶？就这么结束了？沉默寡言类型的么……）","background":"/art/stories/zjm-047.webp","left":3,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:14","scriptId":1580,"text":"“哟吼～我是奈特莉，主要负责前线冲锋和阻挡敌人的攻势。请多多指教啦，长官～”","background":"/art/stories/zjm-047.webp","left":3,"right":572,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-PROLOGUE:1580:15","scriptId":1580,"text":"奈特莉看了看维卡，然后转头对我说。","background":"/art/stories/zjm-047.webp","left":3,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:16","scriptId":1580,"text":"“啊～那个忘说了，维卡可不是高冷哦～她只是比较害羞而已啦～”","background":"/art/stories/zjm-047.webp","left":3,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:17","scriptId":1580,"text":"“奈特莉真多嘴……”","background":"/art/stories/zjm-047.webp","left":596,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:18","scriptId":1580,"text":"“啊哈哈～我只是帮你完善下自我介绍而已～这对长官可是很有帮助的吧？”","background":"/art/stories/zjm-047.webp","left":596,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:19","scriptId":1580,"text":"“恩……”","background":"/art/stories/zjm-047.webp","left":3,"right":574,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-PROLOGUE:1580:20","scriptId":1580,"text":"不去管那两人了，我把目光转向了第三位钢舞姬。","background":"/art/stories/zjm-047.webp","left":3,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:21","scriptId":1580,"text":"“诶？佐伊？你怎么已经来了？蕾贝卡不是说三个月以后吗？而且还换了套制服，感觉不错嘛～”","background":"/art/stories/zjm-047.webp","left":3,"right":574,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-PROLOGUE:1580:22","scriptId":1580,"text":"由于我脱口而出的询问，那个少女显然有些迷茫。","background":"/art/stories/zjm-047.webp","left":3,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:23","scriptId":1580,"text":"“佩妮·谢尔曼，您刚才口中提到的佐伊是不是，佐伊·谢尔曼？”","background":"/art/stories/zjm-047.webp","left":3,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:24","scriptId":1580,"text":"“是的……呃……难道你们是姐妹？”","background":"/art/stories/zjm-047.webp","left":3,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:25","scriptId":1580,"text":"“恩，没错，佐伊是我姐姐。”","background":"/art/stories/zjm-047.webp","left":3,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:26","scriptId":1580,"text":"“果然啊……不然不可能那么相像吧。”","background":"/art/stories/zjm-047.webp","left":3,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:27","scriptId":1580,"text":"“姐姐没有给长官添麻烦吧。”","background":"/art/stories/zjm-047.webp","left":3,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:28","scriptId":1580,"text":"“这个……还好吧，不过我记得佐伊的妹妹不是在英国么？这里可是死水啊。”","background":"/art/stories/zjm-047.webp","left":3,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:29","scriptId":1580,"text":"“……”","background":"/art/stories/zjm-047.webp","left":3,"right":584,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-PROLOGUE:1580:30","scriptId":1580,"text":"眼前的少女陷入了沉默。","background":"/art/stories/zjm-047.webp","left":3,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:31","scriptId":1580,"text":"“那个，佩妮的情况比较复杂，之后我会告诉你的，追问别人的私事可是不礼貌的哟～”","background":"/art/stories/zjm-047.webp","left":231,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:32","scriptId":1580,"text":"“啊，对不起……不自觉的，因为佐伊的关系，所以自然就关心了下。”","background":"/art/stories/zjm-047.webp","left":3,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":592,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:33","scriptId":1580,"text":"“没关系……谢谢。”","background":"/art/stories/zjm-047.webp","left":3,"right":592,"section":0,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:34","scriptId":1580,"text":"“那就让我们开始吧～海伦娜教官，就请您介绍一下这次委托的具体内容吧～”","background":"/art/stories/zjm-047.webp","left":223,"right":592,"section":0,"shake":false},{"kind":"dialogue","head":559,"speaker":"海伦娜·潘兴","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117004-PROLOGUE:1580:35","scriptId":1580,"text":"“好的。”","background":"/art/stories/zjm-047.webp","left":223,"right":559,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-EPILOGUE:11570:1","scriptId":11570,"text":"某处——","background":"/art/stories/zjm-067.webp","left":223,"right":559,"section":1,"shake":false},{"kind":"dialogue","head":49,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"117004-EPILOGUE:11570:2","scriptId":11570,"text":"“疼疼疼……”","background":"/art/stories/zjm-067.webp","left":49,"right":559,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"117004-EPILOGUE:11570:3","scriptId":11570,"text":"“别叫了，只不过是背部强化骨骼发生了变形而已，并没大碍。”","background":"/art/stories/zjm-067.webp","left":49,"right":56,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-EPILOGUE:11570:4","scriptId":11570,"text":"望着两名负伤的手下，奥米克戎摇了摇头。","background":"/art/stories/zjm-067.webp","left":49,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":420,"speaker":"奥米克戎","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"117004-EPILOGUE:11570:5","scriptId":11570,"text":"“本来是派你们两个去拿回样本的，结果竟然怎么会弄成这样？”","background":"/art/stories/zjm-067.webp","left":420,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"117004-EPILOGUE:11570:6","scriptId":11570,"text":"“确实造成了一些损伤，不过样本不是已经拿到了么。”","background":"/art/stories/zjm-067.webp","left":420,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":48,"speaker":"埃普西隆","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"117004-EPILOGUE:11570:7","scriptId":11570,"text":"“是啊是啊，反正是拿到了就行了。”","background":"/art/stories/zjm-067.webp","left":48,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":420,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"117004-EPILOGUE:11570:8","scriptId":11570,"text":"“你们身为‘旅行者’竟然会输给区区的钢舞姬！这点才是我最不可接受的地方！”","background":"/art/stories/zjm-067.webp","left":48,"right":420,"section":1,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"117004-EPILOGUE:11570:9","scriptId":11570,"text":"“嘛，奥米克戎就别生气了，我不仅带回了样本，而且还抓了几个钢舞姬，可以给兰布达当实验品啊～”","background":"/art/stories/zjm-067.webp","left":411,"right":420,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-EPILOGUE:11570:10","scriptId":11570,"text":"旁边的伊塔说道，这次成功偷袭伏龙芝的就是她。","background":"/art/stories/zjm-067.webp","left":411,"right":420,"section":1,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"117004-EPILOGUE:11570:11","scriptId":11570,"text":"“好吧……”","background":"/art/stories/zjm-067.webp","left":411,"right":421,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-EPILOGUE:11570:12","scriptId":11570,"text":"奥米克戎叹了口气说道。","background":"/art/stories/zjm-067.webp","left":411,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"117004-EPILOGUE:11570:13","scriptId":11570,"text":"“那么，柯西，胜利女神特勤局那边就交给你去摆平了，就当一般的战车兽袭击，然后想办法把相关人员都处理掉。”","background":"/art/stories/zjm-067.webp","left":411,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"117004-EPILOGUE:11570:14","scriptId":11570,"text":"“听上去好麻烦……”","background":"/art/stories/zjm-067.webp","left":430,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":421,"speaker":"奥米克戎","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"117004-EPILOGUE:11570:15","scriptId":11570,"text":"“这是命令。”","background":"/art/stories/zjm-067.webp","left":430,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"117004-EPILOGUE:11570:16","scriptId":11570,"text":"“好好好，我知道了……”","background":"/art/stories/zjm-067.webp","left":430,"right":421,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-EPILOGUE:11570:17","scriptId":11570,"text":"柯西望了一眼兰布达和埃普西隆，兰布达回应着点了点头，大概是表示歉意。","background":"/art/stories/zjm-067.webp","left":430,"right":421,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117004-EPILOGUE:11570:18","scriptId":11570,"text":"接着柯西便一言不发地离开了。","background":"/art/stories/zjm-067.webp","left":430,"right":421,"section":1,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117005-PROLOGUE:1590:2","scriptId":1590,"text":"“果然是人靠衣装马靠鞍啊，就觉得你穿这套一定不错～”","background":"/art/stories/zjm-047.webp","left":231,"right":421,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117005-PROLOGUE:1590:3","scriptId":1590,"text":"“虽然是不错，不过为什么要戴假发？”","background":"/art/stories/zjm-047.webp","left":231,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117005-PROLOGUE:1590:4","scriptId":1590,"text":"“啊……那个只是觉得好看而已～”","background":"/art/stories/zjm-047.webp","left":231,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":237,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117005-PROLOGUE:1590:5","scriptId":1590,"text":"“蕾贝卡找这个东西找了好久的说～”","background":"/art/stories/zjm-047.webp","left":231,"right":237,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117005-PROLOGUE:1590:6","scriptId":1590,"text":"“……”","background":"/art/stories/zjm-047.webp","left":4,"right":237,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117005-PROLOGUE:1590:7","scriptId":1590,"text":"换完衣服之后，终于开始了这次的新任务。","background":"/art/stories/zjm-047.webp","left":4,"right":237,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117005-PROLOGUE:1590:8","scriptId":1590,"text":"根据海伦娜的委托内容，这次的任务是摧毁一所被战车兽占领的军事基地。","background":"/art/stories/zjm-047.webp","left":4,"right":237,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117005-PROLOGUE:1590:9","scriptId":1590,"text":"因为是第一次执行任务，外加上要磨合小队，于是蕾贝卡小队和我们同行。","background":"/art/stories/zjm-047.webp","left":4,"right":237,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117005-PROLOGUE:1590:10","scriptId":1590,"text":"“不过说真的，要不是有蕾贝卡你们小队在，以我的经验只用一个小队就想干掉一基地的战车兽简直天方夜谭吧……”","background":"/art/stories/zjm-047.webp","left":4,"right":237,"section":2,"shake":false},{"kind":"dialogue","head":247,"speaker":"雷娅·古德里安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117005-PROLOGUE:1590:11","scriptId":1590,"text":"“还好吧，确实会有点吃力，不过应该能干掉。”","background":"/art/stories/zjm-047.webp","left":4,"right":247,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117005-PROLOGUE:1590:12","scriptId":1590,"text":"我用后视镜看了看身后那几个身影。","background":"/art/stories/zjm-047.webp","left":4,"right":247,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117005-PROLOGUE:1590:13","scriptId":1590,"text":"（从舞装上看，确实要强力不少。不过战斗经验就不知道了。）","background":"/art/stories/zjm-047.webp","left":4,"right":247,"section":2,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117005-PROLOGUE:1590:14","scriptId":1590,"text":"“一点钟方向发现战车兽群，数量约十只，等候命令。”","background":"/art/stories/zjm-047.webp","left":4,"right":223,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117005-PROLOGUE:1590:15","scriptId":1590,"text":"“恩，那就开干！”","background":"/art/stories/zjm-047.webp","left":4,"right":223,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117005-EPILOGUE:11580:0","scriptId":11580,"text":"轻松干掉了这批战车兽，没有动用蕾贝卡小队，纯粹以我这边的队伍配置迎战。","background":"/art/stories/zjm-047.webp","left":4,"right":223,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117005-EPILOGUE:11580:2","scriptId":11580,"text":"“恩，不错不错，这战斗力确实很强，没话说。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117005-EPILOGUE:11580:3","scriptId":11580,"text":"“佩妮和奈特莉负责的牵制工作非常完美，在基本无损的情况下吸引了目标进入打击范围。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":3,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117005-EPILOGUE:11580:4","scriptId":11580,"text":"“过奖了。只是做了分内的事情。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117005-EPILOGUE:11580:5","scriptId":11580,"text":"（恩～比起佐伊能干，而且还挺谦虚，不错不错。）","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117005-EPILOGUE:11580:6","scriptId":11580,"text":"“哈哈，如果连这点都做不到的话，那这次任务肯定要凶多吉少了吧～”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":582,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117005-EPILOGUE:11580:7","scriptId":11580,"text":"“也对，现在是在死水了，我得把原有的思维换过来，能精确衡量自己小队的实力很重要。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":582,"section":3,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117005-EPILOGUE:11580:8","scriptId":11580,"text":"“恩恩～你这个指挥官挺谦虚，没有大架子，从刚来的时候我就这么觉得了～”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":578,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117005-EPILOGUE:11580:9","scriptId":11580,"text":"“还好吧。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":578,"section":3,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117005-EPILOGUE:11580:10","scriptId":11580,"text":"“恩～看到没，就和我之前说的那样，不错吧。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":3,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117005-EPILOGUE:11580:11","scriptId":11580,"text":"“恩……”","background":"/art/stories/zdbjbz-14.webp","left":596,"right":223,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117005-EPILOGUE:11580:12","scriptId":11580,"text":"站在后排的维卡点了点头。","background":"/art/stories/zdbjbz-14.webp","left":596,"right":223,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117005-EPILOGUE:11580:13","scriptId":11580,"text":"“那么继续出发吧。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117006-PROLOGUE:1600:2","scriptId":1600,"text":"在中继站休息时，闲着无聊，问了下佩妮的情况。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:3","scriptId":1600,"text":"“那个……蕾贝卡，佩妮到底是出于什么原因才会在死水的？之后佐伊来了的话，肯定还要解释。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:4","scriptId":1600,"text":"“这倒也是。成绩优秀各项全能的佩妮，照道理应该能被分配到一个比较好的队伍中服役吧。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:5","scriptId":1600,"text":"“恩。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:6","scriptId":1600,"text":"“因为弄坏了一封胜利女神特勤局寄给桑赫斯特学院的文件，于是被学院开除了。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:7","scriptId":1600,"text":"“就因为这个？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:8","scriptId":1600,"text":"“恩，当我听到的时候也觉得没什么大不了的，但是处罚的结果却严重到异常。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:9","scriptId":1600,"text":"“那原因呢？有没有查到？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:10","scriptId":1600,"text":"“奇怪的就是没查到任何相关线索，简直就像故意隐瞒掉了。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:11","scriptId":1600,"text":"“总觉得和这次索菲亚教官的情况很像啊……诶？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117006-PROLOGUE:1600:12","scriptId":1600,"text":"说到这里，我才发现佩妮已经凑了过来。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:13","scriptId":1600,"text":"“呃，看来你都听到了？那我有个问题，你还记得当时文件的内容吗？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117006-PROLOGUE:1600:14","scriptId":1600,"text":"佩妮乖巧地点了点头。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":4,"shake":false},{"kind":"dialogue","head":587,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:15","scriptId":1600,"text":"“我当时只是不小心把蜡封的地方弄破了，看到了里面掉出来的照片。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":587,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:16","scriptId":1600,"text":"“什么样的照片？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":587,"section":4,"shake":false},{"kind":"dialogue","head":589,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:17","scriptId":1600,"text":"“很难描述，看上去有点像人的形状的什么东西，具体说不清楚。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":589,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:18","scriptId":1600,"text":"“哦……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":589,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117006-PROLOGUE:1600:19","scriptId":1600,"text":"听上去没什么帮助，不过这事情确实也有很多蹊跷。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":589,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117006-PROLOGUE:1600:20","scriptId":1600,"text":"因为也和胜利女神特勤局有关，不禁让我联想到发生在自己身上的事情。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":589,"section":4,"shake":false},{"kind":"dialogue","head":587,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:21","scriptId":1600,"text":"“那个因为这种小事而被学院开除的事情千万不要告诉我姐姐啊……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":587,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:22","scriptId":1600,"text":"“很不巧，佐伊估计再过三个月左右也会来死水……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":587,"section":4,"shake":false},{"kind":"dialogue","head":594,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:23","scriptId":1600,"text":"“啊……不是吧，以她的身手能进死水吗？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":594,"section":4,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:24","scriptId":1600,"text":"“确实我也有这方面的担心……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":594,"section":4,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:25","scriptId":1600,"text":"“那她为什么还要来尝试？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":4,"shake":false},{"kind":"dialogue","head":231,"speaker":"蕾贝卡·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-PROLOGUE:1600:26","scriptId":1600,"text":"“我想大概是因为某指挥官的魅力吧～”","background":"/art/stories/zdbjbz-14.webp","left":231,"right":584,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117006-PROLOGUE:1600:27","scriptId":1600,"text":"蕾贝卡半开玩笑得加入了聊天。","background":"/art/stories/zdbjbz-14.webp","left":231,"right":584,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117006-PROLOGUE:1600:28","scriptId":1600,"text":"休息过后，我们又继续之前的旅程。","background":"/art/stories/zdbjbz-14.webp","left":231,"right":584,"section":4,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"117006-EPILOGUE:11590:0","scriptId":11590,"text":"在行进的路上，经常能遇到一点零散的战车兽群。","background":"/art/stories/zdbjbz-14.webp","left":231,"right":584,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:2","scriptId":11590,"text":"“这边的战车兽也挺多的么。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":5,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:3","scriptId":11590,"text":"“还好吧，虽然战车兽数量一直有在控制，但是却从来没有根除。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:4","scriptId":11590,"text":"“我想是因为这边的战车兽比较聪明吧，躲起来繁殖，然后突然就冒出一批，简直和雨后春笋一样。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":582,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:5","scriptId":11590,"text":"“所以海伦娜那边是让我们去清除一个繁殖基地？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":582,"section":5,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:6","scriptId":11590,"text":"“没错，不过报酬给得比较低，所以团长觉得不合算。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:7","scriptId":11590,"text":"“作为军人来说，我觉得这种任务就算没有报酬也会完成。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:8","scriptId":11590,"text":"“不过现在是佣兵了，我想知道报酬是多少？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":223,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:9","scriptId":11590,"text":"“十五万吧。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:10","scriptId":11590,"text":"“诶！？这不是挺多的么。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":223,"section":5,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:11","scriptId":11590,"text":"“扣除掉战斗的消耗，基本就没多少了……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":591,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:12","scriptId":11590,"text":"“呃，之前的物资都是军队供应的，所以没算得那么细，原来是这样啊……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":591,"section":5,"shake":false},{"kind":"dialogue","head":235,"speaker":"露米娜·施泰特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:13","scriptId":11590,"text":"“对的，我们之前和你们一起做侦察任务护卫的时候，报酬就是三十万。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":235,"section":5,"shake":false},{"kind":"dialogue","head":249,"speaker":"雷娅·古德里安","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:14","scriptId":11590,"text":"“不过那次是挺赚的，因为消耗比想象中得要少很多～”","background":"/art/stories/zdbjbz-14.webp","left":249,"right":235,"section":5,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"117006-EPILOGUE:11590:15","scriptId":11590,"text":"（原来每次战斗都那么费钱，之前完全不知道啊……）","background":"/art/stories/zdbjbz-14.webp","left":4,"right":235,"section":5,"shake":false}],"summaries":["更换了死水的指挥官服装，看上去还不错。","闲着无聊，问了下佩妮的情况。"]}
