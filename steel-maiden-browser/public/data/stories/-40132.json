{"schemaVersion":1,"id":-40132,"sections":[{"id":"script-20132","name":"原始脚本 20132","scripts":[20132],"start":0,"count":50}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:0","scriptId":20132,"text":"从海滩方向直射过来两道光炮——","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:1","scriptId":20132,"text":"约塔下意识得后跳躲开，但是只躲过了其中一道，另一道径直击穿了约塔手中的巨炮。","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20132:20132:2","scriptId":20132,"text":"“切……什么情况。”","background":"/art/stories/zjm-047.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:3","scriptId":20132,"text":"约塔定睛看了看自己的武器的损伤情况。","background":"/art/stories/zjm-047.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20132:20132:4","scriptId":20132,"text":"“什么！？这不可能！？和我一样的攻击兵器！？”","background":"/art/stories/zjm-047.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:5","scriptId":20132,"text":"约塔的眼睛睁得大大的……但是无论她怎么看最后仍旧没有找到这光线的来源。","background":"/art/stories/zjm-047.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20132:20132:6","scriptId":20132,"text":"（超视距的聚合光线？人类已经有此等武器了吗！？）","background":"/art/stories/zjm-047.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20132:20132:7","scriptId":20132,"text":"（不行，这样打下去对我不利，只能放弃当前任务，先回去报告西格玛这个发现。）","background":"/art/stories/zjm-047.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":400,"speaker":"约塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20132:20132:8","scriptId":20132,"text":"“切……这次先放过你们！”","background":"/art/stories/zjm-047.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:9","scriptId":20132,"text":"约塔狠狠地丢下了这句话以后，消失在了丛林之中，","background":"/art/stories/zjm-047.webp","left":400,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:11","scriptId":20132,"text":"正在激烈战斗中的众人面面相觑，但是并没有人知道怎么解释当前这个情况……","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:12","scriptId":20132,"text":"“呃……约塔撤退了？”","background":"/art/stories/zjm-047.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:13","scriptId":20132,"text":"“我看看——”","background":"/art/stories/zjm-047.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:14","scriptId":20132,"text":"佐伊把身子探出掩体，这次没有炮弹和光线劈头盖脑地射过来。","background":"/art/stories/zjm-047.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":747,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:15","scriptId":20132,"text":"“什么都没有了……”","background":"/art/stories/zjm-047.webp","left":4,"right":747,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:16","scriptId":20132,"text":"“诶？”","background":"/art/stories/zjm-047.webp","left":4,"right":747,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:17","scriptId":20132,"text":"“约塔不见了，而且软泥也都消失了！”","background":"/art/stories/zjm-047.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:18","scriptId":20132,"text":"经过佐伊的确认，众人也都纷纷离开掩体出来确认。","background":"/art/stories/zjm-047.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:19","scriptId":20132,"text":"“突然出现又突然消失，真像热带风暴啊……”","background":"/art/stories/zjm-047.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:20","scriptId":20132,"text":"“我认为约塔的撤退可能和刚才的逆向光线有关系。”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:21","scriptId":20132,"text":"“恩，有可能……虽然不知道具体发生了什么，但是总算得救了……”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:22","scriptId":20132,"text":"“对了，去确认一下巴丽娜和诺伊娜那边的损伤状况……”","background":"/art/stories/zjm-047.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:23","scriptId":20132,"text":"“这个好像不用了，我已经看到她们过来了～”","background":"/art/stories/zjm-047.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:24","scriptId":20132,"text":"这时已经看到满身灰尘的伊诺娜她们跑了过来。","background":"/art/stories/zjm-047.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:25","scriptId":20132,"text":"“你们没事吧。”","background":"/art/stories/zjm-047.webp","left":680,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:26","scriptId":20132,"text":"“没有，基本都是点擦伤之类的，你们呢？”","background":"/art/stories/zjm-047.webp","left":680,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:27","scriptId":20132,"text":"“我们这边也差不多。”","background":"/art/stories/zjm-047.webp","left":680,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:28","scriptId":20132,"text":"“呼……那就好。”","background":"/art/stories/zjm-047.webp","left":680,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:29","scriptId":20132,"text":"“人是没什么事，不过拍摄器材被破坏掉了……”","background":"/art/stories/zjm-047.webp","left":798,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":784,"speaker":"奥莉娅·契科娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:30","scriptId":20132,"text":"“啊～！？那岂不是要重拍？”","background":"/art/stories/zjm-047.webp","left":798,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:31","scriptId":20132,"text":"“重拍倒是不需要，前两天的拍摄素材已经够用了，现在当务之急是要上报给特勤局这次遇袭的情况。”","background":"/art/stories/zjm-047.webp","left":798,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":791,"speaker":"塞西尔·霞飞","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:32","scriptId":20132,"text":"“哎～～～我今天的状态还很不错呢～结果不收录啊……”","background":"/art/stories/zjm-047.webp","left":798,"right":791,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:33","scriptId":20132,"text":"“没办法，摄像机坏了，今天拍摄的带子也毁了……”","background":"/art/stories/zjm-047.webp","left":798,"right":791,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:34","scriptId":20132,"text":"看到塞西尔她们那么精神，我也安心了。","background":"/art/stories/zjm-047.webp","left":798,"right":791,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:35","scriptId":20132,"text":"“此地不宜久留，不知道约塔还会不会回来，所以先撤回度假村吧。”","background":"/art/stories/zjm-047.webp","left":798,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:36","scriptId":20132,"text":"经由我的建议，大家开始动身返回度假村。","background":"/art/stories/zjm-047.webp","left":798,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:39","scriptId":20132,"text":"回去的路上，我们还遇到了在度假村的尤拉和艾丽莎——","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:40","scriptId":20132,"text":"“长官，你们遇到了旅行者！？”","background":"/art/stories/zjm-101.webp","left":728,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:41","scriptId":20132,"text":"“是啊……差点被弄死……还好对方不知道为什么突然撤退了……”","background":"/art/stories/zjm-101.webp","left":728,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":728,"speaker":"尤拉·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:42","scriptId":20132,"text":"“这样啊～真是辛苦了呢～我们一起回科研基地吧，我想姐姐对这事情肯定很感兴趣。”","background":"/art/stories/zjm-101.webp","left":728,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:43","scriptId":20132,"text":"“确实……”","background":"/art/stories/zjm-101.webp","left":728,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:44","scriptId":20132,"text":"“艾丽莎也没事吧？”","background":"/art/stories/zjm-101.webp","left":728,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":13,"speaker":"艾丽莎","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:45","scriptId":20132,"text":"“恩，没有。”","background":"/art/stories/zjm-101.webp","left":13,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":13,"speaker":"艾丽莎","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20132:20132:46","scriptId":20132,"text":"（看样子刚才的自动反击好像没有打中约塔的样子……算了，谁让她没事乱开炮……）","background":"/art/stories/zjm-101.webp","left":13,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:47","scriptId":20132,"text":"之后，我们很安全的返回了科研基地，途中也没有遇到什么突发事件。","background":"/art/stories/zjm-101.webp","left":13,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:48","scriptId":20132,"text":"而波西娅因为没有参加到这次对旅行者的作战而满脸失望。","background":"/art/stories/zjm-101.webp","left":13,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:49","scriptId":20132,"text":"因为结识了妮科尔·奥尔巴赫，我们也第一次知道了飞行舞装的存在……再追问之下波西娅还是透露了一点消息给我们。","background":"/art/stories/zjm-101.webp","left":13,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:50","scriptId":20132,"text":"飞行舞装的测试进入了β阶段，但是具体的数据还不能对外公开。","background":"/art/stories/zjm-101.webp","left":13,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:51","scriptId":20132,"text":"另外约塔向西格玛汇报了人类科技异常的问题，遭到西格玛否定……","background":"/art/stories/zjm-101.webp","left":13,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20132:20132:52","scriptId":20132,"text":"西格玛认定是约塔想偷懒所以找的借口，于是这件事情最后不了了之……","background":"/art/stories/zjm-101.webp","left":13,"right":4,"section":0,"shake":false}],"summaries":[]}
