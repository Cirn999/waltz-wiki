{"schemaVersion":1,"id":-40120,"sections":[{"id":"script-20120","name":"原始脚本 20120","scripts":[20120],"start":0,"count":49}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20120:20120:1","scriptId":20120,"text":"因为战车兽数量不多，所以战斗很快就结束了。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:2","scriptId":20120,"text":"“没想到波西娅还能弄来空中支援。”","background":"/art/stories/zjm-101.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:3","scriptId":20120,"text":"“我想这应该是夏威夷基地的特色吧，对于不太需要陆军的小岛来说，她们空中或者海上支援更加熟练吧。”","background":"/art/stories/zjm-101.webp","left":584,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:4","scriptId":20120,"text":"“不过要是真的能有可以飞的舞装就好了，省得我们在地上跑了……”","background":"/art/stories/zjm-101.webp","left":584,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:5","scriptId":20120,"text":"“以现在的技术来说不太可能做到吧……”","background":"/art/stories/zjm-101.webp","left":584,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:6","scriptId":20120,"text":"“如果真的有，那我肯定合适啊～以前在空中飞来飞去习惯了～”","background":"/art/stories/zjm-101.webp","left":584,"right":578,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:7","scriptId":20120,"text":"“翱翔……”","background":"/art/stories/zjm-101.webp","left":596,"right":578,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20120:20120:9","scriptId":20120,"text":"这时，我们看到塞西尔她们从海滩边慢慢走过来。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":792,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:10","scriptId":20120,"text":"“呼呼～今天的拍摄完成～完美完美～”","background":"/art/stories/zjm-101.webp","left":792,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":784,"speaker":"奥莉娅·契科娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:11","scriptId":20120,"text":"“就是时间短了点～”","background":"/art/stories/zjm-101.webp","left":792,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:12","scriptId":20120,"text":"“毕竟今天的阳光不太好，没办法啦。”","background":"/art/stories/zjm-101.webp","left":798,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:13","scriptId":20120,"text":"“哦～拍摄完成了？辛苦你们了。”","background":"/art/stories/zjm-101.webp","left":798,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":792,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:14","scriptId":20120,"text":"“恩恩～塞西尔今天表现很不错哦～给你签个名也没问题哟～”","background":"/art/stories/zjm-101.webp","left":792,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:15","scriptId":20120,"text":"“呃……签名……”","background":"/art/stories/zjm-101.webp","left":792,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":793,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:16","scriptId":20120,"text":"“怎么？看不上塞西尔的签名吗？”","background":"/art/stories/zjm-101.webp","left":793,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:17","scriptId":20120,"text":"“不不不……不是这个意思……”","background":"/art/stories/zjm-101.webp","left":793,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":793,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:18","scriptId":20120,"text":"“那你是什么意思？”","background":"/art/stories/zjm-101.webp","left":793,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:19","scriptId":20120,"text":"“塞西尔！？能给我签名嘛？你的演唱会我可是一直看啊～”","background":"/art/stories/zjm-101.webp","left":793,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":792,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:20","scriptId":20120,"text":"“哦呀～是我的粉丝呢！没问题～塞西尔会给你签个非常漂亮的～”","background":"/art/stories/zjm-101.webp","left":792,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:21","scriptId":20120,"text":"“谢谢！谢谢！！我去拿板！”","background":"/art/stories/zjm-101.webp","left":792,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:22","scriptId":20120,"text":"（呼……佐伊！干得漂亮！）","background":"/art/stories/zjm-101.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:23","scriptId":20120,"text":"“啊哈哈～遇到长官不太能应付的类型了啊～”（小声）","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:24","scriptId":20120,"text":"“稍微有点……”（小声）","background":"/art/stories/zjm-101.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:25","scriptId":20120,"text":"“接下来的行动呢？”","background":"/art/stories/zjm-101.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:26","scriptId":20120,"text":"“我想应该是先回度假村休息吧。”","background":"/art/stories/zjm-101.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20120:20120:27","scriptId":20120,"text":"我们顺着沙滩方向往度假村方向返回。","background":"/art/stories/zjm-101.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:28","scriptId":20120,"text":"“刚才有听到炮弹的声音呢，你们在和战车兽战斗？”","background":"/art/stories/zjm-101.webp","left":798,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:29","scriptId":20120,"text":"“恩，刚才在峭壁那边有几只战车兽，不过已经被我们消灭掉了。”","background":"/art/stories/zjm-101.webp","left":798,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:30","scriptId":20120,"text":"“哦哦～伊诺娜还真是可靠呢～”","background":"/art/stories/zjm-101.webp","left":798,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:31","scriptId":20120,"text":"“哪里哪里～虽然我觉得放置那些战车兽不管应该也没什么问题，不过另一个小队的指挥好像不这么想。”","background":"/art/stories/zjm-101.webp","left":798,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:32","scriptId":20120,"text":"“哼哼～有点意思，大概是太紧张了吧～”","background":"/art/stories/zjm-101.webp","left":798,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":784,"speaker":"奥莉娅·契科娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:33","scriptId":20120,"text":"“如果不是拍摄，我也想去和战车兽打一场～”","background":"/art/stories/zjm-101.webp","left":798,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:34","scriptId":20120,"text":"“奥莉娅真是太好动了，虽然有活力是好事，但是身为公众人物可要注意保养啊。”","background":"/art/stories/zjm-101.webp","left":798,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":784,"speaker":"奥莉娅·契科娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:35","scriptId":20120,"text":"“噗噗……没劲啦。”","background":"/art/stories/zjm-101.webp","left":798,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:36","scriptId":20120,"text":"“好吧，今天拍摄也完成了，等会儿去沙滩玩吧～","background":"/art/stories/zjm-101.webp","left":798,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":784,"speaker":"奥莉娅·契科娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:37","scriptId":20120,"text":"“太好了。”","background":"/art/stories/zjm-101.webp","left":798,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":785,"speaker":"路易斯·华盛顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:38","scriptId":20120,"text":"“海滩，我也想去～”","background":"/art/stories/zjm-101.webp","left":785,"right":784,"section":0,"shake":false},{"kind":"dialogue","head":680,"speaker":"诺伊娜·鲍尔特","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:39","scriptId":20120,"text":"“先弄好手头的工作，傍晚的时候应该可以去沙滩玩玩吧～”","background":"/art/stories/zjm-101.webp","left":785,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":785,"speaker":"路易斯·华盛顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:40","scriptId":20120,"text":"“诶！？只能晚上吗？”","background":"/art/stories/zjm-101.webp","left":785,"right":680,"section":0,"shake":false},{"kind":"dialogue","head":799,"speaker":"波比·克里斯蒂安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:41","scriptId":20120,"text":"“路易斯对海滩的免疫能力还是一如既往……”","background":"/art/stories/zjm-101.webp","left":785,"right":799,"section":0,"shake":false},{"kind":"dialogue","head":785,"speaker":"路易斯·华盛顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:42","scriptId":20120,"text":"“哼哼～我这次可是准备了很漂亮的泳装呢！”","background":"/art/stories/zjm-101.webp","left":785,"right":799,"section":0,"shake":false},{"kind":"dialogue","head":799,"speaker":"波比·克里斯蒂安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:43","scriptId":20120,"text":"“不过晚上有人看吗……”","background":"/art/stories/zjm-101.webp","left":785,"right":799,"section":0,"shake":false},{"kind":"dialogue","head":785,"speaker":"路易斯·华盛顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:44","scriptId":20120,"text":"“……本来就不是给别人看的，我自己开心就好了～”","background":"/art/stories/zjm-101.webp","left":785,"right":799,"section":0,"shake":false},{"kind":"dialogue","head":801,"speaker":"波比·克里斯蒂安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:45","scriptId":20120,"text":"“也是～度假村的晚餐可真是很奢华呢～”","background":"/art/stories/zjm-101.webp","left":785,"right":801,"section":0,"shake":false},{"kind":"dialogue","head":785,"speaker":"路易斯·华盛顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:46","scriptId":20120,"text":"“恩，听说今天可以吃到特制的黄金烤猪宴～”","background":"/art/stories/zjm-101.webp","left":785,"right":801,"section":0,"shake":false},{"kind":"dialogue","head":809,"speaker":"波比·克里斯蒂安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:47","scriptId":20120,"text":"“啊！想起来，想到那味道就已经要流口水了～”","background":"/art/stories/zjm-101.webp","left":785,"right":809,"section":0,"shake":false},{"kind":"dialogue","head":785,"speaker":"路易斯·华盛顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:48","scriptId":20120,"text":"（呃……波比每次聊吃得总是一副痴痴的样子……）","background":"/art/stories/zjm-101.webp","left":785,"right":809,"section":0,"shake":false},{"kind":"dialogue","head":785,"speaker":"路易斯·华盛顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:49","scriptId":20120,"text":"“恩，那个味道是不错，不过那是晚上的事情～”","background":"/art/stories/zjm-101.webp","left":785,"right":809,"section":0,"shake":false},{"kind":"dialogue","head":809,"speaker":"波比·克里斯蒂安","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20120:20120:50","scriptId":20120,"text":"“啊～真是期待呢～”","background":"/art/stories/zjm-101.webp","left":785,"right":809,"section":0,"shake":false}],"summaries":[]}
