{"schemaVersion":1,"id":200,"sections":[{"id":"346001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20527],"start":0,"count":20},{"id":"346001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20528],"start":20,"count":15}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"346001-PROLOGUE:20527:1","scriptId":20527,"text":"波西娅的实验室——","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"346001-PROLOGUE:20527:2","scriptId":20527,"text":"由于模拟战斗系统经过了德尔塔的新一代改良，所以现在要对这个系统进行测试。","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"346001-PROLOGUE:20527:3","scriptId":20527,"text":"不过今天测试的目标不是钢舞姬而是旅行者。","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"346001-PROLOGUE:20527:4","scriptId":20527,"text":"“听说今天我们是要协助兰布达和埃普西隆？”","background":"/art/stories/zjm-094.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"346001-PROLOGUE:20527:5","scriptId":20527,"text":"“正是如此，但你们也不要太过放松。”","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"346001-PROLOGUE:20527:6","scriptId":20527,"text":"“什么意思？”","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"346001-PROLOGUE:20527:7","scriptId":20527,"text":"“为什么要用模拟战斗系统你还不明白吗？你们必须以命相搏，战斗数据要真实可靠。”","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"346001-PROLOGUE:20527:8","scriptId":20527,"text":"“呃……就算你这么说……”","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"346001-PROLOGUE:20527:9","scriptId":20527,"text":"“想说假的真不了，没有临场感是吧～”","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"346001-PROLOGUE:20527:10","scriptId":20527,"text":"波西娅直接抢走了我的下一句台词。","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"346001-PROLOGUE:20527:11","scriptId":20527,"text":"“这次的模拟战斗说不定能让你真正体验到死亡的感觉～因为我打算连疼痛都模拟。”","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"346001-PROLOGUE:20527:12","scriptId":20527,"text":"“什么！？”","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"346001-PROLOGUE:20527:13","scriptId":20527,"text":"“你不是说没有临场感吗？我大发慈悲满足你咯～”","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"346001-PROLOGUE:20527:14","scriptId":20527,"text":"“那个——","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":0,"shake":false},{"kind":"dialogue","head":1105,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"346001-PROLOGUE:20527:15","scriptId":20527,"text":"“你们有完没完？快开始吧，我都等不及了！”","background":"/art/stories/zjm-094.webp","left":4,"right":1105,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"346001-PROLOGUE:20527:16","scriptId":20527,"text":"只见埃普西隆头上套着一个超小号的头盔，看来是波西娅为她量身定做的。","background":"/art/stories/zjm-094.webp","left":4,"right":1105,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"346001-PROLOGUE:20527:17","scriptId":20527,"text":"“时间有限，都先躺好吧。”","background":"/art/stories/zjm-094.webp","left":56,"right":1105,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"346001-PROLOGUE:20527:18","scriptId":20527,"text":"兰布达也站了出来，她递给我一个头盔，样子和埃普西隆头上的完全一样。","background":"/art/stories/zjm-094.webp","left":56,"right":1105,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"346001-PROLOGUE:20527:19","scriptId":20527,"text":"“好吧……”","background":"/art/stories/zjm-094.webp","left":4,"right":1105,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"346001-PROLOGUE:20527:20","scriptId":20527,"text":"于是乎战斗测试就此开始。","background":"/art/stories/zjm-094.webp","left":4,"right":1105,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"346001-EPILOGUE:20528:1","scriptId":20528,"text":"经过一场恶战，终于在模拟战斗系统里放倒了埃普西隆和兰布达。","background":"/art/stories/zjm-094.webp","left":4,"right":1105,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"346001-EPILOGUE:20528:2","scriptId":20528,"text":"“真是疼死我了……肩膀脱臼的感觉就像真的一样……”","background":"/art/stories/zjm-094.webp","left":4,"right":1105,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"346001-EPILOGUE:20528:3","scriptId":20528,"text":"我使劲的甩了甩肩膀，刚才那撕心裂肺的疼感就像做梦一样无影无踪了。","background":"/art/stories/zjm-094.webp","left":4,"right":1105,"section":1,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"346001-EPILOGUE:20528:4","scriptId":20528,"text":"“不错嘛，已经相当习惯和旅行者作战了嘛。”","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"346001-EPILOGUE:20528:5","scriptId":20528,"text":"“多谢夸奖。”","background":"/art/stories/zjm-094.webp","left":4,"right":608,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"346001-EPILOGUE:20528:6","scriptId":20528,"text":"“模拟系统已经基本完善了，不过痛觉的调整可以减弱20%”","background":"/art/stories/zjm-094.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"346001-EPILOGUE:20528:7","scriptId":20528,"text":"兰布达摇了摇在那里口吐白沫的埃普西隆，在刚才的战斗中埃普西隆阵亡了。","background":"/art/stories/zjm-094.webp","left":4,"right":56,"section":1,"shake":false},{"kind":"dialogue","head":1106,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"346001-EPILOGUE:20528:8","scriptId":20528,"text":"“呜哈！”","background":"/art/stories/zjm-094.webp","left":4,"right":1106,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"346001-EPILOGUE:20528:9","scriptId":20528,"text":"被兰布达提了起来之后，埃普西隆终于有了反应。","background":"/art/stories/zjm-094.webp","left":4,"right":1106,"section":1,"shake":false},{"kind":"dialogue","head":1105,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"346001-EPILOGUE:20528:10","scriptId":20528,"text":"“用了原来的身体竟然都让你们赢了！我怀疑波西娅你是不是帮他们作弊了？”","background":"/art/stories/zjm-094.webp","left":4,"right":1105,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"346001-EPILOGUE:20528:11","scriptId":20528,"text":"埃普西隆显得很不服气的样子。","background":"/art/stories/zjm-094.webp","left":4,"right":1105,"section":1,"shake":false},{"kind":"dialogue","head":608,"speaker":"波西娅·波尔舍","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"346001-EPILOGUE:20528:12","scriptId":20528,"text":"“很遗憾，我可没那功夫去搞作弊的事情，光是记录数据就已经够我忙的了。”","background":"/art/stories/zjm-094.webp","left":608,"right":1105,"section":1,"shake":false},{"kind":"dialogue","head":1105,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"346001-EPILOGUE:20528:13","scriptId":20528,"text":"“切！我这次明明已经盯着指挥官攻击了啊！竟然还是输了！”","background":"/art/stories/zjm-094.webp","left":608,"right":1105,"section":1,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"346001-EPILOGUE:20528:14","scriptId":20528,"text":"“稍微有了那么一点点的长进，但你也要看一下周围的情况，就这么直线冲过去，傻子都知道你的目标。”","background":"/art/stories/zjm-094.webp","left":56,"right":1105,"section":1,"shake":false},{"kind":"dialogue","head":1105,"speaker":"埃普西隆","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"346001-EPILOGUE:20528:15","scriptId":20528,"text":"“呃……”","background":"/art/stories/zjm-094.webp","left":56,"right":1105,"section":1,"shake":false}],"summaries":[]}
