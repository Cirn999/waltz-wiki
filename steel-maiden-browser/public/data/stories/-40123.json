{"schemaVersion":1,"id":-40123,"sections":[{"id":"script-20123","name":"原始脚本 20123","scripts":[20123],"start":0,"count":25}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20123:20123:1","scriptId":20123,"text":"因为彻夜的观察软泥的动静，我们两个小队都没有合过眼。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20123:20123:2","scriptId":20123,"text":"但因为不能延误拍摄工作，于是我们采用了轮班制的形式来进行警卫工作。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:3","scriptId":20123,"text":"“啊呀呀～长官们昨夜发生了重大事情？现在结果如何了？”","background":"/art/stories/zjm-101.webp","left":798,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20123:20123:4","scriptId":20123,"text":"巴丽娜她们因为是在避难所休息，所以还算睡得安稳。","background":"/art/stories/zjm-101.webp","left":798,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:5","scriptId":20123,"text":"“恩，收拾掉了那只软泥一样的生物，至于残骸已经被波西娅博士带回科研基地了。”","background":"/art/stories/zjm-101.webp","left":798,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:6","scriptId":20123,"text":"“真是大新闻呢，不过好在有长官们在啊～我们可以安心休息。”","background":"/art/stories/zjm-101.webp","left":798,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:7","scriptId":20123,"text":"“警卫工作是我们应做的，而你们则有义务管理好自己的身体，一回事啦。”","background":"/art/stories/zjm-101.webp","left":798,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":786,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:8","scriptId":20123,"text":"“虽然这话从长官嘴里说出来有点微妙，不过确实是这样。”","background":"/art/stories/zjm-101.webp","left":786,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:9","scriptId":20123,"text":"“微妙？？？”","background":"/art/stories/zjm-101.webp","left":786,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:10","scriptId":20123,"text":"“塞西尔就别逗长官啦～正确的说是身体健康啦～我们可是卖艺不卖身的～”","background":"/art/stories/zjm-101.webp","left":798,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:11","scriptId":20123,"text":"“啊！！对不起对不起！我没有别的意思……”","background":"/art/stories/zjm-101.webp","left":798,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:12","scriptId":20123,"text":"“哈哈～作为昨天保护我们的回礼，给你看看身体也无妨哟～”","background":"/art/stories/zjm-101.webp","left":798,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:13","scriptId":20123,"text":"“诶！？真的吗？”","background":"/art/stories/zjm-101.webp","left":798,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:14","scriptId":20123,"text":"“哼哼～”","background":"/art/stories/zjm-101.webp","left":798,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20123:20123:15","scriptId":20123,"text":"巴丽娜微微一笑，并没有立刻回答我。","background":"/art/stories/zjm-101.webp","left":798,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":793,"speaker":"塞西尔·霞飞","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:16","scriptId":20123,"text":"“我看喜欢逗长官的是巴丽娜才对呢……”（小声）","background":"/art/stories/zjm-101.webp","left":793,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20123:20123:17","scriptId":20123,"text":"这时奥莉娅走了过来。","background":"/art/stories/zjm-101.webp","left":793,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":784,"speaker":"奥莉娅·契科娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:18","scriptId":20123,"text":"“拍摄小组已经准备好了～”","background":"/art/stories/zjm-101.webp","left":784,"right":4,"section":0,"shake":false},{"kind":"dialogue","head":798,"speaker":"巴丽娜·波克罗夫卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:19","scriptId":20123,"text":"“来了来了～”","background":"/art/stories/zjm-101.webp","left":784,"right":798,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20123:20123:20","scriptId":20123,"text":"另一侧的墙边——","background":"/art/stories/zjm-101.webp","left":784,"right":798,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:21","scriptId":20123,"text":"（嗯……战地明星的魅力确实很大……长官他……）","background":"/art/stories/zjm-101.webp","left":584,"right":798,"section":0,"shake":false},{"kind":"dialogue","head":748,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:22","scriptId":20123,"text":"“佩妮？你在干什么呢？”","background":"/art/stories/zjm-101.webp","left":584,"right":748,"section":0,"shake":false},{"kind":"dialogue","head":594,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:23","scriptId":20123,"text":"“啊！？没……没什么……我只是在研究这墙的纹理……”","background":"/art/stories/zjm-101.webp","left":594,"right":748,"section":0,"shake":false},{"kind":"dialogue","head":742,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:24","scriptId":20123,"text":"“这有什么好看的～佩妮真是奇怪，老喜欢在这种怪东西上面花费时间～”","background":"/art/stories/zjm-101.webp","left":594,"right":742,"section":0,"shake":false},{"kind":"dialogue","head":589,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20123:20123:25","scriptId":20123,"text":"“我也不想这样啊……”（小声）","background":"/art/stories/zjm-101.webp","left":589,"right":742,"section":0,"shake":false}],"summaries":[]}
