es/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:3","scriptId":383,"text":"“都进来吧”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:4","scriptId":383,"text":"“好……”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:5","scriptId":383,"text":"“哟，你们来啦。”","background":"/art/stories/zjm-047.webp","left":103,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:6","scriptId":383,"text":"“呃……奈乐还有莉娜！？”","background":"/art/stories/zjm-047.webp","left":103,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:7","scriptId":383,"text":"“嘻嘻嘻嘻……”","background":"/art/stories/zjm-047.webp","left":81,"right":40,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108010-PROLOGUE:383:8","scriptId":383,"text":"猎虎小队的出现，完全出乎了我们的意料。","background":"/art/stories/zjm-047.webp","left":81,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:9","scriptId":383,"text":"“我们并没有看到你进学院啊。”","background":"/art/stories/zjm-047.webp","left":81,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:10","scriptId":383,"text":"“校门应该被我们盯死了，不可能有队伍通过的。”","background":"/art/stories/zjm-047.webp","left":1170,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:11","scriptId":383,"text":"“或许她们并不是从正门进来的。”","background":"/art/stories/zjm-047.webp","left":1170,"right":1158,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:12","scriptId":383,"text":"“我们是从后门进来的，都已经来了半天了，因为迟迟没看到你们，我就找索菲亚教官问了问情况。”","background":"/art/stories/zjm-047.webp","left":103,"right":1158,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:13","scriptId":383,"text":"（我们这么完美的正门蹲点……奈乐竟然走后门……）","background":"/art/stories/zjm-047.webp","left":103,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:14","scriptId":383,"text":"“那个…事出有因，我们打算在正面的中继站等你的。”","background":"/art/stories/zjm-047.webp","left":103,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:15","scriptId":383,"text":"“聊完了没？”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:16","scriptId":383,"text":"“听凭教官吩咐……”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:383:17","scriptId":383,"text":"“那就废话不多了，跟我来吧。”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108010-EPILOGUE:10370:0","scriptId":10370,"text":"清理完面前的这批战车兽。","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-EPILOGUE:10370:2","scriptId":10370,"text":"“对你们这次瞒着我联络奈乐的事情，我就先放你们一马。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-EPILOGUE:10370:3","scriptId":10370,"text":"“多谢索菲亚教官宽宏大量！”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-EPILOGUE:10370:4","scriptId":10370,"text":"“但是……”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-EPILOGUE:10370:5","scriptId":10370,"text":"“但是？？”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":211,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-EPILOGUE:10370:6","scriptId":10370,"text":"“顺隆美尔司令的意思，猎虎小队是来学院参加实训演习的。”","background":"/art/stories/zjm-047.webp","left":211,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-EPILOGUE:10370:7","scriptId":10370,"text":"“作为放你们一马的代价就是，和猎虎小队一样参加实训演习。”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-EPILOGUE:10370:8","scriptId":10370,"text":"“诶！？”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-EPILOGUE:10370:9","scriptId":10370,"text":"“不会是夺旗战吧……”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-EPILOGUE:10370:10","scriptId":10370,"text":"“很懂行嘛，没错，这次实训就是夺旗战。”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108010-EPILOGUE:10370:11","scriptId":10370,"text":"所谓夺旗战，就是到达指定地点，夺取旗帜，并返回伏龙芝学院。","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108010-EPILOGUE:10370:12","scriptId":10370,"text":"因为旗帜只有寥寥数枚，所以为了争夺旗帜，小队与小队之间也会发生一定规模的对抗。","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":1,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:390:2","scriptId":390,"text":"“如果我们这次夺旗不成功，肯定会受到相当程度的惩罚吧……”","background":"/art/stories/zjm-090.webp","left":3,"right":3,"section":2,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:390:3","scriptId":390,"text":"“诶？教官不是说参加就行了吗。”","background":"/art/stories/zjm-090.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:390:4","scriptId":390,"text":"“你认为教官会那么容易放过我们么……”","background":"/art/stories/zjm-090.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:390:5","scriptId":390,"text":"“也对……”","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:390:6","scriptId":390,"text":"“那就先赶路吧……之前听奈乐说，我们因为中途参加已经比其他队伍晚了很多时间。”","background":"/art/stories/zjm-090.webp","left":71,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:391:2","scriptId":391,"text":"“如果我们这次夺旗不成功，肯定会受到相当程度的惩罚吧……”","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:391:3","scriptId":391,"text":"“诶？教官不是说参加就行了吗。”","background":"/art/stories/zjm-090.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:391:4","scriptId":391,"text":"“你认为教官会那么容易放过我们么……”","background":"/art/stories/zjm-090.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:391:5","scriptId":391,"text":"“也对……”","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:391:6","scriptId":391,"text":"“我们是中途参加的，应该比别的队伍慢了不少，加快点速度吧。”","background":"/art/stories/zjm-090.webp","left":1171,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:392:2","scriptId":392,"text":"“如果我们这次夺旗不成功，肯定会受到相当程度的惩罚吧……”","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:392:3","scriptId":392,"text":"“诶？教官不是说参加就行了吗。”","background":"/art/stories/zjm-090.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:392:4","scriptId":392,"text":"“你认为教官会那么容易放过我们么……”","background":"/art/stories/zjm-090.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:392:5","scriptId":392,"text":"“也对……”","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:392:6","scriptId":392,"text":"“如果没记错的话，现在已经开始比赛了，我们处于落后状态。”","background":"/art/stories/zjm-090.webp","left":1146,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:392:7","scriptId":392,"text":"“这倒不是大问题，反正是夺旗战，等别人把旗子送上门来就行了。”","background":"/art/stories/zjm-090.webp","left":1146,"right":968,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:393:2","scriptId":393,"text":"“如果我们这次夺旗不成功，肯定会受到相当程度的惩罚吧……”","background":"/art/stories/zjm-090.webp","left":3,"right":968,"section":2,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:393:3","scriptId":393,"text":"“诶？教官不是说参加就行了吗。”","background":"/art/stories/zjm-090.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:393:4","scriptId":393,"text":"“你认为教官会那么容易放过我们么……”","background":"/art/stories/zjm-090.webp","left":3,"right":41,"section":2,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:393:5","scriptId":393,"text":"“也对……”","background":"/art/stories/zjm-090.webp","left":3,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:393:6","scriptId":393,"text":"“不知道伏龙芝的夺旗战会激烈到什么程度。”","background":"/art/stories/zjm-090.webp","left":1170,"right":40,"section":2,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108011-PROLOGUE:393:7","scriptId":393,"text":"“伏龙芝也是豪强学院了，这种夺旗战肯定会比较有意思。”","background":"/art/stories/zjm-090.webp","left":1170,"right":1158,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108011-EPILOGUE:10380:1","scriptId":10380,"text":"看了看教官给的实训地图。","background":"/art/stories/zdbjbz-06.webp","left":1170,"right":1158,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-EPILOGUE:10380:2","scriptId":10380,"text":"“好远的路程……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":1158,"section":3,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108011-EPILOGUE:10380:3","scriptId":10380,"text":"“让你以前实训偷懒，现在出问题了吧。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":37,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-EPILOGUE:10380:4","scriptId":10380,"text":"“万万没想到我都升到少尉了……竟然还要徒步参加钢舞姬的实训，天理不公啊！”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":37,"section":3,"shake":false},{"kind":"dialogue","head":39,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108011-EPILOGUE:10380:5","scriptId":10380,"text":"“我会把这句话记下来告诉索菲亚教官的。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":39,"section":3,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108011-EPILOGUE:10380:6","scriptId":10380,"text":"“……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":39,"section":3,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:400:2","scriptId":400,"text":"“路上的战车兽真多……明明已经消灭掉了那么多。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":39,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:400:3","scriptId":400,"text":"“战车兽本身是可以进行大量无性繁殖的，因此作为兵器来说正适合不过。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:400:4","scriptId":400,"text":"“不斩草除根的话，还是很容易死灰复燃的。”","background":"/art/stories/zdbjbz-06.webp","left":71,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:400:5","scriptId":400,"text":"“所以各地战车兽的袭击事件还是特别多的，清扫不易啊。”","background":"/art/stories/zdbjbz-06.webp","left":71,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:400:6","scriptId":400,"text":"“打断一下，前方发现小群战车兽。”","background":"/art/stories/zdbjbz-06.webp","left":61,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:400:7","scriptId":400,"text":"“准备作战。”","background":"/art/stories/zdbjbz-06.webp","left":61,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:401:2","scriptId":401,"text":"“路上的战车兽真多……明明已经消灭掉了那么多。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:401:3","scriptId":401,"text":"“战车兽本身是可以进行大量无性繁殖的，因此作为兵器来说正适合不过。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:401:4","scriptId":401,"text":"“不斩草除根的话，还是很容易死灰复燃的。”","background":"/art/stories/zdbjbz-06.webp","left":71,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:401:5","scriptId":401,"text":"“所以各地战车兽的袭击事件还是特别多的，清扫不易啊。”","background":"/art/stories/zdbjbz-06.webp","left":71,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:401:6","scriptId":401,"text":"“各单位注意，发现战车兽了，在十二点钟方向。”","background":"/art/stories/zdbjbz-06.webp","left":1171,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:401:7","scriptId":401,"text":"“准备作战。”","background":"/art/stories/zdbjbz-06.webp","left":1171,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:402:2","scriptId":402,"text":"“路上的战车兽真多……明明已经消灭掉了那么多。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:402:3","scriptId":402,"text":"“战车兽本身是可以进行大量无性繁殖的，因此作为兵器来说正适合不过。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:402:4","scriptId":402,"text":"“人手不足啊，包围网不够密集的话经常会有逃掉的战车兽。”","background":"/art/stories/zdbjbz-06.webp","left":968,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:402:5","scriptId":402,"text":"“所以各地战车兽的袭击事件还是特别多的，清扫不易啊。”","background":"/art/stories/zdbjbz-06.webp","left":968,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:402:6","scriptId":402,"text":"“前方有战车兽的群落，已经快要进入有效射程了。”","background":"/art/stories/zdbjbz-06.webp","left":1146,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:402:7","scriptId":402,"text":"“准备作战。”","background":"/art/stories/zdbjbz-06.webp","left":1146,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":31,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:403:2","scriptId":403,"text":"“路上的战车兽真多……明明已经消灭掉了那么多。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:403:3","scriptId":403,"text":"“战车兽本身是可以进行大量无性繁殖的，因此作为兵器来说正适合不过。”","background":"/art/stories/zdbjbz-06.webp","left":31,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1170,"speaker":"夏虹萤","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:403:4","scriptId":403,"text":"“作战的时候一般都会连同巢穴一起焚毁，但有时候总会有漏网之鱼。”","background":"/art/stories/zdbjbz-06.webp","left":1170,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:403:5","scriptId":403,"text":"“所以各地战车兽的袭击事件还是特别多的，清扫不易啊。”","background":"/art/stories/zdbjbz-06.webp","left":1170,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":1158,"speaker":"陈雯兰","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:403:6","scriptId":403,"text":"“前面有战车兽出现了，数量还不少。”","background":"/art/stories/zdbjbz-06.webp","left":1158,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108012-PROLOGUE:403:7","scriptId":403,"text":"“准备作战。”","background":"/art/stories/zdbjbz-06.webp","left":1158,"right":3,"section":4,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-EPILOGUE:10390:1","scriptId":10390,"text":"“这样不行，拼速度应该是比不上前面的队伍。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":3,"section":5,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108012-EPILOGUE:10390:2","scriptId":10390,"text":"“还不是因为长官的脚程太慢。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-EPILOGUE:10390:3","scriptId":10390,"text":"“……”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108012-EPILOGUE:10390:4","scriptId":10390,"text":"（不得不说……佐伊说得确实有点道理……，我得想想办法。)","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":5,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108013-PROLOGUE:410:2","scriptId":410,"text":"对地图进行了一番仔细研究。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108013-PROLOGUE:410:3","scriptId":410,"text":"“现在对之后的路线进行修正，我们需要绕一下远路。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":40,"section":6,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108013-PROLOGUE:410:4","scriptId":410,"text":"“为什么啊？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":41,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108013-PROLOGUE:410:5","scriptId":410,"text":"“找辆交通工具呗……不然以我的速度，明显是拖累了大家。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":41,"section":6,"shake":false},{"kind":"dialogue","head":37,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108013-PROLOGUE:410:6","scriptId":410,"text":"“好吧，那接下来往哪里走呢？”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":37,"section":6,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108013-EPILOGUE:10400:0","scriptId":10400,"text":"“从地图上看，前面有个比较大的中继站，目前只能去那边碰碰运气了。”","background":"/art/stories/zdbjbz-06.webp","left":3,"right":37,"section":7,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108013-EPILOGUE:10400:1","scriptId":10400,"text":"于是我们就向着中继站前进了。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":37,"section":7,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108014-PROLOGUE:420:2","scriptId":420,"text":"大型中继站的规模真是庞大，感觉都快赶上临时司令部了","background":"/art/stories/zdbjbz-06.webp","left":3,"right":37,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108014-PROLOGUE:420:3","scriptId":420,"text":"从大型的防御工事到餐饮伙食应有尽有。","background":"/art/stories/zdbjbz-06.webp","left":3,"right":37,"section":8,"shake":false},{"kind":"dialogue","head":117,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108014-PROLOGUE:420:4","scriptId":420,"text":"“老板！再来杯黑啤～”","background":"/art/stories/zdbjbz-06.webp","left":117,"right":37,"section":8,"shake":false},{"kind":"dialogue","head":153,"speaker":"丽达·麦克阿瑟","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108014-PROLOGUE:420:5","scriptId":420,"text":"“顺便来两大瓶汽水～”","background":"/art/stories/zdbjbz-06.webp","left":153,"right":37,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108014-PROLOGUE:420:6","scriptId":420,"text":"“诶？这不是芙琳吗？你们怎么在这里？实训呢？”","background":"/art/stories/zdbjbz-06.webp","left":153,"right":3,"section":8,"shake":false},{"kind":"dialogue","head":115,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108014-PROLOGUE:420:7","scriptId":420,"text":"“哦呀，长官你们的事情已经办完了？”","background":"/art/stories/zdbjbz-06.webp","left":115,"right":3,"section":8,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108014-PROLOGUE:420:8","scriptId":420,"text":"“唉，一言难尽，我们现在也在实训中。”","background":"/art/stories/zdbjbz-06.webp","left":115,"right":3,"section":8,"shake":false},{"kind":"dialogue","head":124,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108014-PROLOGUE:420:9","scriptId":420,"text":"“嗯！？”","background":"/art/stories/zdbjbz-06.webp","left":124,"right":3,"section":8,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108014-PROLOGUE:420:10","scriptId":420,"text":"芙琳表现出非常警觉的神态，气氛突然变得剑拔弩张。","background":"/art/stories/zdbjbz-06.webp","left":124,"right":3,"section":8,"shake":false},{"kind":"dialogue","head":124,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108014-PROLOGUE:420:11","scriptId":420,"text":"“你们是来夺旗的！？”","background":"/art/stories/zdbjbz-06.webp","left":124,"right":3,"section":8,"shake":false},{"kind":"dialogue","head":120,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108014-EPILOGUE:10410:1","scriptId":10410,"text":"“哼，虽然输了，但是我们成功的拖延了你们，旗帜已经由其他人送回去了。”","background":"/art/stories/zdbjbz-06.webp","left":120,"right":3,"section":9,"shake":false},{"kind":"dialogue","head":132,"speaker":"达利波娃·戈沃罗夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108014-EPILOGUE:10410:2","scriptId":10410,"text":"“亏你们能预测到我们的返程路线。”","background":"/art/stories/zdbjbz-06.webp","left":132,"right":3,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108014-EPILOGUE:10410:3","scriptId":10410,"text":"“呃……我想说，我们不是来夺旗的……”","background":"/art/stories/zdbjbz-06.webp","left":132,"right":3,"section":9,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108014-EPILOGUE:10410:4","scriptId":10410,"text":"“我是想来这个大型中继站借辆军用吉普车而已……”","background":"/art/stories/zdbjbz-06.webp","left":132,"right":3,"section":9,"shake":false},{"kind":"dialogue","head":118,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108014-EPILOGUE:10410:5","scriptId":10410,"text":"“诶！？”","background":"/art/stories/zdbjbz-06.webp","left":118,"right":3,"section":9,"shake":false},{"kind":"dialogue","head":119,"speaker":"芙琳·勒布","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108014-EPILOGUE:10410:6","scriptId":10410,"text":"“这……真是不好意思……”","background":"/art/stories/zdbjbz-06.webp","left":119,"right":3,"section":9,"shake":false}],"summaries":["被索菲亚教官逮了个正着，挨批是在所难免了……","被迫参加实训演习，和猎虎小队暂时分道扬镳。","这次的夺旗战目的地非常之远，真是麻烦……","作战方针需要转换一下，先得找个靠谱的代步工具。","来到了大型中继站，看到了几张熟悉的面孔。"]}
