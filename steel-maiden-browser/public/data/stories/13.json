logue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:380:6","scriptId":380,"text":"“呃……奈乐还有莉娜！？”","background":"/art/stories/zjm-047.webp","left":103,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:380:7","scriptId":380,"text":"“嘻嘻嘻嘻……”","background":"/art/stories/zjm-047.webp","left":81,"right":40,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108010-PROLOGUE:380:8","scriptId":380,"text":"猎虎小队的出现，完全出乎了我们的意料。","background":"/art/stories/zjm-047.webp","left":81,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:380:9","scriptId":380,"text":"“我们并没有看到你进学院啊。”","background":"/art/stories/zjm-047.webp","left":81,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":61,"speaker":"莱尼·博克","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:380:10","scriptId":380,"text":"“是啊。”","background":"/art/stories/zjm-047.webp","left":81,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:380:11","scriptId":380,"text":"“我们是从后门进来的，都已经来了半天了，因为迟迟没看到你们，我就找索菲亚教官问了问情况。”","background":"/art/stories/zjm-047.webp","left":103,"right":61,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:380:12","scriptId":380,"text":"（我们这么完美的正门蹲点……奈乐竟然走后门……）","background":"/art/stories/zjm-047.webp","left":103,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:380:13","scriptId":380,"text":"“那个…事出有因，我们打算在正面的中继站等你的。”","background":"/art/stories/zjm-047.webp","left":103,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:380:14","scriptId":380,"text":"“聊完了没？”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:380:15","scriptId":380,"text":"“听凭教官吩咐……”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:380:16","scriptId":380,"text":"“那就废话不多了，跟我来吧。”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108010-PROLOGUE:381:2","scriptId":381,"text":"被索菲亚教官带到了会议室……","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:3","scriptId":381,"text":"“都进来吧”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:4","scriptId":381,"text":"“好……”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:5","scriptId":381,"text":"“哟，你们来啦。”","background":"/art/stories/zjm-047.webp","left":103,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:6","scriptId":381,"text":"“呃……奈乐还有莉娜！？”","background":"/art/stories/zjm-047.webp","left":103,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:7","scriptId":381,"text":"“嘻嘻嘻嘻……”","background":"/art/stories/zjm-047.webp","left":81,"right":40,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108010-PROLOGUE:381:8","scriptId":381,"text":"猎虎小队的出现，完全出乎了我们的意料。","background":"/art/stories/zjm-047.webp","left":81,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:9","scriptId":381,"text":"“我们并没有看到你进学院啊。”","background":"/art/stories/zjm-047.webp","left":81,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:10","scriptId":381,"text":"“你们是什么时候进来的？”","background":"/art/stories/zjm-047.webp","left":1171,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:11","scriptId":381,"text":"“正门我们应该是紧盯着的，根本没有队伍通过啊？”","background":"/art/stories/zjm-047.webp","left":1171,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:12","scriptId":381,"text":"“我们是从后门进来的，都已经来了半天了，因为迟迟没看到你们，我就找索菲亚教官问了问情况。”","background":"/art/stories/zjm-047.webp","left":103,"right":71,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:13","scriptId":381,"text":"（我们这么完美的正门蹲点……奈乐竟然走后门……）","background":"/art/stories/zjm-047.webp","left":103,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:14","scriptId":381,"text":"“那个…事出有因，我们打算在正面的中继站等你的。”","background":"/art/stories/zjm-047.webp","left":103,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:15","scriptId":381,"text":"“聊完了没？”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:16","scriptId":381,"text":"“听凭教官吩咐……”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:381:17","scriptId":381,"text":"“那就废话不多了，跟我来吧。”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108010-PROLOGUE:382:2","scriptId":382,"text":"被索菲亚教官带到了会议室……","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":219,"speaker":"索菲亚·马利诺夫娜","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:382:3","scriptId":382,"text":"“都进来吧”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:382:4","scriptId":382,"text":"“好……”","background":"/art/stories/zjm-047.webp","left":219,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:382:5","scriptId":382,"text":"“哟，你们来啦。”","background":"/art/stories/zjm-047.webp","left":103,"right":3,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:382:6","scriptId":382,"text":"“呃……奈乐还有莉娜！？”","background":"/art/stories/zjm-047.webp","left":103,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":81,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:382:7","scriptId":382,"text":"“嘻嘻嘻嘻……”","background":"/art/stories/zjm-047.webp","left":81,"right":40,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"108010-PROLOGUE:382:8","scriptId":382,"text":"猎虎小队的出现，完全出乎了我们的意料。","background":"/art/stories/zjm-047.webp","left":81,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":41,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:382:9","scriptId":382,"text":"“我们并没有看到你进学院啊。”","background":"/art/stories/zjm-047.webp","left":81,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":1146,"speaker":"嘉丝莉·鲍恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:382:10","scriptId":382,"text":"“学院的大门都没打开过，你们是怎么进去的？”","background":"/art/stories/zjm-047.webp","left":1146,"right":41,"section":0,"shake":false},{"kind":"dialogue","head":968,"speaker":"索菲·阿登","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"108010-PROLOGUE:382:11","scriptId":382,"t