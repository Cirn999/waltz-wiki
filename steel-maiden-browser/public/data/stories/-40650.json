{"schemaVersion":1,"id":-40650,"sections":[{"id":"script-20650","name":"原始脚本 20650","scripts":[20650],"start":0,"count":87}],"frames":[{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:1","scriptId":20650,"text":"“刚才收到了一份钢舞姬失踪的报告……”","background":"/art/stories/zjm-098.webp","left":547,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:2","scriptId":20650,"text":"维多利亚拿着一份报告书，脸色有点不太好看。","background":"/art/stories/zjm-098.webp","left":547,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:3","scriptId":20650,"text":"“怎么了？钢舞姬失踪不是挺平常的事情么，我记得之前也有好几份失踪名单来着。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:4","scriptId":20650,"text":"（无论是死水还是特勤局都会有一些钢舞姬失踪。）","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:5","scriptId":20650,"text":"“如果只是失踪报告的话，我也没什么可多说的。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:6","scriptId":20650,"text":"维多利亚把失踪报告翻了一页，然后往桌上一扔。","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:7","scriptId":20650,"text":"“除了失踪报告以外还有一份多福莱尼发过来的自荐信。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:8","scriptId":20650,"text":"“哦？那个号称什么地方都能送到的铁道工会？略有耳闻。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:9","scriptId":20650,"text":"“说是可以定期为我们提供失踪钢舞姬的所在位置。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:10","scriptId":20650,"text":"“有意思，他们竟然有连我们都没法弄到的情报？”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:11","scriptId":20650,"text":"“虽然不知道是真是假……”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:12","scriptId":20650,"text":"“看样子你已经有想法了？”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:13","scriptId":20650,"text":"“让那小子去试试吧，顺便也让他调查一下多福莱尼铁道工会。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:14","scriptId":20650,"text":"“搞不好这可是个危险的任务啊，让我去如何？”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:15","scriptId":20650,"text":"“正因为存在着危险，才更应该派他去。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":980,"speaker":"蒂娅·温莎","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:16","scriptId":20650,"text":"“哼，真是器重啊，让我都有点嫉妒了呢。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:17","scriptId":20650,"text":"“你就是想借调查的名义出去乱搞，我可不吃你这套。”","background":"/art/stories/zjm-098.webp","left":547,"right":980,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:20","scriptId":20650,"text":"几天后，","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:21","scriptId":20650,"text":"死水会议室中——","background":"/art/stories/zjm-047.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:22","scriptId":20650,"text":"“这次任务是寻找钢舞姬。”","background":"/art/stories/zjm-047.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:23","scriptId":20650,"text":"“难道是寻人任务？我以前看扎莉她们做过，好像挺费劲的呢。”","background":"/art/stories/zjm-047.webp","left":572,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:24","scriptId":20650,"text":"“嗯，就是寻人任务，但完成时间不限。”","background":"/art/stories/zjm-047.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:25","scriptId":20650,"text":"“这种任务可不是我们的强项啊，真的不要紧吗？”","background":"/art/stories/zjm-047.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:26","scriptId":20650,"text":"“是的，除了维卡以外我们队伍的追踪能力都很一般。”","background":"/art/stories/zjm-047.webp","left":591,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:27","scriptId":20650,"text":"“但找人绝对不轻松。”","background":"/art/stories/zjm-047.webp","left":591,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:28","scriptId":20650,"text":"维卡也给出了否定的看法。","background":"/art/stories/zjm-047.webp","left":591,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:29","scriptId":20650,"text":"“对啊，我们基本没接触过寻人任务。”","background":"/art/stories/zjm-047.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:30","scriptId":20650,"text":"“但……这次是团长的命令，我不太方便拒绝。”","background":"/art/stories/zjm-047.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":746,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:31","scriptId":20650,"text":"“啊？团长命令？”","background":"/art/stories/zjm-047.webp","left":4,"right":746,"section":0,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:32","scriptId":20650,"text":"“这样啊……确实不好拒绝，但团长应该知道我们不擅长寻人吧，那为什么……”","background":"/art/stories/zjm-047.webp","left":4,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:33","scriptId":20650,"text":"“呃……就是锻炼一下我们？全面发展之类的？？”","background":"/art/stories/zjm-047.webp","left":4,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:34","scriptId":20650,"text":"“总觉得怪怪的。”","background":"/art/stories/zjm-047.webp","left":4,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:35","scriptId":20650,"text":"（肯定不是啦，调查多福莱尼的次要任务目前还不能告诉你们，特别是管不住嘴的佐伊。）","background":"/art/stories/zjm-047.webp","left":4,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:36","scriptId":20650,"text":"“当然，这次是有外援帮忙的，不然我也不想接这种麻烦的任务。”","background":"/art/stories/zjm-047.webp","left":4,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":746,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:37","scriptId":20650,"text":"“外援是……？”","background":"/art/stories/zjm-047.webp","left":4,"right":746,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:38","scriptId":20650,"text":"“具体情况明天去了就知道了。”","background":"/art/stories/zjm-047.webp","left":4,"right":746,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:41","scriptId":20650,"text":"隔天一早，带着佐伊她们到达指定接头地点——","background":"/art/stories/zdbjbz-14.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:42","scriptId":20650,"text":"“我们不是要找外援吗？怎么到这种偏僻的地方？”","background":"/art/stories/zdbjbz-14.webp","left":null,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:43","scriptId":20650,"text":"“嗯，因为要和多福莱尼铁道工会的人碰个头，听团长说他们会提供失踪钢舞姬的线索。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:44","scriptId":20650,"text":"“啊？原来是有线索的啊？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:45","scriptId":20650,"text":"“不过具体还得等见面了才知道。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:46","scriptId":20650,"text":"“多福莱尼？”","background":"/art/stories/zdbjbz-14.webp","left":596,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:47","scriptId":20650,"text":"“这个运输组织上过几次报纸，不过我也没关心过，长官知道吗？”","background":"/art/stories/zdbjbz-14.webp","left":596,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:48","scriptId":20650,"text":"“说来惭愧，要不是团长跟我说，我都不知道有这么个组织……所以他们的情况我更不清楚了。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:49","scriptId":20650,"text":"“多福莱尼？我知道啊，自诩是最安全最权威的运输组织，对外宣称没有送不到的地方。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:50","scriptId":20650,"text":"“本来只是个小小的货运公司，但现在已经发展成庞大的工会，另外他们的运输费非常昂贵。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:51","scriptId":20650,"text":"“对哦，奈特莉你以前的职业也算是和运输业相关的工作。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:52","scriptId":20650,"text":"“嗯哼~正是如此~特别是这种行业新闻，我一直都有关心。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":578,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:53","scriptId":20650,"text":"远处传来引擎的轰鸣，一辆大型装甲运输车出现在大家的视线里。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":578,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:54","scriptId":20650,"text":"“看样子是多福莱尼的人来了。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":578,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:55","scriptId":20650,"text":"“哦呀~那么大的运输车啊。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:57","scriptId":20650,"text":"很快，运输车就驶到附近的一处空地并停了下来。","background":"/art/stories/zdbjbz-14.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:58","scriptId":20650,"text":"从车上快步走下一名戴着面罩的女性，手里好像还拿着一个文件袋。","background":"/art/stories/zdbjbz-14.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:59","scriptId":20650,"text":"“你好，我是菲尼克斯，多福莱尼铁道工会的代理人。”","background":"/art/stories/zdbjbz-14.webp","left":null,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:60","scriptId":20650,"text":"“你好，我是死水的——","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:61","scriptId":20650,"text":"“介绍就不必了，你的资料我已经都看过了。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:62","scriptId":20650,"text":"“人比照片上要俊俏不少，部队成员就这些吗？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:63","scriptId":20650,"text":"“是的。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:64","scriptId":20650,"text":"菲尼克斯开始清点人数同时还确认了佐伊她们的舞装资料。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:65","scriptId":20650,"text":"“嗯，和给到的运单资料吻合，没有特殊的运输物件，可以批准运送。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:66","scriptId":20650,"text":"“那个……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:67","scriptId":20650,"text":"“每次发货前我们都会派专车去死水接你们，届时请保证人员数量与现在一致。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:68","scriptId":20650,"text":"“好的，那个……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:69","scriptId":20650,"text":"“当然如果发生变动，我们也会根据变动调整运输费用。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:70","scriptId":20650,"text":"菲尼克斯口吐连珠，根本不给插嘴的机会。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:71","scriptId":20650,"text":"“根据我对你们小队的现场评估，运输费是这个数字，没有问题的话，就在这纸上签个字。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:72","scriptId":20650,"text":"菲尼克斯从文件袋里快速取出一份签单。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:73","scriptId":20650,"text":"“哦，好的。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:74","scriptId":20650,"text":"看了看签单上的数字，比想象中的要贵出许多。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:75","scriptId":20650,"text":"“那个……这运输费是不是错了？怎么那么贵？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:76","scriptId":20650,"text":"“这里面包含了失踪人员的情报提供费用，请仔细阅读条款，最下面的附加栏里有写明。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:77","scriptId":20650,"text":"“哦啊，看到了，作为情报费用的话，这个数字倒是可以接受。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:78","scriptId":20650,"text":"“那请签字吧。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:79","scriptId":20650,"text":"“好的。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:80","scriptId":20650,"text":"签完字后，菲尼克斯收走了签单并加以确认。","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:81","scriptId":20650,"text":"“确认完毕，那今天就这样，我接下来还要去下一个地方，就此别过。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:82","scriptId":20650,"text":"“诶？就这些……？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:83","scriptId":20650,"text":"“是的，还有其他疑问吗？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:84","scriptId":20650,"text":"“那为什么要在这里碰面？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:85","scriptId":20650,"text":"“因为顺路，还有其他疑问吗？”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:86","scriptId":20650,"text":"“呃……没了。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:87","scriptId":20650,"text":"“得到失踪钢舞姬情报之后会第一时间联络你。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:88","scriptId":20650,"text":"“好的，知道了。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:89","scriptId":20650,"text":"“那我们下次再见吧。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20650:20650:91","scriptId":20650,"text":"说完，菲尼克斯便搭着来时的装甲运输车离开了。","background":"/art/stories/zdbjbz-14.webp","left":null,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:92","scriptId":20650,"text":"“真是个匆忙的人……”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20650:20650:93","scriptId":20650,"text":"“我倒是觉得她是个优秀的代理人，工作很效率。”","background":"/art/stories/zdbjbz-14.webp","left":4,"right":584,"section":0,"shake":false}],"summaries":[]}
