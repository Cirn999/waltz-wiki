{"schemaVersion":1,"id":-40760,"sections":[{"id":"script-20760","name":"原始脚本 20760","scripts":[20760],"start":0,"count":45}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20760:20760:1","scriptId":20760,"text":"夏威夷——","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20760:20760:2","scriptId":20760,"text":"一位身着黑色哥特服饰的小姑娘来到了死水夏威夷基地附近的一处海滩。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20760:20760:3","scriptId":20760,"text":"而等在那里迎接她的是旅行者兰布达。","background":"/art/stories/zjm-101.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:4","scriptId":20760,"text":"“好久不见了，缪。”","background":"/art/stories/zjm-101.webp","left":1198,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:5","scriptId":20760,"text":"“在地球上我们这是第一次见面吧，兰布达。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:6","scriptId":20760,"text":"“那个……你这副身体的大小？是哪里有欠缺吗？”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:7","scriptId":20760,"text":"“怎么可能？这副身躯比较容易混入人类群体罢了。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:8","scriptId":20760,"text":"“反倒是你，我差点都认不出了呢，人类的衣服很适合你啊。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:9","scriptId":20760,"text":"“……”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:10","scriptId":20760,"text":"“这是阿尔库涅大人设计的款式，能穿上它是我的光荣。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20760:20760:11","scriptId":20760,"text":"缪向兰布达投来了惊讶的目光。","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:12","scriptId":20760,"text":"“哦？看来那位大人醉心于人类的事情是真的啊，我还以为是菲的玩笑话呢。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:13","scriptId":20760,"text":"“这么多年了，你难道只和菲进行过联系？”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:14","scriptId":20760,"text":"“只是最近遇到过她而已，不算是定期联络。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:15","scriptId":20760,"text":"“我隶属于梅洛佩大人，在没有接到强制命令前还是以单独行动为主。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:16","scriptId":20760,"text":"“照你这么说，在召集的下位里也确实没有你的名字。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:17","scriptId":20760,"text":"“我的任务是收集地球人的信息情报，包括历史文化之类的。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:18","scriptId":20760,"text":"“那工作量还是挺大……”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:19","scriptId":20760,"text":"“这点不算什么啦，我可是专门干这个的。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20760:20760:20","scriptId":20760,"text":"缪提了提她手里的拉杆箱，那是她的专属骸虫，拟态是一只考克箱。","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:21","scriptId":20760,"text":"“大部分的资料都已经通过这家伙制造的小型虫洞传输给梅洛佩大人了。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:22","scriptId":20760,"text":"“也对，你的能力是实体化记忆……”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:23","scriptId":20760,"text":"“那么该进入正题了，叫我来这儿有什么事吗？还是说偶尔发现了我的信号过来叙叙旧的？”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:24","scriptId":20760,"text":"“当然不是，最近阿尔库涅大人和泰莱塔大人不是因为死水的问题发生了小冲突吗？”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:25","scriptId":20760,"text":"“嗯，听菲说过，这件事我正在犹豫是不是要通知梅洛佩大人。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:26","scriptId":20760,"text":"“我可以把目前的记忆共享给你，这样也可以作为你的判断依据。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:27","scriptId":20760,"text":"“喔？有这么好的事情？”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:28","scriptId":20760,"text":"“因为用说的实在是太复杂了，还是直接读取记忆会方便理解。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:29","scriptId":20760,"text":"“既然你都这么说了，那我就不客气咯。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20760:20760:30","scriptId":20760,"text":"于是缪将自己的右手伸向兰布达的胸口，与此同时兰布达全身开始泛起淡淡的白光。","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20760:20760:31","scriptId":20760,"text":"兰布达全身的白光向着缪的右手聚集，慢慢地形成了一粒葡萄大小的光球。","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:32","scriptId":20760,"text":"“容量还不小呢，我来尝尝。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20760:20760:33","scriptId":20760,"text":"缪张开嘴将光球投入口中，一口气吞了下去。","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:34","scriptId":20760,"text":"“怎么样？”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:35","scriptId":20760,"text":"“……”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:36","scriptId":20760,"text":"“…………”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20760:20760:37","scriptId":20760,"text":"缪沉默了几秒后，终于开口了。","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:38","scriptId":20760,"text":"“真是不得了，原来发生了那么多事啊……”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:39","scriptId":20760,"text":"“所以我——","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:40","scriptId":20760,"text":"“要我去调查死水的那个指挥官是吧？没问题。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20760:20760:41","scriptId":20760,"text":"还没等兰布达开口，缪已经从记忆中读到了她的意图。","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:42","scriptId":20760,"text":"“竟然那么爽快就答应了？”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:43","scriptId":20760,"text":"“毕竟不会影响我原本的工作，而且看上去还挺有意思的，没理由不答应啊。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1198,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:44","scriptId":20760,"text":"“嗯，那就这么定了，近期内我会安排你和他见面的。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false},{"kind":"dialogue","head":1203,"speaker":"缪","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20760:20760:45","scriptId":20760,"text":"“哼哼，就放心交给我吧。”","background":"/art/stories/zjm-101.webp","left":1198,"right":1203,"section":0,"shake":false}],"summaries":[]}
