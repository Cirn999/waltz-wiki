{"schemaVersion":1,"id":-20012,"sections":[{"id":"script-12","name":"原始脚本 12","scripts":[12],"start":0,"count":7}],"frames":[{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-12:12:1","scriptId":12,"text":"“认识一下，我是拉伊莎·斯维特兰娜，负责这片区域的侦察工作。旁边这位是卓娅·朱可娃。","background":"/art/stories/zjm-166.webp","left":71,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-12:12:2","scriptId":12,"text":"“你好，我是卓娅，隶属边防小队，正巧在斯特拉斯堡办事。”","background":"/art/stories/zjm-166.webp","left":71,"right":1171,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-12:12:3","scriptId":12,"text":"“她是佐伊·谢尔曼，情况非常，介绍就到这里。”","background":"/art/stories/zjm-166.webp","left":3,"right":1171,"section":0,"shake":false},{"kind":"dialogue","head":40,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-12:12:4","scriptId":12,"text":"“诶！？就这么省略掉了？”","background":"/art/stories/zjm-166.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":3,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-12:12:5","scriptId":12,"text":"“那接下来的战斗就拜托两位了。”","background":"/art/stories/zjm-166.webp","left":3,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":1171,"speaker":"卓娅·朱可娃","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-12:12:6","scriptId":12,"text":"“好嘞。”","background":"/art/stories/zjm-166.webp","left":1171,"right":40,"section":0,"shake":false},{"kind":"dialogue","head":71,"speaker":"拉伊莎·斯大林","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-12:12:7","scriptId":12,"text":"“了解。”","background":"/art/stories/zjm-166.webp","left":1171,"right":71,"section":0,"shake":false}],"summaries":[]}
