{"schemaVersion":1,"id":-40010,"sections":[{"id":"script-20010","name":"原始脚本 20010","scripts":[20010],"start":0,"count":8}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20010:20010:1","scriptId":20010,"text":"德尔塔的位置——","background":"/art/stories/zdbjbz-16.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":62,"speaker":"德尔塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20010:20010:2","scriptId":20010,"text":"（虽然我对人类弄出来的数据没啥兴趣，不过既然是兰布达的要求……先做着吧。）","background":"/art/stories/zdbjbz-16.webp","left":62,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20010:20010:3","scriptId":20010,"text":"这时一个电波信号传到了德尔塔的脑袋中。","background":"/art/stories/zdbjbz-16.webp","left":62,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20010:20010:4","scriptId":20010,"text":"“德尔塔，你在哪里，奥米克戎正在找你呢。”","background":"/art/stories/zdbjbz-16.webp","left":62,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":62,"speaker":"德尔塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20010:20010:5","scriptId":20010,"text":"“诶！？”","background":"/art/stories/zdbjbz-16.webp","left":62,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":62,"speaker":"德尔塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20010:20010:6","scriptId":20010,"text":"“那个……我大概还要个半小时左右吧。你就和奥米克戎说，我正忙着帮兰布达收集数据……”","background":"/art/stories/zdbjbz-16.webp","left":62,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20010:20010:7","scriptId":20010,"text":"“哦，我知道了，那尽量快点吧，奥米克戎好像挺急的。”","background":"/art/stories/zdbjbz-16.webp","left":62,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":62,"speaker":"德尔塔","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20010:20010:8","scriptId":20010,"text":"“收到收到……马上搞定。”","background":"/art/stories/zdbjbz-16.webp","left":62,"right":430,"section":0,"shake":false}],"summaries":[]}
