{"schemaVersion":1,"id":-40599,"sections":[{"id":"script-20599","name":"原始脚本 20599","scripts":[20599],"start":0,"count":87}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:2","scriptId":20599,"text":"在一间由仓库改造的实验室里，兰布达正进行着某项实验。","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:3","scriptId":20599,"text":"“还没好吗？这个姿势很难受啊。”","background":"/art/stories/zjm-094.webp","left":430,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:4","scriptId":20599,"text":"“快了，生物细胞样本采取率90%...91…92…93…”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:5","scriptId":20599,"text":"在短暂的倒计时之后，兰布达关闭了生态侦测仪和样本收集机。","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:6","scriptId":20599,"text":"“好了，样本都已经采取完毕，你可以下来了。”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:7","scriptId":20599,"text":"“哦。”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:8","scriptId":20599,"text":"柯西“噌”地一下跳到了正在一旁待机的骸虫背上。","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:9","scriptId":20599,"text":"“这样就行了吗？”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:10","scriptId":20599,"text":"“是的。大约三个月左右就可以弄出成品。”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:11","scriptId":20599,"text":"“三个月？比起骸虫来还是慢了点。对了，听说上次伊塔的失败品被你处理了？”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:12","scriptId":20599,"text":"“……”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:13","scriptId":20599,"text":"“是的。”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:14","scriptId":20599,"text":"“当做骸虫饲料还是其他的什么？？”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:15","scriptId":20599,"text":"柯西拍了拍自己身下的骸虫，骸虫也与之相应发出了嘶嘶的喘息声。","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:16","scriptId":20599,"text":"“这和你无关。”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:17","scriptId":20599,"text":"“不用那么警惕，毕竟这之后做出的东西怎么说也算是我的后代吧，多少想知道下。”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:18","scriptId":20599,"text":"“……”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:19","scriptId":20599,"text":"“等到完成的时候我会通知你。”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:20","scriptId":20599,"text":"“那就等你消息了~”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:21","scriptId":20599,"text":"“我传送你出去吧，省得被人看见。”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:22","scriptId":20599,"text":"“也好，你用传送的话省得我开伪装了。”","background":"/art/stories/zjm-094.webp","left":430,"right":56,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:24","scriptId":20599,"text":"三个月一眨眼就过去了——","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:25","scriptId":20599,"text":"新的实验体已经培养完毕，兰布达和柯西又聚到了一起。","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:26","scriptId":20599,"text":"“……”","background":"/art/stories/zjm-094.webp","left":56,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:27","scriptId":20599,"text":"“这是怎么回事……”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:28","scriptId":20599,"text":"柯西指着大型培养槽中的生物说道。","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:29","scriptId":20599,"text":"“这家伙是不是成长发育得有些过分了？”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:30","scriptId":20599,"text":"“可能出了点问题。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:31","scriptId":20599,"text":"“比我这个原版都要丰满和健壮，你到底加了什么东西？”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:32","scriptId":20599,"text":"“因为之前伊塔ZWEI的失败，所以我这次多投入了一些培养原料。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:33","scriptId":20599,"text":"“所以这次就过量了？”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:34","scriptId":20599,"text":"“……”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:35","scriptId":20599,"text":"“目前看来是这样……”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:36","scriptId":20599,"text":"“唉，又是缺陷品咯。那是要处分了吗？”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:37","scriptId":20599,"text":"“……”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:38","scriptId":20599,"text":"“我想看看处分的过程或者说让我亲自处分也可以~”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:39","scriptId":20599,"text":"柯西还是一如既往的恶趣味，不过兰布达早就已经习惯了。","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:40","scriptId":20599,"text":"“就算是缺陷品还是有一定的使用价值。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:41","scriptId":20599,"text":"“哦？那你的意思是？”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:42","scriptId":20599,"text":"兰布达一边调整培养槽，一边继续说道。","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:43","scriptId":20599,"text":"“我打算把她安置在死水，然后做进一步的测试。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:44","scriptId":20599,"text":"“什么？放人类那里？”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:45","scriptId":20599,"text":"“是的。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:46","scriptId":20599,"text":"“你疯了？没必要给人类提供多余的帮助吧。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:47","scriptId":20599,"text":"“算是一种合作吧，不过我想你应该没有兴趣。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:48","scriptId":20599,"text":"“……”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:49","scriptId":20599,"text":"柯西看着培养皿中的实验体沉默了片刻。","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:50","scriptId":20599,"text":"“这家伙还没有编入思维模式和记忆吗？”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:51","scriptId":20599,"text":"“是的，这个我之后会着手准备。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:52","scriptId":20599,"text":"“那正好，操作记忆可是我的拿手好戏。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:53","scriptId":20599,"text":"“你要干什么？”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:54","scriptId":20599,"text":"“既然是我的实验体，那就作为我的手脚活下去好了。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:55","scriptId":20599,"text":"柯西切断了培养槽的供给，由于是非正常中断，浅绿色的培养液直接漏出了容器并开始快速汽化。","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:56","scriptId":20599,"text":"由于这突发情况，兰布达一时间慌了手脚。","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:57","scriptId":20599,"text":"“柯西！？”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:58","scriptId":20599,"text":"过了一会儿，气体开始散去，只能看到柯西正站在实验体旁边。","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:59","scriptId":20599,"text":"当兰布达还在吃惊的时候，实验体先开了口。","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":1131,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:60","scriptId":20599,"text":"“培养液汽化后有种刺刺的感觉，估计还要洗一洗，好像还有点味道。”","background":"/art/stories/zjm-094.webp","left":56,"right":1131,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:61","scriptId":20599,"text":"“！！”","background":"/art/stories/zjm-094.webp","left":56,"right":1131,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:62","scriptId":20599,"text":"实验体展现出了明明不该存在的记忆和思维模式。","background":"/art/stories/zjm-094.webp","left":56,"right":1131,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:63","scriptId":20599,"text":"“柯西！！”","background":"/art/stories/zjm-094.webp","left":56,"right":1131,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:64","scriptId":20599,"text":"兰布达这么一吼，奇妙的事情发生了——柯西和实验体两人同时都看向兰布达。","background":"/art/stories/zjm-094.webp","left":56,"right":1131,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:65","scriptId":20599,"text":"“你叫哪个？？”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":1131,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:66","scriptId":20599,"text":"“我觉得她是在叫你。”","background":"/art/stories/zjm-094.webp","left":56,"right":1131,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:67","scriptId":20599,"text":"“也对。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:68","scriptId":20599,"text":"“柯西，你难道……用了记忆复制？”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:69","scriptId":20599,"text":"“嗯，你猜对了，我把自己的记忆复写给了实验体，所以现在的她就是我。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:70","scriptId":20599,"text":"（果然让柯西参与实验是一件错误的事情。）","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:71","scriptId":20599,"text":"“对了，这实验体不能算失败吧，身体素质很高，作为战斗型歼灭姬应该没有任何问题。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:72","scriptId":20599,"text":"“…………你这家伙。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:73","scriptId":20599,"text":"“别生气，我同意你的意见，把实验体交给死水好了，我正好可以顺便观察下你所中意的人类。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:74","scriptId":20599,"text":"说到这里，实验体很流畅地接过了话柄，就好似她和柯西是一个人。","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":1131,"speaker":"？？？","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:75","scriptId":20599,"text":"“为了方便称呼，我就叫柯西ZWEI吧，就按你的命名习惯来。”","background":"/art/stories/zjm-094.webp","left":56,"right":1131,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:76","scriptId":20599,"text":"“真是自说自话，那武器怎么办，还要为你培养独立的大型运载骸虫？”","background":"/art/stories/zjm-094.webp","left":56,"right":1131,"section":0,"shake":false},{"kind":"dialogue","head":1130,"speaker":"柯西ZWEI","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:77","scriptId":20599,"text":"“这个啊……大型运载骸虫就算了，但新的骸虫装备还是要拜托你制作的，毕竟这个身体不能使用记忆操作。”","background":"/art/stories/zjm-094.webp","left":56,"right":1130,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:78","scriptId":20599,"text":"“唉，又要浪费不必要的泡虫……”","background":"/art/stories/zjm-094.webp","left":56,"right":1130,"section":0,"shake":false},{"kind":"dialogue","head":1130,"speaker":"柯西ZWEI","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:79","scriptId":20599,"text":"“反正你私底下养了很多泡虫吧，拿出来一些也没关系啦~”","background":"/art/stories/zjm-094.webp","left":56,"right":1130,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:80","scriptId":20599,"text":"“啧，知道了，我会给你准备泡虫的。”","background":"/art/stories/zjm-094.webp","left":56,"right":1130,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:81","scriptId":20599,"text":"“好了，我觉得这里应该没我事了，我先回去了。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":430,"speaker":"柯西","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:82","scriptId":20599,"text":"“只要没死，她和我连接是不会切断的。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:83","scriptId":20599,"text":"说完柯西就开启了伪装模式，融入到了周围的环境之中。","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":56,"speaker":"兰布达","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"script-20599:20599:84","scriptId":20599,"text":"“但这件事你可别告诉泰莱塔大人，不然我们都会有麻烦。”","background":"/art/stories/zjm-094.webp","left":56,"right":430,"section":0,"shake":false},{"kind":"dialogue","head":1130,"speaker":"柯西ZWEI","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"script-20599:20599:85","scriptId":20599,"text":"“知道啦，我的口风可比埃普西隆紧多了，别紧张。”","background":"/art/stories/zjm-094.webp","left":56,"right":1130,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:86","scriptId":20599,"text":"回答的是柯西ZWEI，但这感觉确实就是在和柯西对话。","background":"/art/stories/zjm-094.webp","left":56,"right":1130,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:87","scriptId":20599,"text":"兰布达只得无奈地叹了口气——死水的麻烦又增加了一个。","background":"/art/stories/zjm-094.webp","left":56,"right":1130,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:89","scriptId":20599,"text":"这之后，由于柯西ZWEI的加入，死水又增加了不俗的战力。","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"script-20599:20599:90","scriptId":20599,"text":"但同时死水的相当一部分情报都经由柯西ZWEI流到了柯西的手里……","background":"/art/stories/zjm-094.webp","left":null,"right":null,"section":0,"shake":false}],"summaries":[]}
