{"schemaVersion":1,"id":406,"sections":[{"id":"925001-OPENING","name":"第 1 战 · 开场","scripts":[20672],"start":0,"count":70},{"id":"925001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20691],"start":70,"count":16},{"id":"925001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20692],"start":86,"count":34}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:1","scriptId":20672,"text":"","background":"/art/stories/zjm-098.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:2","scriptId":20672,"text":"“你说什么？”","background":"/art/stories/zjm-098.webp","left":547,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:3","scriptId":20672,"text":"“不仅仅是运输和情报的费用，死水通过救援还获得了宝贵的战斗力不是吗？”","background":"/art/stories/zjm-098.webp","left":547,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:4","scriptId":20672,"text":"“额外追加一些报酬也在情理之中吧。”","background":"/art/stories/zjm-098.webp","left":547,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":556,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:5","scriptId":20672,"text":"“你这哪是‘一些’？简直狮子大开口，我们没有理由付双份的情报费。”","background":"/art/stories/zjm-098.webp","left":556,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:6","scriptId":20672,"text":"“但这次的目标本来就是你们死水的人，而且T-103舞装也是重要的实验舞装吧？就这么丢了真的好吗？”","background":"/art/stories/zjm-098.webp","left":556,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:7","scriptId":20672,"text":"“……”","background":"/art/stories/zjm-098.webp","left":547,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":554,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:8","scriptId":20672,"text":"（这家伙知道的还挺多……看来情报管控有点松懈了。）","background":"/art/stories/zjm-098.webp","left":554,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:9","scriptId":20672,"text":"T-103舞装是前阵子波西娅正在着手研发的一款新舞装，搭载了全新的防御支架，可以抵挡更多的炮火攻击。","background":"/art/stories/zjm-098.webp","left":554,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:10","scriptId":20672,"text":"不过在该舞装运输途中发生山体滑坡，运输车被卷入了泥石流之中，除司机以外，T-103舞装和其使用者都一同滚落到了谷底。","background":"/art/stories/zjm-098.webp","left":554,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:11","scriptId":20672,"text":"虽然派出了几批部队进行搜救，但最终毫无收获，于是只得将T-103定义为下落不明。","background":"/art/stories/zjm-098.webp","left":554,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:12","scriptId":20672,"text":"“这件事可以转告给波西娅，我想她一定会很乐意支付这笔额外的情报费。”","background":"/art/stories/zjm-098.webp","left":554,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:13","scriptId":20672,"text":"“……”","background":"/art/stories/zjm-098.webp","left":547,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":552,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:14","scriptId":20672,"text":"“不必了，T-103的情报费我们死水会承担的。”","background":"/art/stories/zjm-098.webp","left":552,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:15","scriptId":20672,"text":"“但只此一次。”","background":"/art/stories/zjm-098.webp","left":547,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:16","scriptId":20672,"text":"“我们就喜欢爽快的客户。”","background":"/art/stories/zjm-098.webp","left":547,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:17","scriptId":20672,"text":"“作为优惠，我们会赠送一只多福莱尼猎犬，有了它——","background":"/art/stories/zjm-098.webp","left":547,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:18","scriptId":20672,"text":"“好的，我知道了，猎犬的事情你就直接跟交接的队伍去说吧，细节我并没兴趣。”","background":"/art/stories/zjm-098.webp","left":547,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:19","scriptId":20672,"text":"“好吧，听您的。”","background":"/art/stories/zjm-098.webp","left":547,"right":1133,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:20","scriptId":20672,"text":"维多利亚在协议书上签下了自己的名字，然后交给了菲尼克斯。","background":"/art/stories/zjm-098.webp","left":547,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":1133,"speaker":"菲尼克斯","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:21","scriptId":20672,"text":"“谢谢惠顾。”","background":"/art/stories/zjm-098.webp","left":547,"right":1133,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:24","scriptId":20672,"text":"“这次的任务是寻找T-103舞装的使用者——齐奈达·维尔金斯卡娅”","background":"/art/stories/zjm-099.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":579,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:25","scriptId":20672,"text":"“哦？T-103舞装？我知道啊？她竟然失踪了？”","background":"/art/stories/zjm-099.webp","left":4,"right":579,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:26","scriptId":20672,"text":"“这是照片和一些个人资料。”","background":"/art/stories/zjm-099.webp","left":4,"right":579,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:27","scriptId":20672,"text":"我把一个文件袋交给奈特莉。","background":"/art/stories/zjm-099.webp","left":4,"right":579,"section":0,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:28","scriptId":20672,"text":"“对对，就是她。那时候陪着波西娅测试过，那副装甲非常坚固，用通常弹根本无法击穿。”","background":"/art/stories/zjm-099.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:29","scriptId":20672,"text":"奈特莉确认了照片上的人物。","background":"/art/stories/zjm-099.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:30","scriptId":20672,"text":"“你这又是什么时候去赚的外快……”","background":"/art/stories/zjm-099.webp","left":4,"right":572,"section":0,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:31","scriptId":20672,"text":"“嘿嘿，休息时间打个零工啦～”","background":"/art/stories/zjm-099.webp","left":4,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:32","scriptId":20672,"text":"“也好，至少你认识这个齐奈达，找起人来会方便不少。”","background":"/art/stories/zjm-099.webp","left":4,"right":574,"section":0,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:33","scriptId":20672,"text":"“具体的失踪情报也在文件袋里呢，菲尼克斯已经来过了吗？”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:34","scriptId":20672,"text":"佩妮开始阅览文件袋里的其他资料。","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:35","scriptId":20672,"text":"“嗯，是的，她已经走了，还留了只玩意给我们……”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:36","scriptId":20672,"text":"我指向正在任务大厅餐桌的一角——一个橘黄色的玩意。","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":0,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:37","scriptId":20672,"text":"“嗯？那不是机巧炮台么？和小飞象应该是同个种类吧。”","background":"/art/stories/zjm-099.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:38","scriptId":20672,"text":"“嗯，这炮台里面记录着失踪者最后出现的坐标，说是跟着它就行。”","background":"/art/stories/zjm-099.webp","left":4,"right":740,"section":0,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:39","scriptId":20672,"text":"“看品种好像是狸猫？”","background":"/art/stories/zjm-099.webp","left":4,"right":582,"section":0,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:40","scriptId":20672,"text":"“是狗……”","background":"/art/stories/zjm-099.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:41","scriptId":20672,"text":"“嗯，正式名字是多福莱尼猎犬。”","background":"/art/stories/zjm-099.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:42","scriptId":20672,"text":"“从行动模式来看确实挺像狗的，老是在那儿东嗅嗅吸嗅嗅。”","background":"/art/stories/zjm-099.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:43","scriptId":20672,"text":"（不过这种东西明明是武器，为啥要灌输动物的AI……？）","background":"/art/stories/zjm-099.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:44","scriptId":20672,"text":"正当打算继续介绍这只奇怪的机巧炮台时，一个熟悉的声音打断了我。","background":"/art/stories/zjm-099.webp","left":4,"right":596,"section":0,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:45","scriptId":20672,"text":"“啊呀，这不是犬次郎么？”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:46","scriptId":20672,"text":"“那个……是蕾贝卡吧？”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:47","scriptId":20672,"text":"“长官怎么那么快就忘记我了？真让人伤心啊。”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:48","scriptId":20672,"text":"确实是蕾贝卡，不过今天的她穿得非常与众不同，身着的舞装充满了东方的气息。","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:49","scriptId":20672,"text":"“呃……变化太大，让我的记忆有点混乱了。”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:50","scriptId":20672,"text":"“啊～你是说这套舞装啊……之前回了趟老家见了下母亲大人，结果就稀里糊涂被她给套上了这套舞装了。”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:51","scriptId":20672,"text":"“你这么一说我大概懂了，因为和你之前的风格大相径庭，我都不敢认了。”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:52","scriptId":20672,"text":"“虽然有点特殊待遇的嫌疑，一个人有两套舞装。嘻嘻～怎么样？这舞装不错吧。”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:53","scriptId":20672,"text":"“是挺好看的，就是不知道实战的时候这种衣服会怎么样了……我觉得走光的风险很大啊。”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:54","scriptId":20672,"text":"“真是的～长官原来在想这种事情啊～你要看的话，随时都能来我房间找我啊～”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:55","scriptId":20672,"text":"“诶！？”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:56","scriptId":20672,"text":"“……”","background":"/art/stories/zjm-099.webp","left":4,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":746,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:57","scriptId":20672,"text":"“……”","background":"/art/stories/zjm-099.webp","left":746,"right":591,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:58","scriptId":20672,"text":"突然感到背后一阵凉意，为了安全考虑还是把话题拉了回来。","background":"/art/stories/zjm-099.webp","left":746,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:59","scriptId":20672,"text":"“咳哼，先不聊这个了，你刚才看到多福莱尼猎犬……为什么叫它犬次郎？”","background":"/art/stories/zjm-099.webp","left":4,"right":591,"section":0,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:60","scriptId":20672,"text":"“因为这是我老家的机巧炮台啊，你不觉得这柴犬很有东方风格么？这个型号就叫犬次郎。”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:61","scriptId":20672,"text":"","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:62","scriptId":20672,"text":"“不过家纹好像不见了呢……”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:63","scriptId":20672,"text":"蕾贝卡提起犬次郎从头到脚仔细检查了一下。","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:64","scriptId":20672,"text":"“可能是你母亲和多福莱尼有点关系？”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:65","scriptId":20672,"text":"“不一定，这种机巧炮台在我老家那块挺流行的，所以也不能一口断定。”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:66","scriptId":20672,"text":"“…………”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:67","scriptId":20672,"text":"“哦吼～长官是在调查多福莱尼？要我帮忙吗？”（小声）","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:68","scriptId":20672,"text":"蕾贝卡凑近了我，小声说道。","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:69","scriptId":20672,"text":"“真敏锐，你能帮忙的话，最好不过了。”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":1140,"speaker":"蕾贝卡·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:70","scriptId":20672,"text":"“一句话的事啦～之后记得请我吃饭～两个人哟～”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-OPENING:20672:71","scriptId":20672,"text":"“呃……那当然。”","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-OPENING:20672:72","scriptId":20672,"text":"和蕾贝卡闲聊了几句之后便就此别过，我们小队开始执行本次的任务。","background":"/art/stories/zjm-099.webp","left":4,"right":1140,"section":0,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:3","scriptId":20691,"text":"“怎么回事？这里遭到攻击了？”","background":"/art/stories/zjm-067.webp","left":12,"right":1140,"section":1,"shake":true},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:4","scriptId":20691,"text":"“是的，我们遭到了超远距离攻击，那些该死的人类知道了我们据点的坐标。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:5","scriptId":20691,"text":"“结果你放跑了那些钢舞姬，还让她们用远距离炮击攻击我们？？”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:6","scriptId":20691,"text":"“……无地自容。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:7","scriptId":20691,"text":"“你先去加入防御作战，我随后就到。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:8","scriptId":20691,"text":"“麻烦你了。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:9","scriptId":20691,"text":"“看你平时挺能干的，怎么会犯这种错误？”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:10","scriptId":20691,"text":"“因为那些人和阿尔库涅大人有所关联，所以我没下死手，结果让他们反击成功……”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:11","scriptId":20691,"text":"“……”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:12","scriptId":20691,"text":"“原来是那个队伍……唉……”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:13","scriptId":20691,"text":"“阿尔库涅大人并不在他们身边，这明显是个抹消他们的好机会。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:14","scriptId":20691,"text":"“原来还能这样的？”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:15","scriptId":20691,"text":"“唉……你也太老实了，如果你能杀了这帮家伙，泰莱塔大人肯定会很高兴，到时候就算阿尔库涅大人生气也于事无补。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:16","scriptId":20691,"text":"“嗯，我下次会注意的。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":12,"speaker":"西格玛","player":false,"side":"left","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:17","scriptId":20691,"text":"“下次？这次的机会不是还在吗？出击吧，这次可别失手了。”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"dialogue","head":411,"speaker":"伊塔","player":false,"side":"right","dialogue":"/art/stories/dhjm-009.webp","id":"925001-PROLOGUE:20691:18","scriptId":20691,"text":"“好的！”","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-EPILOGUE:20692:1","scriptId":20692,"text":"原计划打算只摧毁旅行者的据点，避免与旅行者交手，但最后还是和她们打了一场。","background":"/art/stories/zjm-067.webp","left":12,"right":411,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:2","scriptId":20692,"text":"“呼……真是危险，伊塔和西格玛联手的攻击不好对付啊……”","background":"/art/stories/zjm-067.webp","left":4,"right":411,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-EPILOGUE:20692:3","scriptId":20692,"text":"虽然已经习惯和旅行者作战，但和指挥官级别的西格玛作战还是略显颓势。","background":"/art/stories/zjm-067.webp","left":4,"right":411,"section":2,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:4","scriptId":20692,"text":"“如果不是超远距离炮击成功破坏了据点，我们可就危险了。”","background":"/art/stories/zjm-067.webp","left":4,"right":591,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:5","scriptId":20692,"text":"“是啊，根本就是疲于奔命，没想到她们这次的攻击那么猛烈。”","background":"/art/stories/zjm-067.webp","left":4,"right":591,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-EPILOGUE:20692:6","scriptId":20692,"text":"面对数倍于我们的敌人，只能不停地尝试游击作战。","background":"/art/stories/zjm-067.webp","left":4,"right":591,"section":2,"shake":false},{"kind":"dialogue","head":743,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:7","scriptId":20692,"text":"“跑得我履带快断了。”","background":"/art/stories/zjm-067.webp","left":4,"right":743,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-EPILOGUE:20692:8","scriptId":20692,"text":"佐伊正在紧急抢修自己的履带。","background":"/art/stories/zjm-067.webp","left":4,"right":743,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:9","scriptId":20692,"text":"“回去要谢谢波西娅，要不是顺利破坏据点旅行者是不会选择撤退的，如果拖延下去还真不知道会变成什么样子……”","background":"/art/stories/zjm-067.webp","left":4,"right":743,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-EPILOGUE:20692:11","scriptId":20692,"text":"开始调查据点的废墟，依照以往的经验，迪塔格项圈的解除台座就在这据点中。","background":"/art/stories/zjm-067.webp","left":null,"right":null,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:12","scriptId":20692,"text":"“果然是这里。”","background":"/art/stories/zjm-067.webp","left":4,"right":null,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-EPILOGUE:20692:13","scriptId":20692,"text":"我们在据点废墟的深处找到了权令台座。","background":"/art/stories/zjm-067.webp","left":4,"right":null,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:14","scriptId":20692,"text":"“来，齐奈达，把手放上去。”","background":"/art/stories/zjm-067.webp","left":4,"right":null,"section":2,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:15","scriptId":20692,"text":"“遵命。”","background":"/art/stories/zjm-067.webp","left":4,"right":1137,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-EPILOGUE:20692:16","scriptId":20692,"text":"戴在齐奈达脖子上的项圈突然碎裂了，看样子成功解除了迪塔格项圈。","background":"/art/stories/zjm-067.webp","left":4,"right":1137,"section":2,"shake":false},{"kind":"dialogue","head":1137,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:17","scriptId":20692,"text":"“………………………………………………”","background":"/art/stories/zjm-067.webp","left":4,"right":1137,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:18","scriptId":20692,"text":"“感觉怎么样？”","background":"/art/stories/zjm-067.webp","left":4,"right":1137,"section":2,"shake":false},{"kind":"dialogue","head":1138,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:19","scriptId":20692,"text":"“指挥官同志！”","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-EPILOGUE:20692:20","scriptId":20692,"text":"面对齐奈达的飞扑，我一点也开心不起来，因为那力道更像是擒抱……","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:21","scriptId":20692,"text":"“嗯？看样子是恢复了？连对我的称呼都变了。”","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-EPILOGUE:20692:22","scriptId":20692,"text":"之前缺乏生气的齐奈达恢复了血色，而且从她的表情来看精神控制也已经解除了。","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":2,"shake":false},{"kind":"dialogue","head":1138,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:23","scriptId":20692,"text":"“谢谢指挥官同志的救命之恩，我都不知道该说什么好了。”","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:24","scriptId":20692,"text":"“那个……大家都看着呢……”","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":2,"shake":false},{"kind":"dialogue","head":1138,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:25","scriptId":20692,"text":"“啊！”","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"925001-EPILOGUE:20692:26","scriptId":20692,"text":"齐奈达尴尬地从我身边挪开。","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":2,"shake":false},{"kind":"dialogue","head":1138,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:27","scriptId":20692,"text":"“也要谢谢奈特莉，佩妮，佐伊还有维卡～”","background":"/art/stories/zjm-067.webp","left":4,"right":1138,"section":2,"shake":false},{"kind":"dialogue","head":596,"speaker":"维卡","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:28","scriptId":20692,"text":"“小事。”","background":"/art/stories/zjm-067.webp","left":596,"right":1138,"section":2,"shake":false},{"kind":"dialogue","head":574,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:29","scriptId":20692,"text":"“看来还记得我们啊～还担心会从零开始呢，那以后也要多多关照咯～齐奈达～”","background":"/art/stories/zjm-067.webp","left":574,"right":1138,"section":2,"shake":false},{"kind":"dialogue","head":1138,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:30","scriptId":20692,"text":"“嗯～”","background":"/art/stories/zjm-067.webp","left":574,"right":1138,"section":2,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:31","scriptId":20692,"text":"“看来好像没有记忆缺失？照小说里的桥段，一般都会错乱或者沉睡一段时间呢。”","background":"/art/stories/zjm-067.webp","left":584,"right":1138,"section":2,"shake":false},{"kind":"dialogue","head":1138,"speaker":"齐奈达·维尔金斯卡娅","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:32","scriptId":20692,"text":"“我都记得啊，只是身体完全不受控制，感觉就像在自己的身体里看电影。”","background":"/art/stories/zjm-067.webp","left":584,"right":1138,"section":2,"shake":false},{"kind":"dialogue","head":591,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:33","scriptId":20692,"text":"“哦哦，我记一下，是个不错的小说材料。”","background":"/art/stories/zjm-067.webp","left":591,"right":1138,"section":2,"shake":false},{"kind":"dialogue","head":748,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:34","scriptId":20692,"text":"“履带修理完毕！唔……我好像错过了什么？”","background":"/art/stories/zjm-067.webp","left":591,"right":748,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"925001-EPILOGUE:20692:35","scriptId":20692,"text":"“回基地吧～终于可以和这个鬼地方说再见了～”","background":"/art/stories/zjm-067.webp","left":4,"right":748,"section":2,"shake":false}],"summaries":[]}
