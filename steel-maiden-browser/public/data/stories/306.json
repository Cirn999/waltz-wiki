{"schemaVersion":1,"id":306,"sections":[{"id":"607004-PROLOGUE","name":"第 1 战 · 战前","scripts":[20507],"start":0,"count":13},{"id":"607004-EPILOGUE","name":"第 1 战 · 战后","scripts":[20508],"start":13,"count":16}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607004-PROLOGUE:20507:1","scriptId":20507,"text":"铁血小队——","background":"/art/stories/zdbjbz-11.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1091,"speaker":"珍娜·杰克逊","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607004-PROLOGUE:20507:2","scriptId":20507,"text":"“艾米丽队长！我们怎么不去收集战术旗啊？你看那里！还有那里！都是战术旗啊。”","background":"/art/stories/zdbjbz-11.webp","left":1091,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1092,"speaker":"艾米丽·兰德尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607004-PROLOGUE:20507:3","scriptId":20507,"text":"“珍娜，你忘了这次出来的时候我说过的话了吗？”","background":"/art/stories/zdbjbz-11.webp","left":1091,"right":1092,"section":0,"shake":false},{"kind":"dialogue","head":1091,"speaker":"珍娜·杰克逊","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607004-PROLOGUE:20507:4","scriptId":20507,"text":"“？？？”","background":"/art/stories/zdbjbz-11.webp","left":1091,"right":1092,"section":0,"shake":false},{"kind":"dialogue","head":1092,"speaker":"艾米丽·兰德尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607004-PROLOGUE:20507:5","scriptId":20507,"text":"“因为我们小队平时没什么机会执行作战任务，所以这次这种演习正是展现我们实力的时候。”","background":"/art/stories/zdbjbz-11.webp","left":1091,"right":1092,"section":0,"shake":false},{"kind":"dialogue","head":1091,"speaker":"珍娜·杰克逊","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607004-PROLOGUE:20507:6","scriptId":20507,"text":"“所以我们是要埋伏其他小队的人？但是现在周边并没有人啊，收走一些旗帜又没有关系……”","background":"/art/stories/zdbjbz-11.webp","left":1091,"right":1092,"section":0,"shake":false},{"kind":"dialogue","head":1092,"speaker":"艾米丽·兰德尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607004-PROLOGUE:20507:7","scriptId":20507,"text":"“……”","background":"/art/stories/zdbjbz-11.webp","left":1091,"right":1092,"section":0,"shake":false},{"kind":"dialogue","head":1093,"speaker":"谢里尔·克莱恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607004-PROLOGUE:20507:8","scriptId":20507,"text":"“艾米丽队长，要不这样吧，让珍娜去收集信号旗，只要她在我们的射程之内的话我想应该没问题。”","background":"/art/stories/zdbjbz-11.webp","left":1093,"right":1092,"section":0,"shake":false},{"kind":"dialogue","head":1092,"speaker":"艾米丽·兰德尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607004-PROLOGUE:20507:9","scriptId":20507,"text":"“那好吧，珍娜，你先去收集一些战术旗，发现任何情况都要第一时间汇报。”","background":"/art/stories/zdbjbz-11.webp","left":1093,"right":1092,"section":0,"shake":false},{"kind":"dialogue","head":1091,"speaker":"珍娜·杰克逊","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607004-PROLOGUE:20507:10","scriptId":20507,"text":"“好耶～我这就去～”","background":"/art/stories/zdbjbz-11.webp","left":1091,"right":1092,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607004-PROLOGUE:20507:12","scriptId":20507,"text":"珍娜离开之后没多久。","background":"/art/stories/zdbjbz-11.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1093,"speaker":"谢里尔·克莱恩","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607004-PROLOGUE:20507:13","scriptId":20507,"text":"“九点钟方向有一队小队过来了。”","background":"/art/stories/zdbjbz-11.webp","left":1093,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":1092,"speaker":"艾米丽·兰德尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607004-PROLOGUE:20507:14","scriptId":20507,"text":"“很好，机会来了，准备行动。”","background":"/art/stories/zdbjbz-11.webp","left":1093,"right":1092,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"607004-EPILOGUE:20508:1","scriptId":20508,"text":"一场乱战之后。","background":"/art/stories/zdbjbz-11.webp","left":1093,"right":1092,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:2","scriptId":20508,"text":"“呼……特勤局的小队都是怎么回事，就不能安稳点收集信号旗吗？”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":1092,"section":1,"shake":false},{"kind":"dialogue","head":745,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:3","scriptId":20508,"text":"“就是就是，凭什么每次都对我发动突袭啊！？”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":745,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:4","scriptId":20508,"text":"“谁让你不能率先侦察到敌人啊……在队伍前列的任务就是确保前进路线上没有问题。”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":745,"section":1,"shake":false},{"kind":"dialogue","head":745,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:5","scriptId":20508,"text":"“呜呜……是我弱，好了吧。”","background":"/art/stories/zdbjbz-11.webp","left":4,"right":745,"section":1,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:6","scriptId":20508,"text":"“啊哈哈～佐伊别这么说嘛～如果没有你，我们现在这套防守反击可不能成功的呀～”","background":"/art/stories/zdbjbz-11.webp","left":578,"right":745,"section":1,"shake":false},{"kind":"dialogue","head":747,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:7","scriptId":20508,"text":"“真的？”","background":"/art/stories/zdbjbz-11.webp","left":578,"right":747,"section":1,"shake":false},{"kind":"dialogue","head":578,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:8","scriptId":20508,"text":"“当然当然～长官说是不是？”","background":"/art/stories/zdbjbz-11.webp","left":578,"right":747,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:9","scriptId":20508,"text":"“嗯？呃……是，是的。”","background":"/art/stories/zdbjbz-11.webp","left":578,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:10","scriptId":20508,"text":"“哼～长官就是喜欢藏着掖着，不把实际情况告诉我。”","background":"/art/stories/zdbjbz-11.webp","left":740,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:11","scriptId":20508,"text":"“……”","background":"/art/stories/zdbjbz-11.webp","left":740,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:12","scriptId":20508,"text":"（也罢，佐伊当诱饵倒倒是充分发挥了她慌不择路的特性……能把战场弄得一团糟也是一种本事……”","background":"/art/stories/zdbjbz-11.webp","left":740,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:13","scriptId":20508,"text":"“是的，但你还成功吸引到了另一个小队，结果差点让我们陷入窘境……”","background":"/art/stories/zdbjbz-11.webp","left":740,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":744,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:14","scriptId":20508,"text":"“诶嘿嘿～”","background":"/art/stories/zdbjbz-11.webp","left":744,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:15","scriptId":20508,"text":"“这可不是在夸你……以后选取躲避路线的时候多留个心眼，也注意一下周围的情况。”","background":"/art/stories/zdbjbz-11.webp","left":744,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"607004-EPILOGUE:20508:16","scriptId":20508,"text":"“知道啦。”","background":"/art/stories/zdbjbz-11.webp","left":740,"right":4,"section":1,"shake":false}],"summaries":[]}
