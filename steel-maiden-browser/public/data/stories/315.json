{"schemaVersion":1,"id":315,"sections":[{"id":"708001-PROLOGUE","name":"第 1 战 · 战前","scripts":[20186],"start":0,"count":40},{"id":"708001-EPILOGUE","name":"第 1 战 · 战后","scripts":[20187],"start":40,"count":21},{"id":"708002-PROLOGUE","name":"第 2 战 · 战前","scripts":[20188],"start":61,"count":20},{"id":"708002-EPILOGUE","name":"第 2 战 · 战后","scripts":[20189],"start":81,"count":32}],"frames":[{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:1","scriptId":20186,"text":"维多利亚团长双手背在身后，站在窗边看着远方。","background":"/art/stories/zjm-098.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:2","scriptId":20186,"text":"奈乐的目光紧紧盯着我，看了几秒钟。","background":"/art/stories/zjm-098.webp","left":null,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:3","scriptId":20186,"text":"“那个……到底是什么事情啊？奈乐？”","background":"/art/stories/zjm-098.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:4","scriptId":20186,"text":"看到奈乐迟迟不出声，我只能再问了一次。","background":"/art/stories/zjm-098.webp","left":4,"right":null,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:5","scriptId":20186,"text":"“这个是特勤局总部的文书，你看一下。”","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:6","scriptId":20186,"text":"奈乐把一份带有蜡印的文书递了给我，蜡封的部分已经撕开。","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:7","scriptId":20186,"text":"“这个是特勤局的机密文件……应该不能给我看吧。”","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:8","scriptId":20186,"text":"“你看过就知道了。”","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:9","scriptId":20186,"text":"既然奈乐执意让我看，我只能打开文书，仔细地阅读了起来。","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:10","scriptId":20186,"text":"文书的篇幅不是很长，很快我就读完了。","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:11","scriptId":20186,"text":"“这……”","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:12","scriptId":20186,"text":"这个时候维多利亚团长转过身来。","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":550,"speaker":"维多利亚·威灵顿","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:13","scriptId":20186,"text":"“这是特勤局最喜欢的手段之一，看来我们只能把密码纸交回去了。”","background":"/art/stories/zjm-098.webp","left":4,"right":550,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:14","scriptId":20186,"text":"文书的大致内容很清晰，就是让奈乐追回原本属于特勤局的密码纸。","background":"/art/stories/zjm-098.webp","left":4,"right":550,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:15","scriptId":20186,"text":"“没想到还有这种事情……”","background":"/art/stories/zjm-098.webp","left":4,"right":550,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:16","scriptId":20186,"text":"“虽然我不想这么说，但是长官你这是从航天局里把重要的信息偷走了，情节有点严重。”","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:17","scriptId":20186,"text":"“当时的具体情况是怎么样的？最好能告诉我，这样一来我也能方便为你开脱。”","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:18","scriptId":20186,"text":"“呃，原来这么严重啊……好吧，具体情况是这样的。”","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:19","scriptId":20186,"text":"我把遇袭事件和发现密码纸的经过都一五一十地告诉了奈乐。","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:20","scriptId":20186,"text":"听完之后，奈乐皱了皱眉头。","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:21","scriptId":20186,"text":"“原来是这么回事，长官你真是……”","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:22","scriptId":20186,"text":"“唉……不自觉就……不过我倒是没注意，原来航天局还有装摄像头这种东西啊……”","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:23","scriptId":20186,"text":"“密码纸这件事情里面确实有点蹊跷，维多利亚团长也打算彻查这件事情吗？”","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:24","scriptId":20186,"text":"奈乐发表了自己的看法。","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:25","scriptId":20186,"text":"“如果特勤局没发现的话，我是打算让这小子去调查密码纸的事情。”","background":"/art/stories/zjm-098.webp","left":547,"right":103,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:26","scriptId":20186,"text":"维多利亚坐回到自己的办公桌前，继续说道。","background":"/art/stories/zjm-098.webp","left":547,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:27","scriptId":20186,"text":"“不过既然特勤局要把密码纸要回去，那就要回去呗。”","background":"/art/stories/zjm-098.webp","left":547,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":110,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:28","scriptId":20186,"text":"“……”","background":"/art/stories/zjm-098.webp","left":547,"right":110,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:29","scriptId":20186,"text":"奈乐沉思了一会儿。","background":"/art/stories/zjm-098.webp","left":547,"right":110,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:30","scriptId":20186,"text":"“密码纸我会回收，不过我只回收原件。”","background":"/art/stories/zjm-098.webp","left":547,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:31","scriptId":20186,"text":"“！？”","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:32","scriptId":20186,"text":"“毕竟任务是让我回收这份密码纸，我只是奉命行事。”","background":"/art/stories/zjm-098.webp","left":4,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":557,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:33","scriptId":20186,"text":"“奈乐也被隆佬教坏了啊～表面一套背后一套的～”","background":"/art/stories/zjm-098.webp","left":557,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:34","scriptId":20186,"text":"“这事和老爸没有关系，虽然之后会报告给他就是了。”","background":"/art/stories/zjm-098.webp","left":557,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:35","scriptId":20186,"text":"“不过作为包庇你们的条件，我要求参加这次调查行动。”","background":"/art/stories/zjm-098.webp","left":557,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:36","scriptId":20186,"text":"“奈乐想参加调查行动我是没有问题的，不过我可不会付佣金的哟。”","background":"/art/stories/zjm-098.webp","left":547,"right":103,"section":0,"shake":false},{"kind":"dialogue","head":110,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:37","scriptId":20186,"text":"“没关系，本来也不是冲着钱来的。”","background":"/art/stories/zjm-098.webp","left":547,"right":110,"section":0,"shake":false},{"kind":"dialogue","head":547,"speaker":"维多利亚·威灵顿","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:38","scriptId":20186,"text":"“那么就这样，多了一队帮手，自然是再好不过的了。”","background":"/art/stories/zjm-098.webp","left":547,"right":110,"section":0,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-PROLOGUE:20186:39","scriptId":20186,"text":"“是……”","background":"/art/stories/zjm-098.webp","left":547,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-PROLOGUE:20186:40","scriptId":20186,"text":"没想到最后会变成这样……猎虎小队也掺合了进来。","background":"/art/stories/zjm-098.webp","left":547,"right":4,"section":0,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-EPILOGUE:20187:1","scriptId":20187,"text":"回到大厅里，小队的队员都整装待发，看到我的身影之后她们都聚了过来。","background":"/art/stories/zjm-099.webp","left":547,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:2","scriptId":20187,"text":"“长官回来了，我们准备出发吧～”","background":"/art/stories/zjm-099.webp","left":740,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:3","scriptId":20187,"text":"“团长那里有什么事情吗？”","background":"/art/stories/zjm-099.webp","left":740,"right":584,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-EPILOGUE:20187:4","scriptId":20187,"text":"大家七嘴八舌地问着我，而我则是摇了摇头。","background":"/art/stories/zjm-099.webp","left":740,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:5","scriptId":20187,"text":"“那个，大家稍微等等，有另一队钢舞姬也会参加这次行动。”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:6","scriptId":20187,"text":"“还有一队？”","background":"/art/stories/zjm-099.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:7","scriptId":20187,"text":"“恩，应该过一会儿就会来了吧，我们在这里等等她们吧。”","background":"/art/stories/zjm-099.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-EPILOGUE:20187:8","scriptId":20187,"text":"虽然大家好像都有点惊讶，但是没有一个人有怨言的样子。","background":"/art/stories/zjm-099.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-EPILOGUE:20187:9","scriptId":20187,"text":"等了约莫十五分钟——","background":"/art/stories/zjm-099.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:10","scriptId":20187,"text":"“长官，她们还没来吗？”","background":"/art/stories/zjm-099.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:11","scriptId":20187,"text":"“好像还没……哦！来了。”","background":"/art/stories/zjm-099.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-EPILOGUE:20187:12","scriptId":20187,"text":"说曹操曹操到，有三名钢舞姬从死水大厅的另一侧走了过来。","background":"/art/stories/zjm-099.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":747,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:13","scriptId":20187,"text":"“诶！？是奈乐她们？”","background":"/art/stories/zjm-099.webp","left":4,"right":747,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:14","scriptId":20187,"text":"“没错，是猎虎小队，这次是她们和我们同行。”","background":"/art/stories/zjm-099.webp","left":4,"right":747,"section":1,"shake":false},{"kind":"dialogue","head":740,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:15","scriptId":20187,"text":"“真是意外……”","background":"/art/stories/zjm-099.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-EPILOGUE:20187:16","scriptId":20187,"text":"猎虎小队走到我们队伍的前面。","background":"/art/stories/zjm-099.webp","left":4,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:17","scriptId":20187,"text":"“问题都已经处理过了，密码纸原件已经派专人送回特勤局总部，现在猎虎小队可以出发。”","background":"/art/stories/zjm-099.webp","left":103,"right":740,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:18","scriptId":20187,"text":"“你这边没问题的话就行。”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:19","scriptId":20187,"text":"“那么我向大家先介绍一下——","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708001-EPILOGUE:20187:20","scriptId":20187,"text":"经过一番简单的介绍后，奈乐她们很快加入到了我们的行列中。","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":1,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708001-EPILOGUE:20187:21","scriptId":20187,"text":"“那么我们出发吧。”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":1,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-PROLOGUE:20188:0","scriptId":20188,"text":"根据波西娅给出的地址，我们快速前往破译专家的住所。","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-PROLOGUE:20188:1","scriptId":20188,"text":"通过运输机到达了华沙——","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:2","scriptId":20188,"text":"“没想到那么短时间内就又和长官一起执行任务了。”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:3","scriptId":20188,"text":"“呃……纯属意外……”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:4","scriptId":20188,"text":"“不过没想到特勤局那么精，还会把密码纸追回……”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:5","scriptId":20188,"text":"“具体上面要这密码干什么我也不清楚。”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:6","scriptId":20188,"text":"“是啊，毕竟还没有破解，都不知道会是什么内容呢。”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:7","scriptId":20188,"text":"“总之我们可以先做调查，毕竟上层处理这种事情都要走流程，等他们处理好了，我们这边说不定都已经把问题解决了。”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:8","scriptId":20188,"text":"“呃……原来你是这种想法啊～有点像蕾贝卡嘛～”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":112,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:9","scriptId":20188,"text":"“什么！？我才不像那家伙呢。”","background":"/art/stories/zjm-099.webp","left":112,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:10","scriptId":20188,"text":"“蕾贝卡的想法比较难捉摸，不过可以肯定的一点是，她总喜欢想在别人之前，所以你这未雨绸缪的想法和她有点像。”","background":"/art/stories/zjm-099.webp","left":112,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:11","scriptId":20188,"text":"“哦，这意思啊……”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:12","scriptId":20188,"text":"“话题回到这个破译专家吧，这家伙好像是特勤局的人啊……”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:13","scriptId":20188,"text":"“应该是吧，我也不是很确定，不过就算是那样的话，有我在也不会有什么问题。”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:14","scriptId":20188,"text":"“也对，有奈乐帮助真是太好了～难道是你已经猜到会有这种情况？”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":107,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:15","scriptId":20188,"text":"“没、没有这回事……”","background":"/art/stories/zjm-099.webp","left":107,"right":4,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-PROLOGUE:20188:16","scriptId":20188,"text":"这时我拿出地图看了一下。","background":"/art/stories/zjm-099.webp","left":107,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:17","scriptId":20188,"text":"“这里基本都要到最前线了……科研人员一般都不会被派到前线的吧……”","background":"/art/stories/zjm-099.webp","left":107,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:18","scriptId":20188,"text":"“不一定，有很多科研人员本身就是钢舞姬，所以在前线很正常，索菲亚教官出现在前线也挺正常的吧。”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-PROLOGUE:20188:19","scriptId":20188,"text":"“呃……也对……看来很可能是钢舞姬啊。”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":2,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-EPILOGUE:20189:0","scriptId":20189,"text":"黄昏渐渐降临，我们今天的路程看来只能到这里了。","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-EPILOGUE:20189:1","scriptId":20189,"text":"于是开始派莉娜和佐伊去寻找能落脚扎营的地点。","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-EPILOGUE:20189:2","scriptId":20189,"text":"约十分钟后——","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":3,"shake":false},{"kind":"dialogue","head":952,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:3","scriptId":20189,"text":"“我们找到可以扎营的地方了。”","background":"/art/stories/zjm-099.webp","left":952,"right":4,"section":3,"shake":false},{"kind":"dialogue","head":742,"speaker":"佐伊·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:4","scriptId":20189,"text":"“恩～在这里西边一公里开外的高地上，有一片林地，那边应该可以扎营。”","background":"/art/stories/zjm-099.webp","left":952,"right":742,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:5","scriptId":20189,"text":"“好的，那么我们马上朝那边出发吧。”","background":"/art/stories/zjm-099.webp","left":4,"right":742,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-EPILOGUE:20189:6","scriptId":20189,"text":"因为现在人员变多了，所以挑选扎营地点比之前要谨慎一点。","background":"/art/stories/zjm-099.webp","left":4,"right":742,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-EPILOGUE:20189:7","scriptId":20189,"text":"高地势的林地，既有一定的隐蔽性又可以占据良好的视野，是扎营地点的不二之选。","background":"/art/stories/zjm-099.webp","left":4,"right":742,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-EPILOGUE:20189:8","scriptId":20189,"text":"到达林地后进行快速勘察，果然是一块适合扎营的地方，于是立刻动手扎营。","background":"/art/stories/zjm-099.webp","left":4,"right":742,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:9","scriptId":20189,"text":"“恩，人多了不少啊，以前只要一顶小型帐篷，现在已经是中型帐篷都快睡不下了啊。”","background":"/art/stories/zjm-099.webp","left":4,"right":742,"section":3,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:10","scriptId":20189,"text":"“是啊，现在多了两小队的编制，应该要准备大帐篷了啊。”","background":"/art/stories/zjm-099.webp","left":4,"right":572,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:11","scriptId":20189,"text":"“恩……”","background":"/art/stories/zjm-099.webp","left":4,"right":572,"section":3,"shake":false},{"kind":"dialogue","head":952,"speaker":"莉娜·托卢沙娅","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:12","scriptId":20189,"text":"“长官不用担心啦～我们自己有准备的帐篷～”","background":"/art/stories/zjm-099.webp","left":952,"right":572,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-EPILOGUE:20189:13","scriptId":20189,"text":"看到佐伊她们已经开始铺设第二顶帐篷了，从大小上来看应该是猎虎小队的小型便携式帐篷。","background":"/art/stories/zjm-099.webp","left":952,"right":572,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-EPILOGUE:20189:14","scriptId":20189,"text":"莉娜从我们身边走过，她应该是刚从车里把饮用水取了过来。","background":"/art/stories/zjm-099.webp","left":952,"right":572,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:15","scriptId":20189,"text":"“恩，除去站岗的人员，帐篷大小应该还是够的。”","background":"/art/stories/zjm-099.webp","left":952,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:16","scriptId":20189,"text":"“看来下次要换个更大点的了。”","background":"/art/stories/zjm-099.webp","left":4,"right":103,"section":3,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:17","scriptId":20189,"text":"“这种军需品更换的话，要占用更大的空间安置，携带不便，如果可以的话，现在这种尺寸的帐篷比较合适。”","background":"/art/stories/zjm-099.webp","left":4,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:18","scriptId":20189,"text":"“佩妮这么说也对，是否便于携带也是要考虑的的重要事项呢。”","background":"/art/stories/zjm-099.webp","left":572,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":582,"speaker":"奈特莉","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:19","scriptId":20189,"text":"“这样的话，长官还是换成多个帐篷比较好，虽然这样一来谁和长官睡一个帐篷可能会成为额外的问题～”","background":"/art/stories/zjm-099.webp","left":582,"right":584,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:20","scriptId":20189,"text":"“呃……”","background":"/art/stories/zjm-099.webp","left":582,"right":4,"section":3,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:21","scriptId":20189,"text":"“……”","background":"/art/stories/zjm-099.webp","left":584,"right":4,"section":3,"shake":false},{"kind":"dialogue","head":584,"speaker":"佩妮·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:22","scriptId":20189,"text":"“奈特莉过来帮忙生火。”","background":"/art/stories/zjm-099.webp","left":584,"right":4,"section":3,"shake":false},{"kind":"dialogue","head":572,"speaker":"奈特莉","player":false,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:23","scriptId":20189,"text":"“好的。”","background":"/art/stories/zjm-099.webp","left":584,"right":572,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-EPILOGUE:20189:24","scriptId":20189,"text":"佩妮抱起一堆柴火，看来是要结束这个话题准备制作今天的晚饭了。","background":"/art/stories/zjm-099.webp","left":584,"right":572,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-EPILOGUE:20189:25","scriptId":20189,"text":"在野外搞这种炊事，事前要准备的事情很多，于是奈特莉被佩妮拖去帮忙了。","background":"/art/stories/zjm-099.webp","left":584,"right":572,"section":3,"shake":false},{"kind":"dialogue","head":746,"speaker":"佐伊·谢尔曼","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:26","scriptId":20189,"text":"“长官也不要在那里干站着，快点过来把车上的东西搬出来！”","background":"/art/stories/zjm-099.webp","left":746,"right":572,"section":3,"shake":false},{"kind":"narration","head":null,"speaker":"","side":null,"dialogue":"/art/stories/dhjm-010.webp","id":"708002-EPILOGUE:20189:27","scriptId":20189,"text":"佐伊从远处对我呵斥到。","background":"/art/stories/zjm-099.webp","left":746,"right":572,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:28","scriptId":20189,"text":"“好好好，这就来。”","background":"/art/stories/zjm-099.webp","left":746,"right":4,"section":3,"shake":false},{"kind":"dialogue","head":103,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:29","scriptId":20189,"text":"“虽然队伍变大了，不过佐伊她们还是老样子呢，一点没有上下级意识。”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":3,"shake":false},{"kind":"dialogue","head":4,"speaker":"指挥官","player":true,"side":"right","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:30","scriptId":20189,"text":"“这样不也挺好嘛，待在队伍里也不会觉得拘谨。”","background":"/art/stories/zjm-099.webp","left":103,"right":4,"section":3,"shake":false},{"kind":"dialogue","head":105,"speaker":"奈乐·隆美尔","player":false,"side":"left","dialogue":"/art/stories/dhjm-008.webp","id":"708002-EPILOGUE:20189:31","scriptId":20189,"text":"“确实～”","background":"/art/stories/zjm-099.webp","left":105,"right":4,"section":3,"shake":false}],"summaries":[]}
